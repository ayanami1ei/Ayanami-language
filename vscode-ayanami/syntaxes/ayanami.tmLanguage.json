{
  "$schema": "https://raw.githubusercontent.com/microsoft/vscode-grammar/master/schema/tmLanguage.schema.json",
  "name": "Ayanami",
  "scopeName": "source.aya",
  "fileTypes": ["aya"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#delimiters" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.aya", "begin": "//", "end": "$" },
        { "name": "comment.block.aya", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.aya",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "name": "constant.character.escape.aya", "match": "\\\\." }]
    },
    "chars": {
      "name": "string.quoted.single.aya",
      "begin": "'",
      "end": "'",
      "patterns": [{ "name": "constant.character.escape.aya", "match": "\\\\." }]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.aya", "match": "\\b[0-9]+\\.[0-9]+\\b" },
        { "name": "constant.numeric.integer.aya", "match": "\\b[0-9]+\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.aya",
          "match": "\\b(if|elif|else|for|in|while|return|break|continue)\\b"
        },
        {
          "name": "keyword.declaration.aya",
          "match": "\\b(fn|struct|namespace|interface|impl|import|pub|crate|mut)\\b"
        },
        {
          "name": "keyword.operator.aya",
          "match": "\\b(move|clone)\\b"
        },
        {
          "name": "storage.modifier.aya",
          "match": "\\b(shared|unique|weak)\\b"
        },
        {
          "name": "constant.language.aya",
          "match": "\\b(true|false|self)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.aya",
          "match": "\\b(int|float|char|bool|void)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arithmetic.aya", "match": "[+\\-*/%]" },
        { "name": "keyword.operator.comparison.aya", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.logical.aya", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.assignment.aya", "match": "=" }
      ]
    },
    "delimiters": {
      "patterns": [
        { "name": "punctuation.section.block.aya", "match": "[{}]" },
        { "name": "punctuation.section.parens.aya", "match": "[()]" },
        { "name": "punctuation.section.bracket.aya", "match": "[\\[\\]]" },
        { "name": "punctuation.separator.aya", "match": "[,;]" },
        { "name": "punctuation.accessor.aya", "match": "\\." }
      ]
    },
    "identifiers": {
      "name": "variable.other.aya",
      "match": "[a-zA-Z_][a-zA-Z0-9_]*"
    }
  }
}
