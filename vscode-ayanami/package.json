{
  "name": "ayanami",
  "displayName": "Ayanami Language",
  "description": "Ayanami language support",
  "version": "0.1.0",
  "publisher": "ayanami",
  "engines": {
    "vscode": "^1.60.0"
  },
  "icon": "./icon.png",
  "main": "./extension.js",
  "activationEvents": ["onLanguage:ayanami"],
  "categories": ["Programming Languages", "Themes"],
  "contributes": {
    "iconThemes": [
      {
        "id": "ayanami-icons",
        "label": "Ayanami File Icons",
        "path": "./icon-theme.json"
      }
    ],
    "languages": [
      {
        "id": "ayanami",
        "aliases": ["Ayanami", "ayanami"],
        "extensions": [".aya"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ayanami",
        "scopeName": "source.aya",
        "path": "./syntaxes/ayanami.tmLanguage.json"
      }
    ]
  }
}
