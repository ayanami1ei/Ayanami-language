// 同一个 lib.lcl 以别名安装后，来源作用域必须仍由包内容恢复。
import "lib_alias"

fn helper(int x) -> int {
    return x + 20
}

fn main() -> int {
    a = from_lib(1)
    b = generic_from_lib[int](1)
    c = generic_complete[int](7)
    if a != 11 { return a }
    if b != 12 { return b }
    if c != 35 { return c + 100 }
    return 0
}
