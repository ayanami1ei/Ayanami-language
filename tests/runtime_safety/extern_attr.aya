// #[extern] 标注（等价 extern "C"）：导入声明 + 定义导出
import "io"

#[extern]
fn __ayanami_live_allocs() -> int;

#[extern]
fn exported_add(int a, int b) -> int {
    return a + b
}

fn main() -> int {
    live = __ayanami_live_allocs()
    if live < 0 { return 1 }
    if exported_add(2, 3) != 5 { return 2 }
    println(1)
    return 0
}
