// #182：比较表达式（HIR 类型为操作数类型、实际发射 i1/Bool）在各 bool 上下文的赋值
import "option"

struct S {
    int v
    bool b
}

fn take(bool x) -> int {
    if x { return 1 }
    return 0
}

fn main() -> int {
    a = 1
    // 结构体字段直接赋比较表达式
    s = S { v = 2, b = a == 1 }
    if !s.b { return 1 }
    // 枚举载荷（推断为 Option[bool]）
    o = Option::Some(a == 1)
    match o {
        None => { return 2 }
        Some(x) => { if !x { return 3 } }
    }
    // bool 形参 + 比较实参
    if take(a == 1) != 1 { return 4 }
    return 0
}
