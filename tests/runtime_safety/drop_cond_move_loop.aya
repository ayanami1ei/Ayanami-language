// #184：循环内条件移动的拥有型本地在未移动路径须 drop（此前泄漏）
import "io"
import "string"

extern "C" fn __ayanami_live_allocs() -> int;

fn h() -> int {
    k = 0
    i = 0
    while i < 3 {
        a = "x" + i.to_string()
        if i != 1 {
            c = a
            k = k + c.len as int
        }
        i = i + 1
    }
    return k
}

fn main() -> int {
    b = __ayanami_live_allocs()
    h()
    println(__ayanami_live_allocs() - b)
    return 0
}
