// 回归：while/elif 条件内借用临时量每轮求值后 drop（不泄漏、不提升到循环外）
import "io"
extern "C" fn __ayanami_live_allocs() -> int;

fn f_ref(ref String s) -> int { return s.len() as int }

fn pick(int x) -> int {
    if x == 1 { return 1 }
    elif f_ref("xx") == 2 { return 2 }
    else { return 3 }
}

fn run() -> int {
    i = 0
    n = 0
    while f_ref("x") == 1 {
        n = n + pick(0)
        i = i + 1
        if i > 50 { break }
    }
    return n
}

fn main() -> int {
    n = run()
    if n != 102 { return 1 }
    live = __ayanami_live_allocs()
    if live != 0 { println(live); return 2 }
    return 0
}
