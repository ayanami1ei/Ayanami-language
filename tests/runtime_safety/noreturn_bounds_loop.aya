// 回归：panic（#[noreturn]）分支的发散性——边界检查隐藏文件参数在正常路径正常释放，
// 迭代器/带边界检查的调用循环不泄漏
import "io"
import "iter"
import "arraylist"
extern "C" fn __ayanami_live_allocs() -> int;

fn run() -> int {
    a = ArrayList::new[int]()
    a.push(1)
    a.push(2)
    it = a.into_iter()
    s = 0
    for x in it { s = s + x }
    return s
}

fn main() -> int {
    n = run()
    if n != 3 { return 1 }
    live = __ayanami_live_allocs()
    if live != 0 { println(live); return 2 }
    return 0
}
