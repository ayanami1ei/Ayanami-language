import "string";

// 分支表达式（match/if）的臂结果赋值必须移出绑定局部量（清零绑定，避免作用域末尾
// drop 已交给结果变量的堆数据 → 调用方 double free / 悬空指针）。
enum Holder[T] {
    Some(T),
    None,
}

impl[T] Holder[T] {
    fn take(self, T fallback) -> T {
        match self {
            Holder::Some(v) => v,
            Holder::None => fallback,
        }
    }
}

fn take_free[T](Holder[T] h, T fallback) -> T {
    match h {
        Holder::Some(v) => v,
        Holder::None => fallback,
    }
}

fn pick(bool b) -> String {
    s = "hello"
    r = if b { s } else { "x" }
    return r
}

struct Big {
    String a
    String b
}

// >16 字节载荷走装箱变体（N2：_data_Some 为 Unique），同样必须正确移出。
fn boxed_move() -> int {
    b = Big { a = "hello", b = "world" }
    h = Holder::Some(b)
    r = h.take(Big { a = "x", b = "y" })
    if r.a != "hello" { return 1 }
    if r.b != "world" { return 2 }
    return 0
}

fn main() -> int {
    a = Holder::Some("hello")
    s = a.take("x")
    if s != "hello" { return 1 }
    b = Holder::Some("world")
    t = take_free(b, "y")
    if t != "world" { return 2 }
    c = Holder::Some("!")
    u = c.take("z")
    if u != "!" { return 3 }
    p = pick(true)
    if p != "hello" { return 4 }
    q = pick(false)
    if q != "x" { return 6 }
    if boxed_move() != 0 { return 7 }
    return s.len as int
}
