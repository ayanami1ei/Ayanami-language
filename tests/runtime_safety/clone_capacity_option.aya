// #170：拥有动态数组字段的结构体 clone（ArrayList 经 Option 返回后字段读取）
// clone 只分配 len 槽，目标 capability 必须改写为 len，否则 drop 越界释放
import "arraylist"
import "option"
import "string"
import "io"

extern "C" fn __ayanami_live_allocs() -> int;

fn make() -> Option[ArrayList[String]] {
    res = ArrayList::new[String]()
    res.push("a1")
    res.push("b2")
    res.push("c3")
    res.push("d4")
    res.push("e5")
    res.push("f6")
    res.push("g7")
    res.push("h8")
    res.push("i9")
    return Option::Some(res)
}

fn run() -> int {
    o = make()
    e = o._data_Some._0
    if e.len() != 9 { return 1 }
    if e.index(0).len() != 2 { return 2 }
    if e.index(8).len() != 2 { return 3 }
    return 0
}

fn main() -> int {
    r = run()
    if r != 0 { return r }
    live = __ayanami_live_allocs()
    if live != 0 { println(live); return 4 }
    return 0
}
