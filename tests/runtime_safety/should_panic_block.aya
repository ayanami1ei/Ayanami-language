import "alloc";

// #88：语句块级标注 `#[should_panic] { ... }` 由子进程捕获 panic。
import "io"
import "test"

fn main() -> int {
    captured = 0
    #[should_panic]
    {
        #assert_eq(captured, 1)
    }
    {
        y = 2
        #assert_eq(y, 2)
    }
    live = live_allocs()
    if live != 0 { println(live); return 2 }
    return 0
}
