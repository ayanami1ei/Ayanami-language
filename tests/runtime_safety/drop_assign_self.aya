// 回归：自赋值 `s = s + t` 旧值在 RHS 求值后释放（无 use-after-free / 泄漏）
import "io"
extern "C" fn __ayanami_live_allocs() -> int;

fn run() -> int {
    t = "ab"
    s = ""
    i = 0
    while i < 3 {
        s = s + t
        i = i + 1
    }
    return s.len() as int
}

fn main() -> int {
    n = run()
    if n != 6 { return 1 }
    live = __ayanami_live_allocs()
    if live != 0 { println(live); return 2 }
    return 0
}
