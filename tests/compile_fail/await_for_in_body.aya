import "option"

enum Poll[T] { Ready(T), Pending }
struct Context { int x }

struct RangeIter {
    int cur
    int end
}
impl RangeIter {
    fn next(ref mut self) -> Option[int] {
        if self.cur >= self.end { return Option::None }
        v = self.cur
        self.cur = self.cur + 1
        return Option::Some(v)
    }
}

#[async]
fn inc(int x) -> int { return x + 1 }

#[async]
fn bad(int x) -> int {
    y = 0
    for v in (RangeIter { cur = 0, end = 2 }) {
        y = y + (await inc(v))
    }
    return y
}

fn main() -> int { return 0 }
