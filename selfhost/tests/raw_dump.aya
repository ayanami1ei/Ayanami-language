// 临时诊断工具：PARSE_FILE=path —— 打印 lambda 子树的原始 arena 结构
import "io";
import "aya_file";
import "aya_sys";
import "aya_parser";

fn walk(ref Ast ast, int id, int depth) {
    if id < 0 { return; }
    if depth > 12 { return; }
    i = 0;
    while i < depth { print("  "); i = i + 1; }
    print("id=");
    print(id);
    print(" tag=");
    print(ast.tags[id]);
    print(" aa=");
    print(ast.aa[id]);
    print(" bb=");
    print(ast.bb[id]);
    print(" nx=");
    print(ast.nexts[id]);
    print(" tx=");
    println(ast.texts[id]);
}

fn scan(ref Ast ast, int id, int depth) {
    if depth > 12 { return; }
    while id >= 0 {
        walk(ast, id, depth);
        if ast.tags[id] == 23 {
            // ET::Lambda
            print("LAMBDA-BODY\n");
            scan(ast, ast.bb[id], depth + 1);
        } else {
            if ast.aa[id] >= 0 { scan(ast, ast.aa[id], depth + 1); }
            if ast.bb[id] >= 0 { scan(ast, ast.bb[id], depth + 1); }
        }
        id = ast.nexts[id];
    }
}

fn main() -> int {
    path = env("PARSE_FILE");
    r = read_file(path);
    if !r.ok { println("cannot read"); return 2 }
    p = Parser::new(r.data);
    prog = p.parse_program();
    if p.failed == 1 { println("parse error"); return 3 }
    scan(p.ast, prog, 0);
    return 0;
}
