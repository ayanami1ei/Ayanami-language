import "string";
// 回归：String::new(本地数组, len) 返回后不悬空（坑 2 / bd 3hh，2026-10-17 已修）
fn make() -> String {
    buf = [char; 3]
    buf[0] = 'a'
    buf[1] = 'b'
    buf[2] = 'c'
    return String::new(buf, 3 as usize)
}

fn main() -> int {
    s = make()
    if s.len != 3 { return 1 }
    if s != "abc" { return 2 }
    return 0
}
