import "string";
// 探针：fread(ref int) 出参（#154 已修？）
extern "C" fn fopen([char] path, [char] mode) -> int;
extern "C" fn fclose(int f) -> int;
extern "C" fn fread([char] buf, int sz, int n, int f) -> int;

fn main() -> int {
    b = [char; 4]
    b[0] = 0
    f = fopen(to_cstr("selfhost/ayanami.toml"), to_cstr("r"))
    if f == 0 { return 1 }
    n = fread(b, 1, 3, f)
    fclose(f)
    if n != 3 { return 2 }
    return 0
}
