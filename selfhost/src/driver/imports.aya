// M6e：import 合并 —— 把入口文件与其（递归）依赖合并成单源，
// 依赖别名来自最近的 ayanami.toml 的 [dependencies] 段。
// 说明：stage-1 的模块系统是「文本合并」：跳过 import 行，其余按序拼接。
import "io";
import "string";
import "aya_file";
import "aya_sb";
import "aya_sys";
import "aya_path";
import "aya_log";

pub struct Deps {
    [String] names
    [String] paths
    int count
}

pub struct Seen {
    [String] files
    int count
}

pub namespace Deps {
    #[alloc]
    pub fn new() -> Deps {
        return Deps { names = [String; 256], paths = [String; 256], count = 0 };
    }
}

impl Deps {
    #[alloc]
    #[state]
    fn add(ref mut self, ref String name, ref String path) {
        if self.count >= 256 { return; }
        self.names[self.count] = name.copy();
        self.paths[self.count] = path.copy();
        self.count = self.count + 1;
    }

    #[alloc]
    #[state]
    fn path_of(ref self, ref String name) -> String {
        i = 0;
        while i < self.count {
            if self.names[i] == name { return self.paths[i].copy(); }
            i = i + 1;
        }
        return "";
    }
}

pub namespace Seen {
    #[alloc]
    pub fn new() -> Seen {
        return Seen { files = [String; 256], count = 0 };
    }
}

impl Seen {
    // 注意：`ref self` 方法不能在 `ref mut` 变量上调用（stage-0 限制，见 issue），
    // 这里统一用 ref mut self
    fn has(ref mut self, ref String f) -> bool {
        i = 0;
        while i < self.count {
            if self.files[i] == f { return true; }
            i = i + 1;
        }
        return false;
    }

    #[alloc]
    #[state]
    fn add(ref mut self, ref String f) {
        if self.count >= 256 { return; }
        self.files[self.count] = f.copy();
        self.count = self.count + 1;
    }
}

/// 行首空白数
fn lead_ws(ref String line) -> int {
    i = 0;
    while i < line.len as int {
        c = char_code(line.index(i as usize));
        if c != 32 && c != 9 { break; }
        i = i + 1;
    }
    return i;
}

/// 去掉行首空白
fn trim_start2(ref String line) -> String {
    n = lead_ws(line);
    if n == 0 { return line.copy(); }
    return line.substring(n as usize, line.len);
}

/// 去掉行尾空白与 \r
fn trim_end2(ref String line) -> String {
    e = line.len as int;
    while e > 0 {
        c = char_code(line.index((e - 1) as usize));
        if c != 32 && c != 9 && c != 13 { break; }
        e = e - 1;
    }
    return line.substring(0 as usize, e as usize);
}

/// import "alias"; -> alias（否则 ""）
fn import_alias(ref String line) -> String {
    t = trim_start2(line);
    if t.len < 7 { return ""; }
    if !t.starts_with("import") { return ""; }
    // 找第一个引号
    i = 0;
    q1 = -1;
    while i < t.len as int {
        if t.index(i as usize) == '"' {
            q1 = i;
            break;
        }
        i = i + 1;
    }
    if q1 < 0 { return ""; }
    j = q1 + 1;
    q2 = -1;
    while j < t.len as int {
        if t.index(j as usize) == '"' {
            q2 = j;
            break;
        }
        j = j + 1;
    }
    if q2 < 0 { return ""; }
    return t.substring((q1 + 1) as usize, q2 as usize);
}

/// 从 file 所在目录向上找 ayanami.toml（最多 3 层），返回目录（含尾 /）或 ""
#[alloc]
#[state]
pub fn find_manifest_dir(ref String file) -> String {
    d = Path::dir(file);
    if d.len == 0 { d = "."; }
    if d.len > 0 {
        if d.index((d.len - 1) as usize) != '/' {
            d = d + "/";
        }
    }
    up = d;
    i = 0;
    while i < 3 {
        t = up + "ayanami.toml";
        r = read_file(t);
        if r.ok { return up; }
        // 上一级：跳过尾部 '/'，再找上一个 '/'
        cut = up.len as int - 1;
        if cut > 0 {
            if up.index(cut as usize) == '/' {
                cut = cut - 1;
            }
        }
        while cut > 0 {
            if up.index(cut as usize) == '/' { break; }
            cut = cut - 1;
        }
        if cut <= 0 { break; }
        up = up.substring(0 as usize, (cut + 1) as usize);
        i = i + 1;
    }
    return "";
}

/// 解析 ayanami.toml 的 [dependencies]：name = "path"
#[alloc]
#[state]
pub fn load_deps(ref String manifest_dir) -> Deps {
    d = Deps::new();
    if manifest_dir.len == 0 { return d; }
    r = read_file(manifest_dir + "ayanami.toml");
    if !r.ok { return d; }
    in_deps = 0;
    start = 0;
    i = 0;
    while i <= r.data.len as int {
        at_end = 0;
        if i == r.data.len as int { at_end = 1; }
        is_nl = 0;
        if at_end == 0 {
            if char_code(r.data.index(i as usize)) == 10 { is_nl = 1; }
        }
        if at_end == 1 || is_nl == 1 {
            line = r.data.substring(start as usize, i as usize);
            line = trim_end2(line);
            t = trim_start2(line);
            if t.len > 0 {
                if t.index(0) == '[' {
                    // [section]
                    if t.starts_with("[dependencies]") {
                        in_deps = 1;
                    } else {
                        in_deps = 0;
                    }
                } elif in_deps == 1 {
                    // name = "path"
                    eq = -1;
                    k = 0;
                    while k < t.len as int {
                        if t.index(k as usize) == '=' { eq = k; break; }
                        k = k + 1;
                    }
                    if eq > 0 {
                        nm = t.substring(0 as usize, eq as usize);
                        nm = trim_end2(nm);
                        rest = t.substring((eq + 1) as usize, t.len);
                        rest = trim_start2(rest);
                        if rest.len >= 2 {
                            if rest.index(0) == '"' {
                                q = rest.len as int - 1;
                                if rest.index(q as usize) == '"' {
                                    pv = rest.substring(1 as usize, q as usize);
                                    d.add(nm, pv);
                                }
                            }
                        }
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return d;
}

/// 是否启用 std 源码合并（默认开；AYANAMI_STD_SRC=0 关闭）
/// 自举源码自身的 import 全部经 ayanami.toml 解析，不会落到 std 回退
fn std_src_enabled() -> int {
    v = env("AYANAMI_STD_SRC");
    if v == "0" { return 0; }
    return 1;
}

/// 在 std 源码树中查模块：从 start_dir 向上找 std/src/{core,collections,system,meta,dev}/<stem>.aya
#[alloc]
#[state]
fn std_src_path(ref String start_dir, ref String stem) -> String {
    if std_src_enabled() == 0 { return ""; }
    if stem.len == 0 { return ""; }
    d = start_dir.copy();
    if d.len > 0 {
        if d.index((d.len - 1) as usize) != '/' { d = d + "/"; }
    }
    i = 0;
    while i < 4 {
        // std/src/<stem>.aya
        p0 = d + "std/src/";
        p0 = p0 + stem;
        p0 = p0 + ".aya";
        if file_exists(p0) { return p0; }
        subs = ["core", "collections", "system", "meta", "dev"];
        k = 0;
        while k < 5 {
            p = d + "std/src/";
            p = p + subs[k];
            p = p + "/";
            p = p + stem;
            p = p + ".aya";
            if file_exists(p) { return p; }
            k = k + 1;
        }
        // 上一级（到顶后改用相对 CWD）
        if d.len == 0 { break; }
        cut = d.len as int - 1;
        if d.index(cut as usize) == '/' { cut = cut - 1; }
        while cut > 0 {
            if d.index(cut as usize) == '/' { break; }
            cut = cut - 1;
        }
        if cut <= 0 {
            d = "";
        } else {
            d = d.substring(0 as usize, (cut + 1) as usize);
        }
        i = i + 1;
    }
    return "";
}

/// 输出单个文件正文（import 行补空行保行号），并把 import 目标加入 Seen 队列；返回输出行数
#[alloc]
#[state]
pub fn collect_lines(ref String file, ref Deps deps, ref mut Seen seen, ref mut StringBuf dst, ref String mdir) -> int {
    lines_out = 0;
    r = read_file(file);
    if !r.ok { return 0; }
    fdir = Path::dir(file);
    if fdir.len == 0 { fdir = "."; }
    start = 0;
    i = 0;
    while i <= r.data.len as int {
        at_end = 0;
        if i == r.data.len as int { at_end = 1; }
        is_nl = 0;
        if at_end == 0 {
            if char_code(r.data.index(i as usize)) == 10 { is_nl = 1; }
        }
        if at_end == 1 || is_nl == 1 {
            line = r.data.substring(start as usize, i as usize);
            al = import_alias(line);
            if al.len > 0 {
                // 两段式合并：模块内容不内联（否则推移后续行号），只入队
                pv = deps.path_of(al);
                if pv.len > 0 {
                    if !seen.has(mdir + pv) { seen.add(mdir + pv); }
                } else {
                    added = 0;
                    // 相对路径 import（如 "../std/std.aya"）：按文件目录直接解析
                    if Path::is_aya(al) {
                        rp = Path::join(fdir, al);
                        if file_exists(rp) {
                            if !seen.has(rp) { seen.add(rp); }
                            added = 1;
                        }
                        if added == 0 {
                            // 再按文件名在 std/src 各子目录查（std 源码合并）
                            st2 = Path::stem(Path::file_name(al));
                            sp3 = std_src_path(fdir, st2);
                            if sp3.len > 0 {
                                if !seen.has(sp3) { seen.add(sp3); }
                                added = 1;
                            }
                        }
                    } elif al.ends_with(".lcl") {
                        // 预编译包版本检查（自举不消费 .lcl 内容）：回退到同目录 .aya 源码
                        lp0 = Path::join(fdir, al);
                        rr0 = read_file(lp0);
                        if rr0.ok {
                            dat0 = rr0.data;
                            pat0 = "version=\"";
                            pp0 = dat0.index_of(pat0);
                            if pp0 >= 0 {
                                st0 = pp0 + (pat0.len as int);
                                en0 = -1;
                                q0 = st0;
                                while q0 < dat0.len as int {
                                    if char_code(dat0.index(q0 as usize)) == 34 { en0 = q0; break; }
                                    q0 = q0 + 1;
                                }
                                if en0 > st0 {
                                    pv0 = dat0.substring(st0 as usize, en0 as usize);
                                    nm0 = Path::stem(Path::file_name(al));
                                    if pv0 != ayanami_version() {
                                        raw_warn("package '" + nm0 + "' was built with ayanami " + pv0 + ", current " + ayanami_version() + "; rebuild it (at " + lp0 + ")");
                                    }
                                }
                            }
                        }
                        al2 = Path::stem(al) + ".aya";
                        rp2 = Path::join(fdir, al2);
                        if file_exists(rp2) {
                            if !seen.has(rp2) { seen.add(rp2); }
                            added = 1;
                        }
                    }
                    if added == 0 {
                        // std 源码回退（AYANAMI_STD_SRC=1）
                        sp2 = std_src_path(fdir, al);
                        if sp2.len > 0 {
                            if !seen.has(sp2) { seen.add(sp2); }
                        }
                    }
                }
                // import 行补空行：保持本文件行号与原始一致
                dst.push('\n');
            } else {
                dst.push_str(line);
                dst.push('\n');
            }
            lines_out = lines_out + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return lines_out;
}

/// 自举 prelude 路径（String 方法补全）：按候选顺序找存在的文件
fn prelude_path(ref String mdir) -> String {
    c1 = mdir + "selfhost/src/base/prelude.aya";
    if read_file(c1).ok { return c1; }
    c2 = mdir + "src/base/prelude.aya";
    if read_file(c2).ok { return c2; }
    c3 = mdir + "../selfhost/src/base/prelude.aya";
    if read_file(c3).ok { return c3; }
    c4 = "selfhost/src/base/prelude.aya";
    if read_file(c4).ok { return c4; }
    return "";
}

/// 合并源行映射：每个追加文件的 (路径, 起始行, 行数)，用于诊断回映原文件坐标
pub struct SrcMap {
    [String] files
    [int] start
    [int] count
    int n
    int cur_line
}

pub namespace SrcMap {
    #[alloc]
    pub fn new() -> SrcMap {
        return SrcMap { files = [String; 256], start = [int; 256], count = [int; 256], n = 0, cur_line = 0 };
    }
}

impl SrcMap {
    #[alloc]
    #[state]
    fn add(ref mut self, ref String f, int st, int cnt) {
        if self.n >= 256 { return; }
        self.files[self.n] = f.copy();
        self.start[self.n] = st;
        self.count[self.n] = cnt;
        self.n = self.n + 1;
    }

    /// 合并行 -> 原文件；原行写入 cur_line（无命中返回空串）
    #[alloc]
    #[state]
    pub fn resolve(ref mut self, int line) -> String {
        i = 0;
        while i < self.n {
            if line >= self.start[i] && line < self.start[i] + self.count[i] {
                self.cur_line = line - self.start[i] + 1;
                return self.files[i].copy();
            }
            i = i + 1;
        }
        self.cur_line = line;
        return "";
    }
}

/// 入口：返回合并后的源码（解析失败时返回单文件内容）
#[alloc]
#[state]
pub fn merge_source(ref String file) -> String {
    m = SrcMap::new();
    return merge_source_map(file, m);
}

/// 同 merge_source，同时填充行映射（诊断回映原文件坐标）
#[alloc]
#[state]
pub fn merge_source_map(ref String file, ref mut SrcMap map) -> String {
    mdir = find_manifest_dir(file);
    deps = load_deps(mdir);
    seen = Seen::new();
    dst = StringBuf::new();
    // 两段式：根文件正文在前（行号与原始一致），模块按队列追加在后
    seen.add(file);
    ln0 = collect_lines(file, deps, seen, dst, mdir);
    map.add(file, 1, ln0);
    cur = ln0 + 1;
    qi = 1;
    while qi < seen.count {
        f2 = seen.files[qi].copy();
        ln2 = collect_lines(f2, deps, seen, dst, mdir);
        map.add(f2, cur, ln2);
        cur = cur + ln2;
        qi = qi + 1;
    }
    // 自举 prelude：最后追加（缺失时静默跳过）
    pp = prelude_path(mdir);
    if pp.len > 0 {
        if !seen.has(pp) {
            seen.add(pp);
            ln3 = collect_lines(pp, deps, seen, dst, mdir);
            map.add(pp, cur, ln3);
            cur = cur + ln3;
        }
    }
    return dst.to_string();
}
