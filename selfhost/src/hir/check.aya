import "string";
import "aya_sb";
import "aya_ast";
import "aya_log";

// M4b：HIR 子集类型检查（名称解析 + 表达式/语句类型检查）
// 诊断格式与 rust 版 `ayanami check` 对齐：error: msg + file:line:col
// 类型用显示名字符串表示（"int"/"float"/"bool"/"char"/"void"/"String"/结构体名…），
// "" 表示未知（跳过检查）。

pub struct Checker {
    int errors
    String file
    // 函数表
    [String] fn_names
    [String] fn_rets
    [int] fn_nparams
    [int] fn_pstart
    [String] fn_ptypes
    int fn_ptotal
    int fn_count
    // 方法表（impl 内，按接收者类型）
    [String] m_recv
    [String] m_names
    [int] m_nparams
    [int] m_pstart
    [String] m_ptypes
    int m_ptotal
    int m_count
    // 结构体表
    [String] st_names
    [int] st_fstart
    [int] st_fcount
    int st_count
    [String] fld_names
    [String] fld_types
    int fld_count
    // 接口表（名 -> 方法名）
    [String] if_names
    [int] if_mstart
    [int] if_mcount
    [String] if_methods
    int if_mtotal
    int if_count
    // 当前泛型参数（名 -> 约束接口名）
    [String] gp_names
    [String] gp_bounds
    int gp_count
    // 枚举表
    [String] en_names
    [int] en_vstart
    [int] en_vcount
    [String] en_variants
    int en_count
    // 当前函数局部变量
    [String] lv_names
    [String] lv_types
    int lv_count
    // 当前函数
    String cur_fn
    String cur_ret
}

pub namespace Checker {
    pub fn new(ref String file) -> Checker {
        c = Checker {
            errors = 0,
            file = file.copy(),
            fn_names = [String; 4096],
            fn_rets = [String; 4096],
            fn_nparams = [int; 4096],
            fn_pstart = [int; 4096],
            fn_ptypes = [String; 16384],
            fn_ptotal = 0,
            fn_count = 0,
            m_recv = [String; 2048],
            m_names = [String; 2048],
            m_nparams = [int; 2048],
            m_pstart = [int; 2048],
            m_ptypes = [String; 8192],
            m_ptotal = 0,
            m_count = 0,
            st_names = [String; 1024],
            st_fstart = [int; 1024],
            st_fcount = [int; 1024],
            st_count = 0,
            fld_names = [String; 8192],
            fld_types = [String; 8192],
            fld_count = 0,
            if_names = [String; 512],
            if_mstart = [int; 512],
            if_mcount = [int; 512],
            if_methods = [String; 4096],
            if_mtotal = 0,
            if_count = 0,
            gp_names = [String; 64],
            gp_bounds = [String; 64],
            gp_count = 0,
            en_names = [String; 512],
            en_vstart = [int; 512],
            en_vcount = [int; 512],
            en_variants = [String; 4096],
            en_count = 0,
            lv_names = [String; 4096],
            lv_types = [String; 4096],
            lv_count = 0,
            cur_fn = "",
            cur_ret = ""
        };
        return c;
    }
}

fn str_starts_with(ref String s, ref String prefix) -> bool {
    if prefix.len > s.len { return false; }
    i = 0;
    while i < prefix.len as int {
        if s.index(i as usize) != prefix.index(i as usize) { return false; }
        i = i + 1;
    }
    return true;
}

/// 去掉 ref 前缀与泛型实参：ref mut C[T] -> C
fn base_type(ref String t) -> String {
    u = t.copy();
    if str_starts_with(u, "ref mut ") {
        u = u.substring(8 as usize, u.len);
    } elif str_starts_with(u, "ref ") {
        u = u.substring(4 as usize, u.len);
    }
    i = 0;
    while i < u.len as int {
        if u.index(i as usize) == '[' {
            return u.substring(0 as usize, i as usize);
        }
        i = i + 1;
    }
    return u.copy();
}

/// 运算符 -> 方法名
fn op_method_name(int op) -> String {
    if op == bo(BinOp::Eq._tag) { return "eq"; }
    if op == bo(BinOp::Neq._tag) { return "ne"; }
    if op == bo(BinOp::Add._tag) { return "add"; }
    if op == bo(BinOp::Sub._tag) { return "sub"; }
    if op == bo(BinOp::Mul._tag) { return "mul"; }
    if op == bo(BinOp::Div._tag) { return "div"; }
    if op == bo(BinOp::Mod._tag) { return "rem"; }
    if op == bo(BinOp::Lt._tag) { return "lt"; }
    if op == bo(BinOp::Gt._tag) { return "gt"; }
    if op == bo(BinOp::Le._tag) { return "le"; }
    if op == bo(BinOp::Ge._tag) { return "ge"; }
    return "";
}

/// 运算符显示名（诊断用）
fn op_disp_name(int op) -> String {
    if op == bo(BinOp::Eq._tag) { return "Eq"; }
    if op == bo(BinOp::Neq._tag) { return "Neq"; }
    if op == bo(BinOp::Add._tag) { return "Add"; }
    if op == bo(BinOp::Sub._tag) { return "Sub"; }
    if op == bo(BinOp::Mul._tag) { return "Mul"; }
    if op == bo(BinOp::Div._tag) { return "Div"; }
    if op == bo(BinOp::Mod._tag) { return "Mod"; }
    if op == bo(BinOp::Lt._tag) { return "Lt"; }
    if op == bo(BinOp::Gt._tag) { return "Gt"; }
    if op == bo(BinOp::Le._tag) { return "Le"; }
    if op == bo(BinOp::Ge._tag) { return "Ge"; }
    return "";
}

fn contains_dot(ref String s) -> bool {
    i = 0;
    while i < s.len as int {
        if s.index(i as usize) == '.' { return true; }
        i = i + 1;
    }
    return false;
}

/// AST 类型节点 -> 显示名
pub fn type_name(ref Ast ast, int ty) -> String {
    if ty < 0 { return ""; }
    t = ast.tags[ty];
    if t == tt(TT::Int._tag) { return "int"; }
    if t == tt(TT::Float._tag) { return "float"; }
    if t == tt(TT::Char._tag) { return "char"; }
    if t == tt(TT::Bool._tag) { return "bool"; }
    if t == tt(TT::Void._tag) { return "void"; }
    if t == tt(TT::Never._tag) { return "!"; }
    if t == tt(TT::Self_._tag) { return "Self"; }
    if t == tt(TT::Named._tag) { return ast.texts[ty].copy(); }
    if t == tt(TT::Closure._tag) { return "Fn(...)"; }
    if t == tt(TT::FnPtr._tag) { return "Fn(...)"; }
    if t == tt(TT::Array._tag) {
        b = StringBuf::new();
        b.push_str("[");
        b.push_str(type_name(ast, ast.aa[ty]));
        b.push_str("]");
        return b.to_string();
    }
    if t == tt(TT::ArraySized._tag) {
        b = StringBuf::new();
        b.push_str("[");
        b.push_str(type_name(ast, ast.aa[ty]));
        b.push_str("; ");
        b.push_int(ast.bb[ty]);
        b.push_str("]");
        return b.to_string();
    }
    if t == tt(TT::Ref._tag) {
        b = StringBuf::new();
        if ast.bb[ty] == 1 { b.push_str("ref mut "); } else { b.push_str("ref "); }
        b.push_str(type_name(ast, ast.aa[ty]));
        return b.to_string();
    }
    if t == tt(TT::Generic._tag) {
        b = StringBuf::new();
        b.push_str(ast.texts[ty]);
        b.push_str("[");
        g = ast.aa[ty];
        first = 1;
        while g >= 0 {
            if first == 0 { b.push_str(","); }
            b.push_str(type_name(ast, ast.tys[g]));
            first = 0;
            g = ast.nexts[g];
        }
        b.push_str("]");
        return b.to_string();
    }
    return "";
}

/// 后缀 -> 显示类型（usize/isize 在诊断里显示为 u64/i64）
fn suffix_type(ref String suf) -> String {
    if suf == "usize" { return "u64"; }
    if suf == "isize" { return "i64"; }
    if suf == "f64" { return "float"; }
    return suf.copy();
}

/// 数值 rank（int < f32 < float）；非数值返回 -1
fn num_rank(ref String t) -> int {
    if t == "int" { return 0; }
    if t == "f32" { return 1; }
    if t == "float" { return 2; }
    return -1;
}

fn is_int_type(ref String t) -> bool {
    if t == "int" { return true; }
    if t.len == 0 { return false; }
    c = t.index(0);
    if c == 'u' { return true; }
    if c == 'i' { return true; }
    return false;
}

/// 取模式里的变体名（E.V -> V）
fn pat_variant_name(ref String v) -> String {
    i = 0;
    while i < v.len as int {
        if v.index(i as usize) == '.' {
            return v.substring((i + 1) as usize, v.len);
        }
        i = i + 1;
    }
    return v.copy();
}

/// 是否原始类型（match 穷尽要求 _）
fn is_prim_type(ref String t) -> bool {
    if t == "int" { return true; }
    if t == "float" { return true; }
    if t == "f32" { return true; }
    if t == "char" { return true; }
    if t == "String" { return true; }
    if t.len == 0 { return false; }
    c = t.index(0);
    if c == 'u' { return true; }
    if c == 'i' { return true; }
    return false;
}

/// 是否可隐式转换（int/float、bool/int 之间不可隐式转换）
fn convertible(ref String from, ref String to) -> bool {
    if from.len == 0 { return true; }
    if to.len == 0 { return true; }
    if from == to { return true; }
    if from == "!" { return true; }
    return false;
}

impl Checker {
    fn err(ref mut self, ref String msg, int line, int col) {
        self.errors = self.errors + 1;
        error_at(self.file, line, col, msg);
    }

    fn err_name(ref mut self, ref String prefix, ref String name, int line, int col) {
        b = StringBuf::new();
        b.push_str(prefix);
        b.push_str(name);
        b.push_str("`");
        self.err(b.to_string(), line, col);
    }

    fn find_fn(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.fn_count {
            if self.fn_names[i] == name { return i; }
            i = i + 1;
        }
        return -1;
    }

    fn find_method(ref mut self, ref String recv, ref String name) -> int {
        i = 0;
        while i < self.m_count {
            if self.m_recv[i] == recv {
                if self.m_names[i] == name { return i; }
            }
            i = i + 1;
        }
        return -1;
    }

    fn find_struct(ref mut self, ref String name) -> int {
        base = base_type(name);
        i = 0;
        while i < self.st_count {
            if self.st_names[i] == base { return i; }
            i = i + 1;
        }
        return -1;
    }

    fn find_interface(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.if_count {
            if self.if_names[i] == name { return i; }
            i = i + 1;
        }
        return -1;
    }

    fn has_if_method(ref mut self, int ifi, ref String name) -> bool {
        start = self.if_mstart[ifi];
        n = self.if_mcount[ifi];
        i = 0;
        while i < n {
            if self.if_methods[start + i] == name { return true; }
            i = i + 1;
        }
        return false;
    }

    fn gp_bound(ref mut self, ref String name) -> String {
        i = 0;
        while i < self.gp_count {
            if self.gp_names[i] == name { return self.gp_bounds[i].copy(); }
            i = i + 1;
        }
        return "";
    }

    fn is_gp(ref mut self, ref String name) -> bool {
        i = 0;
        while i < self.gp_count {
            if self.gp_names[i] == name { return true; }
            i = i + 1;
        }
        return false;
    }

    /// 载入泛型参数链到当前上下文
    fn load_generics(ref mut self, ref Ast ast, int chain) {
        self.gp_count = 0;
        g = chain;
        while g >= 0 {
            if self.gp_count < 64 {
                self.gp_names[self.gp_count] = ast.texts[g].copy();
                self.gp_bounds[self.gp_count] = type_name(ast, ast.tys[g]);
                self.gp_count = self.gp_count + 1;
            }
            g = ast.nexts[g];
        }
    }

    /// 重复泛型参数检查
    fn check_dup_generics(ref mut self, ref Ast ast, int chain, int line, int col) {
        g = chain;
        while g >= 0 {
            h = ast.nexts[g];
            while h >= 0 {
                if ast.texts[g] == ast.texts[h] {
                    b = StringBuf::new();
                    b.push_str("generic parameter `");
                    b.push_str(ast.texts[g]);
                    b.push_str("` is declared more than once (multi-bound syntax is not supported yet; use a single constraint)");
                    self.err(b.to_string(), line, col);
                    return;
                }
                h = ast.nexts[h];
            }
            g = ast.nexts[g];
        }
    }

    fn find_field(ref mut self, int st, ref String name) -> int {
        start = self.st_fstart[st];
        n = self.st_fcount[st];
        i = 0;
        while i < n {
            if self.fld_names[start + i] == name { return start + i; }
            i = i + 1;
        }
        return -1;
    }

    fn find_enum(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.en_count {
            if self.en_names[i] == name { return i; }
            i = i + 1;
        }
        return -1;
    }

    fn has_variant(ref mut self, int en, ref String name) -> bool {
        start = self.en_vstart[en];
        n = self.en_vcount[en];
        i = 0;
        while i < n {
            if self.en_variants[start + i] == name { return true; }
            i = i + 1;
        }
        return false;
    }

    fn local_type(ref mut self, ref String name) -> String {
        i = 0;
        while i < self.lv_count {
            if self.lv_names[i] == name { return self.lv_types[i].copy(); }
            i = i + 1;
        }
        return "";
    }

    fn has_local(ref mut self, ref String name) -> bool {
        i = 0;
        while i < self.lv_count {
            if self.lv_names[i] == name { return true; }
            i = i + 1;
        }
        return false;
    }

    fn set_local(ref mut self, ref String name, ref String ty) {
        if self.lv_count >= 4096 { return; }
        self.lv_names[self.lv_count] = name.copy();
        self.lv_types[self.lv_count] = ty.copy();
        self.lv_count = self.lv_count + 1;
    }

    /// 预置常见 std/builtin 函数（返回类型未知 → 跳过类型检查）
    fn seed_std(ref mut self) {
        self.add_builtin("println");
        self.add_builtin("print");
        self.add_builtin("putchar");
        self.add_builtin("getchar");
        self.add_builtin("warn");
        self.add_builtin("note");
        self.add_builtin("panic");
        self.add_builtin("error_at");
    }

    fn add_builtin(ref mut self, ref String name) {
        if self.fn_count >= 4096 { return; }
        self.fn_names[self.fn_count] = name.copy();
        self.fn_rets[self.fn_count] = "";
        self.fn_nparams[self.fn_count] = -1;
        self.fn_pstart[self.fn_count] = self.fn_ptotal;
        self.fn_count = self.fn_count + 1;
    }

    // ---------- 收集声明 ----------

    fn collect(ref mut self, ref Ast ast, int prog) {
        self.collect_recv(ast, prog, "");
    }

    fn collect_recv(ref mut self, ref Ast ast, int prog, ref String recv) {
        s = ast.aa[prog];
        while s >= 0 {
            tag = ast.tags[s];
            if tag == st(ST::FnDecl._tag) {
                self.add_fn(ast, s, recv);
                self.check_dup_generics(ast, ast.cc[s], ast.lines[s], ast.cols[s]);
            } elif tag == st(ST::StructDef._tag) {
                self.add_struct(ast, s);
                self.check_dup_generics(ast, ast.bb[s], ast.lines[s], ast.cols[s]);
            } elif tag == st(ST::EnumDef._tag) {
                self.add_enum(ast, s);
            } elif tag == st(ST::InterfaceDef._tag) {
                self.add_interface(ast, s);
            } elif tag == st(ST::ImplBlock._tag) {
                self.check_dup_generics(ast, ast.bb[s], ast.lines[s], ast.cols[s]);
                self.collect_recv(ast, s, ast.texts[s]);
            } elif tag == st(ST::Namespace._tag) {
                self.collect_recv(ast, s, recv);
            }
            s = ast.nexts[s];
        }
    }

    fn add_fn(ref mut self, ref Ast ast, int id, ref String recv) {
        if recv.len == 0 {
            if self.fn_count >= 4096 { return; }
            fi = self.fn_count;
            self.fn_names[fi] = ast.texts[id].copy();
            self.fn_rets[fi] = type_name(ast, ast.tys[id]);
            self.fn_pstart[fi] = self.fn_ptotal;
            n = 0;
            p = ast.aa[id];
            while p >= 0 {
                if self.fn_ptotal < 16384 {
                    self.fn_ptypes[self.fn_ptotal] = type_name(ast, ast.tys[p]);
                    self.fn_ptotal = self.fn_ptotal + 1;
                }
                n = n + 1;
                p = ast.nexts[p];
            }
            self.fn_nparams[fi] = n;
            self.fn_count = fi + 1;
        } else {
            if self.m_count >= 2048 { return; }
            mi = self.m_count;
            self.m_recv[mi] = recv.copy();
            self.m_names[mi] = ast.texts[id].copy();
            self.m_pstart[mi] = self.m_ptotal;
            n = 0;
            p = ast.aa[id];
            while p >= 0 {
                if self.m_ptotal < 8192 {
                    self.m_ptypes[self.m_ptotal] = type_name(ast, ast.tys[p]);
                    self.m_ptotal = self.m_ptotal + 1;
                }
                n = n + 1;
                p = ast.nexts[p];
            }
            self.m_nparams[mi] = n;
            self.m_count = mi + 1;
        }
    }

    fn add_struct(ref mut self, ref Ast ast, int id) {
        if self.st_count >= 1024 { return; }
        st = self.st_count;
        self.st_names[st] = ast.texts[id].copy();
        self.st_fstart[st] = self.fld_count;
        n = 0;
        f = ast.aa[id];
        while f >= 0 {
            if self.fld_count < 8192 {
                self.fld_names[self.fld_count] = ast.texts[f].copy();
                self.fld_types[self.fld_count] = type_name(ast, ast.tys[f]);
                self.fld_count = self.fld_count + 1;
                n = n + 1;
            }
            f = ast.nexts[f];
        }
        self.st_fcount[st] = n;
        self.st_count = st + 1;
    }

    fn add_interface(ref mut self, ref Ast ast, int id) {
        if self.if_count >= 512 { return; }
        ii = self.if_count;
        self.if_names[ii] = ast.texts[id].copy();
        self.if_mstart[ii] = self.if_mtotal;
        n = 0;
        m = ast.aa[id];
        while m >= 0 {
            if self.if_mtotal < 4096 {
                self.if_methods[self.if_mtotal] = ast.texts[m].copy();
                self.if_mtotal = self.if_mtotal + 1;
                n = n + 1;
            }
            m = ast.nexts[m];
        }
        self.if_mcount[ii] = n;
        self.if_count = ii + 1;
    }

    fn add_enum(ref mut self, ref Ast ast, int id) {
        if self.en_count >= 512 { return; }
        en = self.en_count;
        self.en_names[en] = ast.texts[id].copy();
        // 变体扁平存储：前面所有枚举的变体数之和作为起点
        vstart = 0;
        i = 0;
        while i < en {
            vstart = vstart + self.en_vcount[i];
            i = i + 1;
        }
        self.en_vstart[en] = vstart;
        n = 0;
        v = ast.aa[id];
        while v >= 0 {
            if vstart + n < 4096 {
                self.en_variants[vstart + n] = ast.texts[v].copy();
                n = n + 1;
            }
            v = ast.nexts[v];
        }
        self.en_vcount[en] = n;
        self.en_count = en + 1;
    }

    // ---------- 检查函数体 ----------

    fn check_fn(ref mut self, ref Ast ast, int id) {
        self.lv_count = 0;
        if ast.cc[id] >= 0 {
            self.load_generics(ast, ast.cc[id]);
        }
        self.cur_fn = ast.texts[id].copy();
        self.cur_ret = type_name(ast, ast.tys[id]);
        p = ast.aa[id];
        while p >= 0 {
            self.set_local(ast.texts[p], type_name(ast, ast.tys[p]));
            p = ast.nexts[p];
        }
        self.check_block(ast, ast.bb[id]);
    }

    /// match 穷尽 + 未知变体检查；返回 scrutinee 类型
    fn check_match(ref mut self, ref Ast ast, int id) -> String {
        ty = self.check_expr(ast, ast.aa[id]);
        arms = ast.bb[id];
        wild = 0;
        has_true = 0;
        has_false = 0;
        struct_destr = 0;
        base = base_type(ty);
        en = self.find_enum(base);
        st = self.find_struct(base);
        a = arms;
        while a >= 0 {
            pk = ast.tys[a];
            if pk == 0 {
                wild = 1;
            } elif pk == 1 {
                vname = pat_variant_name(ast.texts[a]);
                if en >= 0 {
                    if !self.has_variant(en, vname) {
                        c0 = char_code(vname.index(0));
                        if c0 >= 65 && c0 <= 90 {
                            b = StringBuf::new();
                            b.push_str("unknown variant `");
                            b.push_str(vname);
                            b.push_str("` of enum `");
                            b.push_str(base);
                            b.push_str("`; use `_` for the catch-all arm");
                            self.err(b.to_string(), ast.lines[id], ast.cols[id]);
                        } else {
                            wild = 1;
                        }
                    }
                }
            } elif pk == 2 {
                if ast.texts[a] == "true" { has_true = 1; } else { has_false = 1; }
            } elif pk == 4 {
                struct_destr = 1;
            }
            a = ast.nexts[a];
        }
        rt = "";
        a2 = arms;
        while a2 >= 0 {
            if ast.aa[a2] >= 0 {
                rt = self.check_expr(ast, ast.aa[a2]);
                break;
            }
            a2 = ast.nexts[a2];
        }
        if wild == 0 {
            need = 0;
            if en >= 0 {
                start = self.en_vstart[en];
                n = self.en_vcount[en];
                i = 0;
                while i < n {
                    vname = self.en_variants[start + i].copy();
                    if !self.arms_cover_variant(ast, arms, vname) {
                        need = 1;
                        break;
                    }
                    i = i + 1;
                }
            } elif ty == "bool" {
                if !(has_true == 1 && has_false == 1) { need = 1; }
            } elif st >= 0 {
                if struct_destr == 0 { need = 1; }
            } elif is_prim_type(base) {
                need = 1;
            }
            if need == 1 {
                b = StringBuf::new();
                b.push_str("non-exhaustive match at ");
                b.push_int(ast.lines[id]);
                b.push_str(":");
                b.push_int(ast.cols[id]);
                b.push_str(" (add `_ =>` or cover all variants)");
                raw_error(b.to_string());
                self.errors = self.errors + 1;
            }
        }
        return rt;
    }

    fn arms_cover_variant(ref mut self, ref Ast ast, int arms, ref String vname) -> bool {
        a = arms;
        while a >= 0 {
            if ast.tys[a] == 1 {
                if pat_variant_name(ast.texts[a]) == vname { return true; }
            }
            a = ast.nexts[a];
        }
        return false;
    }

    fn check_block(ref mut self, ref Ast ast, int blk) {
        s = ast.aa[blk];
        while s >= 0 {
            self.check_stmt(ast, s);
            s = ast.nexts[s];
        }
        t = ast.bb[blk];
        if t >= 0 {
            self.check_expr(ast, t);
        }
    }

    fn check_stmt(ref mut self, ref Ast ast, int id) {
        tag = ast.tags[id];
        if tag == st(ST::FnDecl._tag) {
            self.check_fn(ast, id);
        } elif tag == st(ST::Assign._tag) {
            ty = self.check_expr(ast, ast.aa[id]);
            nm = ast.texts[id];
            if self.has_local(nm) {
                old = self.local_type(nm);
                if str_starts_with(old, "ref ") {
                    if !str_starts_with(old, "ref mut ") {
                        b = StringBuf::new();
                        b.push_str("cannot assign through an immutable reference `");
                        b.push_str(nm);
                        b.push_str("`");
                        self.err(b.to_string(), ast.lines[id], ast.cols[id]);
                        return;
                    }
                }
                if !convertible(ty, old) {
                    self.convert_err(ty, old, ast.lines[id], ast.cols[id]);
                }
            } else {
                self.set_local(nm, ty);
            }
        } elif tag == st(ST::Return._tag) {
            if ast.aa[id] >= 0 {
                ty = self.check_expr(ast, ast.aa[id]);
                if !convertible(ty, self.cur_ret) {
                    self.convert_err(ty, self.cur_ret, ast.lines[id], ast.cols[id]);
                }
            } else {
                if self.cur_ret.len > 0 {
                    if self.cur_ret != "void" {
                        if self.cur_ret != "!" {
                            b = StringBuf::new();
                            b.push_str("function `");
                            b.push_str(self.cur_fn);
                            b.push_str("` returns `");
                            b.push_str(self.cur_ret);
                            b.push_str("` but `return;` has no value");
                            self.err(b.to_string(), ast.lines[id], ast.cols[id]);
                        }
                    }
                }
            }
        } elif tag == st(ST::ExprStmt._tag) {
            self.check_expr(ast, ast.aa[id]);
        } elif tag == st(ST::If._tag) {
            self.check_expr(ast, ast.aa[id]);
            self.check_block(ast, ast.bb[id]);
            e = ast.cc[id];
            while e >= 0 {
                self.check_expr(ast, ast.aa[e]);
                self.check_block(ast, ast.bb[e]);
                e = ast.nexts[e];
            }
            if ast.dd[id] >= 0 {
                self.check_block(ast, ast.dd[id]);
            }
        } elif tag == st(ST::While._tag) {
            self.check_expr(ast, ast.aa[id]);
            self.check_block(ast, ast.bb[id]);
        } elif tag == st(ST::For._tag) {
            st1 = self.check_expr(ast, ast.aa[id]);
            st2 = self.check_expr(ast, ast.bb[id]);
            if st1.len > 0 && st2.len > 0 {
                if st1 != st2 {
                    if is_int_type(st1) && is_int_type(st2) {
                        b = StringBuf::new();
                        b.push_str("for bounds have different integer types: `");
                        b.push_str(st1);
                        b.push_str("` and `");
                        b.push_str(st2);
                        b.push_str("` (add an explicit cast)");
                        // 位置对齐 rust：body 块（`{`）位置
                        blk = ast.dd[id];
                        self.err(b.to_string(), ast.lines[blk], ast.cols[blk]);
                    }
                }
            }
            self.set_local(ast.texts[id], "int");
            self.check_block(ast, ast.dd[id]);
        } elif tag == st(ST::ForIn._tag) {
            it_ty = self.check_expr(ast, ast.aa[id]);
            ok_next = 1;
            disp = it_ty.copy();
            if it_ty.len > 0 {
                if it_ty.index(0) == '[' {
                    // 数组没有 next
                    disp = "unique " + it_ty;
                    ok_next = 0;
                } elif self.find_struct(it_ty) >= 0 {
                    if self.find_method(it_ty, "next") < 0 { ok_next = 0; }
                }
            }
            if ok_next == 0 {
                b = StringBuf::new();
                b.push_str("type `");
                b.push_str(disp);
                b.push_str("` has no method `next` for argument types ()");
                self.err(b.to_string(), ast.lines[id], ast.cols[id]);
            }
            self.set_local(ast.texts[id], "");
            self.check_block(ast, ast.bb[id]);
        } elif tag == st(ST::FieldAssign._tag) {
            ot = self.check_expr(ast, ast.aa[id]);
            vt = self.check_expr(ast, ast.bb[id]);
            st = self.find_struct(ot);
            if st >= 0 {
                fi = self.find_field(st, ast.texts[id]);
                if fi < 0 {
                    b = StringBuf::new();
                    b.push_str("结构体 `");
                    b.push_str(ot);
                    b.push_str("` 没有字段 `");
                    b.push_str(ast.texts[id]);
                    b.push_str("`");
                    inline_error(b.to_string(), ast.lines[id], ast.cols[id]);
                    self.errors = self.errors + 1;
                }
            }
        } elif tag == st(ST::IndexAssign._tag) {
            self.check_expr(ast, ast.aa[id]);
            self.check_expr(ast, ast.bb[id]);
            self.check_expr(ast, ast.cc[id]);
        } elif tag == st(ST::Match._tag) {
            self.check_match(ast, id);
        } elif tag == st(ST::Block._tag) {
            self.check_block(ast, id);
        }
    }

    fn convert_err(ref mut self, ref String from, ref String to, int line, int col) {
        b = StringBuf::new();
        b.push_str("cannot implicitly convert `");
        b.push_str(from);
        b.push_str("` to `");
        b.push_str(to);
        b.push_str("`");
        self.err(b.to_string(), line, col);
    }

    /// 拼接实参类型列表 "(int, bool)"
    fn arg_types_str(ref mut self, ref Ast ast, int args) -> String {
        b = StringBuf::new();
        b.push_str("(");
        a = args;
        first = 1;
        while a >= 0 {
            if first == 0 { b.push_str(", "); }
            if ast.tags[a] == xt(XT::Arg._tag) {
                b.push_str(self.check_expr(ast, ast.aa[a]));
            } else {
                b.push_str(self.check_expr(ast, a));
            }
            first = 0;
            a = ast.nexts[a];
        }
        b.push_str(")");
        return b.to_string();
    }

    /// 路径名（A.B）：检查枚举变体是否存在；返回是否已按路径处理
    fn check_path(ref mut self, ref Ast ast, ref String full, int line, int col) -> bool {
        dot = -1;
        i = 0;
        while i < full.len as int {
            if full.index(i as usize) == '.' {
                dot = i;
                break;
            }
            i = i + 1;
        }
        if dot < 0 { return false; }
        base = full.substring(0 as usize, dot as usize);
        variant = full.substring((dot + 1) as usize, full.len);
        en = self.find_enum(base);
        if en >= 0 {
            if !self.has_variant(en, variant) {
                b = StringBuf::new();
                b.push_str("enum `");
                b.push_str(base);
                b.push_str("` has no variant `");
                b.push_str(variant);
                b.push_str("`");
                self.err(b.to_string(), line, col);
            }
        }
        return true;
    }

    fn check_expr(ref mut self, ref Ast ast, int id) -> String {
        if id < 0 { return ""; }
        tag = ast.tags[id];
        if tag == et(ET::Suffixed._tag) {
            self.check_expr(ast, ast.aa[id]);
            return suffix_type(ast.texts[id]);
        }
        if tag == et(ET::Literal._tag) {
            k = ast.bb[id];
            if k == lk(LK::Int._tag) { return "int"; }
            if k == lk(LK::Float._tag) { return "float"; }
            if k == lk(LK::Char._tag) { return "char"; }
            if k == lk(LK::Str._tag) { return "String"; }
            return "bool";
        }
        if tag == et(ET::Ident._tag) {
            nm = ast.texts[id];
            if contains_dot(nm) {
                self.check_path(ast, nm, ast.lines[id], ast.cols[id]);
                return "";
            }
            if self.has_local(nm) { return self.local_type(nm); }
            if self.find_fn(nm) >= 0 { return ""; }
            self.err_name("undefined variable `", nm, ast.lines[id], ast.cols[id]);
            return "";
        }
        if tag == et(ET::FnCall._tag) {
            nm = ast.texts[id];
            if contains_dot(nm) {
                self.check_path(ast, nm, ast.lines[id], ast.cols[id]);
                a0 = ast.aa[id];
                while a0 >= 0 {
                    if ast.tags[a0] == xt(XT::Arg._tag) {
                        self.check_expr(ast, ast.aa[a0]);
                    } else {
                        self.check_expr(ast, a0);
                    }
                    a0 = ast.nexts[a0];
                }
                return "";
            }
            fi = self.find_fn(nm);
            if fi < 0 {
                self.err_name("undefined function `", nm, ast.lines[id], ast.cols[id]);
                return "";
            }
            if self.fn_nparams[fi] < 0 {
                // builtin：只检查实参本身
                a0 = ast.aa[id];
                while a0 >= 0 {
                    self.check_expr(ast, a0);
                    a0 = ast.nexts[a0];
                }
                return "";
            }
            // 非 builtin：单次遍历收集实参类型并匹配
            b = StringBuf::new();
            b.push_str("(");
            n = 0;
            ok = 1;
            first = 1;
            pstart = self.fn_pstart[fi];
            a = ast.aa[id];
            while a >= 0 {
                at = "";
                if ast.tags[a] == xt(XT::Arg._tag) {
                    at = self.check_expr(ast, ast.aa[a]);
                } else {
                    at = self.check_expr(ast, a);
                }
                if first == 0 { b.push_str(", "); }
                b.push_str(at);
                first = 0;
                if n < self.fn_nparams[fi] {
                    if !convertible(at, self.fn_ptypes[pstart + n]) { ok = 0; }
                } else {
                    ok = 0;
                }
                n = n + 1;
                a = ast.nexts[a];
            }
            b.push_str(")");
            if n != self.fn_nparams[fi] { ok = 0; }
            if ok == 0 {
                b2 = StringBuf::new();
                b2.push_str("no matching overload of `");
                b2.push_str(nm);
                b2.push_str("` for argument types ");
                b2.push_str(b.to_string());
                b2.push_str("; candidate(s) exist");
                self.err(b2.to_string(), ast.lines[id], ast.cols[id]);
            }
            return self.fn_rets[fi].copy();
        }
        if tag == et(ET::Binary._tag) {
            lt = self.check_expr(ast, ast.aa[id]);
            rt = self.check_expr(ast, ast.bb[id]);
            op = ast.tys[id];
            if self.is_gp(lt) || self.is_gp(rt) {
                gpn = lt.copy();
                if !self.is_gp(gpn) { gpn = rt.copy(); }
                bound = self.gp_bound(gpn);
                if bound.len > 0 {
                    mname = op_method_name(op);
                    if mname.len > 0 {
                        ifi = self.find_interface(bound);
                        okm = 0;
                        if ifi >= 0 {
                            if self.has_if_method(ifi, mname) { okm = 1; }
                        }
                        if okm == 0 {
                            b = StringBuf::new();
                            b.push_str("operator `");
                            b.push_str(op_disp_name(op));
                            b.push_str("` on generic parameter `");
                            b.push_str(gpn);
                            b.push_str("`: bound `");
                            b.push_str(bound);
                            b.push_str("` has no `");
                            b.push_str(mname);
                            b.push_str("` method");
                            self.err(b.to_string(), ast.lines[id], ast.cols[id]);
                            return "";
                        }
                    }
                }
                if op == bo(BinOp::Eq._tag) || op == bo(BinOp::Neq._tag) || op == bo(BinOp::Lt._tag) || op == bo(BinOp::Gt._tag) || op == bo(BinOp::Le._tag) || op == bo(BinOp::Ge._tag) {
                    return "bool";
                }
                return "";
            }
            if op == bo(BinOp::And._tag) || op == bo(BinOp::Or._tag) {
                return "bool";
            }
            if op == bo(BinOp::Eq._tag) || op == bo(BinOp::Neq._tag) || op == bo(BinOp::Lt._tag) || op == bo(BinOp::Gt._tag) || op == bo(BinOp::Le._tag) || op == bo(BinOp::Ge._tag) {
                return "bool";
            }
            if op == bo(BinOp::BitAnd._tag) || op == bo(BinOp::BitOr._tag) || op == bo(BinOp::BitXor._tag) || op == bo(BinOp::Shl._tag) || op == bo(BinOp::Shr._tag) {
                bad = "";
                if lt == "float" || lt == "f32" { bad = lt.copy(); }
                if rt == "float" || rt == "f32" { bad = rt.copy(); }
                if bad.len > 0 {
                    b = StringBuf::new();
                    b.push_str("cannot apply bitwise operator to `");
                    b.push_str(bad);
                    b.push_str("`");
                    self.err(b.to_string(), ast.lines[id], ast.cols[id]);
                    return "";
                }
            }
            lr = num_rank(lt);
            rr = num_rank(rt);
            if lr >= 0 && rr >= 0 {
                if lr != rr {
                    if lr < rr {
                        self.convert_err(lt, rt, ast.lines[id], ast.cols[id]);
                    } else {
                        self.convert_err(rt, lt, ast.lines[id], ast.cols[id]);
                    }
                    return "";
                }
            }
            if lt == "String" && rt == "String" {
                return "String";
            }
            if lt == "" { return rt; }
            return lt;
        }
        if tag == et(ET::Unary._tag) {
            t2 = self.check_expr(ast, ast.aa[id]);
            op = ast.tys[id];
            if op == uo(UnOp::Not._tag) { return "bool"; }
            return t2;
        }
        if tag == et(ET::StructLiteral._tag) {
            nm = ast.texts[id];
            st = self.find_struct(nm);
            if st < 0 {
                eline = ast.lines[id];
                ecol = ast.cols[id];
                f0 = ast.aa[id];
                if f0 >= 0 {
                    eline = ast.lines[ast.aa[f0]];
                    ecol = ast.cols[ast.aa[f0]];
                }
                b = StringBuf::new();
                b.push_str("unknown struct `");
                b.push_str(nm);
                b.push_str("` in struct literal");
                self.err(b.to_string(), eline, ecol);
                return "";
            }
            f = ast.aa[id];
            while f >= 0 {
                vt = self.check_expr(ast, ast.aa[f]);
                fi = self.find_field(st, ast.texts[f]);
                if fi < 0 {
                    vpos = ast.aa[f];
                    b = StringBuf::new();
                    b.push_str("struct `");
                    b.push_str(nm);
                    b.push_str("` has no field `");
                    b.push_str(ast.texts[f]);
                    b.push_str("`");
                    if vpos >= 0 {
                        self.err(b.to_string(), ast.lines[vpos], ast.cols[vpos]);
                    } else {
                        self.err(b.to_string(), ast.lines[f], ast.cols[f]);
                    }
                } else {
                    ft = self.fld_types[fi];
                    if !convertible(vt, ft) {
                        self.convert_err(vt, ft, ast.lines[f], ast.cols[f]);
                    }
                }
                f = ast.nexts[f];
            }
            return nm;
        }
        if tag == et(ET::FieldAccess._tag) {
            ot = self.check_expr(ast, ast.aa[id]);
            st = self.find_struct(ot);
            if st >= 0 {
                fi = self.find_field(st, ast.texts[id]);
                if fi < 0 {
                    b = StringBuf::new();
                    b.push_str("结构体 `");
                    b.push_str(ot);
                    b.push_str("` 没有字段 `");
                    b.push_str(ast.texts[id]);
                    b.push_str("`");
                    inline_error(b.to_string(), ast.lines[id], ast.cols[id]);
                    self.errors = self.errors + 1;
                    return "";
                }
                return self.fld_types[fi].copy();
            }
            return "";
        }
        if tag == et(ET::MethodCall._tag) {
            ot = self.check_expr(ast, ast.aa[id]);
            given = self.arg_types_str(ast, ast.bb[id]);
            base = base_type(ot);
            if self.find_struct(base) >= 0 {
                mi = self.find_method(base, ast.texts[id]);
                if mi < 0 {
                    b = StringBuf::new();
                    b.push_str("type `");
                    b.push_str(base);
                    b.push_str("` has no method `");
                    b.push_str(ast.texts[id]);
                    b.push_str("` for argument types ");
                    b.push_str(given);
                    self.err(b.to_string(), ast.lines[id], ast.cols[id]);
                }
            } elif self.is_gp(ot) {
                bound = self.gp_bound(ot);
                if bound.len > 0 {
                    ifi = self.find_interface(bound);
                    okm = 0;
                    if ifi >= 0 {
                        if self.has_if_method(ifi, ast.texts[id]) { okm = 1; }
                    }
                    if okm == 0 {
                        nargs = 0;
                        a = ast.bb[id];
                        while a >= 0 {
                            nargs = nargs + 1;
                            a = ast.nexts[a];
                        }
                        b = StringBuf::new();
                        b.push_str("generic parameter `");
                        b.push_str(ot);
                        b.push_str("` (bound `");
                        b.push_str(bound);
                        b.push_str("`) has no method `");
                        b.push_str(ast.texts[id]);
                        b.push_str("` for ");
                        b.push_int(nargs);
                        b.push_str(" argument(s)");
                        self.err(b.to_string(), ast.lines[id], ast.cols[id]);
                    }
                }
            }
            return "";
        }
        if tag == et(ET::Match._tag) {
            return self.check_match(ast, id);
        }
        if tag == et(ET::If._tag) {
            self.check_expr(ast, ast.aa[id]);
            self.check_block(ast, ast.bb[id]);
            e = ast.cc[id];
            while e >= 0 {
                self.check_expr(ast, ast.aa[e]);
                self.check_block(ast, ast.bb[e]);
                e = ast.nexts[e];
            }
            if ast.dd[id] >= 0 {
                self.check_block(ast, ast.dd[id]);
            }
            return "";
        }
        if tag == et(ET::Cast._tag) {
            st2 = self.check_expr(ast, ast.aa[id]);
            tt2 = type_name(ast, ast.tys[id]);
            if tt2 == "bool" {
                if st2.len > 0 {
                    if st2 != "bool" {
                        b = StringBuf::new();
                        b.push_str("cannot cast `");
                        b.push_str(st2);
                        b.push_str("` to `bool`");
                        self.err(b.to_string(), ast.lines[id], ast.cols[id]);
                        return "";
                    }
                }
            }
            return tt2;
        }
        if tag == et(ET::Index._tag) {
            ot = self.check_expr(ast, ast.aa[id]);
            self.check_expr(ast, ast.bb[id]);
            if ot.len > 2 {
                if ot.index(0) == '[' { return ot.substring(1 as usize, (ot.len - 1) as usize); }
            }
            return "";
        }
        if tag == et(ET::Ref._tag) {
            return self.check_expr(ast, ast.aa[id]);
        }
        if tag == et(ET::CallExpr._tag) {
            self.check_expr(ast, ast.aa[id]);
            a = ast.bb[id];
            while a >= 0 {
                self.check_expr(ast, a);
                a = ast.nexts[a];
            }
            return "";
        }
        if tag == et(ET::ArrayLiteral._tag) {
            a = ast.aa[id];
            if a >= 0 {
                et2 = self.check_expr(ast, a);
                b2 = StringBuf::new();
                b2.push_str("[");
                b2.push_str(et2);
                b2.push_str("]");
                return b2.to_string();
            }
            return "";
        }
        return "";
    }
}

/// 入口：收集 + 检查，返回错误数（诊断已输出）
pub fn check_program(ref Ast ast, int prog, ref String file) -> int {
    c = Checker::new(file);
    c.seed_std();
    c.collect(ast, prog);
    s = ast.aa[prog];
    while s >= 0 {
        if ast.tags[s] == st(ST::FnDecl._tag) {
            c.check_fn(ast, s);
        } elif ast.tags[s] == st(ST::ImplBlock._tag) || ast.tags[s] == st(ST::Namespace._tag) {
            if ast.bb[s] >= 0 {
                c.load_generics(ast, ast.bb[s]);
            }
            m = ast.aa[s];
            while m >= 0 {
                if ast.tags[m] == st(ST::FnDecl._tag) {
                    c.check_fn(ast, m);
                }
                m = ast.nexts[m];
            }
        }
        s = ast.nexts[s];
    }
    return c.errors;
}
