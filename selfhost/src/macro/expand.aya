// 宏展开 M1：item 级宏（#[macro] 函数 + #[lib::name(...)] 注解）
//
// 约定（对齐 docs/macros.md）：
// - input = 被标注 item 的源码文本（不含宏注解行）
// - 其后依次是注解实参的源码文本（逗号分隔，已 trim）
// - 宏函数体只支持 return <字符串拼接表达式>（M1 子集）
import "aya_ast";
import "aya_sb";
import "aya_parser";
import "aya_log";

/// 求值结果（0=String 1=int）
pub struct MVal {
    int kind
    String s
    int n
}

/// 宏形参环境
pub struct MEnv {
    [String] names
    [int] kinds
    [String] ss
    [int] ns
    int count
}

/// 行表
pub struct MLines {
    [String] items
    int count
}

/// 实参表
pub struct MArgs {
    [String] items
    int count
}

/// 展开结果
pub struct MacroOut {
    String text
    int changed
    int delta
}

#[alloc]
pub fn m_int_str(int v) -> String {
    b = StringBuf::new();
    b.push_int(v);
    return b.to_string();
}

#[alloc]
pub fn m_trim(ref String s) -> String {
    a = 0;
    e = s.len as int;
    while a < e {
        c = s.index(a as usize);
        if c == ' ' || c == '\t' || c == '\r' || c == '\n' { a = a + 1; } else { break; }
    }
    while e > a {
        c2 = s.index((e - 1) as usize);
        if c2 == ' ' || c2 == '\t' || c2 == '\r' || c2 == '\n' { e = e - 1; } else { break; }
    }
    return s.substring(a as usize, e as usize);
}

/// "#[...]" -> 注解名（到 ] ( 空白 或 = 为止）
#[alloc]
pub fn m_attr_name(ref String t) -> String {
    if t.len < 3 { return ""; }
    i = 2;
    while i < t.len as int {
        c = t.index(i as usize);
        if c == ']' || c == '(' || c == ' ' || c == '\t' || c == '=' { break; }
        i = i + 1;
    }
    return t.substring(2 as usize, i as usize);
}

/// 注解名最后一段（lib::answer -> answer）
#[alloc]
pub fn m_last_seg(ref String n) -> String {
    p = 0;
    i = 0;
    while i < n.len as int {
        c = n.index(i as usize);
        if c == ':' || c == '.' { p = i + 1; }
        i = i + 1;
    }
    return n.substring(p as usize, n.len);
}

/// 注解实参原文（第一个 '(' 到最后一个 ')'）
#[alloc]
pub fn m_attr_args(ref String t) -> String {
    a = -1;
    b = -1;
    i = 0;
    while i < t.len as int {
        c = t.index(i as usize);
        if c == '(' { if a < 0 { a = i + 1; } }
        if c == ')' { b = i; }
        i = i + 1;
    }
    if a < 0 || b < a { return ""; }
    return t.substring(a as usize, b as usize);
}

/// 按顶层逗号切分实参（忽略引号/括号内）
#[alloc]
pub fn m_split_args(ref String s) -> MArgs {
    ob = MArgs { items = [String; 32], count = 0 };
    st = 0;
    dep = 0;
    inq = 0;
    i = 0;
    while i <= s.len as int {
        c = ' ';
        if i < s.len as int { c = s.index(i as usize); }
        if i == s.len as int || (c == ',' && dep == 0 && inq == 0) {
            part = m_trim(s.substring(st as usize, i as usize));
            if part.len > 0 && ob.count < 32 {
                ob.items[ob.count] = part;
                ob.count = ob.count + 1;
            }
            st = i + 1;
        } else {
            if c == '"' { inq = 1 - inq; }
            if inq == 0 {
                if c == '(' || c == '[' || c == '{' { dep = dep + 1; }
                if c == ')' || c == ']' || c == '}' { dep = dep - 1; }
            }
        }
        i = i + 1;
    }
    return ob;
}

#[alloc]
pub fn m_split_lines(ref String src) -> MLines {
    ob = MLines { items = [String; 8192], count = 0 };
    st = 0;
    i = 0;
    while i <= src.len as int {
        is_nl = 0;
        if i < src.len as int {
            if char_code(src.index(i as usize)) == 10 { is_nl = 1; }
        }
        if i == src.len as int || is_nl == 1 {
            if ob.count < 8192 {
                ob.items[ob.count] = src.substring(st as usize, i as usize);
                ob.count = ob.count + 1;
            }
            st = i + 1;
        }
        i = i + 1;
    }
    return ob;
}

/// 到某行之前的花括号深度（跳过字符串与 // 注释）
#[alloc]
pub fn m_depth_at(ref MLines ls, int line) -> int {
    d = 0;
    li = 0;
    while li < line - 1 && li < ls.count {
        ln = ls.items[li];
        inq = 0;
        i = 0;
        while i < ln.len as int {
            c = ln.index(i as usize);
            if inq == 1 {
                if c == '"' { inq = 0; }
            } else {
                if c == '"' { inq = 1; }
                elif c == '/' {
                    if i + 1 < ln.len as int {
                        if ln.index((i + 1) as usize) == '/' { i = ln.len as int; }
                    }
                }
                elif c == '{' { d = d + 1; }
                elif c == '}' { d = d - 1; }
            }
            i = i + 1;
        }
        li = li + 1;
    }
    return d;
}

#[alloc]
pub fn m_lookup(ref MEnv env, ref String nm) -> MVal {
    i = 0;
    while i < env.count {
        if env.names[i] == nm {
            if env.kinds[i] == 1 { return MVal { kind = 1, s = "", n = env.ns[i] }; }
            return MVal { kind = 0, s = env.ss[i].copy(), n = 0 };
        }
        i = i + 1;
    }
    return MVal { kind = 0, s = "", n = 0 };
}

#[alloc]
fn m_parse_int(ref String s) -> int {
    v = 0;
    i = 0;
    while i < s.len as int {
        c = char_code(s.index(i as usize));
        if c >= 48 && c <= 57 { v = v * 10 + (c - 48); }
        i = i + 1;
    }
    return v;
}

/// 求值宏表达式（M1：字面量/形参/加法拼接）
#[alloc]
pub fn m_eval(ref Ast ast, int id, ref MEnv env) -> MVal {
    if id < 0 { return MVal { kind = 0, s = "", n = 0 }; }
    tg = ast.tags[id];
    if tg == et(ET::Literal._tag) {
        k = ast.bb[id];
        if k == lk(LK::Str._tag) { return MVal { kind = 0, s = ast.texts[id].copy(), n = 0 }; }
        if k == lk(LK::Char._tag) { return MVal { kind = 1, s = "", n = char_code(ast.texts[id].index(0 as usize)) }; }
        return MVal { kind = 1, s = "", n = m_parse_int(ast.texts[id]) };
    }
    if tg == et(ET::Ident._tag) { return m_lookup(env, ast.texts[id]); }
    if tg == et(ET::Binary._tag) {
        if ast.tys[id] != bo(BinOp::Add._tag) { return MVal { kind = 0, s = "", n = 0 }; }
        l = m_eval(ast, ast.aa[id], env);
        r = m_eval(ast, ast.bb[id], env);
        ls = l.s;
        if l.kind == 1 { ls = m_int_str(l.n); }
        rs = r.s;
        if r.kind == 1 { rs = m_int_str(r.n); }
        return MVal { kind = 0, s = ls + rs, n = 0 };
    }
    return MVal { kind = 0, s = "", n = 0 };
}

/// 在函数体中找到 return 表达式并求值
#[alloc]
pub fn m_eval_fn(ref Ast ast, int fn_node, ref MEnv env) -> String {
    blk = ast.bb[fn_node];
    if blk < 0 { return ""; }
    s = ast.aa[blk];
    while s >= 0 {
        node = s;
        if ast.tags[node] == st(ST::Attributed._tag) {
            if ast.aa[node] >= 0 { node = ast.aa[node]; }
        }
        if ast.tags[node] == st(ST::Return._tag) {
            if ast.aa[node] >= 0 {
                v = m_eval(ast, ast.aa[node], env);
                if v.kind == 1 { return m_int_str(v.n); }
                return v.s;
            }
            return "";
        }
        s = ast.nexts[s];
    }
    return "";
}

/// 按名字查宏函数节点
#[alloc]
pub fn m_find_fn(ref Ast ast, ref String nm) -> int {
    i = 0;
    while i < ast.len {
        if ast.tags[i] == st(ST::FnDecl._tag) {
            if ast.texts[i] == nm { return i; }
        }
        i = i + 1;
    }
    return -1;
}

#[alloc]
fn m_ty_name(ref Ast ast, int t) -> String {
    while t >= 0 {
        tg = ast.tags[t];
        if tg == tt(TT::Ref._tag) {
            t = ast.aa[t];
            continue;
        }
        if tg == tt(TT::Named._tag) || tg == tt(TT::Generic._tag) { return ast.texts[t].copy(); }
        return "";
    }
    return "";
}

/// 形参名/类型（0=非 String 1=String）
#[alloc]
fn m_param_kind(ref Ast ast, int fn_node, int pi) -> int {
    p = ast.aa[fn_node];
    k = 0;
    while p >= 0 && k < pi {
        p = ast.nexts[p];
        k = k + 1;
    }
    if p < 0 { return 0; }
    tn = m_ty_name(ast, ast.tys[p]);
    // 环境约定：0=String 1=int
    if tn == "String" { return 0; }
    return 1;
}

#[alloc]
fn m_param_name(ref Ast ast, int fn_node, int pi) -> String {
    p = ast.aa[fn_node];
    k = 0;
    while p >= 0 && k < pi {
        p = ast.nexts[p];
        k = k + 1;
    }
    if p < 0 { return ""; }
    return ast.texts[p].copy();
}

/// 宏形参个数
#[alloc]
fn m_param_count(ref Ast ast, int fn_node) -> int {
    p = ast.aa[fn_node];
    n = 0;
    while p >= 0 {
        n = n + 1;
        p = ast.nexts[p];
    }
    return n;
}

/// 是否宏函数（前置注解里有名字为 macro 的注解）
#[alloc]
pub fn m_is_macro(ref Parser p, int line) -> bool {
    i = 0;
    while i < p.attrs_count {
        if p.attrs_eline[i] <= line {
            nm = m_attr_name(p.attrs_text[i]);
            if nm == "macro" { return true; }
        }
        i = i + 1;
    }
    return false;
}

/// 行区间替换：lines[start..end]（0 基，含）替换为 repl
#[alloc]
fn m_replace_lines(ref MLines ls, int start, int end, ref MLines repl) -> MLines {
    ob = MLines { items = [String; 8192], count = 0 };
    i = 0;
    while i < start && i < ls.count {
        ob.items[ob.count] = ls.items[i].copy();
        ob.count = ob.count + 1;
        i = i + 1;
    }
    j = 0;
    while j < repl.count {
        ob.items[ob.count] = repl.items[j].copy();
        ob.count = ob.count + 1;
        j = j + 1;
    }
    i = end + 1;
    while i < ls.count {
        ob.items[ob.count] = ls.items[i].copy();
        ob.count = ob.count + 1;
        i = i + 1;
    }
    return ob;
}

#[alloc]
fn m_join_lines(ref MLines ls) -> String {
    b = StringBuf::new();
    i = 0;
    while i < ls.count {
        b.push_str(ls.items[i]);
        if i + 1 < ls.count { b.push('\n'); }
        i = i + 1;
    }
    return b.to_string();
}

/// 展开入口：返回新源码（无站点时 changed=0）
#[alloc]
#[state]
pub fn maybe_expand(ref String src, ref Ast ast, ref Parser p, int entry_lines) -> MacroOut {
    ob = MacroOut { text = src.copy(), changed = 0, delta = 0 };
    if p.attrs_count == 0 { return ob; }
    ls = m_split_lines(src);
    // 站点：注解名最后一段可解析到宏函数、且位于入口文件、且顶层（item 级）
    s_attr = [int; 64];
    s_fn = [int; 64];
    s_dep = [int; 64];
    s_count = 0;
    i = 0;
    while i < p.attrs_count {
        ln = p.attrs_line[i];
        if ln <= entry_lines {
            nm = m_attr_name(p.attrs_text[i]);
            if nm.len > 0 && nm != "macro" {
                node = m_find_fn(ast, m_last_seg(nm));
                if node >= 0 {
                    if m_is_macro(p, ast.lines[node]) {
                        if s_count < 64 {
                            s_attr[s_count] = i;
                            s_fn[s_count] = node;
                            s_dep[s_count] = m_depth_at(ls, ln);
                            s_count = s_count + 1;
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    if s_count == 0 { return ob; }
    // 按注解行降序处理（改动只影响后续行）
    k = 0;
    while k < s_count {
        m = k + 1;
        while m < s_count {
            if p.attrs_line[s_attr[m]] > p.attrs_line[s_attr[k]] {
                ta = s_attr[k]; s_attr[k] = s_attr[m]; s_attr[m] = ta;
                tf = s_fn[k]; s_fn[k] = s_fn[m]; s_fn[m] = tf;
                td = s_dep[k]; s_dep[k] = s_dep[m]; s_dep[m] = td;
            }
            m = m + 1;
        }
        k = k + 1;
    }
    si = 0;
    while si < s_count {
        ai = s_attr[si];
        fn_node = s_fn[si];
        a_line = p.attrs_line[ai];
        a_eline = p.attrs_eline[ai];
        item_line = -1;
        if s_dep[si] > 0 {
            // 语句级：注解后第一个节点行（即被标注语句）
            j = 0;
            while j < ast.len {
                lnj3 = ast.lines[j];
                if lnj3 >= a_eline && lnj3 > a_line {
                    if item_line < 0 || lnj3 < item_line { item_line = lnj3; }
                }
                j = j + 1;
            }
        } else {
            // item 级：注解后第一个 FnDecl 行
            j = 0;
            while j < ast.len {
                if ast.tags[j] == st(ST::FnDecl._tag) {
                    lnj = ast.lines[j];
                    if lnj >= a_eline && lnj > a_line {
                        if item_line < 0 || lnj < item_line { item_line = lnj; }
                    }
                }
                j = j + 1;
            }
        }
        if item_line < 0 { si = si + 1; continue; }
        item_end = item_line;
        if s_dep[si] > 0 {
            // 语句跨度：按括号平衡扩展
            bal = 0;
            le = item_line;
            while le <= entry_lines {
                lnc = ls.items[le - 1];
                ii = 0;
                while ii < lnc.len as int {
                    cc = lnc.index(ii as usize);
                    if cc == '{' || cc == '(' || cc == '[' { bal = bal + 1; }
                    if cc == '}' || cc == ')' || cc == ']' { bal = bal - 1; }
                    ii = ii + 1;
                }
                item_end = le;
                if bal <= 0 { break; }
                le = le + 1;
            }
        } else {
            // item 结束 = 下一个 item 或注解行 - 1（或入口末尾）
            next_line = entry_lines + 1;
            j = 0;
            while j < ast.len {
                if ast.tags[j] == st(ST::FnDecl._tag) {
                    lnj = ast.lines[j];
                    if lnj > item_line && lnj < next_line { next_line = lnj; }
                }
                j = j + 1;
            }
            j = 0;
            while j < p.attrs_count {
                lnj2 = p.attrs_line[j];
                if lnj2 > item_line && lnj2 < next_line { next_line = lnj2; }
                j = j + 1;
            }
            item_end = next_line - 1;
            if item_end > entry_lines { item_end = entry_lines; }
            // 去掉 item 末尾空行
            while item_end > item_line {
                if m_trim(ls.items[item_end - 1]).len == 0 { item_end = item_end - 1; } else { break; }
            }
        }
        // input = item 源码 + 换行
        ib = StringBuf::new();
        ln_i = item_line;
        while ln_i <= item_end {
            ib.push_str(ls.items[ln_i - 1]);
            ib.push('\n');
            ln_i = ln_i + 1;
        }
        input = ib.to_string();
        // 形参绑定
        env = MEnv { names = [String; 16], kinds = [int; 16], ss = [String; 16], ns = [int; 16], count = 0 };
        nparam = m_param_count(ast, fn_node);
        args = m_split_args(m_attr_args(p.attrs_text[ai]));
        pi = 0;
        ai2 = 0;
        while pi < nparam {
            pn = m_param_name(ast, fn_node, pi);
            pk = m_param_kind(ast, fn_node, pi);
            env.names[env.count] = pn.copy();
            env.kinds[env.count] = pk;
            if pi == 0 {
                env.ss[env.count] = input.copy();
            } elif pn == "__line" {
                env.kinds[env.count] = 1;
                env.ns[env.count] = item_line;
            } elif pn == "__col" {
                env.kinds[env.count] = 1;
                env.ns[env.count] = 1;
            } else {
                if ai2 < args.count {
                    env.ss[env.count] = args.items[ai2].copy();
                    ai2 = ai2 + 1;
                } else {
                    env.ss[env.count] = "";
                }
            }
            env.count = env.count + 1;
            pi = pi + 1;
        }
        res = m_eval_fn(ast, fn_node, env);
        // 替换 [a_line .. item_end] 行
        repl = m_split_lines(res);
        ns0 = ls.count;
        ls = m_replace_lines(ls, a_line - 1, item_end - 1, repl);
        ob.delta = ob.delta + (ls.count - ns0);
        ob.changed = 1;
        si = si + 1;
    }
    ob.text = m_join_lines(ls);
    return ob;
}
