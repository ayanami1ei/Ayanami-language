// Ayanami 自举编译器（stage-1）入口：ayanami <check|build|run> <file.aya>
//
// 设计与里程碑见 docs/selfhost.md；driver 实现在 src/driver/build.aya。
import "io";
import "aya_cli";
import "aya_driver";

fn usage_ok(ref Cli c) -> int {
    c.usage();
    return 0;
}

fn usage_unknown(ref Cli c) -> int {
    raw_error("unknown command: " + c.raw);
    c.usage();
    return 2;
}

// 子命令分派：直接 match 枚举（枚举不支持 ==，match 是惯用法）
fn dispatch(ref Cli c) -> int {
    match c.kind {
        Check => return cmd_check(c.file),
        Build => return cmd_build(c.file, c.opts),
        Run => return cmd_run(c.file, c.opts),
        Help => return usage_ok(c),
        Unknown => return usage_unknown(c),
    }
}

fn main() -> int {
    a = Args::load();
    c = Cli::parse(a);
    return dispatch(c);
}
