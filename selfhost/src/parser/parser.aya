import "string";
import "aya_sb";
import "aya_token";
import "aya_lexer";
import "aya_ast";

// 手写递归下降解析器（M3 子集，逐步扩展；对齐 rust 版 src/parser）
fn is_digit_c(int c) -> bool {
    if c >= 48 && c <= 57 { return true; }
    return false;
}

fn is_hex_digit_c(int c) -> bool {
    if c >= 48 && c <= 57 { return true; }
    if c >= 97 && c <= 102 { return true; }
    if c >= 65 && c <= 70 { return true; }
    return false;
}

fn digit_val_p(int c) -> int {
    if c >= 48 && c <= 57 { return c - 48; }
    if c >= 97 && c <= 102 { return c - 87; }
    if c >= 65 && c <= 70 { return c - 55; }
    return 0;
}

/// 解析整数字面量文本（进制前缀 + 下划线）为值（dump.aya 有同名副本）
fn parse_int_text(ref String s) -> int {
    n = s.len as int;
    i = 0;
    radix = 10;
    if n >= 2 {
        if char_code(s.index(0)) == 48 {
            c1 = char_code(s.index(1));
            if c1 == 120 || c1 == 88 { radix = 16; i = 2; }
            elif c1 == 98 || c1 == 66 { radix = 2; i = 2; }
            elif c1 == 111 || c1 == 79 { radix = 8; i = 2; }
        }
    }
    v = 0;
    while i < n {
        c = char_code(s.index(i as usize));
        if c == 95 { i = i + 1; } else {
            v = v * radix + digit_val_p(c);
            i = i + 1;
        }
    }
    return v;
}

/// 字面量数字部分长度（含进制前缀/小数/指数，不含后缀）
fn num_len(ref String s) -> int {
    n = s.len as int;
    i = 0;
    if n >= 2 {
        if char_code(s.index(0)) == 48 {
            c1 = char_code(s.index(1));
            if c1 == 120 || c1 == 88 || c1 == 98 || c1 == 66 || c1 == 111 || c1 == 79 {
                i = 2;
                while i < n {
                    c = char_code(s.index(i as usize));
                    if is_hex_digit_c(c) || c == 95 { i = i + 1; } else { break; }
                }
                return i;
            }
        }
    }
    while i < n {
        c = char_code(s.index(i as usize));
        if is_digit_c(c) || c == 95 { i = i + 1; } else { break; }
    }
    if i < n {
        if char_code(s.index(i as usize)) == 46 {
            i = i + 1;
            while i < n {
                c = char_code(s.index(i as usize));
                if is_digit_c(c) || c == 95 { i = i + 1; } else { break; }
            }
        }
    }
    if i < n {
        c = char_code(s.index(i as usize));
        if c == 101 || c == 69 {
            j = i + 1;
            if j < n {
                c2 = char_code(s.index(j as usize));
                if c2 == 43 || c2 == 45 { j = j + 1; }
            }
            if j < n {
                if is_digit_c(char_code(s.index(j as usize))) {
                    i = j;
                    while i < n {
                        c3 = char_code(s.index(i as usize));
                        if is_digit_c(c3) || c3 == 95 { i = i + 1; } else { break; }
                    }
                }
            }
        }
    }
    return i;
}

pub struct Parser {
    Lexer lex
    Ast ast
    Token cur
    Token la1
    Token la2
    int failed
    String err
    int err_line
    int err_col
    int no_struct
    String cur_impl
    int impl_args
    int tail_if
    int save_pos
    int save_line
    int save_col
    int save_byte
    int save_ast_len
}

pub namespace Parser {
    pub fn new(ref String src) -> Parser {
        lx = Lexer::new(src);
        t1 = lx.next_token();
        t2 = lx.next_token();
        t3 = lx.next_token();
        p = Parser { lex = lx, ast = Ast::new(), cur = t1, la1 = t2, la2 = t3, failed = 0, err = "", err_line = 0, err_col = 0, no_struct = 0, cur_impl = "", impl_args = -1, tail_if = 0, save_pos = 0, save_line = 1, save_col = 1, save_byte = 0, save_ast_len = 0 };
        return p;
    }
}


impl Parser {
    fn advance(ref mut self) {
        self.cur = self.la1;
        self.la1 = self.la2;
        self.la2 = self.lex.next_token();
    }

    fn la1_is_kw(ref mut self, int kw) -> bool {
        if self.la1.kind == Tk::Keyword._tag && self.la1.sub == kw { return true; }
        return false;
    }

    fn la2_is_kw(ref mut self, int kw) -> bool {
        if self.la2.kind == Tk::Keyword._tag && self.la2.sub == kw { return true; }
        return false;
    }

    /// 记录回溯点：cur 的起始字节 + arena 长度
    /// 注意：lexer 有 2 token 前瞻，pos 已越过 la2，不能直接存 pos；
    /// restore 时从文件头重扫到 cur 起点（O(n)，回溯次数少可接受）
    fn mark(ref mut self) {
        self.save_byte = self.cur.start;
        self.save_ast_len = self.ast.len;
    }

    fn restore(ref mut self) {
        self.lex.pos = 0;
        self.lex.line = 1;
        self.lex.col = 1;
        self.lex.byte = 0;
        t = self.lex.next_token();
        while t.start < self.save_byte {
            t = self.lex.next_token();
        }
        self.cur = t;
        self.la1 = self.lex.next_token();
        self.la2 = self.lex.next_token();
        self.ast.len = self.save_ast_len;
        self.failed = 0;
        self.err = "";
    }

    fn la1_is_delim(ref mut self, int d) -> bool {
        if self.la1.kind == Tk::Delim._tag && self.la1.sub == d { return true; }
        return false;
    }

    fn la2_is_delim(ref mut self, int d) -> bool {
        if self.la2.kind == Tk::Delim._tag && self.la2.sub == d { return true; }
        return false;
    }

    fn la1_is_ident(ref mut self) -> bool {
        if self.la1.kind == Tk::Ident._tag { return true; }
        return false;
    }

    fn la1_is_upper_ident(ref mut self) -> bool {
        if self.la1.kind != Tk::Ident._tag { return false; }
        c = char_code(self.la1.text.index(0));
        if c >= 65 && c <= 90 { return true; }
        return false;
    }

    /// 跳过配对的 [ ... ]（cur 必须是 [）
    fn skip_brackets(ref mut self) {
        depth = 0;
        while !self.at_end() {
            if self.check_delim(D::LBracket._tag) { depth = depth + 1; }
            if self.check_delim(D::RBracket._tag) {
                depth = depth - 1;
                if depth == 0 { self.advance(); break; }
            }
            self.advance();
        }
    }

    /// 跳过连续的 #[...] 属性
    fn skip_attrs(ref mut self) {
        while true {
            if !self.check_op("#") { break; }
            if !self.la1_is_delim(D::LBracket._tag) { break; }
            self.advance();
            self.skip_brackets();
        }
    }

    fn error(ref mut self, ref String msg) {
        if self.failed == 0 {
            self.failed = 1;
            self.err = msg.copy();
            self.err_line = self.cur.line;
            self.err_col = self.cur.col;
        }
    }

    fn check_kw(ref mut self, int kw) -> bool {
        if self.cur.kind == Tk::Keyword._tag && self.cur.sub == kw { return true; }
        return false;
    }

    fn check_delim(ref mut self, int d) -> bool {
        if self.cur.kind == Tk::Delim._tag && self.cur.sub == d { return true; }
        return false;
    }

    fn check_op(ref mut self, ref String op) -> bool {
        if self.cur.kind == Tk::Op._tag && self.cur.text == op { return true; }
        return false;
    }

    fn eat_kw(ref mut self, int kw) -> bool {
        if self.check_kw(kw) {
            self.advance();
            return true;
        }
        return false;
    }

    fn eat_delim(ref mut self, int d) -> bool {
        if self.check_delim(d) {
            self.advance();
            return true;
        }
        return false;
    }

    fn eat_op(ref mut self, ref String op) -> bool {
        if self.check_op(op) {
            self.advance();
            return true;
        }
        return false;
    }

    fn expect_kw(ref mut self, int kw, ref String what) {
        if !self.eat_kw(kw) {
            self.error(what);
        }
    }

    fn expect_delim(ref mut self, int d, ref String what) {
        if !self.eat_delim(d) {
            self.error(what);
        }
    }

    fn expect_ident(ref mut self, ref String what) -> String {
        if self.cur.kind == Tk::Ident._tag {
            s = self.cur.text.copy();
            self.advance();
            return s;
        }
        self.error(what);
        return "";
    }

    fn at_end(ref mut self) -> bool {
        return self.cur.kind == Tk::Eof._tag;
    }

    // ---------- 类型 ----------

    fn parse_type(ref mut self) -> int {
        self.skip_attrs();
        tag = tt(TT::Default._tag);
        a = -1;
        b = 0;
        text = "";
        if self.eat_kw(Kw::Ref._tag) {
            mutable = 0;
            if self.eat_kw(Kw::Mut._tag) { mutable = 1; }
            inner = self.parse_type();
            return self.ast.push(tt(TT::Ref._tag), "", -1, inner, mutable, -1, -1, self.cur.line, self.cur.col);
        }
        if self.eat_kw(Kw::Unique._tag) {
            inner = self.parse_type();
            return self.ast.push(tt(TT::Unique._tag), "", -1, inner, -1, -1, -1, self.cur.line, self.cur.col);
        }
        if self.check_delim(D::LBracket._tag) {
            self.advance();
            inner = self.parse_type();
            if self.eat_delim(D::Semicolon._tag) {
                cnt = self.parse_expr();
                cval = 0;
                if cnt >= 0 {
                    if self.ast.tags[cnt] == et(ET::Literal._tag) {
                        cval = parse_int_text(self.ast.texts[cnt]);
                    }
                }
                self.expect_delim(D::RBracket._tag, "expected ] in array type");
                return self.ast.push(tt(TT::ArraySized._tag), "", -1, inner, cval, -1, -1, self.cur.line, self.cur.col);
            }
            self.expect_delim(D::RBracket._tag, "expected ] in array type");
            return self.ast.push(tt(TT::Array._tag), "", -1, inner, -1, -1, -1, self.cur.line, self.cur.col);
        }
        if self.check_kw(Kw::Fn._tag) {
            self.advance();
            depth = 0;
            while !self.at_end() {
                if self.check_delim(D::LParen._tag) { depth = depth + 1; }
                if self.check_delim(D::RParen._tag) {
                    depth = depth - 1;
                    if depth == 0 { self.advance(); break; }
                }
                self.advance();
            }
            if self.eat_delim(D::Arrow._tag) {
                self.parse_type();
            }
            return self.ast.push(tt(TT::FnPtr._tag), "", -1, -1, -1, -1, -1, self.cur.line, self.cur.col);
        }
        if self.cur.kind == Tk::Ident._tag {
            if self.cur.text == "Fn" {
                if self.la1_is_delim(D::LParen._tag) {
                    // Fn(T) -> U 闭包类型（dump 打印 Fn(...)）
                    self.advance();
                    depth = 0;
                    while !self.at_end() {
                        if self.check_delim(D::LParen._tag) { depth = depth + 1; }
                        if self.check_delim(D::RParen._tag) {
                            depth = depth - 1;
                            if depth == 0 { self.advance(); break; }
                        }
                        self.advance();
                    }
                    if self.eat_delim(D::Arrow._tag) {
                        self.parse_type();
                    }
                    return self.ast.push(tt(TT::Closure._tag), "", -1, -1, -1, -1, -1, self.cur.line, self.cur.col);
                }
            }
        }
        if self.check_op("!") {
            self.advance();
            return self.ast.push(tt(TT::Never._tag), "", -1, -1, -1, -1, -1, self.cur.line, self.cur.col);
        }
        if self.check_delim(D::LParen._tag) && self.la1_is_delim(D::RParen._tag) {
            self.advance();
            self.advance();
            return self.ast.push(tt(TT::Void._tag), "", -1, -1, -1, -1, -1, self.cur.line, self.cur.col);
        }
        if self.check_kw(Kw::Int._tag) {
            self.advance();
            return self.ast.push(tt(TT::Int._tag), "", -1, -1, -1, -1, -1, self.cur.line, self.cur.col);
        }
        if self.check_kw(Kw::Float._tag) {
            self.advance();
            return self.ast.push(tt(TT::Float._tag), "", -1, -1, -1, -1, -1, self.cur.line, self.cur.col);
        }
        if self.check_kw(Kw::Char._tag) {
            self.advance();
            return self.ast.push(tt(TT::Char._tag), "", -1, -1, -1, -1, -1, self.cur.line, self.cur.col);
        }
        if self.check_kw(Kw::Bool._tag) {
            self.advance();
            return self.ast.push(tt(TT::Bool._tag), "", -1, -1, -1, -1, -1, self.cur.line, self.cur.col);
        }
        is_self_upper = 0;
        if self.cur.kind == Tk::Ident._tag {
            if self.cur.text == "Self" {
                is_self_upper = 1;
            }
        }
        if self.check_kw(Kw::Self_._tag) {
            self.advance();
            return self.ast.push(tt(TT::Self_._tag), "", -1, -1, -1, -1, -1, self.cur.line, self.cur.col);
        }
        if is_self_upper == 1 {
            self.advance();
            nm = "Self";
            if self.cur_impl.len > 0 { nm = self.cur_impl; }
            base = self.ast.push(tt(TT::Named._tag), nm, -1, -1, -1, -1, -1, self.cur.line, self.cur.col);
            if self.cur_impl.len > 0 {
                if self.impl_args >= 0 {
                    base = self.ast.push(tt(TT::Generic._tag), nm, -1, self.impl_args, -1, -1, -1, self.cur.line, self.cur.col);
                }
            }
            return base;
        }
        if self.cur.kind == Tk::Ident._tag {
            name = self.cur.text.copy();
            self.advance();
            if self.check_delim(D::LBracket._tag) {
                self.advance();
                args = -1;
                while true {
                    if self.check_delim(D::RBracket._tag) { break; }
                    if self.at_end() { break; }
                    gt = self.parse_type();
                    gn = self.ast.push(xt(XT::GenericArg._tag), "", gt, -1, -1, -1, -1, self.cur.line, self.cur.col);
                    args = self.ast.push_tail(args, gn);
                    if !self.eat_delim(D::Comma._tag) { break; }
                }
                self.expect_delim(D::RBracket._tag, "expected ] in generic type");
                return self.ast.push(tt(TT::Generic._tag), name, -1, args, -1, -1, -1, self.cur.line, self.cur.col);
            }
            return self.ast.push(tt(TT::Named._tag), name, -1, -1, -1, -1, -1, self.cur.line, self.cur.col);
        }
        self.error("expected type");
        return self.ast.push(tt(TT::Default._tag), "", -1, -1, -1, -1, -1, self.cur.line, self.cur.col);
    }

    // ---------- 顶层 ----------

    pub fn parse_program(ref mut self) -> int {
        prog = self.ast.push(st(ST::Program._tag), "", -1, -1, -1, -1, -1, 1, 1);
        head = -1;
        while true {
            if self.at_end() { break; }
            if self.failed == 1 { break; }
            item = self.parse_item();
            if item >= 0 {
                head = self.ast.push_tail(head, item);
            }
        }
        self.ast.aa[prog] = head;
        return prog;
    }

    fn parse_item(ref mut self) -> int {
        self.skip_attrs();
        pub_seen = self.eat_kw(Kw::Pub._tag);
        self.skip_attrs();
        if self.check_kw(Kw::Import._tag) {
            self.advance();
            if self.cur.kind != Tk::StrLit._tag {
                self.error("expected import path string");
                return -1;
            }
            path = self.cur.text.copy();
            self.advance();
            return self.ast.push(st(ST::Import._tag), path, -1, -1, -1, -1, -1, self.cur.line, self.cur.col);
        }
        if self.check_kw(Kw::Extern._tag) {
            self.advance();
            if self.cur.kind == Tk::StrLit._tag {
                self.advance();
            }
            if self.check_kw(Kw::Fn._tag) {
                f = self.parse_fn_body(0);
                if self.check_delim(D::LBrace._tag) {
                    // extern "C" fn ... { ... }：C 导出定义，有函数体
                    blk = self.parse_block();
                    self.ast.bb[f] = blk;
                } else {
                    blk = self.ast.push(st(ST::Block._tag), "", -1, -1, -1, -1, -1, self.cur.line, self.cur.col);
                    self.ast.bb[f] = blk;
                    self.eat_delim(D::Semicolon._tag);
                }
                return f;
            }
            return -1;
        }
        if self.check_kw(Kw::Fn._tag) {
            return self.parse_fn();
        }
        if self.check_kw(Kw::Struct._tag) {
            return self.parse_struct();
        }
        if self.check_kw(Kw::Namespace._tag) {
            return self.parse_namespace();
        }
        if self.check_kw(Kw::Impl._tag) {
            return self.parse_impl();
        }
        if self.check_kw(Kw::Enum._tag) {
            return self.parse_enum();
        }
        if self.check_kw(Kw::Interface._tag) {
            return self.parse_interface();
        }
        if self.check_kw(Kw::Const._tag) {
            return self.parse_const();
        }
        if self.cur.kind == Tk::Ident._tag {
            if self.cur.text == "static" {
                self.advance();
                self.eat_kw(Kw::Mut._tag);
                name = self.expect_ident("expected static name");
                ty = -1;
                if self.eat_delim(D::Colon._tag) {
                    ty = self.parse_type();
                }
                if !self.eat_op("=") {
                    self.error("expected = in static");
                }
                val = self.parse_expr();
                return self.ast.push(st(ST::StaticDecl._tag), name, ty, val, -1, -1, -1, self.cur.line, self.cur.col);
            }
        }
        // 其余顶层项暂跳过（static/type/...）
        self.advance();
        return -1;
    }

    fn parse_struct(ref mut self) -> int {
        self.expect_kw(Kw::Struct._tag, "expected struct");
        name = self.expect_ident("expected struct name");
        if self.check_delim(D::LBracket._tag) { self.skip_brackets(); }
        self.expect_delim(D::LBrace._tag, "expected { in struct");
        head = -1;
        while true {
            if self.check_delim(D::RBrace._tag) { break; }
            if self.at_end() { break; }
            if self.failed == 1 { break; }
            ty = self.parse_type();
            fname = self.expect_ident("expected field name");
            fn_node = self.ast.push(xt(XT::StructField._tag), fname, ty, -1, -1, -1, -1, self.cur.line, self.cur.col);
            head = self.ast.push_tail(head, fn_node);
            self.eat_delim(D::Comma._tag);
        }
        self.expect_delim(D::RBrace._tag, "expected } after struct fields");
        return self.ast.push(st(ST::StructDef._tag), name, -1, head, -1, -1, -1, self.cur.line, self.cur.col);
    }

    fn parse_namespace(ref mut self) -> int {
        self.expect_kw(Kw::Namespace._tag, "expected namespace");
        name = self.expect_ident("expected namespace name");
        self.expect_delim(D::LBrace._tag, "expected { in namespace");
        head = -1;
        while true {
            if self.check_delim(D::RBrace._tag) { break; }
            if self.at_end() { break; }
            if self.failed == 1 { break; }
            item = self.parse_item();
            if item >= 0 { head = self.ast.push_tail(head, item); }
        }
        self.expect_delim(D::RBrace._tag, "expected } after namespace");
        return self.ast.push(st(ST::Namespace._tag), name, -1, head, -1, -1, -1, self.cur.line, self.cur.col);
    }

    fn parse_impl(ref mut self) -> int {
        self.expect_kw(Kw::Impl._tag, "expected impl");
        // impl[T] Type[T] / impl Type
        self.impl_args = -1;
        if self.check_delim(D::LBracket._tag) { self.skip_brackets(); }
        tname = "";
        if self.check_kw(Kw::Int._tag) { tname = "int"; self.advance(); }
        elif self.check_kw(Kw::Float._tag) { tname = "float"; self.advance(); }
        elif self.check_kw(Kw::Char._tag) { tname = "char"; self.advance(); }
        elif self.check_kw(Kw::Bool._tag) { tname = "bool"; self.advance(); }
        else { tname = self.expect_ident("expected impl type name"); }
        self.cur_impl = tname.copy();
        if self.check_delim(D::LBracket._tag) {
            // impl[T] C[T]：把 [T] 解析成泛型实参链（接收者类型用）
            self.advance();
            while true {
                if self.check_delim(D::RBracket._tag) { break; }
                if self.at_end() { break; }
                at = self.parse_type();
                an = self.ast.push(xt(XT::GenericArg._tag), "", at, -1, -1, -1, -1, self.cur.line, self.cur.col);
                self.impl_args = self.ast.push_tail(self.impl_args, an);
                if !self.eat_delim(D::Comma._tag) { break; }
            }
            self.expect_delim(D::RBracket._tag, "expected ] in impl generics");
        }
        self.expect_delim(D::LBrace._tag, "expected { in impl");
        head = -1;
        while true {
            if self.check_delim(D::RBrace._tag) { break; }
            if self.at_end() { break; }
            if self.failed == 1 { break; }
            self.skip_attrs();
            self.eat_kw(Kw::Pub._tag);
            if self.check_kw(Kw::Fn._tag) {
                m = self.parse_fn();
                head = self.ast.push_tail(head, m);
            } else {
                self.advance();
            }
        }
        self.expect_delim(D::RBrace._tag, "expected } after impl");
        self.cur_impl = "";
        return self.ast.push(st(ST::ImplBlock._tag), tname, -1, head, -1, -1, -1, self.cur.line, self.cur.col);
    }

    fn parse_fn(ref mut self) -> int {
        return self.parse_fn_body(1);
    }

    fn parse_fn_body(ref mut self, int with_body) -> int {
        self.expect_kw(Kw::Fn._tag, "expected fn");
        name = self.expect_ident("expected fn name");
        if self.check_delim(D::LBracket._tag) { self.skip_brackets(); }
        self.expect_delim(D::LParen._tag, "expected ( after fn name");
        head = -1;
        while true {
            if self.check_delim(D::RParen._tag) { break; }
            if self.at_end() { break; }
            if self.failed == 1 { break; }
            recv = -1;
            if self.check_kw(Kw::Self_._tag) {
                recv = 0;
            } elif self.check_kw(Kw::Ref._tag) && self.la1_is_kw(Kw::Self_._tag) {
                recv = 1;
            } elif self.check_kw(Kw::Ref._tag) && self.la1_is_kw(Kw::Mut._tag) && self.la2_is_kw(Kw::Self_._tag) {
                recv = 2;
            }
            if recv >= 0 {
                line = self.cur.line;
                col = self.cur.col;
                base = self.ast.push(tt(TT::Named._tag), self.cur_impl, -1, -1, -1, -1, -1, line, col);
                if self.impl_args >= 0 {
                    base = self.ast.push(tt(TT::Generic._tag), self.cur_impl, -1, self.impl_args, -1, -1, -1, line, col);
                }
                recv_ty = base;
                if recv == 1 {
                    recv_ty = self.ast.push(tt(TT::Ref._tag), "", -1, base, 0, -1, -1, line, col);
                } elif recv == 2 {
                    recv_ty = self.ast.push(tt(TT::Ref._tag), "", -1, base, 1, -1, -1, line, col);
                }
                self.advance();
                if recv == 1 { self.advance(); }
                if recv == 2 { self.advance(); self.advance(); }
                p = self.ast.push(xt(XT::Param._tag), "self", recv_ty, -1, -1, -1, -1, line, col);
                head = self.ast.push_tail(head, p);
            } else {
                ty = self.parse_type();
                pname = self.expect_ident("expected parameter name");
                p = self.ast.push(xt(XT::Param._tag), pname, ty, -1, -1, -1, -1, self.cur.line, self.cur.col);
                head = self.ast.push_tail(head, p);
            }
            if !self.eat_delim(D::Comma._tag) { break; }
        }
        self.expect_delim(D::RParen._tag, "expected ) after params");
        ret = -1;
        if self.eat_delim(D::Arrow._tag) {
            ret = self.parse_type();
        } else {
            ret = self.ast.push(tt(TT::Void._tag), "", -1, -1, -1, -1, -1, self.cur.line, self.cur.col);
        }
        body = -1;
        if with_body == 1 {
            body = self.parse_block();
        }
        node = self.ast.push(st(ST::FnDecl._tag), name, ret, head, body, -1, -1, self.cur.line, self.cur.col);
        return node;
    }

    fn parse_enum(ref mut self) -> int {
        self.expect_kw(Kw::Enum._tag, "expected enum");
        name = self.expect_ident("expected enum name");
        if self.check_delim(D::LBracket._tag) { self.skip_brackets(); }
        self.expect_delim(D::LBrace._tag, "expected { in enum");
        depth = 1;
        while true {
            if self.at_end() { break; }
            if depth <= 0 { break; }
            if self.check_delim(D::LBrace._tag) { depth = depth + 1; }
            if self.check_delim(D::RBrace._tag) { depth = depth - 1; }
            self.advance();
        }
        return self.ast.push(st(ST::EnumDef._tag), name, -1, -1, -1, -1, -1, self.cur.line, self.cur.col);
    }

    fn parse_interface(ref mut self) -> int {
        self.expect_kw(Kw::Interface._tag, "expected interface");
        name = self.expect_ident("expected interface name");
        if self.check_delim(D::LBracket._tag) { self.skip_brackets(); }
        self.expect_delim(D::LBrace._tag, "expected { in interface");
        head = -1;
        while true {
            if self.check_delim(D::RBrace._tag) { break; }
            if self.at_end() { break; }
            if self.failed == 1 { break; }
            self.eat_kw(Kw::Pub._tag);
            if self.check_kw(Kw::Fn._tag) {
                m = self.parse_fn_body(0);
                head = self.ast.push_tail(head, m);
            } else {
                self.advance();
            }
        }
        self.expect_delim(D::RBrace._tag, "expected } after interface");
        return self.ast.push(st(ST::InterfaceDef._tag), name, -1, head, -1, -1, -1, self.cur.line, self.cur.col);
    }

    fn parse_const(ref mut self) -> int {
        self.expect_kw(Kw::Const._tag, "expected const");
        name = self.expect_ident("expected const name");
        ty = -1;
        if self.eat_delim(D::Colon._tag) {
            ty = self.parse_type();
        }
        if !self.eat_op("=") {
            self.error("expected = in const");
        }
        val = self.parse_expr();
        return self.ast.push(st(ST::ConstDecl._tag), name, ty, val, -1, -1, -1, self.cur.line, self.cur.col);
    }

    fn parse_block(ref mut self) -> int {
        self.expect_delim(D::LBrace._tag, "expected { to start block");
        blk = self.ast.push(st(ST::Block._tag), "", -1, -1, -1, -1, -1, self.cur.line, self.cur.col);
        head = -1;
        last_semi = 0;
        while true {
            if self.check_delim(D::RBrace._tag) { break; }
            if self.at_end() { break; }
            if self.failed == 1 { break; }
            s = self.parse_stmt();
            last_semi = 0;
            if self.eat_delim(D::Semicolon._tag) { last_semi = 1; }
            if s >= 0 { head = self.ast.push_tail(head, s); }
        }
        self.expect_delim(D::RBrace._tag, "expected } to close block");
        // 尾表达式：最后一条 ExprStmt 提升为 block 的尾（dump 里 Block 不打印尾，
        // 但 if 表达式会打印）
        // 尾表达式：无分号时，最后一个节点若是表达式（ExprStmt）或 if/match
        // 语句（在尾位置即 if/match 表达式）→ 提升为 tail
        if last_semi == 0 {
            last = head;
            prev = -1;
            while last >= 0 {
                nxt = self.ast.nexts[last];
                if nxt < 0 { break; }
                prev = last;
                last = nxt;
            }
            if last >= 0 {
                ltag = self.ast.tags[last];
                tail = -1;
                if ltag == st(ST::ExprStmt._tag) {
                    tail = self.ast.aa[last];
                } elif ltag == st(ST::Match._tag) {
                    tail = self.ast.push(et(ET::Match._tag), "", -1, self.ast.aa[last], -1, -1, -1, self.ast.lines[last], self.ast.cols[last]);
                } elif ltag == st(ST::If._tag) {
                    has_else = 0;
                    if self.ast.dd[last] >= 0 { has_else = 1; }
                    if has_else == 1 {
                        if self.tail_if == 1 || self.if_stmt_has_tail(last) {
                            tail = self.ast.push(et(ET::If._tag), "", -1, self.ast.aa[last], self.ast.bb[last], self.ast.cc[last], self.ast.dd[last], self.ast.lines[last], self.ast.cols[last]);
                        }
                    }
                }
                if tail >= 0 {
                    self.ast.bb[blk] = tail;
                    if prev >= 0 {
                        self.ast.nexts[prev] = -1;
                    } else {
                        head = -1;
                    }
                }
            }
        }
        self.ast.aa[blk] = head;
        return blk;
    }

    // ---------- 语句 ----------

    /// if 语句的任一分支块是否有尾表达式（决定它是否是 if 表达式）
    fn if_stmt_has_tail(ref mut self, int id) -> bool {
        b = self.ast.bb[id];
        if b >= 0 {
            if self.ast.bb[b] >= 0 { return true; }
        }
        e = self.ast.cc[id];
        while e >= 0 {
            eb = self.ast.bb[e];
            if eb >= 0 {
                if self.ast.bb[eb] >= 0 { return true; }
            }
            e = self.ast.nexts[e];
        }
        d = self.ast.dd[id];
        if d >= 0 {
            if self.ast.bb[d] >= 0 { return true; }
        }
        return false;
    }

    fn collect_attrs(ref mut self) -> int {
        n = 0;
        while true {
            if !self.check_op("#") { break; }
            if !self.la1_is_delim(D::LBracket._tag) { break; }
            self.advance();
            self.skip_brackets();
            n = n + 1;
        }
        return n;
    }

    fn parse_stmt(ref mut self) -> int {
        nattrs = self.collect_attrs();
        s = self.parse_stmt_inner();
        if nattrs > 0 {
            if s >= 0 {
                return self.ast.push(st(ST::Attributed._tag), "", -1, s, nattrs, -1, -1, self.cur.line, self.cur.col);
            }
        }
        return s;
    }

    fn parse_stmt_inner(ref mut self) -> int {
        if self.check_kw(Kw::Return._tag) {
            line = self.cur.line;
            col = self.cur.col;
            self.advance();
            val = -1;
            if !self.check_delim(D::RBrace._tag) && !self.at_end() {
                val = self.parse_expr();
            }
            return self.ast.push(st(ST::Return._tag), "", -1, val, -1, -1, -1, line, col);
        }
        if self.check_kw(Kw::If._tag) {
            return self.parse_if_stmt();
        }
        if self.check_kw(Kw::While._tag) {
            line = self.cur.line;
            col = self.cur.col;
            self.advance();
            self.no_struct = 1;
            cond = self.parse_expr();
            self.no_struct = 0;
            body = self.parse_block();
            return self.ast.push(st(ST::While._tag), "", -1, cond, body, -1, -1, line, col);
        }
        if self.check_kw(Kw::Break._tag) {
            line = self.cur.line;
            col = self.cur.col;
            self.advance();
            return self.ast.push(st(ST::Break._tag), "", -1, -1, -1, -1, -1, line, col);
        }
        if self.check_kw(Kw::Continue._tag) {
            line = self.cur.line;
            col = self.cur.col;
            self.advance();
            return self.ast.push(st(ST::Continue._tag), "", -1, -1, -1, -1, -1, line, col);
        }
        if self.check_kw(Kw::For._tag) {
            line = self.cur.line;
            col = self.cur.col;
            self.advance();
            it = self.expect_ident("expected iterator name");
            self.expect_kw(Kw::In._tag, "expected in");
            self.expect_delim(D::LParen._tag, "expected ( after in");
            start = self.parse_expr();
            self.expect_delim(D::Comma._tag, "expected , in for range");
            end = self.parse_expr();
            step = -1;
            if self.eat_delim(D::Comma._tag) {
                step = self.parse_expr();
            }
            self.expect_delim(D::RParen._tag, "expected ) in for range");
            body = self.parse_block();
            return self.ast.push(st(ST::For._tag), it, -1, start, end, step, body, line, col);
        }
        if self.check_kw(Kw::Match._tag) {
            line = self.cur.line;
            col = self.cur.col;
            self.advance();
            self.no_struct = 1;
            val = self.parse_expr();
            self.no_struct = 0;
            self.expect_delim(D::LBrace._tag, "expected { in match");
            depth = 1;
            while true {
                if self.at_end() { break; }
                if depth <= 0 { break; }
                if self.check_delim(D::LBrace._tag) { depth = depth + 1; }
                if self.check_delim(D::RBrace._tag) { depth = depth - 1; }
                self.advance();
            }
            return self.ast.push(st(ST::Match._tag), "", -1, val, -1, -1, -1, line, col);
        }
        line = self.cur.line;
        col = self.cur.col;
        e = self.parse_expr();
        if self.check_op("=") {
            self.advance();
            val = self.parse_expr();
            etag = self.ast.tags[e];
            if etag == et(ET::Ident._tag) {
                return self.ast.push(st(ST::Assign._tag), self.ast.texts[e], -1, val, -1, -1, -1, line, col);
            }
            if etag == et(ET::FieldAccess._tag) {
                return self.ast.push(st(ST::FieldAssign._tag), self.ast.texts[e], -1, self.ast.aa[e], val, -1, -1, line, col);
            }
            if etag == et(ET::Index._tag) {
                return self.ast.push(st(ST::IndexAssign._tag), "", -1, self.ast.aa[e], self.ast.bb[e], val, -1, line, col);
            }
            self.error("invalid assignment target");
            return -1;
        }
        return self.ast.push(st(ST::ExprStmt._tag), "", -1, e, -1, -1, -1, line, col);
    }

    fn parse_if_stmt(ref mut self) -> int {
        line = self.cur.line;
        col = self.cur.col;
        self.expect_kw(Kw::If._tag, "expected if");
        self.no_struct = 1;
        cond = self.parse_expr();
        self.no_struct = 0;
        then_b = self.parse_block();
        elifs = -1;
        else_b = -1;
        while self.check_kw(Kw::Elif._tag) {
            self.advance();
            ec = self.parse_expr();
            eb = self.parse_block();
            en = self.ast.push(xt(XT::Elif._tag), "", -1, ec, eb, -1, -1, self.cur.line, self.cur.col);
            elifs = self.ast.push_tail(elifs, en);
        }
        if self.eat_kw(Kw::Else._tag) {
            else_b = self.parse_block();
        }
        return self.ast.push(st(ST::If._tag), "", -1, cond, then_b, elifs, else_b, line, col);
    }

    // ---------- 表达式（优先级爬升） ----------

    fn bin_tag(ref mut self, ref String op) -> int {
        if op == "||" { return bo(BinOp::Or._tag); }
        if op == "&&" { return bo(BinOp::And._tag); }
        if op == "|" { return bo(BinOp::BitOr._tag); }
        if op == "^" { return bo(BinOp::BitXor._tag); }
        if op == "&" { return bo(BinOp::BitAnd._tag); }
        if op == "==" { return bo(BinOp::Eq._tag); }
        if op == "!=" { return bo(BinOp::Neq._tag); }
        if op == "<" { return bo(BinOp::Lt._tag); }
        if op == ">" { return bo(BinOp::Gt._tag); }
        if op == "<=" { return bo(BinOp::Le._tag); }
        if op == ">=" { return bo(BinOp::Ge._tag); }
        if op == "<<" { return bo(BinOp::Shl._tag); }
        if op == ">>" { return bo(BinOp::Shr._tag); }
        if op == "+" { return bo(BinOp::Add._tag); }
        if op == "-" { return bo(BinOp::Sub._tag); }
        if op == "*" { return bo(BinOp::Mul._tag); }
        if op == "/" { return bo(BinOp::Div._tag); }
        if op == "%" { return bo(BinOp::Mod._tag); }
        return -1;
    }

    fn op_level(ref mut self, ref String op) -> int {
        if op == "||" { return 1; }
        if op == "&&" { return 2; }
        if op == "|" { return 3; }
        if op == "^" { return 4; }
        if op == "&" { return 5; }
        if op == "==" || op == "!=" { return 6; }
        if op == "<" || op == ">" || op == "<=" || op == ">=" { return 7; }
        if op == "<<" || op == ">>" { return 8; }
        if op == "+" || op == "-" { return 9; }
        if op == "*" || op == "/" || op == "%" { return 10; }
        return 0;
    }

    fn parse_expr(ref mut self) -> int {
        return self.parse_bin(1);
    }

    fn parse_bin(ref mut self, int min_level) -> int {
        lhs = self.parse_unary();
        while self.cur.kind == Tk::Op._tag && self.failed == 0 {
            op = self.cur.text.copy();
            lvl = self.op_level(op);
            if lvl == 0 || lvl < min_level { break; }
            line = self.cur.line;
            col = self.cur.col;
            self.advance();
            rhs = self.parse_bin(lvl + 1);
            tag = self.bin_tag(op);
            lhs = self.ast.push(et(ET::Binary._tag), "", tag, lhs, rhs, -1, -1, line, col);
        }
        return lhs;
    }

    fn apply_cast(ref mut self, int e, int line, int col) -> int {
        while self.check_kw(Kw::As._tag) {
            self.advance();
            ty = self.parse_type();
            e = self.ast.push(et(ET::Cast._tag), "", ty, e, -1, -1, -1, line, col);
        }
        return e;
    }

    fn parse_unary(ref mut self) -> int {
        line = self.cur.line;
        col = self.cur.col;
        if self.check_op("-") {
            self.advance();
            if self.cur.kind == Tk::IntLit._tag || self.cur.kind == Tk::FloatLit._tag {
                // 只有带后缀的字面量才把负号折进去（-128i8 → Int(-128)i8），
                // 普通 -1 保持 Unary(Neg, Int(1))；随后应用 as（-1 as u8 = (-1) as u8）
                ntext = self.cur.text.copy();
                if num_len(ntext) < ntext.len as int {
                    e = self.parse_number_literal(1, line, col);
                    return self.apply_cast(e, line, col);
                }
                lit = self.parse_number_literal(0, line, col);
                e = self.ast.push(et(ET::Unary._tag), "", uo(UnOp::Neg._tag), lit, -1, -1, -1, line, col);
                return self.apply_cast(e, line, col);
            }
            arg = self.parse_unary();
            e = self.ast.push(et(ET::Unary._tag), "", uo(UnOp::Neg._tag), arg, -1, -1, -1, line, col);
            return self.apply_cast(e, line, col);
        }
        if self.check_op("!") {
            self.advance();
            arg = self.parse_unary();
            e = self.ast.push(et(ET::Unary._tag), "", uo(UnOp::Not._tag), arg, -1, -1, -1, line, col);
            return self.apply_cast(e, line, col);
        }
        if self.check_op("~") {
            self.advance();
            arg = self.parse_unary();
            e = self.ast.push(et(ET::Unary._tag), "", uo(UnOp::BitNot._tag), arg, -1, -1, -1, line, col);
            return self.apply_cast(e, line, col);
        }
        if self.check_kw(Kw::Ref._tag) {
            self.advance();
            mutable = 0;
            if self.eat_kw(Kw::Mut._tag) { mutable = 1; }
            arg = self.parse_unary();
            return self.ast.push(et(ET::Ref._tag), "", -1, arg, mutable, -1, -1, line, col);
        }
        if self.check_kw(Kw::Move._tag) {
            self.advance();
            arg = self.parse_unary();
            return self.ast.push(et(ET::Move._tag), "", -1, arg, -1, -1, -1, line, col);
        }
        if self.check_kw(Kw::Clone._tag) {
            self.advance();
            arg = self.parse_unary();
            return self.ast.push(et(ET::Clone._tag), "", -1, arg, -1, -1, -1, line, col);
        }
        return self.parse_postfix();
    }

    fn parse_postfix(ref mut self) -> int {
        qmark = "?";
        e = self.parse_primary();
        while self.failed == 0 {
            if self.check_delim(D::LParen._tag) {
                line = self.cur.line;
                col = self.cur.col;
                args = self.parse_args();
                // FnCall 只对 Ident 目标；其他走 CallExpr
                if self.ast.tags[e] == et(ET::Ident._tag) {
                    e = self.ast.push(et(ET::FnCall._tag), self.ast.texts[e], -1, args, -1, -1, -1, line, col);
                } else {
                    e = self.ast.push(et(ET::CallExpr._tag), "", -1, e, args, -1, -1, line, col);
                }
            } elif self.check_op("::") {
                line = self.cur.line;
                col = self.cur.col;
                self.advance();
                variant = self.expect_ident("expected path segment");
                full = self.ast.texts[e].copy();
                full = full + ".";
                full = full + variant;
                if self.check_delim(D::LBracket._tag) { self.skip_brackets(); }
                targs = -1;
                nargs = -1;
                if self.check_delim(D::LParen._tag) {
                    targs = self.parse_args();
                    e = self.ast.push(et(ET::FnCall._tag), full, -1, targs, -1, -1, -1, line, col);
                    continue;
                } elif !self.check_delim(D::LBrace._tag) {
                    // 裸路径（math::PI2）当作 Ident
                    e = self.ast.push(et(ET::Ident._tag), full, -1, -1, -1, -1, -1, line, col);
                    continue;
                } elif self.check_delim(D::LBrace._tag) {
                    self.advance();
                    while true {
                        if self.check_delim(D::RBrace._tag) { break; }
                        if self.at_end() { break; }
                        if self.failed == 1 { break; }
                        self.expect_ident("expected field name");
                        if !self.eat_op("=") {
                            self.error("expected = in enum ctor");
                            break;
                        }
                        v = self.parse_expr();
                        n = self.ast.push(xt(XT::StructLitField._tag), "", -1, v, -1, -1, -1, self.cur.line, self.cur.col);
                        nargs = self.ast.push_tail(nargs, n);
                        if !self.eat_delim(D::Comma._tag) { break; }
                    }
                    self.expect_delim(D::RBrace._tag, "expected } in enum ctor");
                }
                e = self.ast.push(et(ET::EnumConstruct._tag), full, -1, targs, nargs, -1, -1, line, col);
            } elif self.check_delim(D::Dot._tag) {
                line = self.cur.line;
                col = self.cur.col;
                self.advance();
                name = self.expect_ident("expected field or method name");
                if self.check_delim(D::LParen._tag) {
                    args = self.parse_args();
                    e = self.ast.push(et(ET::MethodCall._tag), name, -1, e, args, -1, -1, line, col);
                } else {
                    e = self.ast.push(et(ET::FieldAccess._tag), name, -1, e, -1, -1, -1, line, col);
                }
            } elif self.check_delim(D::LBracket._tag) {
                line = self.cur.line;
                col = self.cur.col;
                self.advance();
                idx = self.parse_expr();
                self.expect_delim(D::RBracket._tag, "expected ] after index");
                e = self.ast.push(et(ET::Index._tag), "", -1, e, idx, -1, -1, line, col);
            } elif self.check_op(qmark) {
                line = self.cur.line;
                col = self.cur.col;
                self.advance();
                e = self.ast.push(et(ET::TryOp._tag), "", -1, e, -1, -1, -1, line, col);
            } elif self.check_kw(Kw::As._tag) {
                line = self.cur.line;
                col = self.cur.col;
                self.advance();
                ty = self.parse_type();
                e = self.ast.push(et(ET::Cast._tag), "", ty, e, -1, -1, -1, line, col);
            } else {
                break;
            }
        }
        return e;
    }

    fn parse_args(ref mut self) -> int {
        self.expect_delim(D::LParen._tag, "expected (");
        head = -1;
        while true {
            if self.check_delim(D::RParen._tag) { break; }
            if self.at_end() { break; }
            if self.failed == 1 { break; }
            a = self.parse_expr();
            an = self.ast.push(xt(XT::Arg._tag), "", -1, a, -1, -1, -1, self.cur.line, self.cur.col);
            head = self.ast.push_tail(head, an);
            if !self.eat_delim(D::Comma._tag) { break; }
        }
        self.expect_delim(D::RParen._tag, "expected ) after args");
        return head;
    }

    /// 解析数字字面量；neg=1 时把负号折进字面量（与 rust 版一致）
    fn parse_number_literal(ref mut self, int neg, int line, int col) -> int {
        isf = 0;
        if self.cur.kind == Tk::FloatLit._tag { isf = 1; }
        text = self.cur.text.copy();
        self.advance();
        nl = num_len(text);
        numtxt = text.substring(0 as usize, nl as usize);
        suftxt = text.substring(nl as usize, text.len);
        if neg == 1 {
            numtxt = "-" + numtxt;
        }
        lk_tag = lk(LK::Int._tag);
        if isf == 1 { lk_tag = lk(LK::Float._tag); }
        lit = self.ast.push(et(ET::Literal._tag), numtxt, -1, -1, lk_tag, -1, -1, line, col);
        if suftxt.len > 0 {
            return self.ast.push(et(ET::Suffixed._tag), suftxt, -1, lit, -1, -1, -1, line, col);
        }
        return lit;
    }

    fn parse_primary(ref mut self) -> int {
        line = self.cur.line;
        col = self.cur.col;
        if self.cur.kind == Tk::IntLit._tag || self.cur.kind == Tk::FloatLit._tag {
            return self.parse_number_literal(0, line, col);
        }
        if self.cur.kind == Tk::CharLit._tag {
            s = self.cur.text.copy();
            self.advance();
            return self.ast.push(et(ET::Literal._tag), s, -1, -1, lk(LK::Char._tag), -1, -1, line, col);
        }
        if self.cur.kind == Tk::StrLit._tag {
            s = self.cur.text.copy();
            self.advance();
            return self.ast.push(et(ET::Literal._tag), s, -1, -1, lk(LK::Str._tag), -1, -1, line, col);
        }
        if self.check_kw(Kw::True._tag) {
            self.advance();
            return self.ast.push(et(ET::Literal._tag), "true", -1, -1, lk(LK::Bool._tag), -1, -1, line, col);
        }
        if self.check_kw(Kw::False._tag) {
            self.advance();
            return self.ast.push(et(ET::Literal._tag), "false", -1, -1, lk(LK::Bool._tag), -1, -1, line, col);
        }
        if self.check_kw(Kw::Null._tag) {
            self.advance();
            return self.ast.push(et(ET::Null._tag), "", -1, -1, -1, -1, -1, line, col);
        }
        if self.check_kw(Kw::If._tag) {
            self.advance();
            self.no_struct = 1;
            cond = self.parse_expr();
            self.no_struct = 0;
            self.tail_if = 1;
            then_b = self.parse_block();
            elifs = -1;
            else_b = -1;
            while self.check_kw(Kw::Elif._tag) {
                self.advance();
                self.no_struct = 1;
                ec = self.parse_expr();
                self.no_struct = 0;
                self.tail_if = 1;
                eb = self.parse_block();
                en = self.ast.push(xt(XT::Elif._tag), "", -1, ec, eb, -1, -1, self.cur.line, self.cur.col);
                elifs = self.ast.push_tail(elifs, en);
            }
            if self.eat_kw(Kw::Else._tag) {
                self.tail_if = 1;
                else_b = self.parse_block();
            }
            self.tail_if = 0;
            return self.ast.push(et(ET::If._tag), "", -1, cond, then_b, elifs, else_b, line, col);
        }
        if self.check_kw(Kw::Match._tag) {
            self.advance();
            self.no_struct = 1;
            val = self.parse_expr();
            self.no_struct = 0;
            self.expect_delim(D::LBrace._tag, "expected { in match expr");
            depth = 1;
            while true {
                if self.at_end() { break; }
                if depth <= 0 { break; }
                if self.check_delim(D::LBrace._tag) { depth = depth + 1; }
                if self.check_delim(D::RBrace._tag) { depth = depth - 1; }
                self.advance();
            }
            return self.ast.push(et(ET::Match._tag), "", -1, val, -1, -1, -1, line, col);
        }
        if self.check_kw(Kw::Asm._tag) {
            self.advance();
            tmpl = "";
            self.expect_delim(D::LParen._tag, "expected ( after asm");
            if self.cur.kind == Tk::StrLit._tag {
                tmpl = self.cur.text.copy();
                self.advance();
            }
            depth = 1;
            while true {
                if self.at_end() { break; }
                if depth <= 0 { break; }
                if self.check_delim(D::LParen._tag) { depth = depth + 1; }
                if self.check_delim(D::RParen._tag) { depth = depth - 1; }
                self.advance();
            }
            return self.ast.push(et(ET::Asm._tag), tmpl, -1, -1, -1, -1, -1, line, col);
        }
        if self.check_op("#") {
            self.advance();
            mname = self.expect_ident("expected macro name");
            while self.check_op("::") {
                self.advance();
                part = self.expect_ident("expected macro name part");
                mname = mname + ".";
                mname = mname + part;
            }
            margs = self.parse_args();
            return self.ast.push(et(ET::MacroCall._tag), mname, -1, margs, -1, -1, -1, line, col);
        }
        if self.check_delim(D::LParen._tag) {
            self.mark();
            lam = self.try_parse_lambda(line, col);
            if lam >= 0 { return lam; }
            self.restore();
            self.advance();
            e = self.parse_expr();
            self.expect_delim(D::RParen._tag, "expected )");
            return e;
        }
        if self.check_delim(D::LBracket._tag) {
            sized = 0;
            if self.la1_is_kw(Kw::Int._tag) || self.la1_is_kw(Kw::Float._tag) || self.la1_is_kw(Kw::Char._tag) || self.la1_is_kw(Kw::Bool._tag) || self.la1_is_kw(Kw::Self_._tag) || self.la1_is_kw(Kw::Ref._tag) || self.la1_is_kw(Kw::Unique._tag) || self.la1_is_kw(Kw::Fn._tag) {
                sized = 1;
            }
            if self.la1_is_ident() && self.la2_is_delim(D::Semicolon._tag) { sized = 1; }
            self.advance();
            if sized == 1 {
                ety = self.parse_type();
                self.expect_delim(D::Semicolon._tag, "expected ; in array type");
                cnt = self.parse_expr();
                self.expect_delim(D::RBracket._tag, "expected ] in array expr");
                return self.ast.push(et(ET::ArraySized._tag), "", ety, cnt, -1, -1, -1, line, col);
            }
            head = -1;
            first = -1;
            while true {
                if self.check_delim(D::RBracket._tag) { break; }
                if self.at_end() { break; }
                if self.failed == 1 { break; }
                a = self.parse_expr();
                if head < 0 { first = a; }
                if self.check_delim(D::Semicolon._tag) {
                    // [expr; n] 重复字面量
                    self.advance();
                    cnt = self.parse_expr();
                    self.expect_delim(D::RBracket._tag, "expected ] in array repeat");
                    return self.ast.push(et(ET::ArrayRepeat._tag), "", -1, first, cnt, -1, -1, line, col);
                }
                head = self.ast.push_tail(head, a);
                if !self.eat_delim(D::Comma._tag) { break; }
            }
            self.expect_delim(D::RBracket._tag, "expected ] after array literal");
            return self.ast.push(et(ET::ArrayLiteral._tag), "", -1, head, -1, -1, -1, line, col);
        }
        if self.check_kw(Kw::Self_._tag) {
            self.advance();
            return self.ast.push(et(ET::Ident._tag), "self", -1, -1, -1, -1, -1, line, col);
        }
        if self.cur.kind == Tk::Ident._tag {
            name = self.cur.text.copy();
            self.advance();
            // 泛型结构体字面量 Name[T] { ... }（启发式：单实参，类型名首字母大写/基本类型）
            if self.check_delim(D::LBracket._tag) && self.no_struct == 0 {
                self.mark();
                self.skip_brackets();
                if self.check_delim(D::LBrace._tag) {
                    return self.parse_struct_literal(name, line, col);
                }
                self.restore();
            }
            if self.check_delim(D::LBrace._tag) && self.no_struct == 0 {
                return self.parse_struct_literal(name, line, col);
            }
            return self.ast.push(et(ET::Ident._tag), name, -1, -1, -1, -1, -1, line, col);
        }
        self.error("expected expression");
        return -1;
    }

    /// 尝试解析 lambda `(类型 名称, ...) { 体 }`；失败返回 -1（调用方 restore）
    fn try_parse_lambda(ref mut self, int line, int col) -> int {
        self.advance();
        params = -1;
        while true {
            if self.check_delim(D::RParen._tag) { break; }
            if self.at_end() { return -1; }
            ty = self.parse_type();
            if self.failed == 1 { return -1; }
            pname = self.expect_ident("expected lambda param name");
            if self.failed == 1 { return -1; }
            pn = self.ast.push(xt(XT::Param._tag), pname, ty, -1, -1, -1, -1, self.cur.line, self.cur.col);
            params = self.ast.push_tail(params, pn);
            if !self.eat_delim(D::Comma._tag) { break; }
        }
        if !self.eat_delim(D::RParen._tag) { return -1; }
        if self.eat_delim(D::Arrow._tag) {
            self.parse_type();
            if self.failed == 1 { return -1; }
        }
        if !self.check_delim(D::LBrace._tag) { return -1; }
        body = self.parse_block();
        return self.ast.push(et(ET::Lambda._tag), "", -1, params, body, -1, -1, line, col);
    }

    fn parse_struct_literal(ref mut self, ref String name, int line, int col) -> int {
        self.expect_delim(D::LBrace._tag, "expected { in struct literal");
        head = -1;
        while true {
            if self.check_delim(D::RBrace._tag) { break; }
            if self.at_end() { break; }
            if self.failed == 1 { break; }
            fname = self.expect_ident("expected field name");
            if !self.eat_op("=") {
                self.error("expected = in struct literal");
                break;
            }
            val = self.parse_expr();
            fnode = self.ast.push(xt(XT::StructLitField._tag), fname, -1, val, -1, -1, -1, self.cur.line, self.cur.col);
            head = self.ast.push_tail(head, fnode);
            if !self.eat_delim(D::Comma._tag) { break; }
        }
        self.expect_delim(D::RBrace._tag, "expected } after struct literal");
        return self.ast.push(et(ET::StructLiteral._tag), name, -1, head, -1, -1, -1, line, col);
    }
}
