import "string";

// 文件读写（FFI；FILE* 用 int 承载，x86-64 指针/整数同寄存器）
// 注意：本模块不 import "std"（跨源文件重复 import std 会触发泛型方法解析缺陷），
// 结果类型用自有结构体而非 Option。
extern "C" fn fopen([char] path, [char] mode) -> int;
extern "C" fn fclose(int f) -> int;
extern "C" fn fgetc(int f) -> int;
extern "C" fn fputc(int c, int f) -> int;
extern "C" fn fseek(int f, int off, int whence) -> int;
extern "C" fn ftell(int f) -> int;
extern "C" fn __ayanami_int_to_char(int c) -> char;

/// 读取结果：ok=false 时 data 为空串
pub struct ReadResult {
    bool ok
    String data
}

fn to_cstr(ref String s) -> [char] {
    buf = [char; s.len + 1];
    for i in (0, s.len) {
        buf[i] = s.index(i);
    }
    buf[s.len] = '\0';
    return buf;
}

fn open_mode(ref String path, [char] mode_chars, int mode_len) -> int {
    path_c = to_cstr(path);
    mode = String::new(mode_chars, mode_len);
    mode_c = to_cstr(mode);
    return fopen(path_c, mode_c);
}

/// 读整个文件；不存在/读失败时 ok=false
pub fn read_file(ref String path) -> ReadResult {
    f = open_mode(path, ['r', 'b'], 2);
    if f == 0 {
        return ReadResult { ok = false, data = String::empty() };
    }
    fseek(f, 0, 2);
    n = ftell(f);
    fseek(f, 0, 0);
    if n <= 0 {
        fclose(f);
        return ReadResult { ok = true, data = String::empty() };
    }
    buf = [char; n];
    for i in (0, n) {
        c = fgetc(f);
        if c < 0 {
            fclose(f);
            return ReadResult { ok = false, data = String::empty() };
        }
        buf[i] = __ayanami_int_to_char(c);
    }
    fclose(f);
    return ReadResult { ok = true, data = String::new(buf, n) };
}

/// 写整个文件；失败返回 false
pub fn write_file(ref String path, ref String data) -> bool {
    f = open_mode(path, ['w', 'b'], 2);
    if f == 0 { return false; }
    for i in (0, data.len) {
        fputc(char_code(data.index(i)), f);
    }
    fclose(f);
    return true;
}

pub fn file_exists(ref String path) -> bool {
    f = open_mode(path, ['r', 'b'], 2);
    if f == 0 { return false; }
    fclose(f);
    return true;
}
