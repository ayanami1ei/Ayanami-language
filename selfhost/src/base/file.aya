import "string";
import "aya_sb";

// 文件读写（FFI；FILE* 用 int 承载，x86-64 指针/整数同寄存器）
// 块读写用 fread/fwrite + 定宽 i32 返回（C 的 int 上 32 位脏），显式 as int 转换；
// #154（extern ref 出参写不回）已修，不再需要单字节绕路
extern "C" fn fopen([char] path, [char] mode) -> int;
extern "C" fn fclose(int f) -> int;
extern "C" fn fread([char] buf, int sz, int n, int f) -> i32;
extern "C" fn fwrite([char] buf, int sz, int n, int f) -> i32;

/// 读取结果：ok=false 时 data 为空串
pub struct ReadResult {
    bool ok
    String data
}

#[alloc]
#[state]
pub fn to_cstr(ref String s) -> [char] {
    buf = [char; s.len + 1];
    for i in (0, s.len) {
        buf[i] = s.index(i);
    }
    buf[s.len] = '\0';
    return buf;
}

fn open_mode(ref String path, ref String mode) -> int {
    path_c = to_cstr(path);
    mode_c = to_cstr(mode);
    return fopen(path_c, mode_c);
}

/// 读整个文件；不存在/读失败时 ok=false
/// 不依赖 ftell（/proc 文件 size 为 0），8KB 块读取 + 倍增缓冲
#[alloc]
#[state]
pub fn read_file(ref String path) -> ReadResult {
    f = open_mode(path, "rb");
    if f == 0 {
        return ReadResult { ok = false, data = String::empty() };
    }
    acc = StringBuf::new();
    chunk = [char; 8192];
    while true {
        n = fread(chunk, 1, 8192, f) as int;
        if n <= 0 { break; }
        i = 0;
        while i < n {
            acc.push(chunk[i] as char);
            i = i + 1;
        }
        if n < 8192 { break; }
    }
    fclose(f);
    return ReadResult { ok = true, data = acc.to_string() };
}

/// 写整个文件；失败返回 false
#[alloc]
#[state]
pub fn write_file(ref String path, ref String data) -> bool {
    f = open_mode(path, "wb");
    if f == 0 { return false; }
    buf = [char; data.len + 1];
    for i in (0, data.len) {
        buf[i] = data.index(i);
    }
    n = fwrite(buf, 1, data.len as int, f) as int;
    fclose(f);
    if n != data.len as int { return false; }
    return true;
}

#[alloc]
#[state]
pub fn file_exists(ref String path) -> bool {
    f = open_mode(path, "rb");
    if f == 0 { return false; }
    fclose(f);
    return true;
}
