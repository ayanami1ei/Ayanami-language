import "string";
import "aya_sb";

// 文件读写（FFI；FILE* 用 int 承载，x86-64 指针/整数同寄存器）
// 单字节读写走 fread/fwrite + ref int 槽：
//   - 返回 size_t（i64）ABI 干净；C 的 int（fgetc）上 32 位是脏的，EOF 会变小正数
//   - ref int 形参不搬移 [char]，避免所有权移动
extern "C" fn fopen([char] path, [char] mode) -> int;
extern "C" fn fclose(int f) -> int;
extern "C" fn fread(ref int slot, int size, int n, int f) -> int;
extern "C" fn fwrite(ref int slot, int size, int n, int f) -> int;
extern "C" fn __ayanami_int_to_char(int c) -> char;

/// 读取结果：ok=false 时 data 为空串
pub struct ReadResult {
    bool ok
    String data
}

#[alloc]
#[state]
pub fn to_cstr(ref String s) -> [char] {
    buf = [char; s.len + 1];
    for i in (0, s.len) {
        buf[i] = s.index(i);
    }
    buf[s.len] = '\0';
    return buf;
}

fn open_mode(ref String path, ref String mode) -> int {
    path_c = to_cstr(path);
    mode_c = to_cstr(mode);
    return fopen(path_c, mode_c);
}

/// 读整个文件；不存在/读失败时 ok=false
/// 不依赖 ftell（/proc 文件 size 为 0），逐字节 + 倍增缓冲
#[alloc]
#[state]
pub fn read_file(ref String path) -> ReadResult {
    f = open_mode(path, "rb");
    if f == 0 {
        return ReadResult { ok = false, data = String::empty() };
    }
    acc = StringBuf::new();
    while true {
        slot = 0;
        got = fread(slot, 1, 1, f);
        if got != 1 { break; }
        acc.push(__ayanami_int_to_char(slot));
    }
    fclose(f);
    return ReadResult { ok = true, data = acc.to_string() };
}

/// 写整个文件；失败返回 false
#[alloc]
#[state]
pub fn write_file(ref String path, ref String data) -> bool {
    f = open_mode(path, "wb");
    if f == 0 { return false; }
    for i in (0, data.len) {
        slot = char_code(data.index(i));
        wrote = fwrite(slot, 1, 1, f);
        if wrote != 1 {
            fclose(f);
            return false;
        }
    }
    fclose(f);
    return true;
}

#[alloc]
#[state]
pub fn file_exists(ref String path) -> bool {
    f = open_mode(path, "rb");
    if f == 0 { return false; }
    fclose(f);
    return true;
}
