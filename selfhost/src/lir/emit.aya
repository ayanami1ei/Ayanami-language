            e.buf.push_str(" i64 ");
            e.buf.push_str(lt.a);
            e.buf.push_str(", ");
            e.buf.push_str(rt.a);
            e.buf.push_str("\n");
            z = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(z);
            e.buf.push_str(" = zext i1 ");
            e.buf.push_str(c);
            e.buf.push_str(" to i64\n");
            return mk_int(z);
        }
        if op == bo(BinOp::And._tag) || op == bo(BinOp::Or._tag) {
