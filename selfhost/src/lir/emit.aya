            e.buf.push_str("  ");
            e.buf.push_str(rv2);
            e.buf.push_str(" = load i64, ptr ");
            e.buf.push_str(rp);
            e.buf.push_str("\n");
            return mk_int(rv2);
        }
        if kd == 20 {
            t = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t);
            e.buf.push_str(" = load ptr, ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str(".p");
            e.buf.push_str("\n");
            ei5 = e.etype_of_local(nm);
            en5 = "";
            if ei5 >= 0 { en5 = e.en_names[ei5].copy(); }
            return Val { kind = 4, a = t, b = en5, ty = -1 };
        }
        if kd == 21 {
            // 接口值：装载 box 指针；接口名来自 etype（vtable 派发用）
            t21 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t21);
            e.buf.push_str(" = load ptr, ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str(".p\n");
            e21 = e.etype_of_local(nm);
            n21 = "";
            if e21 >= 0 { n21 = e.if_names[e21].copy(); }
            return Val { kind = 21, a = t21, b = n21, ty = -1 };
        }
