        t = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(t);
        e.buf.push_str(" = call ptr @malloc(i64 ");
        e.buf.push_str(nb.to_string());
        e.buf.push_str(")\n  call void @llvm.memset.p0.i64(ptr ");
        e.buf.push_str(t);
        e.buf.push_str(", i8 0, i64 ");
        e.buf.push_str(nb.to_string());
        e.buf.push_str(", i1 false)\n");
        f = ast.aa[id];
        while f >= 0 {
            idx = e.find_field_idx(nm, ast.texts[f]);
            if idx >= 0 {
                v = emit_expr(ast, ast.aa[f], e);
                si_l = e.find_struct_idx(nm);
                sl = e.fslot_at(si_l, idx);
                fk = e.fkind_at(si_l, idx);
                g = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(g);
                e.buf.push_str(" = getelementptr %struct.");
                e.buf.push_str(nm);
                e.buf.push_str(", ptr ");
                e.buf.push_str(t);
                e.buf.push_str(", i32 0, i32 ");
                e.buf.push_int(sl);
                e.buf.push_str("\n");
                if fk == 1 {
                    e.buf.push_str("  store ptr ");
                    e.buf.push_str(ptr_operand(v.a));
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(g);
                    e.buf.push_str("\n");
                    g1b = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(g1b);
                    e.buf.push_str(" = getelementptr %struct.");
                    e.buf.push_str(nm);
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(t);
                    e.buf.push_str(", i32 0, i32 ");
                    e.buf.push_int(sl + 1);
                    e.buf.push_str("\n  store i64 ");
                    e.buf.push_str(v.b);
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(g1b);
                    e.buf.push_str("\n");
                } elif fk == 5 {
                    fv5 = float_operand(v, e);
                    e.buf.push_str("  store double ");
                    e.buf.push_str(fv5);
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(g);
                    e.buf.push_str("\n");
                } elif fk == 2 || fk == 3 || fk == 4 {
                    e.buf.push_str("  store ptr ");
                    e.buf.push_str(ptr_operand(v.a));
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(g);
                    e.buf.push_str("\n");
                } elif fk == 6 {
                    // 接口字段：值需为 box（kind 21），具体值就地装箱
                    fv6 = v.a.copy();
                    if v.kind != 21 {
                        fi6b = e.finfo_at(si_l, idx);
                        in6b = "";
                        if fi6b >= 0 { in6b = e.if_names[fi6b].copy(); }
                        fv6 = e.emit_box(v, in6b);
                    }
                    e.buf.push_str("  store ptr ");
                    e.buf.push_str(fv6);
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(g);
                    e.buf.push_str("\n");
                } else {
                    store_slot_i64(e, g, v);
                }
            }
            f = ast.nexts[f];
        }
        return Val { kind = 2, a = t, b = nm.copy(), ty = -1 };
    }
    if tag == et(ET::TryOp._tag) {
        // `expr?`：枚举 tag != Ok/Some 则从当前函数原样返回，否则取载荷
        v_try = emit_expr(ast, ast.aa[id], e);
        if v_try.kind != 4 { return v_try; }
        en_try = v_try.b.copy();
        ei_try = e.find_enum_idx(en_try);
        ok_i = -1;
        ok_nm = "Ok";
        if ei_try >= 0 {
            ok_i = e.find_variant_idx(ei_try, "Ok");
            if ok_i < 0 {
                ok_i = e.find_variant_idx(ei_try, "Some");
                ok_nm = "Some";
            }
        }
        gt_try = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(gt_try);
        e.buf.push_str(" = getelementptr %enum.");
        e.buf.push_str(en_try);
        e.buf.push_str(", ptr ");
        e.buf.push_str(v_try.a);
        e.buf.push_str(", i32 0, i32 0\n  ");
        tg_try = e.fresh();
        e.buf.push_str(tg_try);
        e.buf.push_str(" = load i64, ptr ");
        e.buf.push_str(gt_try);
        e.buf.push_str("\n  ");
        c_try = e.fresh();
        e.buf.push_str(c_try);
        e.buf.push_str(" = icmp ne i64 ");
        e.buf.push_str(tg_try);
        e.buf.push_str(", ");
        e.buf.push_int(ok_i);
        e.buf.push_str("\n  br i1 ");
        e.buf.push_str(c_try);
        err_l = label(e, "try.err.");
        ok_l = label(e, "try.ok.");
        e.buf.push_str(", label %");
        e.buf.push_str(err_l);
        e.buf.push_str(", label %");
        e.buf.push_str(ok_l);
        e.buf.push_str("\n");
        e.buf.push_str(err_l);
        e.buf.push_str(":\n");
        e.terminated = 1;
        pi_try = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(pi_try);
        e.buf.push_str(" = ptrtoint ptr ");
        e.buf.push_str(v_try.a);
        e.buf.push_str(" to i64\n  ret i64 ");
        e.buf.push_str(pi_try);
        e.buf.push_str("\n");
        e.buf.push_str(ok_l);
        e.buf.push_str(":\n");
        e.terminated = 0;
        return emit_variant_payload(ast, v_try.a, en_try, ok_nm, e);
    }
    if tag == et(ET::FieldAccess._tag) {
        // _data_<Variant>._<N>：整体识别（内层不能单独发射，否则会先退化成 0）
        ob4 = ast.aa[id];
        if ob4 >= 0 {
            if ast.tags[ob4] == et(ET::FieldAccess._tag) {
                f4 = ast.texts[ob4];
                if f4.starts_with("_data_") {
                    ix4 = ast.texts[id];
                    if ix4.starts_with("_") {
                        oo4 = emit_expr(ast, ast.aa[ob4], e);
                        if oo4.kind == 4 {
                            vn4 = f4.substring(6 as usize, f4.len);
                            k4 = dec_val_e(ix4.substring(1 as usize, ix4.len));
                            ei4 = e.find_enum_idx(oo4.b);
                            if ei4 >= 0 && k4 >= 0 {
                                vi4 = e.find_variant_idx(ei4, vn4);
                                if vi4 >= 0 {
                                    sl4 = e.payload_slot(ast, ei4, vi4, k4);
                                    g4p = e.fresh();
                                    e.buf.push_str("  ");
                                    e.buf.push_str(g4p);
                                    e.buf.push_str(" = getelementptr %enum.");
                                    e.buf.push_str(oo4.b);
                                    e.buf.push_str(", ptr ");
                                    e.buf.push_str(oo4.a);
                                    e.buf.push_str(", i32 0, i32 ");
                                    e.buf.push_int(sl4);
                                    e.buf.push_str("\n");
                                    pty4 = e.variant_ptype(ei4, vi4, k4);
                                    if pty4 >= 0 {
                                        if ty_name(ast, pty4) == "String" {
                                            p4s = e.fresh();
                                            e.buf.push_str("  ");
                                            e.buf.push_str(p4s);
                                            e.buf.push_str(" = load ptr, ptr ");
                                            e.buf.push_str(g4p);
                                            e.buf.push_str("\n  ");
                                            l4s = e.fresh();
                                            e.buf.push_str(l4s);
                                            e.buf.push_str(" = getelementptr i8, ptr ");
                                            e.buf.push_str(g4p);
                                            e.buf.push_str(", i64 8\n  ");
                                            v4s = e.fresh();
                                            e.buf.push_str(v4s);
                                            e.buf.push_str(" = load i64, ptr ");
                                            e.buf.push_str(l4s);
                                            e.buf.push_str("\n");
                                            return mk_str_tmp(p4s, v4s);
                                        }
                                        pn4 = ty_name(ast, pty4);
                                        if pn4.len > 0 {
                                            if e.find_struct_idx(pn4) >= 0 || e.find_enum_idx(pn4) >= 0 {
                                                i4p = e.fresh();
                                                e.buf.push_str("  ");
                                                e.buf.push_str(i4p);
                                                e.buf.push_str(" = load i64, ptr ");
                                                e.buf.push_str(g4p);
                                                e.buf.push_str("\n  ");
                                                q4p = e.fresh();
                                                e.buf.push_str(q4p);
                                                e.buf.push_str(" = inttoptr i64 ");
                                                e.buf.push_str(i4p);
                                                e.buf.push_str(" to ptr\n");
                                                if e.find_struct_idx(pn4) >= 0 {
                                                    return Val { kind = 2, a = q4p, b = pn4.copy(), ty = -1 };
                                                }
                                                return Val { kind = 4, a = q4p, b = pn4.copy(), ty = -1 };
                                            }
                                        }
                                    }
                                    v4i = e.fresh();
                                    e.buf.push_str("  ");
                                    e.buf.push_str(v4i);
                                    e.buf.push_str(" = load i64, ptr ");
                                    e.buf.push_str(g4p);
                                    e.buf.push_str("\n");
                                    return mk_int(v4i);
                                }
                            }
                        }
                    }
                }
            }
        }
        obj = emit_expr(ast, ast.aa[id], e);
        if obj.kind == 1 {
            if ast.texts[id] == "len" {
                return mk_int(obj.b);
            }
            if ast.texts[id] == "data" {
                // String.data -> [char]（元素 i8）
                return mk_arr(obj.a, 2002);
            }
            return mk_int("0");
        }
        if obj.kind == 4 {
            if ast.texts[id] == "_tag" {
                g = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(g);
                e.buf.push_str(" = getelementptr %enum.");
                e.buf.push_str(obj.b);
                e.buf.push_str(", ptr ");
                e.buf.push_str(obj.a);
                e.buf.push_str(", i32 0, i32 0\n");
                vtag = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(vtag);
                e.buf.push_str(" = load i64, ptr ");
                e.buf.push_str(g);
                e.buf.push_str("\n");
                return mk_int(vtag);
            }
            return mk_int("0");
        }
        if obj.kind == 2 {
            idx = e.find_field_idx(obj.b, ast.texts[id]);
            if idx >= 0 {
                si_f = e.find_struct_idx(obj.b);
                sl = e.fslot_at(si_f, idx);
                fk = e.fkind_at(si_f, idx);
                g2 = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(g2);
                e.buf.push_str(" = getelementptr %struct.");
                e.buf.push_str(obj.b);
                e.buf.push_str(", ptr ");
                e.buf.push_str(obj.a);
                e.buf.push_str(", i32 0, i32 ");
                e.buf.push_int(sl);
                e.buf.push_str("\n");
                if fk == 1 {
                    // String 字段：ptr + len 两槽
                    vp = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(vp);
                    e.buf.push_str(" = load ptr, ptr ");
                    e.buf.push_str(g2);
                    e.buf.push_str("\n");
                    g2b = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(g2b);
                    e.buf.push_str(" = getelementptr %struct.");
                    e.buf.push_str(obj.b);
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(obj.a);
                    e.buf.push_str(", i32 0, i32 ");
                    e.buf.push_int(sl + 1);
                    e.buf.push_str("\n");
                    vllen = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(vllen);
                    e.buf.push_str(" = load i64, ptr ");
                    e.buf.push_str(g2b);
                    e.buf.push_str("\n");
                    return mk_str_tmp(vp, vllen);
                }
                if fk == 2 {
                    vp2 = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(vp2);
                    e.buf.push_str(" = load ptr, ptr ");
                    e.buf.push_str(g2);
                    e.buf.push_str("\n");
                    fnm = e.st_names[e.finfo_at(si_f, idx)].copy();
                    return Val { kind = 2, a = vp2, b = fnm, ty = -1 };
                }
                if fk == 3 {
                    vp3 = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(vp3);
                    e.buf.push_str(" = load ptr, ptr ");
                    e.buf.push_str(g2);
                    e.buf.push_str("\n");
                    return mk_arr(vp3, e.finfo_at(si_f, idx));
                }
                if fk == 5 {
                    vd5 = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(vd5);
                    e.buf.push_str(" = load double, ptr ");
                    e.buf.push_str(g2);
                    e.buf.push_str("\n");
                    return mk_float(vd5);
                }
                if fk == 4 {
                    vp4 = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(vp4);
                    e.buf.push_str(" = load ptr, ptr ");
                    e.buf.push_str(g2);
                    e.buf.push_str("\n");
                    enm4 = "";
                    ei4 = e.finfo_at(si_f, idx);
                    if ei4 >= 0 { enm4 = e.en_names[ei4].copy(); }
                    return Val { kind = 4, a = vp4, b = enm4, ty = -1 };
                }
                if fk == 6 {
                    // 接口字段：装载 box 指针
                    vp6 = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(vp6);
                    e.buf.push_str(" = load ptr, ptr ");
                    e.buf.push_str(g2);
                    e.buf.push_str("\n");
                    inm6 = "";
                    fi6 = e.finfo_at(si_f, idx);
                    if fi6 >= 0 { inm6 = e.if_names[fi6].copy(); }
                    return Val { kind = 21, a = vp6, b = inm6, ty = -1 };
                }
                v2 = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(v2);
                e.buf.push_str(" = load i64, ptr ");
                e.buf.push_str(g2);
                e.buf.push_str("\n");
                return mk_int(v2);
            }
        }
        return mk_int("0");
    }
    if tag == et(ET::CallExpr._tag) {
        // (callee)(args)：字段闭包调用（结构体字段为 Fn 类型）
        callee = ast.aa[id];
        cargs = ast.bb[id];
        if callee >= 0 {
            if ast.tags[callee] == et(ET::FieldAccess._tag) {
                obj = emit_expr(ast, ast.aa[callee], e);
                if obj.kind == 2 {
                    si_ce = e.find_struct_idx(obj.b);
                    fi_ce = e.find_field_idx(obj.b, ast.texts[callee]);
                    if si_ce >= 0 && fi_ce >= 0 {
                        fty_ce = e.ftype_at(si_ce, fi_ce);
                        if fty_ce >= 0 {
                            if ast.tags[fty_ce] == tt(TT::Closure._tag) {
                                sl_ce = e.fslot_at(si_ce, fi_ce);
                                g_ce = e.fresh();
                                e.buf.push_str("  ");
                                e.buf.push_str(g_ce);
                                e.buf.push_str(" = getelementptr %struct.");
                                e.buf.push_str(obj.b);
                                e.buf.push_str(", ptr ");
                                e.buf.push_str(obj.a);
                                e.buf.push_str(", i32 0, i32 ");
                                e.buf.push_int(sl_ce);
                                e.buf.push_str("\n  ");
                                fv_ce = e.fresh();
                                e.buf.push_str(fv_ce);
                                e.buf.push_str(" = load i64, ptr ");
                                e.buf.push_str(g_ce);
                                e.buf.push_str("\n");
                                return emit_indirect_call(ast, fv_ce, fty_ce, cargs, e);
                            }
                        }
                    }
                }
            }
        }
        return mk_int("0");
    }
    if tag == et(ET::MethodCall._tag) {
        obj = emit_expr(ast, ast.aa[id], e);
        if obj.kind == 1 {
            mn = ast.texts[id];
            if mn == "len" { return mk_int(obj.b); }
            if mn == "to_string" { return obj; }
            if mn == "is_empty" {
                c = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(c);
                e.buf.push_str(" = icmp eq i64 ");
                e.buf.push_str(obj.b);
                e.buf.push_str(", 0\n");
                z = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(z);
                e.buf.push_str(" = zext i1 ");
                e.buf.push_str(c);
                e.buf.push_str(" to i64\n");
                return mk_int(z);
            }
            // prelude String 方法（std 语义；见 base/prelude.aya）
            if mn == "trim" {
                if e.fn_ret_type("aya_str_trim") >= 0 {
                    return emit_prelude_str("aya_str_trim", obj, obj, 0, 1, e);
                }
            }
            if mn == "to_upper" {
                if e.fn_ret_type("aya_str_to_upper") >= 0 {
                    return emit_prelude_str("aya_str_to_upper", obj, obj, 0, 1, e);
                }
            }
            if mn == "to_lower" {
                if e.fn_ret_type("aya_str_to_lower") >= 0 {
                    return emit_prelude_str("aya_str_to_lower", obj, obj, 0, 1, e);
                }
            }
            if mn == "parse_int" {
                if e.fn_ret_type("aya_str_parse_int") >= 0 {
                    return emit_prelude_str("aya_str_parse_int", obj, obj, 0, 0, e);
                }
            }
            if mn == "is_int" {
                if e.fn_ret_type("aya_str_is_int") >= 0 {
                    return emit_prelude_str("aya_str_is_int", obj, obj, 0, 0, e);
                }
            }
            if mn == "contains" {
                if e.fn_ret_type("aya_str_contains") >= 0 {
                    a_c = emit_expr(ast, ast.aa[ast.bb[id]], e);
                    return emit_prelude_str("aya_str_contains", obj, a_c, 1, 0, e);
                }
            }
            if mn == "index_of" {
                if e.fn_ret_type("aya_str_index_of") >= 0 {
                    a_i = emit_expr(ast, ast.aa[ast.bb[id]], e);
                    return emit_prelude_str("aya_str_index_of", obj, a_i, 1, 0, e);
                }
            }
            if mn == "repeat" {
                if e.fn_ret_type("aya_str_repeat") >= 0 {
                    a_r = emit_expr(ast, ast.aa[ast.bb[id]], e);
                    t_r = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(t_r);
                    e.buf.push_str(" = call { ptr, i64 } @");
                    e.buf.push_str(e.fn_sym("aya_str_repeat"));
                    e.buf.push_str("(ptr ");
                    e.buf.push_str(ptr_operand(obj.a));
                    e.buf.push_str(", i64 ");
                    e.buf.push_str(obj.b);
                    e.buf.push_str(", i64 ");
                    e.buf.push_str(a_r.a);
                    e.buf.push_str(")\n  ");
                    ip_r = e.fresh();
                    e.buf.push_str(ip_r);
                    e.buf.push_str(" = extractvalue { ptr, i64 } ");
                    e.buf.push_str(t_r);
                    e.buf.push_str(", 0\n  ");
                    il_r = e.fresh();
                    e.buf.push_str(il_r);
                    e.buf.push_str(" = extractvalue { ptr, i64 } ");
                    e.buf.push_str(t_r);
                    e.buf.push_str(", 1\n");
                    return mk_str_tmp(ip_r, il_r);
                }
            }
            if mn == "index" {
                iv = emit_expr(ast, ast.aa[ast.bb[id]], e);
                g = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(g);
                e.buf.push_str(" = getelementptr i8, ptr ");
                e.buf.push_str(obj.a);
                e.buf.push_str(", i64 ");
                e.buf.push_str(iv.a);
                e.buf.push_str("\n  ");
                t8 = e.fresh();
                e.buf.push_str(t8);
                e.buf.push_str(" = load i8, ptr ");
                e.buf.push_str(g);
                e.buf.push_str("\n  ");
                z8 = e.fresh();
                e.buf.push_str(z8);
                e.buf.push_str(" = zext i8 ");
                e.buf.push_str(t8);
                e.buf.push_str(" to i64\n");
                return mk_int(z8);
            }
            if mn == "copy" {
                return emit_str_slice(obj, "0", obj.b, e);
            }
            if mn == "substring" {
                a1 = emit_expr(ast, ast.aa[ast.bb[id]], e);
                a2s = emit_expr(ast, ast.aa[ast.nexts[ast.bb[id]]], e);
                return emit_str_slice(obj, a1.a, a2s.a, e);
            }
            if mn == "add" {
                tadd = emit_expr(ast, ast.aa[ast.bb[id]], e);
                return emit_str_concat(obj, tadd, e);
            }
            if mn == "add" {
                tadd = emit_expr(ast, ast.aa[ast.bb[id]], e);
                return emit_str_concat(obj, tadd, e);
            }
            if mn == "eq" {
                tq = emit_expr(ast, ast.aa[ast.bb[id]], e);
                return emit_str_eq(obj, tq, e);
            }
            if mn == "ne" {
                tq2 = emit_expr(ast, ast.aa[ast.bb[id]], e);
                q2 = emit_str_eq(obj, tq2, e);
                return emit_not(q2, e);
            }
            if mn == "starts_with" {
                tp = emit_expr(ast, ast.aa[ast.bb[id]], e);
                ok = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(ok);
                e.buf.push_str(" = icmp sle i64 ");
                e.buf.push_str(tp.b);
                e.buf.push_str(", ");
                e.buf.push_str(obj.b);
                e.buf.push_str("\n  ");
                r2 = e.fresh();
                e.buf.push_str(r2);
                e.buf.push_str(" = call i32 @memcmp(ptr ");
                e.buf.push_str(tp.a);
                e.buf.push_str(", ptr ");
                e.buf.push_str(obj.a);
                e.buf.push_str(", i64 ");
                e.buf.push_str(tp.b);
                e.buf.push_str(")\n  ");
                e2b = e.fresh();
                e.buf.push_str(e2b);
                e.buf.push_str(" = icmp eq i32 ");
                e.buf.push_str(r2);
                e.buf.push_str(", 0\n  ");
                b2b = e.fresh();
                e.buf.push_str(b2b);
                e.buf.push_str(" = and i1 ");
                e.buf.push_str(ok);
                e.buf.push_str(", ");
                e.buf.push_str(e2b);
                e.buf.push_str("\n  ");
                z2b = e.fresh();
                e.buf.push_str(z2b);
                e.buf.push_str(" = zext i1 ");
                e.buf.push_str(b2b);
                e.buf.push_str(" to i64\n");
                return mk_int(z2b);
            }
            if mn == "ends_with" {
                ts = emit_expr(ast, ast.aa[ast.bb[id]], e);
                ok3 = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(ok3);
                e.buf.push_str(" = icmp sle i64 ");
                e.buf.push_str(ts.b);
                e.buf.push_str(", ");
                e.buf.push_str(obj.b);
                e.buf.push_str("\n  ");
                off3 = e.fresh();
                e.buf.push_str(off3);
                e.buf.push_str(" = sub i64 ");
                e.buf.push_str(obj.b);
                e.buf.push_str(", ");
                e.buf.push_str(ts.b);
                e.buf.push_str("\n  ");
                p3 = e.fresh();
                e.buf.push_str(p3);
                e.buf.push_str(" = getelementptr i8, ptr ");
                e.buf.push_str(obj.a);
                e.buf.push_str(", i64 ");
                e.buf.push_str(off3);
                e.buf.push_str("\n  ");
                r3 = e.fresh();
                e.buf.push_str(r3);
                e.buf.push_str(" = call i32 @memcmp(ptr ");
                e.buf.push_str(ts.a);
                e.buf.push_str(", ptr ");
                e.buf.push_str(p3);
                e.buf.push_str(", i64 ");
                e.buf.push_str(ts.b);
                e.buf.push_str(")\n  ");
                e3b = e.fresh();
                e.buf.push_str(e3b);
                e.buf.push_str(" = icmp eq i32 ");
                e.buf.push_str(r3);
                e.buf.push_str(", 0\n  ");
                b3b = e.fresh();
                e.buf.push_str(b3b);
                e.buf.push_str(" = and i1 ");
                e.buf.push_str(ok3);
                e.buf.push_str(", ");
                e.buf.push_str(e3b);
                e.buf.push_str("\n  ");
                z3b = e.fresh();
                e.buf.push_str(z3b);
                e.buf.push_str(" = zext i1 ");
                e.buf.push_str(b3b);
                e.buf.push_str(" to i64\n");
                return mk_int(z3b);
            }
            return mk_int("0");
        }
        if obj.kind == 3 {
            // 数组：get_unchecked / get / index 读元素（与 a[i] 相同）
            mn_a = ast.texts[id];
            if mn_a == "get_unchecked" || mn_a == "get" || mn_a == "index" {
                iv_a = emit_expr(ast, ast.aa[ast.bb[id]], e);
                return emit_index_read(ast, obj, iv_a.a, e);
            }
            return mk_int("0");
        }
        mid = -1;
        recv_ty = obj.b.copy();
        prim_recv = 0;
        if obj.kind == 0 {
            // int.to_string（prelude）
            if ast.texts[id] == "to_string" {
                if e.fn_ret_type("aya_int_to_string") >= 0 {
                    t_is = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(t_is);
                    e.buf.push_str(" = call { ptr, i64 } @");
                    e.buf.push_str(e.fn_sym("aya_int_to_string"));
                    e.buf.push_str("(i64 ");
                    e.buf.push_str(obj.a);
                    e.buf.push_str(")\n  ");
                    ip_is = e.fresh();
                    e.buf.push_str(ip_is);
                    e.buf.push_str(" = extractvalue { ptr, i64 } ");
                    e.buf.push_str(t_is);
                    e.buf.push_str(", 0\n  ");
                    il_is = e.fresh();
                    e.buf.push_str(il_is);
                    e.buf.push_str(" = extractvalue { ptr, i64 } ");
                    e.buf.push_str(t_is);
                    e.buf.push_str(", 1\n");
                    return mk_str_tmp(ip_is, il_is);
                }
            }
            // char 方法（prelude；char 以 i64 传入）
            mn_c = ast.texts[id];
            if e.fn_ret_type("aya_ch_is_digit") >= 0 {
                if mn_c == "is_digit" { return emit_prelude_int1("aya_ch_is_digit", obj.a, e); }
                if mn_c == "is_alpha" { return emit_prelude_int1("aya_ch_is_alpha", obj.a, e); }
                if mn_c == "is_alnum" { return emit_prelude_int1("aya_ch_is_alnum", obj.a, e); }
                if mn_c == "is_upper" { return emit_prelude_int1("aya_ch_is_upper", obj.a, e); }
                if mn_c == "is_lower" { return emit_prelude_int1("aya_ch_is_lower", obj.a, e); }
                if mn_c == "to_digit" { return emit_prelude_int1("aya_ch_to_digit", obj.a, e); }
                if mn_c == "to_upper" { return emit_prelude_int1("aya_ch_to_upper", obj.a, e); }
                if mn_c == "to_lower" { return emit_prelude_int1("aya_ch_to_lower", obj.a, e); }
                if mn_c == "is_space" { return emit_prelude_int1("aya_ch_is_space", obj.a, e); }
            }
            // 原语接收者：按常见整型/浮点类型名依次查找
            prim_recv = 1;
            recv_ty = "";
            ptnames = ["int", "i32", "i64", "u32", "u64", "usize", "i8", "u8", "i16", "u16", "float", "f32", "f64", "char", "bool"];
            pi_t = 0;
            while pi_t < 15 {
                if e.find_method_id(ptnames[pi_t], ast.texts[id]) >= 0 {
                    recv_ty = ptnames[pi_t].copy();
                    break;
                }
                pi_t = pi_t + 1;
            }
            if recv_ty.len == 0 { recv_ty = "int"; }
        }
        if obj.kind == 21 {
            // 接口值：vtable 动态派发（box = {data, vtable}）
            ii_v = e.find_iface_idx(obj.b);
            mi_v = e.iface_method_idx(ii_v, ast.texts[id]);
            if ii_v >= 0 && mi_v >= 0 {
                return emit_iface_dispatch(ast, ast.bb[id], obj, ii_v, mi_v, e);
            }
            // 兜底：按名在 impl 表查找（单实现）
            mid = e.find_method_any(ast.texts[id]);
            recv_ty = e.method_ty_of(mid);
        } elif obj.kind == 2 || obj.kind == 4 || prim_recv == 1 {
            mid = e.find_method_id(recv_ty, ast.texts[id]);
        }
        if mid >= 0 {
            b3 = StringBuf::new();
            b3.push_str("  ");
            t5 = e.fresh();
            mrty = e.method_ret_type(recv_ty, ast.texts[id]);
            rk_m = e.ret_kind(ast, mrty);
            b3.push_str(t5);
            if rk_m == 5 {
                b3.push_str(" = call double @");
            } elif rk_m == 1 {
                b3.push_str(" = call { ptr, i64 } @");
            } else {
                b3.push_str(" = call i64 @");
            }
            mfull_d = recv_ty + ".";
            mfull_d = mfull_d + ast.texts[id];
            b3.push_str(e.fn_sym(mfull_d));
            b3.push_str("(ptr ");
            if prim_recv == 1 {
                // 原语接收者：落到临时槽取地址
                tp3 = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(tp3);
                e.buf.push_str(" = alloca i64\n  store i64 ");
                e.buf.push_str(obj.a);
                e.buf.push_str(", ptr ");
                e.buf.push_str(tp3);
                e.buf.push_str("\n");
                b3.push_str(tp3);
            } else {
                b3.push_str(obj.a);
            }
            a3 = ast.bb[id];
            ak3 = 1;
            while a3 >= 0 {
                at3 = emit_expr(ast, ast.aa[a3], e);
                mfull = recv_ty + ".";
                mfull = mfull + ast.texts[id];
                pk3 = e.fn_param_kind(mfull, ak3);
                if pk3 == 31 {
                    b3.push_str(", double ");
                    b3.push_str(float_operand(at3, e));
                } elif pk3 == 30 {
                    b3.push_str(", ptr ");
                    b3.push_str(addr_of_arg(ast, ast.aa[a3], e));
                } elif pk3 == 0 {
                    b3.push_str(", i64 ");
                    b3.push_str(at3.a);
                } elif pk3 == 1 {
                    b3.push_str(", ptr ");
                    b3.push_str(at3.a);
                    b3.push_str(", i64 ");
                    b3.push_str(at3.b);
                } elif pk3 == 21 {
                    ii_p3 = e.fn_piface_of(mfull, ak3);
                    if ii_p3 > 0 && at3.kind != 21 {
                        in_p3 = e.if_names[ii_p3 - 1].copy();
                        b3.push_str(", ptr ");
                        b3.push_str(e.emit_box(at3, in_p3));
                    } else {
                        b3.push_str(", ptr ");
                        b3.push_str(at3.a);
                    }
                } else {
                    b3.push_str(", ptr ");
                    b3.push_str(at3.a);
                }
                ak3 = ak3 + 1;
                a3 = ast.nexts[a3];
            }
            b3.push_str(")\n");
            e.buf.push_str(b3.to_string());
            if rk_m == 5 {
                return mk_float(t5);
            }
            if rk_m == 1 {
                p6 = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(p6);
                e.buf.push_str(" = extractvalue { ptr, i64 } ");
                e.buf.push_str(t5);
                e.buf.push_str(", 0\n  ");
                l6 = e.fresh();
                e.buf.push_str(l6);
                e.buf.push_str(" = extractvalue { ptr, i64 } ");
                e.buf.push_str(t5);
                e.buf.push_str(", 1\n");
                return mk_str_tmp(p6, l6);
            }
            if rk_m == 2 {
                rinfo3 = e.ret_info(ast, mrty);
                rnm3 = "";
                if rinfo3 >= 0 { rnm3 = e.st_names[rinfo3].copy(); }
                pi5 = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(pi5);
                e.buf.push_str(" = inttoptr i64 ");
                e.buf.push_str(t5);
                e.buf.push_str(" to ptr\n");
                return Val { kind = 2, a = pi5, b = rnm3, ty = -1 };
            }
            if rk_m == 4 {
                rinfo4 = e.ret_info(ast, mrty);
                rnm4 = "";
                if rinfo4 >= 0 { rnm4 = e.en_names[rinfo4].copy(); }
                pi6 = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(pi6);
                e.buf.push_str(" = inttoptr i64 ");
                e.buf.push_str(t5);
                e.buf.push_str(" to ptr\n");
                return Val { kind = 4, a = pi6, b = rnm4, ty = -1 };
            }
            if rk_m == 6 {
