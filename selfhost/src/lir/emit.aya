            a3 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(a3);
            e.buf.push_str(" = icmp eq i64 ");
            e.buf.push_str(at.a);
            e.buf.push_str(", 0\n");
            z3 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(z3);
            e.buf.push_str(" = zext i1 ");
            e.buf.push_str(a3);
            e.buf.push_str(" to i64\n");
            return mk_int(z3);
        }
        return at;
    }
    if tag == et(ET::FnCall._tag) {
        nm = ast.texts[id];
