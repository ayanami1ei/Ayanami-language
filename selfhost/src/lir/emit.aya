            e.buf.push_str(nm);
            e.buf.push_str(".ptr\n");
            l = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(l);
            e.buf.push_str(" = load i64, ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str(".len\n");
