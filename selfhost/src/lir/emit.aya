            e.buf.push_str(", ");
            e.buf.push_str(b2);
            e.buf.push_str("\n");
            z2 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(z2);
            e.buf.push_str(" = zext i1 ");
            e.buf.push_str(c2);
            e.buf.push_str(" to i64\n");
            return mk_int(z2);
        }
        t2 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(t2);
        e.buf.push_str(" = ");
        e.buf.push_str(bin_llvm_op(op));
        e.buf.push_str(" i64 ");
        e.buf.push_str(lt.a);
        e.buf.push_str(", ");
        e.buf.push_str(rt.a);
        e.buf.push_str("\n");
