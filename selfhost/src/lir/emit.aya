                e.buf.push_str("  ");
                e.buf.push_str(pi7);
                e.buf.push_str(" = inttoptr i64 ");
                e.buf.push_str(t5);
                e.buf.push_str(" to ptr\n");
                return mk_arr(pi7, e.ret_info(ast, mrty));
            }
            return mk_int(t5);
        }
        // UFCS 回退：同名自由函数、接收者作首参（如 f.replace_int(i, v)）
        fi_u = find_fn_by_recv(e, ast, ast.texts[id], recv_ty);
        if fi_u >= 0 {
            return emit_ufcs_call(ast, id, obj, ast.texts[id], e);
        }
        return mk_int("0");
    }
    if tag == et(ET::MacroCall._tag) {
        mname_m = ast.texts[id];
        if mname_m == "panic" {
            // #panic(msg)：调用运行时 panic（退出 101）
            a_m = ast.aa[id];
            msg_m = mk_str("null", 0);
            if a_m >= 0 { msg_m = emit_expr(ast, ast.aa[a_m], e); }
            fi_p = e.add_str(e.src_file);
            e.buf.push_str("  call void @__ayanami_panic_at(i64 ");
            e.buf.push_str(int_str2(ast.lines[id]));
            e.buf.push_str(", i64 ");
            e.buf.push_str(int_str2(ast.cols[id]));
            e.buf.push_str(", ptr @.str.");
            e.buf.push_int(fi_p);
            e.buf.push_str(", i64 ");
            e.buf.push_int(e.src_file.len as int);
            e.buf.push_str(", ptr ");
            e.buf.push_str(ptr_operand(msg_m.a));
            e.buf.push_str(", i64 ");
            e.buf.push_str(msg_m.b);
            e.buf.push_str(")\n");
            return mk_int("0");
        }
        return mk_int("0");
    }
    if tag == et(ET::Lambda._tag) {
        return emit_lambda_value(ast, id, e);
    }
    if tag == et(ET::Match._tag) {
        return emit_match(ast, id, e, 1);
    }
    if tag == et(ET::If._tag) {
        return emit_if_expr(ast, id, e);
    }
    if tag == et(ET::Cast._tag) {
        v = emit_expr(ast, ast.aa[id], e);
        tty = ast.tys[id];
        if tty < 0 { return v; }
        if v.kind == 6 {
            // 浮点源：目标为浮点则透传；目标为整数则饱和转换（rust as 语义）
            tv6 = ty_name(ast, tty);
            ttag6 = ast.tags[tty];
            is_float_dst = 0;
            if ttag6 == tt(TT::Float._tag) { is_float_dst = 1; }
            if tv6 == "f32" || tv6 == "f64" || tv6 == "float" { is_float_dst = 1; }
            if is_float_dst == 1 { return v; }
            itn6 = tv6;
            if itn6.len == 0 {
                if ttag6 == tt(TT::Char._tag) { itn6 = "char"; }
                elif ttag6 == tt(TT::Bool._tag) { itn6 = "bool"; }
            }
            // 饱和：按目标宽度夹取
            lo6 = fmin_text(itn6);
            hi6 = fmax_text(itn6);
            xd = v.a;
            if lo6.len > 0 {
                cl = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(cl);
                e.buf.push_str(" = fcmp olt double ");
                e.buf.push_str(xd);
                e.buf.push_str(", ");
                e.buf.push_str(lo6);
                e.buf.push_str("\n  ");
                sd = e.fresh();
                e.buf.push_str(sd);
                e.buf.push_str(" = select i1 ");
                e.buf.push_str(cl);
                e.buf.push_str(", double ");
                e.buf.push_str(lo6);
                e.buf.push_str(", double ");
                e.buf.push_str(xd);
                e.buf.push_str("\n");
                xd = sd;
            }
            if hi6.len > 0 {
                ch = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(ch);
                e.buf.push_str(" = fcmp ogt double ");
                e.buf.push_str(xd);
                e.buf.push_str(", ");
                e.buf.push_str(hi6);
                e.buf.push_str("\n  ");
                sh = e.fresh();
                e.buf.push_str(sh);
                e.buf.push_str(" = select i1 ");
                e.buf.push_str(ch);
                e.buf.push_str(", double ");
                e.buf.push_str(hi6);
                e.buf.push_str(", double ");
                e.buf.push_str(xd);
                e.buf.push_str("\n");
                xd = sh;
            }
            fi6 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(fi6);
            e.buf.push_str(" = fptosi double ");
            e.buf.push_str(xd);
            e.buf.push_str(" to i64\n");
            v = mk_int(fi6);
            if itn6 == "char" {
                t8c6 = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(t8c6);
                e.buf.push_str(" = trunc i64 ");
                e.buf.push_str(v.a);
                e.buf.push_str(" to i8\n  ");
                z8c6 = e.fresh();
                e.buf.push_str(z8c6);
                e.buf.push_str(" = zext i8 ");
                e.buf.push_str(t8c6);
                e.buf.push_str(" to i64\n");
                return mk_int(z8c6);
            }
            lty6 = int_ty_llvm(itn6);
            if lty6.len == 0 || lty6 == "i64" { return v; }
            t1c6 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t1c6);
            e.buf.push_str(" = trunc i64 ");
            e.buf.push_str(v.a);
            e.buf.push_str(" to ");
            e.buf.push_str(lty6);
            e.buf.push_str("\n  ");
            t2c6 = e.fresh();
            e.buf.push_str(t2c6);
            if int_ty_signed(itn6) == 1 {
                e.buf.push_str(" = sext ");
            } else {
                e.buf.push_str(" = zext ");
            }
            e.buf.push_str(lty6);
            e.buf.push_str(" ");
            e.buf.push_str(t1c6);
            e.buf.push_str(" to i64\n");
            return mk_int(t2c6);
        }
        tn = ty_name(ast, tty);
        if tn.len == 0 {
            tg = ast.tags[tty];
            if tg == tt(TT::Char._tag) { tn = "char"; }
            elif tg == tt(TT::Bool._tag) { tn = "bool"; }
            elif tg == tt(TT::Float._tag) { return v; }
            elif tg == tt(TT::Int._tag) { return v; }
            else { return v; }
        }
        if tn == "char" {
            // int -> char：低 8 位
            t8c = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t8c);
            e.buf.push_str(" = trunc i64 ");
            e.buf.push_str(v.a);
            e.buf.push_str(" to i8\n  ");
            z8c = e.fresh();
            e.buf.push_str(z8c);
            e.buf.push_str(" = zext i8 ");
            e.buf.push_str(t8c);
            e.buf.push_str(" to i64\n");
            return mk_int(z8c);
        }
        lty_c = int_ty_llvm(tn);
        if lty_c.len == 0 || lty_c == "i64" { return v; }
        t1c = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(t1c);
        e.buf.push_str(" = trunc i64 ");
        e.buf.push_str(v.a);
        e.buf.push_str(" to ");
        e.buf.push_str(lty_c);
        e.buf.push_str("\n  ");
        t2c = e.fresh();
        e.buf.push_str(t2c);
        if int_ty_signed(tn) == 1 {
            e.buf.push_str(" = sext ");
        } else {
            e.buf.push_str(" = zext ");
        }
        e.buf.push_str(lty_c);
        e.buf.push_str(" ");
        e.buf.push_str(t1c);
        e.buf.push_str(" to i64\n");
        return mk_int(t2c);
    }
    if tag == et(ET::ArraySized._tag) {
        // [T; n]：元素类型来自 tys，n 是表达式
        cnt = emit_expr(ast, ast.aa[id], e);
        return emit_array_new(ast, id, ast.tys[id], cnt.a, e);
    }
    if tag == et(ET::ArrayLiteral._tag) {
        // [a, b, c]：元素类型由首元素推导，逐个 store（首元素只求值一次）
        head = ast.aa[id];
        cnt2 = 0;
        t2 = head;
        while t2 >= 0 { cnt2 = cnt2 + 1; t2 = ast.nexts[t2]; }
        bcnt = StringBuf::new();
        bcnt.push_int(cnt2);
        ety = e.elem_type_of_m(ast, head);
        cnt_s = bcnt.to_string();
        av = emit_array_new(ast, id, ety, cnt_s, e);
        lty = e.elem_llvm_m(ast, ety);
        two_char = 0;
        if elem_is_string(ast, ety) { two_char = 1; }
        el = ast.aa[id];
        k = 0;
        while el >= 0 {
            ev = emit_expr(ast, el, e);
            kb = StringBuf::new();
            kb.push_int(k);
            g = elem_addr(e, elem_stride(ast, ety), av.a, kb.to_string());
            store_elem(e, lty, two_char, g, ev);
            k = k + 1;
            el = ast.nexts[el];
        }
        return av;
    }
    if tag == et(ET::ArrayRepeat._tag) {
        // [expr; n]：值求值一次，循环填充到 n 个槽
        cnt3 = emit_expr(ast, ast.bb[id], e);
        ety3 = e.elem_type_of_m(ast, ast.aa[id]);
        ev3 = emit_expr(ast, ast.aa[id], e);
        av3 = emit_array_new(ast, id, ety3, cnt3.a, e);
        lty3 = e.elem_llvm_m(ast, ety3);
        fill = ev3.a;
        if lty3 == "double" && ev3.kind != 6 {
            fd3 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(fd3);
            e.buf.push_str(" = sitofp i64 ");
            e.buf.push_str(ev3.a);
            e.buf.push_str(" to double\n");
            fill = fd3;
        } elif elem_is_leaf(lty3) {
            t3b = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t3b);
            e.buf.push_str(" = trunc i64 ");
            e.buf.push_str(ev3.a);
            e.buf.push_str(" to ");
            e.buf.push_str(lty3);
            e.buf.push_str("\n  ");
            z3 = e.fresh();
            e.buf.push_str(z3);
            e.buf.push_str(" = zext ");
            e.buf.push_str(lty3);
            e.buf.push_str(" ");
            e.buf.push_str(t3b);
            e.buf.push_str(" to i64\n");
            fill = z3;
        }
        emit_array_fill(e, lty3, elem_stride(ast, ety3), av3.a, cnt3.a, fill);
        return av3;
    }
    if tag == et(ET::Index._tag) {
        // xs[i]：取值（按元素类型装载）
        base3 = emit_expr(ast, ast.aa[id], e);
        iv3 = emit_expr(ast, ast.bb[id], e);
        return emit_index_read(ast, base3, iv3.a, e);
    }
    if tag == et(ET::Ref._tag) {
        // &x / ref x：返回地址（仅用于数组/结构体实参场景）
        if ast.tags[ast.aa[id]] == et(ET::Ident._tag) {
            nm7 = ast.texts[ast.aa[id]];
            gk7 = e.global_kind(nm7);
            if gk7 == 2 {
                return mk_arr("@" + nm7, -1);
            }
            if gk7 == 0 {
                t7g = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(t7g);
                e.buf.push_str(" = load i64, ptr @");
                e.buf.push_str(nm7);
                e.buf.push_str("\n");
                return mk_int(t7g);
            }
            if gk7 == 4 {
                t7g4 = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(t7g4);
                e.buf.push_str(" = load i64, ptr @");
                e.buf.push_str(nm7);
                e.buf.push_str("\n  ");
                p7g4 = e.fresh();
                e.buf.push_str(p7g4);
                e.buf.push_str(" = inttoptr i64 ");
                e.buf.push_str(t7g4);
                e.buf.push_str(" to ptr\n");
                gi7 = e.global_idx(nm7);
                sn7 = "";
                if gi7 >= 0 {
                    sti7 = e.g_stype[gi7];
                    if sti7 >= 0 && sti7 < e.st_count { sn7 = e.st_names[sti7].copy(); }
                }
                return Val { kind = 2, a = p7g4, b = sn7, ty = -1 };
            }
            kd7 = e.local_kind(nm7);
            if kd7 == 3 || kd7 == 10 {
                t7a = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(t7a);
                e.buf.push_str(" = load ptr, ptr %v_");
                e.buf.push_str(nm7);
                e.buf.push_str(".p\n");
                return mk_arr(t7a, e.elem_of_local(nm7));
            }
            if kd7 == 20 {
                t7b = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(t7b);
                e.buf.push_str(" = load ptr, ptr %v_");
                e.buf.push_str(nm7);
                e.buf.push_str(".p\n");
                ei7 = e.etype_of_local(nm7);
                en7 = "";
                if ei7 >= 0 { en7 = e.en_names[ei7].copy(); }
                return Val { kind = 4, a = t7b, b = en7, ty = -1 };
            }
            if kd7 >= 100 && kd7 < 228 {
                t7c = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(t7c);
                e.buf.push_str(" = load ptr, ptr %v_");
                e.buf.push_str(nm7);
                e.buf.push_str(".p\n");
                return Val { kind = 2, a = t7c, b = e.struct_of_local(nm7), ty = -1 };
            }
            ad7 = addr_of_arg(ast, ast.aa[id], e);
            return mk_int(ad7);
        }
        return emit_expr(ast, ast.aa[id], e);
    }
    return mk_int("0");
}

/// 发射块：语句链 + 块尾表达式（尾按语句处理；用于 if/while/for/unsafe 体）
#[alloc]
#[state]
fn emit_block_all(ref Ast ast, int blk, ref mut Emitter e) {
    if blk < 0 { return; }
    emit_stmts(ast, ast.aa[blk], e);
    if e.terminated == 0 {
        tail_b = ast.bb[blk];
        if tail_b >= 0 {
            emit_expr(ast, tail_b, e);
        }
    }
}

fn emit_stmts(ref Ast ast, int stmts, ref mut Emitter e) {
    s = stmts;
    while s >= 0 {
        if e.terminated == 1 { break; }
        emit_stmt(ast, s, e);
        s = ast.nexts[s];
    }
}

/// 元素是否为<8 字节标量（需要 trunc / sext 转换）
fn elem_is_leaf(ref String lty) -> bool {
    if lty == "i8" { return true; }
    if lty == "i32" { return true; }
    return false;
}

/// 循环填充：`[T; n]`（val 为 "0"）/ `[expr; n]`（val 为元素值）的元素写入
/// 用 alloca 计数器（不依赖 %entry 块，可在任意位置展开）
fn emit_array_fill(ref mut Emitter e, ref String lty, int stride, ref String base, ref String cnt, ref String val) {
    n = e.tmp;
    e.tmp = e.tmp + 1;
    e.buf.push_str("  %fi.");
    e.buf.push_int(n);
    e.buf.push_str(" = alloca i64\n  store i64 0, ptr %fi.");
    e.buf.push_int(n);
    e.buf.push_str("\n  br label %fill.cond.");
    e.buf.push_int(n);
    e.buf.push_str("\nfill.cond.");
    e.buf.push_int(n);
    e.buf.push_str(":\n  %fv.");
    e.buf.push_int(n);
    e.buf.push_str(" = load i64, ptr %fi.");
    e.buf.push_int(n);
    e.buf.push_str("\n  %fc.");
    e.buf.push_int(n);
    e.buf.push_str(" = icmp slt i64 %fv.");
    e.buf.push_int(n);
    e.buf.push_str(", ");
    e.buf.push_str(cnt);
    e.buf.push_str("\n  br i1 %fc.");
    e.buf.push_int(n);
    e.buf.push_str(", label %fill.body.");
    e.buf.push_int(n);
    e.buf.push_str(", label %fill.end.");
    e.buf.push_int(n);
    e.buf.push_str("\nfill.body.");
    e.buf.push_int(n);
    e.buf.push_str(":\n");
    g = elem_addr(e, stride, base, "%fv.".to_string() + int_str2(n));
    e.buf.push_str("  store ");
    e.buf.push_str(lty);
    e.buf.push_str(" ");
    e.buf.push_str(val);
    e.buf.push_str(", ptr ");
    e.buf.push_str(g);
    e.buf.push_str("\n  %fn.");
    e.buf.push_int(n);
    e.buf.push_str(" = add i64 %fv.");
    e.buf.push_int(n);
    e.buf.push_str(", 1\n  store i64 %fn.");
    e.buf.push_int(n);
    e.buf.push_str(", ptr %fi.");
    e.buf.push_int(n);
    e.buf.push_str("\n  br label %fill.cond.");
    e.buf.push_int(n);
    e.buf.push_str("\nfill.end.");
    e.buf.push_int(n);
    e.buf.push_str(":\n");
}

/// 数组元素写入：lty 元素 LLVM 类型，two_char 时按 { ptr, i64 } 双字写
/// i64 槽写入：结构体/枚举/数组值先 ptrtoint
#[alloc]
fn store_slot_i64(ref mut Emitter e, ref String gep, ref Val v) {
    if v.kind == 6 {
        // 浮点值：按位存入 i64 槽
        b6 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(b6);
        e.buf.push_str(" = bitcast double ");
        e.buf.push_str(v.a);
        e.buf.push_str(" to i64\n  store i64 ");
        e.buf.push_str(b6);
        e.buf.push_str(", ptr ");
        e.buf.push_str(gep);
        e.buf.push_str("\n");
        return;
    }
    if v.kind == 2 || v.kind == 3 || v.kind == 4 {
        pi = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(pi);
        e.buf.push_str(" = ptrtoint ptr ");
        e.buf.push_str(v.a);
        e.buf.push_str(" to i64\n  store i64 ");
        e.buf.push_str(pi);
        e.buf.push_str(", ptr ");
        e.buf.push_str(gep);
        e.buf.push_str("\n");
        return;
    }
    e.buf.push_str("  store i64 ");
    e.buf.push_str(v.a);
    e.buf.push_str(", ptr ");
    e.buf.push_str(gep);
    e.buf.push_str("\n");
}

fn store_elem(ref mut Emitter e, ref String lty, int two_char, ref String gep, ref Val v) {
    if lty == "i64" {
        store_slot_i64(e, gep, v);
        return;
    }
    if lty == "ptr" {
        e.buf.push_str("  store ptr ");
        e.buf.push_str(v.a);
        e.buf.push_str(", ptr ");
        e.buf.push_str(gep);
        e.buf.push_str("\n");
        if two_char == 1 {
            g2 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(g2);
            e.buf.push_str(" = getelementptr i8, ptr ");
            e.buf.push_str(gep);
            e.buf.push_str(", i64 8\n  store i64 ");
            e.buf.push_str(v.b);
            e.buf.push_str(", ptr ");
            e.buf.push_str(g2);
            e.buf.push_str("\n");
        }
        return;
    }
    if lty == "double" {
        // 浮点元素：整数/字面量 sitofp
        fve = float_operand(v, e);
        e.buf.push_str("  store double ");
        e.buf.push_str(fve);
        e.buf.push_str(", ptr ");
        e.buf.push_str(gep);
        e.buf.push_str("\n");
        return;
    }
    // i8/i32：截断后写入，读回时按同样宽度
    e.buf.push_str("  ");
    w = e.fresh();
    e.buf.push_str(w);
    e.buf.push_str(" = trunc i64 ");
    e.buf.push_str(v.a);
    e.buf.push_str(" to ");
    e.buf.push_str(lty);
    e.buf.push_str("\n  store ");
    e.buf.push_str(lty);
    e.buf.push_str(" ");
    e.buf.push_str(w);
    e.buf.push_str(", ptr ");
    e.buf.push_str(gep);
    e.buf.push_str("\n");
}

/// `xs[i] = v`（ST::IndexAssign）：aa=基址表达式，bb=下标，cc=值
/// 基址是数组局部变量时按元素类型直接写入 malloc 缓冲区
fn emit_index_assign(ref Ast ast, int id, ref mut Emitter e) {
    base_id = ast.aa[id];
    bp = "";
    ety = -1;
    if ast.tags[base_id] == et(ET::Ident._tag) {
        nm = ast.texts[base_id];
        ety_l = e.elem_of_local(nm);
        if ety_l >= 0 {
            t = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t);
            e.buf.push_str(" = load ptr, ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str(".p");
            e.buf.push_str("\n");
            bp = t;
            ety = ety_l;
        }
    }
    if ety < 0 {
        bv = emit_expr(ast, base_id, e);
        if bv.kind != 3 { return; }
        bp = bv.a;
        ety = bv.ty;
    }
    lty = e.elem_llvm_m(ast, ety);
    two_char = 0;
    if elem_is_string(ast, ety) { two_char = 1; }
    iv = emit_expr(ast, ast.bb[id], e);
    g = elem_addr(e, elem_stride(ast, ety), bp, iv.a);
    v = emit_expr(ast, ast.cc[id], e);
    store_elem(e, lty, two_char, g, v);
}

/// 数组字面量 / [expr; n] / [T; n]：malloc 缓冲区，返回 ptr 值
fn emit_array_new(ref Ast ast, int id, int ety, ref String count, ref mut Emitter e) -> Val {
    lty = e.elem_llvm_m(ast, ety);
    sz = elem_bytes(ast, ety);
    c = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(c);
    e.buf.push_str(" = mul i64 ");
    e.buf.push_str(count);
    e.buf.push_str(", ");
    e.buf.push_int(sz);
    e.buf.push_str("\n");
    big = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(big);
    e.buf.push_str(" = icmp slt i64 ");
    e.buf.push_str(c);
    e.buf.push_str(", 1\n  ");
    z = e.fresh();
    e.buf.push_str(z);
    e.buf.push_str(" = select i1 ");
    e.buf.push_str(big);
    e.buf.push_str(", i64 1, i64 ");
    e.buf.push_str(c);
    e.buf.push_str("\n");
    raw = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(raw);
    e.buf.push_str(" = call ptr @malloc(i64 ");
    e.buf.push_str(z);
    e.buf.push_str(")\n");
    e.buf.push_str("  call void @llvm.memset.p0.i64(ptr ");
    e.buf.push_str(raw);
    e.buf.push_str(", i8 0, i64 ");
    e.buf.push_str(z);
    e.buf.push_str(", i1 false)\n");
    // 结构体/枚举元素：逐元素分配（默认零值对象）
    etn = ty_name(ast, ety);
    if etn.len > 0 {
        si_e = e.find_struct_idx(etn);
        ei_e = -1;
        if si_e < 0 { ei_e = e.find_enum_idx(etn); }
        if si_e >= 0 || ei_e >= 0 {
            nbytes = 8;
            if si_e >= 0 { nbytes = e.st_slots[si_e] * 8; }
            else { nbytes = (e.enum_max_arity(ei_e) + 1) * 8; }
            nb3 = StringBuf::new();
            nb3.push_int(nbytes);
            n_e = e.tmp;
            e.tmp = e.tmp + 1;
            e.buf.push_str("  %ei.");
            e.buf.push_int(n_e);
            e.buf.push_str(" = alloca i64\n  store i64 0, ptr %ei.");
            e.buf.push_int(n_e);
            e.buf.push_str("\n  br label %ec.");
            e.buf.push_int(n_e);
            e.buf.push_str("\nec.");
            e.buf.push_int(n_e);
            e.buf.push_str(":\n  %ev.");
            e.buf.push_int(n_e);
            e.buf.push_str(" = load i64, ptr %ei.");
            e.buf.push_int(n_e);
            e.buf.push_str("\n  %ecmp.");
            e.buf.push_int(n_e);
            e.buf.push_str(" = icmp slt i64 %ev.");
            e.buf.push_int(n_e);
            e.buf.push_str(", ");
            e.buf.push_str(count);
            e.buf.push_str("\n  br i1 %ecmp.");
            e.buf.push_int(n_e);
            e.buf.push_str(", label %eb.");
            e.buf.push_int(n_e);
            e.buf.push_str(", label %ee.");
            e.buf.push_int(n_e);
            e.buf.push_str("\neb.");
            e.buf.push_int(n_e);
            e.buf.push_str(":\n  %ep.");
            e.buf.push_int(n_e);
            e.buf.push_str(" = call ptr @malloc(i64 ");
            e.buf.push_str(nb3.to_string());
            e.buf.push_str(")\n  call void @llvm.memset.p0.i64(ptr %ep.");
            e.buf.push_int(n_e);
            e.buf.push_str(", i8 0, i64 ");
            e.buf.push_str(nb3.to_string());
            e.buf.push_str(", i1 false)\n");
            g_e = elem_addr(e, elem_stride(ast, ety), raw, "%ev.".to_string() + int_str2(n_e));
            e.buf.push_str("  store ptr %ep.");
            e.buf.push_int(n_e);
            e.buf.push_str(", ptr ");
            e.buf.push_str(g_e);
            e.buf.push_str("\n  %en.");
            e.buf.push_int(n_e);
            e.buf.push_str(" = add i64 %ev.");
            e.buf.push_int(n_e);
            e.buf.push_str(", 1\n  store i64 %en.");
            e.buf.push_int(n_e);
            e.buf.push_str(", ptr %ei.");
            e.buf.push_int(n_e);
            e.buf.push_str("\n  br label %ec.");
            e.buf.push_int(n_e);
            e.buf.push_str("\nee.");
            e.buf.push_int(n_e);
            e.buf.push_str(":\n");
        }
    }
    return mk_arr(raw, ety);
}

fn emit_stmt(ref Ast ast, int id, ref mut Emitter e) {
    tag = ast.tags[id];
    if tag == st(ST::Attributed._tag) {
        // 语句级属性：#[cfg(target="windows")] 在 linux 上跳过，其余解包执行
        // （#[invariant(...)] 等检查未发射——不变量成立时行为等价）
        mask_a = ast.cc[id];
        if (mask_a / 32768) % 2 == 1 { return; }
        emit_stmt(ast, ast.aa[id], e);
        return;
    }
    if tag == st(ST::IndexAssign._tag) {
        emit_index_assign(ast, id, e);
    } elif tag == st(ST::Assign._tag) {
        rhs_id = ast.aa[id];
        nm = ast.texts[id];
        if e.global_kind(nm) == 0 {
            v = emit_expr(ast, rhs_id, e);
            e.buf.push_str("  store i64 ");
            e.buf.push_str(v.a);
            e.buf.push_str(", ptr @");
            e.buf.push_str(nm);
            e.buf.push_str("\n");
            return;
        }
        if ast.tags[rhs_id] == et(ET::Ref._tag) {
            // r = ref mut X：局部存引用（kind 30）
            ad = addr_of_arg(ast, ast.aa[rhs_id], e);
            e.declare_local(nm, 30);
            // 记录被引用目标类型（结构体 5000+si / 枚举 6000+ei），供解引用/方法派发
            inner_id = ast.aa[rhs_id];
            if inner_id >= 0 {
                if ast.tags[inner_id] == et(ET::Ident._tag) {
                    pnm = ast.texts[inner_id];
                    pkd = e.local_kind(pnm);
                    if pkd >= 100 && pkd < 228 {
                        e.record_etype(nm, 5000 + (pkd - 100));
                    } elif pkd == 20 {
                        pei = e.etype_of_local(pnm);
                        if pei >= 0 { e.record_etype(nm, 6000 + pei); }
                    }
                }
            }
            e.buf.push_str("  store ptr ");
            e.buf.push_str(ad);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str(".p");
            e.buf.push_str("\n");
            return;
        }
        if e.local_kind(nm) == 30 {
            v = emit_expr(ast, rhs_id, e);
            rp2 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(rp2);
            e.buf.push_str(" = load ptr, ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str(".p");
            e.buf.push_str("\n  store i64 ");
            e.buf.push_str(v.a);
            e.buf.push_str(", ptr ");
            e.buf.push_str(rp2);
            e.buf.push_str("\n");
            return;
        }
        v = emit_expr(ast, rhs_id, e);
        if v.kind == 3 {
            e.declare_array_local(nm, v.ty);
            e.buf.push_str("  store ptr ");
            e.buf.push_str(v.a);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str(".p");
            e.buf.push_str("\n");
            return;
        }
        if v.kind == 6 {
            e.declare_local(nm, 40);
            e.buf.push_str("  store double ");
            e.buf.push_str(v.a);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str(".d");
            e.buf.push_str("\n");
            return;
        }
        if v.kind == 4 {
            ei4 = e.find_enum_idx(v.b);
            e.declare_local(nm, 20);
            e.record_etype(nm, ei4);
            e.buf.push_str("  store ptr ");
            e.buf.push_str(v.a);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str(".p");
            e.buf.push_str("\n");
            return;
        }
        if v.kind == 2 {
            si2 = e.find_struct_idx(v.b);
            e.declare_local(nm, 100 + si2);
            e.record_etype(nm, si2);
            e.buf.push_str("  store ptr ");
            e.buf.push_str(v.a);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str(".p");
            e.buf.push_str("\n");
            return;
        }
        if v.kind == 1 {
            e.declare_local(nm, 1);
            e.buf.push_str("  store ptr ");
            e.buf.push_str(v.a);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str(".ptr\n  store i64 ");
            e.buf.push_str(v.b);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str(".len\n");
        } else {
            e.declare_local(nm, 0);
            e.buf.push_str("  store i64 ");
            e.buf.push_str(v.a);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str("\n");
        }
        e.record_assign_ftype(ast, nm, rhs_id);
    } elif tag == st(ST::Return._tag) {
        rk_ret = e.ret_kind(ast, e.cur_rtype);
        if ast.aa[id] >= 0 {
            v2 = emit_expr(ast, ast.aa[id], e);
            if rk_ret == 5 {
                if v2.kind == 6 {
                    e.buf.push_str("  ret double ");
                    e.buf.push_str(v2.a);
                    e.buf.push_str("\n");
                } else {
                    fr5 = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(fr5);
                    e.buf.push_str(" = sitofp i64 ");
                    e.buf.push_str(v2.a);
                    e.buf.push_str(" to double\n  ret double ");
                    e.buf.push_str(fr5);
                    e.buf.push_str("\n");
                }
            } elif rk_ret == 1 {
                // llc 22 不接受聚合字面量里的函数局部名，用 insertvalue
                if v2.kind == 1 {
                    r0 = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(r0);
                    e.buf.push_str(" = insertvalue { ptr, i64 } undef, ptr ");
                    e.buf.push_str(v2.a);
                    e.buf.push_str(", 0\n  ");
                    r1 = e.fresh();
                    e.buf.push_str(r1);
                    e.buf.push_str(" = insertvalue { ptr, i64 } ");
                    e.buf.push_str(r0);
                    e.buf.push_str(", i64 ");
                    e.buf.push_str(v2.b);
                    e.buf.push_str(", 1\n  ret { ptr, i64 } ");
                    e.buf.push_str(r1);
                    e.buf.push_str("\n");
                } else {
                    r2 = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(r2);
                    e.buf.push_str(" = insertvalue { ptr, i64 } undef, ptr null, 0\n  ");
                    r3 = e.fresh();
                    e.buf.push_str(r3);
                    e.buf.push_str(" = insertvalue { ptr, i64 } ");
                    e.buf.push_str(r2);
                    e.buf.push_str(", i64 ");
                    e.buf.push_str(v2.a);
                    e.buf.push_str(", 1\n  ret { ptr, i64 } ");
                    e.buf.push_str(r3);
                    e.buf.push_str("\n");
                }
            } elif rk_ret == 6 {
                // 接口返回：具体值先装箱
                ri_r = e.ret_info(ast, e.cur_rtype);
                in_r = "";
                if ri_r >= 0 { in_r = e.if_names[ri_r].copy(); }
                bx_r = v2.a.copy();
                if v2.kind != 21 {
                    bx_r = e.emit_box(v2, in_r);
                }
                pi_r = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(pi_r);
                e.buf.push_str(" = ptrtoint ptr ");
                e.buf.push_str(bx_r);
                e.buf.push_str(" to i64\n  ret i64 ");
                e.buf.push_str(pi_r);
                e.buf.push_str("\n");
            } elif v2.kind == 2 || v2.kind == 3 || v2.kind == 4 {
                pi = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(pi);
                e.buf.push_str(" = ptrtoint ptr ");
                e.buf.push_str(v2.a);
                e.buf.push_str(" to i64\n  ret i64 ");
                e.buf.push_str(pi);
                e.buf.push_str("\n");
            } else {
                e.buf.push_str("  ret i64 ");
                e.buf.push_str(v2.a);
                e.buf.push_str("\n");
            }
        } else {
            if rk_ret == 1 {
                e.buf.push_str("  ret { ptr, i64 } { ptr null, i64 0 }\n");
            } else {
                e.buf.push_str("  ret i64 0\n");
            }
        }
    } elif tag == st(ST::Unsafe._tag) {
        emit_block_all(ast, ast.aa[id], e);
    } elif tag == st(ST::Break._tag) {
        if e.loop_depth > 0 {
            e.buf.push_str("  br label %");
            e.buf.push_str(e.loop_ends[e.loop_depth - 1]);
            e.buf.push_str("\n");
            e.terminated = 1;
        }
    } elif tag == st(ST::Continue._tag) {
        if e.loop_depth > 0 {
            e.buf.push_str("  br label %");
            e.buf.push_str(e.loop_conds[e.loop_depth - 1]);
            e.buf.push_str("\n");
            e.terminated = 1;
        }
    } elif tag == st(ST::ExprStmt._tag) {
        emit_expr(ast, ast.aa[id], e);
    } elif tag == st(ST::Match._tag) {
        emit_match(ast, id, e, 0);
    } elif tag == st(ST::FieldAssign._tag) {
        obj = emit_expr(ast, ast.aa[id], e);
        if obj.kind == 2 {
            idx = e.find_field_idx(obj.b, ast.texts[id]);
            if idx >= 0 {
                v = emit_expr(ast, ast.bb[id], e);
                si_a = e.find_struct_idx(obj.b);
                sl_a = e.fslot_at(si_a, idx);
                fk_a = e.fkind_at(si_a, idx);
                g = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(g);
                e.buf.push_str(" = getelementptr %struct.");
                e.buf.push_str(obj.b);
                e.buf.push_str(", ptr ");
                e.buf.push_str(obj.a);
                e.buf.push_str(", i32 0, i32 ");
                e.buf.push_int(sl_a);
                e.buf.push_str("\n");
                if fk_a == 1 {
                    e.buf.push_str("  store ptr ");
                    e.buf.push_str(ptr_operand(v.a));
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(g);
                    e.buf.push_str("\n");
                    gab = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(gab);
                    e.buf.push_str(" = getelementptr %struct.");
                    e.buf.push_str(obj.b);
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(obj.a);
                    e.buf.push_str(", i32 0, i32 ");
                    e.buf.push_int(sl_a + 1);
                    e.buf.push_str("\n  store i64 ");
                    e.buf.push_str(v.b);
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(gab);
                    e.buf.push_str("\n");
                } elif fk_a == 5 {
                    fv5a = float_operand(v, e);
                    e.buf.push_str("  store double ");
                    e.buf.push_str(fv5a);
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(g);
                    e.buf.push_str("\n");
                } elif fk_a == 2 || fk_a == 3 || fk_a == 4 {
                    e.buf.push_str("  store ptr ");
                    e.buf.push_str(ptr_operand(v.a));
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(g);
                    e.buf.push_str("\n");
                } else {
                    store_slot_i64(e, g, v);
                }
            }
        }
    } elif tag == st(ST::If._tag) {
        end_l = label(e, "if.end.");
        // 首条件
        c = emit_expr(ast, ast.aa[id], e);
        then_l = label(e, "if.then.");
        next_l = label(e, "if.next.");
        cc = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(cc);
        e.buf.push_str(" = icmp ne i64 ");
        e.buf.push_str(c.a);
        e.buf.push_str(", 0\n  br i1 ");
        e.buf.push_str(cc);
        e.buf.push_str(", label %");
        e.buf.push_str(then_l);
        e.buf.push_str(", label %");
        e.buf.push_str(next_l);
        e.buf.push_str("\n");
        e.buf.push_str(then_l);
        e.buf.push_str(":\n");
        e.terminated = 0;
        emit_block_all(ast, ast.bb[id], e);
        if e.terminated == 0 {
            e.buf.push_str("  br label %");
            e.buf.push_str(end_l);
            e.buf.push_str("\n");
        }
        // elif 链
        en = ast.cc[id];
        cur_next = next_l;
        while en >= 0 {
            e.buf.push_str(cur_next);
            e.buf.push_str(":\n");
            e.terminated = 0;
            ec2 = emit_expr(ast, ast.aa[en], e);
            then_l2 = label(e, "if.then.");
            next_l2 = label(e, "if.next.");
            cc2 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(cc2);
            e.buf.push_str(" = icmp ne i64 ");
            e.buf.push_str(ec2.a);
            e.buf.push_str(", 0\n  br i1 ");
            e.buf.push_str(cc2);
            e.buf.push_str(", label %");
            e.buf.push_str(then_l2);
            e.buf.push_str(", label %");
            e.buf.push_str(next_l2);
            e.buf.push_str("\n");
            e.buf.push_str(then_l2);
            e.buf.push_str(":\n");
            e.terminated = 0;
            emit_block_all(ast, ast.bb[en], e);
            if e.terminated == 0 {
                e.buf.push_str("  br label %");
                e.buf.push_str(end_l);
                e.buf.push_str("\n");
            }
            cur_next = next_l2;
            en = ast.nexts[en];
        }
        e.buf.push_str(cur_next);
        e.buf.push_str(":\n");
        e.terminated = 0;
        e2 = ast.dd[id];
        if e2 >= 0 {
            emit_block_all(ast, e2, e);
        }
        if e.terminated == 0 {
            e.buf.push_str("  br label %");
            e.buf.push_str(end_l);
            e.buf.push_str("\n");
        }
        e.buf.push_str(end_l);
        e.buf.push_str(":\n");
        e.terminated = 0;
    } elif tag == st(ST::While._tag) {
        cond_l = label(e, "while.cond.");
        body_l = label(e, "while.body.");
        end_l = label(e, "while.end.");
        if e.loop_depth < 64 {
            e.loop_ends[e.loop_depth] = end_l.copy();
            e.loop_conds[e.loop_depth] = cond_l.copy();
            e.loop_depth = e.loop_depth + 1;
        }
        e.buf.push_str("  br label %");
        e.buf.push_str(cond_l);
        e.buf.push_str("\n");
        e.buf.push_str(cond_l);
        e.buf.push_str(":\n");
        e.terminated = 0;
        c2 = emit_expr(ast, ast.aa[id], e);
        cc2 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(cc2);
        e.buf.push_str(" = icmp ne i64 ");
        e.buf.push_str(c2.a);
        e.buf.push_str(", 0\n  br i1 ");
        e.buf.push_str(cc2);
        e.buf.push_str(", label %");
        e.buf.push_str(body_l);
        e.buf.push_str(", label %");
        e.buf.push_str(end_l);
        e.buf.push_str("\n");
        e.buf.push_str(body_l);
        e.buf.push_str(":\n");
        e.terminated = 0;
        emit_block_all(ast, ast.bb[id], e);
        if e.terminated == 0 {
            e.buf.push_str("  br label %");
            e.buf.push_str(cond_l);
            e.buf.push_str("\n");
        }
        e.buf.push_str(end_l);
        e.buf.push_str(":\n");
        e.terminated = 0;
        if e.loop_depth > 0 { e.loop_depth = e.loop_depth - 1; }
    } elif tag == st(ST::ForIn._tag) {
        // for x in coll：迭代器协议（next() -> Option），直接发射
        x_nm = ast.texts[id];
        it_nm_b = StringBuf::new();
        it_nm_b.push_str("__fit_");
        it_nm_b.push_int(id);
        it_nm = it_nm_b.to_string();
        opt_nm_b = StringBuf::new();
        opt_nm_b.push_str("__fopt_");
        opt_nm_b.push_int(id);
        opt_nm = opt_nm_b.to_string();
        v_it = emit_expr(ast, ast.aa[id], e);
        if v_it.kind == 2 || v_it.kind == 4 || v_it.kind == 21 {
            e.declare_local(it_nm, v_it.kind);
            if v_it.kind == 2 {
                e.record_etype(it_nm, e.find_struct_idx(v_it.b));
            } elif v_it.kind == 4 {
                e.record_etype(it_nm, e.find_enum_idx(v_it.b));
            } elif v_it.kind == 21 {
                e.record_etype(it_nm, e.find_iface_idx(v_it.b));
            }
            e.buf.push_str("  store ptr ");
            e.buf.push_str(v_it.a);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(it_nm);
            e.buf.push_str(".p\n");
        } elif v_it.kind == 1 {
            e.declare_local(it_nm, 1);
            e.buf.push_str("  store ptr ");
            e.buf.push_str(v_it.a);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(it_nm);
            e.buf.push_str(".ptr\n  store i64 ");
            e.buf.push_str(v_it.b);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(it_nm);
            e.buf.push_str(".len\n");
        } else {
            e.declare_local(it_nm, 0);
            e.buf.push_str("  store i64 ");
            e.buf.push_str(v_it.a);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(it_nm);
            e.buf.push_str("\n");
        }
        cond_l2 = label(e, "forin.cond.");
        body_l2 = label(e, "forin.body.");
        end_l2 = label(e, "forin.end.");
        if e.loop_depth < 64 {
            e.loop_ends[e.loop_depth] = end_l2.copy();
            e.loop_conds[e.loop_depth] = cond_l2.copy();
            e.loop_depth = e.loop_depth + 1;
        }
        e.buf.push_str("  br label %");
        e.buf.push_str(cond_l2);
        e.buf.push_str("\n");
        e.buf.push_str(cond_l2);
        e.buf.push_str(":\n");
        e.terminated = 0;
        v_opt = emit_forin_next(ast, it_nm, v_it.kind, v_it.b, e);
        e.declare_local(opt_nm, 4);
        ei_opt = -1;
        if v_opt.b.len > 0 { ei_opt = e.find_enum_idx(v_opt.b); }
        e.record_etype(opt_nm, ei_opt);
        e.buf.push_str("  store ptr ");
        e.buf.push_str(v_opt.a);
        e.buf.push_str(", ptr %v_");
        e.buf.push_str(opt_nm);
        e.buf.push_str(".p\n");
        vi_some = -1;
        if ei_opt >= 0 { vi_some = e.find_variant_idx(ei_opt, "Some"); }
        gt_l = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(gt_l);
        e.buf.push_str(" = getelementptr %enum.");
        e.buf.push_str(v_opt.b);
        e.buf.push_str(", ptr ");
        e.buf.push_str(v_opt.a);
        e.buf.push_str(", i32 0, i32 0\n  ");
        tg_l = e.fresh();
        e.buf.push_str(tg_l);
        e.buf.push_str(" = load i64, ptr ");
        e.buf.push_str(gt_l);
        e.buf.push_str("\n  ");
        c_fi = e.fresh();
        e.buf.push_str(c_fi);
        e.buf.push_str(" = icmp eq i64 ");
        e.buf.push_str(tg_l);
        e.buf.push_str(", ");
        e.buf.push_int(vi_some);
        e.buf.push_str("\n  br i1 ");
        e.buf.push_str(c_fi);
        e.buf.push_str(", label %");
        e.buf.push_str(body_l2);
        e.buf.push_str(", label %");
        e.buf.push_str(end_l2);
        e.buf.push_str("\n");
        e.buf.push_str(body_l2);
        e.buf.push_str(":\n");
        e.terminated = 0;
        v_pl = emit_variant_payload(ast, v_opt.a, v_opt.b, "Some", e);
        if v_pl.kind == 1 {
            e.declare_local(x_nm, 1);
            e.buf.push_str("  store ptr ");
            e.buf.push_str(v_pl.a);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(x_nm);
            e.buf.push_str(".ptr\n  store i64 ");
            e.buf.push_str(v_pl.b);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(x_nm);
            e.buf.push_str(".len\n");
        } elif v_pl.kind == 2 || v_pl.kind == 4 || v_pl.kind == 21 {
            e.declare_local(x_nm, v_pl.kind);
            if v_pl.kind == 2 {
                e.record_etype(x_nm, e.find_struct_idx(v_pl.b));
            } elif v_pl.kind == 4 {
                e.record_etype(x_nm, e.find_enum_idx(v_pl.b));
            } elif v_pl.kind == 21 {
                e.record_etype(x_nm, e.find_iface_idx(v_pl.b));
            }
            e.buf.push_str("  store ptr ");
            e.buf.push_str(v_pl.a);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(x_nm);
            e.buf.push_str(".p\n");
        } elif v_pl.kind == 6 {
            e.declare_local(x_nm, 40);
            e.buf.push_str("  store double ");
            e.buf.push_str(v_pl.a);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(x_nm);
            e.buf.push_str(".d\n");
        } else {
            e.declare_local(x_nm, 0);
            e.buf.push_str("  store i64 ");
            e.buf.push_str(v_pl.a);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(x_nm);
            e.buf.push_str("\n");
        }
        emit_block_all(ast, ast.bb[id], e);
        if e.terminated == 1 {
            e.buf.push_str(end_l2);
            e.buf.push_str(":\n");
            e.terminated = 0;
            if e.loop_depth > 0 { e.loop_depth = e.loop_depth - 1; }
            return;
        }
        e.buf.push_str("  br label %");
        e.buf.push_str(cond_l2);
        e.buf.push_str("\n");
        e.buf.push_str(end_l2);
        e.buf.push_str(":\n");
        e.terminated = 0;
        if e.loop_depth > 0 { e.loop_depth = e.loop_depth - 1; }
    } elif tag == st(ST::For._tag) {
        e.declare_local(ast.texts[id], 0);
        v = emit_expr(ast, ast.aa[id], e);
        e.buf.push_str("  store i64 ");
        e.buf.push_str(v.a);
        e.buf.push_str(", ptr %v_");
        e.buf.push_str(ast.texts[id]);
        e.buf.push_str("\n");
        cond_l = label(e, "for.cond.");
        body_l = label(e, "for.body.");
        end_l = label(e, "for.end.");
        if e.loop_depth < 64 {
            e.loop_ends[e.loop_depth] = end_l.copy();
            e.loop_conds[e.loop_depth] = cond_l.copy();
            e.loop_depth = e.loop_depth + 1;
        }
        e.buf.push_str("  br label %");
        e.buf.push_str(cond_l);
        e.buf.push_str("\n");
        e.buf.push_str(cond_l);
        e.buf.push_str(":\n");
        iv = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(iv);
        e.buf.push_str(" = load i64, ptr %v_");
        e.buf.push_str(ast.texts[id]);
        e.buf.push_str("\n");
        ev = emit_expr(ast, ast.bb[id], e);
        c3 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(c3);
        e.buf.push_str(" = icmp slt i64 ");
        e.buf.push_str(iv);
        e.buf.push_str(", ");
        e.buf.push_str(ev.a);
        e.buf.push_str("\n  br i1 ");
        e.buf.push_str(c3);
        e.buf.push_str(", label %");
        e.buf.push_str(body_l);
        e.buf.push_str(", label %");
        e.buf.push_str(end_l);
        e.buf.push_str("\n");
        e.buf.push_str(body_l);
        e.buf.push_str(":\n");
        e.terminated = 0;
        emit_block_all(ast, ast.dd[id], e);
        if e.terminated == 1 {
            e.buf.push_str(end_l);
            e.buf.push_str(":\n");
            e.terminated = 0;
            if e.loop_depth > 0 { e.loop_depth = e.loop_depth - 1; }
            return;
        }
        iv2 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(iv2);
        e.buf.push_str(" = load i64, ptr %v_");
        e.buf.push_str(ast.texts[id]);
        e.buf.push_str("\n");
        nx = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(nx);
        e.buf.push_str(" = add i64 ");
        e.buf.push_str(iv2);
        e.buf.push_str(", 1\n  store i64 ");
        e.buf.push_str(nx);
        e.buf.push_str(", ptr %v_");
        e.buf.push_str(ast.texts[id]);
        e.buf.push_str("\n  br label %");
        e.buf.push_str(cond_l);
        e.buf.push_str("\n");
        e.buf.push_str(end_l);
        e.buf.push_str(":\n");
        e.terminated = 0;
        if e.loop_depth > 0 { e.loop_depth = e.loop_depth - 1; }
    }
}

/// lambda 提升：复用函数发射（保存/恢复发射器状态）
#[alloc]
#[state]
fn emit_lambda(ref Ast ast, int lam_id, ref mut Emitter e) {
    sv_buf = e.buf;
    sv_entry = e.entry_pos;
    sv_pre = e.pre_buf;
    sv_prea = e.pre_active;
    sv_term = e.terminated;
    sv_ld = e.loop_depth;
    sv_tmp = e.tmp;
    sv_lv = e.lv_count;
    e.buf = StringBuf::new();
    e.terminated = 0;
    e.loop_depth = 0;
    emit_fn_named(ast, lam_id, "", e);
    e.lambda_buf.push_str(e.buf.to_string());
    e.buf = sv_buf;
    e.entry_pos = sv_entry;
    e.pre_buf = sv_pre;
    e.pre_active = sv_prea;
    e.terminated = sv_term;
    e.loop_depth = sv_ld;
    e.tmp = sv_tmp;
    e.lv_count = sv_lv;
}

fn emit_fn(ref Ast ast, int id, ref mut Emitter e) {
    emit_fn_named(ast, id, "", e);
}

/// extern 声明：declare i64 @name(...)（同名去重）
fn emit_decl(ref Ast ast, int id, ref mut Emitter e) {
    nm_d = ast.texts[id];
    i_d = 0;
    while i_d < e.decl_count {
        if e.decl_names[i_d] == nm_d { return; }
        i_d = i_d + 1;
    }
    if e.decl_count < 2048 {
        e.decl_names[e.decl_count] = nm_d.copy();
        e.decl_count = e.decl_count + 1;
    }
    rll = e.ret_llvm_code(ast, ast.tys[id]);
    if rll == 1 {
        e.buf.push_str("declare i32 @");
    } elif rll == 2 {
        e.buf.push_str("declare i8 @");
    } else {
        e.buf.push_str("declare i64 @");
    }
    e.buf.push_str(ast.texts[id]);
    e.buf.push_str("(");
    first = 1;
    p = ast.aa[id];
    idx = 0;
    while p >= 0 {
        if first == 0 { e.buf.push_str(", "); }
        pk = e.param_kind(ast, p);
        if pk == 0 {
            e.buf.push_str("i64 %a");
        } else {
            e.buf.push_str("ptr %a");
        }
        e.buf.push_int(idx);
        first = 0;
        idx = idx + 1;
        p = ast.nexts[p];
    }
    e.buf.push_str(")\n");
}

fn emit_fn_named(ref Ast ast, int id, ref String prefix, ref mut Emitter e) {
    e.tmp = 0;
    e.lv_count = 0;
    // 上一函数以 ret 结束会残留 terminated；新函数体必须复位，否则整段被跳过
    e.terminated = 0;
    name = ast.texts[id];
    rty = ast.tys[id];
    rkind = e.ret_kind(ast, rty);
    e.cur_rtype = rty;
    if rkind == 1 {
        e.buf.push_str("define { ptr, i64 } @");
    } elif rkind == 5 {
        e.buf.push_str("define double @");
    } else {
        e.buf.push_str("define i64 @");
    }
    full_d = name.copy();
    if prefix.len > 0 {
        full_d = prefix + ".";
        full_d = full_d + name;
    }
    e.buf.push_str(e.fn_sym(full_d));
    e.buf.push_str("(");
    first = 1;
    p = ast.aa[id];
    idx = 0;
    while p >= 0 {
        if first == 0 { e.buf.push_str(", "); }
        if ast.texts[p] == "self" {
            e.buf.push_str("ptr %self");
            idx = idx + 1;
        } else {
            pk_sig = e.param_kind(ast, p);
            if pk_sig == 31 {
                e.buf.push_str("double %a");
                e.buf.push_int(idx);
                idx = idx + 1;
            } elif pk_sig == 1 {
                e.buf.push_str("ptr %a");
                e.buf.push_int(idx);
                e.buf.push_str(", i64 %a");
                e.buf.push_int(idx + 1);
                idx = idx + 2;
            } elif pk_sig == 0 {
                e.buf.push_str("i64 %a");
                e.buf.push_int(idx);
                idx = idx + 1;
            } else {
                e.buf.push_str("ptr %a");
                e.buf.push_int(idx);
                idx = idx + 1;
            }
        }
        first = 0;
        p = ast.nexts[p];
    }
    env_slot = -1;
    if ast.tags[id] == et(ET::Lambda._tag) {
        li_sig = e.lam_index_of(id);
        if li_sig >= 0 {
            if e.cap_count[li_sig] > 0 {
                if first == 0 { e.buf.push_str(", "); }
                e.buf.push_str("ptr %a");
                e.buf.push_int(idx);
                env_slot = idx;
            }
        }
    }
    e.buf.push_str(") {\nentry:\n");
    e.entry_pos = e.buf.len;
    e.pre_buf = StringBuf::new();
    e.pre_active = 1;
    p2 = ast.aa[id];
    idx2 = 0;
    while p2 >= 0 {
        if ast.texts[p2] == "self" {
            kind_self = 2;
            si_self = e.find_struct_idx(prefix);
            ei_self = -1;
            if prefix == "String" {
                // impl String：self 是 String 值（ptr+len；len 占位 0，调用点走内建）
                kind_self = 1;
            } elif si_self >= 0 {
                kind_self = 100 + si_self;
            } else {
                ei_self = e.find_enum_idx(prefix);
                if ei_self >= 0 {
                    kind_self = 20;
                } else {
                    // impl int / impl char 等原语 impl：self 是指向原语的引用
                    kind_self = 30;
                }
            }
            e.declare_local("self", kind_self);
            if ei_self >= 0 {
                e.record_etype("self", ei_self);
            } else {
                e.record_etype("self", si_self);
            }
            if kind_self == 1 {
                e.buf.push_str("  store ptr %self, ptr %v_self.ptr\n  store i64 0, ptr %v_self.len\n");
            } else {
                e.buf.push_str("  store ptr %self, ptr %v_self.p\n");
            }
            idx2 = idx2 + 1;
        } else {
            pname = ast.texts[p2];
            pk = e.param_kind(ast, p2);
            ei_p = -1;
            if pk == 20 {
                ptn = ty_name(ast, ast.tys[p2]);
                ei_p = e.find_enum_idx(ptn);
            } elif pk >= 100 {
                ei_p = pk - 100;
            } elif pk == 21 {
                ptn21 = ty_name(ast, ast.tys[p2]);
                ei_p = e.find_iface_idx(ptn21);
            } elif pk == 3 {
                // 数组形参：记录元素类型节点
                ety_p = ast.tys[p2];
                if ety_p >= 0 {
                    eei = ast.tags[ety_p];
                    if eei == tt(TT::Array._tag) || eei == tt(TT::ArraySized._tag) {
                        ei_p = ast.aa[ety_p];
                    }
                }
            }
            if pk == 31 {
                e.declare_local(pname, 40);
                e.buf.push_str("  store double %a");
                e.buf.push_int(idx2);
                e.buf.push_str(", ptr %v_");
                e.buf.push_str(pname);
                e.buf.push_str(".d\n");
                idx2 = idx2 + 1;
            } elif pk == 1 {
                // String 参数：ptr + len 双槽
                e.declare_local(pname, 1);
                e.buf.push_str("  store ptr %a");
                e.buf.push_int(idx2);
                e.buf.push_str(", ptr %v_");
                e.buf.push_str(pname);
                e.buf.push_str(".ptr\n  store i64 %a");
                e.buf.push_int(idx2 + 1);
                e.buf.push_str(", ptr %v_");
                e.buf.push_str(pname);
                e.buf.push_str(".len\n");
                idx2 = idx2 + 2;
            } elif pk == 0 {
                e.declare_local(pname, 0);
                e.buf.push_str("  store i64 %a");
                e.buf.push_int(idx2);
                e.buf.push_str(", ptr %v_");
                e.buf.push_str(pname);
                e.buf.push_str("\n");
                idx2 = idx2 + 1;
            } else {
                e.declare_local(pname, pk);
                e.record_etype(pname, ei_p);
                e.buf.push_str("  store ptr %a");
                e.buf.push_int(idx2);
                e.buf.push_str(", ptr %v_");
                e.buf.push_str(pname);
                e.buf.push_str(".p\n");
                idx2 = idx2 + 1;
            }
            pty2 = ast.tys[p2];
            if pty2 >= 0 {
                if ast.tags[pty2] == tt(TT::Closure._tag) {
                    e.record_ftype(pname, pty2);
                }
            }
        }
        p2 = ast.nexts[p2];
    }
    // 闭包捕获序言：从环境块恢复捕获局部
    if ast.tags[id] == et(ET::Lambda._tag) {
        li_pr = e.lam_index_of(id);
        if li_pr >= 0 && env_slot >= 0 {
            cnt_pr = e.cap_count[li_pr];
            start_pr = e.cap_start[li_pr];
            i_pr = 0;
            while i_pr < cnt_pr {
                cnm = e.cap_names[start_pr + i_pr];
                ckd = e.cap_kinds[start_pr + i_pr];
                cey = e.cap_etypes[start_pr + i_pr];
                off_pr = (i_pr + 1) * 8;
                if ckd == 0 {
                    e.declare_local(cnm, 30);
                    tp_pr = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(tp_pr);
                    e.buf.push_str(" = getelementptr i8, ptr %a");
                    e.buf.push_int(env_slot);
                    e.buf.push_str(", i64 ");
                    e.buf.push_int(off_pr);
                    e.buf.push_str("\n  store ptr ");
                    e.buf.push_str(tp_pr);
                    e.buf.push_str(", ptr %v_");
                    e.buf.push_str(cnm);
                    e.buf.push_str(".p\n");
                } elif ckd == 30 {
                    e.declare_local(cnm, 30);
                    tp30 = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(tp30);
                    e.buf.push_str(" = getelementptr i8, ptr %a");
                    e.buf.push_int(env_slot);
                    e.buf.push_str(", i64 ");
                    e.buf.push_int(off_pr);
                    e.buf.push_str("\n  ");
                    rp30b = e.fresh();
                    e.buf.push_str(rp30b);
                    e.buf.push_str(" = load ptr, ptr ");
                    e.buf.push_str(tp30);
                    e.buf.push_str("\n  store ptr ");
                    e.buf.push_str(rp30b);
                    e.buf.push_str(", ptr %v_");
                    e.buf.push_str(cnm);
                    e.buf.push_str(".p\n");
                } elif ckd == 1 {
                    e.declare_local(cnm, 1);
                    tp1 = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(tp1);
                    e.buf.push_str(" = getelementptr i8, ptr %a");
                    e.buf.push_int(env_slot);
                    e.buf.push_str(", i64 ");
                    e.buf.push_int(off_pr);
                    e.buf.push_str("\n  ");
                    vp1 = e.fresh();
                    e.buf.push_str(vp1);
                    e.buf.push_str(" = load ptr, ptr ");
                    e.buf.push_str(tp1);
                    e.buf.push_str("\n  ");
                    tl1 = e.fresh();
                    e.buf.push_str(tl1);
                    e.buf.push_str(" = getelementptr i8, ptr %a");
                    e.buf.push_int(env_slot);
                    e.buf.push_str(", i64 ");
                    e.buf.push_int(off_pr + 8);
                    e.buf.push_str("\n  ");
                    vl1 = e.fresh();
                    e.buf.push_str(vl1);
                    e.buf.push_str(" = load i64, ptr ");
                    e.buf.push_str(tl1);
                    e.buf.push_str("\n  store ptr ");
                    e.buf.push_str(vp1);
                    e.buf.push_str(", ptr %v_");
                    e.buf.push_str(cnm);
                    e.buf.push_str(".ptr\n  store i64 ");
                    e.buf.push_str(vl1);
                    e.buf.push_str(", ptr %v_");
                    e.buf.push_str(cnm);
                    e.buf.push_str(".len\n");
                } elif ckd == 40 {
                    e.declare_local(cnm, 40);
                    tpd = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(tpd);
                    e.buf.push_str(" = getelementptr i8, ptr %a");
                    e.buf.push_int(env_slot);
                    e.buf.push_str(", i64 ");
                    e.buf.push_int(off_pr);
                    e.buf.push_str("\n  ");
                    bd0 = e.fresh();
                    e.buf.push_str(bd0);
                    e.buf.push_str(" = load i64, ptr ");
                    e.buf.push_str(tpd);
                    e.buf.push_str("\n  ");
                    dd0 = e.fresh();
                    e.buf.push_str(dd0);
                    e.buf.push_str(" = bitcast i64 ");
                    e.buf.push_str(bd0);
                    e.buf.push_str(" to double\n  store double ");
                    e.buf.push_str(dd0);
                    e.buf.push_str(", ptr %v_");
                    e.buf.push_str(cnm);
                    e.buf.push_str(".d\n");
                } else {
                    e.declare_local(cnm, ckd);
                    e.record_etype(cnm, cey);
                    tpp = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(tpp);
                    e.buf.push_str(" = getelementptr i8, ptr %a");
                    e.buf.push_int(env_slot);
                    e.buf.push_str(", i64 ");
                    e.buf.push_int(off_pr);
                    e.buf.push_str("\n  ");
                    vpp = e.fresh();
                    e.buf.push_str(vpp);
                    e.buf.push_str(" = load ptr, ptr ");
                    e.buf.push_str(tpp);
                    e.buf.push_str("\n  store ptr ");
                    e.buf.push_str(vpp);
                    e.buf.push_str(", ptr %v_");
                    e.buf.push_str(cnm);
                    e.buf.push_str(".p\n");
                }
                i_pr = i_pr + 1;
            }
        }
    }
    if name == "main" && e.need_ginit == 1 {
        e.buf.push_str("  call void @__aya_init_globals()\n");
    }
    emit_stmts(ast, ast.aa[ast.bb[id]], e);
    // 块尾表达式（无分号的最后表达式）：作为隐式返回值
    if e.terminated == 0 {
        body_blk = ast.bb[id];
        if body_blk >= 0 {
            tail = ast.bb[body_blk];
            if tail >= 0 {
                tv = emit_expr(ast, tail, e);
                if rkind == 5 {
                    if tv.kind == 6 {
                        e.buf.push_str("  ret double ");
                        e.buf.push_str(tv.a);
                        e.buf.push_str("\n");
                    } else {
                        ft5 = e.fresh();
                        e.buf.push_str("  ");
                        e.buf.push_str(ft5);
                        e.buf.push_str(" = sitofp i64 ");
                        e.buf.push_str(tv.a);
                        e.buf.push_str(" to double\n  ret double ");
                        e.buf.push_str(ft5);
                        e.buf.push_str("\n");
                    }
                    e.terminated = 1;
                } elif rkind == 1 {
                    if tv.kind == 1 {
                        r0t = e.fresh();
                        e.buf.push_str("  ");
                        e.buf.push_str(r0t);
                        e.buf.push_str(" = insertvalue { ptr, i64 } undef, ptr ");
                        e.buf.push_str(tv.a);
                        e.buf.push_str(", 0\n  ");
                        r1t = e.fresh();
                        e.buf.push_str(r1t);
                        e.buf.push_str(" = insertvalue { ptr, i64 } ");
                        e.buf.push_str(r0t);
                        e.buf.push_str(", i64 ");
                        e.buf.push_str(tv.b);
                        e.buf.push_str(", 1\n  ret { ptr, i64 } ");
                        e.buf.push_str(r1t);
                        e.buf.push_str("\n");
                    } else {
                        e.buf.push_str("  ret { ptr, i64 } { ptr null, i64 0 }\n");
                    }
                } elif tv.kind == 2 || tv.kind == 3 || tv.kind == 4 {
                    pit = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(pit);
                    e.buf.push_str(" = ptrtoint ptr ");
                    e.buf.push_str(tv.a);
                    e.buf.push_str(" to i64\n  ret i64 ");
                    e.buf.push_str(pit);
                    e.buf.push_str("\n");
                } else {
                    e.buf.push_str("  ret i64 ");
                    e.buf.push_str(tv.a);
                    e.buf.push_str("\n");
                }
                e.terminated = 1;
            }
        }
    }
    if rkind == 1 {
        e.buf.push_str("  ret { ptr, i64 } { ptr null, i64 0 }\n}\n");
    } elif rkind == 5 {
        e.buf.push_str("  ret double 0.0\n}\n");
    } else {
        e.buf.push_str("  ret i64 0\n}\n");
    }
    // 把 alloca 前置到 entry 块（只复制函数体片段，避免整缓冲复制）
    e.pre_active = 0;
    body_s = e.buf.substring(e.entry_pos, e.buf.len);
    e.buf.truncate(e.entry_pos);
    e.buf.push_str(e.pre_buf.to_string());
    e.buf.push_str(body_s);
    e.cur_rtype = -1;
}

#[alloc]
#[state]
pub fn emit_program(ref Ast ast, int prog, ref String file) -> String {
    e = Emitter::new();
    e.src_file = file.copy();
    e.collect_decls(ast, prog);
    e.collect_globals(ast, prog);
    e.collect_lambdas(ast);
    // 结构体类型定义
    si = 0;
    while si < e.st_count {
        e.buf.push_str("%struct.");
        e.buf.push_str(e.st_names[si]);
        e.buf.push_str(" = type { ");
        n = e.st_slots[si];
        i = 0;
        while i < n {
            if i > 0 { e.buf.push_str(", "); }
            e.buf.push_str("i64");
            i = i + 1;
        }
        e.buf.push_str(" }\n");
        si = si + 1;
    }
    // 枚举类型定义（tag + 载荷槽）
    ei2 = 0;
    while ei2 < e.en_count {
        e.buf.push_str("%enum.");
        e.buf.push_str(e.en_names[ei2]);
        e.buf.push_str(" = type { i64");
        mx = e.enum_max_arity(ei2);
        k2 = 0;
        while k2 < mx {
            e.buf.push_str(", i64");
            k2 = k2 + 1;
        }
        e.buf.push_str(" }\n");
        ei2 = ei2 + 1;
    }
    // 函数与方法
    s = ast.aa[prog];
    while s >= 0 {
        if ast.tags[s] == st(ST::FnDecl._tag) {
            if e.fn_first_id(ast.texts[s]) != s {
                // 重名重载：只发射第一个定义
            } elif ast.dd[s] == 1 {
                emit_decl(ast, s, e);
            } else {
                emit_fn(ast, s, e);
            }
        } elif ast.tags[s] == st(ST::ImplBlock._tag) {
            m = ast.aa[s];
            while m >= 0 {
                if ast.tags[m] == st(ST::FnDecl._tag) {
                    full_n = ast.texts[s] + ".";
                    full_n = full_n + ast.texts[m];
                    if e.fn_first_id(full_n) == m {
                        emit_fn_named(ast, m, ast.texts[s], e);
                    }
                }
                m = ast.nexts[m];
            }
        } elif ast.tags[s] == st(ST::Namespace._tag) {
            m3 = ast.aa[s];
            while m3 >= 0 {
                if ast.tags[m3] == st(ST::FnDecl._tag) {
                    full_n2 = ast.texts[s] + ".";
                    full_n2 = full_n2 + ast.texts[m3];
                    if e.fn_first_id(full_n2) == m3 {
                        emit_fn_named(ast, m3, ast.texts[s], e);
                    }
                }
                m3 = ast.nexts[m3];
            }
        }
        s = ast.nexts[s];
    }
    if e.decl_has("__ayanami_print_int") == 0 { e.buf.push_str("declare void @__ayanami_print_int(i64)\n"); }
    if e.decl_has("__ayanami_print_ln") == 0 { e.buf.push_str("declare void @__ayanami_print_ln()\n"); }
    if e.decl_has("__ayanami_print_str") == 0 { e.buf.push_str("declare void @__ayanami_print_str(ptr, i64)\n"); }
    // 数组分配/清零所需（M6a）：malloc + llvm.memset
    if e.decl_has("malloc") == 0 { e.buf.push_str("declare ptr @malloc(i64)\n"); }
    if e.decl_has("memcpy") == 0 { e.buf.push_str("declare ptr @memcpy(ptr, ptr, i64)\n"); }
    if e.decl_has("memcmp") == 0 { e.buf.push_str("declare i32 @memcmp(ptr, ptr, i64)\n"); }
    if e.decl_has("__ayanami_panic_at") == 0 { e.buf.push_str("declare void @__ayanami_panic_at(i64, i64, ptr, i64, ptr, i64)\n"); }
    e.buf.push_str("declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)\n");
    // lambda 函数定义（非捕获；捕获留待后续）
    li = 0;
    while li < e.lam_count {
        emit_lambda(ast, e.lam_ids[li], e);
        li = li + 1;
    }
    e.buf.push_str(e.lambda_buf.to_string());
    // Fn 值环境块全局（@fnenv.* / @lamenv.*）
    e.buf.push_str(e.env_defs.to_string());
    // vtable 全局（接口动态派发）
    e.emit_vtables();
    e.buf.push_str(e.vt_defs.to_string());
    // 结构体全局初始化函数（main 入口调用）
    emit_globals_init(ast, e);
    e.buf.push_str(e.ginit_buf.to_string());
    // 常量/静态全局
    gi = 0;
    while gi < e.g_count {
        e.buf.push_str("@");
        e.buf.push_str(e.g_names[gi]);
        if e.g_kinds[gi] == 0 {
            e.buf.push_str(" = global i64 ");
            e.buf.push_str(e.g_vals[gi]);
            e.buf.push_str("\n");
        } elif e.g_kinds[gi] == 3 {
            e.buf.push_str(" = global double ");
            e.buf.push_str(e.g_vals[gi]);
            e.buf.push_str("\n");
        } elif e.g_kinds[gi] == 4 {
            e.buf.push_str(" = global i64 0\n");
        } else {
            e.buf.push_str(" = global [");
            e.buf.push_int(e.g_lens[gi]);
            e.buf.push_str(" x i64] [");
            // 元素以逗号串存，展开
            vs = e.g_vals[gi];
            st2 = 0;
            ii = 0;
            firstg = 1;
            while ii <= vs.len as int {
                at2 = 0;
                if ii == vs.len as int { at2 = 1; }
                isc = 0;
                if at2 == 0 {
                    if vs.index(ii as usize) == ',' { isc = 1; }
                }
                if at2 == 1 || isc == 1 {
                    if ii > st2 {
                        if firstg == 0 { e.buf.push_str(", "); }
                        e.buf.push_str("i64 ");
                        e.buf.push_str(vs.substring(st2 as usize, ii as usize));
                        firstg = 0;
                    }
                    st2 = ii + 1;
                }
                ii = ii + 1;
            }
            e.buf.push_str("]\n");
        }
        gi = gi + 1;
    }
    // 字符串字面量全局
    i = 0;
    while i < e.str_count {
        text = e.strs[i];
        e.buf.push_str("@.str.");
        e.buf.push_int(i);
        e.buf.push_str(" = private unnamed_addr constant [");
        e.buf.push_int(text.len as int + 1);
        e.buf.push_str(" x i8] c\"");
        e.buf.push_str(escape_ir(text));
        e.buf.push_str("\\00\"\n");
        i = i + 1;
    }
    return e.buf.to_string();
}
