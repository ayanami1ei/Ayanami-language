                e.buf.push_str(rv30e);
                e.buf.push_str(" = load ptr, ptr ");
                e.buf.push_str(rp);
                e.buf.push_str("\n");
                return Val { kind = 4, a = rv30e, b = e.en_names[e30 - 6000].copy(), ty = -1 };
            }
