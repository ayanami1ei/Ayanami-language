            ptnames = ["int", "i32", "i64", "u32", "u64", "usize", "i8", "u8", "i16", "u16", "float", "f32", "f64", "char", "bool"];
            if obj.kind == 6 {
                // 浮点接收者：浮点类型名优先（避免命中 int 版方法）
                ptnames = ["float", "f64", "f32", "int", "i32", "i64", "u32", "u64", "usize", "i8", "u8", "i16", "u16", "char", "bool"];
            }
