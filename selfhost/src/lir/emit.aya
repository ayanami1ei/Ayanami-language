import "string";
import "aya_sb";
import "aya_ast";
import "aya_log";

// M5b/M6a：AST -> LLVM IR 文本（int/bool/String/struct/数组 子集）
// 值表示：Val { kind: 0=int, 1=String(ptr,len), 2=struct(ptr,类型名), 3=数组(ptr,元素类型 id) }
pub struct Val {
    int kind
    String a
    String b
    int ty
}

pub struct Emitter {
    StringBuf buf
    int tmp
    [String] locals
    [int] local_kinds
    [int] local_forms
    [int] local_ftypes
    int lv_count
    // 数组局部变量的元素类型（AST 类型节点 id；-1 表示非数组）
    [int] local_etypes
    [String] strs
    int str_count
    // 结构体表（字段扁平）
    [String] st_names
    [int] st_fstart
    [int] st_fcount
    [String] st_fields
    int st_ftotal
    int st_count
    // 字段类型：0=int槽 1=String(2槽) 2=struct 3=array
    [int] st_fkind
    [int] st_finfo
    [int] st_fslot
    [int] st_ftype
    [int] st_slots
    // 方法表：(类型, 方法名) -> FnDecl id
    [String] m_ty
    [String] m_name
    [int] m_id
    int m_count
    // 枚举表
    [String] en_names
    [int] en_vstart
    [int] en_vcount
    [String] en_variants
    [int] en_arity
    int en_vtotal
    int en_count
    // 载荷类型（扁平）与每变体起点；槽位数（String 载荷占 2 槽）
    [int] en_ptype
    [int] en_pvstart
    int en_ptotal
    [int] en_vslots
    // 函数签名表（参数种类：0=int, 20=enum, 100+si=struct）
    [String] fn_names
    // 是否 extern（C 符号，不加修饰）
    [int] fn_extern
    [int] fn_pstart
    [int] fn_pcount
    [int] fn_pkinds
    int fn_ptotal
    int fn_count
    [int] fn_rtype
    [int] fn_rllvm
    [int] fn_first
    int cur_rtype
    [int] m_rtype
    // 已发射的 extern 声明（去重）
    [String] decl_names
    int decl_count
    // lambda 定义输出缓冲
    StringBuf lambda_buf
    // lambda 表（id -> 名字）
    [int] lam_ids
    [String] lam_names
    int lam_count
    // 闭包捕获表（按 lambda 表下标索引）
    [int] cap_start
    [int] cap_count
    [int] cap_done
    [String] cap_names
    [int] cap_kinds
    [int] cap_etypes
    [int] cap_ids
    int cap_total
    // Fn 值环境块全局（@fnenv.* / @lamenv.*）
    [String] env_g_names
    int env_g_count
    StringBuf env_defs
    // 全局常量/静态：0=int 2=数组；数组元素以逗号串存
    [String] g_names
    [int] g_kinds
    // 接口名表与接口方法表（vtable 动态派发）
    [String] if_names
    [int] if_mstart
    [int] if_mcount
    [String] if_mnames
    [int] if_mnode
    int if_mtotal
    int if_count
    // 函数形参接口下标（+1；0 = 非接口），按 fn_ptotal 对齐
    [int] fn_piface
    // vtable 定义缓冲与已登记的 (类型.接口) 对
    StringBuf vt_defs
    [String] vt_pairs
    int vt_count
    // #[compile_time] 函数表与常量求值环境（编译期解释器）
    [String] ct_names
    [int] ct_ids
    int ct_count
    [String] ct_env_names
    [int] ct_env_vals
    int ct_env_count
    [int] ct_args
    int ct_ret
    int ct_depth
    int ct_frame
    // 源文件名（#panic 位置用）
    String src_file
    // 结构体全局（kind 4）：初始化节点与结构体下标
    [int] g_init_ids
    [int] g_stype
    int need_ginit
    StringBuf ginit_buf
    [String] g_vals
    [int] g_lens
    int g_count
    // 函数体 alloca 前置缓冲（LLVM 要求 alloca 支配所有使用）
    StringBuf pre_buf
    int pre_active
    int entry_pos
    // 循环标签栈（break/continue）
    [String] loop_ends
    [String] loop_conds
    int loop_depth
    int terminated
}

pub namespace Emitter {
    #[alloc]
    pub fn new() -> Emitter {
        e = Emitter {
            buf = StringBuf::new(), tmp = 0,
            locals = [String; 512], local_kinds = [int; 512], local_forms = [int; 512],
            local_ftypes = [int; 512], lv_count = 0,
            local_etypes = [int; 512],
            strs = [String; 8192], str_count = 0,
            st_names = [String; 128], st_fstart = [int; 128], st_fcount = [int; 128],
            st_fields = [String; 1024], st_ftotal = 0, st_count = 0,
            st_fkind = [int; 1024], st_finfo = [int; 1024], st_fslot = [int; 1024],
            st_ftype = [int; 1024],
            st_slots = [int; 128],
            m_ty = [String; 8192], m_name = [String; 8192], m_id = [int; 8192], m_count = 0,
            en_names = [String; 128], en_vstart = [int; 128], en_vcount = [int; 128],
            en_variants = [String; 1024], en_arity = [int; 1024], en_vtotal = 0, en_count = 0,
            en_ptype = [int; 4096], en_pvstart = [int; 1024], en_ptotal = 0, en_vslots = [int; 1024],
            fn_names = [String; 8192], fn_extern = [int; 8192], fn_pstart = [int; 8192], fn_pcount = [int; 8192],
            fn_pkinds = [int; 65536], fn_ptotal = 0, fn_count = 0,
            fn_rtype = [int; 8192], fn_rllvm = [int; 8192], fn_first = [int; 8192], cur_rtype = -1, m_rtype = [int; 8192],
            decl_names = [String; 2048], decl_count = 0,
            lambda_buf = StringBuf::new(),
            lam_ids = [int; 256], lam_names = [String; 256], lam_count = 0,
            cap_start = [int; 256], cap_count = [int; 256], cap_done = [int; 256],
            cap_names = [String; 1024], cap_kinds = [int; 1024], cap_etypes = [int; 1024],
            cap_ids = [int; 1024], cap_total = 0,
            env_g_names = [String; 512], env_g_count = 0, env_defs = StringBuf::new(),
            g_names = [String; 512], g_kinds = [int; 512], g_vals = [String; 512],
            g_lens = [int; 512], g_count = 0,
            g_init_ids = [int; 512], g_stype = [int; 512], need_ginit = 0, ginit_buf = StringBuf::new(),
            if_names = [String; 128], if_mstart = [int; 128], if_mcount = [int; 128],
            if_mnames = [String; 512], if_mnode = [int; 512], if_mtotal = 0, if_count = 0,
            fn_piface = [int; 32768], vt_defs = StringBuf::new(), vt_pairs = [String; 512], vt_count = 0,
            ct_names = [String; 256], ct_ids = [int; 256], ct_count = 0,
            ct_env_names = [String; 256], ct_env_vals = [int; 256], ct_env_count = 0,
            ct_args = [int; 16], ct_ret = 0, ct_depth = 0, ct_frame = 0, src_file = String::empty(),
            pre_buf = StringBuf::new(), pre_active = 0, entry_pos = 0,
            loop_ends = [String; 64], loop_conds = [String; 64], loop_depth = 0,
            terminated = 0
        };
        return e;
    }
}

/// 类型节点的类型名（解 ref/泛型包装；非命名类型返回 ""）
fn ty_name(ref Ast ast, int t) -> String {
    while t >= 0 {
        tg = ast.tags[t];
        if tg == tt(TT::Ref._tag) {
            t = ast.aa[t];
            continue;
        }
        if tg == tt(TT::Named._tag) || tg == tt(TT::Generic._tag) {
            return ast.texts[t].copy();
        }
        return "";
    }
    return "";
}

/// 取实参地址（ref 原语形参）：变量/全局直接取址，其余落到临时槽
fn addr_of_arg(ref Ast ast, int id, ref mut Emitter e) -> String {
    if id >= 0 {
        if ast.tags[id] == et(ET::Ref._tag) {
            // ref x：取 x 的地址（避免落到临时槽存成 i64 符号）
            return addr_of_arg(ast, ast.aa[id], e);
        }
        if ast.tags[id] == et(ET::Ident._tag) {
            nm = ast.texts[id];
            if e.global_kind(nm) == 0 { return "@" + nm; }
            kd = e.local_kind(nm);
            if kd == 0 { return "%v_" + nm; }
            if kd == 10 || kd == 20 || (kd >= 100 && kd < 228) {
                // 数组/枚举/结构体局部：.p 槽即其指针存储地址
                return "%v_" + nm + ".p";
            }
            if kd == 30 {
                // 已是引用：直接传递保存的指针
                rp30 = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(rp30);
                e.buf.push_str(" = load ptr, ptr %v_");
                e.buf.push_str(nm);
                e.buf.push_str(".p\n");
                return rp30;
            }
        }
    }
    v = emit_expr(ast, id, e);
    tp = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(tp);
    e.buf.push_str(" = alloca i64\n  store i64 ");
    e.buf.push_str(v.a);
    e.buf.push_str(", ptr ");
    e.buf.push_str(tp);
    e.buf.push_str("\n");
    return tp;
}

/// 浮点 -> 整数饱和下界（double 常量文本；未知返回 ""）
fn fmin_text(ref String tn) -> String {
    if tn == "u8" || tn == "char" || tn == "bool" { return "0.0"; }
    if tn == "u16" { return "0.0"; }
    if tn == "u32" { return "0.0"; }
    if tn == "u64" || tn == "usize" { return "0.0"; }
    if tn == "i8" { return "-128.0"; }
    if tn == "i16" { return "-32768.0"; }
    if tn == "i32" { return "-2147483648.0"; }
    return "";
}

/// 浮点 -> 整数饱和上界（double 常量文本；未知返回 ""）
fn fmax_text(ref String tn) -> String {
    if tn == "u8" || tn == "char" || tn == "bool" { return "255.0"; }
    if tn == "u16" { return "65535.0"; }
    if tn == "u32" { return "4294967295.0"; }
    if tn == "i8" { return "127.0"; }
    if tn == "i16" { return "32767.0"; }
    if tn == "i32" { return "2147483647.0"; }
    return "";
}

/// 具体整型名 -> LLVM 宽度类型（未知返回 ""）
fn int_ty_llvm(ref String tn) -> String {
    if tn == "u8" || tn == "i8" { return "i8"; }
    if tn == "u16" || tn == "i16" { return "i16"; }
    if tn == "u32" || tn == "i32" { return "i32"; }
    if tn == "u64" || tn == "i64" || tn == "usize" || tn == "isize" { return "i64"; }
    return "";
}

fn int_ty_signed(ref String tn) -> int {
    if tn == "i8" || tn == "i16" || tn == "i32" || tn == "i64" || tn == "isize" { return 1; }
    return 0;
}

/// 整数常量求值（字面量/括号/一元负/二元算术/位运算/引用其他常量）；失败返回 ""
fn const_int(ref Ast ast, int id) -> String {
    if id < 0 { return ""; }
    tag = ast.tags[id];
    if tag == et(ET::Literal._tag) {
        k = ast.bb[id];
        if k == lk(LK::Int._tag) {
            return int_text_ok(ast.texts[id]);
        }
        if k == lk(LK::Bool._tag) {
            if ast.texts[id] == "true" { return "1"; }
            return "0";
        }
        return "";
    }
    if tag == et(ET::Suffixed._tag) {
        return const_int(ast, ast.aa[id]);
    }
    if tag == et(ET::Binary._tag) {
        lv = const_int(ast, ast.aa[id]);
        rv = const_int(ast, ast.bb[id]);
        if lv.len == 0 || rv.len == 0 { return ""; }
        a = str_to_int_ok(lv);
        b = str_to_int_ok(rv);
        op = ast.tys[id];
        r = -999999;
        if op == bo(BinOp::Add._tag) { r = a + b; }
        elif op == bo(BinOp::Sub._tag) { r = a - b; }
        elif op == bo(BinOp::Mul._tag) { r = a * b; }
        elif op == bo(BinOp::Div._tag) { if b == 0 { return ""; } r = a / b; }
        elif op == bo(BinOp::Mod._tag) { if b == 0 { return ""; } r = a % b; }
        elif op == bo(BinOp::BitAnd._tag) { r = a & b; }
        elif op == bo(BinOp::BitOr._tag) { r = a | b; }
        elif op == bo(BinOp::BitXor._tag) { r = a ^ b; }
        elif op == bo(BinOp::Shl._tag) { r = a << b; }
        elif op == bo(BinOp::Shr._tag) { r = a >> b; }
        if r == -999999 { return ""; }
        return int_str2(r);
    }
    if tag == et(ET::Unary._tag) {
        // 一元负
        ov = const_int(ast, ast.aa[id]);
        if ov.len == 0 { return ""; }
        op2 = ast.tys[id];
        if op2 == uo(UnOp::Neg._tag) {
            return int_str2(0 - str_to_int_ok(ov));
        }
        return "";
    }
    if tag == et(ET::Ident._tag) {
        return "";
    }
    return "";
}

/// 十进制/十六进制整数字面量 -> 规范十进制文本（失败 ""）
fn int_text_ok(ref String t) -> String {
    v = str_to_int_ok(t);
    if v == -999999 { return ""; }
    return int_str2(v);
}

/// 解析整数字面量（支持 0x 前缀、下划线、负号）；失败 -999999
fn str_to_int_ok(ref String t) -> int {
    if t.len == 0 { return -999999; }
    neg = 0;
    i = 0;
    if t.index(0) == '-' {
        neg = 1;
        i = 1;
    }
    base = 10;
    if i + 1 < t.len as int {
        if t.index(i as usize) == '0' {
            c1 = t.index((i + 1) as usize);
            if c1 == 'x' || c1 == 'X' {
                base = 16;
                i = i + 2;
            } elif c1 == 'b' || c1 == 'B' {
                base = 2;
                i = i + 2;
            } elif c1 == 'o' || c1 == 'O' {
                base = 8;
                i = i + 2;
            }
        }
    }
    v = 0;
    n = 0;
    while i < t.len as int {
        ch = t.index(i as usize);
        d = -1;
        if ch == '_' { i = i + 1; continue; }
        if ch >= '0' && ch <= '9' { d = char_code(ch) - 48; }
        elif ch >= 'a' && ch <= 'f' { d = char_code(ch) - 87; }
        elif ch >= 'A' && ch <= 'F' { d = char_code(ch) - 55; }
        else { return -999999; }
        if d >= base { return -999999; }
        v = v * base + d;
        n = n + 1;
        i = i + 1;
    }
    if n == 0 { return -999999; }
    if neg == 1 { return 0 - v; }
    return v;
}

/// ptr 位置的立即数 0 -> null
fn ptr_operand(ref String a) -> String {
    if a == "0" { return "null"; }
    return a.copy();
}

fn int_str2(int v) -> String {
    b = StringBuf::new();
    b.push_int(v);
    return b.to_string();
}

fn mk_int(ref String t) -> Val {
    return Val { kind = 0, a = t.copy(), b = "", ty = -1 };
}

/// 数组值（malloc 指针 + 元素类型 id）
fn mk_arr(ref String ptr, int ety) -> Val {
    return Val { kind = 3, a = ptr.copy(), b = "", ty = ety };
}

fn mk_str(ref String ptr, int len) -> Val {
    b = StringBuf::new();
    b.push_int(len);
    return Val { kind = 1, a = ptr.copy(), b = b.to_string(), ty = -1 };
}

/// Fn 类型/函数/lambda 节点的参数链（-1 表示无）
fn fn_type_params(ref Ast ast, int fty) -> int {
    if fty < 0 { return -1; }
    tg = ast.tags[fty];
    if tg == tt(TT::Closure._tag) { return ast.aa[fty]; }
    if tg == et(ET::Lambda._tag) { return ast.aa[fty]; }
    if tg == st(ST::FnDecl._tag) { return ast.aa[fty]; }
    return -1;
}

/// Fn 类型/函数/lambda 节点的返回类型（-1 表示无）
fn fn_type_ret(ref Ast ast, int fty) -> int {
    if fty < 0 { return -1; }
    tg = ast.tags[fty];
    if tg == tt(TT::Closure._tag) { return ast.tys[fty]; }
    if tg == et(ET::Lambda._tag) { return ast.tys[fty]; }
    if tg == st(ST::FnDecl._tag) { return ast.tys[fty]; }
    return -1;
}

/// 浮点运算操作数：浮点值直接用，整数/字面量转 double
fn float_operand(ref Val v, ref mut Emitter e) -> String {
    if v.kind == 6 { return v.a.copy(); }
    t = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(t);
    e.buf.push_str(" = sitofp i64 ");
    e.buf.push_str(v.a);
    e.buf.push_str(" to double\n");
    return t;
}

/// 浮点比较谓词（有序比较）
fn fcmp_op(int op) -> String {
    if op == bo(BinOp::Eq._tag) { return "oeq"; }
    if op == bo(BinOp::Neq._tag) { return "one"; }
    if op == bo(BinOp::Lt._tag) { return "olt"; }
    if op == bo(BinOp::Gt._tag) { return "ogt"; }
    if op == bo(BinOp::Le._tag) { return "ole"; }
    if op == bo(BinOp::Ge._tag) { return "oge"; }
    return "oeq";
}

/// 浮点值（a = double 类型的操作数文本/临时名）
fn mk_float(ref String a) -> Val {
    return Val { kind = 6, a = a.copy(), b = "", ty = -1 };
}

/// 浮点字面量文本 -> LLVM double 常量文本（补 .0 / 0 前缀）
fn float_text(ref String t) -> String {
    has_dot = 0;
    has_exp = 0;
    i = 0;
    while i < t.len as int {
        c = t.index(i as usize);
        if c == '.' { has_dot = 1; }
        if c == 'e' || c == 'E' { has_exp = 1; }
        i = i + 1;
    }
    if has_dot == 0 && has_exp == 0 {
        return t.copy() + ".0";
    }
    if has_dot == 0 && has_exp == 1 {
        // 1e3 -> 1.0e3（LLVM double 常量需要小数点）
        b = StringBuf::new();
        i = 0;
        while i < t.len as int {
            c = t.index(i as usize);
            if c == 'e' || c == 'E' {
                b.push_str(".0");
            }
            b.push(c);
            i = i + 1;
        }
        return b.to_string();
    }
    if t.len > 0 {
        if t.index(0) == '.' {
            return "0" + t;
        }
    }
    return t.copy();
}

/// String 值（len 已是临时名，运行期动态）
fn mk_str_tmp(ref String ptr, ref String len_tmp) -> Val {
    return Val { kind = 1, a = ptr.copy(), b = len_tmp.copy(), ty = -1 };
}

/// 逻辑取反（i64 0/1）
fn emit_not(ref Val v, ref mut Emitter e) -> Val {
    c = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(c);
    e.buf.push_str(" = icmp eq i64 ");
    e.buf.push_str(v.a);
    e.buf.push_str(", 0\n");
    z = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(z);
    e.buf.push_str(" = zext i1 ");
    e.buf.push_str(c);
    e.buf.push_str(" to i64\n");
    return mk_int(z);
}

/// 字符串内容相等：memcmp(min) == 0 且长度相等
fn emit_str_eq(ref Val lt0, ref Val rt0, ref mut Emitter e) -> Val {
    lt = str_of_val(lt0, e);
    rt = str_of_val(rt0, e);
    c0 = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(c0);
    e.buf.push_str(" = icmp slt i64 ");
    e.buf.push_str(lt.b);
    e.buf.push_str(", ");
    e.buf.push_str(rt.b);
    e.buf.push_str("\n  ");
    mn = e.fresh();
    e.buf.push_str(mn);
    e.buf.push_str(" = select i1 ");
    e.buf.push_str(c0);
    e.buf.push_str(", i64 ");
    e.buf.push_str(lt.b);
    e.buf.push_str(", i64 ");
    e.buf.push_str(rt.b);
    e.buf.push_str("\n  ");
    r = e.fresh();
    e.buf.push_str(r);
    e.buf.push_str(" = call i32 @memcmp(ptr ");
    e.buf.push_str(lt.a);
    e.buf.push_str(", ptr ");
    e.buf.push_str(rt.a);
    e.buf.push_str(", i64 ");
    e.buf.push_str(mn);
    e.buf.push_str(")\n  ");
    eqm = e.fresh();
    e.buf.push_str(eqm);
    e.buf.push_str(" = icmp eq i32 ");
    e.buf.push_str(r);
    e.buf.push_str(", 0\n  ");
    le = e.fresh();
    e.buf.push_str(le);
    e.buf.push_str(" = icmp eq i64 ");
    e.buf.push_str(lt.b);
    e.buf.push_str(", ");
    e.buf.push_str(rt.b);
    e.buf.push_str("\n  ");
    bo2 = e.fresh();
    e.buf.push_str(bo2);
    e.buf.push_str(" = and i1 ");
    e.buf.push_str(eqm);
    e.buf.push_str(", ");
    e.buf.push_str(le);
    e.buf.push_str("\n  ");
    z = e.fresh();
    e.buf.push_str(z);
    e.buf.push_str(" = zext i1 ");
    e.buf.push_str(bo2);
    e.buf.push_str(" to i64\n");
    return mk_int(z);
}

/// 非 String 值转 String（int/泛型 i64 走 aya_int_to_string；浮点暂给空串）
#[alloc]
fn str_of_val(ref Val v, ref mut Emitter e) -> Val {
    if v.kind == 1 {
        // 返回拥有值：ref 形参的 String 字段必须显式 copy（否则双重释放）
        return Val { kind = v.kind, a = v.a.copy(), b = v.b.copy(), ty = v.ty };
    }
    if v.kind != 6 {
        if e.fn_ret_type("aya_int_to_string") >= 0 {
            t = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t);
            e.buf.push_str(" = call { ptr, i64 } @");
            e.buf.push_str(e.fn_sym("aya_int_to_string"));
            e.buf.push_str("(i64 ");
            e.buf.push_str(v.a);
            e.buf.push_str(")\n  ");
            ip = e.fresh();
            e.buf.push_str(ip);
            e.buf.push_str(" = extractvalue { ptr, i64 } ");
            e.buf.push_str(t);
            e.buf.push_str(", 0\n  ");
            il = e.fresh();
            e.buf.push_str(il);
            e.buf.push_str(" = extractvalue { ptr, i64 } ");
            e.buf.push_str(t);
            e.buf.push_str(", 1\n");
            return mk_str_tmp(ip, il);
        }
    }
    return mk_str("null", 0);
}

/// 字符串拼接（非 String 操作数先转 String）
fn emit_str_concat(ref Val lt0, ref Val rt0, ref mut Emitter e) -> Val {
    lt = str_of_val(lt0, e);
    rt = str_of_val(rt0, e);
    n = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(n);
    e.buf.push_str(" = add i64 ");
    e.buf.push_str(lt.b);
    e.buf.push_str(", ");
    e.buf.push_str(rt.b);
    e.buf.push_str("\n  ");
    buf = e.fresh();
    e.buf.push_str(buf);
    e.buf.push_str(" = call ptr @malloc(i64 ");
    e.buf.push_str(n);
    e.buf.push_str(")\n  call ptr @memcpy(ptr ");
    e.buf.push_str(buf);
    e.buf.push_str(", ptr ");
    e.buf.push_str(lt.a);
    e.buf.push_str(", i64 ");
    e.buf.push_str(lt.b);
    e.buf.push_str(")\n  ");
    dst = e.fresh();
    e.buf.push_str(dst);
    e.buf.push_str(" = getelementptr i8, ptr ");
    e.buf.push_str(buf);
    e.buf.push_str(", i64 ");
    e.buf.push_str(lt.b);
    e.buf.push_str("\n  call ptr @memcpy(ptr ");
    e.buf.push_str(dst);
    e.buf.push_str(", ptr ");
    e.buf.push_str(rt.a);
    e.buf.push_str(", i64 ");
    e.buf.push_str(rt.b);
    e.buf.push_str(")\n");
    return mk_str_tmp(buf, n);
}

/// 子串 [start, end)：malloc + memcpy
fn emit_str_slice(ref Val sv, ref String start, ref String end, ref mut Emitter e) -> Val {
    n = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(n);
    e.buf.push_str(" = sub i64 ");
    e.buf.push_str(end);
    e.buf.push_str(", ");
    e.buf.push_str(start);
    e.buf.push_str("\n  ");
    buf = e.fresh();
    e.buf.push_str(buf);
    e.buf.push_str(" = call ptr @malloc(i64 ");
    e.buf.push_str(n);
    e.buf.push_str(")\n  ");
    src = e.fresh();
    e.buf.push_str(src);
    e.buf.push_str(" = getelementptr i8, ptr ");
    e.buf.push_str(sv.a);
    e.buf.push_str(", i64 ");
    e.buf.push_str(start);
    e.buf.push_str("\n  call ptr @memcpy(ptr ");
    e.buf.push_str(buf);
    e.buf.push_str(", ptr ");
    e.buf.push_str(src);
    e.buf.push_str(", i64 ");
    e.buf.push_str(n);
    e.buf.push_str(")\n");
    return mk_str_tmp(buf, n);
}

impl Emitter {
    #[alloc]
    #[state]
    fn fresh(ref mut self) -> String {
        b = StringBuf::new();
        b.push_str("%t");
        b.push_int(self.tmp);
        self.tmp = self.tmp + 1;
        return b.to_string();
    }

    fn local_kind(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.lv_count {
            if self.locals[i] == name { return self.local_kinds[i]; }
            i = i + 1;
        }
        return -1;
    }

    /// 数组局部的元素类型（AST 类型节点 id）；非数组返回 -1
    fn find_elem(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.lv_count {
            if self.locals[i] == name { return self.local_etypes[i]; }
            i = i + 1;
        }
        return -1;
    }

    #[alloc]
    #[state]
    fn declare_array_local(ref mut self, ref String name, int ety) {
        self.declare_local(name, 10);
        i = 0;
        while i < self.lv_count {
            if self.locals[i] == name {
                self.local_etypes[i] = ety;
                return;
            }
            i = i + 1;
        }
    }

    #[state]
    fn record_etype(ref mut self, ref String name, int ety) {
        i = 0;
        while i < self.lv_count {
            if self.locals[i] == name {
                self.local_etypes[i] = ety;
                return;
            }
            i = i + 1;
        }
    }

    fn elem_of_local(ref mut self, ref String name) -> int {
        if self.local_kind(name) != 10 { return -1; }
        return self.find_elem(name);
    }

    fn etype_of_local(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.lv_count {
            if self.locals[i] == name {
                return self.local_etypes[i];
            }
            i = i + 1;
        }
        return -1;
    }

    /// 声明/复用局部；同名不同类型时补分配对应存储（源码里同名局部在不同分支复用不同类型）
    #[alloc]
    #[state]
    fn declare_local(ref mut self, ref String name, int kind) {
        idx_l = -1;
        i = 0;
        while i < self.lv_count {
            if self.locals[i] == name {
                idx_l = i;
                break;
            }
            i = i + 1;
        }
        form = 0;
        if kind == 1 { form = 1; } elif kind == 40 { form = 3; } elif kind >= 2 { form = 2; }
        if idx_l >= 0 {
            self.local_kinds[idx_l] = kind;
            have = self.local_forms[idx_l];
            if have == form { return; }
            self.local_forms[idx_l] = form;
            self.emit_local_storage(name, form);
            return;
        }
        if self.lv_count < 512 {
            self.locals[self.lv_count] = name.copy();
            self.local_kinds[self.lv_count] = kind;
            self.local_etypes[self.lv_count] = -1;
            self.local_forms[self.lv_count] = form;
            self.local_ftypes[self.lv_count] = -1;
            self.lv_count = self.lv_count + 1;
        }
        self.emit_local_storage(name, form);
    }

    /// 局部存储分配（写 pre_buf，最终拼到 entry 块）
    #[alloc]
    #[state]
    fn emit_local_storage(ref mut self, ref String name, int form) {
        tmp2 = StringBuf::new();
        if form == 1 {
            tmp2.push_str("  %v_");
            tmp2.push_str(name);
            tmp2.push_str(".ptr = alloca ptr\n  %v_");
            tmp2.push_str(name);
            tmp2.push_str(".len = alloca i64\n");
        } elif form == 3 {
            tmp2.push_str("  %v_");
            tmp2.push_str(name);
            tmp2.push_str(".d = alloca double\n");
        } elif form == 2 {
            tmp2.push_str("  %v_");
            tmp2.push_str(name);
            tmp2.push_str(".p = alloca ptr\n");
        } else {
            tmp2.push_str("  %v_");
            tmp2.push_str(name);
            tmp2.push_str(" = alloca i64\n");
        }
        if self.pre_active == 1 {
            self.pre_buf.push_str(tmp2.to_string());
        } else {
            self.buf.push_str(tmp2.to_string());
        }
    }

    /// struct 局部变量的类型名（kind 2 的局部）
    #[alloc]
    #[state]
    fn struct_of_local(ref mut self, ref String name) -> String {
        i = 0;
        while i < self.lv_count {
            if self.locals[i] == name {
                ety = self.local_etypes[i];
                if ety >= 0 {
                    if ety < self.st_count { return self.st_names[ety].copy(); }
                }
            }
            i = i + 1;
        }
        return "";
    }

    /// 参数类型种类：0=int/其他, 1=String(双槽), 3=数组(ptr), 20=枚举, 100+si=结构体
    #[alloc]
    #[state]
    fn param_kind(ref mut self, ref Ast ast, int p) -> int {
        pt = ast.tys[p];
        if pt < 0 { return 0; }
        // 解开 ref/ref mut 包装（记下是否为引用）
        is_ref = 0;
        while pt >= 0 {
            if ast.tags[pt] != tt(TT::Ref._tag) { break; }
            is_ref = 1;
            pt = ast.aa[pt];
        }
        if pt < 0 { return 0; }
        ptg = ast.tags[pt];
        if ptg == tt(TT::Array._tag) || ptg == tt(TT::ArraySized._tag) {
            return 3;
        }
        if ptg == tt(TT::Generic._tag) { ptg = tt(TT::Named._tag); }
        if ptg == tt(TT::Float._tag) {
            return 31;
        }
        if ptg != tt(TT::Named._tag) {
            // 原语：ref 形参按指针传（30）
            if is_ref == 1 { return 30; }
            return 0;
        }
        tn = ast.texts[pt];
        if tn == "f32" || tn == "f64" { return 31; }
        if tn == "String" { return 1; }
        ei = self.find_enum_idx(tn);
        if ei >= 0 { return 20; }
        si = self.find_struct_idx(tn);
        if si >= 0 { return 100 + si; }
        if self.find_iface_idx(tn) >= 0 { return 21; }
        if is_ref == 1 { return 30; }
        return 0;
    }

    /// 返回类型种类：0=int, 1=String, 2=struct, 3=array, 4=enum
    #[alloc]
    #[state]
    fn ret_kind(ref mut self, ref Ast ast, int rty) -> int {
        if rty < 0 { return 0; }
        while rty >= 0 {
            if ast.tags[rty] != tt(TT::Ref._tag) { break; }
            rty = ast.aa[rty];
        }
        if rty < 0 { return 0; }
        rtg = ast.tags[rty];
        if rtg == tt(TT::Array._tag) || rtg == tt(TT::ArraySized._tag) {
            return 3;
        }
        if rtg == tt(TT::Float._tag) { return 5; }
        if rtg == tt(TT::Generic._tag) { rtg = tt(TT::Named._tag); }
        if rtg != tt(TT::Named._tag) { return 0; }
        tn = ast.texts[rty];
        if tn == "f32" || tn == "f64" { return 5; }
        if tn == "String" { return 1; }
        if self.find_struct_idx(tn) >= 0 { return 2; }
        if self.find_enum_idx(tn) >= 0 { return 4; }
        if self.find_iface_idx(tn) >= 0 { return 6; }
        return 0;
    }

    /// 返回类型附加信息：struct index / array elem type / enum index
    #[alloc]
    #[state]
    fn ret_info(ref mut self, ref Ast ast, int rty) -> int {
        if rty < 0 { return -1; }
        rtg = ast.tags[rty];
        if rtg == tt(TT::Array._tag) || rtg == tt(TT::ArraySized._tag) {
            return ast.aa[rty];
        }
        if rtg == tt(TT::Generic._tag) { rtg = tt(TT::Named._tag); }
        if rtg != tt(TT::Named._tag) { return -1; }
        tn = ast.texts[rty];
        si = self.find_struct_idx(tn);
        if si >= 0 { return si; }
        ei_r = self.find_enum_idx(tn);
        if ei_r >= 0 { return ei_r; }
        return self.find_iface_idx(tn);
    }

    /// 返回 LLVM 宽度码（0=i64, 1=i32, 2=i8）
    #[alloc]
    #[state]
    fn ret_llvm_code(ref mut self, ref Ast ast, int rty) -> int {
        if rty < 0 { return 0; }
        if ast.tags[rty] != tt(TT::Named._tag) { return 0; }
        tn = ast.texts[rty];
        if tn == "i32" { return 1; }
        if tn == "i8" { return 2; }
        return 0;
    }

    /// 记录局部的 Fn 类型节点（闭包/函数值形参）
    #[state]
    fn record_ftype(ref mut self, ref String name, int fty) {
        i = 0;
        while i < self.lv_count {
            if self.locals[i] == name {
                self.local_ftypes[i] = fty;
                return;
            }
            i = i + 1;
        }
    }

    fn ftype_of_local(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.lv_count {
            if self.locals[i] == name {
                return self.local_ftypes[i];
            }
            i = i + 1;
        }
        return -1;
    }

    /// 全局下标（按名）
    fn global_idx(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.g_count {
            if self.g_names[i] == name { return i; }
            i = i + 1;
        }
        return -1;
    }

    /// extern 声明是否已存在（内置 declare 去重）
    fn decl_has(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.decl_count {
            if self.decl_names[i] == name { return 1; }
            i = i + 1;
        }
        return 0;
    }

    /// lambda AST id -> lambda 表下标
    fn lam_index_of(ref mut self, int id) -> int {
        i = 0;
        while i < self.lam_count {
            if self.lam_ids[i] == id { return i; }
            i = i + 1;
        }
        return -1;
    }

    /// 追加一个闭包捕获（同名去重）
    #[alloc]
    #[state]
    fn cap_add(ref mut self, int li, ref String name, int kind, int ety, int cid) {
        start = self.cap_start[li];
        cnt = self.cap_count[li];
        i = 0;
        while i < cnt {
            if self.cap_names[start + i] == name { return; }
            i = i + 1;
        }
        if self.cap_total >= 1024 { return; }
        if cnt >= 32 { return; }
        self.cap_names[self.cap_total] = name.copy();
        self.cap_kinds[self.cap_total] = kind;
        self.cap_etypes[self.cap_total] = ety;
        self.cap_ids[self.cap_total] = cid;
        self.cap_total = self.cap_total + 1;
        self.cap_count[li] = cnt + 1;
    }

    /// Fn 值环境块全局（去重）：@<prefix>.<code> = global [1 x ptr] [ptr @<code>]
    #[alloc]
    #[state]
    fn add_env_global(ref mut self, ref String prefix, ref String code_name) -> String {
        gname = prefix + "." + code_name;
        i = 0;
        while i < self.env_g_count {
            if self.env_g_names[i] == gname { return gname; }
            i = i + 1;
        }
        if self.env_g_count < 512 {
            self.env_g_names[self.env_g_count] = gname.copy();
            self.env_g_count = self.env_g_count + 1;
        }
        self.env_defs.push_str("@");
        self.env_defs.push_str(gname);
        self.env_defs.push_str(" = global [1 x ptr] [ptr @");
        self.env_defs.push_str(self.fn_sym(code_name));
        self.env_defs.push_str("]\n");
        return gname;
    }

    /// 赋值时记录函数值的 Fn 类型（lambda/命名函数/Fn 局部/结构体字段）
    #[alloc]
    #[state]
    fn record_assign_ftype(ref mut self, ref Ast ast, ref String nm, int rhs) {
        if self.ftype_of_local(nm) >= 0 { return; }
        tg_r = ast.tags[rhs];
        if tg_r == et(ET::Lambda._tag) {
            self.record_ftype(nm, rhs);
            return;
        }
        if tg_r == et(ET::Ident._tag) {
            rn_r = ast.texts[rhs];
            ft_r = self.ftype_of_local(rn_r);
            if ft_r >= 0 {
                self.record_ftype(nm, ft_r);
                return;
            }
            if self.fn_ret_type(rn_r) >= 0 {
                fid_r = self.fn_first_id(rn_r);
                if fid_r >= 0 { self.record_ftype(nm, fid_r); }
            }
            return;
        }
        if tg_r == et(ET::FnCall._tag) {
            rn_r2 = ast.texts[rhs];
            rt_r = self.fn_ret_type(rn_r2);
            if rt_r >= 0 {
                if ast.tags[rt_r] == tt(TT::Closure._tag) {
                    self.record_ftype(nm, rt_r);
                }
            }
            return;
        }
        if tg_r == et(ET::FieldAccess._tag) {
            ob_r = ast.aa[rhs];
            if ob_r >= 0 {
                if ast.tags[ob_r] == et(ET::Ident._tag) {
                    stn_r = self.struct_of_local(ast.texts[ob_r]);
                    si_r = self.find_struct_idx(stn_r);
                    fi_r = self.find_field_idx(stn_r, ast.texts[rhs]);
                    if si_r >= 0 && fi_r >= 0 {
                        ft_r2 = self.ftype_at(si_r, fi_r);
                        if ft_r2 >= 0 {
                            if ast.tags[ft_r2] == tt(TT::Closure._tag) {
                                self.record_ftype(nm, ft_r2);
                            }
                        }
                    }
                }
            }
            return;
        }
    }

    /// 类型节点 -> 参数种类（与 param_kind 同规则）
    #[alloc]
    #[state]
    fn pk_of_ty(ref mut self, ref Ast ast, int pt) -> int {
        if pt < 0 { return 0; }
        is_ref2 = 0;
        while pt >= 0 {
            if ast.tags[pt] != tt(TT::Ref._tag) { break; }
            is_ref2 = 1;
            pt = ast.aa[pt];
        }
        if pt < 0 { return 0; }
        ptg = ast.tags[pt];
        if ptg == tt(TT::Array._tag) || ptg == tt(TT::ArraySized._tag) { return 3; }
        if ptg == tt(TT::Float._tag) { return 31; }
        if ptg == tt(TT::Generic._tag) { ptg = tt(TT::Named._tag); }
        if ptg != tt(TT::Named._tag) {
            if is_ref2 == 1 { return 30; }
            return 0;
        }
        tn = ast.texts[pt];
        if tn == "f32" || tn == "f64" { return 31; }
        if tn == "String" { return 1; }
        ei = self.find_enum_idx(tn);
        if ei >= 0 { return 20; }
        si = self.find_struct_idx(tn);
        if si >= 0 { return 100 + si; }
        if is_ref2 == 1 { return 30; }
        return 0;
    }

    /// 闭包类型第 i 个参数的种类
    #[alloc]
    #[state]
    fn closure_param_kind(ref mut self, ref Ast ast, int fty, int i) -> int {
        p = fn_type_params(ast, fty);
        k = 0;
        while p >= 0 {
            if k == i {
                return self.pk_of_ty(ast, ast.tys[p]);
            }
            k = k + 1;
            p = ast.nexts[p];
        }
        return 0;
    }

    /// 该名首次定义的 FnDecl id（重载只发射第一个）
    fn fn_first_id(ref mut self, ref String fname) -> int {
        f = 0;
        while f < self.fn_count {
            if self.fn_names[f] == fname { return self.fn_first[f]; }
            f = f + 1;
        }
        return -1;
    }

    fn fn_ret_llvm(ref mut self, ref String fname) -> int {
        f = 0;
        while f < self.fn_count {
            if self.fn_names[f] == fname {
                return self.fn_rllvm[f];
            }
            f = f + 1;
        }
        return 0;
    }

    /// 函数返回类型节点 id（-1 未知）
    fn fn_ret_type(ref mut self, ref String fname) -> int {
        f = 0;
        while f < self.fn_count {
            if self.fn_names[f] == fname {
                return self.fn_rtype[f];
            }
            f = f + 1;
        }
        return -1;
    }

    /// 方法返回类型节点 id
    fn method_ret_type(ref mut self, ref String ty, ref String name) -> int {
        i = 0;
        while i < self.m_count {
            if self.m_ty[i] == ty {
                if self.m_name[i] == name { return self.m_rtype[i]; }
            }
            i = i + 1;
        }
        return -1;
    }

    /// 收集所有 lambda（线性扫 AST arena）
    #[alloc]
    #[state]
    /// 名字是否为该 lambda 的形参（捕获扫描排除自身形参遮蔽）
    #[alloc]
    fn lam_param_of(ref mut self, ref Ast ast, int li, ref String name) -> int {
        if li < 0 || li >= self.lam_count { return 0; }
        lid = self.lam_ids[li];
        if lid < 0 { return 0; }
        p = ast.aa[lid];
        while p >= 0 {
            if ast.texts[p] == name { return 1; }
            p = ast.nexts[p];
        }
        return 0;
    }

    fn collect_lambdas(ref mut self, ref Ast ast) {
        i = 0;
        while i < ast.len {
            if ast.tags[i] == et(ET::Lambda._tag) {
                if self.lam_count < 256 {
                    self.lam_ids[self.lam_count] = i;
                    self.lam_names[self.lam_count] = ast.texts[i].copy();
                    self.lam_count = self.lam_count + 1;
                }
            }
            i = i + 1;
        }
    }

    /// 全局常量/静态收集（顶层与 namespace 内）
    #[alloc]
    #[state]
    fn collect_globals(ref mut self, ref Ast ast, int prog) {
        s = ast.aa[prog];
        while s >= 0 {
            tag = ast.tags[s];
            if tag == st(ST::ConstDecl._tag) || tag == st(ST::StaticDecl._tag) {
                self.add_global(ast, ast.texts[s].copy(), s);
            } elif tag == st(ST::Namespace._tag) {
                self.collect_globals_ns(ast, s, "");
            }
            s = ast.nexts[s];
        }
    }

    /// namespace 内全局收集（支持嵌套：前缀逐级拼接）
    #[alloc]
    #[state]
    fn collect_globals_ns(ref mut self, ref Ast ast, int ns_id, ref String prefix) {
        ns = prefix.copy();
        if ns.len > 0 { ns = ns + "."; }
        ns = ns + ast.texts[ns_id];
        m = ast.aa[ns_id];
        while m >= 0 {
            if ast.tags[m] == st(ST::ConstDecl._tag) || ast.tags[m] == st(ST::StaticDecl._tag) {
                nm2 = ns + ".";
                nm2 = nm2 + ast.texts[m];
                self.add_global(ast, nm2, m);
            } elif ast.tags[m] == st(ST::Namespace._tag) {
                self.collect_globals_ns(ast, m, ns);
            }
            m = ast.nexts[m];
        }
    }

    /// 常量求值（可解析已注册的全局常量引用）
    #[alloc]
    #[state]
    fn const_eval_g(ref mut self, ref Ast ast, int id) -> String {
        if id < 0 { return ""; }
        tag = ast.tags[id];
        if tag == et(ET::Ident._tag) {
            return self.global_val(ast.texts[id]);
        }
        if tag == et(ET::Binary._tag) {
            lv2 = self.const_eval_g(ast, ast.aa[id]);
            rv2 = self.const_eval_g(ast, ast.bb[id]);
            if lv2.len == 0 || rv2.len == 0 { return ""; }
            // 复用纯函数：构造不了 AST，这里直接算
            a2 = str_to_int_ok(lv2);
            b2 = str_to_int_ok(rv2);
            op2 = ast.tys[id];
            r2 = -999999;
            if op2 == bo(BinOp::Add._tag) { r2 = a2 + b2; }
            elif op2 == bo(BinOp::Sub._tag) { r2 = a2 - b2; }
            elif op2 == bo(BinOp::Mul._tag) { r2 = a2 * b2; }
            elif op2 == bo(BinOp::Div._tag) { if b2 == 0 { return ""; } r2 = a2 / b2; }
            elif op2 == bo(BinOp::Mod._tag) { if b2 == 0 { return ""; } r2 = a2 % b2; }
            elif op2 == bo(BinOp::BitAnd._tag) { r2 = a2 & b2; }
            elif op2 == bo(BinOp::BitOr._tag) { r2 = a2 | b2; }
            elif op2 == bo(BinOp::BitXor._tag) { r2 = a2 ^ b2; }
            elif op2 == bo(BinOp::Shl._tag) { r2 = a2 << b2; }
            elif op2 == bo(BinOp::Shr._tag) { r2 = a2 >> b2; }
            if r2 == -999999 { return ""; }
            return int_str2(r2);
        }
        if tag == et(ET::FnCall._tag) {
            // #[compile_time] 函数：编译期解释求值
            fid = self.ct_find(ast.texts[id]);
            if fid >= 0 {
                n = 0;
                a3 = ast.aa[id];
                while a3 >= 0 {
                    av = self.const_eval_g(ast, ast.aa[a3]);
                    if av.len == 0 { return ""; }
                    if n < 16 { self.ct_args[n] = str_to_int_ok(av); }
                    n = n + 1;
                    a3 = ast.nexts[a3];
                }
                r3 = ct_call(ast, fid, n, self);
                if r3 == -999999 { return ""; }
                return int_str2(r3);
            }
        }
        return const_int(ast, id);
    }

    /// 常量求值环境读写
    #[alloc]
    #[state]
    fn ct_set(ref mut self, ref String name, int v) {
        // 同帧内更新已有绑定；跨帧（递归/嵌套调用）追加，查找取最内层
        i = self.ct_frame;
        while i < self.ct_env_count {
            if self.ct_env_names[i] == name {
                self.ct_env_vals[i] = v;
                return;
            }
            i = i + 1;
        }
        if self.ct_env_count < 256 {
            self.ct_env_names[self.ct_env_count] = name.copy();
            self.ct_env_vals[self.ct_env_count] = v;
            self.ct_env_count = self.ct_env_count + 1;
        }
    }

    fn ct_get(ref mut self, ref String name) -> int {
        i = self.ct_env_count - 1;
        while i >= 0 {
            if self.ct_env_names[i] == name { return self.ct_env_vals[i]; }
            i = i - 1;
        }
        return -999999;
    }

    fn ct_find(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.ct_count {
            if self.ct_names[i] == name { return self.ct_ids[i]; }
            i = i + 1;
        }
        return -1;
    }

    #[alloc]
    #[state]
    fn add_global(ref mut self, ref Ast ast, ref String name, int id) {
        if self.g_count >= 512 { return; }
        init = ast.aa[id];
        // 浮点字面量（含 f32/f64 后缀）
        if init >= 0 {
            if ast.tags[init] == et(ET::Literal._tag) && ast.bb[init] == lk(LK::Float._tag) {
                self.g_names[self.g_count] = name.copy();
                self.g_kinds[self.g_count] = 3;
                self.g_vals[self.g_count] = float_text(ast.texts[init]);
                self.g_lens[self.g_count] = 0;
                self.g_count = self.g_count + 1;
                return;
            }
            if ast.tags[init] == et(ET::Suffixed._tag) {
                sfx = ast.texts[init];
                if sfx == "f32" || sfx == "f64" {
                    self.g_names[self.g_count] = name.copy();
                    self.g_kinds[self.g_count] = 3;
                    self.g_vals[self.g_count] = float_text(ast.texts[ast.aa[init]]);
                    self.g_lens[self.g_count] = 0;
                    self.g_count = self.g_count + 1;
                    return;
                }
            }
        }
        if init >= 0 {
            if ast.tags[init] == et(ET::StructLiteral._tag) {
                // 结构体全局：global i64（堆指针）+ 启动初始化
                si_g = self.find_struct_idx(ast.texts[init]);
                if si_g >= 0 {
                    self.g_names[self.g_count] = name.copy();
                    self.g_kinds[self.g_count] = 4;
                    self.g_vals[self.g_count] = "";
                    self.g_lens[self.g_count] = 0;
                    self.g_init_ids[self.g_count] = init;
                    self.g_stype[self.g_count] = si_g;
                    self.g_count = self.g_count + 1;
                    self.need_ginit = 1;
                    return;
                }
            }
        }
        v = self.const_eval_g(ast, init);
        if v.len > 0 {
            self.g_names[self.g_count] = name.copy();
            self.g_kinds[self.g_count] = 0;
            self.g_vals[self.g_count] = v.copy();
            self.g_lens[self.g_count] = 0;
            self.g_count = self.g_count + 1;
            return;
        }
        if init >= 0 {
            tg = ast.tags[init];
            if tg == et(ET::ArrayLiteral._tag) {
                b = StringBuf::new();
                n = 0;
                first = 1;
                el = ast.aa[init];
                while el >= 0 {
                    ev = const_int(ast, el);
                    if ev.len == 0 { return; }
                    if first == 0 { b.push(','); }
                    b.push_str(ev);
                    first = 0;
                    n = n + 1;
                    el = ast.nexts[el];
                }
                if n == 0 { return; }
                self.g_names[self.g_count] = name.copy();
                self.g_kinds[self.g_count] = 2;
                self.g_vals[self.g_count] = b.to_string();
                self.g_lens[self.g_count] = n;
                self.g_count = self.g_count + 1;
                return;
            }
            if tg == et(ET::ArrayRepeat._tag) {
                ev2 = const_int(ast, ast.aa[init]);
                cnt2 = const_int(ast, ast.bb[init]);
                if ev2.len == 0 || cnt2.len == 0 { return; }
                cn = 0;
                okc = 1;
                q = 0;
                while q < cnt2.len as int {
                    ch = cnt2.index(q as usize);
                    if ch < '0' || ch > '9' { okc = 0; break; }
                    cn = cn * 10 + (char_code(ch) - 48);
                    q = q + 1;
                }
                if okc == 0 || cn == 0 || cn > 4096 { return; }
                b2 = StringBuf::new();
                k = 0;
                while k < cn {
                    if k > 0 { b2.push(','); }
                    b2.push_str(ev2);
                    k = k + 1;
                }
                self.g_names[self.g_count] = name.copy();
                self.g_kinds[self.g_count] = 2;
                self.g_vals[self.g_count] = b2.to_string();
                self.g_lens[self.g_count] = cn;
                self.g_count = self.g_count + 1;
                return;
            }
        }
    }

    fn global_kind(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.g_count {
            if self.g_names[i] == name { return self.g_kinds[i]; }
            i = i + 1;
        }
        return -1;
    }

    #[alloc]
    #[state]
    fn global_val(ref mut self, ref String name) -> String {
        i = 0;
        while i < self.g_count {
            if self.g_names[i] == name { return self.g_vals[i].copy(); }
            i = i + 1;
        }
        return "";
    }

    fn find_struct_idx(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.st_count {
            if self.st_names[i] == name { return i; }
            i = i + 1;
        }
        return -1;
    }

    fn find_field_idx(ref mut self, ref String stname, ref String fname) -> int {
        si = self.find_struct_idx(stname);
        if si < 0 { return -1; }
        start = self.st_fstart[si];
        n = self.st_fcount[si];
        i = 0;
        while i < n {
            if self.st_fields[start + i] == fname { return i; }
            i = i + 1;
        }
        return -1;
    }

    fn fkind_at(ref mut self, int si, int idx) -> int {
        if si < 0 { return 0; }
        return self.st_fkind[self.st_fstart[si] + idx];
    }

    fn finfo_at(ref mut self, int si, int idx) -> int {
        if si < 0 { return -1; }
        return self.st_finfo[self.st_fstart[si] + idx];
    }

    fn fslot_at(ref mut self, int si, int idx) -> int {
        if si < 0 { return idx; }
        return self.st_fslot[self.st_fstart[si] + idx];
    }

    fn ftype_at(ref mut self, int si, int idx) -> int {
        if si < 0 { return -1; }
        return self.st_ftype[self.st_fstart[si] + idx];
    }

    fn find_method_id(ref mut self, ref String ty, ref String name) -> int {
        i = 0;
        while i < self.m_count {
            if self.m_ty[i] == ty {
                if self.m_name[i] == name { return self.m_id[i]; }
            }
            i = i + 1;
        }
        return -1;
    }

    #[alloc]
    #[state]
    /// 登记接口名与方法表（vtable 布局 = 接口方法声明顺序）
    #[alloc]
    #[state]
    fn reg_iface(ref mut self, ref Ast ast, int id) {
        if self.if_count >= 128 { return; }
        if self.find_iface_idx(ast.texts[id]) >= 0 { return; }
        self.if_names[self.if_count] = ast.texts[id].copy();
        self.if_mstart[self.if_count] = self.if_mtotal;
        n = 0;
        m = ast.aa[id];
        while m >= 0 {
            if ast.tags[m] == st(ST::FnDecl._tag) {
                if self.if_mtotal < 512 {
                    self.if_mnames[self.if_mtotal] = ast.texts[m].copy();
                    self.if_mnode[self.if_mtotal] = m;
                    self.if_mtotal = self.if_mtotal + 1;
                    n = n + 1;
                }
            }
            m = ast.nexts[m];
        }
        self.if_mcount[self.if_count] = n;
        self.if_count = self.if_count + 1;
    }

    /// 接口方法下标（无 -> -1）
    fn iface_method_idx(ref mut self, int ii, ref String name) -> int {
        if ii < 0 || ii >= self.if_count { return -1; }
        s0 = self.if_mstart[ii];
        e0 = s0 + self.if_mcount[ii];
        i = s0;
        while i < e0 {
            if self.if_mnames[i] == name { return i - s0; }
            i = i + 1;
        }
        return -1;
    }

    /// 接口方法声明节点
    fn iface_method_node_at(ref mut self, int ii, int mi) -> int {
        if ii < 0 || ii >= self.if_count { return -1; }
        s0 = self.if_mstart[ii];
        if mi < 0 || mi >= self.if_mcount[ii] { return -1; }
        return self.if_mnode[s0 + mi];
    }

    /// 接口方法第 i 个形参的种类（含 self，0 基）
    #[alloc]
    fn iface_param_kind(ref mut self, ref Ast ast, int mnode, int i) -> int {
        if mnode < 0 { return -1; }
        p = ast.aa[mnode];
        k = 0;
        while p >= 0 {
            if k == i { return self.param_kind(ast, p); }
            k = k + 1;
            p = ast.nexts[p];
        }
        return -1;
    }

    /// 接口方法第 i 个形参的类型名（含 self，0 基）
    #[alloc]
    fn iface_param_name(ref mut self, ref Ast ast, int mnode, int i) -> String {
        if mnode < 0 { return ""; }
        p = ast.aa[mnode];
        k = 0;
        while p >= 0 {
            if k == i { return ty_name(ast, ast.tys[p]); }
            k = k + 1;
            p = ast.nexts[p];
        }
        return "";
    }

    /// 函数形参的接口下标（+1；0 = 非接口）
    fn fn_piface_of(ref mut self, ref String fname, int i) -> int {
        f = 0;
        while f < self.fn_count {
            if self.fn_names[f] == fname {
                if i < self.fn_pcount[f] { return self.fn_piface[self.fn_pstart[f] + i]; }
                return 0;
            }
            f = f + 1;
        }
        return 0;
    }

    /// 类型是否实现了接口全部方法
    #[alloc]
    fn type_impls_iface(ref mut self, ref String ty, int ii) -> int {
        if ii < 0 || ii >= self.if_count { return 0; }
        s0 = self.if_mstart[ii];
        e0 = s0 + self.if_mcount[ii];
        if e0 == s0 { return 0; }
        i = s0;
        while i < e0 {
            if self.find_method_id(ty, self.if_mnames[i]) < 0 { return 0; }
            i = i + 1;
        }
        return 1;
    }

    /// 具体值 -> impl 表类型名（原语按候选名找实现了接口全部方法的）
    #[alloc]
    #[state]
    fn concrete_impl_name(ref mut self, ref Val v, ref String iface) -> String {
        if v.kind == 2 || v.kind == 4 { return v.b.copy(); }
        ii = self.find_iface_idx(iface);
        if ii < 0 { return ""; }
        if v.kind == 1 {
            if self.type_impls_iface("String", ii) == 1 { return "String"; }
            return "";
        }
        if v.kind == 6 {
            fn_c = ["float", "f64", "f32"];
            i6 = 0;
            while i6 < 3 {
                if self.type_impls_iface(fn_c[i6], ii) == 1 { return fn_c[i6].copy(); }
                i6 = i6 + 1;
            }
            return "";
        }
        if v.kind == 0 {
            in_c = ["int", "i64", "i32", "usize", "u32", "u64", "char", "bool", "i8", "u8", "i16", "u16"];
            i0 = 0;
            while i0 < 12 {
                if self.type_impls_iface(in_c[i0], ii) == 1 { return in_c[i0].copy(); }
                i0 = i0 + 1;
            }
        }
        return "";
    }

    /// 装箱：具体值 -> 接口值 box {data, vtable}（返回 box 指针）
    #[alloc]
    #[state]
    fn emit_box(ref mut self, ref Val v, ref String iface) -> String {
        data = v.a.copy();
        if v.kind == 0 {
            c0 = self.fresh();
            self.buf.push_str("  ");
            self.buf.push_str(c0);
            self.buf.push_str(" = call ptr @malloc(i64 8)\n  store i64 ");
            self.buf.push_str(v.a);
            self.buf.push_str(", ptr ");
            self.buf.push_str(c0);
            self.buf.push_str("\n");
            data = c0.copy();
        } elif v.kind == 6 {
            c6 = self.fresh();
            self.buf.push_str("  ");
            self.buf.push_str(c6);
            self.buf.push_str(" = call ptr @malloc(i64 8)\n  store double ");
            self.buf.push_str(v.a);
            self.buf.push_str(", ptr ");
            self.buf.push_str(c6);
            self.buf.push_str("\n");
            data = c6.copy();
        } elif v.kind == 1 {
            c1 = self.fresh();
            self.buf.push_str("  ");
            self.buf.push_str(c1);
            self.buf.push_str(" = call ptr @malloc(i64 16)\n  store ptr ");
            self.buf.push_str(v.a);
            self.buf.push_str(", ptr ");
            self.buf.push_str(c1);
            self.buf.push_str("\n  ");
            c1b = self.fresh();
            self.buf.push_str(c1b);
            self.buf.push_str(" = getelementptr i8, ptr ");
            self.buf.push_str(c1);
            self.buf.push_str(", i64 8\n  store i64 ");
            self.buf.push_str(v.b);
            self.buf.push_str(", ptr ");
            self.buf.push_str(c1b);
            self.buf.push_str("\n");
            data = c1.copy();
        }
        bx = self.fresh();
        self.buf.push_str("  ");
        self.buf.push_str(bx);
        self.buf.push_str(" = call ptr @malloc(i64 16)\n  store ptr ");
        self.buf.push_str(data);
        self.buf.push_str(", ptr ");
        self.buf.push_str(bx);
        self.buf.push_str("\n  ");
        bx8 = self.fresh();
        self.buf.push_str(bx8);
        self.buf.push_str(" = getelementptr i8, ptr ");
        self.buf.push_str(bx);
        self.buf.push_str(", i64 8\n");
        tn = self.concrete_impl_name(v, iface);
        if tn.len > 0 && iface.len > 0 {
            self.reg_vtable(tn, iface);
            self.buf.push_str("  store ptr @vtable.");
            self.buf.push_str(tn);
            self.buf.push_str(".");
            self.buf.push_str(iface);
            self.buf.push_str(", ptr ");
            self.buf.push_str(bx8);
            self.buf.push_str("\n");
        } else {
            self.buf.push_str("  store ptr null, ptr ");
            self.buf.push_str(bx8);
            self.buf.push_str("\n");
        }
        return bx;
    }

    /// 登记 (类型, 接口) vtable 对（去重）
    #[alloc]
    #[state]
    fn reg_vtable(ref mut self, ref String ty, ref String iface) {
        pn = ty + ".";
        pn = pn + iface;
        i = 0;
        while i < self.vt_count {
            if self.vt_pairs[i] == pn { return; }
            i = i + 1;
        }
        if self.vt_count < 512 {
            self.vt_pairs[self.vt_count] = pn.copy();
            self.vt_count = self.vt_count + 1;
        }
    }

    /// 发射已登记的 vtable 全局
    #[alloc]
    #[state]
    fn emit_vtables(ref mut self) {
        i = 0;
        while i < self.vt_count {
            pn = self.vt_pairs[i];
            d = -1;
            j = 0;
            while j < pn.len as int {
                if pn.index(j as usize) == '.' { d = j; break; }
                j = j + 1;
            }
            if d >= 0 {
                ty = pn.substring(0 as usize, d as usize);
                ifn = pn.substring((d + 1) as usize, pn.len);
                ii = self.find_iface_idx(ifn);
                if ii >= 0 && self.type_impls_iface(ty, ii) == 1 {
                    n2 = self.if_mcount[ii];
                    self.vt_defs.push_str("@vtable.");
                    self.vt_defs.push_str(pn);
                    self.vt_defs.push_str(" = global [");
                    self.vt_defs.push_int(n2);
                    self.vt_defs.push_str(" x ptr] [");
                    k = 0;
                    while k < n2 {
                        mn = self.if_mnames[self.if_mstart[ii] + k];
                        if k > 0 { self.vt_defs.push_str(", "); }
                        full = ty + ".";
                        full = full + mn;
                        self.vt_defs.push_str("ptr @");
                        self.vt_defs.push_str(self.fn_sym(full));
                        k = k + 1;
                    }
                    self.vt_defs.push_str("]\n");
                }
            }
            i = i + 1;
        }
    }

    fn find_iface_idx(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.if_count {
            if self.if_names[i] == name { return i; }
            i = i + 1;
        }
        return -1;
    }

    /// 方法 id -> impl 类型名
    #[alloc]
    fn method_ty_of(ref mut self, int mid) -> String {
        i = 0;
        while i < self.m_count {
            if self.m_id[i] == mid { return self.m_ty[i].copy(); }
            i = i + 1;
        }
        return "";
    }

    /// 按方法名在 impl 表里查（接口静态派发；多实现时取第一个）
    #[alloc]
    fn find_method_any(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.m_count {
            if self.m_name[i] == name { return self.m_id[i]; }
            i = i + 1;
        }
        return -1;
    }

    fn reg_struct(ref mut self, ref Ast ast, int id) {
        if self.st_count >= 128 { return; }
        // 同名去重
        if self.find_struct_idx(ast.texts[id]) >= 0 { return; }
        si = self.st_count;
        self.st_names[si] = ast.texts[id].copy();
        self.st_fstart[si] = self.st_ftotal;
        self.st_fcount[si] = 0;
        self.st_slots[si] = 0;
        self.st_count = si + 1;
    }

    #[alloc]
    #[state]
    fn fill_struct(ref mut self, ref Ast ast, int id) {
        si = self.find_struct_idx(ast.texts[id]);
        if si < 0 { return; }
        self.st_fstart[si] = self.st_ftotal;
        n = 0;
        slot = 0;
        f = ast.aa[id];
        while f >= 0 {
            if self.st_ftotal < 1024 {
                self.st_fields[self.st_ftotal] = ast.texts[f].copy();
                fk = 0;
                finfo = -1;
                fty = ast.tys[f];
                if fty >= 0 {
                    ftag = ast.tags[fty];
                    if ftag == tt(TT::Float._tag) {
                        fk = 5;
                    } elif ftag == tt(TT::Array._tag) || ftag == tt(TT::ArraySized._tag) {
                        fk = 3;
                        finfo = ast.aa[fty];
                    } elif ftag == tt(TT::Named._tag) || ftag == tt(TT::Generic._tag) {
                        tn = ast.texts[fty];
                        if tn == "f32" || tn == "f64" {
                            fk = 5;
                        } elif tn == "String" {
                            fk = 1;
                        } else {
                            ii2 = self.find_iface_idx(tn);
                            si2 = self.find_struct_idx(tn);
                            if ii2 >= 0 {
                                fk = 6;
                                finfo = ii2;
                            } elif si2 >= 0 {
                                fk = 2;
                                finfo = si2;
                            } else {
                                ei2 = self.find_enum_idx(tn);
                                if ei2 >= 0 {
                                    fk = 4;
                                    finfo = ei2;
                                }
                            }
                        }
                    }
                }
                self.st_fkind[self.st_ftotal] = fk;
                self.st_finfo[self.st_ftotal] = finfo;
                self.st_fslot[self.st_ftotal] = slot;
                self.st_ftype[self.st_ftotal] = fty;
                if fk == 1 { slot = slot + 2; } else { slot = slot + 1; }
                self.st_ftotal = self.st_ftotal + 1;
                n = n + 1;
            }
            f = ast.nexts[f];
        }
        self.st_fcount[si] = n;
        self.st_slots[si] = slot;
    }

    #[alloc]
    #[state]
    fn add_method(ref mut self, ref Ast ast, ref String ty, int fid) {
        if self.m_count >= 4096 { return; }
        self.m_ty[self.m_count] = ty.copy();
        self.m_name[self.m_count] = ast.texts[fid].copy();
        self.m_id[self.m_count] = fid;
        self.m_rtype[self.m_count] = ast.tys[fid];
        self.m_count = self.m_count + 1;
    }

    #[alloc]
    #[state]
    fn find_enum_idx(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.en_count {
            if self.en_names[i] == name { return i; }
            i = i + 1;
        }
        return -1;
    }

    fn find_variant_idx(ref mut self, int ei, ref String vname) -> int {
        start = self.en_vstart[ei];
        n = self.en_vcount[ei];
        i = 0;
        while i < n {
            if self.en_variants[start + i] == vname { return i; }
            i = i + 1;
        }
        return -1;
    }

    fn enum_max_arity(ref mut self, int ei) -> int {
        start = self.en_vstart[ei];
        n = self.en_vcount[ei];
        mx = 0;
        i = 0;
        while i < n {
            if self.en_vslots[start + i] > mx { mx = self.en_vslots[start + i]; }
            i = i + 1;
        }
        return mx;
    }

    /// 变体第 k 个载荷的类型节点 id（-1 未知）
    fn variant_ptype(ref mut self, int ei, int vi, int k) -> int {
        idx = self.en_vstart[ei] + vi;
        if k >= self.en_arity[idx] { return -1; }
        return self.en_ptype[self.en_pvstart[idx] + k];
    }

    /// 变体第 k 个载荷的槽位偏移（1 起，tag 占 0）
    #[alloc]
    #[state]
    fn payload_slot(ref mut self, ref Ast ast, int ei, int vi, int k) -> int {
        idx = self.en_vstart[ei] + vi;
        off = 1;
        i = 0;
        while i < k {
            pty = self.en_ptype[self.en_pvstart[idx] + i];
            if ty_name(ast, pty) == "String" {
                off = off + 2;
            } else {
                off = off + 1;
            }
            i = i + 1;
        }
        return off;
    }

    #[alloc]
    #[state]
    fn add_enum(ref mut self, ref Ast ast, int id) {
        if self.en_count >= 128 { return; }
        // 同名去重（prelude 与 std 合并时 Option/Result 会重复定义）
        if self.find_enum_idx(ast.texts[id]) >= 0 { return; }
        ei = self.en_count;
        self.en_names[ei] = ast.texts[id].copy();
        self.en_vstart[ei] = self.en_vtotal;
        n = 0;
        v = ast.aa[id];
        while v >= 0 {
            if self.en_vtotal < 1024 {
                self.en_variants[self.en_vtotal] = ast.texts[v].copy();
                self.en_arity[self.en_vtotal] = ast.tys[v];
                self.en_pvstart[self.en_vtotal] = self.en_ptotal;
                slots = 0;
                pa = ast.aa[v];
                while pa >= 0 {
                    if self.en_ptotal < 4096 {
                        pty = ast.tys[pa];
                        self.en_ptype[self.en_ptotal] = pty;
                        self.en_ptotal = self.en_ptotal + 1;
                        if ty_name(ast, pty) == "String" {
                            slots = slots + 2;
                        } else {
                            slots = slots + 1;
                        }
                    }
                    pa = ast.nexts[pa];
                }
                self.en_vslots[self.en_vtotal] = slots;
                self.en_vtotal = self.en_vtotal + 1;
                n = n + 1;
            }
            v = ast.nexts[v];
        }
        self.en_vcount[ei] = n;
        self.en_count = ei + 1;
    }

    #[alloc]
    #[state]
    /// 记录函数签名（参数种类）
    #[alloc]
    #[state]
    fn add_fn_sig(ref mut self, ref Ast ast, int id, ref String prefix) {
        if self.fn_count >= 4096 { return; }
        fi = self.fn_count;
        name = ast.texts[id].copy();
        if prefix.len > 0 {
            name = prefix + ".";
            name = name + ast.texts[id];
        }
        self.fn_names[fi] = name.copy();
        self.fn_extern[fi] = 0;
        if ast.dd[id] == 1 { self.fn_extern[fi] = 1; }
        self.fn_first[fi] = id;
        if (ast.dd[id] / 131072) % 2 == 1 {
            if self.ct_count < 256 {
                self.ct_names[self.ct_count] = name.copy();
                self.ct_ids[self.ct_count] = id;
                self.ct_count = self.ct_count + 1;
            }
        }
        self.fn_pstart[fi] = self.fn_ptotal;
        n = 0;
        p = ast.aa[id];
        while p >= 0 {
            if self.fn_ptotal < 32768 {
                pki = self.param_kind(ast, p);
                self.fn_pkinds[self.fn_ptotal] = pki;
                if pki == 21 {
                    pn_if = ty_name(ast, ast.tys[p]);
                    ii_if = self.find_iface_idx(pn_if);
                    if ii_if >= 0 { self.fn_piface[self.fn_ptotal] = ii_if + 1; }
                }
                self.fn_ptotal = self.fn_ptotal + 1;
                n = n + 1;
            }
            p = ast.nexts[p];
        }
        self.fn_pcount[fi] = n;
        self.fn_rtype[fi] = ast.tys[id];
        // 只有 extern 声明才按声明宽度调用（普通函数定义统一 i64）
        self.fn_rllvm[fi] = 0;
        if ast.dd[id] == 1 {
            self.fn_rllvm[fi] = self.ret_llvm_code(ast, ast.tys[id]);
        }
        self.fn_count = fi + 1;
    }

    /// Ayanami 函数符号：非 extern 加 `aya.` 前缀（避免与 libc 重名；extern 保持裸名）
    #[alloc]
    fn fn_sym(ref mut self, ref String fname) -> String {
        if fname == "main" { return fname.copy(); }
        i = 0;
        while i < self.fn_count {
            if self.fn_names[i] == fname {
                if self.fn_extern[i] == 1 { return fname.copy(); }
                return "aya." + fname;
            }
            i = i + 1;
        }
        return "aya." + fname;
    }

    /// 元素槽类型（表感知）：未知 Named（泛型参数 T 等）按 i64，与 param_kind 一致
    #[alloc]
    fn elem_llvm_m(ref mut self, ref Ast ast, int ety) -> String {
        // 精确哨兵（2000-2002）直接走原逻辑；合成 id 为负值不在此列
        if ety == 2000 || ety == 2001 || ety == 2002 { return elem_llvm(ast, ety); }
        if ety >= 0 {
            tg = ast.tags[ety];
            if tg == tt(TT::Named._tag) || tg == tt(TT::Generic._tag) {
                tn = ast.texts[ety];
                if tn != "String" && tn != "f32" && tn != "f64" {
                    if self.find_struct_idx(tn) < 0 {
                        if self.find_enum_idx(tn) < 0 {
                            if self.find_iface_idx(tn) < 0 {
                                return "i64";
                            }
                        }
                    }
                }
            }
        }
        return elem_llvm(ast, ety);
    }

    fn fn_param_kind(ref mut self, ref String fname, int i) -> int {
        f = 0;
        while f < self.fn_count {
            if self.fn_names[f] == fname {
                if i < self.fn_pcount[f] {
                    return self.fn_pkinds[self.fn_pstart[f] + i];
                }
                return 0;
            }
            f = f + 1;
        }
        return 0;
    }

    #[alloc]
    #[state]
    fn collect_decls(ref mut self, ref Ast ast, int prog) {
        // 第一遍：结构体名（字段引用需全部名字就绪）
        s = ast.aa[prog];
        while s >= 0 {
            if ast.tags[s] == st(ST::StructDef._tag) {
                self.reg_struct(ast, s);
            } elif ast.tags[s] == st(ST::EnumDef._tag) {
                self.add_enum(ast, s);
            } elif ast.tags[s] == st(ST::InterfaceDef._tag) {
                self.reg_iface(ast, s);
            } elif ast.tags[s] == st(ST::Namespace._tag) {
                m2 = ast.aa[s];
                while m2 >= 0 {
                    if ast.tags[m2] == st(ST::StructDef._tag) {
                        self.reg_struct(ast, m2);
                    } elif ast.tags[m2] == st(ST::EnumDef._tag) {
                        self.add_enum(ast, m2);
                    }
                    m2 = ast.nexts[m2];
                }
            }
            s = ast.nexts[s];
        }
        // 第二遍：结构体字段
        s = ast.aa[prog];
        while s >= 0 {
            if ast.tags[s] == st(ST::StructDef._tag) {
                self.fill_struct(ast, s);
            } elif ast.tags[s] == st(ST::Namespace._tag) {
                m2 = ast.aa[s];
                while m2 >= 0 {
                    if ast.tags[m2] == st(ST::StructDef._tag) {
                        self.fill_struct(ast, m2);
                    }
                    m2 = ast.nexts[m2];
                }
            }
            s = ast.nexts[s];
        }
        // 第三遍：枚举 + 函数/方法签名
        s = ast.aa[prog];
        while s >= 0 {
            if ast.tags[s] == st(ST::ImplBlock._tag) {
                m = ast.aa[s];
                while m >= 0 {
                    if ast.tags[m] == st(ST::FnDecl._tag) {
                        self.add_method(ast, ast.texts[s], m);
                        self.add_fn_sig(ast, m, ast.texts[s]);
                    }
                    m = ast.nexts[m];
                }
            } elif ast.tags[s] == st(ST::FnDecl._tag) {
                self.add_fn_sig(ast, s, "");
            } elif ast.tags[s] == st(ST::Namespace._tag) {
                ns = ast.texts[s].copy();
                m2 = ast.aa[s];
                while m2 >= 0 {
                    if ast.tags[m2] == st(ST::FnDecl._tag) {
                        self.add_fn_sig(ast, m2, ns);
                    }
                    m2 = ast.nexts[m2];
                }
            }
            s = ast.nexts[s];
        }
    }

    /// 注册字符串字面量，返回全局名与长度（存入 strs）
    #[alloc]
    #[state]
    fn add_str(ref mut self, ref String text) -> int {
        idx = self.str_count;
        if idx < 8192 {
            self.strs[idx] = text.copy();
            self.str_count = idx + 1;
        }
        return idx;
    }
}

/// LLVM c"..." 转义（UTF-8 字节）
fn escape_ir(ref String s) -> String {
    b = StringBuf::new();
    i = 0;
    while i < s.len as int {
        c = char_code(s.index(i as usize));
        if c == 34 {
            b.push_str("\\22");
        } elif c == 92 {
            b.push_str("\\5c");
        } elif c == 10 {
            b.push_str("\\0a");
        } elif c == 13 {
            b.push_str("\\0d");
        } elif c == 9 {
            b.push_str("\\09");
        } elif c >= 32 && c <= 126 {
            b.push(c as char);
        } else {
            b.push_str("\\");
            h = c / 16;
            l = c % 16;
            b.push(hex_digit(h));
            b.push(hex_digit(l));
        }
        i = i + 1;
    }
    return b.to_string();
}

fn hex_digit(int v) -> char {
    if v < 10 { return (48 + v) as char; }
    return (87 + v) as char;
}

fn bin_llvm_op(int op) -> String {
    if op == bo(BinOp::Add._tag) { return "add"; }
    if op == bo(BinOp::Sub._tag) { return "sub"; }
    if op == bo(BinOp::Mul._tag) { return "mul"; }
    if op == bo(BinOp::Div._tag) { return "sdiv"; }
    if op == bo(BinOp::Mod._tag) { return "srem"; }
    if op == bo(BinOp::BitAnd._tag) { return "and"; }
    if op == bo(BinOp::BitOr._tag) { return "or"; }
    if op == bo(BinOp::BitXor._tag) { return "xor"; }
    if op == bo(BinOp::Shl._tag) { return "shl"; }
    if op == bo(BinOp::Shr._tag) { return "ashr"; }
    return "";
}

/// 运算符 -> 重载方法名（对应 rust binary_op_to_fn_name）
fn op_method_name(int op) -> String {
    if op == bo(BinOp::Add._tag) { return "add"; }
    if op == bo(BinOp::Sub._tag) { return "sub"; }
    if op == bo(BinOp::Mul._tag) { return "mul"; }
    if op == bo(BinOp::Div._tag) { return "div"; }
    if op == bo(BinOp::Mod._tag) { return "rem"; }
    if op == bo(BinOp::Eq._tag) { return "eq"; }
    if op == bo(BinOp::Neq._tag) { return "ne"; }
    if op == bo(BinOp::Lt._tag) { return "lt"; }
    if op == bo(BinOp::Gt._tag) { return "gt"; }
    if op == bo(BinOp::Le._tag) { return "le"; }
    if op == bo(BinOp::Ge._tag) { return "ge"; }
    if op == bo(BinOp::BitAnd._tag) { return "bitand"; }
    if op == bo(BinOp::BitOr._tag) { return "bitor"; }
    if op == bo(BinOp::BitXor._tag) { return "bitxor"; }
    if op == bo(BinOp::Shl._tag) { return "shl"; }
    if op == bo(BinOp::Shr._tag) { return "shr"; }
    return "";
}

/// 运算符重载：obj OP arg -> Type.method(obj, arg) 直接调用
#[alloc]
fn emit_op_method_call(ref Ast ast, int id, ref Val lt, ref String mn, int mid, ref mut Emitter e) -> Val {
    mname = lt.b + "." + mn;
    rty_m = ast.tys[mid];
    rk_m = e.ret_kind(ast, rty_m);
    b = StringBuf::new();
    b.push_str("  ");
    t = e.fresh();
    b.push_str(t);
    if rk_m == 1 {
        b.push_str(" = call { ptr, i64 } ");
    } elif rk_m == 5 {
        b.push_str(" = call double ");
    } else {
        b.push_str(" = call i64 ");
    }
    b.push_str("@");
    b.push_str(e.fn_sym(mname));
    b.push_str("(ptr ");
    b.push_str(lt.a);
    at = emit_expr(ast, ast.bb[id], e);
    pk = e.fn_param_kind(mname, 0);
    if pk == 1 {
        b.push_str(", ptr ");
        b.push_str(at.a);
        b.push_str(", i64 ");
        b.push_str(at.b);
    } elif pk == 31 {
        b.push_str(", double ");
        b.push_str(at.a);
    } elif pk == 0 {
        b.push_str(", i64 ");
        b.push_str(at.a);
    } else {
        b.push_str(", ptr ");
        b.push_str(at.a);
    }
    b.push_str(")\n");
    e.buf.push_str(b.to_string());
    if rk_m == 1 {
        ip = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(ip);
        e.buf.push_str(" = extractvalue { ptr, i64 } ");
        e.buf.push_str(t);
        e.buf.push_str(", 0\n  ");
        il = e.fresh();
        e.buf.push_str(il);
        e.buf.push_str(" = extractvalue { ptr, i64 } ");
        e.buf.push_str(t);
        e.buf.push_str(", 1\n");
        return mk_str_tmp(ip, il);
    }
    if rk_m == 5 { return mk_float(t); }
    if rk_m == 2 {
        pi = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(pi);
        e.buf.push_str(" = inttoptr i64 ");
        e.buf.push_str(t);
        e.buf.push_str(" to ptr\n");
        return Val { kind = 2, a = pi, b = ty_name(ast, rty_m).copy(), ty = -1 };
    }
    if rk_m == 4 {
        pi2 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(pi2);
        e.buf.push_str(" = inttoptr i64 ");
        e.buf.push_str(t);
        e.buf.push_str(" to ptr\n");
        return Val { kind = 4, a = pi2, b = ty_name(ast, rty_m).copy(), ty = -1 };
    }
    if rk_m == 3 {
        pi3 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(pi3);
        e.buf.push_str(" = inttoptr i64 ");
        e.buf.push_str(t);
        e.buf.push_str(" to ptr\n");
        return mk_arr(pi3, e.ret_info(ast, rty_m));
    }
    return mk_int(t);
}

/// UFCS 回退：同名自由函数且首参类型名 == recv_ty
#[alloc]
fn find_fn_by_recv(ref mut Emitter e, ref Ast ast, ref String name, ref String recv_ty) -> int {
    i = 0;
    while i < e.fn_count {
        if e.fn_names[i] == name {
            fid = e.fn_first[i];
            if fid >= 0 {
                p0 = ast.aa[fid];
                if p0 >= 0 {
                    pn = ty_name(ast, ast.tys[p0]);
                    if pn == recv_ty { return i; }
                }
            }
        }
        i = i + 1;
    }
    return -1;
}

/// UFCS 调用：自由函数（接收者作首参）
#[alloc]
#[state]
fn emit_ufcs_call(ref Ast ast, int id, ref Val obj, ref String name, ref mut Emitter e) -> Val {
    full = name.copy();
    mrty = e.fn_ret_type(full);
    rk_m = e.ret_kind(ast, mrty);
    b = StringBuf::new();
    b.push_str("  ");
    t = e.fresh();
    b.push_str(t);
    if rk_m == 5 {
        b.push_str(" = call double @");
    } elif rk_m == 1 {
        b.push_str(" = call { ptr, i64 } @");
    } else {
        b.push_str(" = call i64 @");
    }
    b.push_str(e.fn_sym(full));
    pkc = e.fn_param_kind(full, 0);
    if pkc == 0 {
        b.push_str("(i64 ");
        b.push_str(obj.a);
    } elif pkc == 30 {
        tp0 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(tp0);
        e.buf.push_str(" = alloca i64\n  store i64 ");
        e.buf.push_str(obj.a);
        e.buf.push_str(", ptr ");
        e.buf.push_str(tp0);
        e.buf.push_str("\n");
        b.push_str("(ptr ");
        b.push_str(tp0);
    } elif pkc == 31 {
        b.push_str("(double ");
        b.push_str(float_operand(obj, e));
    } else {
        b.push_str("(ptr ");
        b.push_str(obj.a);
    }
    a3 = ast.bb[id];
    ak3 = 1;
    while a3 >= 0 {
        at3 = emit_expr(ast, ast.aa[a3], e);
        pk3 = e.fn_param_kind(full, ak3);
        if pk3 == 31 {
            b.push_str(", double ");
            b.push_str(float_operand(at3, e));
        } elif pk3 == 30 {
            b.push_str(", ptr ");
            b.push_str(addr_of_arg(ast, ast.aa[a3], e));
        } elif pk3 == 0 {
            b.push_str(", i64 ");
            b.push_str(at3.a);
        } elif pk3 == 1 {
            b.push_str(", ptr ");
            b.push_str(at3.a);
            b.push_str(", i64 ");
            b.push_str(at3.b);
        } elif pk3 == 21 {
            ii_p3u = e.fn_piface_of(full, ak3);
            if ii_p3u > 0 && at3.kind != 21 {
                in_p3u = e.if_names[ii_p3u - 1].copy();
                b.push_str(", ptr ");
                b.push_str(e.emit_box(at3, in_p3u));
            } else {
                b.push_str(", ptr ");
                b.push_str(at3.a);
            }
        } else {
            b.push_str(", ptr ");
            b.push_str(at3.a);
        }
        ak3 = ak3 + 1;
        a3 = ast.nexts[a3];
    }
    b.push_str(")\n");
    e.buf.push_str(b.to_string());
    if rk_m == 5 { return mk_float(t); }
    if rk_m == 1 {
        p6 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(p6);
        e.buf.push_str(" = extractvalue { ptr, i64 } ");
        e.buf.push_str(t);
        e.buf.push_str(", 0\n  ");
        l6 = e.fresh();
        e.buf.push_str(l6);
        e.buf.push_str(" = extractvalue { ptr, i64 } ");
        e.buf.push_str(t);
        e.buf.push_str(", 1\n");
        return mk_str_tmp(p6, l6);
    }
    if rk_m == 2 {
        rinfo3 = e.ret_info(ast, mrty);
        rnm3 = "";
        if rinfo3 >= 0 { rnm3 = e.st_names[rinfo3].copy(); }
        pi5 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(pi5);
        e.buf.push_str(" = inttoptr i64 ");
        e.buf.push_str(t);
        e.buf.push_str(" to ptr\n");
        return Val { kind = 2, a = pi5, b = rnm3, ty = -1 };
    }
    if rk_m == 4 {
        rinfo4 = e.ret_info(ast, mrty);
        rnm4 = "";
        if rinfo4 >= 0 { rnm4 = e.en_names[rinfo4].copy(); }
        pi6 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(pi6);
        e.buf.push_str(" = inttoptr i64 ");
        e.buf.push_str(t);
        e.buf.push_str(" to ptr\n");
        return Val { kind = 4, a = pi6, b = rnm4, ty = -1 };
    }
    if rk_m == 6 {
        rinfo6 = e.ret_info(ast, mrty);
        rnm6 = "";
        if rinfo6 >= 0 { rnm6 = e.if_names[rinfo6].copy(); }
        pi6b = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(pi6b);
        e.buf.push_str(" = inttoptr i64 ");
        e.buf.push_str(t);
        e.buf.push_str(" to ptr\n");
        return Val { kind = 21, a = pi6b, b = rnm6, ty = -1 };
    }
    if rk_m == 3 {
        pi7 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(pi7);
        e.buf.push_str(" = inttoptr i64 ");
        e.buf.push_str(t);
        e.buf.push_str(" to ptr\n");
        return mk_arr(pi7, e.ret_info(ast, mrty));
    }
    return mk_int(t);
}

/// for-in 的 next() 调用（无参）：结构体/枚举静态、接口 vtable
#[alloc]
#[state]
fn emit_forin_next(ref Ast ast, ref String it_nm, int it_kind, ref String it_ty, ref mut Emitter e) -> Val {
    if it_kind == 21 {
        ii = e.find_iface_idx(it_ty);
        mi = e.iface_method_idx(ii, "next");
        if ii < 0 || mi < 0 { return mk_int("0"); }
        rv = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(rv);
        e.buf.push_str(" = load ptr, ptr %v_");
        e.buf.push_str(it_nm);
        e.buf.push_str(".p\n");
        obj = Val { kind = 21, a = rv, b = it_ty.copy(), ty = -1 };
        return emit_iface_dispatch(ast, -1, obj, ii, mi, e);
    }
    mid = e.find_method_id(it_ty, "next");
    if mid < 0 { return mk_int("0"); }
    mrty = e.method_ret_type(it_ty, "next");
    rk = e.ret_kind(ast, mrty);
    rv0 = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(rv0);
    e.buf.push_str(" = load ptr, ptr %v_");
    e.buf.push_str(it_nm);
    e.buf.push_str(".p\n");
    t = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(t);
    if rk == 5 {
        e.buf.push_str(" = call double @");
    } elif rk == 1 {
        e.buf.push_str(" = call { ptr, i64 } @");
    } else {
        e.buf.push_str(" = call i64 @");
    }
    full = it_ty + ".next";
    e.buf.push_str(e.fn_sym(full));
    e.buf.push_str("(ptr ");
    e.buf.push_str(rv0);
    e.buf.push_str(")\n");
    if rk == 5 { return mk_float(t); }
    if rk == 1 {
        ip = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(ip);
        e.buf.push_str(" = extractvalue { ptr, i64 } ");
        e.buf.push_str(t);
        e.buf.push_str(", 0\n  ");
        il = e.fresh();
        e.buf.push_str(il);
        e.buf.push_str(" = extractvalue { ptr, i64 } ");
        e.buf.push_str(t);
        e.buf.push_str(", 1\n");
        return mk_str_tmp(ip, il);
    }
    if rk == 2 || rk == 4 || rk == 6 {
        rinfo = e.ret_info(ast, mrty);
        rnm = "";
        if rk == 2 {
            if rinfo >= 0 { rnm = e.st_names[rinfo].copy(); }
        } elif rk == 4 {
            if rinfo >= 0 { rnm = e.en_names[rinfo].copy(); }
        } else {
            if rinfo >= 0 { rnm = e.if_names[rinfo].copy(); }
        }
        pi = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(pi);
        e.buf.push_str(" = inttoptr i64 ");
        e.buf.push_str(t);
        e.buf.push_str(" to ptr\n");
        if rk == 2 { return Val { kind = 2, a = pi, b = rnm, ty = -1 }; }
        if rk == 4 { return Val { kind = 4, a = pi, b = rnm, ty = -1 }; }
        return Val { kind = 21, a = pi, b = rnm, ty = -1 };
    }
    if rk == 3 {
        pi3 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(pi3);
        e.buf.push_str(" = inttoptr i64 ");
        e.buf.push_str(t);
        e.buf.push_str(" to ptr\n");
        return mk_arr(pi3, e.ret_info(ast, mrty));
    }
    return mk_int(t);
}

/// 变体第 0 个载荷（for-in 的 Some / ? 的 Ok）
#[alloc]
#[state]
fn emit_variant_payload(ref Ast ast, ref String opt_a, ref String en_name, ref String variant, ref mut Emitter e) -> Val {
    ei = e.find_enum_idx(en_name);
    if ei < 0 { return mk_int("0"); }
    vi = e.find_variant_idx(ei, variant);
    if vi < 0 { return mk_int("0"); }
    sl = e.payload_slot(ast, ei, vi, 0);
    pty = e.variant_ptype(ei, vi, 0);
    g = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(g);
    e.buf.push_str(" = getelementptr %enum.");
    e.buf.push_str(en_name);
    e.buf.push_str(", ptr ");
    e.buf.push_str(opt_a);
    e.buf.push_str(", i32 0, i32 ");
    e.buf.push_int(sl);
    e.buf.push_str("\n");
    tn = ty_name(ast, pty);
    if tn == "String" {
        vp = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(vp);
        e.buf.push_str(" = load ptr, ptr ");
        e.buf.push_str(g);
        e.buf.push_str("\n  ");
        gl = e.fresh();
        e.buf.push_str(gl);
        e.buf.push_str(" = getelementptr %enum.");
        e.buf.push_str(en_name);
        e.buf.push_str(", ptr ");
        e.buf.push_str(opt_a);
        e.buf.push_str(", i32 0, i32 ");
        e.buf.push_int(sl + 1);
        e.buf.push_str("\n  ");
        vl = e.fresh();
        e.buf.push_str(vl);
        e.buf.push_str(" = load i64, ptr ");
        e.buf.push_str(gl);
        e.buf.push_str("\n");
        return mk_str_tmp(vp, vl);
    }
    si_p = e.find_struct_idx(tn);
    ei_p = e.find_enum_idx(tn);
    ii_p = e.find_iface_idx(tn);
    if tn.len > 0 {
        if si_p >= 0 || ei_p >= 0 || ii_p >= 0 {
            iq = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(iq);
            e.buf.push_str(" = load i64, ptr ");
            e.buf.push_str(g);
            e.buf.push_str("\n  ");
            qp = e.fresh();
            e.buf.push_str(qp);
            e.buf.push_str(" = inttoptr i64 ");
            e.buf.push_str(iq);
            e.buf.push_str(" to ptr\n");
            if ii_p >= 0 { return Val { kind = 21, a = qp, b = tn.copy(), ty = -1 }; }
            if si_p >= 0 { return Val { kind = 2, a = qp, b = tn.copy(), ty = -1 }; }
            return Val { kind = 4, a = qp, b = tn.copy(), ty = -1 };
        }
    }
    vi2 = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(vi2);
    e.buf.push_str(" = load i64, ptr ");
    e.buf.push_str(g);
    e.buf.push_str("\n");
    return mk_int(vi2);
}

/// 接口方法 vtable 动态派发：box = {data, vtable}
#[alloc]
#[state]
fn emit_iface_dispatch(ref Ast ast, int args_head, ref Val obj, int ii, int mi, ref mut Emitter e) -> Val {
    mnode = e.iface_method_node_at(ii, mi);
    mrty = -1;
    if mnode >= 0 { mrty = ast.tys[mnode]; }
    rk_m = e.ret_kind(ast, mrty);
    dt = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(dt);
    e.buf.push_str(" = load ptr, ptr ");
    e.buf.push_str(obj.a);
    e.buf.push_str("\n  ");
    vt = e.fresh();
    e.buf.push_str(vt);
    e.buf.push_str(" = getelementptr i8, ptr ");
    e.buf.push_str(obj.a);
    e.buf.push_str(", i64 8\n  ");
    vtl = e.fresh();
    e.buf.push_str(vtl);
    e.buf.push_str(" = load ptr, ptr ");
    e.buf.push_str(vt);
    e.buf.push_str("\n  ");
    sl = e.fresh();
    e.buf.push_str(sl);
    e.buf.push_str(" = getelementptr i8, ptr ");
    e.buf.push_str(vtl);
    e.buf.push_str(", i64 ");
    e.buf.push_int(mi * 8);
    e.buf.push_str("\n  ");
    fp = e.fresh();
    e.buf.push_str(fp);
    e.buf.push_str(" = load ptr, ptr ");
    e.buf.push_str(sl);
    e.buf.push_str("\n");
    b = StringBuf::new();
    b.push_str("  ");
    t5 = e.fresh();
    b.push_str(t5);
    if rk_m == 5 {
        b.push_str(" = call double ");
    } elif rk_m == 1 {
        b.push_str(" = call { ptr, i64 } ");
    } else {
        b.push_str(" = call i64 ");
    }
    b.push_str(fp);
    b.push_str("(ptr ");
    b.push_str(dt);
    a3 = args_head;
    ak3 = 1;
    while a3 >= 0 {
        at3 = emit_expr(ast, ast.aa[a3], e);
        pk4 = e.iface_param_kind(ast, mnode, ak3);
        if pk4 == 31 {
            b.push_str(", double ");
            b.push_str(float_operand(at3, e));
        } elif pk4 == 30 {
            b.push_str(", ptr ");
            b.push_str(addr_of_arg(ast, ast.aa[a3], e));
        } elif pk4 == 0 {
            b.push_str(", i64 ");
            b.push_str(at3.a);
        } elif pk4 == 1 {
            b.push_str(", ptr ");
            b.push_str(at3.a);
            b.push_str(", i64 ");
            b.push_str(at3.b);
        } elif pk4 == 21 {
            b.push_str(", ptr ");
            if at3.kind == 21 {
                b.push_str(at3.a);
            } else {
                pn4 = e.iface_param_name(ast, mnode, ak3);
                b.push_str(e.emit_box(at3, pn4));
            }
        } else {
            b.push_str(", ptr ");
            b.push_str(at3.a);
        }
        ak3 = ak3 + 1;
        a3 = ast.nexts[a3];
    }
    b.push_str(")\n");
    e.buf.push_str(b.to_string());
    if rk_m == 5 { return mk_float(t5); }
    if rk_m == 1 {
        p6 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(p6);
        e.buf.push_str(" = extractvalue { ptr, i64 } ");
        e.buf.push_str(t5);
        e.buf.push_str(", 0\n  ");
        l6 = e.fresh();
        e.buf.push_str(l6);
        e.buf.push_str(" = extractvalue { ptr, i64 } ");
        e.buf.push_str(t5);
        e.buf.push_str(", 1\n");
        return mk_str_tmp(p6, l6);
    }
    if rk_m == 2 {
        rinfo3 = e.ret_info(ast, mrty);
        rnm3 = "";
        if rinfo3 >= 0 { rnm3 = e.st_names[rinfo3].copy(); }
        pi5 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(pi5);
        e.buf.push_str(" = inttoptr i64 ");
        e.buf.push_str(t5);
        e.buf.push_str(" to ptr\n");
        return Val { kind = 2, a = pi5, b = rnm3, ty = -1 };
    }
    if rk_m == 4 {
        rinfo4 = e.ret_info(ast, mrty);
        rnm4 = "";
        if rinfo4 >= 0 { rnm4 = e.en_names[rinfo4].copy(); }
        pi6 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(pi6);
        e.buf.push_str(" = inttoptr i64 ");
        e.buf.push_str(t5);
        e.buf.push_str(" to ptr\n");
        return Val { kind = 4, a = pi6, b = rnm4, ty = -1 };
    }
    if rk_m == 6 {
        rinfo6 = e.ret_info(ast, mrty);
        rnm6 = "";
        if rinfo6 >= 0 { rnm6 = e.if_names[rinfo6].copy(); }
        pi7b = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(pi7b);
        e.buf.push_str(" = inttoptr i64 ");
        e.buf.push_str(t5);
        e.buf.push_str(" to ptr\n");
        return Val { kind = 21, a = pi7b, b = rnm6, ty = -1 };
    }
    if rk_m == 3 {
        pi7 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(pi7);
        e.buf.push_str(" = inttoptr i64 ");
        e.buf.push_str(t5);
        e.buf.push_str(" to ptr\n");
        return mk_arr(pi7, e.ret_info(ast, mrty));
    }
    return mk_int(t5);
}

fn cmp_llvm_op(int op) -> String {
    if op == bo(BinOp::Eq._tag) { return "eq"; }
    if op == bo(BinOp::Neq._tag) { return "ne"; }
    if op == bo(BinOp::Lt._tag) { return "slt"; }
    if op == bo(BinOp::Gt._tag) { return "sgt"; }
    if op == bo(BinOp::Le._tag) { return "sle"; }
    if op == bo(BinOp::Ge._tag) { return "sge"; }
    return "";
}

fn is_cmp(int op) -> bool {
    if op == bo(BinOp::Eq._tag) { return true; }
    if op == bo(BinOp::Neq._tag) { return true; }
    if op == bo(BinOp::Lt._tag) { return true; }
    if op == bo(BinOp::Gt._tag) { return true; }
    if op == bo(BinOp::Le._tag) { return true; }
    if op == bo(BinOp::Ge._tag) { return true; }
    return false;
}

/// 数组元素槽布局：统一 8 字节槽（String/结构体为 {ptr, i64} → 16 字节）
/// 内建哨兵：2000 = String（ptr 槽，16 字节）、2001 = float（double 槽）
fn elem_slot(ref Ast ast, int ty) -> String {
    // 合成 id（负值，避免与真实 AST 节点 id 冲突）
    if ty <= -1000 && ty > -1128 { return "ptr"; }
    if ty <= -2000 && ty > -2128 { return "ptr"; }
    if ty == 2000 { return "ptr"; }
    if ty == 2001 { return "double"; }
    if ty == 2002 { return "i8"; }
    if ty < 0 { return "i64"; }
    t = ast.tags[ty];
    if t == tt(TT::Char._tag) { return "i8"; }
    if t == tt(TT::Float._tag) { return "double"; }
    if t == tt(TT::Named._tag) { return "ptr"; }
    if t == tt(TT::Array._tag) { return "ptr"; }
    if t == tt(TT::ArraySized._tag) { return "ptr"; }
    if t == tt(TT::Unique._tag) { return "ptr"; }
    if t == tt(TT::Ref._tag) { return "ptr"; }
    if t == tt(TT::FnPtr._tag) { return "ptr"; }
    if t == tt(TT::Closure._tag) { return "ptr"; }
    return "i64";
}

/// 槽的 LLVM 类型（getelementptr / store 用）
fn elem_llvm(ref Ast ast, int ty) -> String {
    return elem_slot(ast, ty);
}

/// 槽字节数（malloc 分配用）
fn elem_bytes(ref Ast ast, int ty) -> int {
    // 必须与 elem_stride 一致（String 元素 16 字节）
    if elem_is_string(ast, ty) { return 16; }
    if ty == 2002 { return 1; }
    if elem_slot(ast, ty) == "i8" { return 1; }
    return 8;
}

/// 元素字节跨度（String 元素 16 字节：ptr + len）
fn elem_stride(ref Ast ast, int ety) -> int {
    if elem_is_string(ast, ety) { return 16; }
    if ety == 2002 { return 1; }
    if ety >= 0 {
        if elem_slot(ast, ety) == "i8" { return 1; }
    }
    return 8;
}

/// 元素地址（字节偏移 GEP）：off = idx * stride
fn elem_addr(ref mut Emitter e, int stride, ref String base, ref String idx) -> String {
    off = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(off);
    e.buf.push_str(" = mul i64 ");
    e.buf.push_str(idx);
    e.buf.push_str(", ");
    e.buf.push_int(stride);
    e.buf.push_str("\n");
    g = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(g);
    e.buf.push_str(" = getelementptr i8, ptr ");
    e.buf.push_str(base);
    e.buf.push_str(", i64 ");
    e.buf.push_str(off);
    e.buf.push_str("\n");
    return g;
}

/// 元素是否为 String（布局 { ptr, i64 }，需要两次 store）
fn elem_is_string(ref Ast ast, int ty) -> bool {
    if ty <= -1000 && ty > -1128 { return false; }
    if ty <= -2000 && ty > -2128 { return false; }
    if ty == 2000 { return true; }
    if ty == 2002 { return false; }
    if ty < 0 { return false; }
    if ty >= ast.len { return false; }
    if ast.tags[ty] != tt(TT::Named._tag) { return false; }
    return ast.texts[ty] == "String";
}

/// 元素的 AST 类型 id：字面量用内建哨兵，数组用其元素类型，其余 -1（i64 槽）
fn elem_type_of(ref Ast ast, int id) -> int {
    if id < 0 { return -1; }
    if ast.tags[id] == et(ET::Literal._tag) {
        k = ast.bb[id];
        if k == lk(LK::Str._tag) { return 2000; }
        if k == lk(LK::Float._tag) { return 2001; }
        return -1;
    }
    if ast.tags[id] == et(ET::ArraySized._tag) { return ast.tys[id]; }
    if ast.tags[id] == et(ET::ArrayLiteral._tag) { return elem_type_of(ast, ast.aa[id]); }
    if ast.tags[id] == et(ET::ArrayRepeat._tag) { return elem_type_of(ast, ast.aa[id]); }
    return -1;
}

/// 数组元素类型（含结构体/枚举字面量与结构体/枚举局部；合成 id：-1000-si / -2000-ei）
impl Emitter {
    #[alloc]
    #[state]
    fn elem_type_of_m(ref mut self, ref Ast ast, int id) -> int {
        if id < 0 { return -1; }
        tg = ast.tags[id];
        if tg == et(ET::StructLiteral._tag) {
            si = self.find_struct_idx(ast.texts[id]);
            if si >= 0 { return -1000 - si; }
            return -1;
        }
        if tg == et(ET::EnumConstruct._tag) {
            en = pat_name(ast.texts[id]);
            ei = self.find_enum_idx(en);
            if ei >= 0 { return -2000 - ei; }
            return -1;
        }
        if tg == et(ET::Ident._tag) {
            kd = self.local_kind(ast.texts[id]);
            if kd >= 100 && kd < 228 { return -1000 - (kd - 100); }
            if kd == 20 {
                ei2 = self.etype_of_local(ast.texts[id]);
                if ei2 >= 0 { return -2000 - ei2; }
            }
            return -1;
        }
        return elem_type_of(ast, id);
    }
}

/// 模式名部分（"A|x,y" -> "A"；"E.A|x" -> "E.A"）
fn pat_name(ref String p) -> String {
    i = 0;
    while i < p.len as int {
        if p.index(i as usize) == '|' {
            return p.substring(0 as usize, i as usize);
        }
        i = i + 1;
    }
    return p.copy();
}

/// 模式绑定部分（"A|x,y" -> "x,y"；无 -> ""）
fn pat_binds(ref String p) -> String {
    i = 0;
    while i < p.len as int {
        if p.index(i as usize) == '|' {
            return p.substring((i + 1) as usize, p.len);
        }
        i = i + 1;
    }
    return "";
}

/// 变体短名（"E.A" -> "A"）
fn pat_short(ref String p) -> String {
    i = 0;
    last = -1;
    while i < p.len as int {
        if p.index(i as usize) == '.' { last = i; }
        i = i + 1;
    }
    if last >= 0 {
        return p.substring((last + 1) as usize, p.len);
    }
    return p.copy();
}

/// 枚举名（"E.A" -> "E"；无点 -> ""）
fn pat_enum(ref String p) -> String {
    i = 0;
    last = -1;
    while i < p.len as int {
        if p.index(i as usize) == '.' { last = i; }
        i = i + 1;
    }
    if last >= 0 {
        return p.substring(0 as usize, last as usize);
    }
    return "";
}

fn contains_dot2(ref String s) -> bool {
    i = 0;
    while i < s.len as int {
        if s.index(i as usize) == '.' { return true; }
        i = i + 1;
    }
    return false;
}

fn label(ref mut Emitter e, ref String prefix) -> String {
    b = StringBuf::new();
    b.push_str(prefix);
    b.push_int(e.tmp);
    e.tmp = e.tmp + 1;
    return b.to_string();
}

/// 枚举构造：full = "E.A"（裸变体或带实参）
fn emit_enum_ctor(ref Ast ast, ref String full, int args, ref mut Emitter e) -> Val {
    ename = pat_enum(full);
    vname = pat_short(full);
    ei = e.find_enum_idx(ename);
    if ei < 0 { return mk_int("0"); }
    vi = e.find_variant_idx(ei, vname);
    if vi < 0 { return mk_int("0"); }
    nbytes = 8;
    if ei >= 0 { nbytes = (e.enum_max_arity(ei) + 1) * 8; }
    nb2 = StringBuf::new();
    nb2.push_int(nbytes);
    t = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(t);
    e.buf.push_str(" = call ptr @malloc(i64 ");
    e.buf.push_str(nb2.to_string());
    e.buf.push_str(")\n  call void @llvm.memset.p0.i64(ptr ");
    e.buf.push_str(t);
    e.buf.push_str(", i8 0, i64 ");
    e.buf.push_str(nb2.to_string());
    e.buf.push_str(", i1 false)\n");
    g0 = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(g0);
    e.buf.push_str(" = getelementptr %enum.");
    e.buf.push_str(ename);
    e.buf.push_str(", ptr ");
    e.buf.push_str(t);
    e.buf.push_str(", i32 0, i32 0\n  store i64 ");
    e.buf.push_int(vi);
    e.buf.push_str(", ptr ");
    e.buf.push_str(g0);
    e.buf.push_str("\n");
    k = 0;
    a = args;
    while a >= 0 {
        v = mk_int("0");
        if ast.tags[a] == xt(XT::Arg._tag) {
            v = emit_expr(ast, ast.aa[a], e);
        } else {
            v = emit_expr(ast, a, e);
        }
        sl2 = e.payload_slot(ast, ei, vi, k);
        g = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(g);
        e.buf.push_str(" = getelementptr %enum.");
        e.buf.push_str(ename);
        e.buf.push_str(", ptr ");
        e.buf.push_str(t);
        e.buf.push_str(", i32 0, i32 ");
        e.buf.push_int(sl2);
        e.buf.push_str("\n");
        if v.kind == 1 {
            // String 载荷：ptr + len 两槽
            e.buf.push_str("  store ptr ");
            e.buf.push_str(ptr_operand(v.a));
            e.buf.push_str(", ptr ");
            e.buf.push_str(g);
            e.buf.push_str("\n");
            g2b = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(g2b);
            e.buf.push_str(" = getelementptr %enum.");
            e.buf.push_str(ename);
            e.buf.push_str(", ptr ");
            e.buf.push_str(t);
            e.buf.push_str(", i32 0, i32 ");
            e.buf.push_int(sl2 + 1);
            e.buf.push_str("\n  store i64 ");
            e.buf.push_str(v.b);
            e.buf.push_str(", ptr ");
            e.buf.push_str(g2b);
            e.buf.push_str("\n");
        } elif v.kind == 2 || v.kind == 3 || v.kind == 4 {
            e.buf.push_str("  store ptr ");
            e.buf.push_str(ptr_operand(v.a));
            e.buf.push_str(", ptr ");
            e.buf.push_str(g);
            e.buf.push_str("\n");
        } elif v.kind == 6 {
            // 浮点载荷：按位存入 i64 槽
            b6e = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(b6e);
            e.buf.push_str(" = bitcast double ");
            e.buf.push_str(v.a);
            e.buf.push_str(" to i64\n  store i64 ");
            e.buf.push_str(b6e);
            e.buf.push_str(", ptr ");
            e.buf.push_str(g);
            e.buf.push_str("\n");
        } else {
            e.buf.push_str("  store i64 ");
            e.buf.push_str(v.a);
            e.buf.push_str(", ptr ");
            e.buf.push_str(g);
            e.buf.push_str("\n");
        }
        k = k + 1;
        a = ast.nexts[a];
    }
    return Val { kind = 4, a = t, b = ename.copy(), ty = -1 };
}

/// 模式匹配条件（返回 i64 0/1 或 temp）
fn emit_pat_cond(ref Ast ast, int arm, ref Val sc, ref mut Emitter e) -> Val {
    ptext = ast.texts[arm];
    pk = ast.tys[arm];
    if pk == 0 { return mk_int("1"); }
    if pk == 4 { return mk_int("1"); }
    if pk == 1 {
        if sc.kind != 4 {
            // 绑定模式（n => ...）：恒匹配
            return mk_int("1");
        }
        vname = pat_short(pat_name(ptext));
        ename = pat_enum(pat_name(ptext));
        if ename.len == 0 { ename = sc.b.copy(); }
        ei = e.find_enum_idx(ename);
        if ei < 0 { return mk_int("0"); }
        vi = e.find_variant_idx(ei, vname);
        if vi < 0 { return mk_int("0"); }
        // 嵌套变体模式（Some|Some|v）：还需检查内层标签
        bar1 = -1;
        bar2 = -1;
        qq = 0;
        while qq < ptext.len as int {
            if ptext.index(qq as usize) == '|' {
                if bar1 < 0 { bar1 = qq; } elif bar2 < 0 { bar2 = qq; }
            }
            qq = qq + 1;
        }
        if bar2 > 0 {
            mid = ptext.substring((bar1 + 1) as usize, bar2 as usize);
            if e.find_struct_idx(mid) < 0 {
                // 内层标签检查在 body 块（外层标签确认后）进行，避免空指针解引用
            }
        }
        g = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(g);
        e.buf.push_str(" = getelementptr %enum.");
        e.buf.push_str(sc.b);
        e.buf.push_str(", ptr ");
        e.buf.push_str(sc.a);
        e.buf.push_str(", i32 0, i32 0\n");
        t = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(t);
        e.buf.push_str(" = load i64, ptr ");
        e.buf.push_str(g);
        e.buf.push_str("\n");
        c = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(c);
        e.buf.push_str(" = icmp eq i64 ");
        e.buf.push_str(t);
        e.buf.push_str(", ");
        e.buf.push_int(vi);
        e.buf.push_str("\n");
        return Val { kind = 5, a = c, b = "", ty = -1 };
    }
    if pk == 2 {
        lit = "0";
        if ptext == "true" { lit = "1"; }
        c2 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(c2);
        e.buf.push_str(" = icmp eq i64 ");
        e.buf.push_str(sc.a);
        e.buf.push_str(", ");
        e.buf.push_str(lit);
        e.buf.push_str("\n");
        return Val { kind = 5, a = c2, b = "", ty = -1 };
    }
    if pk == 6 {
        // 区间模式 start..end（左闭右开）或 start..=end（闭区间）
        dd = -1;
        eqq = 0;
        ii = 0;
        while ii < ptext.len as int {
            if ptext.index(ii as usize) == '.' {
                dd = ii;
                break;
            }
            ii = ii + 1;
        }
        if dd < 0 { return mk_int("0"); }
        rstart = ptext.substring(0 as usize, dd as usize);
        rest = ptext.substring((dd + 1) as usize, ptext.len);
        if rest.len > 0 {
            if rest.index(0) == '.' { rest = rest.substring(1 as usize, rest.len); }
        }
        if rest.len > 0 {
            if rest.index(0) == '=' {
                eqq = 1;
                rest = rest.substring(1 as usize, rest.len);
            }
        }
        rend = rest;
        if rstart.len == 0 || rend.len == 0 { return mk_int("0"); }
        c1r = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(c1r);
        e.buf.push_str(" = icmp sge i64 ");
        e.buf.push_str(sc.a);
        e.buf.push_str(", ");
        e.buf.push_str(rstart);
        e.buf.push_str("\n  ");
        c2r = e.fresh();
        e.buf.push_str(c2r);
        if eqq == 1 {
            e.buf.push_str(" = icmp sle i64 ");
        } else {
            e.buf.push_str(" = icmp slt i64 ");
        }
        e.buf.push_str(sc.a);
        e.buf.push_str(", ");
        e.buf.push_str(rend);
        e.buf.push_str("\n  ");
        c3r = e.fresh();
        e.buf.push_str(c3r);
        e.buf.push_str(" = and i1 ");
        e.buf.push_str(c1r);
        e.buf.push_str(", ");
        e.buf.push_str(c2r);
        e.buf.push_str("\n");
        return Val { kind = 5, a = c3r, b = "", ty = -1 };
    }
    if pk == 5 {
        // 字符字面量模式
        if ptext.len == 0 { return mk_int("0"); }
        cb5 = StringBuf::new();
        cb5.push_int(char_code(ptext.index(0)));
        c5 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(c5);
        e.buf.push_str(" = icmp eq i64 ");
        e.buf.push_str(sc.a);
        e.buf.push_str(", ");
        e.buf.push_str(cb5.to_string());
        e.buf.push_str("\n");
        return Val { kind = 5, a = c5, b = "", ty = -1 };
    }
    if pk == 3 {
        // 只支持整数字面量
        ok = 1;
        i = 0;
        while i < ptext.len as int {
            ch = ptext.index(i as usize);
            if !(ch >= '0' && ch <= '9') { ok = 0; }
            i = i + 1;
        }
        if ok == 0 { return mk_int("0"); }
        c3 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(c3);
        e.buf.push_str(" = icmp eq i64 ");
        e.buf.push_str(sc.a);
        e.buf.push_str(", ");
        e.buf.push_str(ptext);
        e.buf.push_str("\n");
        return Val { kind = 5, a = c3, b = "", ty = -1 };
    }
    return mk_int("0");
}

/// 嵌套变体模式的内层标签检查（在外层确认后、绑定前调用）；返回 1 表示已发射分支
#[alloc]
#[state]
fn emit_pat_inner_check(ref Ast ast, int arm, ref Val sc, ref String nxt, ref mut Emitter e) -> int {
    ptext = ast.texts[arm];
    pk = ast.tys[arm];
    if pk != 1 { return 0; }
    bar1 = -1;
    bar2 = -1;
    qq = 0;
    while qq < ptext.len as int {
        if ptext.index(qq as usize) == '|' {
            if bar1 < 0 { bar1 = qq; } elif bar2 < 0 { bar2 = qq; }
        }
        qq = qq + 1;
    }
    if bar2 <= 0 { return 0; }
    mid = ptext.substring((bar1 + 1) as usize, bar2 as usize);
    if e.find_struct_idx(mid) >= 0 { return 0; }
    ei = e.find_enum_idx(sc.b);
    if ei < 0 { return 0; }
    ivi = e.find_variant_idx(ei, mid);
    if ivi < 0 { return 0; }
    gpi = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(gpi);
    e.buf.push_str(" = getelementptr %enum.");
    e.buf.push_str(sc.b);
    e.buf.push_str(", ptr ");
    e.buf.push_str(sc.a);
    e.buf.push_str(", i32 0, i32 1\n  ");
    ipi = e.fresh();
    e.buf.push_str(ipi);
    e.buf.push_str(" = load ptr, ptr ");
    e.buf.push_str(gpi);
    e.buf.push_str("\n  ");
    gti = e.fresh();
    e.buf.push_str(gti);
    e.buf.push_str(" = getelementptr %enum.");
    e.buf.push_str(sc.b);
    e.buf.push_str(", ptr ");
    e.buf.push_str(ipi);
    e.buf.push_str(", i32 0, i32 0\n  ");
    tvi = e.fresh();
    e.buf.push_str(tvi);
    e.buf.push_str(" = load i64, ptr ");
    e.buf.push_str(gti);
    e.buf.push_str("\n  ");
    cvi = e.fresh();
    e.buf.push_str(cvi);
    e.buf.push_str(" = icmp eq i64 ");
    e.buf.push_str(tvi);
    e.buf.push_str(", ");
    e.buf.push_int(ivi);
    e.buf.push_str("\n  br i1 ");
    e.buf.push_str(cvi);
    e.buf.push_str(", label %");
    ok_l = label(e, "pat.ok.");
    e.buf.push_str(ok_l);
    e.buf.push_str(", label %");
    e.buf.push_str(nxt);
    e.buf.push_str("\n");
    e.buf.push_str(ok_l);
    e.buf.push_str(":\n");
    return 1;
}

/// 模式绑定（载荷 -> 局部变量）
fn emit_pat_binds(ref Ast ast, int arm, ref Val sc, ref mut Emitter e) {
    ptext = ast.texts[arm];
    pk = ast.tys[arm];
    if pk == 1 && sc.kind != 4 {
        // 绑定模式：把整个 scrutinee 绑定到模式名
        bn0 = pat_short(pat_name(ptext));
        if bn0.len > 0 && bn0 != "_" {
            e.declare_local(bn0, 0);
            e.buf.push_str("  store i64 ");
            e.buf.push_str(sc.a);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(bn0);
            e.buf.push_str("\n");
        }
        return;
    }
    binds = pat_binds(ptext);
    if binds.len == 0 { return; }
    // 枚举 + 嵌套结构体模式（Some|Point|x,y）：先取载荷槽 1 的指针，再按字段解构
    if pk == 1 {
        bar1 = -1;
        bar2 = -1;
        q0 = 0;
        while q0 < ptext.len as int {
            if ptext.index(q0 as usize) == '|' {
                if bar1 < 0 { bar1 = q0; } elif bar2 < 0 { bar2 = q0; }
            }
            q0 = q0 + 1;
        }
        if bar2 > 0 {
            sname = ptext.substring((bar1 + 1) as usize, bar2 as usize);
            binds = ptext.substring((bar2 + 1) as usize, ptext.len);
            if e.find_struct_idx(sname) < 0 {
                // 嵌套变体：内层载荷槽依次绑定
                gpv = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(gpv);
                e.buf.push_str(" = getelementptr %enum.");
                e.buf.push_str(sc.b);
                e.buf.push_str(", ptr ");
                e.buf.push_str(sc.a);
                e.buf.push_str(", i32 0, i32 1\n  ");
                ipv = e.fresh();
                e.buf.push_str(ipv);
                e.buf.push_str(" = load ptr, ptr ");
                e.buf.push_str(gpv);
                e.buf.push_str("\n");
                start3 = 0;
                i3 = 0;
                k3 = 0;
                while i3 <= binds.len as int {
                    at3e = 0;
                    if i3 == binds.len as int { at3e = 1; }
                    isc3 = 0;
                    if at3e == 0 {
                        if binds.index(i3 as usize) == ',' { isc3 = 1; }
                    }
                    if at3e == 1 || isc3 == 1 {
                        if i3 > start3 {
                            bnd3 = binds.substring(start3 as usize, i3 as usize);
                            g3 = e.fresh();
                            e.buf.push_str("  ");
                            e.buf.push_str(g3);
                            e.buf.push_str(" = getelementptr %enum.");
                            e.buf.push_str(sc.b);
                            e.buf.push_str(", ptr ");
                            e.buf.push_str(ipv);
                            e.buf.push_str(", i32 0, i32 ");
                            e.buf.push_int(k3 + 1);
                            e.buf.push_str("\n  ");
                            v3 = e.fresh();
                            e.buf.push_str(v3);
                            e.buf.push_str(" = load i64, ptr ");
                            e.buf.push_str(g3);
                            e.buf.push_str("\n");
                            e.declare_local(bnd3, 0);
                            e.buf.push_str("  store i64 ");
                            e.buf.push_str(v3);
                            e.buf.push_str(", ptr %v_");
                            e.buf.push_str(bnd3);
                            e.buf.push_str("\n");
                            k3 = k3 + 1;
                        }
                        start3 = i3 + 1;
                    }
                    i3 = i3 + 1;
                }
                return;
            }
            gp = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(gp);
            e.buf.push_str(" = getelementptr %enum.");
            e.buf.push_str(sc.b);
            e.buf.push_str(", ptr ");
            e.buf.push_str(sc.a);
            e.buf.push_str(", i32 0, i32 1\n");
            sp = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(sp);
            e.buf.push_str(" = load ptr, ptr ");
            e.buf.push_str(gp);
            e.buf.push_str("\n");
            start2 = 0;
            i2 = 0;
            while i2 <= binds.len as int {
                at_end2 = 0;
                if i2 == binds.len as int { at_end2 = 1; }
                is_comma2 = 0;
                if at_end2 == 0 {
                    if binds.index(i2 as usize) == ',' { is_comma2 = 1; }
                }
                if at_end2 == 1 || is_comma2 == 1 {
                    if i2 > start2 {
                        item = binds.substring(start2 as usize, i2 as usize);
                        fld = item.copy();
                        bnd = item.copy();
                        eqp2 = -1;
                        q3 = 0;
                        while q3 < item.len as int {
                            if item.index(q3 as usize) == '=' { eqp2 = q3; break; }
                            q3 = q3 + 1;
                        }
                        if eqp2 >= 0 {
                            fld = item.substring(0 as usize, eqp2 as usize);
                            bnd = item.substring((eqp2 + 1) as usize, item.len);
                        }
                        fi2 = e.find_field_idx(sname, fld);
                        if fi2 < 0 { return; }
                        gf = e.fresh();
                        e.buf.push_str("  ");
                        e.buf.push_str(gf);
                        e.buf.push_str(" = getelementptr %struct.");
                        e.buf.push_str(sname);
                        e.buf.push_str(", ptr ");
                        e.buf.push_str(sp);
                        e.buf.push_str(", i32 0, i32 ");
                        e.buf.push_int(fi2);
                        e.buf.push_str("\n");
                        vf = e.fresh();
                        e.buf.push_str("  ");
                        e.buf.push_str(vf);
                        e.buf.push_str(" = load i64, ptr ");
                        e.buf.push_str(gf);
                        e.buf.push_str("\n");
                        e.declare_local(bnd, 0);
                        e.buf.push_str("  store i64 ");
                        e.buf.push_str(vf);
                        e.buf.push_str(", ptr %v_");
                        e.buf.push_str(bnd);
                        e.buf.push_str("\n");
                    }
                    start2 = i2 + 1;
                }
                i2 = i2 + 1;
            }
            return;
        }
    }
    // 按 ',' 切分
    start = 0;
    k = 0;
    i = 0;
    while i <= binds.len as int {
        at_end = 0;
        if i == binds.len as int { at_end = 1; }
        is_comma = 0;
        if at_end == 0 {
            if binds.index(i as usize) == ',' { is_comma = 1; }
        }
        if at_end == 1 || is_comma == 1 {
            if i > start {
                bname = binds.substring(start as usize, i as usize);
                g = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(g);
                bname2 = bname.copy();
                pty_k = -1;
                psl_k = k + 1;
                pkind_k = 0;
                psi_k = -1;
                if pk == 1 {
                    ei_b = e.find_enum_idx(sc.b);
                    vn_b = pat_short(pat_name(ptext));
                    vi_b = -1;
                    if ei_b >= 0 { vi_b = e.find_variant_idx(ei_b, vn_b); }
                    if ei_b >= 0 && vi_b >= 0 {
                        pty_k = e.variant_ptype(ei_b, vi_b, k);
                        psl_k = e.payload_slot(ast, ei_b, vi_b, k);
                        tn_k = ty_name(ast, pty_k);
                        if tn_k == "String" {
                            pkind_k = 1;
                        } else {
                            si_k = e.find_struct_idx(tn_k);
                            if si_k >= 0 {
                                pkind_k = 100 + si_k;
                                psi_k = si_k;
                            } else {
                                ei_k = e.find_enum_idx(tn_k);
                                if ei_k >= 0 {
                                    pkind_k = 20;
                                    psi_k = ei_k;
                                }
                            }
                        }
                    }
                    e.buf.push_str(" = getelementptr %enum.");
                    e.buf.push_str(sc.b);
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(sc.a);
                    e.buf.push_str(", i32 0, i32 ");
                    e.buf.push_int(psl_k);
                } else {
                    // 结构体解构：bname 可能是 field 或 field=binding
                    fname2 = bname.copy();
                    eqp = -1;
                    q = 0;
                    while q < bname.len as int {
                        if bname.index(q as usize) == '=' { eqp = q; break; }
                        q = q + 1;
                    }
                    if eqp >= 0 {
                        fname2 = bname.substring(0 as usize, eqp as usize);
                        bname2 = bname.substring((eqp + 1) as usize, bname.len);
                    }
                    idx = e.find_field_idx(sc.b, fname2);
                    if idx < 0 { return; }
                    e.buf.push_str(" = getelementptr %struct.");
                    e.buf.push_str(sc.b);
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(sc.a);
                    e.buf.push_str(", i32 0, i32 ");
                    e.buf.push_int(idx);
                    e.buf.push_str("\n");
                }
                if pk == 1 && pkind_k == 1 {
                    // String 载荷：ptr + len
                    e.buf.push_str("\n");
                    vp_s = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(vp_s);
                    e.buf.push_str(" = load ptr, ptr ");
                    e.buf.push_str(g);
                    e.buf.push_str("\n");
                    gl_s = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(gl_s);
                    e.buf.push_str(" = getelementptr %enum.");
                    e.buf.push_str(sc.b);
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(sc.a);
                    e.buf.push_str(", i32 0, i32 ");
                    e.buf.push_int(psl_k + 1);
                    e.buf.push_str("\n");
                    vl_s = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(vl_s);
                    e.buf.push_str(" = load i64, ptr ");
                    e.buf.push_str(gl_s);
                    e.buf.push_str("\n");
                    e.declare_local(bname2, 1);
                    e.buf.push_str("  store ptr ");
                    e.buf.push_str(vp_s);
                    e.buf.push_str(", ptr %v_");
                    e.buf.push_str(bname2);
                    e.buf.push_str(".ptr\n  store i64 ");
                    e.buf.push_str(vl_s);
                    e.buf.push_str(", ptr %v_");
                    e.buf.push_str(bname2);
                    e.buf.push_str(".len\n");
                } elif pk == 1 && pkind_k >= 2 {
                    // 结构体/枚举载荷：指针
                    e.buf.push_str("\n");
                    vp_p = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(vp_p);
                    e.buf.push_str(" = load ptr, ptr ");
                    e.buf.push_str(g);
                    e.buf.push_str("\n");
                    e.declare_local(bname2, pkind_k);
                    e.record_etype(bname2, psi_k);
                    e.buf.push_str("  store ptr ");
                    e.buf.push_str(vp_p);
                    e.buf.push_str(", ptr %v_");
                    e.buf.push_str(bname2);
                    e.buf.push_str(".p");
                    e.buf.push_str("\n");
                } else {
                    e.buf.push_str("\n");
                    v = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(v);
                    e.buf.push_str(" = load i64, ptr ");
                    e.buf.push_str(g);
                    e.buf.push_str("\n");
                    e.declare_local(bname2, 0);
                    e.buf.push_str("  store i64 ");
                    e.buf.push_str(v);
                    e.buf.push_str(", ptr %v_");
                    e.buf.push_str(bname2);
                    e.buf.push_str("\n");
                }
                k = k + 1;
            }
            start = i + 1;
        }
        i = i + 1;
    }
}

/// match（语句 want_value=0 / 表达式 want_value=1）
/// 分支块尾是否为浮点值（用于 if/match 表达式结果槽的装载方式）
fn tail_is_float(ref Ast ast, int blk) -> int {
    if blk < 0 { return 0; }
    t = ast.bb[blk];
    if t < 0 { return 0; }
    if ast.tags[t] == et(ET::Literal._tag) {
        if ast.bb[t] == lk(LK::Float._tag) { return 1; }
        return 0;
    }
    if ast.tags[t] == et(ET::Suffixed._tag) {
        sfx = ast.texts[t];
        if sfx == "f32" || sfx == "f64" { return 1; }
        return 0;
    }
    return 0;
}

/// if 表达式分支：发射块语句 + 块尾值（存入 res）
fn emit_if_branch(ref Ast ast, int blk, ref String res, int want_float, ref mut Emitter e) -> int {
    if blk < 0 { return 0; }
    emit_stmts(ast, ast.aa[blk], e);
    if e.terminated == 1 { return 0; }
    tail = ast.bb[blk];
    if tail >= 0 {
        tv = emit_expr(ast, tail, e);
        if tv.kind == 6 {
            // 浮点：按位存入 i64 结果槽
            // 浮点：按位存入 i64 结果槽
            fb = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(fb);
            e.buf.push_str(" = bitcast double ");
            e.buf.push_str(tv.a);
            e.buf.push_str(" to i64\n  store i64 ");
            e.buf.push_str(fb);
            e.buf.push_str(", ptr ");
            e.buf.push_str(res);
            e.buf.push_str("\n");
        } elif want_float == 1 {
            // 结果槽按浮点解释：整数分支 sitofp 后按位存
            cf = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(cf);
            e.buf.push_str(" = sitofp i64 ");
            e.buf.push_str(tv.a);
            e.buf.push_str(" to double\n  ");
            cb = e.fresh();
            e.buf.push_str(cb);
            e.buf.push_str(" = bitcast double ");
            e.buf.push_str(cf);
            e.buf.push_str(" to i64\n  store i64 ");
            e.buf.push_str(cb);
            e.buf.push_str(", ptr ");
            e.buf.push_str(res);
            e.buf.push_str("\n");
            return 0;
        } else {
            return store_match_val(tv, res, e);
        }
    }
    return 0;
}

/// 分支尾值存入 i64 结果槽（指针类值先 ptrtoint；String 装箱为 16 字节单元，槽存单元指针）
/// 返回 1 表示本次存的是 String 单元（结果槽按 String 解释）
#[alloc]
fn store_match_val(ref Val tv, ref String res, ref mut Emitter e) -> int {
    if tv.kind == 1 {
        cell = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(cell);
        e.buf.push_str(" = call ptr @malloc(i64 16)\n  store ptr ");
        e.buf.push_str(tv.a);
        e.buf.push_str(", ptr ");
        e.buf.push_str(cell);
        e.buf.push_str("\n  ");
        c8 = e.fresh();
        e.buf.push_str(c8);
        e.buf.push_str(" = getelementptr i8, ptr ");
        e.buf.push_str(cell);
        e.buf.push_str(", i64 8\n  store i64 ");
        e.buf.push_str(tv.b);
        e.buf.push_str(", ptr ");
        e.buf.push_str(c8);
        e.buf.push_str("\n  ");
        pi = e.fresh();
        e.buf.push_str(pi);
        e.buf.push_str(" = ptrtoint ptr ");
        e.buf.push_str(cell);
        e.buf.push_str(" to i64\n  store i64 ");
        e.buf.push_str(pi);
        e.buf.push_str(", ptr ");
        e.buf.push_str(res);
        e.buf.push_str("\n");
        return 1;
    }
    if tv.kind == 2 || tv.kind == 3 || tv.kind == 4 || tv.kind == 21 {
        pv = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(pv);
        e.buf.push_str(" = ptrtoint ptr ");
        e.buf.push_str(tv.a);
        e.buf.push_str(" to i64\n  store i64 ");
        e.buf.push_str(pv);
        e.buf.push_str(", ptr ");
        e.buf.push_str(res);
        e.buf.push_str("\n");
        return 0;
    }
    e.buf.push_str("  store i64 ");
    e.buf.push_str(tv.a);
    e.buf.push_str(", ptr ");
    e.buf.push_str(res);
    e.buf.push_str("\n");
    return 0;
}

/// String 结果槽拆包：槽内 i64 是 16 字节单元指针（ptr + len）
#[alloc]
fn unpack_str_res(ref String slot_i64, ref mut Emitter e) -> Val {
    pc = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(pc);
    e.buf.push_str(" = inttoptr i64 ");
    e.buf.push_str(slot_i64);
    e.buf.push_str(" to ptr\n  ");
    rp = e.fresh();
    e.buf.push_str(rp);
    e.buf.push_str(" = load ptr, ptr ");
    e.buf.push_str(pc);
    e.buf.push_str("\n  ");
    rl8 = e.fresh();
    e.buf.push_str(rl8);
    e.buf.push_str(" = getelementptr i8, ptr ");
    e.buf.push_str(pc);
    e.buf.push_str(", i64 8\n  ");
    rl = e.fresh();
    e.buf.push_str(rl);
    e.buf.push_str(" = load i64, ptr ");
    e.buf.push_str(rl8);
    e.buf.push_str("\n");
    return mk_str_tmp(rp, rl);
}

/// if 表达式：条件链 + 分支块尾值合流
fn emit_if_expr(ref Ast ast, int id, ref mut Emitter e) -> Val {
    is_float_res = tail_is_float(ast, ast.bb[id]);
    if is_float_res == 0 { is_float_res = tail_is_float(ast, ast.dd[id]); }
    end_l = label(e, "ifx.end.");
    res = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(res);
    e.buf.push_str(" = alloca i64\n");
    sf = 0;
    c = emit_expr(ast, ast.aa[id], e);
    then_l = label(e, "ifx.then.");
    next_l = label(e, "ifx.next.");
    cc = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(cc);
    e.buf.push_str(" = icmp ne i64 ");
    e.buf.push_str(c.a);
    e.buf.push_str(", 0\n  br i1 ");
    e.buf.push_str(cc);
    e.buf.push_str(", label %");
    e.buf.push_str(then_l);
    e.buf.push_str(", label %");
    e.buf.push_str(next_l);
    e.buf.push_str("\n");
    e.buf.push_str(then_l);
    e.buf.push_str(":\n");
    e.terminated = 0;
    sf = sf | emit_if_branch(ast, ast.bb[id], res, is_float_res, e);
    if e.terminated == 0 {
        e.buf.push_str("  br label %");
        e.buf.push_str(end_l);
        e.buf.push_str("\n");
    }
    en = ast.cc[id];
    cur_next = next_l;
    while en >= 0 {
        e.buf.push_str(cur_next);
        e.buf.push_str(":\n");
        e.terminated = 0;
        ec2 = emit_expr(ast, ast.aa[en], e);
        then_l2 = label(e, "ifx.then.");
        next_l2 = label(e, "ifx.next.");
        cc2 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(cc2);
        e.buf.push_str(" = icmp ne i64 ");
        e.buf.push_str(ec2.a);
        e.buf.push_str(", 0\n  br i1 ");
        e.buf.push_str(cc2);
        e.buf.push_str(", label %");
        e.buf.push_str(then_l2);
        e.buf.push_str(", label %");
        e.buf.push_str(next_l2);
        e.buf.push_str("\n");
        e.buf.push_str(then_l2);
        e.buf.push_str(":\n");
        e.terminated = 0;
        sf = sf | emit_if_branch(ast, ast.bb[en], res, is_float_res, e);
        if e.terminated == 0 {
            e.buf.push_str("  br label %");
            e.buf.push_str(end_l);
            e.buf.push_str("\n");
        }
        cur_next = next_l2;
        en = ast.nexts[en];
    }
    e.buf.push_str(cur_next);
    e.buf.push_str(":\n");
    e.terminated = 0;
    e2 = ast.dd[id];
    if e2 >= 0 {
        sf = sf | emit_if_branch(ast, e2, res, is_float_res, e);
    }
    if e.terminated == 0 {
        e.buf.push_str("  br label %");
        e.buf.push_str(end_l);
        e.buf.push_str("\n");
    }
    e.buf.push_str(end_l);
    e.buf.push_str(":\n");
    e.terminated = 0;
    rv = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(rv);
    e.buf.push_str(" = load i64, ptr ");
    e.buf.push_str(res);
    e.buf.push_str("\n");
    if sf == 1 {
        return unpack_str_res(rv, e);
    }
    if is_float_res == 1 {
        fd = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(fd);
        e.buf.push_str(" = bitcast i64 ");
        e.buf.push_str(rv);
        e.buf.push_str(" to double\n");
        return mk_float(fd);
    }
    return mk_int(rv);
}

fn emit_match(ref Ast ast, int id, ref mut Emitter e, int want_value) -> Val {
    sc = emit_expr(ast, ast.aa[id], e);
    arms = ast.bb[id];
    cnt = 0;
    a = arms;
    while a >= 0 { cnt = cnt + 1; a = ast.nexts[a]; }
    if cnt == 0 { return mk_int("0"); }
    end_l = label(e, "match.end.");
    res = "";
    sf_m = 0;
    if want_value == 1 {
        res = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(res);
        e.buf.push_str(" = alloca i64\n");
    }
    e.buf.push_str("  br label %match.arm.0\n");
    i = 0;
    a = arms;
    prev_body = -1;
    while a >= 0 {
        lbl = "match.arm.";
        b1 = StringBuf::new();
        b1.push_str(lbl);
        b1.push_int(i);
        nxt = end_l.copy();
        if i + 1 < cnt {
            n2 = StringBuf::new();
            n2.push_str("match.arm.");
            n2.push_int(i + 1);
            nxt = n2.to_string();
        }
        bl = StringBuf::new();
        bl.push_str("match.body.");
        bl.push_int(i);
        body_l = bl.to_string();
        e.buf.push_str(b1.to_string());
        e.buf.push_str(":\n");
        cond = emit_pat_cond(ast, a, sc, e);
        if cond.kind == 5 {
            e.buf.push_str("  br i1 ");
            e.buf.push_str(cond.a);
            e.buf.push_str(", label %");
            e.buf.push_str(body_l);
            e.buf.push_str(", label %");
            e.buf.push_str(nxt);
            e.buf.push_str("\n");
        } elif cond.kind == 0 {
            if cond.a == "1" {
                e.buf.push_str("  br label %");
                e.buf.push_str(body_l);
                e.buf.push_str("\n");
            } elif cond.a == "0" {
                e.buf.push_str("  br label %");
                e.buf.push_str(nxt);
                e.buf.push_str("\n");
            } else {
                cc = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(cc);
                e.buf.push_str(" = icmp ne i64 ");
                e.buf.push_str(cond.a);
                e.buf.push_str(", 0\n  br i1 ");
                e.buf.push_str(cc);
                e.buf.push_str(", label %");
                e.buf.push_str(body_l);
                e.buf.push_str(", label %");
                e.buf.push_str(nxt);
                e.buf.push_str("\n");
            }
        } else {
            cc2 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(cc2);
            e.buf.push_str(" = icmp ne i64 ");
            e.buf.push_str(cond.a);
            e.buf.push_str(", 0\n  br i1 ");
            e.buf.push_str(cc2);
            e.buf.push_str(", label %");
            e.buf.push_str(body_l);
            e.buf.push_str(", label %");
            e.buf.push_str(nxt);
            e.buf.push_str("\n");
        }
        e.buf.push_str(body_l);
        e.buf.push_str(":\n");
        emit_pat_inner_check(ast, a, sc, nxt, e);
        emit_pat_binds(ast, a, sc, e);
        gd = ast.bb[a];
        if gd >= 0 {
            // 守卫：绑定已就位，条件为假则跳到下一臂
            gv = emit_expr(ast, gd, e);
            gc = e.fresh();
            b2l = StringBuf::new();
            b2l.push_str("match.guard.");
            b2l.push_int(i);
            e.buf.push_str("  ");
            e.buf.push_str(gc);
            e.buf.push_str(" = icmp ne i64 ");
            e.buf.push_str(gv.a);
            e.buf.push_str(", 0\n  br i1 ");
            e.buf.push_str(gc);
            e.buf.push_str(", label %");
            e.buf.push_str(b2l.to_string());
            e.buf.push_str(", label %");
            e.buf.push_str(nxt);
            e.buf.push_str("\n");
            e.buf.push_str(b2l.to_string());
            e.buf.push_str(":\n");
        }
        body = ast.aa[a];
        if body < 0 { body = prev_body; }
        if body >= 0 {
            prev_body = body;
            btag = ast.tags[body];
            if want_value == 1 {
                if btag == st(ST::Return._tag) {
                    emit_stmt(ast, body, e);
                } elif btag == st(ST::ExprStmt._tag) {
                    v = emit_expr(ast, ast.aa[body], e);
                    sf_m = sf_m | store_match_val(v, res, e);
                } elif btag == st(ST::Block._tag) {
                    emit_stmts(ast, ast.aa[body], e);
                    if e.terminated == 0 {
                        tail_m = ast.bb[body];
                        if tail_m >= 0 {
                            tv_m = emit_expr(ast, tail_m, e);
                            sf_m = sf_m | store_match_val(tv_m, res, e);
                        }
                    }
                } elif btag == st(ST::If._tag) {
                    // 臂体是尾位置 if（无花括号）：按 if 表达式取值
                    // （ST::If 与 ET::If 字段布局相同：aa=cond bb=then cc=elifs dd=else）
                    v_if = emit_if_expr(ast, body, e);
                    sf_m = sf_m | store_match_val(v_if, res, e);
                } else {
                    emit_stmt(ast, body, e);
                }
            } else {
                emit_stmt(ast, body, e);
            }
        }
        e.buf.push_str("  br label %");
        e.buf.push_str(end_l);
        e.buf.push_str("\n");
        i = i + 1;
        a = ast.nexts[a];
    }
    e.buf.push_str(end_l);
    e.buf.push_str(":\n");
    if want_value == 1 {
        rv = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(rv);
        e.buf.push_str(" = load i64, ptr ");
        e.buf.push_str(res);
        e.buf.push_str("\n");
        if sf_m == 1 {
            return unpack_str_res(rv, e);
        }
        return mk_int(rv);
    }
    return mk_int("0");
}

/// 间接调用 Fn 值：值 = 环境块指针（块首代码指针），env 作为末位参数
#[alloc]
fn emit_indirect_call(ref Ast ast, ref String fval, int fty, int args, ref mut Emitter e) -> Val {
    b = StringBuf::new();
    b.push_str("  ");
    envp = e.fresh();
    b.push_str(envp);
    b.push_str(" = inttoptr i64 ");
    b.push_str(fval);
    b.push_str(" to ptr\n  ");
    codep = e.fresh();
    b.push_str(codep);
    b.push_str(" = load ptr, ptr ");
    b.push_str(envp);
    b.push_str("\n  ");
    t4 = e.fresh();
    b.push_str(t4);
    frk = 0;
    frty = fn_type_ret(ast, fty);
    if frty >= 0 {
        frk = e.ret_kind(ast, frty);
    }
    if frk == 1 {
        b.push_str(" = call { ptr, i64 } ");
    } elif frk == 5 {
        b.push_str(" = call double ");
    } else {
        b.push_str(" = call i64 ");
    }
    b.push_str(codep);
    b.push_str("(");
    first0 = 1;
    a0f = args;
    fk_i = 0;
    while a0f >= 0 {
        at0 = emit_expr(ast, ast.aa[a0f], e);
        if first0 == 0 { b.push_str(", "); }
        pk0 = e.closure_param_kind(ast, fty, fk_i);
        if pk0 == 1 {
            b.push_str("ptr ");
            b.push_str(at0.a);
            b.push_str(", i64 ");
            b.push_str(at0.b);
        } elif pk0 == 31 {
            b.push_str("double ");
            b.push_str(float_operand(at0, e));
        } elif pk0 == 0 {
            b.push_str("i64 ");
            b.push_str(at0.a);
        } else {
            b.push_str("ptr ");
            b.push_str(at0.a);
        }
        first0 = 0;
        fk_i = fk_i + 1;
        a0f = ast.nexts[a0f];
    }
    if first0 == 0 { b.push_str(", "); }
    b.push_str("ptr ");
    b.push_str(envp);
    b.push_str(")\n");
    e.buf.push_str(b.to_string());
    if frk == 1 {
        ip5 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(ip5);
        e.buf.push_str(" = extractvalue { ptr, i64 } ");
        e.buf.push_str(t4);
        e.buf.push_str(", 0\n  ");
        il5 = e.fresh();
        e.buf.push_str(il5);
        e.buf.push_str(" = extractvalue { ptr, i64 } ");
        e.buf.push_str(t4);
        e.buf.push_str(", 1\n");
        return mk_str_tmp(ip5, il5);
    }
    if frk == 5 {
        return mk_float(t4);
    }
    return mk_int(t4);
}

/// 闭包值：非捕获 -> 静态环境块；捕获 -> 堆环境块（块首代码指针，后续捕获槽）
#[alloc]
fn emit_lambda_value(ref Ast ast, int id, ref mut Emitter e) -> Val {
    li = e.lam_index_of(id);
    if li < 0 {
        lp0 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(lp0);
        e.buf.push_str(" = ptrtoint ptr @");
        e.buf.push_str(ast.texts[id]);
        e.buf.push_str(" to i64\n");
        return mk_int(lp0);
    }
    if e.cap_done[li] == 0 {
        e.cap_start[li] = e.cap_total;
        e.cap_count[li] = 0;
        e.cap_done[li] = 1;
        cap_scan_list(ast, ast.bb[id], li, e);
    }
    cnt = e.cap_count[li];
    lname = ast.texts[id];
    if cnt == 0 {
        gnm = e.add_env_global("lamenv", lname);
        lp = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(lp);
        e.buf.push_str(" = ptrtoint ptr @");
        e.buf.push_str(gnm);
        e.buf.push_str(" to i64\n");
        return mk_int(lp);
    }
    sz = (cnt + 1) * 8;
    envp = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(envp);
    e.buf.push_str(" = call ptr @malloc(i64 ");
    e.buf.push_int(sz);
    e.buf.push_str(")\n  store ptr @");
    e.buf.push_str(e.fn_sym(lname));
    e.buf.push_str(", ptr ");
    e.buf.push_str(envp);
    e.buf.push_str("\n");
    start = e.cap_start[li];
    i = 0;
    while i < cnt {
        cid = e.cap_ids[start + i];
        ck = e.cap_kinds[start + i];
        off = (i + 1) * 8;
        if ck == 30 {
            ad = addr_of_arg(ast, cid, e);
            sp = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(sp);
            e.buf.push_str(" = getelementptr i8, ptr ");
            e.buf.push_str(envp);
            e.buf.push_str(", i64 ");
            e.buf.push_int(off);
            e.buf.push_str("\n  store ptr ");
            e.buf.push_str(ad);
            e.buf.push_str(", ptr ");
            e.buf.push_str(sp);
            e.buf.push_str("\n");
        } else {
            v = emit_expr(ast, cid, e);
            sp2 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(sp2);
            e.buf.push_str(" = getelementptr i8, ptr ");
            e.buf.push_str(envp);
            e.buf.push_str(", i64 ");
            e.buf.push_int(off);
            e.buf.push_str("\n");
            if v.kind == 1 {
                e.buf.push_str("  store ptr ");
                e.buf.push_str(v.a);
                e.buf.push_str(", ptr ");
                e.buf.push_str(sp2);
                e.buf.push_str("\n  ");
                sp2b = e.fresh();
                e.buf.push_str(sp2b);
                e.buf.push_str(" = getelementptr i8, ptr ");
                e.buf.push_str(envp);
                e.buf.push_str(", i64 ");
                e.buf.push_int(off + 8);
                e.buf.push_str("\n  store i64 ");
                e.buf.push_str(v.b);
                e.buf.push_str(", ptr ");
                e.buf.push_str(sp2b);
                e.buf.push_str("\n");
            } elif v.kind == 3 || v.kind == 2 || v.kind == 4 {
                e.buf.push_str("  store ptr ");
                e.buf.push_str(v.a);
                e.buf.push_str(", ptr ");
                e.buf.push_str(sp2);
                e.buf.push_str("\n");
            } elif v.kind == 6 {
                bb0 = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(bb0);
                e.buf.push_str(" = bitcast double ");
                e.buf.push_str(v.a);
                e.buf.push_str(" to i64\n  store i64 ");
                e.buf.push_str(bb0);
                e.buf.push_str(", ptr ");
                e.buf.push_str(sp2);
                e.buf.push_str("\n");
            } else {
                e.buf.push_str("  store i64 ");
                e.buf.push_str(v.a);
                e.buf.push_str(", ptr ");
                e.buf.push_str(sp2);
                e.buf.push_str("\n");
            }
        }
        i = i + 1;
    }
    lp2 = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(lp2);
    e.buf.push_str(" = ptrtoint ptr ");
    e.buf.push_str(envp);
    e.buf.push_str(" to i64\n");
    return mk_int(lp2);
}

/// 捕获扫描：收集 lambda 子树中引用到外层局部的名字（含嵌套 lambda 的引用）
#[alloc]
fn cap_scan_list(ref Ast ast, int id, int li, ref mut Emitter e) {
    while id >= 0 {
        cap_scan_node(ast, id, li, e);
        id = ast.nexts[id];
    }
}

/// bb 是否为子节点（Literal 存 LK、Ref 存 mutable 标志、Attributed 存属性数、MacroBlock 存计数）
fn bb_is_child(int tag) -> int {
    if tag == et(ET::Literal._tag) { return 0; }
    if tag == et(ET::Ref._tag) { return 0; }
    if tag == et(ET::MacroBlock._tag) { return 0; }
    if tag == st(ST::Attributed._tag) { return 0; }
    return 1;
}

/// cc/dd 为子节点的标签（if/for/index-assign）
fn ccdd_is_child(int tag) -> int {
    if tag == et(ET::If._tag) { return 1; }
    if tag == st(ST::If._tag) { return 1; }
    if tag == st(ST::For._tag) { return 1; }
    if tag == st(ST::IndexAssign._tag) { return 1; }
    return 0;
}

#[alloc]
fn cap_scan_node(ref Ast ast, int id, int li, ref mut Emitter e) {
    tag0 = ast.tags[id];
    if tag0 == et(ET::Ident._tag) {
        nm0 = ast.texts[id];
        kd0 = e.local_kind(nm0);
        if kd0 >= 0 {
            if e.lam_param_of(ast, li, nm0) == 1 { return; }
            ety0 = e.etype_of_local(nm0);
            e.cap_add(li, nm0, kd0, ety0, id);
        }
        return;
    }
    if tag0 == et(ET::Lambda._tag) {
        // 内层 lambda：其引用同样需要外层可见（捕获传递）
        cap_scan_list(ast, ast.bb[id], li, e);
        return;
    }
    if ast.aa[id] >= 0 {
        cap_scan_list(ast, ast.aa[id], li, e);
    }
    if ast.bb[id] >= 0 {
        if bb_is_child(tag0) == 1 {
            cap_scan_list(ast, ast.bb[id], li, e);
        }
    }
    if ccdd_is_child(tag0) == 1 {
        if ast.cc[id] >= 0 {
            cap_scan_list(ast, ast.cc[id], li, e);
        }
        if ast.dd[id] >= 0 {
            cap_scan_list(ast, ast.dd[id], li, e);
        }
    }
}

/// prelude 一元 int 调用：@fn(i64) -> i64（char 方法）
#[alloc]
fn emit_prelude_int1(ref String fname, ref String arg, ref mut Emitter e) -> Val {
    t = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(t);
    e.buf.push_str(" = call i64 @");
    e.buf.push_str(e.fn_sym(fname));
    e.buf.push_str("(i64 ");
    e.buf.push_str(arg);
    e.buf.push_str(")\n");
    return mk_int(t);
}

/// prelude String 辅助调用：@fn(ptr s, i64 len[, ptr arg, i64 arglen])；rk 1 返回 String
#[alloc]
fn emit_prelude_str(ref String fname, ref Val s, ref Val arg, int has_arg, int rk, ref mut Emitter e) -> Val {
    b = StringBuf::new();
    b.push_str("  ");
    t = e.fresh();
    b.push_str(t);
    if rk == 1 {
        b.push_str(" = call { ptr, i64 } ");
    } else {
        b.push_str(" = call i64 ");
    }
    b.push_str("@");
    b.push_str(e.fn_sym(fname));
    b.push_str("(ptr ");
    b.push_str(ptr_operand(s.a));
    b.push_str(", i64 ");
    b.push_str(s.b);
    if has_arg == 1 {
        b.push_str(", ptr ");
        b.push_str(ptr_operand(arg.a));
        b.push_str(", i64 ");
        b.push_str(arg.b);
    }
    b.push_str(")\n");
    e.buf.push_str(b.to_string());
    if rk == 1 {
        ip = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(ip);
        e.buf.push_str(" = extractvalue { ptr, i64 } ");
        e.buf.push_str(t);
        e.buf.push_str(", 0\n  ");
        il = e.fresh();
        e.buf.push_str(il);
        e.buf.push_str(" = extractvalue { ptr, i64 } ");
        e.buf.push_str(t);
        e.buf.push_str(", 1\n");
        return mk_str_tmp(ip, il);
    }
    return mk_int(t);
}

/// 索引读取：按元素类型装载（base 为数组值，idx 为下标临时名）
#[alloc]
fn emit_index_read(ref Ast ast, ref Val base3, ref String idx, ref mut Emitter e) -> Val {
        ety3 = base3.ty;
        lty4 = "i64";
        if ety3 >= 0 {
            lty4 = e.elem_llvm_m(ast, ety3);
        }
        g4 = elem_addr(e, elem_stride(ast, ety3), base3.a, idx);
        if elem_is_string(ast, ety3) {
            p4 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(p4);
            e.buf.push_str(" = load ptr, ptr ");
            e.buf.push_str(g4);
            e.buf.push_str("\n");
            g4b = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(g4b);
            e.buf.push_str(" = getelementptr i8, ptr ");
            e.buf.push_str(g4);
            e.buf.push_str(", i64 8\n");
            l4 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(l4);
            e.buf.push_str(" = load i64, ptr ");
            e.buf.push_str(g4b);
            e.buf.push_str("\n");
            return mk_str_tmp(p4, l4);
        }
        if lty4 == "ptr" {
            // 指针元素：结构体/枚举/其他指针值
            tp4 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(tp4);
            e.buf.push_str(" = load ptr, ptr ");
            e.buf.push_str(g4);
            e.buf.push_str("\n");
            if ety3 <= -1000 && ety3 > -1128 {
                return Val { kind = 2, a = tp4, b = e.st_names[0 - 1000 - ety3].copy(), ty = -1 };
            }
            if ety3 <= -2000 && ety3 > -2128 {
                return Val { kind = 4, a = tp4, b = e.en_names[0 - 2000 - ety3].copy(), ty = -1 };
            }
            etn4 = ty_name(ast, ety3);
            if etn4.len > 0 {
                si4 = e.find_struct_idx(etn4);
                if si4 >= 0 {
                    return Val { kind = 2, a = tp4, b = etn4.copy(), ty = -1 };
                }
                ei4i = e.find_enum_idx(etn4);
                if ei4i >= 0 {
                    return Val { kind = 4, a = tp4, b = etn4.copy(), ty = -1 };
                }
            }
            return mk_int(tp4);
        }
        if lty4 == "i8" {
            t4 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t4);
            e.buf.push_str(" = load i8, ptr ");
            e.buf.push_str(g4);
            e.buf.push_str("\n  ");
            s4 = e.fresh();
            e.buf.push_str(s4);
            e.buf.push_str(" = zext i8 ");
            e.buf.push_str(t4);
            e.buf.push_str(" to i64\n");
            return mk_int(s4);
        }
        if lty4 == "i32" {
            t5 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t5);
            e.buf.push_str(" = load i32, ptr ");
            e.buf.push_str(g4);
            e.buf.push_str("\n  ");
            s5 = e.fresh();
            e.buf.push_str(s5);
            e.buf.push_str(" = sext i32 ");
            e.buf.push_str(t5);
            e.buf.push_str(" to i64\n");
            return mk_int(s5);
        }
        t6 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(t6);
        e.buf.push_str(" = load ");
        e.buf.push_str(lty4);
        e.buf.push_str(", ptr ");
        e.buf.push_str(g4);
        e.buf.push_str("\n");
        if lty4 == "double" {
            return Val { kind = 0, a = t6, b = "", ty = ety3 };
        }
        return mk_int(t6);
    }

/// 结构体全局初始化函数：@__aya_init_globals（main 入口调用）
#[alloc]
fn emit_globals_init(ref Ast ast, ref mut Emitter e) {
    if e.need_ginit == 0 { return; }
    sv_buf2 = e.buf;
    sv_tmp2 = e.tmp;
    sv_lv2 = e.lv_count;
    sv_pre2 = e.pre_buf;
    sv_prea2 = e.pre_active;
    sv_term2 = e.terminated;
    sv_rt2 = e.cur_rtype;
    e.buf = StringBuf::new();
    e.tmp = 0;
    e.lv_count = 0;
    e.pre_buf = StringBuf::new();
    e.pre_active = 0;
    e.terminated = 0;
    e.buf.push_str("define void @__aya_init_globals() {\nentry:\n");
    i_g = 0;
    while i_g < e.g_count {
        if e.g_kinds[i_g] == 4 {
            v_g = emit_expr(ast, e.g_init_ids[i_g], e);
            pi_g = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(pi_g);
            e.buf.push_str(" = ptrtoint ptr ");
            e.buf.push_str(v_g.a);
            e.buf.push_str(" to i64\n  store i64 ");
            e.buf.push_str(pi_g);
            e.buf.push_str(", ptr @");
            e.buf.push_str(e.g_names[i_g]);
            e.buf.push_str("\n");
        }
        i_g = i_g + 1;
    }
    e.buf.push_str("  ret void\n}\n");
    e.ginit_buf.push_str(e.buf.to_string());
    e.buf = sv_buf2;
    e.tmp = sv_tmp2;
    e.lv_count = sv_lv2;
    e.pre_buf = sv_pre2;
    e.pre_active = sv_prea2;
    e.terminated = sv_term2;
    e.cur_rtype = sv_rt2;
}

/// 十进制文本 -> int（非纯数字返回 -1；载荷下标 _N 解析用）
fn dec_val_e(ref String s) -> int {
    if s.len == 0 { return -1; }
    v = 0;
    i = 0;
    while i < s.len as int {
        c = char_code(s.index(i as usize));
        if c < 48 || c > 57 { return -1; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v;
}

/// ---- #[compile_time] 编译期解释器（int 域；失败 -999999）----

/// 二元运算求值
fn ct_binop(int op, int a, int b) -> int {
    if op == bo(BinOp::Add._tag) { return a + b; }
    if op == bo(BinOp::Sub._tag) { return a - b; }
    if op == bo(BinOp::Mul._tag) { return a * b; }
    if op == bo(BinOp::Div._tag) { if b == 0 { return -999999; } return a / b; }
    if op == bo(BinOp::Mod._tag) { if b == 0 { return -999999; } return a % b; }
    if op == bo(BinOp::BitAnd._tag) { return a & b; }
    if op == bo(BinOp::BitOr._tag) { return a | b; }
    if op == bo(BinOp::BitXor._tag) { return a ^ b; }
    if op == bo(BinOp::Shl._tag) { return a << b; }
    if op == bo(BinOp::Shr._tag) { return a >> b; }
    if op == bo(BinOp::Eq._tag) { if a == b { return 1; } return 0; }
    if op == bo(BinOp::Neq._tag) { if a != b { return 1; } return 0; }
    if op == bo(BinOp::Lt._tag) { if a < b { return 1; } return 0; }
    if op == bo(BinOp::Gt._tag) { if a > b { return 1; } return 0; }
    if op == bo(BinOp::Le._tag) { if a <= b { return 1; } return 0; }
    if op == bo(BinOp::Ge._tag) { if a >= b { return 1; } return 0; }
    if op == bo(BinOp::And._tag) { if a != 0 && b != 0 { return 1; } return 0; }
    if op == bo(BinOp::Or._tag) { if a != 0 || b != 0 { return 1; } return 0; }
    return -999999;
}

/// 解释语句链：0=正常 1=return -1=失败
fn ct_block(ref Ast ast, int stmts, ref mut Emitter e) -> int {
    st = stmts;
    while st >= 0 {
        r = ct_stmt(ast, st, e);
        if r != 0 { return r; }
        st = ast.nexts[st];
    }
    return 0;
}

/// 解释 if 的 then/elif/else 取值（表达式形式）
fn ct_if_value(ref Ast ast, int id, ref mut Emitter e) -> int {
    c = ct_expr(ast, ast.aa[id], e);
    if c == -999999 { return -999999; }
    if c != 0 {
        return ct_branch_value(ast, ast.bb[id], e);
    }
    en = ast.cc[id];
    while en >= 0 {
        c2 = ct_expr(ast, ast.aa[en], e);
        if c2 == -999999 { return -999999; }
        if c2 != 0 {
            return ct_branch_value(ast, ast.bb[en], e);
        }
        en = ast.nexts[en];
    }
    if ast.dd[id] >= 0 {
        return ct_branch_value(ast, ast.dd[id], e);
    }
    return -999999;
}

/// 解释分支块取值（语句 + 尾表达式）
fn ct_branch_value(ref Ast ast, int blk, ref mut Emitter e) -> int {
    if blk < 0 { return -999999; }
    base = e.ct_env_count;
    r = ct_block(ast, ast.aa[blk], e);
    res = -999999;
    if r == 1 {
        res = e.ct_ret;
    } elif r == 0 {
        t = ast.bb[blk];
        if t >= 0 { res = ct_expr(ast, t, e); }
    }
    e.ct_env_count = base;
    return res;
}

fn ct_stmt(ref Ast ast, int id, ref mut Emitter e) -> int {
    tag = ast.tags[id];
    if tag == st(ST::Assign._tag) {
        v = ct_expr(ast, ast.aa[id], e);
        if v == -999999 { return -1; }
        e.ct_set(ast.texts[id], v);
        return 0;
    }
    if tag == st(ST::Return._tag) {
        if ast.aa[id] >= 0 {
            v2 = ct_expr(ast, ast.aa[id], e);
            if v2 == -999999 { return -1; }
            e.ct_ret = v2;
        }
        return 1;
    }
    if tag == st(ST::If._tag) {
        // 语句语义：分支内的 return 必须向外传播（勿用表达式求值）
        c3 = ct_expr(ast, ast.aa[id], e);
        if c3 == -999999 { return -1; }
        if c3 != 0 { return ct_block(ast, ast.aa[ast.bb[id]], e); }
        en3 = ast.cc[id];
        while en3 >= 0 {
            c4 = ct_expr(ast, ast.aa[en3], e);
            if c4 == -999999 { return -1; }
            if c4 != 0 { return ct_block(ast, ast.aa[ast.bb[en3]], e); }
            en3 = ast.nexts[en3];
        }
        if ast.dd[id] >= 0 { return ct_block(ast, ast.aa[ast.dd[id]], e); }
        return 0;
    }
    if tag == st(ST::For._tag) {
        a1 = ct_expr(ast, ast.aa[id], e);
        b1 = ct_expr(ast, ast.bb[id], e);
        c1 = 1;
        if ast.cc[id] >= 0 {
            c1 = ct_expr(ast, ast.cc[id], e);
        }
        if a1 == -999999 || b1 == -999999 || c1 == -999999 { return -1; }
        if c1 == 0 { return -1; }
        base4 = e.ct_env_count;
        i1 = a1;
        while i1 < b1 {
            e.ct_set(ast.texts[id], i1);
            r4 = ct_block(ast, ast.aa[ast.dd[id]], e);
            if r4 != 0 { return r4; }
            e.ct_env_count = base4;
            i1 = i1 + c1;
        }
        e.ct_env_count = base4;
        return 0;
    }
    if tag == st(ST::ExprStmt._tag) {
        v5 = ct_expr(ast, ast.aa[id], e);
        if v5 == -999999 { return -1; }
        return 0;
    }
    if tag == st(ST::Block._tag) {
        return ct_block(ast, ast.aa[id], e);
    }
    return -1;
}

fn ct_expr(ref Ast ast, int id, ref mut Emitter e) -> int {
    if id < 0 { return -999999; }
    tag = ast.tags[id];
    if tag == et(ET::Literal._tag) {
        sv = const_int(ast, id);
        if sv.len == 0 { return -999999; }
        return str_to_int_ok(sv);
    }
    if tag == et(ET::Ident._tag) {
        nm = ast.texts[id];
        v = e.ct_get(nm);
        if v != -999999 { return v; }
        g = e.global_val(nm);
        if g.len == 0 { return -999999; }
        return str_to_int_ok(g);
    }
    if tag == et(ET::Binary._tag) {
        a = ct_expr(ast, ast.aa[id], e);
        if a == -999999 { return -999999; }
        b = ct_expr(ast, ast.bb[id], e);
        if b == -999999 { return -999999; }
        return ct_binop(ast.tys[id], a, b);
    }
    if tag == et(ET::Unary._tag) {
        a2 = ct_expr(ast, ast.aa[id], e);
        if a2 == -999999 { return -999999; }
        op2 = ast.tys[id];
        if op2 == uo(UnOp::Neg._tag) { return 0 - a2; }
        if op2 == uo(UnOp::Not._tag) { if a2 == 0 { return 1; } return 0; }
        if op2 == uo(UnOp::BitNot._tag) { return ~a2; }
        return -999999;
    }
    if tag == et(ET::If._tag) {
        return ct_if_value(ast, id, e);
    }
    if tag == et(ET::FnCall._tag) {
        fid = e.ct_find(ast.texts[id]);
        if fid < 0 { return -999999; }
        n = 0;
        a3 = ast.aa[id];
        while a3 >= 0 {
            av = ct_expr(ast, ast.aa[a3], e);
            if av == -999999 { return -999999; }
            if n < 16 { e.ct_args[n] = av; }
            n = n + 1;
            a3 = ast.nexts[a3];
        }
        return ct_call(ast, fid, n, e);
    }
    if tag == et(ET::Cast._tag) {
        return ct_expr(ast, ast.aa[id], e);
    }
    return -999999;
}

/// 解释 #[compile_time] 函数调用
fn ct_call(ref Ast ast, int fn_id, int nargs, ref mut Emitter e) -> int {
    if e.ct_depth > 64 { return -999999; }
    e.ct_depth = e.ct_depth + 1;
    base = e.ct_env_count;
    sv_frame = e.ct_frame;
    e.ct_frame = base;
    p = ast.aa[fn_id];
    i = 0;
    while p >= 0 {
        if i < nargs { e.ct_set(ast.texts[p], e.ct_args[i]); }
        i = i + 1;
        p = ast.nexts[p];
    }
    res = -999999;
    r = ct_block(ast, ast.aa[ast.bb[fn_id]], e);
    if r == 1 {
        res = e.ct_ret;
    } elif r == 0 {
        tail = ast.bb[ast.bb[fn_id]];
        if tail >= 0 { res = ct_expr(ast, tail, e); }
    }
    e.ct_env_count = base;
    e.ct_frame = sv_frame;
    e.ct_depth = e.ct_depth - 1;
    return res;
}

fn emit_expr(ref Ast ast, int id, ref mut Emitter e) -> Val {
    if id < 0 { return mk_int("0"); }
    tag = ast.tags[id];
    if tag == et(ET::Literal._tag) {
        k = ast.bb[id];
        if k == lk(LK::Int._tag) {
            dec = int_text_ok(ast.texts[id]);
            if dec.len > 0 { return mk_int(dec); }
            return mk_int(ast.texts[id]);
        }
        if k == lk(LK::Bool._tag) {
            if ast.texts[id] == "true" { return mk_int("1"); }
            return mk_int("0");
        }
        if k == lk(LK::Float._tag) {
            return mk_float(float_text(ast.texts[id]));
        }
        if k == lk(LK::Str._tag) {
            si = e.add_str(ast.texts[id]);
            b = StringBuf::new();
            b.push_str("@.str.");
            b.push_int(si);
            return mk_str(b.to_string(), ast.texts[id].len as int);
        }
        if k == lk(LK::Char._tag) {
            t = ast.texts[id];
            if t.len == 0 { return mk_int("0"); }
            cb = StringBuf::new();
            cb.push_int(char_code(t.index(0)));
            return mk_int(cb.to_string());
        }
        return mk_int("0");
    }
    if tag == et(ET::Suffixed._tag) {
        // 后缀字面量（1usize / 3f64）：f32/f64 按浮点
        sufx = ast.texts[id];
        if sufx == "f32" || sufx == "f64" {
            return mk_float(float_text(ast.texts[ast.aa[id]]));
        }
        return emit_expr(ast, ast.aa[id], e);
    }
    if tag == et(ET::Ident._tag) {
        nm = ast.texts[id];
        gk = e.global_kind(nm);
        if gk == 0 {
            t = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t);
            e.buf.push_str(" = load i64, ptr @");
            e.buf.push_str(nm);
            e.buf.push_str("\n");
            return mk_int(t);
        }
        if gk == 2 {
            return mk_arr("@" + nm, -1);
        }
        if gk == 3 {
            fdg = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(fdg);
            e.buf.push_str(" = load double, ptr @");
            e.buf.push_str(nm);
            e.buf.push_str("\n");
            return mk_float(fdg);
        }
        if gk == 4 {
            // 结构体全局：装载堆指针
            t_g4 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t_g4);
            e.buf.push_str(" = load i64, ptr @");
            e.buf.push_str(nm);
            e.buf.push_str("\n  ");
            p_g4 = e.fresh();
            e.buf.push_str(p_g4);
            e.buf.push_str(" = inttoptr i64 ");
            e.buf.push_str(t_g4);
            e.buf.push_str(" to ptr\n");
            gi_g4 = e.global_idx(nm);
            sn_g4 = "";
            if gi_g4 >= 0 {
                sti = e.g_stype[gi_g4];
                if sti >= 0 && sti < e.st_count { sn_g4 = e.st_names[sti].copy(); }
            }
            return Val { kind = 2, a = p_g4, b = sn_g4, ty = -1 };
        }
        if contains_dot2(nm) {
