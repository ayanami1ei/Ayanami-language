            e.buf.push_str("  ");
            e.buf.push_str(t3);
            e.buf.push_str(" = sub i64 0, ");
            e.buf.push_str(at.a);
            e.buf.push_str("\n");
            return mk_int(t3);
        }
        if op == uo(UnOp::BitNot._tag) {
            tbn = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(tbn);
            e.buf.push_str(" = xor i64 ");
            e.buf.push_str(at.a);
            e.buf.push_str(", -1\n");
            return mk_int(tbn);
