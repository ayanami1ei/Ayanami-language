            pi2 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(pi2);
            e.buf.push_str(" = inttoptr i64 ");
            e.buf.push_str(t4);
            e.buf.push_str(" to ptr\n");
            return Val { kind = 2, a = pi2, b = rnm, ty = -1 };
        }
