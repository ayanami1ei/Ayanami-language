import "string";
import "aya_sb";
import "aya_ast";

// M5b：AST -> LLVM IR 文本（int/bool/String 子集）
// 值表示：Val { kind: 0=int, 1=String(ptr,len), 2=struct(ptr,类型名) }
pub struct Val {
    int kind
    String a
    String b
}

pub struct Emitter {
    StringBuf buf
    int tmp
    [String] locals
    [int] local_kinds
    int lv_count
    [String] strs
    int str_count
    // 结构体表（字段扁平）
    [String] st_names
    [int] st_fstart
    [int] st_fcount
    [String] st_fields
    int st_ftotal
    int st_count
    // 方法表：(类型, 方法名) -> FnDecl id
    [String] m_ty
    [String] m_name
    [int] m_id
    int m_count
}

pub namespace Emitter {
    pub fn new() -> Emitter {
        e = Emitter {
            buf = StringBuf::new(), tmp = 0,
            locals = [String; 512], local_kinds = [int; 512], lv_count = 0,
            strs = [String; 256], str_count = 0,
            st_names = [String; 128], st_fstart = [int; 128], st_fcount = [int; 128],
            st_fields = [String; 1024], st_ftotal = 0, st_count = 0,
            m_ty = [String; 256], m_name = [String; 256], m_id = [int; 256], m_count = 0
        };
        return e;
    }
}

fn mk_int(ref String t) -> Val {
    return Val { kind = 0, a = t.copy(), b = "" };
}

fn mk_str(ref String ptr, int len) -> Val {
    b = StringBuf::new();
    b.push_int(len);
    return Val { kind = 1, a = ptr.copy(), b = b.to_string() };
}

impl Emitter {
    fn fresh(ref mut self) -> String {
        b = StringBuf::new();
        b.push_str("%t");
        b.push_int(self.tmp);
        self.tmp = self.tmp + 1;
        return b.to_string();
    }

    fn local_kind(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.lv_count {
            if self.locals[i] == name { return self.local_kinds[i]; }
            i = i + 1;
        }
        return -1;
    }

    fn declare_local(ref mut self, ref String name, int kind) {
        if self.local_kind(name) >= 0 { return; }
        if self.lv_count < 512 {
            self.locals[self.lv_count] = name.copy();
            self.local_kinds[self.lv_count] = kind;
            self.lv_count = self.lv_count + 1;
        }
        if kind == 1 {
            self.buf.push_str("  %v_");
            self.buf.push_str(name);
            self.buf.push_str(".ptr = alloca ptr\n  %v_");
            self.buf.push_str(name);
            self.buf.push_str(".len = alloca i64\n");
        } elif kind >= 2 {
            self.buf.push_str("  %v_");
            self.buf.push_str(name);
            self.buf.push_str(" = alloca ptr\n");
        } else {
            self.buf.push_str("  %v_");
            self.buf.push_str(name);
            self.buf.push_str(" = alloca i64\n");
        }
    }

    /// struct 局部变量的类型名（kind 2 的局部）
    fn struct_of_local(ref mut self, ref String name) -> String {
        i = 0;
        while i < self.lv_count {
            if self.locals[i] == name {
                if self.local_kinds[i] >= 100 {
                    // kind 编码：100 + 结构体下标
                    si = self.local_kinds[i] - 100;
                    if si < self.st_count { return self.st_names[si].copy(); }
                }
            }
            i = i + 1;
        }
        return "";
    }

    fn find_struct_idx(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.st_count {
            if self.st_names[i] == name { return i; }
            i = i + 1;
        }
        return -1;
    }

    fn find_field_idx(ref mut self, ref String stname, ref String fname) -> int {
        si = self.find_struct_idx(stname);
        if si < 0 { return -1; }
        start = self.st_fstart[si];
        n = self.st_fcount[si];
        i = 0;
        while i < n {
            if self.st_fields[start + i] == fname { return i; }
            i = i + 1;
        }
        return -1;
    }

    fn find_method_id(ref mut self, ref String ty, ref String name) -> int {
        i = 0;
        while i < self.m_count {
            if self.m_ty[i] == ty {
                if self.m_name[i] == name { return self.m_id[i]; }
            }
            i = i + 1;
        }
        return -1;
    }

    fn add_struct(ref mut self, ref Ast ast, int id) {
        if self.st_count >= 128 { return; }
        si = self.st_count;
        self.st_names[si] = ast.texts[id].copy();
        self.st_fstart[si] = self.st_ftotal;
        n = 0;
        f = ast.aa[id];
        while f >= 0 {
            if self.st_ftotal < 1024 {
                self.st_fields[self.st_ftotal] = ast.texts[f].copy();
                self.st_ftotal = self.st_ftotal + 1;
                n = n + 1;
            }
            f = ast.nexts[f];
        }
        self.st_fcount[si] = n;
        self.st_count = si + 1;
    }

    fn add_method(ref mut self, ref Ast ast, ref String ty, int fid) {
        if self.m_count >= 256 { return; }
        self.m_ty[self.m_count] = ty.copy();
        self.m_name[self.m_count] = ast.texts[fid].copy();
        self.m_id[self.m_count] = fid;
        self.m_count = self.m_count + 1;
    }

    fn collect_decls(ref mut self, ref Ast ast, int prog) {
        s = ast.aa[prog];
        while s >= 0 {
            if ast.tags[s] == st(ST::StructDef._tag) {
                self.add_struct(ast, s);
            } elif ast.tags[s] == st(ST::ImplBlock._tag) {
                m = ast.aa[s];
                while m >= 0 {
                    if ast.tags[m] == st(ST::FnDecl._tag) {
                        self.add_method(ast, ast.texts[s], m);
                    }
                    m = ast.nexts[m];
                }
            }
            s = ast.nexts[s];
        }
    }

    /// 注册字符串字面量，返回全局名与长度（存入 strs）
    fn add_str(ref mut self, ref String text) -> int {
        idx = self.str_count;
        if idx < 256 {
            self.strs[idx] = text.copy();
            self.str_count = idx + 1;
        }
        return idx;
    }
}

/// LLVM c"..." 转义（UTF-8 字节）
fn escape_ir(ref String s) -> String {
    b = StringBuf::new();
    i = 0;
    while i < s.len as int {
        c = char_code(s.index(i as usize));
        if c == 34 {
            b.push_str("\\22");
        } elif c == 92 {
            b.push_str("\\5c");
        } elif c == 10 {
            b.push_str("\\0a");
        } elif c == 13 {
            b.push_str("\\0d");
        } elif c == 9 {
            b.push_str("\\09");
        } elif c >= 32 && c <= 126 {
            b.push(__ayanami_int_to_char(c));
        } else {
            b.push_str("\\");
            h = c / 16;
            l = c % 16;
            b.push(hex_digit(h));
            b.push(hex_digit(l));
        }
        i = i + 1;
    }
    return b.to_string();
}

fn hex_digit(int v) -> char {
    if v < 10 { return __ayanami_int_to_char(48 + v); }
    return __ayanami_int_to_char(87 + v);
}

extern "C" fn __ayanami_int_to_char(int c) -> char;

fn bin_llvm_op(int op) -> String {
    if op == bo(BinOp::Add._tag) { return "add"; }
    if op == bo(BinOp::Sub._tag) { return "sub"; }
    if op == bo(BinOp::Mul._tag) { return "mul"; }
    if op == bo(BinOp::Div._tag) { return "sdiv"; }
    if op == bo(BinOp::Mod._tag) { return "srem"; }
    return "";
}

fn cmp_llvm_op(int op) -> String {
    if op == bo(BinOp::Eq._tag) { return "eq"; }
    if op == bo(BinOp::Neq._tag) { return "ne"; }
    if op == bo(BinOp::Lt._tag) { return "slt"; }
    if op == bo(BinOp::Gt._tag) { return "sgt"; }
    if op == bo(BinOp::Le._tag) { return "sle"; }
    if op == bo(BinOp::Ge._tag) { return "sge"; }
    return "";
}

fn is_cmp(int op) -> bool {
    if op == bo(BinOp::Eq._tag) { return true; }
    if op == bo(BinOp::Neq._tag) { return true; }
    if op == bo(BinOp::Lt._tag) { return true; }
    if op == bo(BinOp::Gt._tag) { return true; }
    if op == bo(BinOp::Le._tag) { return true; }
    if op == bo(BinOp::Ge._tag) { return true; }
    return false;
}

fn label(ref mut Emitter e, ref String prefix) -> String {
    b = StringBuf::new();
    b.push_str(prefix);
    b.push_int(e.tmp);
    e.tmp = e.tmp + 1;
    return b.to_string();
}

fn emit_expr(ref Ast ast, int id, ref mut Emitter e) -> Val {
    if id < 0 { return mk_int("0"); }
    tag = ast.tags[id];
    if tag == et(ET::Literal._tag) {
        k = ast.bb[id];
        if k == lk(LK::Int._tag) {
            return mk_int(ast.texts[id]);
        }
        if k == lk(LK::Bool._tag) {
            if ast.texts[id] == "true" { return mk_int("1"); }
            return mk_int("0");
        }
        if k == lk(LK::Str._tag) {
            si = e.add_str(ast.texts[id]);
            b = StringBuf::new();
            b.push_str("@.str.");
            b.push_int(si);
            return mk_str(b.to_string(), ast.texts[id].len as int);
        }
        return mk_int("0");
    }
    if tag == et(ET::Suffixed._tag) {
        return mk_int(ast.texts[id].copy());
    }
    if tag == et(ET::Ident._tag) {
        nm = ast.texts[id];
        kd = e.local_kind(nm);
        if kd >= 2 {
            e.declare_local(nm, 2);
            t = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t);
            e.buf.push_str(" = load ptr, ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str("
");
            return Val { kind = 2, a = t, b = e.struct_of_local(nm) };
        }
        if kd == 1 {
            p = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(p);
            e.buf.push_str(" = load ptr, ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str(".ptr\n");
            l = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(l);
            e.buf.push_str(" = load i64, ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str(".len\n");
            return Val { kind = 1, a = p, b = l };
        }
        e.declare_local(nm, 0);
        t = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(t);
        e.buf.push_str(" = load i64, ptr %v_");
        e.buf.push_str(nm);
        e.buf.push_str("\n");
        return mk_int(t);
    }
    if tag == et(ET::Binary._tag) {
        op = ast.tys[id];
        lt = emit_expr(ast, ast.aa[id], e);
        rt = emit_expr(ast, ast.bb[id], e);
        if is_cmp(op) {
            c = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(c);
            e.buf.push_str(" = icmp ");
            e.buf.push_str(cmp_llvm_op(op));
            e.buf.push_str(" i64 ");
            e.buf.push_str(lt.a);
            e.buf.push_str(", ");
            e.buf.push_str(rt.a);
            e.buf.push_str("\n");
            z = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(z);
            e.buf.push_str(" = zext i1 ");
            e.buf.push_str(c);
            e.buf.push_str(" to i64\n");
            return mk_int(z);
        }
        if op == bo(BinOp::And._tag) || op == bo(BinOp::Or._tag) {
            a = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(a);
            e.buf.push_str(" = icmp ne i64 ");
            e.buf.push_str(lt.a);
            e.buf.push_str(", 0\n");
            b2 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(b2);
            e.buf.push_str(" = icmp ne i64 ");
            e.buf.push_str(rt.a);
            e.buf.push_str(", 0\n");
            c2 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(c2);
            if op == bo(BinOp::And._tag) {
                e.buf.push_str(" = and i1 ");
            } else {
                e.buf.push_str(" = or i1 ");
            }
            e.buf.push_str(a);
            e.buf.push_str(", ");
            e.buf.push_str(b2);
            e.buf.push_str("\n");
            z2 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(z2);
            e.buf.push_str(" = zext i1 ");
            e.buf.push_str(c2);
            e.buf.push_str(" to i64\n");
            return mk_int(z2);
        }
        t2 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(t2);
        e.buf.push_str(" = ");
        e.buf.push_str(bin_llvm_op(op));
        e.buf.push_str(" i64 ");
        e.buf.push_str(lt.a);
        e.buf.push_str(", ");
        e.buf.push_str(rt.a);
        e.buf.push_str("\n");
        return mk_int(t2);
    }
    if tag == et(ET::Unary._tag) {
        at = emit_expr(ast, ast.aa[id], e);
        op = ast.tys[id];
        if op == uo(UnOp::Neg._tag) {
            t3 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t3);
            e.buf.push_str(" = sub i64 0, ");
            e.buf.push_str(at.a);
            e.buf.push_str("\n");
            return mk_int(t3);
        }
        if op == uo(UnOp::Not._tag) {
            a3 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(a3);
            e.buf.push_str(" = icmp eq i64 ");
            e.buf.push_str(at.a);
            e.buf.push_str(", 0\n");
            z3 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(z3);
            e.buf.push_str(" = zext i1 ");
            e.buf.push_str(a3);
            e.buf.push_str(" to i64\n");
            return mk_int(z3);
        }
        return at;
    }
    if tag == et(ET::FnCall._tag) {
        nm = ast.texts[id];
        if nm == "println" || nm == "print" {
            a = ast.aa[id];
            if a >= 0 {
                v = emit_expr(ast, ast.aa[a], e);
                if v.kind == 1 {
                    e.buf.push_str("  call void @__ayanami_print_str(ptr ");
                    e.buf.push_str(v.a);
                    e.buf.push_str(", i64 ");
                    e.buf.push_str(v.b);
                    e.buf.push_str(")\n");
                } else {
                    e.buf.push_str("  call void @__ayanami_print_int(i64 ");
                    e.buf.push_str(v.a);
                    e.buf.push_str(")\n");
                }
            }
            if nm == "println" {
                e.buf.push_str("  call void @__ayanami_print_ln()\n");
            }
            return mk_int("0");
        }
        b = StringBuf::new();
        b.push_str("  ");
        t4 = e.fresh();
        b.push_str(t4);
        b.push_str(" = call i64 @");
        b.push_str(nm);
        b.push_str("(");
        first = 1;
        a2 = ast.aa[id];
        while a2 >= 0 {
            at2 = emit_expr(ast, ast.aa[a2], e);
            if first == 0 { b.push_str(", "); }
            b.push_str("i64 ");
            b.push_str(at2.a);
            first = 0;
            a2 = ast.nexts[a2];
        }
        b.push_str(")\n");
        e.buf.push_str(b.to_string());
        return mk_int(t4);
    }
    if tag == et(ET::StructLiteral._tag) {
        nm = ast.texts[id];
        t = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(t);
        e.buf.push_str(" = alloca %struct.");
        e.buf.push_str(nm);
        e.buf.push_str("\n");
        f = ast.aa[id];
        while f >= 0 {
            idx = e.find_field_idx(nm, ast.texts[f]);
            if idx >= 0 {
                v = emit_expr(ast, ast.aa[f], e);
                g = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(g);
                e.buf.push_str(" = getelementptr %struct.");
                e.buf.push_str(nm);
                e.buf.push_str(", ptr ");
                e.buf.push_str(t);
                e.buf.push_str(", i32 0, i32 ");
                e.buf.push_int(idx);
                e.buf.push_str("\n  store i64 ");
                e.buf.push_str(v.a);
                e.buf.push_str(", ptr ");
                e.buf.push_str(g);
                e.buf.push_str("\n");
            }
            f = ast.nexts[f];
        }
        return Val { kind = 2, a = t, b = nm.copy() };
    }
    if tag == et(ET::FieldAccess._tag) {
        obj = emit_expr(ast, ast.aa[id], e);
        if obj.kind == 2 {
            idx = e.find_field_idx(obj.b, ast.texts[id]);
            if idx >= 0 {
                g2 = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(g2);
                e.buf.push_str(" = getelementptr %struct.");
                e.buf.push_str(obj.b);
                e.buf.push_str(", ptr ");
                e.buf.push_str(obj.a);
                e.buf.push_str(", i32 0, i32 ");
                e.buf.push_int(idx);
                e.buf.push_str("\n");
                v2 = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(v2);
                e.buf.push_str(" = load i64, ptr ");
                e.buf.push_str(g2);
                e.buf.push_str("\n");
                return mk_int(v2);
            }
        }
        return mk_int("0");
    }
    if tag == et(ET::MethodCall._tag) {
        obj = emit_expr(ast, ast.aa[id], e);
        mid = -1;
        if obj.kind == 2 {
            mid = e.find_method_id(obj.b, ast.texts[id]);
        }
        if mid >= 0 {
            b3 = StringBuf::new();
            b3.push_str("  ");
            t5 = e.fresh();
            b3.push_str(t5);
            b3.push_str(" = call i64 @");
            b3.push_str(obj.b);
            b3.push_str(".");
            b3.push_str(ast.texts[id]);
            b3.push_str("(ptr ");
            b3.push_str(obj.a);
            a3 = ast.bb[id];
            while a3 >= 0 {
                at3 = emit_expr(ast, ast.aa[a3], e);
                b3.push_str(", i64 ");
                b3.push_str(at3.a);
                a3 = ast.nexts[a3];
            }
            b3.push_str(")\n");
            e.buf.push_str(b3.to_string());
            return mk_int(t5);
        }
        return mk_int("0");
    }
    if tag == et(ET::Cast._tag) {
        return emit_expr(ast, ast.aa[id], e);
    }
    return mk_int("0");
}

fn emit_stmts(ref Ast ast, int stmts, ref mut Emitter e) {
    s = stmts;
    while s >= 0 {
        emit_stmt(ast, s, e);
        s = ast.nexts[s];
    }
}

fn emit_stmt(ref Ast ast, int id, ref mut Emitter e) {
    tag = ast.tags[id];
    if tag == st(ST::Assign._tag) {
        v = emit_expr(ast, ast.aa[id], e);
        nm = ast.texts[id];
        if v.kind == 2 {
            si2 = e.find_struct_idx(v.b);
            e.declare_local(nm, 100 + si2);
            e.buf.push_str("  store ptr ");
            e.buf.push_str(v.a);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str("\n");
            return;
        }
        if v.kind == 1 {
            e.declare_local(nm, 1);
            e.buf.push_str("  store ptr ");
            e.buf.push_str(v.a);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str(".ptr\n  store i64 ");
            e.buf.push_str(v.b);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str(".len\n");
        } else {
            e.declare_local(nm, 0);
            e.buf.push_str("  store i64 ");
            e.buf.push_str(v.a);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str("\n");
        }
    } elif tag == st(ST::Return._tag) {
        if ast.aa[id] >= 0 {
            v2 = emit_expr(ast, ast.aa[id], e);
            e.buf.push_str("  ret i64 ");
            e.buf.push_str(v2.a);
            e.buf.push_str("\n");
        } else {
            e.buf.push_str("  ret i64 0\n");
        }
    } elif tag == st(ST::ExprStmt._tag) {
        emit_expr(ast, ast.aa[id], e);
    } elif tag == st(ST::FieldAssign._tag) {
        obj = emit_expr(ast, ast.aa[id], e);
        if obj.kind == 2 {
            idx = e.find_field_idx(obj.b, ast.texts[id]);
            if idx >= 0 {
                v = emit_expr(ast, ast.bb[id], e);
                g = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(g);
                e.buf.push_str(" = getelementptr %struct.");
                e.buf.push_str(obj.b);
                e.buf.push_str(", ptr ");
                e.buf.push_str(obj.a);
                e.buf.push_str(", i32 0, i32 ");
                e.buf.push_int(idx);
                e.buf.push_str("\n  store i64 ");
                e.buf.push_str(v.a);
                e.buf.push_str(", ptr ");
                e.buf.push_str(g);
                e.buf.push_str("\n");
            }
        }
    } elif tag == st(ST::If._tag) {
        c = emit_expr(ast, ast.aa[id], e);
        then_l = label(e, "if.then.");
        else_l = label(e, "if.else.");
        end_l = label(e, "if.end.");
        cc = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(cc);
        e.buf.push_str(" = icmp ne i64 ");
        e.buf.push_str(c.a);
        e.buf.push_str(", 0\n  br i1 ");
        e.buf.push_str(cc);
        e.buf.push_str(", label %");
        e.buf.push_str(then_l);
        e.buf.push_str(", label %");
        e.buf.push_str(else_l);
        e.buf.push_str("\n");
        e.buf.push_str(then_l);
        e.buf.push_str(":\n");
        emit_stmts(ast, ast.aa[ast.bb[id]], e);
        e.buf.push_str("  br label %");
        e.buf.push_str(end_l);
        e.buf.push_str("\n");
        e.buf.push_str(else_l);
        e.buf.push_str(":\n");
        e2 = ast.dd[id];
        if e2 >= 0 {
            emit_stmts(ast, ast.aa[e2], e);
        }
        e.buf.push_str("  br label %");
        e.buf.push_str(end_l);
        e.buf.push_str("\n");
        e.buf.push_str(end_l);
        e.buf.push_str(":\n");
    } elif tag == st(ST::While._tag) {
        cond_l = label(e, "while.cond.");
        body_l = label(e, "while.body.");
        end_l = label(e, "while.end.");
        e.buf.push_str("  br label %");
        e.buf.push_str(cond_l);
        e.buf.push_str("\n");
        e.buf.push_str(cond_l);
        e.buf.push_str(":\n");
        c2 = emit_expr(ast, ast.aa[id], e);
        cc2 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(cc2);
        e.buf.push_str(" = icmp ne i64 ");
        e.buf.push_str(c2.a);
        e.buf.push_str(", 0\n  br i1 ");
        e.buf.push_str(cc2);
        e.buf.push_str(", label %");
        e.buf.push_str(body_l);
        e.buf.push_str(", label %");
        e.buf.push_str(end_l);
        e.buf.push_str("\n");
        e.buf.push_str(body_l);
        e.buf.push_str(":\n");
        emit_stmts(ast, ast.aa[ast.bb[id]], e);
        e.buf.push_str("  br label %");
        e.buf.push_str(cond_l);
        e.buf.push_str("\n");
        e.buf.push_str(end_l);
        e.buf.push_str(":\n");
    } elif tag == st(ST::For._tag) {
        e.declare_local(ast.texts[id], 0);
        v = emit_expr(ast, ast.aa[id], e);
        e.buf.push_str("  store i64 ");
        e.buf.push_str(v.a);
        e.buf.push_str(", ptr %v_");
        e.buf.push_str(ast.texts[id]);
        e.buf.push_str("\n");
        cond_l = label(e, "for.cond.");
        body_l = label(e, "for.body.");
        end_l = label(e, "for.end.");
        e.buf.push_str("  br label %");
        e.buf.push_str(cond_l);
        e.buf.push_str("\n");
        e.buf.push_str(cond_l);
        e.buf.push_str(":\n");
        iv = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(iv);
        e.buf.push_str(" = load i64, ptr %v_");
        e.buf.push_str(ast.texts[id]);
        e.buf.push_str("\n");
        ev = emit_expr(ast, ast.bb[id], e);
        c3 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(c3);
        e.buf.push_str(" = icmp slt i64 ");
        e.buf.push_str(iv);
        e.buf.push_str(", ");
        e.buf.push_str(ev.a);
        e.buf.push_str("\n  br i1 ");
        e.buf.push_str(c3);
        e.buf.push_str(", label %");
        e.buf.push_str(body_l);
        e.buf.push_str(", label %");
        e.buf.push_str(end_l);
        e.buf.push_str("\n");
        e.buf.push_str(body_l);
        e.buf.push_str(":\n");
        emit_stmts(ast, ast.aa[ast.dd[id]], e);
        iv2 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(iv2);
        e.buf.push_str(" = load i64, ptr %v_");
        e.buf.push_str(ast.texts[id]);
        e.buf.push_str("\n");
        nx = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(nx);
        e.buf.push_str(" = add i64 ");
        e.buf.push_str(iv2);
        e.buf.push_str(", 1\n  store i64 ");
        e.buf.push_str(nx);
        e.buf.push_str(", ptr %v_");
        e.buf.push_str(ast.texts[id]);
        e.buf.push_str("\n  br label %");
        e.buf.push_str(cond_l);
        e.buf.push_str("\n");
        e.buf.push_str(end_l);
        e.buf.push_str(":\n");
    }
}

fn emit_fn(ref Ast ast, int id, ref mut Emitter e) {
    emit_fn_named(ast, id, "", e);
}

fn emit_fn_named(ref Ast ast, int id, ref String prefix, ref mut Emitter e) {
    e.tmp = 0;
    e.lv_count = 0;
    name = ast.texts[id];
    e.buf.push_str("define i64 @");
    if prefix.len > 0 {
        e.buf.push_str(prefix);
        e.buf.push_str(".");
    }
    e.buf.push_str(name);
    e.buf.push_str("(");
    first = 1;
    p = ast.aa[id];
    idx = 0;
    while p >= 0 {
        if first == 0 { e.buf.push_str(", "); }
        if ast.texts[p] == "self" {
            e.buf.push_str("ptr %self");
        } else {
            e.buf.push_str("i64 %a");
            e.buf.push_int(idx);
        }
        first = 0;
        idx = idx + 1;
        p = ast.nexts[p];
    }
    e.buf.push_str(") {\nentry:\n");
    p2 = ast.aa[id];
    idx2 = 0;
    while p2 >= 0 {
        if ast.texts[p2] == "self" {
            e.buf.push_str("  %v_self = alloca ptr\n  store ptr %self, ptr %v_self\n");
            kind_self = 2;
            si_self = e.find_struct_idx(prefix);
            if si_self >= 0 { kind_self = 100 + si_self; }
            if e.lv_count < 512 {
                e.locals[e.lv_count] = "self";
                e.local_kinds[e.lv_count] = kind_self;
                e.lv_count = e.lv_count + 1;
            }
        } else {
            e.buf.push_str("  %v_");
            e.buf.push_str(ast.texts[p2]);
            e.buf.push_str(" = alloca i64\n  store i64 %a");
            e.buf.push_int(idx2);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(ast.texts[p2]);
            e.buf.push_str("\n");
            if e.lv_count < 512 {
                e.locals[e.lv_count] = ast.texts[p2].copy();
                e.local_kinds[e.lv_count] = 0;
                e.lv_count = e.lv_count + 1;
            }
        }
        idx2 = idx2 + 1;
        p2 = ast.nexts[p2];
    }
    emit_stmts(ast, ast.aa[ast.bb[id]], e);
    e.buf.push_str("  ret i64 0\n}\n");
}

pub fn emit_program(ref Ast ast, int prog) -> String {
    e = Emitter::new();
    e.collect_decls(ast, prog);
    // 结构体类型定义
    si = 0;
    while si < e.st_count {
        e.buf.push_str("%struct.");
        e.buf.push_str(e.st_names[si]);
        e.buf.push_str(" = type { ");
        n = e.st_fcount[si];
        i = 0;
        while i < n {
            if i > 0 { e.buf.push_str(", "); }
            e.buf.push_str("i64");
            i = i + 1;
        }
        e.buf.push_str(" }\n");
        si = si + 1;
    }
    // 函数与方法
    s = ast.aa[prog];
    while s >= 0 {
        if ast.tags[s] == st(ST::FnDecl._tag) {
            emit_fn(ast, s, e);
        } elif ast.tags[s] == st(ST::ImplBlock._tag) {
            m = ast.aa[s];
            while m >= 0 {
                if ast.tags[m] == st(ST::FnDecl._tag) {
                    emit_fn_named(ast, m, ast.texts[s], e);
                }
                m = ast.nexts[m];
            }
        }
        s = ast.nexts[s];
    }
    e.buf.push_str("declare void @__ayanami_print_int(i64)\ndeclare void @__ayanami_print_ln()\ndeclare void @__ayanami_print_str(ptr, i64)\n");
    // 字符串字面量全局
    i = 0;
    while i < e.str_count {
        text = e.strs[i];
        e.buf.push_str("@.str.");
        e.buf.push_int(i);
        e.buf.push_str(" = private unnamed_addr constant [");
        e.buf.push_int(text.len as int + 1);
        e.buf.push_str(" x i8] c\"");
        e.buf.push_str(escape_ir(text));
        e.buf.push_str("\\00\"\n");
        i = i + 1;
    }
    return e.buf.to_string();
}
