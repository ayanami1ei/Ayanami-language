            }
            if rk_m == 3 {
                pi7 = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(pi7);
                e.buf.push_str(" = inttoptr i64 ");
                e.buf.push_str(t5);
                e.buf.push_str(" to ptr\n");
                return mk_arr(pi7, e.ret_info(ast, mrty));
            }
            return mk_int(t5);
        }
        return mk_int("0");
    }
    if tag == et(ET::Match._tag) {
        return emit_match(ast, id, e, 1);
    }
    if tag == et(ET::Cast._tag) {
        return emit_expr(ast, ast.aa[id], e);
    }
    if tag == et(ET::ArraySized._tag) {
        // [T; n]：元素类型来自 tys，n 是表达式
        cnt = emit_expr(ast, ast.aa[id], e);
        return emit_array_new(ast, id, ast.tys[id], cnt.a, e);
    }
    if tag == et(ET::ArrayLiteral._tag) {
        // [a, b, c]：元素类型由首元素推导，逐个 store（首元素只求值一次）
        head = ast.aa[id];
        cnt2 = 0;
        t2 = head;
        while t2 >= 0 { cnt2 = cnt2 + 1; t2 = ast.nexts[t2]; }
        bcnt = StringBuf::new();
        bcnt.push_int(cnt2);
        ety = elem_type_of(ast, head);
        cnt_s = bcnt.to_string();
        av = emit_array_new(ast, id, ety, cnt_s, e);
        lty = elem_llvm(ast, ety);
        two_char = 0;
        if elem_is_string(ast, ety) { two_char = 1; }
        el = ast.aa[id];
        k = 0;
        while el >= 0 {
            ev = emit_expr(ast, el, e);
            kb = StringBuf::new();
            kb.push_int(k);
            g = elem_addr(e, elem_stride(ast, ety), av.a, kb.to_string());
            store_elem(e, lty, two_char, g, ev);
            k = k + 1;
            el = ast.nexts[el];
        }
        return av;
    }
    if tag == et(ET::ArrayRepeat._tag) {
        // [expr; n]：值求值一次，循环填充到 n 个槽
        cnt3 = emit_expr(ast, ast.bb[id], e);
        ety3 = elem_type_of(ast, ast.aa[id]);
        ev3 = emit_expr(ast, ast.aa[id], e);
        av3 = emit_array_new(ast, id, ety3, cnt3.a, e);
        lty3 = elem_llvm(ast, ety3);
        fill = ev3.a;
        if elem_is_leaf(lty3) {
            t3b = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t3b);
            e.buf.push_str(" = trunc i64 ");
            e.buf.push_str(ev3.a);
            e.buf.push_str(" to ");
            e.buf.push_str(lty3);
            e.buf.push_str("\n  ");
            z3 = e.fresh();
            e.buf.push_str(z3);
            e.buf.push_str(" = zext ");
            e.buf.push_str(lty3);
            e.buf.push_str(" ");
            e.buf.push_str(t3b);
            e.buf.push_str(" to i64\n");
            fill = z3;
        }
        emit_array_fill(e, lty3, elem_stride(ast, ety3), av3.a, cnt3.a, fill);
        return av3;
    }
    if tag == et(ET::Index._tag) {
        // xs[i]：取值（8 位元素做 sext；其余按元素类型装载）
        base3 = emit_expr(ast, ast.aa[id], e);
        iv3 = emit_expr(ast, ast.bb[id], e);
        ety3 = base3.ty;
        lty4 = "i64";
        if ety3 >= 0 {
            lty4 = elem_llvm(ast, ety3);
        }
        g4 = elem_addr(e, elem_stride(ast, ety3), base3.a, iv3.a);
        if elem_is_string(ast, ety3) {
            p4 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(p4);
            e.buf.push_str(" = load ptr, ptr ");
            e.buf.push_str(g4);
            e.buf.push_str("\n");
            g4b = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(g4b);
            e.buf.push_str(" = getelementptr i8, ptr ");
            e.buf.push_str(g4);
            e.buf.push_str(", i64 8\n");
            l4 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(l4);
            e.buf.push_str(" = load i64, ptr ");
            e.buf.push_str(g4b);
            e.buf.push_str("\n");
            return mk_str_tmp(p4, l4);
        }
        if lty4 == "i8" {
            t4 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t4);
            e.buf.push_str(" = load i8, ptr ");
            e.buf.push_str(g4);
            e.buf.push_str("\n  ");
            s4 = e.fresh();
            e.buf.push_str(s4);
            e.buf.push_str(" = zext i8 ");
            e.buf.push_str(t4);
            e.buf.push_str(" to i64\n");
            return mk_int(s4);
        }
        if lty4 == "i32" {
            t5 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t5);
            e.buf.push_str(" = load i32, ptr ");
            e.buf.push_str(g4);
            e.buf.push_str("\n  ");
            s5 = e.fresh();
            e.buf.push_str(s5);
            e.buf.push_str(" = sext i32 ");
            e.buf.push_str(t5);
            e.buf.push_str(" to i64\n");
            return mk_int(s5);
        }
        t6 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(t6);
        e.buf.push_str(" = load ");
        e.buf.push_str(lty4);
        e.buf.push_str(", ptr ");
        e.buf.push_str(g4);
        e.buf.push_str("\n");
        if lty4 == "double" {
            return Val { kind = 0, a = t6, b = "", ty = ety3 };
        }
        return mk_int(t6);
    }
    if tag == et(ET::Ref._tag) {
        // &x / ref x：返回地址（仅用于数组/结构体实参场景）
        if ast.tags[ast.aa[id]] == et(ET::Ident._tag) {
            nm7 = ast.texts[ast.aa[id]];
            e.declare_local(nm7, 0);
            t7 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t7);
            e.buf.push_str(" = load i64, ptr %v_");
            e.buf.push_str(nm7);
            e.buf.push_str("\n");
            return mk_int(t7);
        }
        return emit_expr(ast, ast.aa[id], e);
    }
    return mk_int("0");
}

fn emit_stmts(ref Ast ast, int stmts, ref mut Emitter e) {
    s = stmts;
    while s >= 0 {
        if e.terminated == 1 { break; }
        emit_stmt(ast, s, e);
        s = ast.nexts[s];
    }
}

/// 元素是否为<8 字节标量（需要 trunc / sext 转换）
fn elem_is_leaf(ref String lty) -> bool {
    if lty == "i8" { return true; }
    if lty == "i32" { return true; }
    return false;
}

/// 单元素赋值（emit_array_fill 用）
fn store_one(ref mut Emitter e, ref String lty, ref String gep, ref String v) {
    if elem_is_leaf(lty) {
        w = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(w);
        e.buf.push_str(" = trunc i64 ");
        e.buf.push_str(v);
        e.buf.push_str(" to ");
        e.buf.push_str(lty);
        e.buf.push_str("\n  store ");
        e.buf.push_str(lty);
        e.buf.push_str(" ");
        e.buf.push_str(w);
        e.buf.push_str(", ptr ");
        e.buf.push_str(gep);
        e.buf.push_str("\n");
        return;
    }
    e.buf.push_str("  store ");
    e.buf.push_str(lty);
    e.buf.push_str(" ");
    e.buf.push_str(v);
    e.buf.push_str(", ptr ");
    e.buf.push_str(gep);
    e.buf.push_str("\n");
}

/// 循环填充：`[T; n]`（val 为 "0"）/ `[expr; n]`（val 为元素值）的元素写入
/// 用 alloca 计数器（不依赖 %entry 块，可在任意位置展开）
fn emit_array_fill(ref mut Emitter e, ref String lty, int stride, ref String base, ref String cnt, ref String val) {
    n = e.tmp;
    e.tmp = e.tmp + 1;
    e.buf.push_str("  %fi.");
    e.buf.push_int(n);
    e.buf.push_str(" = alloca i64\n  store i64 0, ptr %fi.");
    e.buf.push_int(n);
    e.buf.push_str("\n  br label %fill.cond.");
    e.buf.push_int(n);
    e.buf.push_str("\nfill.cond.");
    e.buf.push_int(n);
    e.buf.push_str(":\n  %fv.");
    e.buf.push_int(n);
    e.buf.push_str(" = load i64, ptr %fi.");
    e.buf.push_int(n);
    e.buf.push_str("\n  %fc.");
    e.buf.push_int(n);
    e.buf.push_str(" = icmp slt i64 %fv.");
    e.buf.push_int(n);
    e.buf.push_str(", ");
    e.buf.push_str(cnt);
    e.buf.push_str("\n  br i1 %fc.");
    e.buf.push_int(n);
    e.buf.push_str(", label %fill.body.");
    e.buf.push_int(n);
    e.buf.push_str(", label %fill.end.");
    e.buf.push_int(n);
    e.buf.push_str("\nfill.body.");
    e.buf.push_int(n);
    e.buf.push_str(":\n");
    g = elem_addr(e, stride, base, "%fv.".to_string() + int_str2(n));
    e.buf.push_str("  store ");
    e.buf.push_str(lty);
    e.buf.push_str(" ");
    e.buf.push_str(val);
    e.buf.push_str(", ptr ");
    e.buf.push_str(g);
    e.buf.push_str("\n  %fn.");
    e.buf.push_int(n);
    e.buf.push_str(" = add i64 %fv.");
    e.buf.push_int(n);
    e.buf.push_str(", 1\n  store i64 %fn.");
    e.buf.push_int(n);
    e.buf.push_str(", ptr %fi.");
    e.buf.push_int(n);
    e.buf.push_str("\n  br label %fill.cond.");
    e.buf.push_int(n);
    e.buf.push_str("\nfill.end.");
    e.buf.push_int(n);
    e.buf.push_str(":\n");
}

/// 数组元素写入：lty 元素 LLVM 类型，two_char 时按 { ptr, i64 } 双字写
fn store_elem(ref mut Emitter e, ref String lty, int two_char, ref String gep, ref Val v) {
    if lty == "i64" {
        e.buf.push_str("  store i64 ");
        e.buf.push_str(v.a);
        e.buf.push_str(", ptr ");
        e.buf.push_str(gep);
        e.buf.push_str("\n");
        return;
    }
    if lty == "ptr" {
        e.buf.push_str("  store ptr ");
        e.buf.push_str(v.a);
        e.buf.push_str(", ptr ");
        e.buf.push_str(gep);
        e.buf.push_str("\n");
        if two_char == 1 {
            g2 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(g2);
            e.buf.push_str(" = getelementptr i8, ptr ");
            e.buf.push_str(gep);
            e.buf.push_str(", i64 8\n  store i64 ");
            e.buf.push_str(v.b);
            e.buf.push_str(", ptr ");
            e.buf.push_str(g2);
            e.buf.push_str("\n");
        }
        return;
    }
    // i8/i32/double：截断后写入，读回时按同样宽度
    e.buf.push_str("  ");
    w = e.fresh();
    e.buf.push_str(w);
    e.buf.push_str(" = trunc i64 ");
    e.buf.push_str(v.a);
    e.buf.push_str(" to ");
    e.buf.push_str(lty);
    e.buf.push_str("\n  store ");
    e.buf.push_str(lty);
    e.buf.push_str(" ");
    e.buf.push_str(w);
    e.buf.push_str(", ptr ");
    e.buf.push_str(gep);
    e.buf.push_str("\n");
}

/// 数组 GEP：base 指针 + i64 下标 → 元素地址
fn elem_gep(ref mut Emitter e, ref String lty, ref String base, ref String idx) -> String {
    g = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(g);
    e.buf.push_str(" = getelementptr ");
    e.buf.push_str(lty);
    e.buf.push_str(", ptr ");
    e.buf.push_str(base);
    e.buf.push_str(", i64 ");
    e.buf.push_str(idx);
    e.buf.push_str("\n");
    return g;
}

/// `xs[i] = v`（ST::IndexAssign）：aa=基址表达式，bb=下标，cc=值
/// 基址是数组局部变量时按元素类型直接写入 malloc 缓冲区
fn emit_index_assign(ref Ast ast, int id, ref mut Emitter e) {
    base_id = ast.aa[id];
    bp = "";
    ety = -1;
    if ast.tags[base_id] == et(ET::Ident._tag) {
        nm = ast.texts[base_id];
        ety_l = e.elem_of_local(nm);
        if ety_l >= 0 {
            t = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t);
            e.buf.push_str(" = load ptr, ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str("\n");
            bp = t;
            ety = ety_l;
        }
    }
    if ety < 0 {
        bv = emit_expr(ast, base_id, e);
        if bv.kind != 3 { return; }
        bp = bv.a;
        ety = bv.ty;
    }
    lty = elem_llvm(ast, ety);
    two_char = 0;
    if elem_is_string(ast, ety) { two_char = 1; }
    iv = emit_expr(ast, ast.bb[id], e);
    g = elem_addr(e, elem_stride(ast, ety), bp, iv.a);
    v = emit_expr(ast, ast.cc[id], e);
    store_elem(e, lty, two_char, g, v);
}

/// 数组字面量 / [expr; n] / [T; n]：malloc 缓冲区，返回 ptr 值
fn emit_array_new(ref Ast ast, int id, int ety, ref String count, ref mut Emitter e) -> Val {
    lty = elem_llvm(ast, ety);
    sz = elem_bytes(ast, ety);
    c = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(c);
    e.buf.push_str(" = mul i64 ");
    e.buf.push_str(count);
    e.buf.push_str(", ");
    e.buf.push_int(sz);
    e.buf.push_str("\n");
    big = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(big);
    e.buf.push_str(" = icmp slt i64 ");
    e.buf.push_str(c);
    e.buf.push_str(", 1\n  ");
    z = e.fresh();
    e.buf.push_str(z);
    e.buf.push_str(" = select i1 ");
    e.buf.push_str(big);
    e.buf.push_str(", i64 1, i64 ");
    e.buf.push_str(c);
    e.buf.push_str("\n");
    raw = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(raw);
    e.buf.push_str(" = call ptr @malloc(i64 ");
    e.buf.push_str(z);
    e.buf.push_str(")\n");
    e.buf.push_str("  call void @llvm.memset.p0.i64(ptr ");
    e.buf.push_str(raw);
    e.buf.push_str(", i8 0, i64 ");
    e.buf.push_str(z);
    e.buf.push_str(", i1 false)\n");
    return mk_arr(raw, ety);
}

fn emit_stmt(ref Ast ast, int id, ref mut Emitter e) {
    tag = ast.tags[id];
    if tag == st(ST::IndexAssign._tag) {
        emit_index_assign(ast, id, e);
    } elif tag == st(ST::Assign._tag) {
        rhs_id = ast.aa[id];
        nm = ast.texts[id];
        v = emit_expr(ast, rhs_id, e);
        if v.kind == 3 {
            e.declare_array_local(nm, v.ty);
            e.buf.push_str("  store ptr ");
            e.buf.push_str(v.a);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str("\n");
            return;
        }
        if v.kind == 4 {
            ei4 = e.find_enum_idx(v.b);
            e.declare_local(nm, 20);
            e.record_etype(nm, ei4);
            e.buf.push_str("  store ptr ");
            e.buf.push_str(v.a);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str("\n");
            return;
        }
        if v.kind == 2 {
            si2 = e.find_struct_idx(v.b);
            e.declare_local(nm, 100 + si2);
            e.record_etype(nm, si2);
            e.buf.push_str("  store ptr ");
            e.buf.push_str(v.a);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str("\n");
            return;
        }
        if v.kind == 1 {
            e.declare_local(nm, 1);
            e.buf.push_str("  store ptr ");
            e.buf.push_str(v.a);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str(".ptr\n  store i64 ");
            e.buf.push_str(v.b);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str(".len\n");
        } else {
            e.declare_local(nm, 0);
            e.buf.push_str("  store i64 ");
            e.buf.push_str(v.a);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str("\n");
        }
    } elif tag == st(ST::Return._tag) {
        rk_ret = e.ret_kind(ast, e.cur_rtype);
        if ast.aa[id] >= 0 {
            v2 = emit_expr(ast, ast.aa[id], e);
            if rk_ret == 1 {
                // llc 22 不接受聚合字面量里的函数局部名，用 insertvalue
                if v2.kind == 1 {
                    r0 = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(r0);
                    e.buf.push_str(" = insertvalue { ptr, i64 } undef, ptr ");
                    e.buf.push_str(v2.a);
                    e.buf.push_str(", 0\n  ");
                    r1 = e.fresh();
                    e.buf.push_str(r1);
                    e.buf.push_str(" = insertvalue { ptr, i64 } ");
                    e.buf.push_str(r0);
                    e.buf.push_str(", i64 ");
                    e.buf.push_str(v2.b);
                    e.buf.push_str(", 1\n  ret { ptr, i64 } ");
                    e.buf.push_str(r1);
                    e.buf.push_str("\n");
                } else {
                    r2 = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(r2);
                    e.buf.push_str(" = insertvalue { ptr, i64 } undef, ptr null, 0\n  ");
                    r3 = e.fresh();
                    e.buf.push_str(r3);
                    e.buf.push_str(" = insertvalue { ptr, i64 } ");
                    e.buf.push_str(r2);
                    e.buf.push_str(", i64 ");
                    e.buf.push_str(v2.a);
                    e.buf.push_str(", 1\n  ret { ptr, i64 } ");
                    e.buf.push_str(r3);
                    e.buf.push_str("\n");
                }
            } elif v2.kind == 2 || v2.kind == 3 || v2.kind == 4 {
                pi = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(pi);
                e.buf.push_str(" = ptrtoint ptr ");
                e.buf.push_str(v2.a);
                e.buf.push_str(" to i64\n  ret i64 ");
                e.buf.push_str(pi);
                e.buf.push_str("\n");
            } else {
                e.buf.push_str("  ret i64 ");
                e.buf.push_str(v2.a);
                e.buf.push_str("\n");
            }
        } else {
            if rk_ret == 1 {
                e.buf.push_str("  ret { ptr, i64 } { ptr null, i64 0 }\n");
            } else {
                e.buf.push_str("  ret i64 0\n");
            }
        }
    } elif tag == st(ST::Break._tag) {
        if e.loop_depth > 0 {
            e.buf.push_str("  br label %");
            e.buf.push_str(e.loop_ends[e.loop_depth - 1]);
            e.buf.push_str("\n");
            e.terminated = 1;
        }
    } elif tag == st(ST::Continue._tag) {
        if e.loop_depth > 0 {
            e.buf.push_str("  br label %");
            e.buf.push_str(e.loop_conds[e.loop_depth - 1]);
            e.buf.push_str("\n");
            e.terminated = 1;
        }
    } elif tag == st(ST::ExprStmt._tag) {
        emit_expr(ast, ast.aa[id], e);
    } elif tag == st(ST::Match._tag) {
        emit_match(ast, id, e, 0);
    } elif tag == st(ST::FieldAssign._tag) {
        obj = emit_expr(ast, ast.aa[id], e);
        if obj.kind == 2 {
            idx = e.find_field_idx(obj.b, ast.texts[id]);
            if idx >= 0 {
                v = emit_expr(ast, ast.bb[id], e);
                si_a = e.find_struct_idx(obj.b);
                sl_a = e.fslot_at(si_a, idx);
                fk_a = e.fkind_at(si_a, idx);
                g = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(g);
                e.buf.push_str(" = getelementptr %struct.");
                e.buf.push_str(obj.b);
                e.buf.push_str(", ptr ");
                e.buf.push_str(obj.a);
                e.buf.push_str(", i32 0, i32 ");
                e.buf.push_int(sl_a);
                e.buf.push_str("\n");
                if fk_a == 1 {
                    e.buf.push_str("  store ptr ");
                    e.buf.push_str(ptr_operand(v.a));
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(g);
                    e.buf.push_str("\n");
                    gab = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(gab);
                    e.buf.push_str(" = getelementptr %struct.");
                    e.buf.push_str(obj.b);
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(obj.a);
                    e.buf.push_str(", i32 0, i32 ");
                    e.buf.push_int(sl_a + 1);
                    e.buf.push_str("\n  store i64 ");
                    e.buf.push_str(v.b);
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(gab);
                    e.buf.push_str("\n");
                } elif fk_a == 2 || fk_a == 3 || fk_a == 4 {
                    e.buf.push_str("  store ptr ");
                    e.buf.push_str(ptr_operand(v.a));
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(g);
                    e.buf.push_str("\n");
                } else {
                    e.buf.push_str("  store i64 ");
                    e.buf.push_str(v.a);
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(g);
                    e.buf.push_str("\n");
                }
            }
        }
    } elif tag == st(ST::If._tag) {
        end_l = label(e, "if.end.");
        // 首条件
        c = emit_expr(ast, ast.aa[id], e);
        then_l = label(e, "if.then.");
        next_l = label(e, "if.next.");
        cc = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(cc);
        e.buf.push_str(" = icmp ne i64 ");
        e.buf.push_str(c.a);
        e.buf.push_str(", 0\n  br i1 ");
        e.buf.push_str(cc);
        e.buf.push_str(", label %");
        e.buf.push_str(then_l);
        e.buf.push_str(", label %");
        e.buf.push_str(next_l);
        e.buf.push_str("\n");
        e.buf.push_str(then_l);
        e.buf.push_str(":\n");
        e.terminated = 0;
        emit_stmts(ast, ast.aa[ast.bb[id]], e);
        if e.terminated == 0 {
            e.buf.push_str("  br label %");
            e.buf.push_str(end_l);
            e.buf.push_str("\n");
        }
        // elif 链
        en = ast.cc[id];
        cur_next = next_l;
        while en >= 0 {
            e.buf.push_str(cur_next);
            e.buf.push_str(":\n");
            e.terminated = 0;
            ec2 = emit_expr(ast, ast.aa[en], e);
            then_l2 = label(e, "if.then.");
            next_l2 = label(e, "if.next.");
            cc2 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(cc2);
            e.buf.push_str(" = icmp ne i64 ");
            e.buf.push_str(ec2.a);
            e.buf.push_str(", 0\n  br i1 ");
            e.buf.push_str(cc2);
            e.buf.push_str(", label %");
            e.buf.push_str(then_l2);
            e.buf.push_str(", label %");
            e.buf.push_str(next_l2);
            e.buf.push_str("\n");
            e.buf.push_str(then_l2);
            e.buf.push_str(":\n");
            e.terminated = 0;
            emit_stmts(ast, ast.aa[ast.bb[en]], e);
            if e.terminated == 0 {
                e.buf.push_str("  br label %");
                e.buf.push_str(end_l);
                e.buf.push_str("\n");
            }
            cur_next = next_l2;
            en = ast.nexts[en];
        }
        e.buf.push_str(cur_next);
        e.buf.push_str(":\n");
        e.terminated = 0;
        e2 = ast.dd[id];
        if e2 >= 0 {
            emit_stmts(ast, ast.aa[e2], e);
        }
        if e.terminated == 0 {
            e.buf.push_str("  br label %");
            e.buf.push_str(end_l);
            e.buf.push_str("\n");
        }
        e.buf.push_str(end_l);
        e.buf.push_str(":\n");
        e.terminated = 0;
    } elif tag == st(ST::While._tag) {
        cond_l = label(e, "while.cond.");
        body_l = label(e, "while.body.");
        end_l = label(e, "while.end.");
        if e.loop_depth < 64 {
            e.loop_ends[e.loop_depth] = end_l.copy();
            e.loop_conds[e.loop_depth] = cond_l.copy();
            e.loop_depth = e.loop_depth + 1;
        }
        e.buf.push_str("  br label %");
        e.buf.push_str(cond_l);
        e.buf.push_str("\n");
        e.buf.push_str(cond_l);
        e.buf.push_str(":\n");
        e.terminated = 0;
        c2 = emit_expr(ast, ast.aa[id], e);
        cc2 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(cc2);
        e.buf.push_str(" = icmp ne i64 ");
        e.buf.push_str(c2.a);
        e.buf.push_str(", 0\n  br i1 ");
        e.buf.push_str(cc2);
        e.buf.push_str(", label %");
        e.buf.push_str(body_l);
        e.buf.push_str(", label %");
        e.buf.push_str(end_l);
        e.buf.push_str("\n");
        e.buf.push_str(body_l);
        e.buf.push_str(":\n");
        e.terminated = 0;
        emit_stmts(ast, ast.aa[ast.bb[id]], e);
        if e.terminated == 0 {
            e.buf.push_str("  br label %");
            e.buf.push_str(cond_l);
            e.buf.push_str("\n");
        }
        e.buf.push_str(end_l);
        e.buf.push_str(":\n");
        e.terminated = 0;
        if e.loop_depth > 0 { e.loop_depth = e.loop_depth - 1; }
    } elif tag == st(ST::For._tag) {
        e.declare_local(ast.texts[id], 0);
        v = emit_expr(ast, ast.aa[id], e);
        e.buf.push_str("  store i64 ");
        e.buf.push_str(v.a);
        e.buf.push_str(", ptr %v_");
        e.buf.push_str(ast.texts[id]);
        e.buf.push_str("\n");
        cond_l = label(e, "for.cond.");
        body_l = label(e, "for.body.");
        end_l = label(e, "for.end.");
        if e.loop_depth < 64 {
            e.loop_ends[e.loop_depth] = end_l.copy();
            e.loop_conds[e.loop_depth] = cond_l.copy();
            e.loop_depth = e.loop_depth + 1;
        }
        e.buf.push_str("  br label %");
        e.buf.push_str(cond_l);
        e.buf.push_str("\n");
        e.buf.push_str(cond_l);
        e.buf.push_str(":\n");
        iv = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(iv);
        e.buf.push_str(" = load i64, ptr %v_");
        e.buf.push_str(ast.texts[id]);
        e.buf.push_str("\n");
        ev = emit_expr(ast, ast.bb[id], e);
        c3 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(c3);
        e.buf.push_str(" = icmp slt i64 ");
        e.buf.push_str(iv);
        e.buf.push_str(", ");
        e.buf.push_str(ev.a);
        e.buf.push_str("\n  br i1 ");
        e.buf.push_str(c3);
        e.buf.push_str(", label %");
        e.buf.push_str(body_l);
        e.buf.push_str(", label %");
        e.buf.push_str(end_l);
        e.buf.push_str("\n");
        e.buf.push_str(body_l);
        e.buf.push_str(":\n");
        e.terminated = 0;
        emit_stmts(ast, ast.aa[ast.dd[id]], e);
        if e.terminated == 1 {
            e.buf.push_str(end_l);
            e.buf.push_str(":\n");
            e.terminated = 0;
            if e.loop_depth > 0 { e.loop_depth = e.loop_depth - 1; }
            return;
        }
        iv2 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(iv2);
        e.buf.push_str(" = load i64, ptr %v_");
        e.buf.push_str(ast.texts[id]);
        e.buf.push_str("\n");
        nx = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(nx);
        e.buf.push_str(" = add i64 ");
        e.buf.push_str(iv2);
        e.buf.push_str(", 1\n  store i64 ");
        e.buf.push_str(nx);
        e.buf.push_str(", ptr %v_");
        e.buf.push_str(ast.texts[id]);
        e.buf.push_str("\n  br label %");
        e.buf.push_str(cond_l);
        e.buf.push_str("\n");
        e.buf.push_str(end_l);
        e.buf.push_str(":\n");
        e.terminated = 0;
        if e.loop_depth > 0 { e.loop_depth = e.loop_depth - 1; }
    }
}

fn emit_fn(ref Ast ast, int id, ref mut Emitter e) {
    emit_fn_named(ast, id, "", e);
}

/// extern 声明：declare i64 @name(...)（同名去重）
fn emit_decl(ref Ast ast, int id, ref mut Emitter e) {
    nm_d = ast.texts[id];
    i_d = 0;
    while i_d < e.decl_count {
        if e.decl_names[i_d] == nm_d { return; }
        i_d = i_d + 1;
    }
    if e.decl_count < 512 {
        e.decl_names[e.decl_count] = nm_d.copy();
        e.decl_count = e.decl_count + 1;
    }
    rll = e.ret_llvm_code(ast, ast.tys[id]);
    if rll == 1 {
        e.buf.push_str("declare i32 @");
    } elif rll == 2 {
        e.buf.push_str("declare i8 @");
    } else {
        e.buf.push_str("declare i64 @");
    }
    e.buf.push_str(ast.texts[id]);
    e.buf.push_str("(");
    first = 1;
    p = ast.aa[id];
    idx = 0;
    while p >= 0 {
        if first == 0 { e.buf.push_str(", "); }
        pk = e.param_kind(ast, p);
        if pk == 0 {
            e.buf.push_str("i64 %a");
        } else {
            e.buf.push_str("ptr %a");
        }
        e.buf.push_int(idx);
        first = 0;
        idx = idx + 1;
        p = ast.nexts[p];
    }
    e.buf.push_str(")\n");
}

fn emit_fn_named(ref Ast ast, int id, ref String prefix, ref mut Emitter e) {
    e.tmp = 0;
    e.lv_count = 0;
    name = ast.texts[id];
    rty = ast.tys[id];
    rkind = e.ret_kind(ast, rty);
    e.cur_rtype = rty;
    if rkind == 1 {
        e.buf.push_str("define { ptr, i64 } @");
    } else {
        e.buf.push_str("define i64 @");
    }
    if prefix.len > 0 {
        e.buf.push_str(prefix);
        e.buf.push_str(".");
    }
    e.buf.push_str(name);
    e.buf.push_str("(");
    first = 1;
    p = ast.aa[id];
    idx = 0;
    while p >= 0 {
        if first == 0 { e.buf.push_str(", "); }
        if ast.texts[p] == "self" {
            e.buf.push_str("ptr %self");
            idx = idx + 1;
        } else {
            pk_sig = e.param_kind(ast, p);
            if pk_sig == 1 {
                e.buf.push_str("ptr %a");
                e.buf.push_int(idx);
                e.buf.push_str(", i64 %a");
                e.buf.push_int(idx + 1);
                idx = idx + 2;
            } elif pk_sig == 0 {
                e.buf.push_str("i64 %a");
                e.buf.push_int(idx);
                idx = idx + 1;
            } else {
                e.buf.push_str("ptr %a");
                e.buf.push_int(idx);
                idx = idx + 1;
            }
        }
        first = 0;
        p = ast.nexts[p];
    }
    e.buf.push_str(") {\nentry:\n");
    e.entry_pos = e.buf.len;
    e.pre_buf = StringBuf::new();
    e.pre_active = 1;
    p2 = ast.aa[id];
    idx2 = 0;
    while p2 >= 0 {
        if ast.texts[p2] == "self" {
            kind_self = 2;
            si_self = e.find_struct_idx(prefix);
            ei_self = -1;
            if si_self >= 0 {
                kind_self = 100 + si_self;
            } else {
                ei_self = e.find_enum_idx(prefix);
                if ei_self >= 0 { kind_self = 20; }
            }
            e.declare_local("self", kind_self);
            if ei_self >= 0 {
                e.record_etype("self", ei_self);
            } else {
                e.record_etype("self", si_self);
            }
            e.buf.push_str("  store ptr %self, ptr %v_self\n");
            idx2 = idx2 + 1;
        } else {
            pname = ast.texts[p2];
            pk = e.param_kind(ast, p2);
            ei_p = -1;
            if pk == 20 {
                ptn = ty_name(ast, ast.tys[p2]);
                ei_p = e.find_enum_idx(ptn);
            } elif pk >= 100 {
                ei_p = pk - 100;
            }
            if pk == 1 {
                // String 参数：ptr + len 双槽
                e.declare_local(pname, 1);
                e.buf.push_str("  store ptr %a");
                e.buf.push_int(idx2);
                e.buf.push_str(", ptr %v_");
                e.buf.push_str(pname);
                e.buf.push_str(".ptr\n  store i64 %a");
                e.buf.push_int(idx2 + 1);
                e.buf.push_str(", ptr %v_");
                e.buf.push_str(pname);
                e.buf.push_str(".len\n");
                idx2 = idx2 + 2;
            } elif pk == 0 {
                e.declare_local(pname, 0);
                e.buf.push_str("  store i64 %a");
                e.buf.push_int(idx2);
                e.buf.push_str(", ptr %v_");
                e.buf.push_str(pname);
                e.buf.push_str("\n");
                idx2 = idx2 + 1;
            } else {
                e.declare_local(pname, pk);
                e.record_etype(pname, ei_p);
                e.buf.push_str("  store ptr %a");
                e.buf.push_int(idx2);
                e.buf.push_str(", ptr %v_");
                e.buf.push_str(pname);
                e.buf.push_str("\n");
                idx2 = idx2 + 1;
            }
        }
        p2 = ast.nexts[p2];
    }
    emit_stmts(ast, ast.aa[ast.bb[id]], e);
    if rkind == 1 {
        e.buf.push_str("  ret { ptr, i64 } { ptr null, i64 0 }\n}\n");
    } else {
        e.buf.push_str("  ret i64 0\n}\n");
    }
    // 把 alloca 前置到 entry 块
    e.pre_active = 0;
    all_s = e.buf.to_string();
    head_s = all_s.substring(0 as usize, e.entry_pos as usize);
    body_s = all_s.substring(e.entry_pos as usize, all_s.len);
    e.buf = StringBuf::new();
    e.buf.push_str(head_s);
    e.buf.push_str(e.pre_buf.to_string());
    e.buf.push_str(body_s);
    e.cur_rtype = -1;
}

#[alloc]
#[state]
pub fn emit_program(ref Ast ast, int prog) -> String {
    e = Emitter::new();
    e.collect_decls(ast, prog);
    // 结构体类型定义
    si = 0;
    while si < e.st_count {
        e.buf.push_str("%struct.");
        e.buf.push_str(e.st_names[si]);
        e.buf.push_str(" = type { ");
        n = e.st_slots[si];
        i = 0;
        while i < n {
            if i > 0 { e.buf.push_str(", "); }
            e.buf.push_str("i64");
            i = i + 1;
        }
        e.buf.push_str(" }\n");
        si = si + 1;
    }
    // 枚举类型定义（tag + 载荷槽）
    ei2 = 0;
    while ei2 < e.en_count {
        e.buf.push_str("%enum.");
        e.buf.push_str(e.en_names[ei2]);
        e.buf.push_str(" = type { i64");
        mx = e.enum_max_arity(ei2);
        k2 = 0;
        while k2 < mx {
            e.buf.push_str(", i64");
            k2 = k2 + 1;
        }
        e.buf.push_str(" }\n");
        ei2 = ei2 + 1;
    }
    // 函数与方法
    s = ast.aa[prog];
    while s >= 0 {
        if ast.tags[s] == st(ST::FnDecl._tag) {
            if ast.dd[s] == 1 {
                emit_decl(ast, s, e);
            } else {
                emit_fn(ast, s, e);
            }
        } elif ast.tags[s] == st(ST::ImplBlock._tag) {
            m = ast.aa[s];
            while m >= 0 {
                if ast.tags[m] == st(ST::FnDecl._tag) {
                    emit_fn_named(ast, m, ast.texts[s], e);
                }
                m = ast.nexts[m];
            }
        } elif ast.tags[s] == st(ST::Namespace._tag) {
            m3 = ast.aa[s];
            while m3 >= 0 {
                if ast.tags[m3] == st(ST::FnDecl._tag) {
                    emit_fn_named(ast, m3, ast.texts[s], e);
                }
                m3 = ast.nexts[m3];
            }
        }
        s = ast.nexts[s];
    }
    e.buf.push_str("declare void @__ayanami_print_int(i64)\ndeclare void @__ayanami_print_ln()\ndeclare void @__ayanami_print_str(ptr, i64)\n");
    // 数组分配/清零所需（M6a）：malloc + llvm.memset
    e.buf.push_str("declare ptr @malloc(i64)\ndeclare ptr @memcpy(ptr, ptr, i64)\ndeclare i32 @memcmp(ptr, ptr, i64)\n");
    e.buf.push_str("declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)\n");
    // 字符串字面量全局
    i = 0;
    while i < e.str_count {
        text = e.strs[i];
        e.buf.push_str("@.str.");
        e.buf.push_int(i);
        e.buf.push_str(" = private unnamed_addr constant [");
        e.buf.push_int(text.len as int + 1);
        e.buf.push_str(" x i8] c\"");
        e.buf.push_str(escape_ir(text));
        e.buf.push_str("\\00\"\n");
        i = i + 1;
    }
    return e.buf.to_string();
}
