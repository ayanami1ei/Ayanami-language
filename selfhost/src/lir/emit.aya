            e.buf.push_str(a);
            e.buf.push_str(" = icmp ne i64 ");
            e.buf.push_str(lt.a);
            e.buf.push_str(", 0\n");
            b2 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(b2);
            e.buf.push_str(" = icmp ne i64 ");
            e.buf.push_str(rt.a);
            e.buf.push_str(", 0\n");
            c2 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(c2);
