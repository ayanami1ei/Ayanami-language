import "string";
import "aya_sb";
import "aya_ast";

// M5b/M6a：AST -> LLVM IR 文本（int/bool/String/struct/数组 子集）
// 值表示：Val { kind: 0=int, 1=String(ptr,len), 2=struct(ptr,类型名), 3=数组(ptr,元素类型 id) }
pub struct Val {
    int kind
    String a
    String b
    int ty
}

pub struct Emitter {
    StringBuf buf
    int tmp
    [String] locals
    [int] local_kinds
    int lv_count
    // 数组局部变量的元素类型（AST 类型节点 id；-1 表示非数组）
    [int] local_etypes
    [String] strs
    int str_count
    // 结构体表（字段扁平）
    [String] st_names
    [int] st_fstart
    [int] st_fcount
    [String] st_fields
    int st_ftotal
    int st_count
    // 方法表：(类型, 方法名) -> FnDecl id
    [String] m_ty
    [String] m_name
    [int] m_id
    int m_count
    // 枚举表
    [String] en_names
    [int] en_vstart
    [int] en_vcount
    [String] en_variants
    [int] en_arity
    int en_vtotal
    int en_count
    // 函数签名表（参数种类：0=int, 20=enum, 100+si=struct）
    [String] fn_names
    [int] fn_pstart
    [int] fn_pcount
    [int] fn_pkinds
    int fn_ptotal
    int fn_count
}

pub namespace Emitter {
    #[alloc]
    pub fn new() -> Emitter {
        e = Emitter {
            buf = StringBuf::new(), tmp = 0,
            locals = [String; 512], local_kinds = [int; 512], lv_count = 0,
            local_etypes = [int; 512],
            strs = [String; 256], str_count = 0,
            st_names = [String; 128], st_fstart = [int; 128], st_fcount = [int; 128],
            st_fields = [String; 1024], st_ftotal = 0, st_count = 0,
            m_ty = [String; 256], m_name = [String; 256], m_id = [int; 256], m_count = 0,
            en_names = [String; 128], en_vstart = [int; 128], en_vcount = [int; 128],
            en_variants = [String; 1024], en_arity = [int; 1024], en_vtotal = 0, en_count = 0,
            fn_names = [String; 256], fn_pstart = [int; 256], fn_pcount = [int; 256],
            fn_pkinds = [int; 2048], fn_ptotal = 0, fn_count = 0
        };
        return e;
    }
}

fn mk_int(ref String t) -> Val {
    return Val { kind = 0, a = t.copy(), b = "", ty = -1 };
}

/// 数组值（malloc 指针 + 元素类型 id）
fn mk_arr(ref String ptr, int ety) -> Val {
    return Val { kind = 3, a = ptr.copy(), b = "", ty = ety };
}

fn mk_str(ref String ptr, int len) -> Val {
    b = StringBuf::new();
    b.push_int(len);
    return Val { kind = 1, a = ptr.copy(), b = b.to_string(), ty = -1 };
}

impl Emitter {
    #[alloc]
    #[state]
    fn fresh(ref mut self) -> String {
        b = StringBuf::new();
        b.push_str("%t");
        b.push_int(self.tmp);
        self.tmp = self.tmp + 1;
        return b.to_string();
    }

    fn local_kind(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.lv_count {
            if self.locals[i] == name { return self.local_kinds[i]; }
            i = i + 1;
        }
        return -1;
    }

    /// 数组局部的元素类型（AST 类型节点 id）；非数组返回 -1
    fn find_elem(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.lv_count {
            if self.locals[i] == name { return self.local_etypes[i]; }
            i = i + 1;
        }
        return -1;
    }

    #[alloc]
    #[state]
    fn declare_array_local(ref mut self, ref String name, int ety) {
        self.declare_local(name, 10);
        i = 0;
        while i < self.lv_count {
            if self.locals[i] == name {
                self.local_etypes[i] = ety;
                return;
            }
            i = i + 1;
        }
    }

    #[state]
    fn record_etype(ref mut self, ref String name, int ety) {
        i = 0;
        while i < self.lv_count {
            if self.locals[i] == name {
                self.local_etypes[i] = ety;
                return;
            }
            i = i + 1;
        }
    }

    fn elem_of_local(ref mut self, ref String name) -> int {
        if self.local_kind(name) != 10 { return -1; }
        return self.find_elem(name);
    }

    fn etype_of_local(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.lv_count {
            if self.locals[i] == name {
                return self.local_etypes[i];
            }
            i = i + 1;
        }
        return -1;
    }

    #[alloc]
    #[state]
    fn declare_local(ref mut self, ref String name, int kind) {
        if self.local_kind(name) >= 0 { return; }
        if self.lv_count < 512 {
            self.locals[self.lv_count] = name.copy();
            self.local_kinds[self.lv_count] = kind;
            self.local_etypes[self.lv_count] = -1;
            self.lv_count = self.lv_count + 1;
        }
        if kind == 1 {
            self.buf.push_str("  %v_");
            self.buf.push_str(name);
            self.buf.push_str(".ptr = alloca ptr\n  %v_");
            self.buf.push_str(name);
            self.buf.push_str(".len = alloca i64\n");
        } elif kind == 10 {
            self.buf.push_str("  %v_");
            self.buf.push_str(name);
            self.buf.push_str(" = alloca ptr\n");
        } elif kind >= 2 {
            self.buf.push_str("  %v_");
            self.buf.push_str(name);
            self.buf.push_str(" = alloca ptr\n");
        } else {
            self.buf.push_str("  %v_");
            self.buf.push_str(name);
            self.buf.push_str(" = alloca i64\n");
        }
    }

    /// struct 局部变量的类型名（kind 2 的局部）
    #[alloc]
    #[state]
    fn struct_of_local(ref mut self, ref String name) -> String {
        i = 0;
        while i < self.lv_count {
            if self.locals[i] == name {
                if self.local_kinds[i] >= 100 {
                    // kind 编码：100 + 结构体下标
                    si = self.local_kinds[i] - 100;
                    if si < self.st_count { return self.st_names[si].copy(); }
                }
            }
            i = i + 1;
        }
        return "";
    }

    /// 参数类型种类：0=int/其他, 20=枚举, 100+si=结构体
    #[alloc]
    #[state]
    fn param_kind(ref mut self, ref Ast ast, int p) -> int {
        pt = ast.tys[p];
        if pt < 0 { return 0; }
        if ast.tags[pt] != tt(TT::Named._tag) { return 0; }
        tn = ast.texts[pt];
        ei = self.find_enum_idx(tn);
        if ei >= 0 { return 20; }
        si = self.find_struct_idx(tn);
        if si >= 0 { return 100 + si; }
        return 0;
    }

    fn find_struct_idx(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.st_count {
            if self.st_names[i] == name { return i; }
            i = i + 1;
        }
        return -1;
    }

    fn find_field_idx(ref mut self, ref String stname, ref String fname) -> int {
        si = self.find_struct_idx(stname);
        if si < 0 { return -1; }
        start = self.st_fstart[si];
        n = self.st_fcount[si];
        i = 0;
        while i < n {
            if self.st_fields[start + i] == fname { return i; }
            i = i + 1;
        }
        return -1;
    }

    fn find_method_id(ref mut self, ref String ty, ref String name) -> int {
        i = 0;
        while i < self.m_count {
            if self.m_ty[i] == ty {
                if self.m_name[i] == name { return self.m_id[i]; }
            }
            i = i + 1;
        }
        return -1;
    }

    #[alloc]
    #[state]
    fn add_struct(ref mut self, ref Ast ast, int id) {
        if self.st_count >= 128 { return; }
        si = self.st_count;
        self.st_names[si] = ast.texts[id].copy();
        self.st_fstart[si] = self.st_ftotal;
        n = 0;
        f = ast.aa[id];
        while f >= 0 {
            if self.st_ftotal < 1024 {
                self.st_fields[self.st_ftotal] = ast.texts[f].copy();
                self.st_ftotal = self.st_ftotal + 1;
                n = n + 1;
            }
            f = ast.nexts[f];
        }
        self.st_fcount[si] = n;
        self.st_count = si + 1;
    }

    #[alloc]
    #[state]
    fn add_method(ref mut self, ref Ast ast, ref String ty, int fid) {
        if self.m_count >= 256 { return; }
        self.m_ty[self.m_count] = ty.copy();
        self.m_name[self.m_count] = ast.texts[fid].copy();
        self.m_id[self.m_count] = fid;
        self.m_count = self.m_count + 1;
    }

    #[alloc]
    #[state]
    fn find_enum_idx(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.en_count {
            if self.en_names[i] == name { return i; }
            i = i + 1;
        }
        return -1;
    }

    fn find_variant_idx(ref mut self, int ei, ref String vname) -> int {
        start = self.en_vstart[ei];
        n = self.en_vcount[ei];
        i = 0;
        while i < n {
            if self.en_variants[start + i] == vname { return i; }
            i = i + 1;
        }
        return -1;
    }

    fn variant_arity(ref mut self, int ei, int vi) -> int {
        return self.en_arity[self.en_vstart[ei] + vi];
    }

    fn enum_max_arity(ref mut self, int ei) -> int {
        start = self.en_vstart[ei];
        n = self.en_vcount[ei];
        mx = 0;
        i = 0;
        while i < n {
            if self.en_arity[start + i] > mx { mx = self.en_arity[start + i]; }
            i = i + 1;
        }
        return mx;
    }

    #[alloc]
    #[state]
    fn add_enum(ref mut self, ref Ast ast, int id) {
        if self.en_count >= 128 { return; }
        ei = self.en_count;
        self.en_names[ei] = ast.texts[id].copy();
        self.en_vstart[ei] = self.en_vtotal;
        n = 0;
        v = ast.aa[id];
        while v >= 0 {
            if self.en_vtotal < 1024 {
                self.en_variants[self.en_vtotal] = ast.texts[v].copy();
                self.en_arity[self.en_vtotal] = ast.tys[v];
                self.en_vtotal = self.en_vtotal + 1;
                n = n + 1;
            }
            v = ast.nexts[v];
        }
        self.en_vcount[ei] = n;
        self.en_count = ei + 1;
    }

    #[alloc]
    #[state]
    /// 记录函数签名（参数种类）
    #[alloc]
    #[state]
    fn add_fn_sig(ref mut self, ref Ast ast, int id, ref String prefix) {
        if self.fn_count >= 256 { return; }
        fi = self.fn_count;
        name = ast.texts[id].copy();
        if prefix.len > 0 {
            name = prefix + ".";
            name = name + ast.texts[id];
        }
        self.fn_names[fi] = name;
        self.fn_pstart[fi] = self.fn_ptotal;
        n = 0;
        p = ast.aa[id];
        while p >= 0 {
            if self.fn_ptotal < 2048 {
                self.fn_pkinds[self.fn_ptotal] = self.param_kind(ast, p);
                self.fn_ptotal = self.fn_ptotal + 1;
                n = n + 1;
            }
            p = ast.nexts[p];
        }
        self.fn_pcount[fi] = n;
        self.fn_count = fi + 1;
    }

    fn fn_param_kind(ref mut self, ref String fname, int i) -> int {
        f = 0;
        while f < self.fn_count {
            if self.fn_names[f] == fname {
                if i < self.fn_pcount[f] {
                    return self.fn_pkinds[self.fn_pstart[f] + i];
                }
                return 0;
            }
            f = f + 1;
        }
        return 0;
    }

    #[alloc]
    #[state]
    fn collect_decls(ref mut self, ref Ast ast, int prog) {
        s = ast.aa[prog];
        while s >= 0 {
            if ast.tags[s] == st(ST::StructDef._tag) {
                self.add_struct(ast, s);
            } elif ast.tags[s] == st(ST::EnumDef._tag) {
                self.add_enum(ast, s);
            } elif ast.tags[s] == st(ST::ImplBlock._tag) {
                m = ast.aa[s];
                while m >= 0 {
                    if ast.tags[m] == st(ST::FnDecl._tag) {
                        self.add_method(ast, ast.texts[s], m);
                        self.add_fn_sig(ast, m, ast.texts[s]);
                    }
                    m = ast.nexts[m];
                }
            } elif ast.tags[s] == st(ST::FnDecl._tag) {
                self.add_fn_sig(ast, s, "");
            }
            s = ast.nexts[s];
        }
    }

    /// 注册字符串字面量，返回全局名与长度（存入 strs）
    #[alloc]
    #[state]
    fn add_str(ref mut self, ref String text) -> int {
        idx = self.str_count;
        if idx < 256 {
            self.strs[idx] = text.copy();
            self.str_count = idx + 1;
        }
        return idx;
    }
}

/// LLVM c"..." 转义（UTF-8 字节）
fn escape_ir(ref String s) -> String {
    b = StringBuf::new();
    i = 0;
    while i < s.len as int {
        c = char_code(s.index(i as usize));
        if c == 34 {
            b.push_str("\\22");
        } elif c == 92 {
            b.push_str("\\5c");
        } elif c == 10 {
            b.push_str("\\0a");
        } elif c == 13 {
            b.push_str("\\0d");
        } elif c == 9 {
            b.push_str("\\09");
        } elif c >= 32 && c <= 126 {
            b.push(__ayanami_int_to_char(c));
        } else {
            b.push_str("\\");
            h = c / 16;
            l = c % 16;
            b.push(hex_digit(h));
            b.push(hex_digit(l));
        }
        i = i + 1;
    }
    return b.to_string();
}

fn hex_digit(int v) -> char {
    if v < 10 { return __ayanami_int_to_char(48 + v); }
    return __ayanami_int_to_char(87 + v);
}

extern "C" fn __ayanami_int_to_char(int c) -> char;

fn bin_llvm_op(int op) -> String {
    if op == bo(BinOp::Add._tag) { return "add"; }
    if op == bo(BinOp::Sub._tag) { return "sub"; }
    if op == bo(BinOp::Mul._tag) { return "mul"; }
    if op == bo(BinOp::Div._tag) { return "sdiv"; }
    if op == bo(BinOp::Mod._tag) { return "srem"; }
    return "";
}

fn cmp_llvm_op(int op) -> String {
    if op == bo(BinOp::Eq._tag) { return "eq"; }
    if op == bo(BinOp::Neq._tag) { return "ne"; }
    if op == bo(BinOp::Lt._tag) { return "slt"; }
    if op == bo(BinOp::Gt._tag) { return "sgt"; }
    if op == bo(BinOp::Le._tag) { return "sle"; }
    if op == bo(BinOp::Ge._tag) { return "sge"; }
    return "";
}

fn is_cmp(int op) -> bool {
    if op == bo(BinOp::Eq._tag) { return true; }
    if op == bo(BinOp::Neq._tag) { return true; }
    if op == bo(BinOp::Lt._tag) { return true; }
    if op == bo(BinOp::Gt._tag) { return true; }
    if op == bo(BinOp::Le._tag) { return true; }
    if op == bo(BinOp::Ge._tag) { return true; }
    return false;
}

/// 数组元素槽布局：统一 8 字节槽（String/结构体为 {ptr, i64} → 16 字节）
/// 内建哨兵：2000 = String（ptr 槽，16 字节）、2001 = float（double 槽）
fn elem_slot(ref Ast ast, int ty) -> String {
    if ty == 2000 { return "ptr"; }
    if ty == 2001 { return "double"; }
    if ty < 0 { return "i64"; }
    t = ast.tags[ty];
    if t == tt(TT::Float._tag) { return "double"; }
    if t == tt(TT::Named._tag) { return "ptr"; }
    if t == tt(TT::Array._tag) { return "ptr"; }
    if t == tt(TT::ArraySized._tag) { return "ptr"; }
    if t == tt(TT::Unique._tag) { return "ptr"; }
    if t == tt(TT::Ref._tag) { return "ptr"; }
    if t == tt(TT::FnPtr._tag) { return "ptr"; }
    if t == tt(TT::Closure._tag) { return "ptr"; }
    return "i64";
}

/// 槽的 LLVM 类型（getelementptr / store 用）
fn elem_llvm(ref Ast ast, int ty) -> String {
    return elem_slot(ast, ty);
}

/// 槽字节数（malloc 分配用）
fn elem_bytes(ref Ast ast, int ty) -> int {
    if ty == 2000 { return 16; }
    if elem_slot(ast, ty) == "ptr" { return 8; }
    return 8;
}

/// 元素是否为 String（布局 { ptr, i64 }，需要两次 store）
fn elem_is_string(ref Ast ast, int ty) -> bool {
    if ty == 2000 { return true; }
    if ty < 0 { return false; }
    if ast.tags[ty] != tt(TT::Named._tag) { return false; }
    return ast.texts[ty] == "String";
}

/// 元素的 AST 类型 id：字面量用内建哨兵，数组用其元素类型，其余 -1（i64 槽）
fn elem_type_of(ref Ast ast, int id) -> int {
    if id < 0 { return -1; }
    if ast.tags[id] == et(ET::Literal._tag) {
        k = ast.bb[id];
        if k == lk(LK::Str._tag) { return 2000; }
        if k == lk(LK::Float._tag) { return 2001; }
        return -1;
    }
    if ast.tags[id] == et(ET::ArraySized._tag) { return ast.aa[id]; }
    if ast.tags[id] == et(ET::ArrayLiteral._tag) { return elem_type_of(ast, ast.aa[id]); }
    if ast.tags[id] == et(ET::ArrayRepeat._tag) { return elem_type_of(ast, ast.aa[id]); }
    return -1;
}

/// 模式名部分（"A|x,y" -> "A"；"E.A|x" -> "E.A"）
fn pat_name(ref String p) -> String {
    i = 0;
    while i < p.len as int {
        if p.index(i as usize) == '|' {
            return p.substring(0 as usize, i as usize);
        }
        i = i + 1;
    }
    return p.copy();
}

/// 模式绑定部分（"A|x,y" -> "x,y"；无 -> ""）
fn pat_binds(ref String p) -> String {
    i = 0;
    while i < p.len as int {
        if p.index(i as usize) == '|' {
            return p.substring((i + 1) as usize, p.len);
        }
        i = i + 1;
    }
    return "";
}

/// 变体短名（"E.A" -> "A"）
fn pat_short(ref String p) -> String {
    i = 0;
    last = -1;
    while i < p.len as int {
        if p.index(i as usize) == '.' { last = i; }
        i = i + 1;
    }
    if last >= 0 {
        return p.substring((last + 1) as usize, p.len);
    }
    return p.copy();
}

/// 枚举名（"E.A" -> "E"；无点 -> ""）
fn pat_enum(ref String p) -> String {
    i = 0;
    last = -1;
    while i < p.len as int {
        if p.index(i as usize) == '.' { last = i; }
        i = i + 1;
    }
    if last >= 0 {
        return p.substring(0 as usize, last as usize);
    }
    return "";
}

fn contains_dot2(ref String s) -> bool {
    i = 0;
    while i < s.len as int {
        if s.index(i as usize) == '.' { return true; }
        i = i + 1;
    }
    return false;
}

fn label(ref mut Emitter e, ref String prefix) -> String {
    b = StringBuf::new();
    b.push_str(prefix);
    b.push_int(e.tmp);
    e.tmp = e.tmp + 1;
    return b.to_string();
}

/// 枚举构造：full = "E.A"（裸变体或带实参）
fn emit_enum_ctor(ref Ast ast, ref String full, int args, ref mut Emitter e) -> Val {
    ename = pat_enum(full);
    vname = pat_short(full);
    ei = e.find_enum_idx(ename);
    if ei < 0 { return mk_int("0"); }
    vi = e.find_variant_idx(ei, vname);
    if vi < 0 { return mk_int("0"); }
    t = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(t);
    e.buf.push_str(" = alloca %enum.");
    e.buf.push_str(ename);
    e.buf.push_str("\n");
    g0 = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(g0);
    e.buf.push_str(" = getelementptr %enum.");
    e.buf.push_str(ename);
    e.buf.push_str(", ptr ");
    e.buf.push_str(t);
    e.buf.push_str(", i32 0, i32 0\n  store i64 ");
    e.buf.push_int(vi);
    e.buf.push_str(", ptr ");
    e.buf.push_str(g0);
    e.buf.push_str("\n");
    k = 0;
    a = args;
    while a >= 0 {
        v = mk_int("0");
        if ast.tags[a] == xt(XT::Arg._tag) {
            v = emit_expr(ast, ast.aa[a], e);
        } else {
            v = emit_expr(ast, a, e);
        }
        g = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(g);
        e.buf.push_str(" = getelementptr %enum.");
        e.buf.push_str(ename);
        e.buf.push_str(", ptr ");
        e.buf.push_str(t);
        e.buf.push_str(", i32 0, i32 ");
        e.buf.push_int(k + 1);
        e.buf.push_str("\n  store i64 ");
        e.buf.push_str(v.a);
        e.buf.push_str(", ptr ");
        e.buf.push_str(g);
        e.buf.push_str("\n");
        k = k + 1;
        a = ast.nexts[a];
    }
    return Val { kind = 4, a = t, b = ename.copy(), ty = -1 };
}

/// 模式匹配条件（返回 i64 0/1 或 temp）
fn emit_pat_cond(ref Ast ast, int arm, ref Val sc, ref mut Emitter e) -> Val {
    ptext = ast.texts[arm];
    pk = ast.tys[arm];
    if pk == 0 { return mk_int("1"); }
    if pk == 4 { return mk_int("1"); }
    if pk == 1 {
        if sc.kind != 4 { return mk_int("0"); }
        vname = pat_short(pat_name(ptext));
        ename = pat_enum(pat_name(ptext));
        if ename.len == 0 { ename = sc.b.copy(); }
        ei = e.find_enum_idx(ename);
        if ei < 0 { return mk_int("0"); }
        vi = e.find_variant_idx(ei, vname);
        if vi < 0 { return mk_int("0"); }
        g = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(g);
        e.buf.push_str(" = getelementptr %enum.");
        e.buf.push_str(sc.b);
        e.buf.push_str(", ptr ");
        e.buf.push_str(sc.a);
        e.buf.push_str(", i32 0, i32 0\n");
        t = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(t);
        e.buf.push_str(" = load i64, ptr ");
        e.buf.push_str(g);
        e.buf.push_str("\n");
        c = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(c);
        e.buf.push_str(" = icmp eq i64 ");
        e.buf.push_str(t);
        e.buf.push_str(", ");
        e.buf.push_int(vi);
        e.buf.push_str("\n");
        return Val { kind = 5, a = c, b = "", ty = -1 };
    }
    if pk == 2 {
        lit = "0";
        if ptext == "true" { lit = "1"; }
        c2 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(c2);
        e.buf.push_str(" = icmp eq i64 ");
        e.buf.push_str(sc.a);
        e.buf.push_str(", ");
        e.buf.push_str(lit);
        e.buf.push_str("\n");
        return Val { kind = 5, a = c2, b = "", ty = -1 };
    }
    if pk == 3 {
        // 只支持整数字面量
        ok = 1;
        i = 0;
        while i < ptext.len as int {
            ch = ptext.index(i as usize);
            if !(ch >= '0' && ch <= '9') { ok = 0; }
            i = i + 1;
        }
        if ok == 0 { return mk_int("0"); }
        c3 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(c3);
        e.buf.push_str(" = icmp eq i64 ");
        e.buf.push_str(sc.a);
        e.buf.push_str(", ");
        e.buf.push_str(ptext);
        e.buf.push_str("\n");
        return Val { kind = 5, a = c3, b = "", ty = -1 };
    }
    return mk_int("0");
}

/// 模式绑定（载荷 -> 局部变量）
fn emit_pat_binds(ref Ast ast, int arm, ref Val sc, ref mut Emitter e) {
    ptext = ast.texts[arm];
    pk = ast.tys[arm];
    binds = pat_binds(ptext);
    if binds.len == 0 { return; }
    // 按 ',' 切分
    start = 0;
    k = 0;
    i = 0;
    while i <= binds.len as int {
        at_end = 0;
        if i == binds.len as int { at_end = 1; }
        is_comma = 0;
        if at_end == 0 {
            if binds.index(i as usize) == ',' { is_comma = 1; }
        }
        if at_end == 1 || is_comma == 1 {
            if i > start {
                bname = binds.substring(start as usize, i as usize);
                g = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(g);
                if pk == 1 {
                    e.buf.push_str(" = getelementptr %enum.");
                    e.buf.push_str(sc.b);
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(sc.a);
                    e.buf.push_str(", i32 0, i32 ");
                    e.buf.push_int(k + 1);
                } else {
                    idx = e.find_field_idx(sc.b, bname);
                    if idx < 0 { return; }
                    e.buf.push_str(" = getelementptr %struct.");
                    e.buf.push_str(sc.b);
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(sc.a);
                    e.buf.push_str(", i32 0, i32 ");
                    e.buf.push_int(idx);
                }
                e.buf.push_str("\n");
                v = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(v);
                e.buf.push_str(" = load i64, ptr ");
                e.buf.push_str(g);
                e.buf.push_str("\n");
                e.declare_local(bname, 0);
                e.buf.push_str("  store i64 ");
                e.buf.push_str(v);
                e.buf.push_str(", ptr %v_");
                e.buf.push_str(bname);
                e.buf.push_str("\n");
                k = k + 1;
            }
            start = i + 1;
        }
        i = i + 1;
    }
}

/// match（语句 want_value=0 / 表达式 want_value=1）
fn emit_match(ref Ast ast, int id, ref mut Emitter e, int want_value) -> Val {
    sc = emit_expr(ast, ast.aa[id], e);
    arms = ast.bb[id];
    cnt = 0;
    a = arms;
    while a >= 0 { cnt = cnt + 1; a = ast.nexts[a]; }
    if cnt == 0 { return mk_int("0"); }
    end_l = label(e, "match.end.");
    res = "";
    if want_value == 1 {
        res = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(res);
        e.buf.push_str(" = alloca i64\n");
    }
    e.buf.push_str("  br label %match.arm.0\n");
    i = 0;
    a = arms;
    prev_body = -1;
    while a >= 0 {
        lbl = "match.arm.";
        b1 = StringBuf::new();
        b1.push_str(lbl);
        b1.push_int(i);
        nxt = end_l.copy();
        if i + 1 < cnt {
            n2 = StringBuf::new();
            n2.push_str("match.arm.");
            n2.push_int(i + 1);
            nxt = n2.to_string();
        }
        bl = StringBuf::new();
        bl.push_str("match.body.");
        bl.push_int(i);
        body_l = bl.to_string();
        e.buf.push_str(b1.to_string());
        e.buf.push_str(":\n");
        cond = emit_pat_cond(ast, a, sc, e);
        if cond.kind == 5 {
            e.buf.push_str("  br i1 ");
            e.buf.push_str(cond.a);
            e.buf.push_str(", label %");
            e.buf.push_str(body_l);
            e.buf.push_str(", label %");
            e.buf.push_str(nxt);
            e.buf.push_str("\n");
        } elif cond.kind == 0 {
            if cond.a == "1" {
                e.buf.push_str("  br label %");
                e.buf.push_str(body_l);
                e.buf.push_str("\n");
            } elif cond.a == "0" {
                e.buf.push_str("  br label %");
                e.buf.push_str(nxt);
                e.buf.push_str("\n");
            } else {
                cc = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(cc);
                e.buf.push_str(" = icmp ne i64 ");
                e.buf.push_str(cond.a);
                e.buf.push_str(", 0\n  br i1 ");
                e.buf.push_str(cc);
                e.buf.push_str(", label %");
                e.buf.push_str(body_l);
                e.buf.push_str(", label %");
                e.buf.push_str(nxt);
                e.buf.push_str("\n");
            }
        } else {
            cc2 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(cc2);
            e.buf.push_str(" = icmp ne i64 ");
            e.buf.push_str(cond.a);
            e.buf.push_str(", 0\n  br i1 ");
            e.buf.push_str(cc2);
            e.buf.push_str(", label %");
            e.buf.push_str(body_l);
            e.buf.push_str(", label %");
            e.buf.push_str(nxt);
            e.buf.push_str("\n");
        }
        e.buf.push_str(body_l);
        e.buf.push_str(":\n");
        emit_pat_binds(ast, a, sc, e);
        body = ast.aa[a];
        if body < 0 { body = prev_body; }
        if body >= 0 {
            prev_body = body;
            btag = ast.tags[body];
            if want_value == 1 {
                if btag == st(ST::Return._tag) {
                    emit_stmt(ast, body, e);
                } elif btag == st(ST::ExprStmt._tag) {
                    v = emit_expr(ast, ast.aa[body], e);
                    e.buf.push_str("  store i64 ");
                    e.buf.push_str(v.a);
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(res);
                    e.buf.push_str("\n");
                } elif btag == st(ST::Block._tag) {
                    emit_stmts(ast, ast.aa[body], e);
                } else {
                    emit_stmt(ast, body, e);
                }
            } else {
                emit_stmt(ast, body, e);
            }
        }
        e.buf.push_str("  br label %");
        e.buf.push_str(end_l);
        e.buf.push_str("\n");
        i = i + 1;
        a = ast.nexts[a];
    }
    e.buf.push_str(end_l);
    e.buf.push_str(":\n");
    if want_value == 1 {
        rv = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(rv);
        e.buf.push_str(" = load i64, ptr ");
        e.buf.push_str(res);
        e.buf.push_str("\n");
        return mk_int(rv);
    }
    return mk_int("0");
}

fn emit_expr(ref Ast ast, int id, ref mut Emitter e) -> Val {
    if id < 0 { return mk_int("0"); }
    tag = ast.tags[id];
    if tag == et(ET::Literal._tag) {
        k = ast.bb[id];
        if k == lk(LK::Int._tag) {
            return mk_int(ast.texts[id]);
        }
        if k == lk(LK::Bool._tag) {
            if ast.texts[id] == "true" { return mk_int("1"); }
            return mk_int("0");
        }
        if k == lk(LK::Str._tag) {
            si = e.add_str(ast.texts[id]);
            b = StringBuf::new();
            b.push_str("@.str.");
            b.push_int(si);
            return mk_str(b.to_string(), ast.texts[id].len as int);
        }
        return mk_int("0");
    }
    if tag == et(ET::Suffixed._tag) {
        return mk_int(ast.texts[id].copy());
    }
    if tag == et(ET::Ident._tag) {
        nm = ast.texts[id];
        if contains_dot2(nm) {
            return emit_enum_ctor(ast, nm, -1, e);
        }
        kd = e.local_kind(nm);
        if kd == 10 {
            // 数组变量：装载 malloc 指针
            t9 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t9);
            e.buf.push_str(" = load ptr, ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str("\n");
            return mk_arr(t9, e.find_elem(nm));
        }
        if kd == 20 {
            t = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t);
            e.buf.push_str(" = load ptr, ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str("\n");
            ei5 = e.etype_of_local(nm);
            en5 = "";
            if ei5 >= 0 { en5 = e.en_names[ei5].copy(); }
            return Val { kind = 4, a = t, b = en5, ty = -1 };
        }
        if kd >= 2 {
            e.declare_local(nm, 2);
            t = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t);
            e.buf.push_str(" = load ptr, ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str("\n");
            return Val { kind = 2, a = t, b = e.struct_of_local(nm), ty = -1 };
        }
        if kd == 1 {
            p = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(p);
            e.buf.push_str(" = load ptr, ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str(".ptr\n");
            l = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(l);
            e.buf.push_str(" = load i64, ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str(".len\n");
            return Val { kind = 1, a = p, b = l, ty = -1 };
        }
        if kd == 10 {
            t = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t);
            e.buf.push_str(" = load ptr, ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str("\n");
            return mk_arr(t, e.elem_of_local(nm));
        }
        e.declare_local(nm, 0);
        t = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(t);
        e.buf.push_str(" = load i64, ptr %v_");
        e.buf.push_str(nm);
        e.buf.push_str("\n");
        return mk_int(t);
    }
    if tag == et(ET::Binary._tag) {
        op = ast.tys[id];
        lt = emit_expr(ast, ast.aa[id], e);
        rt = emit_expr(ast, ast.bb[id], e);
        if is_cmp(op) {
            c = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(c);
            e.buf.push_str(" = icmp ");
            e.buf.push_str(cmp_llvm_op(op));
            e.buf.push_str(" i64 ");
            e.buf.push_str(lt.a);
            e.buf.push_str(", ");
            e.buf.push_str(rt.a);
            e.buf.push_str("\n");
            z = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(z);
            e.buf.push_str(" = zext i1 ");
            e.buf.push_str(c);
            e.buf.push_str(" to i64\n");
            return mk_int(z);
        }
        if op == bo(BinOp::And._tag) || op == bo(BinOp::Or._tag) {
            a = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(a);
            e.buf.push_str(" = icmp ne i64 ");
            e.buf.push_str(lt.a);
            e.buf.push_str(", 0\n");
            b2 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(b2);
            e.buf.push_str(" = icmp ne i64 ");
            e.buf.push_str(rt.a);
            e.buf.push_str(", 0\n");
            c2 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(c2);
            if op == bo(BinOp::And._tag) {
                e.buf.push_str(" = and i1 ");
            } else {
                e.buf.push_str(" = or i1 ");
            }
            e.buf.push_str(a);
            e.buf.push_str(", ");
            e.buf.push_str(b2);
            e.buf.push_str("\n");
            z2 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(z2);
            e.buf.push_str(" = zext i1 ");
            e.buf.push_str(c2);
            e.buf.push_str(" to i64\n");
            return mk_int(z2);
        }
        t2 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(t2);
        e.buf.push_str(" = ");
        e.buf.push_str(bin_llvm_op(op));
        e.buf.push_str(" i64 ");
        e.buf.push_str(lt.a);
        e.buf.push_str(", ");
        e.buf.push_str(rt.a);
        e.buf.push_str("\n");
        return mk_int(t2);
    }
    if tag == et(ET::Unary._tag) {
        at = emit_expr(ast, ast.aa[id], e);
        op = ast.tys[id];
        if op == uo(UnOp::Neg._tag) {
            t3 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t3);
            e.buf.push_str(" = sub i64 0, ");
            e.buf.push_str(at.a);
            e.buf.push_str("\n");
            return mk_int(t3);
        }
        if op == uo(UnOp::Not._tag) {
            a3 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(a3);
            e.buf.push_str(" = icmp eq i64 ");
            e.buf.push_str(at.a);
            e.buf.push_str(", 0\n");
            z3 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(z3);
            e.buf.push_str(" = zext i1 ");
            e.buf.push_str(a3);
            e.buf.push_str(" to i64\n");
            return mk_int(z3);
        }
        return at;
    }
    if tag == et(ET::FnCall._tag) {
        nm = ast.texts[id];
        if contains_dot2(nm) {
            return emit_enum_ctor(ast, nm, ast.aa[id], e);
        }
        if nm == "println" || nm == "print" {
            a = ast.aa[id];
            if a >= 0 {
                v = emit_expr(ast, ast.aa[a], e);
                if v.kind == 1 {
                    e.buf.push_str("  call void @__ayanami_print_str(ptr ");
                    e.buf.push_str(v.a);
                    e.buf.push_str(", i64 ");
                    e.buf.push_str(v.b);
                    e.buf.push_str(")\n");
                } else {
                    e.buf.push_str("  call void @__ayanami_print_int(i64 ");
                    e.buf.push_str(v.a);
                    e.buf.push_str(")\n");
                }
            }
            if nm == "println" {
                e.buf.push_str("  call void @__ayanami_print_ln()\n");
            }
            return mk_int("0");
        }
        b = StringBuf::new();
        b.push_str("  ");
        t4 = e.fresh();
        b.push_str(t4);
        b.push_str(" = call i64 @");
        b.push_str(nm);
        b.push_str("(");
        first = 1;
        a2 = ast.aa[id];
        ak = 0;
        while a2 >= 0 {
            at2 = emit_expr(ast, ast.aa[a2], e);
            if first == 0 { b.push_str(", "); }
            pk2 = e.fn_param_kind(nm, ak);
            if pk2 == 0 {
                b.push_str("i64 ");
            } else {
                b.push_str("ptr ");
            }
            b.push_str(at2.a);
            first = 0;
            ak = ak + 1;
            a2 = ast.nexts[a2];
        }
        b.push_str(")\n");
        e.buf.push_str(b.to_string());
        return mk_int(t4);
    }
    if tag == et(ET::StructLiteral._tag) {
        nm = ast.texts[id];
        t = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(t);
        e.buf.push_str(" = alloca %struct.");
        e.buf.push_str(nm);
        e.buf.push_str("\n");
        f = ast.aa[id];
        while f >= 0 {
            idx = e.find_field_idx(nm, ast.texts[f]);
            if idx >= 0 {
                v = emit_expr(ast, ast.aa[f], e);
                g = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(g);
                e.buf.push_str(" = getelementptr %struct.");
                e.buf.push_str(nm);
                e.buf.push_str(", ptr ");
                e.buf.push_str(t);
                e.buf.push_str(", i32 0, i32 ");
                e.buf.push_int(idx);
                e.buf.push_str("\n  store i64 ");
                e.buf.push_str(v.a);
                e.buf.push_str(", ptr ");
                e.buf.push_str(g);
                e.buf.push_str("\n");
            }
            f = ast.nexts[f];
        }
        return Val { kind = 2, a = t, b = nm.copy(), ty = -1 };
    }
    if tag == et(ET::FieldAccess._tag) {
        obj = emit_expr(ast, ast.aa[id], e);
        if obj.kind == 4 {
            if ast.texts[id] == "_tag" {
                g = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(g);
                e.buf.push_str(" = getelementptr %enum.");
                e.buf.push_str(obj.b);
                e.buf.push_str(", ptr ");
                e.buf.push_str(obj.a);
                e.buf.push_str(", i32 0, i32 0\n");
                v = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(v);
                e.buf.push_str(" = load i64, ptr ");
                e.buf.push_str(g);
                e.buf.push_str("\n");
                return mk_int(v);
            }
            return mk_int("0");
        }
        if obj.kind == 2 {
            idx = e.find_field_idx(obj.b, ast.texts[id]);
            if idx >= 0 {
                g2 = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(g2);
                e.buf.push_str(" = getelementptr %struct.");
                e.buf.push_str(obj.b);
                e.buf.push_str(", ptr ");
                e.buf.push_str(obj.a);
                e.buf.push_str(", i32 0, i32 ");
                e.buf.push_int(idx);
                e.buf.push_str("\n");
                v2 = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(v2);
                e.buf.push_str(" = load i64, ptr ");
                e.buf.push_str(g2);
                e.buf.push_str("\n");
                return mk_int(v2);
            }
        }
        return mk_int("0");
    }
    if tag == et(ET::MethodCall._tag) {
        obj = emit_expr(ast, ast.aa[id], e);
        mid = -1;
        if obj.kind == 2 {
            mid = e.find_method_id(obj.b, ast.texts[id]);
        }
        if mid >= 0 {
            b3 = StringBuf::new();
            b3.push_str("  ");
            t5 = e.fresh();
            b3.push_str(t5);
            b3.push_str(" = call i64 @");
            b3.push_str(obj.b);
            b3.push_str(".");
            b3.push_str(ast.texts[id]);
            b3.push_str("(ptr ");
            b3.push_str(obj.a);
            a3 = ast.bb[id];
            ak3 = 1;
            while a3 >= 0 {
                at3 = emit_expr(ast, ast.aa[a3], e);
                mfull = obj.b + ".";
                mfull = mfull + ast.texts[id];
                pk3 = e.fn_param_kind(mfull, ak3);
                if pk3 == 0 {
                    b3.push_str(", i64 ");
                } else {
                    b3.push_str(", ptr ");
                }
                b3.push_str(at3.a);
                ak3 = ak3 + 1;
                a3 = ast.nexts[a3];
            }
            b3.push_str(")\n");
            e.buf.push_str(b3.to_string());
            return mk_int(t5);
        }
        return mk_int("0");
    }
    if tag == et(ET::Match._tag) {
        return emit_match(ast, id, e, 1);
    }
    if tag == et(ET::Cast._tag) {
        return emit_expr(ast, ast.aa[id], e);
    }
    if tag == et(ET::ArraySized._tag) {
        // [T; n]：元素类型来自 tys，n 是表达式
        cnt = emit_expr(ast, ast.aa[id], e);
        return emit_array_new(ast, id, ast.tys[id], cnt.a, e);
    }
    if tag == et(ET::ArrayLiteral._tag) {
        // [a, b, c]：元素类型由首元素推导，逐个 store（首元素只求值一次）
        head = ast.aa[id];
        cnt2 = 0;
        t2 = head;
        while t2 >= 0 { cnt2 = cnt2 + 1; t2 = ast.nexts[t2]; }
        bcnt = StringBuf::new();
        bcnt.push_int(cnt2);
        ety = elem_type_of(ast, head);
        cnt_s = bcnt.to_string();
        av = emit_array_new(ast, id, ety, cnt_s, e);
        lty = elem_llvm(ast, ety);
        two_char = 0;
        if elem_is_string(ast, ety) { two_char = 1; }
        el = ast.aa[id];
        k = 0;
        while el >= 0 {
            ev = emit_expr(ast, el, e);
            kb = StringBuf::new();
            kb.push_int(k);
            g = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(g);
            e.buf.push_str(" = getelementptr ");
            e.buf.push_str(lty);
            e.buf.push_str(", ptr ");
            e.buf.push_str(av.a);
            e.buf.push_str(", i64 ");
            e.buf.push_str(kb.to_string());
            e.buf.push_str("\n");
            store_elem(e, lty, two_char, g, ev);
            k = k + 1;
            el = ast.nexts[el];
        }
        return av;
    }
    if tag == et(ET::ArrayRepeat._tag) {
        // [expr; n]：值求值一次，循环填充到 n 个槽
        cnt3 = emit_expr(ast, ast.bb[id], e);
        ety3 = elem_type_of(ast, ast.aa[id]);
        ev3 = emit_expr(ast, ast.aa[id], e);
        av3 = emit_array_new(ast, id, ety3, cnt3.a, e);
        lty3 = elem_llvm(ast, ety3);
        fill = ev3.a;
        if elem_is_leaf(lty3) {
            t3b = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t3b);
            e.buf.push_str(" = trunc i64 ");
            e.buf.push_str(ev3.a);
            e.buf.push_str(" to ");
            e.buf.push_str(lty3);
            e.buf.push_str("\n  ");
            z3 = e.fresh();
            e.buf.push_str(z3);
            e.buf.push_str(" = zext ");
            e.buf.push_str(lty3);
            e.buf.push_str(" ");
            e.buf.push_str(t3b);
            e.buf.push_str(" to i64\n");
            fill = z3;
        }
        emit_array_fill(e, lty3, av3.a, cnt3.a, fill);
        return av3;
    }
    if tag == et(ET::Index._tag) {
        // xs[i]：取值（8 位元素做 sext；其余按元素类型装载）
        base3 = emit_expr(ast, ast.aa[id], e);
        iv3 = emit_expr(ast, ast.bb[id], e);
        ety3 = base3.ty;
        lty4 = "i64";
        if ety3 >= 0 {
            lty4 = elem_llvm(ast, ety3);
        }
        g4 = elem_gep(e, lty4, base3.a, iv3.a);
        if lty4 == "i8" {
            t4 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t4);
            e.buf.push_str(" = load i8, ptr ");
            e.buf.push_str(g4);
            e.buf.push_str("\n  ");
            s4 = e.fresh();
            e.buf.push_str(s4);
            e.buf.push_str(" = sext i8 ");
            e.buf.push_str(t4);
            e.buf.push_str(" to i64\n");
            return mk_int(s4);
        }
        if lty4 == "i32" {
            t5 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t5);
            e.buf.push_str(" = load i32, ptr ");
            e.buf.push_str(g4);
            e.buf.push_str("\n  ");
            s5 = e.fresh();
            e.buf.push_str(s5);
            e.buf.push_str(" = sext i32 ");
            e.buf.push_str(t5);
            e.buf.push_str(" to i64\n");
            return mk_int(s5);
        }
        t6 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(t6);
        e.buf.push_str(" = load ");
        e.buf.push_str(lty4);
        e.buf.push_str(", ptr ");
        e.buf.push_str(g4);
        e.buf.push_str("\n");
        if lty4 == "double" {
            return Val { kind = 0, a = t6, b = "", ty = ety3 };
        }
        return mk_int(t6);
    }
    if tag == et(ET::Ref._tag) {
        // &x / ref x：返回地址（仅用于数组/结构体实参场景）
        if ast.tags[ast.aa[id]] == et(ET::Ident._tag) {
            nm7 = ast.texts[ast.aa[id]];
            e.declare_local(nm7, 0);
            t7 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t7);
            e.buf.push_str(" = load i64, ptr %v_");
            e.buf.push_str(nm7);
            e.buf.push_str("\n");
            return mk_int(t7);
        }
        return emit_expr(ast, ast.aa[id], e);
    }
    return mk_int("0");
}

fn emit_stmts(ref Ast ast, int stmts, ref mut Emitter e) {
    s = stmts;
    while s >= 0 {
        emit_stmt(ast, s, e);
        s = ast.nexts[s];
    }
}

/// 元素是否为<8 字节标量（需要 trunc / sext 转换）
fn elem_is_leaf(ref String lty) -> bool {
    if lty == "i8" { return true; }
    if lty == "i32" { return true; }
    return false;
}

/// 单元素赋值（emit_array_fill 用）
fn store_one(ref mut Emitter e, ref String lty, ref String gep, ref String v) {
    if elem_is_leaf(lty) {
        w = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(w);
        e.buf.push_str(" = trunc i64 ");
        e.buf.push_str(v);
        e.buf.push_str(" to ");
        e.buf.push_str(lty);
        e.buf.push_str("\n  store ");
        e.buf.push_str(lty);
        e.buf.push_str(" ");
        e.buf.push_str(w);
        e.buf.push_str(", ptr ");
        e.buf.push_str(gep);
        e.buf.push_str("\n");
        return;
    }
    e.buf.push_str("  store ");
    e.buf.push_str(lty);
    e.buf.push_str(" ");
    e.buf.push_str(v);
    e.buf.push_str(", ptr ");
    e.buf.push_str(gep);
    e.buf.push_str("\n");
}

/// 循环填充：`[T; n]`（val 为 "0"）/ `[expr; n]`（val 为元素值）的元素写入
/// 用 alloca 计数器（不依赖 %entry 块，可在任意位置展开）
fn emit_array_fill(ref mut Emitter e, ref String lty, ref String base, ref String cnt, ref String val) {
    n = e.tmp;
    e.tmp = e.tmp + 1;
    e.buf.push_str("  %fi.");
    e.buf.push_int(n);
    e.buf.push_str(" = alloca i64\n  store i64 0, ptr %fi.");
    e.buf.push_int(n);
    e.buf.push_str("\n  br label %fill.cond.");
    e.buf.push_int(n);
    e.buf.push_str("\nfill.cond.");
    e.buf.push_int(n);
    e.buf.push_str(":\n  %fv.");
    e.buf.push_int(n);
    e.buf.push_str(" = load i64, ptr %fi.");
    e.buf.push_int(n);
    e.buf.push_str("\n  %fc.");
    e.buf.push_int(n);
    e.buf.push_str(" = icmp slt i64 %fv.");
    e.buf.push_int(n);
    e.buf.push_str(", ");
    e.buf.push_str(cnt);
    e.buf.push_str("\n  br i1 %fc.");
    e.buf.push_int(n);
    e.buf.push_str(", label %fill.body.");
    e.buf.push_int(n);
    e.buf.push_str(", label %fill.end.");
    e.buf.push_int(n);
    e.buf.push_str("\nfill.body.");
    e.buf.push_int(n);
    e.buf.push_str(":\n");
    g = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(g);
    e.buf.push_str(" = getelementptr ");
    e.buf.push_str(lty);
    e.buf.push_str(", ptr ");
    e.buf.push_str(base);
    e.buf.push_str(", i64 %fv.");
    e.buf.push_int(n);
    e.buf.push_str("\n  store ");
    e.buf.push_str(lty);
    e.buf.push_str(" ");
    e.buf.push_str(val);
    e.buf.push_str(", ptr ");
    e.buf.push_str(g);
    e.buf.push_str("\n  %fn.");
    e.buf.push_int(n);
    e.buf.push_str(" = add i64 %fv.");
    e.buf.push_int(n);
    e.buf.push_str(", 1\n  store i64 %fn.");
    e.buf.push_int(n);
    e.buf.push_str(", ptr %fi.");
    e.buf.push_int(n);
    e.buf.push_str("\n  br label %fill.cond.");
    e.buf.push_int(n);
    e.buf.push_str("\nfill.end.");
    e.buf.push_int(n);
    e.buf.push_str(":\n");
}

/// 数组元素写入：lty 元素 LLVM 类型，two_char 时按 { ptr, i64 } 双字写
fn store_elem(ref mut Emitter e, ref String lty, int two_char, ref String gep, ref Val v) {
    if lty == "i64" {
        e.buf.push_str("  store i64 ");
        e.buf.push_str(v.a);
        e.buf.push_str(", ptr ");
        e.buf.push_str(gep);
        e.buf.push_str("\n");
        return;
    }
    if lty == "ptr" {
        e.buf.push_str("  store ptr ");
        e.buf.push_str(v.a);
        e.buf.push_str(", ptr ");
        e.buf.push_str(gep);
        e.buf.push_str("\n");
        if two_char == 1 {
            g2 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(g2);
            e.buf.push_str(" = getelementptr i8, ptr ");
            e.buf.push_str(gep);
            e.buf.push_str(", i64 8\n  store i64 ");
            e.buf.push_str(v.b);
            e.buf.push_str(", ptr ");
            e.buf.push_str(g2);
            e.buf.push_str("\n");
        }
        return;
    }
    // i8/i32/double：截断后写入，读回时按同样宽度
    e.buf.push_str("  ");
    w = e.fresh();
    e.buf.push_str(w);
    e.buf.push_str(" = trunc i64 ");
    e.buf.push_str(v.a);
    e.buf.push_str(" to ");
    e.buf.push_str(lty);
    e.buf.push_str("\n  store ");
    e.buf.push_str(lty);
    e.buf.push_str(" ");
    e.buf.push_str(w);
    e.buf.push_str(", ptr ");
    e.buf.push_str(gep);
    e.buf.push_str("\n");
}

/// 数组 GEP：base 指针 + i64 下标 → 元素地址
fn elem_gep(ref mut Emitter e, ref String lty, ref String base, ref String idx) -> String {
    g = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(g);
    e.buf.push_str(" = getelementptr ");
    e.buf.push_str(lty);
    e.buf.push_str(", ptr ");
    e.buf.push_str(base);
    e.buf.push_str(", i64 ");
    e.buf.push_str(idx);
    e.buf.push_str("\n");
    return g;
}

/// `xs[i] = v`（ST::IndexAssign）：aa=基址表达式，bb=下标，cc=值
/// 基址是数组局部变量时按元素类型直接写入 malloc 缓冲区
fn emit_index_assign(ref Ast ast, int id, ref mut Emitter e) {
    base_id = ast.aa[id];
    if ast.tags[base_id] != et(ET::Ident._tag) { return; }
    nm = ast.texts[base_id];
    ety = e.elem_of_local(nm);
    if ety < 0 { return; }
    lty = elem_llvm(ast, ety);
    two_char = 0;
    if elem_is_string(ast, ety) { two_char = 1; }
    iv = emit_expr(ast, ast.bb[id], e);
    t = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(t);
    e.buf.push_str(" = load ptr, ptr %v_");
    e.buf.push_str(nm);
    e.buf.push_str("\n");
    g = elem_gep(e, lty, t, iv.a);
    v = emit_expr(ast, ast.cc[id], e);
    store_elem(e, lty, two_char, g, v);
}

/// 数组字面量 / [expr; n] / [T; n]：malloc 缓冲区，返回 ptr 值
fn emit_array_new(ref Ast ast, int id, int ety, ref String count, ref mut Emitter e) -> Val {
    lty = elem_llvm(ast, ety);
    sz = elem_bytes(ast, ety);
    c = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(c);
    e.buf.push_str(" = mul i64 ");
    e.buf.push_str(count);
    e.buf.push_str(", ");
    e.buf.push_int(sz);
    e.buf.push_str("\n");
    big = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(big);
    e.buf.push_str(" = icmp slt i64 ");
    e.buf.push_str(c);
    e.buf.push_str(", 1\n  ");
    z = e.fresh();
    e.buf.push_str(z);
    e.buf.push_str(" = select i1 ");
    e.buf.push_str(big);
    e.buf.push_str(", i64 1, i64 ");
    e.buf.push_str(c);
    e.buf.push_str("\n");
    raw = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(raw);
    e.buf.push_str(" = call ptr @malloc(i64 ");
    e.buf.push_str(z);
    e.buf.push_str(")\n");
    e.buf.push_str("  call void @llvm.memset.p0.i64(ptr ");
    e.buf.push_str(raw);
    e.buf.push_str(", i8 0, i64 ");
    e.buf.push_str(z);
    e.buf.push_str(", i1 false)\n");
    return mk_arr(raw, ety);
}

fn emit_stmt(ref Ast ast, int id, ref mut Emitter e) {
    tag = ast.tags[id];
    if tag == st(ST::IndexAssign._tag) {
        emit_index_assign(ast, id, e);
    } elif tag == st(ST::Assign._tag) {
        rhs_id = ast.aa[id];
        nm = ast.texts[id];
        v = emit_expr(ast, rhs_id, e);
        if v.kind == 3 {
            e.declare_array_local(nm, v.ty);
            e.buf.push_str("  store ptr ");
            e.buf.push_str(v.a);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str("\n");
            return;
        }
        if v.kind == 4 {
            ei4 = e.find_enum_idx(v.b);
            e.declare_local(nm, 20);
            e.record_etype(nm, ei4);
            e.buf.push_str("  store ptr ");
            e.buf.push_str(v.a);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str("\n");
            return;
        }
        if v.kind == 2 {
            si2 = e.find_struct_idx(v.b);
            e.declare_local(nm, 100 + si2);
            e.buf.push_str("  store ptr ");
            e.buf.push_str(v.a);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str("\n");
            return;
        }
        if v.kind == 1 {
            e.declare_local(nm, 1);
            e.buf.push_str("  store ptr ");
            e.buf.push_str(v.a);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str(".ptr\n  store i64 ");
            e.buf.push_str(v.b);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str(".len\n");
        } else {
            e.declare_local(nm, 0);
            e.buf.push_str("  store i64 ");
            e.buf.push_str(v.a);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str("\n");
        }
    } elif tag == st(ST::Return._tag) {
        if ast.aa[id] >= 0 {
            v2 = emit_expr(ast, ast.aa[id], e);
            e.buf.push_str("  ret i64 ");
            e.buf.push_str(v2.a);
            e.buf.push_str("\n");
        } else {
            e.buf.push_str("  ret i64 0\n");
        }
    } elif tag == st(ST::ExprStmt._tag) {
        emit_expr(ast, ast.aa[id], e);
    } elif tag == st(ST::Match._tag) {
        emit_match(ast, id, e, 0);
    } elif tag == st(ST::FieldAssign._tag) {
        obj = emit_expr(ast, ast.aa[id], e);
        if obj.kind == 2 {
            idx = e.find_field_idx(obj.b, ast.texts[id]);
            if idx >= 0 {
                v = emit_expr(ast, ast.bb[id], e);
                g = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(g);
                e.buf.push_str(" = getelementptr %struct.");
                e.buf.push_str(obj.b);
                e.buf.push_str(", ptr ");
                e.buf.push_str(obj.a);
                e.buf.push_str(", i32 0, i32 ");
                e.buf.push_int(idx);
                e.buf.push_str("\n  store i64 ");
                e.buf.push_str(v.a);
                e.buf.push_str(", ptr ");
                e.buf.push_str(g);
                e.buf.push_str("\n");
            }
        }
    } elif tag == st(ST::If._tag) {
        c = emit_expr(ast, ast.aa[id], e);
        then_l = label(e, "if.then.");
        else_l = label(e, "if.else.");
        end_l = label(e, "if.end.");
        cc = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(cc);
        e.buf.push_str(" = icmp ne i64 ");
        e.buf.push_str(c.a);
        e.buf.push_str(", 0\n  br i1 ");
        e.buf.push_str(cc);
        e.buf.push_str(", label %");
        e.buf.push_str(then_l);
        e.buf.push_str(", label %");
        e.buf.push_str(else_l);
        e.buf.push_str("\n");
        e.buf.push_str(then_l);
        e.buf.push_str(":\n");
        emit_stmts(ast, ast.aa[ast.bb[id]], e);
        e.buf.push_str("  br label %");
        e.buf.push_str(end_l);
        e.buf.push_str("\n");
        e.buf.push_str(else_l);
        e.buf.push_str(":\n");
        e2 = ast.dd[id];
        if e2 >= 0 {
            emit_stmts(ast, ast.aa[e2], e);
        }
        e.buf.push_str("  br label %");
        e.buf.push_str(end_l);
        e.buf.push_str("\n");
        e.buf.push_str(end_l);
        e.buf.push_str(":\n");
    } elif tag == st(ST::While._tag) {
        cond_l = label(e, "while.cond.");
        body_l = label(e, "while.body.");
        end_l = label(e, "while.end.");
        e.buf.push_str("  br label %");
        e.buf.push_str(cond_l);
        e.buf.push_str("\n");
        e.buf.push_str(cond_l);
        e.buf.push_str(":\n");
        c2 = emit_expr(ast, ast.aa[id], e);
        cc2 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(cc2);
        e.buf.push_str(" = icmp ne i64 ");
        e.buf.push_str(c2.a);
        e.buf.push_str(", 0\n  br i1 ");
        e.buf.push_str(cc2);
        e.buf.push_str(", label %");
        e.buf.push_str(body_l);
        e.buf.push_str(", label %");
        e.buf.push_str(end_l);
        e.buf.push_str("\n");
        e.buf.push_str(body_l);
        e.buf.push_str(":\n");
        emit_stmts(ast, ast.aa[ast.bb[id]], e);
        e.buf.push_str("  br label %");
        e.buf.push_str(cond_l);
        e.buf.push_str("\n");
        e.buf.push_str(end_l);
        e.buf.push_str(":\n");
    } elif tag == st(ST::For._tag) {
        e.declare_local(ast.texts[id], 0);
        v = emit_expr(ast, ast.aa[id], e);
        e.buf.push_str("  store i64 ");
        e.buf.push_str(v.a);
        e.buf.push_str(", ptr %v_");
        e.buf.push_str(ast.texts[id]);
        e.buf.push_str("\n");
        cond_l = label(e, "for.cond.");
        body_l = label(e, "for.body.");
        end_l = label(e, "for.end.");
        e.buf.push_str("  br label %");
        e.buf.push_str(cond_l);
        e.buf.push_str("\n");
        e.buf.push_str(cond_l);
        e.buf.push_str(":\n");
        iv = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(iv);
        e.buf.push_str(" = load i64, ptr %v_");
        e.buf.push_str(ast.texts[id]);
        e.buf.push_str("\n");
        ev = emit_expr(ast, ast.bb[id], e);
        c3 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(c3);
        e.buf.push_str(" = icmp slt i64 ");
        e.buf.push_str(iv);
        e.buf.push_str(", ");
        e.buf.push_str(ev.a);
        e.buf.push_str("\n  br i1 ");
        e.buf.push_str(c3);
        e.buf.push_str(", label %");
        e.buf.push_str(body_l);
        e.buf.push_str(", label %");
        e.buf.push_str(end_l);
        e.buf.push_str("\n");
        e.buf.push_str(body_l);
        e.buf.push_str(":\n");
        emit_stmts(ast, ast.aa[ast.dd[id]], e);
        iv2 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(iv2);
        e.buf.push_str(" = load i64, ptr %v_");
        e.buf.push_str(ast.texts[id]);
        e.buf.push_str("\n");
        nx = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(nx);
        e.buf.push_str(" = add i64 ");
        e.buf.push_str(iv2);
        e.buf.push_str(", 1\n  store i64 ");
        e.buf.push_str(nx);
        e.buf.push_str(", ptr %v_");
        e.buf.push_str(ast.texts[id]);
        e.buf.push_str("\n  br label %");
        e.buf.push_str(cond_l);
        e.buf.push_str("\n");
        e.buf.push_str(end_l);
        e.buf.push_str(":\n");
    }
}

fn emit_fn(ref Ast ast, int id, ref mut Emitter e) {
    emit_fn_named(ast, id, "", e);
}

fn emit_fn_named(ref Ast ast, int id, ref String prefix, ref mut Emitter e) {
    e.tmp = 0;
    e.lv_count = 0;
    name = ast.texts[id];
    e.buf.push_str("define i64 @");
    if prefix.len > 0 {
        e.buf.push_str(prefix);
        e.buf.push_str(".");
    }
    e.buf.push_str(name);
    e.buf.push_str("(");
    first = 1;
    p = ast.aa[id];
    idx = 0;
    while p >= 0 {
        if first == 0 { e.buf.push_str(", "); }
        if ast.texts[p] == "self" {
            e.buf.push_str("ptr %self");
        } else {
            pk_sig = e.param_kind(ast, p);
            if pk_sig == 0 {
                e.buf.push_str("i64 %a");
            } else {
                e.buf.push_str("ptr %a");
            }
            e.buf.push_int(idx);
        }
        first = 0;
        idx = idx + 1;
        p = ast.nexts[p];
    }
    e.buf.push_str(") {\nentry:\n");
    p2 = ast.aa[id];
    idx2 = 0;
    while p2 >= 0 {
        if ast.texts[p2] == "self" {
            e.buf.push_str("  %v_self = alloca ptr\n  store ptr %self, ptr %v_self\n");
            kind_self = 2;
            si_self = e.find_struct_idx(prefix);
            if si_self >= 0 { kind_self = 100 + si_self; }
            if e.lv_count < 512 {
                e.locals[e.lv_count] = "self";
                e.local_kinds[e.lv_count] = kind_self;
                e.lv_count = e.lv_count + 1;
            }
        } else {
            pname = ast.texts[p2];
            pk = e.param_kind(ast, p2);
            ei_p = -1;
            if pk == 20 {
                ptn = "";
                pt = ast.tys[p2];
                if pt >= 0 {
                    if ast.tags[pt] == tt(TT::Named._tag) { ptn = ast.texts[pt].copy(); }
                }
                ei_p = e.find_enum_idx(ptn);
            }
            if pk == 0 {
                e.buf.push_str("  %v_");
                e.buf.push_str(pname);
                e.buf.push_str(" = alloca i64\n  store i64 %a");
                e.buf.push_int(idx2);
                e.buf.push_str(", ptr %v_");
                e.buf.push_str(pname);
                e.buf.push_str("\n");
            } else {
                e.buf.push_str("  %v_");
                e.buf.push_str(pname);
                e.buf.push_str(" = alloca ptr\n  store ptr %a");
                e.buf.push_int(idx2);
                e.buf.push_str(", ptr %v_");
                e.buf.push_str(pname);
                e.buf.push_str("\n");
            }
            if e.lv_count < 512 {
                e.locals[e.lv_count] = pname.copy();
                e.local_kinds[e.lv_count] = pk;
                e.local_etypes[e.lv_count] = ei_p;
                e.lv_count = e.lv_count + 1;
            }
        }
        idx2 = idx2 + 1;
        p2 = ast.nexts[p2];
    }
    emit_stmts(ast, ast.aa[ast.bb[id]], e);
    e.buf.push_str("  ret i64 0\n}\n");
}

#[alloc]
#[state]
pub fn emit_program(ref Ast ast, int prog) -> String {
    e = Emitter::new();
    e.collect_decls(ast, prog);
    // 结构体类型定义
    si = 0;
    while si < e.st_count {
        e.buf.push_str("%struct.");
        e.buf.push_str(e.st_names[si]);
        e.buf.push_str(" = type { ");
        n = e.st_fcount[si];
        i = 0;
        while i < n {
            if i > 0 { e.buf.push_str(", "); }
            e.buf.push_str("i64");
            i = i + 1;
        }
        e.buf.push_str(" }\n");
        si = si + 1;
    }
    // 枚举类型定义（tag + 载荷槽）
    ei2 = 0;
    while ei2 < e.en_count {
        e.buf.push_str("%enum.");
        e.buf.push_str(e.en_names[ei2]);
        e.buf.push_str(" = type { i64");
        mx = e.enum_max_arity(ei2);
        k2 = 0;
        while k2 < mx {
            e.buf.push_str(", i64");
            k2 = k2 + 1;
        }
        e.buf.push_str(" }\n");
        ei2 = ei2 + 1;
    }
    // 函数与方法
    s = ast.aa[prog];
    while s >= 0 {
        if ast.tags[s] == st(ST::FnDecl._tag) {
            emit_fn(ast, s, e);
        } elif ast.tags[s] == st(ST::ImplBlock._tag) {
            m = ast.aa[s];
            while m >= 0 {
                if ast.tags[m] == st(ST::FnDecl._tag) {
                    emit_fn_named(ast, m, ast.texts[s], e);
                }
                m = ast.nexts[m];
            }
        }
        s = ast.nexts[s];
    }
    e.buf.push_str("declare void @__ayanami_print_int(i64)\ndeclare void @__ayanami_print_ln()\ndeclare void @__ayanami_print_str(ptr, i64)\n");
    // 数组分配/清零所需（M6a）：malloc + llvm.memset
    e.buf.push_str("declare ptr @malloc(i64)\n");
    e.buf.push_str("declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)\n");
    // 字符串字面量全局
    i = 0;
    while i < e.str_count {
        text = e.strs[i];
        e.buf.push_str("@.str.");
        e.buf.push_int(i);
        e.buf.push_str(" = private unnamed_addr constant [");
        e.buf.push_int(text.len as int + 1);
        e.buf.push_str(" x i8] c\"");
        e.buf.push_str(escape_ir(text));
        e.buf.push_str("\\00\"\n");
        i = i + 1;
    }
    return e.buf.to_string();
}
