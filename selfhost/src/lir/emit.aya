            fop = "";
            if op == bo(BinOp::Add._tag) { fop = "fadd"; }
            elif op == bo(BinOp::Sub._tag) { fop = "fsub"; }
            elif op == bo(BinOp::Mul._tag) { fop = "fmul"; }
            elif op == bo(BinOp::Div._tag) { fop = "fdiv"; }
