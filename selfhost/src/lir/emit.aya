                if recv_arg_ty2 != -1 { gp_m2 = e.impl_gparam2(ast, recv_ty); }
                if gp_m.len > 0 {
                    rk_m = e.ret_kind_with2(ast, mrty, gp_m, recv_arg_ty, gp_m2, recv_arg_ty2);
