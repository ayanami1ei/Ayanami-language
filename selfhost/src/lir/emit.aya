import "string";
import "aya_sb";
import "aya_ast";
import "aya_log";

// M5b/M6a：AST -> LLVM IR 文本（int/bool/String/struct/数组 子集）
// 值表示：Val { kind: 0=int, 1=String(ptr,len), 2=struct(ptr,类型名), 3=数组(ptr,元素类型 id) }
pub struct Val {
    int kind
    String a
    String b
    int ty
}

pub struct Emitter {
    StringBuf buf
    // 类型定义缓冲（支持发射期新建实例：类型定义始终在函数体之前）
    StringBuf type_buf
    int body_phase
    int tmp
    [String] locals
    [int] local_kinds
    [int] local_forms
    [int] local_ftypes
    int lv_count
    // 数组局部变量的元素类型（AST 类型节点 id；-1 表示非数组）
    [int] local_etypes
    [String] strs
    int str_count
    // 结构体表（字段扁平）
    [String] st_names
    [int] st_fstart
    [int] st_fcount
    [String] st_fields
    int st_ftotal
    int st_count
    // 字段类型：0=int槽 1=String(2槽) 2=struct 3=array
    [int] st_fkind
    [int] st_finfo
    [int] st_fslot
    [int] st_ftype
    [int] st_slots
    // 方法表：(类型, 方法名) -> FnDecl id
    [String] m_ty
    [String] m_name
    [int] m_id
    int m_count
    // 枚举表
    [String] en_names
    [int] en_vstart
    [int] en_vcount
    [String] en_variants
    [int] en_arity
    int en_vtotal
    int en_count
    // 载荷类型（扁平）与每变体起点；槽位数（String 载荷占 2 槽）
    [int] en_ptype
    [int] en_pvstart
    int en_ptotal
    [int] en_vslots
    // 枚举实例：en 下标 / 源枚举下标 / 类型实参标记
    [int] ei_ens
    [int] ei_srcs
    [int] ei_args
    int ei_count
    // 容器局部 -> 源结构体名（枚举载荷推断用）
    [String] ln_names
    [String] ln_srcs
    int ln_count
    // 函数签名表（参数种类：0=int, 20=enum, 100+si=struct）
    [String] fn_names
    // 是否 extern（C 符号，不加修饰）
    [int] fn_extern
    [int] fn_pstart
    [int] fn_pcount
    [int] fn_pkinds
    int fn_ptotal
    int fn_count
    [int] fn_rtype
    [int] fn_rllvm
    [int] fn_first
    int cur_rtype
    // 当前发射的定义在同名候选中的序数（重载符号后缀）
    int cur_ord
    // 当前 impl 的类型名（方法签名中的 Self 替换）
    String cur_self_ty
    // 3tq 阶段 1：泛型实例键（"Name[Arg]"；只收集，供后续特化使用）
    [String] inst_keys
    int inst_count
    // 全部泛型参数名（跳过以类型参数为实参的"实例"）
    [String] gp_names
    int gp_names_count
    // 3tq 阶段 2：结构体实例（特化布局）：实例名 / 源结构体下标 / 类型实参节点
    [String] inst_st_names
    [int] inst_st_src
    [int] inst_st_argty
    [int] inst_st_argty2
    int inst_st_count
    // 实例对应的类型实参节点（与 inst_keys 平行）
    [int] inst_arg_tys
    [int] inst_arg2_tys
    // 3tq 阶段 2/3：特化 worklist（FnDecl 节点、前缀、类型参数名、实参类型节点）
    [int] spec_nodes
    [String] spec_prefixes
    [String] spec_params
    [int] spec_args
    [String] spec_params2
    [int] spec_args2
    [String] spec_params3
    [int] spec_args3
    [String] spec_params4
    [int] spec_args4
    [String] spec_selfs
    int spec_count
    // ref String 实参临时与回写
    [String] cb_tmps
    [String] cb_names
    int cb_count
    // 容器用法推断：调用节点 -> 推断出的类型标记
    [int] ic_nodes
    [int] ic_tys
    int ic_count
    // 自由函数多类型参数推断结果（≤4）
    int inf_arg1
    int inf_arg2
    int inf_arg3
    int inf_arg4
    // 当前特化上下文
    String cur_inst_param
    int cur_inst_arg_ty
    String cur_inst_param2
    int cur_inst_arg_ty2
    String cur_inst_param3
    int cur_inst_arg_ty3
    String cur_inst_param4
    int cur_inst_arg_ty4
    int cur_inst_ord
    // 特化的接收者结构体实例名（方法特化时）
    String cur_inst_struct
    [int] m_rtype
    // 已发射的 extern 声明（去重）
    [String] decl_names
    int decl_count
    // lambda 定义输出缓冲
    StringBuf lambda_buf
    // lambda 表（id -> 名字）
    [int] lam_ids
    [String] lam_names
    int lam_count
    // 闭包捕获表（按 lambda 表下标索引）
    [int] cap_start
    [int] cap_count
    [int] cap_done
    [String] cap_names
    [int] cap_kinds
    [int] cap_etypes
    [int] cap_ids
    int cap_total
    // Fn 值环境块全局（@fnenv.* / @lamenv.*）
    [String] env_g_names
    int env_g_count
    StringBuf env_defs
    // 全局常量/静态：0=int 2=数组；数组元素以逗号串存
    [String] g_names
    [int] g_kinds
    // 接口名表与接口方法表（vtable 动态派发）
    [String] if_names
    [int] if_mstart
    [int] if_mcount
    [String] if_mnames
    [int] if_mnode
    int if_mtotal
    int if_count
    // 函数形参接口下标（+1；0 = 非接口），按 fn_ptotal 对齐
    [int] fn_piface
    // vtable 定义缓冲与已登记的 (类型.接口) 对
    StringBuf vt_defs
    [String] vt_pairs
    int vt_count
    // #[compile_time] 函数表与常量求值环境（编译期解释器）
    [String] ct_names
    [int] ct_ids
    int ct_count
    [String] ct_env_names
    [int] ct_env_vals
    int ct_env_count
    [int] ct_args
    int ct_ret
    int ct_depth
    int ct_frame
    // 源文件名（#panic 位置用）
    String src_file
    // 结构体全局（kind 4）：初始化节点与结构体下标
    [int] g_init_ids
    [int] g_stype
    int need_ginit
    StringBuf ginit_buf
    [String] g_vals
    [int] g_lens
    int g_count
    // 函数体 alloca 前置缓冲（LLVM 要求 alloca 支配所有使用）
    StringBuf pre_buf
    int pre_active
    int entry_pos
    // 循环标签栈（break/continue）
    [String] loop_ends
    [String] loop_conds
    int loop_depth
    int terminated
}

pub namespace Emitter {
    #[alloc]
    pub fn new() -> Emitter {
        e = Emitter {
            buf = StringBuf::new(), type_buf = StringBuf::new(), body_phase = 0, tmp = 0,
            locals = [String; 512], local_kinds = [int; 512], local_forms = [int; 512],
            local_ftypes = [int; 512], lv_count = 0,
            local_etypes = [int; 512],
            strs = [String; 8192], str_count = 0,
            st_names = [String; 128], st_fstart = [int; 128], st_fcount = [int; 128],
            st_fields = [String; 1024], st_ftotal = 0, st_count = 0,
            st_fkind = [int; 1024], st_finfo = [int; 1024], st_fslot = [int; 1024],
            st_ftype = [int; 1024],
            st_slots = [int; 128],
            m_ty = [String; 8192], m_name = [String; 8192], m_id = [int; 8192], m_count = 0,
            en_names = [String; 128], en_vstart = [int; 128], en_vcount = [int; 128],
            en_variants = [String; 1024], en_arity = [int; 1024], en_vtotal = 0, en_count = 0,
            en_ptype = [int; 4096], en_pvstart = [int; 1024], en_ptotal = 0, en_vslots = [int; 1024],
            ei_ens = [int; 128], ei_srcs = [int; 128], ei_args = [int; 128], ei_count = 0,
            ln_names = [String; 256], ln_srcs = [String; 256], ln_count = 0,
            fn_names = [String; 8192], fn_extern = [int; 8192], fn_pstart = [int; 8192], fn_pcount = [int; 8192],
            fn_pkinds = [int; 65536], fn_ptotal = 0, fn_count = 0,
            fn_rtype = [int; 8192], fn_rllvm = [int; 8192], fn_first = [int; 8192], cur_rtype = -1, cur_ord = 0, cur_self_ty = "", inst_keys = [String; 512], inst_count = 0, gp_names = [String; 256], gp_names_count = 0, inst_st_names = [String; 128], inst_st_src = [int; 128], inst_st_argty = [int; 128], inst_st_argty2 = [int; 128], inst_st_count = 0, inst_arg_tys = [int; 512], inst_arg2_tys = [int; 512], spec_nodes = [int; 256], spec_prefixes = [String; 256], spec_params = [String; 256], spec_args = [int; 256], spec_params2 = [String; 256], spec_args2 = [int; 256], spec_params3 = [String; 256], spec_args3 = [int; 256], spec_params4 = [String; 256], spec_args4 = [int; 256], spec_selfs = [String; 256], spec_count = 0, cb_tmps = [String; 32], cb_names = [String; 32], cb_count = 0, ic_nodes = [int; 256], ic_tys = [int; 256], ic_count = 0, inf_arg1 = -1, inf_arg2 = -1, inf_arg3 = -1, inf_arg4 = -1, cur_inst_param = "", cur_inst_arg_ty = -1, cur_inst_param2 = "", cur_inst_arg_ty2 = -1, cur_inst_param3 = "", cur_inst_arg_ty3 = -1, cur_inst_param4 = "", cur_inst_arg_ty4 = -1, cur_inst_ord = -1, cur_inst_struct = "", m_rtype = [int; 8192],
            decl_names = [String; 2048], decl_count = 0,
            lambda_buf = StringBuf::new(),
            lam_ids = [int; 256], lam_names = [String; 256], lam_count = 0,
            cap_start = [int; 256], cap_count = [int; 256], cap_done = [int; 256],
            cap_names = [String; 1024], cap_kinds = [int; 1024], cap_etypes = [int; 1024],
            cap_ids = [int; 1024], cap_total = 0,
            env_g_names = [String; 512], env_g_count = 0, env_defs = StringBuf::new(),
            g_names = [String; 512], g_kinds = [int; 512], g_vals = [String; 512],
            g_lens = [int; 512], g_count = 0,
            g_init_ids = [int; 512], g_stype = [int; 512], need_ginit = 0, ginit_buf = StringBuf::new(),
            if_names = [String; 128], if_mstart = [int; 128], if_mcount = [int; 128],
            if_mnames = [String; 512], if_mnode = [int; 512], if_mtotal = 0, if_count = 0,
            fn_piface = [int; 32768], vt_defs = StringBuf::new(), vt_pairs = [String; 512], vt_count = 0,
            ct_names = [String; 256], ct_ids = [int; 256], ct_count = 0,
            ct_env_names = [String; 256], ct_env_vals = [int; 256], ct_env_count = 0,
            ct_args = [int; 16], ct_ret = 0, ct_depth = 0, ct_frame = 0, src_file = String::empty(),
            pre_buf = StringBuf::new(), pre_active = 0, entry_pos = 0,
            loop_ends = [String; 64], loop_conds = [String; 64], loop_depth = 0,
            terminated = 0
        };
        return e;
    }
}

/// 类型节点的类型名（解 ref/泛型包装；非命名类型返回 ""）
fn ty_name(ref Ast ast, int t) -> String {
    if t == -4001 { return "int"; }
    if t == -4002 { return "bool"; }
    if t == -4003 { return "String"; }
    if t == -4004 { return "float"; }
    if t == -4005 { return "char"; }
    if t == -4006 { return "fn"; }
    while t >= 0 {
        tg = ast.tags[t];
        if tg == xt(XT::GenericArg._tag) {
            nx_g = ast.aa[t];
            if nx_g < 0 { nx_g = ast.tys[t]; }
            t = nx_g;
            continue;
        }
        if tg == tt(TT::Ref._tag) {
            t = ast.aa[t];
            continue;
        }
        if tg == tt(TT::Named._tag) || tg == tt(TT::Generic._tag) {
            return ast.texts[t].copy();
        }
        return "";
    }
    return "";
}

/// 解包 Ref 与 GenericArg 包装（泛型实参的包装把类型放在 tys）
fn unwrap_ty(ref Ast ast, int ty) -> int {
    if ty < 0 { return ty; }
    tg = ast.tags[ty];
    if tg == xt(XT::GenericArg._tag) {
        nx = ast.aa[ty];
        if nx < 0 { nx = ast.tys[ty]; }
        return unwrap_ty(ast, nx);
    }
    if tg == tt(TT::Ref._tag) { return unwrap_ty(ast, ast.aa[ty]); }
    return ty;
}

/// 取实参地址（ref 原语形参）：变量/全局直接取址，其余落到临时槽
fn addr_of_arg(ref Ast ast, int id, ref mut Emitter e) -> String {
    if id >= 0 {
        if ast.tags[id] == et(ET::Ref._tag) {
            // ref x：取 x 的地址（避免落到临时槽存成 i64 符号）
            return addr_of_arg(ast, ast.aa[id], e);
        }
        if ast.tags[id] == et(ET::Ident._tag) {
            nm = ast.texts[id];
            if e.global_kind(nm) == 0 { return "@" + nm; }
            kd = e.local_kind(nm);
            if kd == 0 { return "%v_" + nm; }
            if kd == 10 || kd == 20 || (kd >= 100 && kd < 228) {
                // 数组/枚举/结构体局部：.p 槽即其指针存储地址
                return "%v_" + nm + ".p";
            }
            if kd == 30 {
                // 已是引用：直接传递保存的指针
                rp30 = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(rp30);
                e.buf.push_str(" = load ptr, ptr %v_");
                e.buf.push_str(nm);
                e.buf.push_str(".p\n");
                return rp30;
            }
        }
    }
    v = emit_expr(ast, id, e);
    if v.kind == 1 {
        // String 临时（字面量/表达式）→ 双槽临时，供 ref String 形参
        tp1 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(tp1);
        e.buf.push_str(" = alloca { ptr, i64 }\n  ");
        g1s = e.fresh();
        e.buf.push_str(g1s);
        e.buf.push_str(" = getelementptr { ptr, i64 }, ptr ");
        e.buf.push_str(tp1);
        e.buf.push_str(", i32 0, i32 0\n  store ptr ");
        e.buf.push_str(ptr_operand(v.a));
        e.buf.push_str(", ptr ");
        e.buf.push_str(g1s);
        e.buf.push_str("\n  ");
        g2s = e.fresh();
        e.buf.push_str(g2s);
        e.buf.push_str(" = getelementptr { ptr, i64 }, ptr ");
        e.buf.push_str(tp1);
        e.buf.push_str(", i32 0, i32 1\n  store i64 ");
        e.buf.push_str(v.b);
        e.buf.push_str(", ptr ");
        e.buf.push_str(g2s);
        e.buf.push_str("\n");
        return tp1;
    }
    tp = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(tp);
    e.buf.push_str(" = alloca i64\n  store i64 ");
    e.buf.push_str(v.a);
    e.buf.push_str(", ptr ");
    e.buf.push_str(tp);
    e.buf.push_str("\n");
    return tp;
}

/// 浮点 -> 整数饱和下界（double 常量文本；未知返回 ""）
fn fmin_text(ref String tn) -> String {
    if tn == "u8" || tn == "char" || tn == "bool" { return "0.0"; }
    if tn == "u16" { return "0.0"; }
    if tn == "u32" { return "0.0"; }
    if tn == "u64" || tn == "usize" { return "0.0"; }
    if tn == "i8" { return "-128.0"; }
    if tn == "i16" { return "-32768.0"; }
    if tn == "i32" { return "-2147483648.0"; }
    return "";
}

/// 浮点 -> 整数饱和上界（double 常量文本；未知返回 ""）
fn fmax_text(ref String tn) -> String {
    if tn == "u8" || tn == "char" || tn == "bool" { return "255.0"; }
    if tn == "u16" { return "65535.0"; }
    if tn == "u32" { return "4294967295.0"; }
    if tn == "i8" { return "127.0"; }
    if tn == "i16" { return "32767.0"; }
    if tn == "i32" { return "2147483647.0"; }
    return "";
}

/// 具体整型名 -> LLVM 宽度类型（未知返回 ""）
fn int_ty_llvm(ref String tn) -> String {
    if tn == "u8" || tn == "i8" { return "i8"; }
    if tn == "u16" || tn == "i16" { return "i16"; }
    if tn == "u32" || tn == "i32" { return "i32"; }
    if tn == "u64" || tn == "i64" || tn == "usize" || tn == "isize" { return "i64"; }
    return "";
}

fn int_ty_signed(ref String tn) -> int {
    if tn == "i8" || tn == "i16" || tn == "i32" || tn == "i64" || tn == "isize" { return 1; }
    return 0;
}

/// 整数常量求值（字面量/括号/一元负/二元算术/位运算/引用其他常量）；失败返回 ""
fn const_int(ref Ast ast, int id) -> String {
    if id < 0 { return ""; }
    tag = ast.tags[id];
    if tag == et(ET::Literal._tag) {
        k = ast.bb[id];
        if k == lk(LK::Int._tag) {
            return int_text_ok(ast.texts[id]);
        }
        if k == lk(LK::Bool._tag) {
            if ast.texts[id] == "true" { return "1"; }
            return "0";
        }
        return "";
    }
    if tag == et(ET::Suffixed._tag) {
        return const_int(ast, ast.aa[id]);
    }
    if tag == et(ET::Binary._tag) {
        lv = const_int(ast, ast.aa[id]);
        rv = const_int(ast, ast.bb[id]);
        if lv.len == 0 || rv.len == 0 { return ""; }
        a = str_to_int_ok(lv);
        b = str_to_int_ok(rv);
        op = ast.tys[id];
        r = -999999;
        if op == bo(BinOp::Add._tag) { r = a + b; }
        elif op == bo(BinOp::Sub._tag) { r = a - b; }
        elif op == bo(BinOp::Mul._tag) { r = a * b; }
        elif op == bo(BinOp::Div._tag) { if b == 0 { return ""; } r = a / b; }
        elif op == bo(BinOp::Mod._tag) { if b == 0 { return ""; } r = a % b; }
        elif op == bo(BinOp::BitAnd._tag) { r = a & b; }
        elif op == bo(BinOp::BitOr._tag) { r = a | b; }
        elif op == bo(BinOp::BitXor._tag) { r = a ^ b; }
        elif op == bo(BinOp::Shl._tag) { r = a << b; }
        elif op == bo(BinOp::Shr._tag) { r = a >> b; }
        if r == -999999 { return ""; }
        return int_str2(r);
    }
    if tag == et(ET::Unary._tag) {
        // 一元负
        ov = const_int(ast, ast.aa[id]);
        if ov.len == 0 { return ""; }
        op2 = ast.tys[id];
        if op2 == uo(UnOp::Neg._tag) {
            return int_str2(0 - str_to_int_ok(ov));
        }
        return "";
    }
    if tag == et(ET::Ident._tag) {
        return "";
    }
    return "";
}

/// 十进制/十六进制整数字面量 -> 规范十进制文本（失败 ""）
fn int_text_ok(ref String t) -> String {
    v = str_to_int_ok(t);
    if v == -999999 { return ""; }
    return int_str2(v);
}

/// 解析整数字面量（支持 0x 前缀、下划线、负号）；失败 -999999
fn str_to_int_ok(ref String t) -> int {
    if t.len == 0 { return -999999; }
    neg = 0;
    i = 0;
    if t.index(0) == '-' {
        neg = 1;
        i = 1;
    }
    base = 10;
    if i + 1 < t.len as int {
        if t.index(i as usize) == '0' {
            c1 = t.index((i + 1) as usize);
            if c1 == 'x' || c1 == 'X' {
                base = 16;
                i = i + 2;
            } elif c1 == 'b' || c1 == 'B' {
                base = 2;
                i = i + 2;
            } elif c1 == 'o' || c1 == 'O' {
                base = 8;
                i = i + 2;
            }
        }
    }
    v = 0;
    n = 0;
    while i < t.len as int {
        ch = t.index(i as usize);
        d = -1;
        if ch == '_' { i = i + 1; continue; }
        if ch >= '0' && ch <= '9' { d = char_code(ch) - 48; }
        elif ch >= 'a' && ch <= 'f' { d = char_code(ch) - 87; }
        elif ch >= 'A' && ch <= 'F' { d = char_code(ch) - 55; }
        else { return -999999; }
        if d >= base { return -999999; }
        v = v * base + d;
        n = n + 1;
        i = i + 1;
    }
    if n == 0 { return -999999; }
    if neg == 1 { return 0 - v; }
    return v;
}

/// ptr 位置的立即数 0 -> null
fn ptr_operand(ref String a) -> String {
    if a == "0" { return "null"; }
    return a.copy();
}

fn int_str2(int v) -> String {
    b = StringBuf::new();
    b.push_int(v);
    return b.to_string();
}

fn mk_int(ref String t) -> Val {
    return Val { kind = 0, a = t.copy(), b = "", ty = -1 };
}

/// 数组值（malloc 指针 + 元素类型 id）
fn mk_arr(ref String ptr, int ety) -> Val {
    return Val { kind = 3, a = ptr.copy(), b = "", ty = ety };
}

fn mk_str(ref String ptr, int len) -> Val {
    b = StringBuf::new();
    b.push_int(len);
    return Val { kind = 1, a = ptr.copy(), b = b.to_string(), ty = -1 };
}

/// Fn 类型/函数/lambda 节点的参数链（-1 表示无）
fn fn_type_params(ref Ast ast, int fty) -> int {
    if fty < 0 { return -1; }
    tg = ast.tags[fty];
    if tg == tt(TT::Closure._tag) { return ast.aa[fty]; }
    if tg == et(ET::Lambda._tag) { return ast.aa[fty]; }
    if tg == st(ST::FnDecl._tag) { return ast.aa[fty]; }
    return -1;
}

/// Fn 类型/函数/lambda 节点的返回类型（-1 表示无）
fn fn_type_ret(ref Ast ast, int fty) -> int {
    if fty < 0 { return -1; }
    tg = ast.tags[fty];
    if tg == tt(TT::Closure._tag) { return ast.tys[fty]; }
    if tg == et(ET::Lambda._tag) { return ast.tys[fty]; }
    if tg == st(ST::FnDecl._tag) { return ast.tys[fty]; }
    return -1;
}

/// 浮点运算操作数：浮点值直接用，整数/字面量转 double
fn float_operand(ref Val v, ref mut Emitter e) -> String {
    if v.kind == 6 { return v.a.copy(); }
    t = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(t);
    e.buf.push_str(" = sitofp i64 ");
    e.buf.push_str(v.a);
    e.buf.push_str(" to double\n");
    return t;
}

/// 浮点比较谓词（有序比较）
fn fcmp_op(int op) -> String {
    if op == bo(BinOp::Eq._tag) { return "oeq"; }
    if op == bo(BinOp::Neq._tag) { return "one"; }
    if op == bo(BinOp::Lt._tag) { return "olt"; }
    if op == bo(BinOp::Gt._tag) { return "ogt"; }
    if op == bo(BinOp::Le._tag) { return "ole"; }
    if op == bo(BinOp::Ge._tag) { return "oge"; }
    return "oeq";
}

/// 浮点值（a = double 类型的操作数文本/临时名）
fn mk_float(ref String a) -> Val {
    return Val { kind = 6, a = a.copy(), b = "", ty = -1 };
}

/// 浮点字面量文本 -> LLVM double 常量文本（补 .0 / 0 前缀）
fn float_text(ref String t) -> String {
    has_dot = 0;
    has_exp = 0;
    i = 0;
    while i < t.len as int {
        c = t.index(i as usize);
        if c == '.' { has_dot = 1; }
        if c == 'e' || c == 'E' { has_exp = 1; }
        i = i + 1;
    }
    if has_dot == 0 && has_exp == 0 {
        return t.copy() + ".0";
    }
    if has_dot == 0 && has_exp == 1 {
        // 1e3 -> 1.0e3（LLVM double 常量需要小数点）
        b = StringBuf::new();
        i = 0;
        while i < t.len as int {
            c = t.index(i as usize);
            if c == 'e' || c == 'E' {
                b.push_str(".0");
            }
            b.push(c);
            i = i + 1;
        }
        return b.to_string();
    }
    if t.len > 0 {
        if t.index(0) == '.' {
            return "0" + t;
        }
    }
    return t.copy();
}

/// String 值（len 已是临时名，运行期动态）
fn mk_str_tmp(ref String ptr, ref String len_tmp) -> Val {
    return Val { kind = 1, a = ptr.copy(), b = len_tmp.copy(), ty = -1 };
}

/// 逻辑取反（i64 0/1）
fn emit_not(ref Val v, ref mut Emitter e) -> Val {
    c = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(c);
    e.buf.push_str(" = icmp eq i64 ");
    e.buf.push_str(v.a);
    e.buf.push_str(", 0\n");
    z = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(z);
    e.buf.push_str(" = zext i1 ");
    e.buf.push_str(c);
    e.buf.push_str(" to i64\n");
    return mk_int(z);
}

/// 字符串内容相等：memcmp(min) == 0 且长度相等
fn emit_str_eq(ref Val lt0, ref Val rt0, ref mut Emitter e) -> Val {
    lt = str_of_val(lt0, e);
    rt = str_of_val(rt0, e);
    c0 = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(c0);
    e.buf.push_str(" = icmp slt i64 ");
    e.buf.push_str(lt.b);
    e.buf.push_str(", ");
    e.buf.push_str(rt.b);
    e.buf.push_str("\n  ");
    mn = e.fresh();
    e.buf.push_str(mn);
    e.buf.push_str(" = select i1 ");
    e.buf.push_str(c0);
    e.buf.push_str(", i64 ");
    e.buf.push_str(lt.b);
    e.buf.push_str(", i64 ");
    e.buf.push_str(rt.b);
    e.buf.push_str("\n  ");
    r = e.fresh();
    e.buf.push_str(r);
    e.buf.push_str(" = call i32 @memcmp(ptr ");
    e.buf.push_str(lt.a);
    e.buf.push_str(", ptr ");
    e.buf.push_str(rt.a);
    e.buf.push_str(", i64 ");
    e.buf.push_str(mn);
    e.buf.push_str(")\n  ");
    eqm = e.fresh();
    e.buf.push_str(eqm);
    e.buf.push_str(" = icmp eq i32 ");
    e.buf.push_str(r);
    e.buf.push_str(", 0\n  ");
    le = e.fresh();
    e.buf.push_str(le);
    e.buf.push_str(" = icmp eq i64 ");
    e.buf.push_str(lt.b);
    e.buf.push_str(", ");
    e.buf.push_str(rt.b);
    e.buf.push_str("\n  ");
    bo2 = e.fresh();
    e.buf.push_str(bo2);
    e.buf.push_str(" = and i1 ");
    e.buf.push_str(eqm);
    e.buf.push_str(", ");
    e.buf.push_str(le);
    e.buf.push_str("\n  ");
    z = e.fresh();
    e.buf.push_str(z);
    e.buf.push_str(" = zext i1 ");
    e.buf.push_str(bo2);
    e.buf.push_str(" to i64\n");
    return mk_int(z);
}

/// 非 String 值转 String（int/泛型 i64 走 aya_int_to_string；浮点暂给空串）
#[alloc]
fn str_of_val(ref Val v, ref mut Emitter e) -> Val {
    if v.kind == 1 {
        // 返回拥有值：ref 形参的 String 字段必须显式 copy（否则双重释放）
        return Val { kind = v.kind, a = v.a.copy(), b = v.b.copy(), ty = v.ty };
    }
    if v.ty == 7000 {
        // char：转单字符 String（拼接语义，对应 rust 侧 char 参与 concat）
        if e.fn_ret_type("aya_ch_to_string") >= 0 {
            tc = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(tc);
            e.buf.push_str(" = call { ptr, i64 } @");
            e.buf.push_str(e.fn_sym("aya_ch_to_string"));
            e.buf.push_str("(i64 ");
            e.buf.push_str(v.a);
            e.buf.push_str(")\n  ");
            ipc = e.fresh();
            e.buf.push_str(ipc);
            e.buf.push_str(" = extractvalue { ptr, i64 } ");
            e.buf.push_str(tc);
            e.buf.push_str(", 0\n  ");
            ilc = e.fresh();
            e.buf.push_str(ilc);
            e.buf.push_str(" = extractvalue { ptr, i64 } ");
            e.buf.push_str(tc);
            e.buf.push_str(", 1\n");
            return mk_str_tmp(ipc, ilc);
        }
    }
    if v.kind != 6 {
        if e.fn_ret_type("aya_int_to_string") >= 0 {
            t = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t);
            e.buf.push_str(" = call { ptr, i64 } @");
            e.buf.push_str(e.fn_sym("aya_int_to_string"));
            e.buf.push_str("(i64 ");
            e.buf.push_str(v.a);
            e.buf.push_str(")\n  ");
            ip = e.fresh();
            e.buf.push_str(ip);
            e.buf.push_str(" = extractvalue { ptr, i64 } ");
            e.buf.push_str(t);
            e.buf.push_str(", 0\n  ");
            il = e.fresh();
            e.buf.push_str(il);
            e.buf.push_str(" = extractvalue { ptr, i64 } ");
            e.buf.push_str(t);
            e.buf.push_str(", 1\n");
            return mk_str_tmp(ip, il);
        }
    }
    return mk_str("null", 0);
}

/// 字符串拼接（非 String 操作数先转 String）
fn emit_str_concat(ref Val lt0, ref Val rt0, ref mut Emitter e) -> Val {
    lt = str_of_val(lt0, e);
    rt = str_of_val(rt0, e);
    n = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(n);
    e.buf.push_str(" = add i64 ");
    e.buf.push_str(lt.b);
    e.buf.push_str(", ");
    e.buf.push_str(rt.b);
    e.buf.push_str("\n  ");
    buf = e.fresh();
    e.buf.push_str(buf);
    e.buf.push_str(" = call ptr @malloc(i64 ");
    e.buf.push_str(n);
    e.buf.push_str(")\n  call ptr @memcpy(ptr ");
    e.buf.push_str(buf);
    e.buf.push_str(", ptr ");
    e.buf.push_str(lt.a);
    e.buf.push_str(", i64 ");
    e.buf.push_str(lt.b);
    e.buf.push_str(")\n  ");
    dst = e.fresh();
    e.buf.push_str(dst);
    e.buf.push_str(" = getelementptr i8, ptr ");
    e.buf.push_str(buf);
    e.buf.push_str(", i64 ");
    e.buf.push_str(lt.b);
    e.buf.push_str("\n  call ptr @memcpy(ptr ");
    e.buf.push_str(dst);
    e.buf.push_str(", ptr ");
    e.buf.push_str(rt.a);
    e.buf.push_str(", i64 ");
    e.buf.push_str(rt.b);
    e.buf.push_str(")\n");
    return mk_str_tmp(buf, n);
}

/// 子串 [start, end)：malloc + memcpy
fn emit_str_slice(ref Val sv, ref String start, ref String end, ref mut Emitter e) -> Val {
    n = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(n);
    e.buf.push_str(" = sub i64 ");
    e.buf.push_str(end);
    e.buf.push_str(", ");
    e.buf.push_str(start);
    e.buf.push_str("\n  ");
    buf = e.fresh();
    e.buf.push_str(buf);
    e.buf.push_str(" = call ptr @malloc(i64 ");
    e.buf.push_str(n);
    e.buf.push_str(")\n  ");
    src = e.fresh();
    e.buf.push_str(src);
    e.buf.push_str(" = getelementptr i8, ptr ");
    e.buf.push_str(sv.a);
    e.buf.push_str(", i64 ");
    e.buf.push_str(start);
    e.buf.push_str("\n  call ptr @memcpy(ptr ");
    e.buf.push_str(buf);
    e.buf.push_str(", ptr ");
    e.buf.push_str(src);
    e.buf.push_str(", i64 ");
    e.buf.push_str(n);
    e.buf.push_str(")\n");
    return mk_str_tmp(buf, n);
}

impl Emitter {
    #[alloc]
    #[state]
    fn fresh(ref mut self) -> String {
        b = StringBuf::new();
        b.push_str("%t");
        b.push_int(self.tmp);
        self.tmp = self.tmp + 1;
        return b.to_string();
    }

    fn local_kind(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.lv_count {
            if self.locals[i] == name { return self.local_kinds[i]; }
            i = i + 1;
        }
        return -1;
    }

    /// 数组局部的元素类型（AST 类型节点 id）；非数组返回 -1
    fn find_elem(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.lv_count {
            if self.locals[i] == name { return self.local_etypes[i]; }
            i = i + 1;
        }
        return -1;
    }

    #[alloc]
    #[state]
    #[alloc]
    #[state]
    fn declare_array_local(ref mut self, ref String name, int ety) {
        ety_r = self.subst_elem_ty(ety);
        self.declare_local(name, 10);
        i = 0;
        while i < self.lv_count {
            if self.locals[i] == name {
                self.local_etypes[i] = ety_r;
                return;
            }
            i = i + 1;
        }
    }

    /// 元素类型替换：类型参数名 → 实参类型（特化上下文）
    #[alloc]
    fn subst_elem_ty(ref mut self, int ety) -> int {
        if ety < 0 || self.cur_inst_arg_ty < 0 || self.cur_inst_param.len == 0 { return ety; }
        return ety;
    }

    #[state]
    fn record_etype(ref mut self, ref String name, int ety) {
        i = 0;
        while i < self.lv_count {
            if self.locals[i] == name {
                self.local_etypes[i] = ety;
                return;
            }
            i = i + 1;
        }
    }

    fn elem_of_local(ref mut self, ref String name) -> int {
        if self.local_kind(name) != 10 { return -1; }
        return self.find_elem(name);
    }

    fn etype_of_local(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.lv_count {
            if self.locals[i] == name {
                return self.local_etypes[i];
            }
            i = i + 1;
        }
        return -1;
    }

    /// 声明/复用局部；同名不同类型时补分配对应存储（源码里同名局部在不同分支复用不同类型）
    #[alloc]
    #[state]
    fn declare_local(ref mut self, ref String name, int kind) {
        idx_l = -1;
        i = 0;
        while i < self.lv_count {
            if self.locals[i] == name {
                idx_l = i;
                break;
            }
            i = i + 1;
        }
        form = 0;
        if kind == 1 { form = 1; } elif kind == 40 { form = 3; } elif kind >= 2 { form = 2; }
        if idx_l >= 0 {
            self.local_kinds[idx_l] = kind;
            have = self.local_forms[idx_l];
            if have == form { return; }
            self.local_forms[idx_l] = form;
            self.emit_local_storage(name, form);
            return;
        }
        if self.lv_count < 512 {
            self.locals[self.lv_count] = name.copy();
            self.local_kinds[self.lv_count] = kind;
            self.local_etypes[self.lv_count] = -1;
            self.local_forms[self.lv_count] = form;
            self.local_ftypes[self.lv_count] = -1;
            self.lv_count = self.lv_count + 1;
        }
        self.emit_local_storage(name, form);
    }

    /// 局部存储分配（写 pre_buf，最终拼到 entry 块）
    #[alloc]
    #[state]
    fn emit_local_storage(ref mut self, ref String name, int form) {
        tmp2 = StringBuf::new();
        if form == 1 {
            tmp2.push_str("  %v_");
            tmp2.push_str(name);
            tmp2.push_str(".ptr = alloca ptr\n  %v_");
            tmp2.push_str(name);
            tmp2.push_str(".len = alloca i64\n");
        } elif form == 3 {
            tmp2.push_str("  %v_");
            tmp2.push_str(name);
            tmp2.push_str(".d = alloca double\n");
        } elif form == 2 {
            tmp2.push_str("  %v_");
            tmp2.push_str(name);
            tmp2.push_str(".p = alloca ptr\n");
        } else {
            tmp2.push_str("  %v_");
            tmp2.push_str(name);
            tmp2.push_str(" = alloca i64\n");
        }
        if self.pre_active == 1 {
            self.pre_buf.push_str(tmp2.to_string());
        } else {
            self.buf.push_str(tmp2.to_string());
        }
    }

    /// struct 局部变量的类型名（kind 2 的局部）
    #[alloc]
    #[state]
    fn struct_of_local(ref mut self, ref String name) -> String {
        i = 0;
        while i < self.lv_count {
            if self.locals[i] == name {
                ety = self.local_etypes[i];
                if ety >= 0 {
                    if ety < self.st_count { return self.st_names[ety].copy(); }
                }
            }
            i = i + 1;
        }
        return "";
    }

    /// 参数类型种类：0=int/其他, 1=String(双槽), 3=数组(ptr), 20=枚举, 100+si=结构体
    #[alloc]
    #[state]
    fn param_kind(ref mut self, ref Ast ast, int p) -> int {
        pt = ast.tys[p];
        if pt < 0 { return 0; }
        // 解开 ref/ref mut 包装（记下是否为引用）
        is_ref = 0;
        while pt >= 0 {
            if ast.tags[pt] != tt(TT::Ref._tag) { break; }
            is_ref = 1;
            pt = ast.aa[pt];
        }
        if pt < 0 { return 0; }
        ptg = ast.tags[pt];
        if ptg == tt(TT::Array._tag) || ptg == tt(TT::ArraySized._tag) {
            return 3;
        }
        if ptg == tt(TT::Generic._tag) { ptg = tt(TT::Named._tag); }
        if ptg == tt(TT::Float._tag) {
            return 31;
        }
        if ptg != tt(TT::Named._tag) {
            // 原语：ref 形参按指针传（30）
            if is_ref == 1 { return 30; }
            return 0;
        }
        tn = ast.texts[pt];
        if tn == "Self" { tn = self.cur_self_ty.copy(); }
        if tn == self.cur_inst_param && self.cur_inst_arg_ty != -1 {
            r_ink = self.pk_of_ty(ast, self.cur_inst_arg_ty);
            if is_ref == 1 && r_ink == 1 { return 30; }
            return r_ink;
        }
        if tn == self.cur_inst_param2 && self.cur_inst_arg_ty2 != -1 {
            return self.pk_of_ty(ast, self.cur_inst_arg_ty2);
        }
        if tn == self.cur_inst_param3 && self.cur_inst_arg_ty3 != -1 {
            return self.pk_of_ty(ast, self.cur_inst_arg_ty3);
        }
        if tn == self.cur_inst_param4 && self.cur_inst_arg_ty4 != -1 {
            return self.pk_of_ty(ast, self.cur_inst_arg_ty4);
        }
        if tn == "f32" || tn == "f64" { return 31; }
        if tn == "String" { return 1; }
        ei = self.find_enum_idx(tn);
        if ei >= 0 { return 20; }
        si = self.find_struct_idx(tn);
        if si >= 0 { return 100 + si; }
        if self.find_iface_idx(tn) >= 0 { return 21; }
        if is_ref == 1 { return 30; }
        return 0;
    }

    /// 返回类型种类：0=int, 1=String, 2=struct, 3=array, 4=enum
    #[alloc]
    #[state]
    fn ret_kind(ref mut self, ref Ast ast, int rty) -> int {
        if rty == -4003 { return 1; }
        if rty == -4004 { return 5; }
        if rty == -4001 || rty == -4002 || rty == -4005 || rty == -4006 { return 0; }
        if rty <= -1000 && rty > -1128 { return 2; }
        if rty <= -2000 && rty > -2128 { return 4; }
        if rty < 0 { return 0; }
        while rty >= 0 {
            if ast.tags[rty] != tt(TT::Ref._tag) { break; }
            rty = ast.aa[rty];
        }
        if rty < 0 { return 0; }
        rtg = ast.tags[rty];
        if rtg == tt(TT::Array._tag) || rtg == tt(TT::ArraySized._tag) {
            return 3;
        }
        if rtg == tt(TT::Float._tag) { return 5; }
        if rtg == tt(TT::Generic._tag) { rtg = tt(TT::Named._tag); }
        if rtg != tt(TT::Named._tag) { return 0; }
        tn = ast.texts[rty];
        if tn == "Self" { tn = self.cur_self_ty.copy(); }
        if tn == self.cur_inst_param && self.cur_inst_arg_ty != -1 {
            return self.ret_kind(ast, self.cur_inst_arg_ty);
        }
        if tn == self.cur_inst_param2 && self.cur_inst_arg_ty2 != -1 {
            return self.ret_kind(ast, self.cur_inst_arg_ty2);
        }
        if tn == self.cur_inst_param3 && self.cur_inst_arg_ty3 != -1 {
            return self.ret_kind(ast, self.cur_inst_arg_ty3);
        }
        if tn == self.cur_inst_param4 && self.cur_inst_arg_ty4 != -1 {
            return self.ret_kind(ast, self.cur_inst_arg_ty4);
        }
        if tn == "f32" || tn == "f64" { return 5; }
        if tn == "String" { return 1; }
        if self.find_struct_idx(tn) >= 0 { return 2; }
        if self.find_enum_idx(tn) >= 0 { return 4; }
        if self.find_iface_idx(tn) >= 0 { return 6; }
        return 0;
    }

    /// 返回类型附加信息：struct index / array elem type / enum index
    #[alloc]
    #[state]
    fn ret_info(ref mut self, ref Ast ast, int rty) -> int {
        if rty <= -1000 && rty > -1128 { return 0 - 1000 - rty; }
        if rty <= -2000 && rty > -2128 { return 0 - 2000 - rty; }
        if rty < 0 { return -1; }
        rtg = ast.tags[rty];
        if rtg == tt(TT::Array._tag) || rtg == tt(TT::ArraySized._tag) {
            return ast.aa[rty];
        }
        if rtg == tt(TT::Generic._tag) { rtg = tt(TT::Named._tag); }
        if rtg != tt(TT::Named._tag) { return -1; }
        tn = ast.texts[rty];
        if tn == "Self" { tn = self.cur_self_ty.copy(); }
        if tn == self.cur_inst_param && self.cur_inst_arg_ty != -1 {
            return self.ret_info(ast, self.cur_inst_arg_ty);
        }
        if tn == self.cur_inst_param2 && self.cur_inst_arg_ty2 != -1 {
            return self.ret_info(ast, self.cur_inst_arg_ty2);
        }
        if tn == self.cur_inst_param3 && self.cur_inst_arg_ty3 != -1 {
            return self.ret_info(ast, self.cur_inst_arg_ty3);
        }
        if tn == self.cur_inst_param4 && self.cur_inst_arg_ty4 != -1 {
            return self.ret_info(ast, self.cur_inst_arg_ty4);
        }
        si = self.find_struct_idx(tn);
        if si >= 0 { return si; }
        ei_r = self.find_enum_idx(tn);
        if ei_r >= 0 { return ei_r; }
        return self.find_iface_idx(tn);
    }

    /// 返回 LLVM 宽度码（0=i64, 1=i32, 2=i8）
    #[alloc]
    #[state]
    fn ret_llvm_code(ref mut self, ref Ast ast, int rty) -> int {
        if rty < 0 { return 0; }
        if ast.tags[rty] != tt(TT::Named._tag) { return 0; }
        tn = ast.texts[rty];
        if tn == "i32" { return 1; }
        if tn == "i8" { return 2; }
        return 0;
    }

    /// 记录局部的 Fn 类型节点（闭包/函数值形参）
    #[state]
    fn record_ftype(ref mut self, ref String name, int fty) {
        i = 0;
        while i < self.lv_count {
            if self.locals[i] == name {
                self.local_ftypes[i] = fty;
                return;
            }
            i = i + 1;
        }
    }

    fn ftype_of_local(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.lv_count {
            if self.locals[i] == name {
                return self.local_ftypes[i];
            }
            i = i + 1;
        }
        return -1;
    }

    /// 全局下标（按名）
    fn global_idx(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.g_count {
            if self.g_names[i] == name { return i; }
            i = i + 1;
        }
        return -1;
    }

    /// extern 声明是否已存在（内置 declare 去重）
    fn decl_has(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.decl_count {
            if self.decl_names[i] == name { return 1; }
            i = i + 1;
        }
        return 0;
    }

    /// lambda AST id -> lambda 表下标
    fn lam_index_of(ref mut self, int id) -> int {
        i = 0;
        while i < self.lam_count {
            if self.lam_ids[i] == id { return i; }
            i = i + 1;
        }
        return -1;
    }

    /// 追加一个闭包捕获（同名去重）
    #[alloc]
    #[state]
    fn cap_add(ref mut self, int li, ref String name, int kind, int ety, int cid) {
        start = self.cap_start[li];
        cnt = self.cap_count[li];
        i = 0;
        while i < cnt {
            if self.cap_names[start + i] == name { return; }
            i = i + 1;
        }
        if self.cap_total >= 1024 { return; }
        if cnt >= 32 { return; }
        self.cap_names[self.cap_total] = name.copy();
        self.cap_kinds[self.cap_total] = kind;
        self.cap_etypes[self.cap_total] = ety;
        self.cap_ids[self.cap_total] = cid;
        self.cap_total = self.cap_total + 1;
        self.cap_count[li] = cnt + 1;
    }

    /// Fn 值环境块全局（去重）：@<prefix>.<code> = global [1 x ptr] [ptr @<code>]
    #[alloc]
    #[state]
    fn add_env_global(ref mut self, ref String prefix, ref String code_name) -> String {
        gname = prefix + "." + code_name;
        i = 0;
        while i < self.env_g_count {
            if self.env_g_names[i] == gname { return gname; }
            i = i + 1;
        }
        if self.env_g_count < 512 {
            self.env_g_names[self.env_g_count] = gname.copy();
            self.env_g_count = self.env_g_count + 1;
        }
        self.env_defs.push_str("@");
        self.env_defs.push_str(gname);
        self.env_defs.push_str(" = global [1 x ptr] [ptr @");
        self.env_defs.push_str(self.fn_sym(code_name));
        self.env_defs.push_str("]\n");
        return gname;
    }

    /// 赋值时记录函数值的 Fn 类型（lambda/命名函数/Fn 局部/结构体字段）
    #[alloc]
    #[state]
    fn record_assign_ftype(ref mut self, ref Ast ast, ref String nm, int rhs) {
        if self.ftype_of_local(nm) >= 0 { return; }
        tg_r = ast.tags[rhs];
        if tg_r == et(ET::Lambda._tag) {
            self.record_ftype(nm, rhs);
            return;
        }
        if tg_r == et(ET::Ident._tag) {
            rn_r = ast.texts[rhs];
            ft_r = self.ftype_of_local(rn_r);
            if ft_r >= 0 {
                self.record_ftype(nm, ft_r);
                return;
            }
            if self.fn_ret_type(rn_r) >= 0 {
                fid_r = self.fn_first_id(rn_r);
                if fid_r >= 0 { self.record_ftype(nm, fid_r); }
            }
            return;
        }
        if tg_r == et(ET::FnCall._tag) {
            rn_r2 = ast.texts[rhs];
            rt_r = self.fn_ret_type(rn_r2);
            if rt_r >= 0 {
                if ast.tags[rt_r] == tt(TT::Closure._tag) {
                    self.record_ftype(nm, rt_r);
                }
            }
            return;
        }
        if tg_r == et(ET::FieldAccess._tag) {
            ob_r = ast.aa[rhs];
            if ob_r >= 0 {
                if ast.tags[ob_r] == et(ET::Ident._tag) {
                    stn_r = self.struct_of_local(ast.texts[ob_r]);
                    si_r = self.find_struct_idx(stn_r);
                    fi_r = self.find_field_idx(stn_r, ast.texts[rhs]);
                    if si_r >= 0 && fi_r >= 0 {
                        ft_r2 = self.ftype_at(si_r, fi_r);
                        if ft_r2 >= 0 {
                            if ast.tags[ft_r2] == tt(TT::Closure._tag) {
                                self.record_ftype(nm, ft_r2);
                            }
                        }
                    }
                }
            }
            return;
        }
    }

    /// 类型节点 -> 参数种类（与 param_kind 同规则）
    #[alloc]
    #[state]
    fn pk_of_ty(ref mut self, ref Ast ast, int pt) -> int {
        if pt == -4003 { return 1; }
        if pt == -4004 { return 31; }
        if pt == -4001 || pt == -4002 || pt == -4005 || pt == -4006 { return 0; }
        if pt <= -1000 && pt > -1128 { return 100 + (0 - 1000 - pt); }
        if pt <= -2000 && pt > -2128 { return 20; }
        if pt < 0 { return 0; }
        is_ref2 = 0;
        while pt >= 0 {
            if ast.tags[pt] != tt(TT::Ref._tag) { break; }
            is_ref2 = 1;
            pt = ast.aa[pt];
        }
        if pt < 0 { return 0; }
        ptg = ast.tags[pt];
        if ptg == tt(TT::Array._tag) || ptg == tt(TT::ArraySized._tag) { return 3; }
        if ptg == tt(TT::Float._tag) { return 31; }
        if ptg == tt(TT::Generic._tag) { ptg = tt(TT::Named._tag); }
        if ptg != tt(TT::Named._tag) {
            if is_ref2 == 1 { return 30; }
            return 0;
        }
        tn = ast.texts[pt];
        if tn == "Self" { tn = self.cur_self_ty.copy(); }
        if tn == self.cur_inst_param && self.cur_inst_arg_ty != -1 {
            return self.pk_of_ty(ast, self.cur_inst_arg_ty);
        }
        if tn == self.cur_inst_param2 && self.cur_inst_arg_ty2 != -1 {
            return self.pk_of_ty(ast, self.cur_inst_arg_ty2);
        }
        if tn == self.cur_inst_param3 && self.cur_inst_arg_ty3 != -1 {
            return self.pk_of_ty(ast, self.cur_inst_arg_ty3);
        }
        if tn == self.cur_inst_param4 && self.cur_inst_arg_ty4 != -1 {
            return self.pk_of_ty(ast, self.cur_inst_arg_ty4);
        }
        if tn == "f32" || tn == "f64" { return 31; }
        if tn == "String" { return 1; }
        ei = self.find_enum_idx(tn);
        if ei >= 0 { return 20; }
        si = self.find_struct_idx(tn);
        if si >= 0 { return 100 + si; }
        if is_ref2 == 1 { return 30; }
        return 0;
    }

    /// 闭包类型第 i 个参数的种类
    #[alloc]
    #[state]
    fn closure_param_kind(ref mut self, ref Ast ast, int fty, int i) -> int {
        p = fn_type_params(ast, fty);
        k = 0;
        while p >= 0 {
            if k == i {
                return self.pk_of_ty(ast, ast.tys[p]);
            }
            k = k + 1;
            p = ast.nexts[p];
        }
        return 0;
    }

    /// 该名首次定义的 FnDecl id（重载只发射第一个）
    fn fn_first_id(ref mut self, ref String fname) -> int {
        f = 0;
        while f < self.fn_count {
            if self.fn_names[f] == fname { return self.fn_first[f]; }
            f = f + 1;
        }
        return -1;
    }

    fn fn_ret_llvm(ref mut self, ref String fname) -> int {
        f = 0;
        while f < self.fn_count {
            if self.fn_names[f] == fname {
                return self.fn_rllvm[f];
            }
            f = f + 1;
        }
        return 0;
    }

    /// 函数返回类型节点 id（-1 未知）
    fn fn_ret_type(ref mut self, ref String fname) -> int {
        f = 0;
        while f < self.fn_count {
            if self.fn_names[f] == fname {
                return self.fn_rtype[f];
            }
            f = f + 1;
        }
        return -1;
    }

    /// 方法返回类型节点 id
    fn method_ret_type(ref mut self, ref String ty, ref String name) -> int {
        i = 0;
        while i < self.m_count {
            if self.m_ty[i] == ty {
                if self.m_name[i] == name { return self.m_rtype[i]; }
            }
            i = i + 1;
        }
        return -1;
    }

    /// 收集所有 lambda（线性扫 AST arena）
    #[alloc]
    #[state]
    /// 名字是否为该 lambda 的形参（捕获扫描排除自身形参遮蔽）
    #[alloc]
    fn lam_param_of(ref mut self, ref Ast ast, int li, ref String name) -> int {
        if li < 0 || li >= self.lam_count { return 0; }
        lid = self.lam_ids[li];
        if lid < 0 { return 0; }
        p = ast.aa[lid];
        while p >= 0 {
            if ast.texts[p] == name { return 1; }
            p = ast.nexts[p];
        }
        return 0;
    }

    fn collect_lambdas(ref mut self, ref Ast ast) {
        i = 0;
        while i < ast.len {
            if ast.tags[i] == et(ET::Lambda._tag) {
                if self.lam_count < 256 {
                    self.lam_ids[self.lam_count] = i;
                    self.lam_names[self.lam_count] = ast.texts[i].copy();
                    self.lam_count = self.lam_count + 1;
                }
            }
            i = i + 1;
        }
    }

    /// 全局常量/静态收集（顶层与 namespace 内）
    #[alloc]
    #[state]
    fn collect_globals(ref mut self, ref Ast ast, int prog) {
        s = ast.aa[prog];
        while s >= 0 {
            tag = ast.tags[s];
            if tag == st(ST::ConstDecl._tag) || tag == st(ST::StaticDecl._tag) {
                self.add_global(ast, ast.texts[s].copy(), s);
            } elif tag == st(ST::Namespace._tag) {
                self.collect_globals_ns(ast, s, "");
            }
            s = ast.nexts[s];
        }
    }

    /// namespace 内全局收集（支持嵌套：前缀逐级拼接）
    #[alloc]
    #[state]
    fn collect_globals_ns(ref mut self, ref Ast ast, int ns_id, ref String prefix) {
        ns = prefix.copy();
        if ns.len > 0 { ns = ns + "."; }
        ns = ns + ast.texts[ns_id];
        m = ast.aa[ns_id];
        while m >= 0 {
            if ast.tags[m] == st(ST::ConstDecl._tag) || ast.tags[m] == st(ST::StaticDecl._tag) {
                nm2 = ns + ".";
                nm2 = nm2 + ast.texts[m];
                self.add_global(ast, nm2, m);
            } elif ast.tags[m] == st(ST::Namespace._tag) {
                self.collect_globals_ns(ast, m, ns);
            }
            m = ast.nexts[m];
        }
    }

    /// 常量求值（可解析已注册的全局常量引用）
    #[alloc]
    #[state]
    fn const_eval_g(ref mut self, ref Ast ast, int id) -> String {
        if id < 0 { return ""; }
        tag = ast.tags[id];
        if tag == et(ET::Ident._tag) {
            return self.global_val(ast.texts[id]);
        }
        if tag == et(ET::Binary._tag) {
            lv2 = self.const_eval_g(ast, ast.aa[id]);
            rv2 = self.const_eval_g(ast, ast.bb[id]);
            if lv2.len == 0 || rv2.len == 0 { return ""; }
            // 复用纯函数：构造不了 AST，这里直接算
            a2 = str_to_int_ok(lv2);
            b2 = str_to_int_ok(rv2);
            op2 = ast.tys[id];
            r2 = -999999;
            if op2 == bo(BinOp::Add._tag) { r2 = a2 + b2; }
            elif op2 == bo(BinOp::Sub._tag) { r2 = a2 - b2; }
            elif op2 == bo(BinOp::Mul._tag) { r2 = a2 * b2; }
            elif op2 == bo(BinOp::Div._tag) { if b2 == 0 { return ""; } r2 = a2 / b2; }
            elif op2 == bo(BinOp::Mod._tag) { if b2 == 0 { return ""; } r2 = a2 % b2; }
            elif op2 == bo(BinOp::BitAnd._tag) { r2 = a2 & b2; }
            elif op2 == bo(BinOp::BitOr._tag) { r2 = a2 | b2; }
            elif op2 == bo(BinOp::BitXor._tag) { r2 = a2 ^ b2; }
            elif op2 == bo(BinOp::Shl._tag) { r2 = a2 << b2; }
            elif op2 == bo(BinOp::Shr._tag) { r2 = a2 >> b2; }
            if r2 == -999999 { return ""; }
            return int_str2(r2);
        }
        if tag == et(ET::FnCall._tag) {
            vlb = self.layout_builtin_val(ast, id);
            if vlb.len > 0 { return vlb; }
            // #[compile_time] 函数：编译期解释求值
            fid = self.ct_find(ast.texts[id]);
            if fid >= 0 {
                n = 0;
                a3 = ast.aa[id];
                while a3 >= 0 {
                    av = self.const_eval_g(ast, ast.aa[a3]);
                    if av.len == 0 { return ""; }
                    if n < 16 { self.ct_args[n] = str_to_int_ok(av); }
                    n = n + 1;
                    a3 = ast.nexts[a3];
                }
                r3 = ct_call(ast, fid, n, self);
                if r3 == -999999 { return ""; }
                return int_str2(r3);
            }
        }
        return const_int(ast, id);
    }

    /// 常量求值环境读写
    #[alloc]
    #[state]
    fn ct_set(ref mut self, ref String name, int v) {
        // 同帧内更新已有绑定；跨帧（递归/嵌套调用）追加，查找取最内层
        i = self.ct_frame;
        while i < self.ct_env_count {
            if self.ct_env_names[i] == name {
                self.ct_env_vals[i] = v;
                return;
            }
            i = i + 1;
        }
        if self.ct_env_count < 256 {
            self.ct_env_names[self.ct_env_count] = name.copy();
            self.ct_env_vals[self.ct_env_count] = v;
            self.ct_env_count = self.ct_env_count + 1;
        }
    }

    fn ct_get(ref mut self, ref String name) -> int {
        i = self.ct_env_count - 1;
        while i >= 0 {
            if self.ct_env_names[i] == name { return self.ct_env_vals[i]; }
            i = i - 1;
        }
        return -999999;
    }

    fn ct_find(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.ct_count {
            if self.ct_names[i] == name { return self.ct_ids[i]; }
            i = i + 1;
        }
        return -1;
    }

    #[alloc]
    #[state]
    fn add_global(ref mut self, ref Ast ast, ref String name, int id) {
        if self.g_count >= 512 { return; }
        init = ast.aa[id];
        // 浮点字面量（含 f32/f64 后缀）
        if init >= 0 {
            if ast.tags[init] == et(ET::Literal._tag) && ast.bb[init] == lk(LK::Float._tag) {
                self.g_names[self.g_count] = name.copy();
                self.g_kinds[self.g_count] = 3;
                self.g_vals[self.g_count] = float_text(ast.texts[init]);
                self.g_lens[self.g_count] = 0;
                self.g_count = self.g_count + 1;
                return;
            }
            if ast.tags[init] == et(ET::Suffixed._tag) {
                sfx = ast.texts[init];
                if sfx == "f32" || sfx == "f64" {
                    self.g_names[self.g_count] = name.copy();
                    self.g_kinds[self.g_count] = 3;
                    self.g_vals[self.g_count] = float_text(ast.texts[ast.aa[init]]);
                    self.g_lens[self.g_count] = 0;
                    self.g_count = self.g_count + 1;
                    return;
                }
            }
        }
        if init >= 0 {
            if ast.tags[init] == et(ET::StructLiteral._tag) {
                // 结构体全局：global i64（堆指针）+ 启动初始化
                si_g = self.find_struct_idx(ast.texts[init]);
                if si_g >= 0 {
                    self.g_names[self.g_count] = name.copy();
                    self.g_kinds[self.g_count] = 4;
                    self.g_vals[self.g_count] = "";
                    self.g_lens[self.g_count] = 0;
                    self.g_init_ids[self.g_count] = init;
                    self.g_stype[self.g_count] = si_g;
                    self.g_count = self.g_count + 1;
                    self.need_ginit = 1;
                    return;
                }
            }
        }
        v = self.const_eval_g(ast, init);
        if v.len > 0 {
            self.g_names[self.g_count] = name.copy();
            self.g_kinds[self.g_count] = 0;
            self.g_vals[self.g_count] = v.copy();
            self.g_lens[self.g_count] = 0;
            self.g_count = self.g_count + 1;
            return;
        }
        if init >= 0 {
            tg = ast.tags[init];
            if tg == et(ET::ArrayLiteral._tag) {
                b = StringBuf::new();
                n = 0;
                first = 1;
                el = ast.aa[init];
                while el >= 0 {
                    ev = const_int(ast, el);
                    if ev.len == 0 { return; }
                    if first == 0 { b.push(','); }
                    b.push_str(ev);
                    first = 0;
                    n = n + 1;
                    el = ast.nexts[el];
                }
                if n == 0 { return; }
                self.g_names[self.g_count] = name.copy();
                self.g_kinds[self.g_count] = 2;
                self.g_vals[self.g_count] = b.to_string();
                self.g_lens[self.g_count] = n;
                self.g_count = self.g_count + 1;
                return;
            }
            if tg == et(ET::ArrayRepeat._tag) {
                ev2 = const_int(ast, ast.aa[init]);
                cnt2 = const_int(ast, ast.bb[init]);
                if ev2.len == 0 || cnt2.len == 0 { return; }
                cn = 0;
                okc = 1;
                q = 0;
                while q < cnt2.len as int {
                    ch = cnt2.index(q as usize);
                    if ch < '0' || ch > '9' { okc = 0; break; }
                    cn = cn * 10 + (char_code(ch) - 48);
                    q = q + 1;
                }
                if okc == 0 || cn == 0 || cn > 4096 { return; }
                b2 = StringBuf::new();
                k = 0;
                while k < cn {
                    if k > 0 { b2.push(','); }
                    b2.push_str(ev2);
                    k = k + 1;
                }
                self.g_names[self.g_count] = name.copy();
                self.g_kinds[self.g_count] = 2;
                self.g_vals[self.g_count] = b2.to_string();
                self.g_lens[self.g_count] = cn;
                self.g_count = self.g_count + 1;
                return;
            }
        }
        // #[compile_time] 调用返回数组：堆数组全局（启动期初始化）
        if init >= 0 {
            if ast.tags[init] == et(ET::FnCall._tag) {
                rty_g = self.fn_ret_type(ast.texts[init]);
                if rty_g >= 0 {
                    if self.ret_kind(ast, rty_g) == 3 {
                        self.g_names[self.g_count] = name.copy();
                        self.g_kinds[self.g_count] = 5;
                        self.g_init_ids[self.g_count] = init;
                        self.g_vals[self.g_count] = "";
                        self.g_lens[self.g_count] = 0;
                        self.g_count = self.g_count + 1;
                        self.need_ginit = 1;
                        return;
                    }
                }
            }
        }
        // 通用回退：常量表达式（布局内置 / #[compile_time] 调用等）求值为 int 全局
        if init >= 0 {
            vg = self.const_eval_g(ast, init);
            if vg.len > 0 {
                self.g_names[self.g_count] = name.copy();
                self.g_kinds[self.g_count] = 0;
                self.g_vals[self.g_count] = vg.copy();
                self.g_lens[self.g_count] = 0;
                self.g_count = self.g_count + 1;
            }
        }
    }

    fn global_kind(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.g_count {
            if self.g_names[i] == name { return self.g_kinds[i]; }
            i = i + 1;
        }
        return -1;
    }

    #[alloc]
    #[state]
    fn global_val(ref mut self, ref String name) -> String {
        i = 0;
        while i < self.g_count {
            if self.g_names[i] == name { return self.g_vals[i].copy(); }
            i = i + 1;
        }
        return "";
    }

    fn find_struct_idx(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.st_count {
            if self.st_names[i] == name { return i; }
            i = i + 1;
        }
        return -1;
    }

    fn find_field_idx(ref mut self, ref String stname, ref String fname) -> int {
        si = self.find_struct_idx(stname);
        if si < 0 { return -1; }
        start = self.st_fstart[si];
        n = self.st_fcount[si];
        i = 0;
        while i < n {
            if self.st_fields[start + i] == fname { return i; }
            i = i + 1;
        }
        return -1;
    }

    fn fkind_at(ref mut self, int si, int idx) -> int {
        if si < 0 { return 0; }
        return self.st_fkind[self.st_fstart[si] + idx];
    }

    fn finfo_at(ref mut self, int si, int idx) -> int {
        if si < 0 { return -1; }
        return self.st_finfo[self.st_fstart[si] + idx];
    }

    fn fslot_at(ref mut self, int si, int idx) -> int {
        if si < 0 { return idx; }
        return self.st_fslot[self.st_fstart[si] + idx];
    }

    fn ftype_at(ref mut self, int si, int idx) -> int {
        if si < 0 { return -1; }
        return self.st_ftype[self.st_fstart[si] + idx];
    }

    fn find_method_id(ref mut self, ref String ty, ref String name) -> int {
        i = 0;
        while i < self.m_count {
            if self.m_ty[i] == ty {
                if self.m_name[i] == name { return self.m_id[i]; }
            }
            i = i + 1;
        }
        return -1;
    }

    #[alloc]
    #[state]
    /// 登记接口名与方法表（vtable 布局 = 接口方法声明顺序）
    #[alloc]
    #[state]
    fn reg_iface(ref mut self, ref Ast ast, int id) {
        if self.if_count >= 128 { return; }
        if self.find_iface_idx(ast.texts[id]) >= 0 { return; }
        self.if_names[self.if_count] = ast.texts[id].copy();
        self.if_mstart[self.if_count] = self.if_mtotal;
        n = 0;
        m = ast.aa[id];
        while m >= 0 {
            if ast.tags[m] == st(ST::FnDecl._tag) {
                if self.if_mtotal < 512 {
                    self.if_mnames[self.if_mtotal] = ast.texts[m].copy();
                    self.if_mnode[self.if_mtotal] = m;
                    self.if_mtotal = self.if_mtotal + 1;
                    n = n + 1;
                }
            }
            m = ast.nexts[m];
        }
        self.if_mcount[self.if_count] = n;
        self.if_count = self.if_count + 1;
    }

    /// 接口方法下标（无 -> -1）
    fn iface_method_idx(ref mut self, int ii, ref String name) -> int {
        if ii < 0 || ii >= self.if_count { return -1; }
        s0 = self.if_mstart[ii];
        e0 = s0 + self.if_mcount[ii];
        i = s0;
        while i < e0 {
            if self.if_mnames[i] == name { return i - s0; }
            i = i + 1;
        }
        return -1;
    }

    /// 接口方法声明节点
    fn iface_method_node_at(ref mut self, int ii, int mi) -> int {
        if ii < 0 || ii >= self.if_count { return -1; }
        s0 = self.if_mstart[ii];
        if mi < 0 || mi >= self.if_mcount[ii] { return -1; }
        return self.if_mnode[s0 + mi];
    }

    /// 接口方法第 i 个形参的种类（含 self，0 基）
    #[alloc]
    fn iface_param_kind(ref mut self, ref Ast ast, int mnode, int i) -> int {
        if mnode < 0 { return -1; }
        p = ast.aa[mnode];
        k = 0;
        while p >= 0 {
            if k == i { return self.param_kind(ast, p); }
            k = k + 1;
            p = ast.nexts[p];
        }
        return -1;
    }

    /// 接口方法第 i 个形参的类型名（含 self，0 基）
    #[alloc]
    fn iface_param_name(ref mut self, ref Ast ast, int mnode, int i) -> String {
        if mnode < 0 { return ""; }
        p = ast.aa[mnode];
        k = 0;
        while p >= 0 {
            if k == i { return ty_name(ast, ast.tys[p]); }
            k = k + 1;
            p = ast.nexts[p];
        }
        return "";
    }

    /// 函数形参的接口下标（+1；0 = 非接口）
    fn fn_piface_of(ref mut self, ref String fname, int i) -> int {
        f = 0;
        while f < self.fn_count {
            if self.fn_names[f] == fname {
                if i < self.fn_pcount[f] { return self.fn_piface[self.fn_pstart[f] + i]; }
                return 0;
            }
            f = f + 1;
        }
        return 0;
    }

    /// 类型是否实现了接口全部方法
    #[alloc]
    fn type_impls_iface(ref mut self, ref String ty, int ii) -> int {
        if ii < 0 || ii >= self.if_count { return 0; }
        s0 = self.if_mstart[ii];
        e0 = s0 + self.if_mcount[ii];
        if e0 == s0 { return 0; }
        i = s0;
        while i < e0 {
            if self.find_method_id(ty, self.if_mnames[i]) < 0 { return 0; }
            i = i + 1;
        }
        return 1;
    }

    /// 具体值 -> impl 表类型名（原语按候选名找实现了接口全部方法的）
    #[alloc]
    #[state]
    fn concrete_impl_name(ref mut self, ref Val v, ref String iface) -> String {
        if v.kind == 2 || v.kind == 4 { return v.b.copy(); }
        ii = self.find_iface_idx(iface);
        if ii < 0 { return ""; }
        if v.kind == 1 {
            if self.type_impls_iface("String", ii) == 1 { return "String"; }
            return "";
        }
        if v.kind == 6 {
            fn_c = ["float", "f64", "f32"];
            i6 = 0;
            while i6 < 3 {
                if self.type_impls_iface(fn_c[i6], ii) == 1 { return fn_c[i6].copy(); }
                i6 = i6 + 1;
            }
            return "";
        }
        if v.kind == 0 {
            in_c = ["int", "i64", "i32", "usize", "u32", "u64", "char", "bool", "i8", "u8", "i16", "u16"];
            i0 = 0;
            while i0 < 12 {
                if self.type_impls_iface(in_c[i0], ii) == 1 { return in_c[i0].copy(); }
                i0 = i0 + 1;
            }
        }
        return "";
    }

    /// 装箱：具体值 -> 接口值 box {data, vtable}（返回 box 指针）
    #[alloc]
    #[state]
    fn emit_box(ref mut self, ref Val v, ref String iface) -> String {
        data = v.a.copy();
        if v.kind == 0 {
            c0 = self.fresh();
            self.buf.push_str("  ");
            self.buf.push_str(c0);
            self.buf.push_str(" = call ptr @malloc(i64 8)\n  store i64 ");
            self.buf.push_str(v.a);
            self.buf.push_str(", ptr ");
            self.buf.push_str(c0);
            self.buf.push_str("\n");
            data = c0.copy();
        } elif v.kind == 6 {
            c6 = self.fresh();
            self.buf.push_str("  ");
            self.buf.push_str(c6);
            self.buf.push_str(" = call ptr @malloc(i64 8)\n  store double ");
            self.buf.push_str(v.a);
            self.buf.push_str(", ptr ");
            self.buf.push_str(c6);
            self.buf.push_str("\n");
            data = c6.copy();
        } elif v.kind == 1 {
            c1 = self.fresh();
            self.buf.push_str("  ");
            self.buf.push_str(c1);
            self.buf.push_str(" = call ptr @malloc(i64 16)\n  store ptr ");
            self.buf.push_str(v.a);
            self.buf.push_str(", ptr ");
            self.buf.push_str(c1);
            self.buf.push_str("\n  ");
            c1b = self.fresh();
            self.buf.push_str(c1b);
            self.buf.push_str(" = getelementptr i8, ptr ");
            self.buf.push_str(c1);
            self.buf.push_str(", i64 8\n  store i64 ");
            self.buf.push_str(v.b);
            self.buf.push_str(", ptr ");
            self.buf.push_str(c1b);
            self.buf.push_str("\n");
            data = c1.copy();
        }
        bx = self.fresh();
        self.buf.push_str("  ");
        self.buf.push_str(bx);
        self.buf.push_str(" = call ptr @malloc(i64 16)\n  store ptr ");
        self.buf.push_str(data);
        self.buf.push_str(", ptr ");
        self.buf.push_str(bx);
        self.buf.push_str("\n  ");
        bx8 = self.fresh();
        self.buf.push_str(bx8);
        self.buf.push_str(" = getelementptr i8, ptr ");
        self.buf.push_str(bx);
        self.buf.push_str(", i64 8\n");
        tn = self.concrete_impl_name(v, iface);
        if tn.len > 0 && iface.len > 0 {
            self.reg_vtable(tn, iface);
            self.buf.push_str("  store ptr @vtable.");
            self.buf.push_str(tn);
            self.buf.push_str(".");
            self.buf.push_str(iface);
            self.buf.push_str(", ptr ");
            self.buf.push_str(bx8);
            self.buf.push_str("\n");
        } else {
            self.buf.push_str("  store ptr null, ptr ");
            self.buf.push_str(bx8);
            self.buf.push_str("\n");
        }
        return bx;
    }

    /// 登记 (类型, 接口) vtable 对（去重）
    #[alloc]
    #[state]
    fn reg_vtable(ref mut self, ref String ty, ref String iface) {
        pn = ty + ".";
        pn = pn + iface;
        i = 0;
        while i < self.vt_count {
            if self.vt_pairs[i] == pn { return; }
            i = i + 1;
        }
        if self.vt_count < 512 {
            self.vt_pairs[self.vt_count] = pn.copy();
            self.vt_count = self.vt_count + 1;
        }
    }

    /// 发射已登记的 vtable 全局
    #[alloc]
    #[state]
    fn emit_vtables(ref mut self) {
        i = 0;
        while i < self.vt_count {
            pn = self.vt_pairs[i];
            d = -1;
            j = 0;
            while j < pn.len as int {
                if pn.index(j as usize) == '.' { d = j; break; }
                j = j + 1;
            }
            if d >= 0 {
                ty = pn.substring(0 as usize, d as usize);
                ifn = pn.substring((d + 1) as usize, pn.len);
                ii = self.find_iface_idx(ifn);
                if ii >= 0 && self.type_impls_iface(ty, ii) == 1 {
                    n2 = self.if_mcount[ii];
                    self.vt_defs.push_str("@vtable.");
                    self.vt_defs.push_str(pn);
                    self.vt_defs.push_str(" = global [");
                    self.vt_defs.push_int(n2);
                    self.vt_defs.push_str(" x ptr] [");
                    k = 0;
                    while k < n2 {
                        mn = self.if_mnames[self.if_mstart[ii] + k];
                        if k > 0 { self.vt_defs.push_str(", "); }
                        full = ty + ".";
                        full = full + mn;
                        self.vt_defs.push_str("ptr @");
                        self.vt_defs.push_str(self.fn_sym(full));
                        k = k + 1;
                    }
                    self.vt_defs.push_str("]\n");
                }
            }
            i = i + 1;
        }
    }

    fn find_iface_idx(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.if_count {
            if self.if_names[i] == name { return i; }
            i = i + 1;
        }
        return -1;
    }

    /// 方法 id -> impl 类型名
    #[alloc]
    fn method_ty_of(ref mut self, int mid) -> String {
        i = 0;
        while i < self.m_count {
            if self.m_id[i] == mid { return self.m_ty[i].copy(); }
            i = i + 1;
        }
        return "";
    }

    /// 按方法名在 impl 表里查（接口静态派发；多实现时取第一个）
    #[alloc]
    fn find_method_any(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.m_count {
            if self.m_name[i] == name { return self.m_id[i]; }
            i = i + 1;
        }
        return -1;
    }

    fn reg_struct(ref mut self, ref Ast ast, int id) {
        if self.st_count >= 128 { return; }
        // 同名去重
        if self.find_struct_idx(ast.texts[id]) >= 0 { return; }
        si = self.st_count;
        self.st_names[si] = ast.texts[id].copy();
        self.st_fstart[si] = self.st_ftotal;
        self.st_fcount[si] = 0;
        self.st_slots[si] = 0;
        self.st_count = si + 1;
    }

    /// union 字段布局：所有字段共享槽 0，slots = max 字段大小（字符串按 2 槽）
    #[alloc]
    #[state]
    fn fill_union(ref mut self, ref Ast ast, int id) {
        si = self.find_struct_idx(ast.texts[id]);
        if si < 0 { return; }
        self.st_fstart[si] = self.st_ftotal;
        n = 0;
        mx = 0;
        f = ast.aa[id];
        while f >= 0 {
            if self.st_ftotal < 1024 {
                self.st_fields[self.st_ftotal] = ast.texts[f].copy();
                fk = 0;
                finfo = -1;
                fty = ast.tys[f];
                if fty >= 0 {
                    ftag = ast.tags[fty];
                    if ftag == tt(TT::Float._tag) {
                        fk = 5;
                    } elif ftag == tt(TT::Array._tag) || ftag == tt(TT::ArraySized._tag) {
                        fk = 3;
                        finfo = ast.aa[fty];
                    } elif ftag == tt(TT::Named._tag) || ftag == tt(TT::Generic._tag) {
                        tn = ast.texts[fty];
                        if tn == "f32" || tn == "f64" {
                            fk = 5;
                        } elif tn == "String" {
                            fk = 1;
                        } else {
                            ii2 = self.find_iface_idx(tn);
                            si2 = self.find_struct_idx(tn);
                            if ii2 >= 0 {
                                fk = 6;
                                finfo = ii2;
                            } elif si2 >= 0 {
                                fk = 2;
                                finfo = si2;
                            } else {
                                ei2 = self.find_enum_idx(tn);
                                if ei2 >= 0 {
                                    fk = 4;
                                    finfo = ei2;
                                }
                            }
                        }
                    }
                }
                self.st_fkind[self.st_ftotal] = fk;
                self.st_finfo[self.st_ftotal] = finfo;
                self.st_fslot[self.st_ftotal] = 0;
                self.st_ftype[self.st_ftotal] = fty;
                if fk == 1 {
                    if mx < 2 { mx = 2; }
                } else {
                    if mx < 1 { mx = 1; }
                }
                self.st_ftotal = self.st_ftotal + 1;
                n = n + 1;
            }
            f = ast.nexts[f];
        }
        self.st_fcount[si] = n;
        self.st_slots[si] = mx;
    }

    #[alloc]
    #[state]
    fn fill_struct(ref mut self, ref Ast ast, int id) {
        si = self.find_struct_idx(ast.texts[id]);
        if si < 0 { return; }
        self.st_fstart[si] = self.st_ftotal;
        n = 0;
        slot = 0;
        f = ast.aa[id];
        while f >= 0 {
            if self.st_ftotal < 1024 {
                self.st_fields[self.st_ftotal] = ast.texts[f].copy();
                fk = 0;
                finfo = -1;
                fty = ast.tys[f];
                if fty >= 0 {
                    ftag = ast.tags[fty];
                    if ftag == tt(TT::Float._tag) {
                        fk = 5;
                    } elif ftag == tt(TT::Array._tag) || ftag == tt(TT::ArraySized._tag) {
                        fk = 3;
                        finfo = ast.aa[fty];
                    } elif ftag == tt(TT::Named._tag) || ftag == tt(TT::Generic._tag) {
                        tn = ast.texts[fty];
                        if tn == "f32" || tn == "f64" {
                            fk = 5;
                        } elif tn == "String" {
                            fk = 1;
                        } else {
                            ii2 = self.find_iface_idx(tn);
                            si2 = self.find_struct_idx(tn);
                            if ii2 >= 0 {
                                fk = 6;
                                finfo = ii2;
                            } elif si2 >= 0 {
                                fk = 2;
                                finfo = si2;
                            } else {
                                ei2 = self.find_enum_idx(tn);
                                if ei2 >= 0 {
                                    fk = 4;
                                    finfo = ei2;
                                }
                            }
                        }
                    }
                }
                self.st_fkind[self.st_ftotal] = fk;
                self.st_finfo[self.st_ftotal] = finfo;
                self.st_fslot[self.st_ftotal] = slot;
                self.st_ftype[self.st_ftotal] = fty;
                if fk == 1 { slot = slot + 2; } else { slot = slot + 1; }
                self.st_ftotal = self.st_ftotal + 1;
                n = n + 1;
            }
            f = ast.nexts[f];
        }
        self.st_fcount[si] = n;
        self.st_slots[si] = slot;
    }

    #[alloc]
    #[state]
    fn add_method(ref mut self, ref Ast ast, ref String ty, int fid) {
        if self.m_count >= 4096 { return; }
        self.m_ty[self.m_count] = ty.copy();
        self.m_name[self.m_count] = ast.texts[fid].copy();
        self.m_id[self.m_count] = fid;
        self.m_rtype[self.m_count] = ast.tys[fid];
        self.m_count = self.m_count + 1;
    }

    #[alloc]
    #[state]
    fn find_enum_idx(ref mut self, ref String name) -> int {
        i = 0;
        while i < self.en_count {
            if self.en_names[i] == name { return i; }
            i = i + 1;
        }
        return -1;
    }

    fn find_variant_idx(ref mut self, int ei, ref String vname) -> int {
        start = self.en_vstart[ei];
        n = self.en_vcount[ei];
        i = 0;
        while i < n {
            if self.en_variants[start + i] == vname { return i; }
            i = i + 1;
        }
        return -1;
    }

    fn enum_max_arity(ref mut self, int ei) -> int {
        start = self.en_vstart[ei];
        n = self.en_vcount[ei];
        mx = 0;
        i = 0;
        while i < n {
            if self.en_vslots[start + i] > mx { mx = self.en_vslots[start + i]; }
            i = i + 1;
        }
        return mx;
    }

    fn variant_arity(ref mut self, int ei, int vi) -> int {
        return self.en_arity[self.en_vstart[ei] + vi];
    }

    /// 变体第 k 个载荷的类型节点 id（-1 未知）
    fn variant_ptype(ref mut self, int ei, int vi, int k) -> int {
        idx = self.en_vstart[ei] + vi;
        if k >= self.en_arity[idx] { return -1; }
        return self.en_ptype[self.en_pvstart[idx] + k];
    }

    /// 变体第 k 个载荷的槽位偏移（1 起，tag 占 0）
    #[alloc]
    #[state]
    fn payload_slot(ref mut self, ref Ast ast, int ei, int vi, int k) -> int {
        idx = self.en_vstart[ei] + vi;
        off = 1;
        i = 0;
        while i < k {
            pty = self.en_ptype[self.en_pvstart[idx] + i];
            if ty_name(ast, pty) == "String" {
                off = off + 2;
            } else {
                off = off + 1;
            }
            i = i + 1;
        }
        return off;
    }

    #[alloc]
    #[state]
    fn add_enum(ref mut self, ref Ast ast, int id) {
        if self.en_count >= 128 { return; }
        // 同名去重（prelude 与 std 合并时 Option/Result 会重复定义）
        if self.find_enum_idx(ast.texts[id]) >= 0 { return; }
        ei = self.en_count;
        self.en_names[ei] = ast.texts[id].copy();
        self.en_vstart[ei] = self.en_vtotal;
        n = 0;
        v = ast.aa[id];
        while v >= 0 {
            if self.en_vtotal < 1024 {
                self.en_variants[self.en_vtotal] = ast.texts[v].copy();
                self.en_arity[self.en_vtotal] = ast.tys[v];
                self.en_pvstart[self.en_vtotal] = self.en_ptotal;
                slots = 0;
                pa = ast.aa[v];
                while pa >= 0 {
                    if self.en_ptotal < 4096 {
                        pty = ast.tys[pa];
                        self.en_ptype[self.en_ptotal] = pty;
                        self.en_ptotal = self.en_ptotal + 1;
                        if ty_name(ast, pty) == "String" {
                            slots = slots + 2;
                        } else {
                            slots = slots + 1;
                        }
                    }
                    pa = ast.nexts[pa];
                }
                self.en_vslots[self.en_vtotal] = slots;
                self.en_vtotal = self.en_vtotal + 1;
                n = n + 1;
            }
            v = ast.nexts[v];
        }
        self.en_vcount[ei] = n;
        self.en_count = ei + 1;
    }

    #[alloc]
    #[state]
    /// 记录函数签名（参数种类）
    #[alloc]
    #[state]
    fn add_fn_sig(ref mut self, ref Ast ast, int id, ref String prefix) {
        if self.fn_count >= 4096 { return; }
        if (ast.dd[id] / 262144) % 2 == 1 { return; }
        fi = self.fn_count;
        name = ast.texts[id].copy();
        if prefix.len > 0 {
            name = prefix + ".";
            name = name + ast.texts[id];
        }
        self.fn_names[fi] = name.copy();
        self.fn_extern[fi] = 0;
        if ast.dd[id] == 1 { self.fn_extern[fi] = 1; }
        self.fn_first[fi] = id;
        if (ast.dd[id] / 131072) % 2 == 1 {
            if self.ct_count < 256 {
                self.ct_names[self.ct_count] = name.copy();
                self.ct_ids[self.ct_count] = id;
                self.ct_count = self.ct_count + 1;
            }
        }
        self.fn_pstart[fi] = self.fn_ptotal;
        n = 0;
        p = ast.aa[id];
        while p >= 0 {
            if self.fn_ptotal < 32768 {
                pki = self.param_kind(ast, p);
                self.fn_pkinds[self.fn_ptotal] = pki;
                if pki == 21 {
                    pn_if = ty_name(ast, ast.tys[p]);
                    ii_if = self.find_iface_idx(pn_if);
                    if ii_if >= 0 { self.fn_piface[self.fn_ptotal] = ii_if + 1; }
                }
                self.fn_ptotal = self.fn_ptotal + 1;
                n = n + 1;
            }
            p = ast.nexts[p];
        }
        self.fn_pcount[fi] = n;
        self.fn_rtype[fi] = ast.tys[id];
        // 只有 extern 声明才按声明宽度调用（普通函数定义统一 i64）
        self.fn_rllvm[fi] = 0;
        if ast.dd[id] == 1 {
            self.fn_rllvm[fi] = self.ret_llvm_code(ast, ast.tys[id]);
        }
        self.fn_count = fi + 1;
    }

    /// Ayanami 函数符号：非 extern 加 `aya.` 前缀（避免与 libc 重名；extern 保持裸名）
    #[alloc]
    fn fn_sym(ref mut self, ref String fname) -> String {
        if fname == "main" { return fname.copy(); }
        i = 0;
        while i < self.fn_count {
            if self.fn_names[i] == fname {
                if self.fn_extern[i] == 1 { return fname.copy(); }
                return "aya." + fname;
            }
            i = i + 1;
        }
        return "aya." + fname;
    }

    /// 元素槽类型（表感知）：未知 Named（泛型参数 T 等）按 i64，与 param_kind 一致
    #[alloc]
    fn elem_llvm_m(ref mut self, ref Ast ast, int ety) -> String {
        // 精确哨兵（2000-2002）直接走原逻辑；合成 id 为负值不在此列
        if ety == 2000 || ety == 2001 || ety == 2002 { return elem_llvm(ast, ety); }
        if ety >= 0 {
            tg = ast.tags[ety];
            if tg == tt(TT::Named._tag) || tg == tt(TT::Generic._tag) {
                tn = ast.texts[ety];
                if tn != "String" && tn != "f32" && tn != "f64" {
                    if self.find_struct_idx(tn) < 0 {
                        if self.find_enum_idx(tn) < 0 {
                            if self.find_iface_idx(tn) < 0 {
                                return "i64";
                            }
                        }
                    }
                }
            }
        }
        return elem_llvm(ast, ety);
    }

    /// 按首个实参 kind 选重载候选（返回候选下标；k0=6 浮点优先 31，否则非 31）
    fn fn_pick_by_kind(ref mut self, ref String fname, int k0) -> int {
        first_i = -1;
        i = 0;
        while i < self.fn_count {
            if self.fn_names[i] == fname {
                if first_i < 0 { first_i = i; }
                if self.fn_pcount[i] >= 1 {
                    pk = self.fn_pkinds[self.fn_pstart[i]];
                    if k0 == 6 {
                        if pk == 31 { return i; }
                    } else {
                        if pk != 31 { return i; }
                    }
                }
            }
            i = i + 1;
        }
        return first_i;
    }

    /// 按首个形参类型名选候选（如 bool/char 重载）
    #[alloc]
    fn fn_pick_by_tyname(ref mut self, ref Ast ast, ref String fname, ref String tname) -> int {
        i = 0;
        while i < self.fn_count {
            if self.fn_names[i] == fname {
                fid = self.fn_first[i];
                if fid >= 0 {
                    p0 = ast.aa[fid];
                    if p0 >= 0 {
                        ok_t = 0;
                        if ty_name(ast, ast.tys[p0]) == tname { ok_t = 1; }
                        pt = ast.tys[p0];
                        if pt >= 0 {
                            if tname == "bool" && ast.tags[pt] == tt(TT::Bool._tag) { ok_t = 1; }
                            if tname == "char" && ast.tags[pt] == tt(TT::Char._tag) { ok_t = 1; }
                        }
                        if ok_t == 1 { return i; }
                    }
                }
            }
            i = i + 1;
        }
        return -1;
    }

    /// 候选定义序数（同名前第几个）
    fn fn_ord_at(ref mut self, int fi) -> int {
        if fi < 0 { return 0; }
        nm = self.fn_names[fi].copy();
        ord = 0;
        i = 0;
        while i < fi {
            if self.fn_names[i] == nm { ord = ord + 1; }
            i = i + 1;
        }
        return ord;
    }

    /// 候选形参种类（按下标）
    fn fn_pk_at(ref mut self, int fi, int k) -> int {
        if fi < 0 { return -1; }
        if k < self.fn_pcount[fi] { return self.fn_pkinds[self.fn_pstart[fi] + k]; }
        return -1;
    }

    /// 候选返回类型节点
    fn fn_rt_at(ref mut self, int fi) -> int {
        if fi < 0 { return -1; }
        return self.fn_rtype[fi];
    }

    /// 同名候选数
    fn fn_count_name(ref mut self, ref String fname) -> int {
        c = 0;
        i = 0;
        while i < self.fn_count {
            if self.fn_names[i] == fname { c = c + 1; }
            i = i + 1;
        }
        return c;
    }

    /// 按 FnDecl 节点查表下标
    fn fn_idx_of_node(ref mut self, ref String fname, int node) -> int {
        i = 0;
        while i < self.fn_count {
            if self.fn_names[i] == fname {
                if self.fn_first[i] == node { return i; }
            }
            i = i + 1;
        }
        return -1;
    }

    /// 符号（重名候选按表下标加 .__N；唯一名保持原符号）
    #[alloc]
    fn fn_sym_ord(ref mut self, ref String fname, int idx) -> String {
        if idx < 0 { return self.fn_sym(fname); }
        // extern（C 符号）不参与重载修饰
        if self.fn_extern[idx] == 1 { return self.fn_sym(fname); }
        if self.fn_count_name(fname) <= 1 { return self.fn_sym(fname); }
        b = StringBuf::new();
        b.push_str(self.fn_sym(fname));
        b.push_str(".__");
        b.push_int(idx);
        return b.to_string();
    }

    /// 定义序数（按 FnDecl 节点）
    fn fn_ord_of_node(ref mut self, ref String fname, int node) -> int {
        ord = 0;
        i = 0;
        while i < self.fn_count {
            if self.fn_names[i] == fname {
                if self.fn_first[i] == node { return ord; }
                ord = ord + 1;
            }
            i = i + 1;
        }
        return 0;
    }

    /// 隐式位置参数（__line/__col/__file）在调用点注入；返回附加实参文本
    #[alloc]
    #[state]
    fn implicit_args_m(ref mut self, ref Ast ast, int id, int fnode, int start, int first) -> String {
        b = StringBuf::new();
        if fnode < 0 { return ""; }
        pp = ast.aa[fnode];
        pi = 0;
        fst = first;
        while pp >= 0 {
            if pi >= start {
                pname = ast.texts[pp];
                if pname == "__line" || pname == "__col" || pname == "__file" {
                    if fst == 0 { b.push_str(", "); }
                    fst = 0;
                    if pname == "__file" {
                        si_f = self.add_str(self.src_file);
                        b.push_str("ptr @.str.");
                        b.push_int(si_f);
                        b.push_str(", i64 ");
                        b.push_int(self.src_file.len as int);
                    } elif pname == "__line" {
                        b.push_str("i64 ");
                        if id >= 0 { b.push_int(ast.lines[id]); } else { b.push_int(0); }
                    } else {
                        b.push_str("i64 ");
                        if id >= 0 { b.push_int(ast.cols[id]); } else { b.push_int(0); }
                    }
                }
            }
            pi = pi + 1;
            pp = ast.nexts[pp];
        }
        return b.to_string();
    }

    /// 裸指针指向类型的元素尺寸（offset 步长）
    #[alloc]
    fn pointee_size(ref mut self, ref String tn) -> int {
        si_p = self.find_struct_idx(tn);
        if si_p >= 0 { return self.st_slots[si_p] * 8; }
        ei_p = self.find_enum_idx(tn);
        if ei_p >= 0 { return (1 + self.enum_max_arity(ei_p)) * 8; }
        return 8;
    }

    /// 布局内置求值：size_of[T]/align_of[T]/offset_of[T](field)（自然对齐，与 stage-0 一致）
    #[alloc]
    #[state]
    fn layout_builtin_val(ref mut self, ref Ast ast, int id) -> String {
        nm_b = ast.texts[id];
        if nm_b != "size_of" && nm_b != "align_of" && nm_b != "offset_of" { return ""; }
        ty_b = ast.tys[id];
        if ty_b < 0 { return ""; }
        // 特化上下文：类型参数按实参类型求布局
        if self.cur_inst_param.len > 0 && self.cur_inst_arg_ty != -1 {
            if ty_name(ast, ty_b) == self.cur_inst_param { ty_b = self.cur_inst_arg_ty; }
        }
        if self.cur_inst_param2.len > 0 && self.cur_inst_arg_ty2 != -1 {
            if ty_name(ast, ty_b) == self.cur_inst_param2 { ty_b = self.cur_inst_arg_ty2; }
        }
        if self.cur_inst_param3.len > 0 && self.cur_inst_arg_ty3 != -1 {
            if ty_name(ast, ty_b) == self.cur_inst_param3 { ty_b = self.cur_inst_arg_ty3; }
        }
        if self.cur_inst_param4.len > 0 && self.cur_inst_arg_ty4 != -1 {
            if ty_name(ast, ty_b) == self.cur_inst_param4 { ty_b = self.cur_inst_arg_ty4; }
        }
        enc = self.layout_enc(ast, ty_b);
        sz_b = enc / 16;
        al_b = enc - sz_b * 16;
        if nm_b == "align_of" { return int_str2(al_b); }
        if nm_b == "size_of" { return int_str2(sz_b); }
        // offset_of：字段名 + 自然对齐偏移
        tn_b = ty_name(ast, ty_b);
        si_b = self.find_struct_idx(tn_b);
        if si_b < 0 { return "0"; }
        a_b = ast.aa[id];
        if a_b < 0 { return ""; }
        if ast.tags[a_b] == xt(XT::Arg._tag) { a_b = ast.aa[a_b]; }
        fn_b = ast.texts[a_b];
        is_u = 0;
        nm_s2 = self.st_names[si_b].copy();
        if self.is_union_name(ast, nm_s2) { is_u = 1; }
        start = self.st_fstart[si_b];
        n = self.st_fcount[si_b];
        off = 0;
        i = 0;
        while i < n {
            enc_i = self.layout_enc(ast, self.st_ftype[start + i]);
            sz_i = enc_i / 16;
            a_i = enc_i - sz_i * 16;
            if a_i < 1 { a_i = 1; }
            if is_u == 0 { off = align_up(off, a_i); }
            if self.st_fields[start + i] == fn_b { return int_str2(off); }
            if is_u == 0 { off = off + sz_i; }
            i = i + 1;
        }
        return "";
    }

    /// 声明处的首个类型参数名（结构体）
    #[alloc]
    fn struct_gparam(ref mut self, ref Ast ast, ref String nm) -> String {
        i = 0;
        while i < ast.len {
            if ast.tags[i] == st(ST::StructDef._tag) && ast.texts[i] == nm {
                g = ast.bb[i];
                if g >= 0 { return ast.texts[g].copy(); }
                return "";
            }
            i = i + 1;
        }
        return "";
    }

    /// 枚举的首个类型参数名（从变体载荷推断）
    fn enum_gparam(ref mut self, ref Ast ast, int ei) -> String {
        vs = self.en_vstart[ei];
        n = self.en_vcount[ei];
        i = 0;
        while i < n {
            idx = vs + i;
            ar = self.en_arity[idx];
            pv = self.en_pvstart[idx];
            k = 0;
            while k < ar {
                nm = ty_name(ast, self.en_ptype[pv + k]);
                if nm.len > 0 && self.is_gparam(nm) {
                    if self.find_struct_idx(nm) < 0 {
                        if self.find_enum_idx(nm) < 0 {
                            if self.find_iface_idx(nm) < 0 { return nm.copy(); }
                        }
                    }
                }
                k = k + 1;
            }
            i = i + 1;
        }
        return "";
    }

    /// 是否 union 定义
    #[alloc]
    fn is_union_name(ref mut self, ref Ast ast, ref String nm) -> bool {
        i = 0;
        while i < ast.len {
            if ast.tags[i] == st(ST::UnionDef._tag) && ast.texts[i] == nm { return true; }
            i = i + 1;
        }
        return false;
    }

    /// 布局编码：size * 16 + align（自然对齐规则）
    #[alloc]
    #[state]
    fn layout_enc(ref mut self, ref Ast ast, int ty) -> int {
        return self.layout_enc_s(ast, ty, "", -1);
    }

    #[alloc]
    #[state]
    fn layout_enc_s(ref mut self, ref Ast ast, int ty, ref String pn, int pa) -> int {
        if ty == -4001 { return 136; }
        if ty == -4002 { return 17; }
        if ty == -4003 { return 264; }
        if ty == -4004 { return 136; }
        if ty == -4005 { return 17; }
        if ty == -4006 { return 136; }
        if ty <= -1000 && ty > -1128 { return self.layout_struct_s(ast, 0 - 1000 - ty, "", -1); }
        if ty <= -2000 && ty > -2128 { return self.layout_enum_s(ast, 0 - 2000 - ty, "", -1); }
        if ty < 0 { return 0; }
        tg = ast.tags[ty];
        tn = "";
        if tg == tt(TT::Named._tag) || tg == tt(TT::Generic._tag) { tn = ast.texts[ty].copy(); }
        if pn.len > 0 && pa >= 0 && tn == pn { return self.layout_enc_s(ast, pa, "", -1); }
        if tg == tt(TT::Char._tag) || tg == tt(TT::Bool._tag) { return 17; }
        if tg == tt(TT::Float._tag) { return 136; }
        if tg == tt(TT::Array._tag) || tg == tt(TT::ArraySized._tag) { return 136; }
        if tg == tt(TT::Ref._tag) || tg == tt(TT::RawPtr._tag) || tg == tt(TT::FnPtr._tag) { return 136; }
        if tg == tt(TT::Closure._tag) { return 264; }
        if tg == tt(TT::Unique._tag) {
            in_u = ast.aa[ty];
            if in_u < 0 { return 136; }
            itg = ast.tags[in_u];
            if itg == tt(TT::Named._tag) || itg == tt(TT::Generic._tag) || itg == tt(TT::Closure._tag) || itg == tt(TT::Array._tag) || itg == tt(TT::ArraySized._tag) { return 136; }
            return self.layout_enc_s(ast, in_u, pn, pa);
        }
        if tn.len == 0 { return 136; }
        if tn == "String" { return 264; }
        if tn == "int" || tn == "i64" || tn == "u64" || tn == "usize" || tn == "float" || tn == "f64" { return 136; }
        if tn == "i32" || tn == "u32" || tn == "f32" { return 68; }
        if tn == "i16" || tn == "u16" { return 34; }
        if tn == "i8" || tn == "u8" || tn == "char" || tn == "bool" { return 17; }
        if tn == "Ptr" { return 136; }
        si = self.find_struct_idx(tn);
        if si >= 0 {
            arg_s = -1;
            gp_s = "";
            if tg == tt(TT::Generic._tag) {
                arg_s = ast.aa[ty];
                gp_s = self.struct_gparam(ast, tn);
            }
            return self.layout_struct_s(ast, si, gp_s, arg_s);
        }
        ei = self.find_enum_idx(tn);
        if ei >= 0 {
            arg_e = -1;
            gp_e = "";
            if tg == tt(TT::Generic._tag) {
                arg_e = ast.aa[ty];
                gp_e = self.enum_gparam(ast, ei);
            }
            return self.layout_enum_s(ast, ei, gp_e, arg_e);
        }
        return 264;
    }

    /// 结构体/联合体布局编码
    #[alloc]
    #[state]
    fn layout_struct_s(ref mut self, ref Ast ast, int si, ref String pn, int pa) -> int {
        if si < 0 || si >= self.st_count { return 264; }
        is_u = 0;
        nm_s = self.st_names[si].copy();
        if self.is_union_name(ast, nm_s) { is_u = 1; }
        start = self.st_fstart[si];
        n = self.st_fcount[si];
        off = 0;
        al = 1;
        i = 0;
        while i < n {
            enc = self.layout_enc_s(ast, self.st_ftype[start + i], pn, pa);
            sz_i = enc / 16;
            a_i = enc - sz_i * 16;
            if a_i < 1 { a_i = 1; }
            if is_u == 1 {
                if sz_i > off { off = sz_i; }
            } else {
                off = align_up(off, a_i) + sz_i;
            }
            if a_i > al { al = a_i; }
            i = i + 1;
        }
        off = align_up(off, al);
        return off * 16 + al;
    }

    /// 枚举布局编码（tag + 各变体载荷结构依次排列）
    #[alloc]
    #[state]
    fn layout_enum_s(ref mut self, ref Ast ast, int ei, ref String pn, int pa) -> int {
        if ei < 0 || ei >= self.en_count { return 264; }
        off = 8;
        al = 8;
        vs = self.en_vstart[ei];
        n = self.en_vcount[ei];
        vi = 0;
        while vi < n {
            idx = vs + vi;
            ar = self.en_arity[idx];
            pv = self.en_pvstart[idx];
            poff = 0;
            pal = 1;
            k = 0;
            while k < ar {
                enc = self.layout_enc_s(ast, self.en_ptype[pv + k], pn, pa);
                sz_p = enc / 16;
                a_p = enc - sz_p * 16;
                if a_p < 1 { a_p = 1; }
                poff = align_up(poff, a_p) + sz_p;
                if a_p > pal { pal = a_p; }
                k = k + 1;
            }
            poff = align_up(poff, pal);
            off = align_up(off, pal) + poff;
            if pal > al { al = pal; }
            vi = vi + 1;
        }
        off = align_up(off, al);
        return off * 16 + al;
    }

    fn fn_param_kind(ref mut self, ref String fname, int i) -> int {
        f = 0;
        while f < self.fn_count {
            if self.fn_names[f] == fname {
                if i < self.fn_pcount[f] {
                    return self.fn_pkinds[self.fn_pstart[f] + i];
                }
                return 0;
            }
            f = f + 1;
        }
        return 0;
    }

    #[alloc]
    #[state]
    fn collect_decls(ref mut self, ref Ast ast, int prog) {
        // 第一遍：结构体名（字段引用需全部名字就绪）
        s = ast.aa[prog];
        while s >= 0 {
            if ast.tags[s] == st(ST::StructDef._tag) {
                self.reg_struct(ast, s);
            } elif ast.tags[s] == st(ST::UnionDef._tag) {
                self.reg_struct(ast, s);
            } elif ast.tags[s] == st(ST::EnumDef._tag) {
                self.add_enum(ast, s);
            } elif ast.tags[s] == st(ST::InterfaceDef._tag) {
                self.reg_iface(ast, s);
            } elif ast.tags[s] == st(ST::Namespace._tag) {
                m2 = ast.aa[s];
                while m2 >= 0 {
                    if ast.tags[m2] == st(ST::StructDef._tag) {
                        self.reg_struct(ast, m2);
                    } elif ast.tags[m2] == st(ST::EnumDef._tag) {
                        self.add_enum(ast, m2);
                    }
                    m2 = ast.nexts[m2];
                }
            }
            s = ast.nexts[s];
        }
        // 第二遍：结构体字段
        s = ast.aa[prog];
        while s >= 0 {
            if ast.tags[s] == st(ST::StructDef._tag) {
                self.fill_struct(ast, s);
            } elif ast.tags[s] == st(ST::UnionDef._tag) {
                self.fill_union(ast, s);
            } elif ast.tags[s] == st(ST::Namespace._tag) {
                m2 = ast.aa[s];
                while m2 >= 0 {
                    if ast.tags[m2] == st(ST::StructDef._tag) {
                        self.fill_struct(ast, m2);
                    } elif ast.tags[m2] == st(ST::UnionDef._tag) {
                        self.fill_union(ast, m2);
                    }
                    m2 = ast.nexts[m2];
                }
            }
            s = ast.nexts[s];
        }
        // 第三遍：枚举 + 函数/方法签名
        s = ast.aa[prog];
        while s >= 0 {
            if ast.tags[s] == st(ST::ImplBlock._tag) {
                m = ast.aa[s];
                while m >= 0 {
                    if ast.tags[m] == st(ST::FnDecl._tag) {
                        self.add_method(ast, ast.texts[s], m);
                        self.add_fn_sig(ast, m, ast.texts[s]);
                    }
                    m = ast.nexts[m];
                }
            } elif ast.tags[s] == st(ST::FnDecl._tag) {
                self.add_fn_sig(ast, s, "");
            } elif ast.tags[s] == st(ST::Namespace._tag) {
                ns = ast.texts[s].copy();
                m2 = ast.aa[s];
                while m2 >= 0 {
                    if ast.tags[m2] == st(ST::FnDecl._tag) {
                        self.add_fn_sig(ast, m2, ns);
                    }
                    m2 = ast.nexts[m2];
                }
            }
            s = ast.nexts[s];
        }
    }

    /// 名称是否为泛型参数
    #[alloc]
    /// 标记 -> 名字（原语/结构体/枚举）
    #[alloc]
    fn marker_name(ref mut self, int m) -> String {
        if m == -4001 { return "int"; }
        if m == -4002 { return "bool"; }
        if m == -4003 { return "String"; }
        if m == -4004 { return "float"; }
        if m == -4005 { return "char"; }
        if m == -4006 { return "fn"; }
        if m <= -1000 && m > -1128 { return self.st_names[0 - 1000 - m].copy(); }
        if m <= -2000 && m > -2128 { return self.en_names[0 - 2000 - m].copy(); }
        return "";
    }

    /// 标记基名（实例名去掉 __m<k>）
    #[alloc]
    fn marker_base(ref mut self, int m) -> String {
        nm = self.marker_name(m);
        p = nm.index_of("__m");
        if p > 0 { return nm.substring(0 as usize, p as usize); }
        return nm;
    }

    /// 名字 -> 标记
    #[alloc]
    fn marker_of_name(ref mut self, ref String nm) -> int {
        if nm == "String" { return -4003; }
        if nm == "int" || nm == "usize" || nm == "i32" || nm == "i64" || nm == "u32" || nm == "u64" || nm == "i8" || nm == "u8" || nm == "i16" || nm == "u16" { return -4001; }
        if nm == "float" || nm == "f64" || nm == "f32" { return -4004; }
        if nm == "char" { return -4005; }
        if nm == "bool" { return -4002; }
        if nm == "fn" { return -4006; }
        si = self.find_struct_idx(nm);
        if si >= 0 { return -1000 - si; }
        ei = self.find_enum_idx(nm);
        if ei >= 0 { return -2000 - ei; }
        return -1;
    }

    /// Val -> 类型标记（枚举构造实例推断）
    #[alloc]
    fn val_marker(ref mut self, ref Ast ast, ref Val v) -> int {
        if v.kind == 1 { return -4003; }
        if v.kind == 6 { return -4004; }
        if v.kind == 2 {
            si_v = self.find_struct_idx(v.b);
            if si_v >= 0 { return -1000 - si_v; }
            return -1;
        }
        if v.kind == 4 {
            ei_v = self.find_enum_idx(v.b);
            if ei_v >= 0 { return -2000 - ei_v; }
            return -1;
        }
        if v.ty == 7000 { return -4005; }
        if v.ty == 9000 { return -4002; }
        if v.ty >= 10001 && v.ty < 10129 { return -1000 - (v.ty - 10001); }
        return -4001;
    }

    /// 记录容器局部 -> 源结构体名
    #[state]
    fn note_local_src(ref mut self, ref String nm, ref String src) {
        if nm.len == 0 || src.len == 0 { return; }
        i = 0;
        while i < self.ln_count {
            if self.ln_names[i] == nm {
                if self.ln_srcs[i].len == 0 { self.ln_srcs[i] = src.copy(); }
                return;
            }
            i = i + 1;
        }
        if self.ln_count < 256 {
            self.ln_names[self.ln_count] = nm.copy();
            self.ln_srcs[self.ln_count] = src.copy();
            self.ln_count = self.ln_count + 1;
        }
    }

    fn local_src_of(ref mut self, ref String nm) -> String {
        i = 0;
        while i < self.ln_count {
            if self.ln_names[i] == nm { return self.ln_srcs[i].copy(); }
            i = i + 1;
        }
        return "";
    }

    /// 实参表示（标记或类型节点）的基名
    #[alloc]
    fn arg_name_of(ref mut self, ref Ast ast, int arg) -> String {
        if arg < 0 { return self.marker_base(arg); }
        return self.type_arg_name(ast, arg);
    }

    /// 按 (源枚举, 实参基名) 查找枚举实例（返回 en 下标）
    #[alloc]
    fn find_enum_inst(ref mut self, ref Ast ast, int ei_src, int arg) -> int {
        ab = self.arg_name_of(ast, arg);
        if ab.len == 0 { return -1; }
        i = 0;
        while i < self.ei_count {
            if self.ei_srcs[i] == ei_src {
                if self.arg_name_of(ast, self.ei_args[i]) == ab { return self.ei_ens[i]; }
            }
            i = i + 1;
        }
        return -1;
    }

    /// 生成/查找泛型枚举实例（变体与载荷类型按首个类型参数替换）
    #[alloc]
    #[state]
    fn fill_enum_inst(ref mut self, ref Ast ast, int ei_src, int arg) -> int {
        if ei_src < 0 || ei_src >= self.en_count || arg == -1 { return -1; }
        old_ei = self.find_enum_inst(ast, ei_src, arg);
        if old_ei >= 0 { return old_ei; }
        if self.en_count >= 128 || self.ei_count >= 128 { return -1; }
        gp = self.enum_gparam(ast, ei_src);
        if gp.len == 0 { return -1; }
        src_name = self.en_names[ei_src].copy();
        ei_new = self.en_count;
        self.en_names[ei_new] = src_name + "__m" + int_str2(ei_new);
        self.en_vstart[ei_new] = self.en_vtotal;
        self.en_vcount[ei_new] = self.en_vcount[ei_src];
        vs = self.en_vstart[ei_src];
        nv = self.en_vcount[ei_src];
        k = 0;
        while k < nv {
            idx_s = vs + k;
            if self.en_vtotal >= 1024 { break; }
            self.en_variants[self.en_vtotal] = self.en_variants[idx_s].copy();
            ar = self.en_arity[idx_s];
            self.en_arity[self.en_vtotal] = ar;
            self.en_pvstart[self.en_vtotal] = self.en_ptotal;
            pv = self.en_pvstart[idx_s];
            sl_n = 0;
            j = 0;
            while j < ar {
                pty = unwrap_ty(ast, self.en_ptype[pv + j]);
                pn = ty_name(ast, pty);
                if pn.len > 0 && pn == gp { pty = arg; }
                if self.en_ptotal < 4096 {
                    self.en_ptype[self.en_ptotal] = pty;
                    self.en_ptotal = self.en_ptotal + 1;
                }
                if elem_is_string(ast, pty) { sl_n = sl_n + 2; } else { sl_n = sl_n + 1; }
                j = j + 1;
            }
            self.en_vslots[self.en_vtotal] = sl_n;
            self.en_vtotal = self.en_vtotal + 1;
            k = k + 1;
        }
        self.en_count = ei_new + 1;
        self.ei_ens[self.ei_count] = ei_new;
        self.ei_srcs[self.ei_count] = ei_src;
        self.ei_args[self.ei_count] = arg;
        self.ei_count = self.ei_count + 1;
        if self.body_phase == 1 {
            self.type_buf.push_str("%enum.");
            self.type_buf.push_str(self.en_names[ei_new]);
            self.type_buf.push_str(" = type { i64");
            mx_e = self.enum_max_arity(ei_new);
            k_e = 0;
            while k_e < mx_e {
                self.type_buf.push_str(", i64");
                k_e = k_e + 1;
            }
            self.type_buf.push_str(" }\n");
        }
        return ei_new;
    }

    /// 类型节点内是否仍含类型参数（含嵌套泛型实参，如 Box[T]）
    #[alloc]
    fn type_has_gparam(ref mut self, ref Ast ast, int ty) -> bool {
        t = unwrap_ty(ast, ty);
        if t < 0 { return false; }
        tg = ast.tags[t];
        if tg == tt(TT::Named._tag) || tg == tt(TT::Generic._tag) {
            nm = ast.texts[t];
            if self.is_gparam(nm) {
                if self.find_struct_idx(nm) < 0 {
                    if self.find_enum_idx(nm) < 0 {
                        if self.find_iface_idx(nm) < 0 { return true; }
                    }
                }
            }
            if tg == tt(TT::Generic._tag) {
                a = ast.aa[t];
                if a >= 0 { return self.type_has_gparam(ast, a); }
            }
            return false;
        }
        if tg == tt(TT::Array._tag) || tg == tt(TT::ArraySized._tag) {
            return self.type_has_gparam(ast, ast.aa[t]);
        }
        return false;
    }

    /// 类型节点是否为类型参数（先排除已声明的结构体/枚举/接口名）
    #[alloc]
    fn type_is_gparam(ref mut self, ref Ast ast, int arg) -> bool {
        if arg < 0 { return false; }
        tg_tg = ast.tags[arg];
        if tg_tg != tt(TT::Named._tag) && tg_tg != tt(TT::Generic._tag) { return false; }
        nm_tg = ast.texts[arg];
        if self.find_struct_idx(nm_tg) >= 0 { return false; }
        if self.find_enum_idx(nm_tg) >= 0 { return false; }
        if self.find_iface_idx(nm_tg) >= 0 { return false; }
        return self.is_gparam(nm_tg);
    }

    #[state]
    fn is_gparam(ref mut self, ref String name) -> bool {
        i = 0;
        while i < self.gp_names_count {
            if self.gp_names[i] == name { return true; }
            i = i + 1;
        }
        return false;
    }

    /// 3tq 阶段 1：登记一个泛型实例键（去重，顺序稳定）
    #[alloc]
    #[state]
    fn add_inst(ref mut self, ref String key, int arg_ty) {
        if key.len == 0 { return; }
        i = 0;
        while i < self.inst_count {
            if self.inst_keys[i] == key { return; }
            i = i + 1;
        }
        if self.inst_count < 512 {
            self.inst_keys[self.inst_count] = key.copy();
            self.inst_arg_tys[self.inst_count] = arg_ty;
            self.inst_arg2_tys[self.inst_count] = -1;
            self.inst_count = self.inst_count + 1;
        }
    }

    /// 登记实例（含第二个类型实参；同名时补齐缺失的第二实参）
    #[alloc]
    #[state]
    fn add_inst2(ref mut self, ref String key, int arg_ty, int arg_ty2) {
        if key.len == 0 { return; }
        i = 0;
        while i < self.inst_count {
            if self.inst_keys[i] == key {
                if self.inst_arg2_tys[i] == -1 && arg_ty2 != -1 {
                    self.inst_arg2_tys[i] = arg_ty2;
                }
                return;
            }
            i = i + 1;
        }
        if self.inst_count < 512 {
            self.inst_keys[self.inst_count] = key.copy();
            self.inst_arg_tys[self.inst_count] = arg_ty;
            self.inst_arg2_tys[self.inst_count] = arg_ty2;
            self.inst_count = self.inst_count + 1;
        }
    }

    /// 类型实参名（Named/Generic 取文本；原语/数组/裸指针用标签名）
    #[alloc]
    fn type_arg_name(ref mut self, ref Ast ast, int arg) -> String {
        if arg == -4001 { return "int"; }
        if arg == -4002 { return "bool"; }
        if arg == -4003 { return "String"; }
        if arg == -4004 { return "float"; }
        if arg == -4005 { return "char"; }
        if arg == -4006 { return "fn"; }
        if arg <= -1000 && arg > -1128 { return self.st_names[0 - 1000 - arg].copy(); }
        if arg <= -2000 && arg > -2128 { return self.en_names[0 - 2000 - arg].copy(); }
        if arg < 0 { return ""; }
        if arg >= 0 {
            atg0 = ast.tags[arg];
            if atg0 == tt(TT::FnPtr._tag) || atg0 == tt(TT::Closure._tag) { return "fn"; }
        }
        an = ty_name(ast, arg);
        if an.len > 0 { return an; }
        if arg < 0 { return ""; }
        atg = ast.tags[arg];
        if atg == tt(TT::Array._tag) || atg == tt(TT::ArraySized._tag) { return "array"; }
        if atg == tt(TT::RawPtr._tag) { return "rawptr"; }
        if atg == tt(TT::Float._tag) { return "float"; }
        if atg == tt(TT::Int._tag) { return "int"; }
        if atg == tt(TT::Bool._tag) { return "bool"; }
        if atg == tt(TT::Char._tag) { return "char"; }
        return "";
    }

    /// 3tq 阶段 1：类型节点中的泛型实例（Name[Arg]，含 ref/数组内层）
    #[alloc]
    #[state]
    fn note_type_inst(ref mut self, ref Ast ast, int ty) {
        if ty < 0 { return; }
        tg = ast.tags[ty];
        if tg == tt(TT::Generic._tag) {
            nm = ast.texts[ty].copy();
            arg = ast.aa[ty];
            if arg >= 0 {
                an = self.type_arg_name(ast, arg);
                a1_u = unwrap_ty(ast, arg);
                a2_u = -1;
                nx_a = ast.nexts[arg];
                if nx_a >= 0 { a2_u = unwrap_ty(ast, nx_a); }
                if an.len > 0 && !self.type_is_gparam(ast, arg) && !self.type_has_gparam(ast, arg) {
                    self.add_inst2(nm + "[" + an + "]", a1_u, a2_u);
                    ei_nt = self.find_enum_idx(nm);
                    if ei_nt >= 0 {
                        self.fill_enum_inst(ast, ei_nt, a1_u);
                    }
                }
            }
        } elif tg == tt(TT::Ref._tag) {
            self.note_type_inst(ast, ast.aa[ty]);
        } elif tg == tt(TT::Array._tag) || tg == tt(TT::ArraySized._tag) {
            self.note_type_inst(ast, ast.aa[ty]);
        }
    }

    /// 3tq 阶段 1：实例收集（类型标注 + 显式泛型调用；不改发射）
    #[alloc]
    #[state]
    fn collect_instances(ref mut self, ref Ast ast) {
        // 先收集全部泛型参数名（跳过以类型参数为实参的"实例"）
        i = 0;
        while i < ast.len {
            if ast.tags[i] == xt(XT::GenericParam._tag) {
                nmg = ast.texts[i];
                k = 0;
                dup = 0;
                while k < self.gp_names_count {
                    if self.gp_names[k] == nmg { dup = 1; break; }
                    k = k + 1;
                }
                if dup == 0 && self.gp_names_count < 256 {
                    self.gp_names[self.gp_names_count] = nmg.copy();
                    self.gp_names_count = self.gp_names_count + 1;
                }
            }
            i = i + 1;
        }
        // 仅声明类节点：其 tys 字段是类型节点（表达式节点的 tys 存操作符/模式标签）
        i = 0;
        while i < ast.len {
            tg0 = ast.tags[i];
            if tg0 == st(ST::FnDecl._tag) || tg0 == st(ST::ConstDecl._tag) || tg0 == st(ST::StaticDecl._tag) || tg0 == xt(XT::Param._tag) || tg0 == xt(XT::StructField._tag) || tg0 == xt(XT::GenericParam._tag) {
                ty0 = ast.tys[i];
                if ty0 >= 0 { self.note_type_inst(ast, ty0); }
            }
            i = i + 1;
        }
        // 显式泛型调用：FnCall.tys 保存类型实参（size_of[T]/reinterpret[T]/Ns::f[T]）
        i = 0;
        while i < ast.len {
            if ast.tags[i] == et(ET::FnCall._tag) {
                ty1 = ast.tys[i];
                if ty1 >= 0 {
                    an1 = self.type_arg_name(ast, ty1);
                    if an1.len > 0 && !self.type_is_gparam(ast, ty1) && !self.type_has_gparam(ast, ty1) {
                        self.add_inst(ast.texts[i] + "[" + an1 + "]", unwrap_ty(ast, ty1));
                        // 返回类型中的泛型结构体：Name[T] -> Name[实参]（结构体实例）
                        fid_r = self.fn_first_id(ast.texts[i]);
                        if fid_r >= 0 {
                            rty_n = ast.tys[fid_r];
                            if rty_n >= 0 {
                                if ast.tags[rty_n] == tt(TT::Generic._tag) {
                                    rn2 = ast.texts[rty_n].copy();
                                    self.add_inst(rn2 + "[" + an1 + "]", ty1);
                                }
                            }
                        }
                    }
                }
            }
            i = i + 1;
        }
        // 局部源结构体名：x = X::new(...) / Type.fn(...)（枚举载荷推断用）
        i = 0;
        while i < ast.len {
            if ast.tags[i] == st(ST::Assign._tag) {
                rhs_l = ast.aa[i];
                if rhs_l >= 0 && ast.tags[rhs_l] == et(ET::FnCall._tag) {
                    cn_l = ast.texts[rhs_l];
                    ld_l = -1;
                    q_l = 0;
                    while q_l < cn_l.len as int {
                        if cn_l.index(q_l as usize) == '.' { ld_l = q_l; }
                        q_l = q_l + 1;
                    }
                    if ld_l > 0 {
                        base_l = cn_l.substring(0 as usize, ld_l as usize);
                        if self.find_struct_idx(base_l) >= 0 {
                            self.note_local_src(ast.texts[i], base_l);
                        }
                    }
                }
            }
            i = i + 1;
        }
        // 泛型枚举实例：Option::Some(x) 等（按载荷值推断类型实参）
        i = 0;
        while i < ast.len {
            if ast.tags[i] == et(ET::FnCall._tag) {
                en_ec = pat_enum(ast.texts[i]);
                ei_ec = self.find_enum_idx(en_ec);
                if ei_ec >= 0 {
                    vn_ec = pat_short(ast.texts[i]);
                    vi_ec = self.find_variant_idx(ei_ec, vn_ec);
                    if vi_ec >= 0 {
                        gp_ec = self.enum_gparam(ast, ei_ec);
                        if gp_ec.len > 0 {
                            ar_ec = self.variant_arity(ei_ec, vi_ec);
                            k_ec = 0;
                            while k_ec < ar_ec {
                                if ty_name(ast, self.variant_ptype(ei_ec, vi_ec, k_ec)) == gp_ec {
                                    // 第 k 个构造实参
                                    a_ec = ast.aa[i];
                                    j_ec = 0;
                                    while a_ec >= 0 && j_ec < k_ec {
                                        a_ec = ast.nexts[a_ec];
                                        j_ec = j_ec + 1;
                                    }
                                    if a_ec >= 0 {
                                        ax_ec = a_ec;
                                        if ast.tags[ax_ec] == xt(XT::Arg._tag) { ax_ec = ast.aa[ax_ec]; }
                                        m_ec = self.infer_ctor_arg(ast, ax_ec);
                                        if m_ec != -1 {
                                            self.fill_enum_inst(ast, ei_ec, m_ec);
                                        }
                                    }
                                }
                                k_ec = k_ec + 1;
                            }
                        }
                    }
                }
            }
            i = i + 1;
        }
        // 容器用法推断：x = X::new()（无显式类型实参）+ x.method(arg) → 实例
        i = 0;
        while i < ast.len {
            if ast.tags[i] == st(ST::Assign._tag) {
                rhs_i = ast.aa[i];
                if rhs_i >= 0 && ast.tags[rhs_i] == et(ET::FnCall._tag) {
                    if ast.tys[rhs_i] < 0 {
                        fid_i = self.fn_first_id(ast.texts[rhs_i]);
                        if fid_i >= 0 {
                            g_i = ast.cc[fid_i];
                            if g_i >= 0 && ast.nexts[g_i] < 0 {
                                rt_i = ast.tys[fid_i];
                                if rt_i >= 0 && ast.tags[rt_i] == tt(TT::Generic._tag) {
                                    sn_i = ast.texts[rt_i].copy();
                                    gp_i = ast.texts[g_i].copy();
                                    ln_i = ast.texts[i].copy();
                                    m_i = 0;
                                    while m_i < ast.len {
                                        if ast.tags[m_i] == et(ET::MethodCall._tag) {
                                            ob_i = ast.aa[m_i];
                                            if ob_i >= 0 && ast.tags[ob_i] == et(ET::Ident._tag) && ast.texts[ob_i] == ln_i {
                                                mid_i = self.find_method_id(sn_i, ast.texts[m_i]);
                                                if mid_i >= 0 {
                                                    pp_i = ast.aa[mid_i];
                                                    if pp_i >= 0 {
                                                        if ast.texts[pp_i] == "self" { pp_i = ast.nexts[pp_i]; }
                                                    }
                                                    aa_i = ast.bb[m_i];
                                                    while pp_i >= 0 && aa_i >= 0 {
                                                        if ty_name(ast, ast.tys[pp_i]) == gp_i {
                                                            ax_i = aa_i;
                                                            if ast.tags[ax_i] == xt(XT::Arg._tag) { ax_i = ast.aa[ax_i]; }
                                                            mk_i = self.infer_static_ty(ast, ax_i);
                                                            if mk_i != -1 {
                                                                an_i = self.type_arg_name(ast, mk_i);
                                                                if an_i.len > 0 {
                                                                    self.add_inst(sn_i + "[" + an_i + "]", mk_i);
                                                                    self.infer_note_call(rhs_i, mk_i);
                                                                }
                                                            }
                                                        }
                                                        pp_i = ast.nexts[pp_i];
                                                        aa_i = ast.nexts[aa_i];
                                                    }
                                                }
                                            }
                                        }
                                        m_i = m_i + 1;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i = i + 1;
        }
        // 无类型实参的泛型结构体字面量：按字段值推断（Box { v = 42 } / Pair { ... }）
        i = 0;
        while i < ast.len {
            if ast.tags[i] == et(ET::StructLiteral._tag) {
                if ast.tys[i] < 0 {
                    nm_li = ast.texts[i];
                    si_li = self.find_struct_idx(nm_li);
                    if si_li >= 0 {
                        gp1_li = self.struct_gparam(ast, nm_li);
                        if gp1_li.len > 0 {
                            gp2_li = "";
                            sd_li = -1;
                            q_li = 0;
                            while q_li < ast.len {
                                if ast.tags[q_li] == st(ST::StructDef._tag) && ast.texts[q_li] == nm_li { sd_li = q_li; break; }
                                q_li = q_li + 1;
                            }
                            if sd_li >= 0 {
                                g2_li = ast.bb[sd_li];
                                if g2_li >= 0 {
                                    g2_li = ast.nexts[g2_li];
                                    if g2_li >= 0 { gp2_li = ast.texts[g2_li].copy(); }
                                }
                            }
                            a1_li = -1;
                            a2_li = -1;
                            f_li = ast.aa[i];
                            while f_li >= 0 {
                                idx_li = self.find_field_idx(nm_li, ast.texts[f_li]);
                                if idx_li >= 0 {
                                    fty_li = self.ftype_at(si_li, idx_li);
                                    tn_li = ty_name(ast, fty_li);
                                    if tn_li.len > 0 && tn_li == gp1_li {
                                        m_li = self.infer_ctor_arg(ast, ast.aa[f_li]);
                                        if m_li != -1 { a1_li = m_li; }
                                    } elif gp2_li.len > 0 && tn_li == gp2_li {
                                        m2_li = self.infer_ctor_arg(ast, ast.aa[f_li]);
                                        if m2_li != -1 { a2_li = m2_li; }
                                    } elif tn_li == "Ptr" {
                                        mpt_li = self.infer_ptr_elem(ast, ast.aa[f_li]);
                                        if mpt_li != -1 {
                                            fpt_li = self.ftype_at(si_li, idx_li);
                                            inpt_li = ast.aa[fpt_li];
                                            if inpt_li < 0 { inpt_li = ast.tys[fpt_li]; }
                                            inptn_li = ty_name(ast, unwrap_ty(ast, inpt_li));
                                            if inptn_li.len > 0 && inptn_li == gp1_li { a1_li = mpt_li; }
                                            elif gp2_li.len > 0 && inptn_li == gp2_li { a2_li = mpt_li; }
                                        }
                                    }
                                }
                                f_li = ast.nexts[f_li];
                            }
                            if a1_li != -1 {
                                an_li = self.type_arg_name(ast, a1_li);
                                if an_li.len > 0 {
                                    self.add_inst2(nm_li + "[" + an_li + "]", a1_li, a2_li);
                                }
                            }
                        }
                    }
                }
            }
            i = i + 1;
        }
        // 泛型结构体字面量：Name[T] { ... }
        i = 0;
        while i < ast.len {
            if ast.tags[i] == et(ET::StructLiteral._tag) {
                tyg_l = ast.tys[i];
                if tyg_l >= 0 {
                    an_l = self.type_arg_name(ast, tyg_l);
                    if an_l.len > 0 && !self.type_is_gparam(ast, tyg_l) && !self.type_has_gparam(ast, tyg_l) {
                        a1_l = unwrap_ty(ast, tyg_l);
                        a2_l = -1;
                        nx_l = ast.nexts[tyg_l];
                        if nx_l >= 0 { a2_l = unwrap_ty(ast, nx_l); }
                        self.add_inst2(ast.texts[i] + "[" + an_l + "]", a1_l, a2_l);
                    }
                }
            }
            i = i + 1;
        }
        // 3tq 阶段 2（建表阶段）：为结构体实例生成特化字段布局
        i = 0;
        while i < self.inst_count {
            key = self.inst_keys[i];
            lb = -1;
            rb = -1;
            q = 0;
            while q < key.len as int {
                if key.index(q as usize) == '[' {
                    if lb < 0 { lb = q; }
                }
                if key.index(q as usize) == ']' { rb = q; }
                q = q + 1;
            }
            if lb > 0 && rb > lb {
                nm_i = key.substring(0 as usize, lb as usize);
                si_src = self.find_struct_idx(nm_i);
                if si_src >= 0 {
                    self.fill_struct_inst(ast, si_src, self.inst_arg_tys[i], self.inst_arg2_tys[i]);
                }
            }
            i = i + 1;
        }
    }

    /// 3tq 阶段 2：结构体实例的特化字段布局（源结构体的类型参数替换为实参类型）
    #[alloc]
    #[state]
    fn fill_struct_inst(ref mut self, ref Ast ast, int si_src, int arg_ty, int arg_ty2) {
        self.fill_struct_inst4(ast, si_src, arg_ty, arg_ty2, -1, -1);
    }

    /// 四类型实参的结构体实例布局（T,U,I,J）
    #[alloc]
    #[state]
    fn fill_struct_inst4(ref mut self, ref Ast ast, int si_src, int arg_ty, int arg_ty2, int arg_ty3, int arg_ty4) {
        if si_src < 0 || si_src >= self.st_count { return; }
        src_name = self.st_names[si_src].copy();
        // 源结构体定义节点（按名扫描）
        sdef = -1;
        i = 0;
        while i < ast.len {
            if ast.tags[i] == st(ST::StructDef._tag) {
                if ast.texts[i] == src_name { sdef = i; break; }
            }
            i = i + 1;
        }
        if sdef < 0 { return; }
        // 第一个类型参数名
        gpname = "";
        gpname2 = "";
        gpname3 = "";
        gpname4 = "";
        g = ast.bb[sdef];
        if g >= 0 {
            gpname = ast.texts[g].copy();
            g2 = ast.nexts[g];
            if g2 >= 0 {
                gpname2 = ast.texts[g2].copy();
                g3 = ast.nexts[g2];
                if g3 >= 0 {
                    gpname3 = ast.texts[g3].copy();
                    g4 = ast.nexts[g3];
                    if g4 >= 0 { gpname4 = ast.texts[g4].copy(); }
                }
            }
        }
        if gpname.len == 0 { return; }
        if self.st_count >= 128 { return; }
        si_new = self.st_count;
        iname = src_name + "__m";
        iname = iname + int_str2(si_new);
        self.st_names[si_new] = iname.copy();
        self.st_fstart[si_new] = self.st_ftotal;
        cnt_n = 0;
        slot = 0;
        f = ast.aa[sdef];
        while f >= 0 {
            if self.st_ftotal < 1024 {
                self.st_fields[self.st_ftotal] = ast.texts[f].copy();
                fk = 0;
                finfo = -1;
                fty = ast.tys[f];
                tn_f = ty_name(ast, fty);
                subst = -1;
                if tn_f.len > 0 {
                    if tn_f == gpname { subst = arg_ty; }
                    elif gpname2.len > 0 && tn_f == gpname2 { subst = arg_ty2; }
                    elif gpname3.len > 0 && tn_f == gpname3 { subst = arg_ty3; }
                    elif gpname4.len > 0 && tn_f == gpname4 { subst = arg_ty4; }
                }
                if subst != -1 { fty = subst; }
                if fty < 0 {
                    // 合成类型标记作为字段类型
                    if fty == -4003 {
                        fk = 1;
                    } elif fty == -4004 {
                        fk = 5;
                    } elif fty <= -1000 && fty > -1128 {
                        fk = 2;
                        finfo = 0 - 1000 - fty;
                    } elif fty <= -2000 && fty > -2128 {
                        fk = 4;
                        finfo = 0 - 2000 - fty;
                    }
                } elif fty >= 0 {
                    ftag = ast.tags[fty];
                    if ftag == tt(TT::Float._tag) {
                        fk = 5;
                    } elif ftag == tt(TT::Array._tag) || ftag == tt(TT::ArraySized._tag) {
                        fk = 3;
                        finfo = ast.aa[fty];
                        ety_f = ast.aa[fty];
                        if ety_f >= 0 {
                            en_f = ty_name(ast, ety_f);
                            if en_f.len > 0 {
                                if en_f == gpname { finfo = arg_ty; }
                                elif gpname2.len > 0 && en_f == gpname2 { finfo = arg_ty2; }
                                elif gpname3.len > 0 && en_f == gpname3 { finfo = arg_ty3; }
                                elif gpname4.len > 0 && en_f == gpname4 { finfo = arg_ty4; }
                            }
                        }
                    } elif ftag == tt(TT::Named._tag) || ftag == tt(TT::Generic._tag) {
                        tn2 = ast.texts[fty];
                        if tn2 == gpname {
                            if arg_ty >= 0 {
                                atg2 = ast.tags[arg_ty];
                                if atg2 == tt(TT::Float._tag) {
                                    fk = 5;
                                } elif atg2 == tt(TT::Named._tag) || atg2 == tt(TT::Generic._tag) {
                                    an2 = ast.texts[arg_ty];
                                    if an2 == "String" {
                                        fk = 1;
                                    } else {
                                        si3 = self.find_struct_idx(an2);
                                        if si3 >= 0 {
                                            fk = 2;
                                            finfo = si3;
                                        } else {
                                            ei3 = self.find_enum_idx(an2);
                                            if ei3 >= 0 {
                                                fk = 4;
                                                finfo = ei3;
                                            }
                                        }
                                    }
                                }
                            } else {
                                // 推断得到的合成类型标记
                                if arg_ty == -4003 {
                                    fk = 1;
                                } elif arg_ty == -4004 {
                                    fk = 5;
                                } elif arg_ty <= -1000 && arg_ty > -1128 {
                                    fk = 2;
                                    finfo = 0 - 1000 - arg_ty;
                                } elif arg_ty <= -2000 && arg_ty > -2128 {
                                    fk = 4;
                                    finfo = 0 - 2000 - arg_ty;
                                }
                            }
                        } elif tn2 == "f32" || tn2 == "f64" {
                            fk = 5;
                        } elif tn2 == "String" {
                            fk = 1;
                        } else {
                            ii2 = self.find_iface_idx(tn2);
                            si2 = self.find_struct_idx(tn2);
                            if ii2 >= 0 {
                                fk = 6;
                                finfo = ii2;
                            } elif si2 >= 0 {
                                fk = 2;
                                finfo = si2;
                            } else {
                                ei2 = self.find_enum_idx(tn2);
                                if ei2 >= 0 {
                                    fk = 4;
                                    finfo = ei2;
                                }
                            }
                        }
                    }
                }
                self.st_fkind[self.st_ftotal] = fk;
                self.st_finfo[self.st_ftotal] = finfo;
                self.st_fslot[self.st_ftotal] = slot;
                self.st_ftype[self.st_ftotal] = fty;
                if fk == 1 { slot = slot + 2; } else { slot = slot + 1; }
                self.st_ftotal = self.st_ftotal + 1;
                cnt_n = cnt_n + 1;
            }
            f = ast.nexts[f];
        }
        self.st_fcount[si_new] = cnt_n;
        self.st_slots[si_new] = slot;
        self.st_count = si_new + 1;
        // 登记实例表（源结构体下标 + 实参类型节点 → 实例名）
        if self.inst_st_count < 128 {
            self.inst_st_names[self.inst_st_count] = iname.copy();
            self.inst_st_src[self.inst_st_count] = si_src;
            self.inst_st_argty[self.inst_st_count] = arg_ty;
            self.inst_st_argty2[self.inst_st_count] = arg_ty2;
            self.inst_st_count = self.inst_st_count + 1;
        }
        // 发射期新建实例：补 %struct 定义（类型定义在函数体之前）
        if self.body_phase == 1 {
            self.type_buf.push_str("%struct.");
            self.type_buf.push_str(iname);
            self.type_buf.push_str(" = type { ");
            n_t = self.st_slots[si_new];
            i_t = 0;
            while i_t < n_t {
                if i_t > 0 { self.type_buf.push_str(", "); }
                self.type_buf.push_str("i64");
                i_t = i_t + 1;
            }
            self.type_buf.push_str(" }\n");
        }
    }

    /// ref String 实参：构造连续双槽临时，登记调用后回写
    #[alloc]
    #[state]
    fn string_ref_temp(ref mut self, ref String nm) -> String {
        tmp = self.fresh();
        self.buf.push_str("  ");
        self.buf.push_str(tmp);
        self.buf.push_str(" = alloca { ptr, i64 }\n  ");
        gp1 = self.fresh();
        self.buf.push_str(gp1);
        self.buf.push_str(" = getelementptr { ptr, i64 }, ptr ");
        self.buf.push_str(tmp);
        self.buf.push_str(", i32 0, i32 0\n  ");
        v1 = self.fresh();
        self.buf.push_str(v1);
        self.buf.push_str(" = load ptr, ptr %v_");
        self.buf.push_str(nm);
        self.buf.push_str(".ptr\n  store ptr ");
        self.buf.push_str(v1);
        self.buf.push_str(", ptr ");
        self.buf.push_str(gp1);
        self.buf.push_str("\n  ");
        gp2 = self.fresh();
        self.buf.push_str(gp2);
        self.buf.push_str(" = getelementptr { ptr, i64 }, ptr ");
        self.buf.push_str(tmp);
        self.buf.push_str(", i32 0, i32 1\n  ");
        v2 = self.fresh();
        self.buf.push_str(v2);
        self.buf.push_str(" = load i64, ptr %v_");
        self.buf.push_str(nm);
        self.buf.push_str(".len\n  store i64 ");
        self.buf.push_str(v2);
        self.buf.push_str(", ptr ");
        self.buf.push_str(gp2);
        self.buf.push_str("\n");
        if self.cb_count < 32 {
            self.cb_tmps[self.cb_count] = tmp.copy();
            self.cb_names[self.cb_count] = nm.copy();
            self.cb_count = self.cb_count + 1;
        }
        return tmp;
    }

    /// 调用后回写 ref String 实参
    #[state]
    fn flush_string_refs(ref mut self) {
        i = 0;
        while i < self.cb_count {
            tmp = self.cb_tmps[i].copy();
            nm = self.cb_names[i].copy();
            gp3 = self.fresh();
            self.buf.push_str("  ");
            self.buf.push_str(gp3);
            self.buf.push_str(" = getelementptr { ptr, i64 }, ptr ");
            self.buf.push_str(tmp);
            self.buf.push_str(", i32 0, i32 0\n  ");
            v3 = self.fresh();
            self.buf.push_str(v3);
            self.buf.push_str(" = load ptr, ptr ");
            self.buf.push_str(gp3);
            self.buf.push_str("\n  store ptr ");
            self.buf.push_str(v3);
            self.buf.push_str(", ptr %v_");
            self.buf.push_str(nm);
            self.buf.push_str(".ptr\n  ");
            gp4 = self.fresh();
            self.buf.push_str(gp4);
            self.buf.push_str(" = getelementptr { ptr, i64 }, ptr ");
            self.buf.push_str(tmp);
            self.buf.push_str(", i32 0, i32 1\n  ");
            v4 = self.fresh();
            self.buf.push_str(v4);
            self.buf.push_str(" = load i64, ptr ");
            self.buf.push_str(gp4);
            self.buf.push_str("\n  store i64 ");
            self.buf.push_str(v4);
            self.buf.push_str(", ptr %v_");
            self.buf.push_str(nm);
            self.buf.push_str(".len\n");
            i = i + 1;
        }
        self.cb_count = 0;
    }

    /// 语法级类型推断（不依赖局部类型表；供 collect_instances 前置扫描）
    #[alloc]
    #[state]
    fn infer_static_ty(ref mut self, ref Ast ast, int id) -> int {
        if id < 0 { return -1; }
        tg = ast.tags[id];
        if tg == et(ET::Ref._tag) { return self.infer_static_ty(ast, ast.aa[id]); }
        if tg == et(ET::Lambda._tag) { return -4006; }
        if tg == et(ET::StructLiteral._tag) {
            si = self.find_struct_idx(ast.texts[id]);
            if si >= 0 { return -1000 - si; }
            return -1;
        }
        if tg == et(ET::EnumConstruct._tag) {
            ei = self.find_enum_idx(pat_name(ast.texts[id]));
            if ei >= 0 { return -2000 - ei; }
            return -1;
        }
        if tg == et(ET::Literal._tag) {
            k = ast.bb[id];
            if k == lk(LK::Str._tag) { return -4003; }
            if k == lk(LK::Float._tag) { return -4004; }
            if k == lk(LK::Char._tag) { return -4005; }
            if k == lk(LK::Bool._tag) { return -4002; }
            return -4001;
        }
        if tg == et(ET::FnCall._tag) {
            en_c = pat_enum(ast.texts[id]);
            ei_c = self.find_enum_idx(en_c);
            if ei_c >= 0 {
                if self.find_variant_idx(ei_c, pat_short(ast.texts[id])) >= 0 {
                    return -2000 - ei_c;
                }
            }
            f = self.fn_first_id(ast.texts[id]);
            if f >= 0 {
                rt = ast.tys[f];
                if rt >= 0 {
                    tn = ty_name(ast, rt);
                    if tn == "String" { return -4003; }
                    if tn == "float" || tn == "f64" || tn == "f32" { return -4004; }
                    if tn == "char" { return -4005; }
                    if tn == "bool" { return -4002; }
                    if tn == "int" || tn == "usize" || tn == "i32" || tn == "u32" || tn == "i64" || tn == "u64" { return -4001; }
                    si_f = self.find_struct_idx(tn);
                    if si_f >= 0 { return -1000 - si_f; }
                    ei_f = self.find_enum_idx(tn);
                    if ei_f >= 0 { return -2000 - ei_f; }
                    rtag = ast.tags[rt];
                    if rtag == tt(TT::Char._tag) { return -4005; }
                    if rtag == tt(TT::Bool._tag) { return -4002; }
                    if rtag == tt(TT::Float._tag) { return -4004; }
                    if rtag == tt(TT::Int._tag) { return -4001; }
                }
            }
            return -1;
        }
        return -1;
    }

    #[state]
    fn infer_note_call(ref mut self, int node, int ty) {
        if self.ic_count < 256 {
            self.ic_nodes[self.ic_count] = node;
            self.ic_tys[self.ic_count] = ty;
            self.ic_count = self.ic_count + 1;
        }
    }

    fn infer_call_ty_of(ref mut self, int node) -> int {
        i = 0;
        while i < self.ic_count {
            if self.ic_nodes[i] == node { return self.ic_tys[i]; }
            i = i + 1;
        }
        return -1;
    }

    /// 从实参表达式推断类型标记（不发射代码；未知返回 -1）
    #[alloc]
    #[state]
    fn infer_expr_ty(ref mut self, ref Ast ast, int id) -> int {
        if id < 0 { return -1; }
        tg = ast.tags[id];
        if tg == et(ET::Ref._tag) { return self.infer_expr_ty(ast, ast.aa[id]); }
        if tg == et(ET::Lambda._tag) { return -4006; }
        if tg == et(ET::StructLiteral._tag) {
            si = self.find_struct_idx(ast.texts[id]);
            if si >= 0 { return -1000 - si; }
            return -1;
        }
        if tg == et(ET::EnumConstruct._tag) {
            en = pat_name(ast.texts[id]);
            ei = self.find_enum_idx(en);
            if ei >= 0 { return -2000 - ei; }
            return -1;
        }
        if tg == et(ET::Literal._tag) {
            k = ast.bb[id];
            if k == lk(LK::Str._tag) { return -4003; }
            if k == lk(LK::Float._tag) { return -4004; }
            if k == lk(LK::Char._tag) { return -4005; }
            if k == lk(LK::Bool._tag) { return -4002; }
            return -4001;
        }
        if tg == et(ET::FnCall._tag) {
            en_c2 = pat_enum(ast.texts[id]);
            ei_c2 = self.find_enum_idx(en_c2);
            if ei_c2 >= 0 {
                if self.find_variant_idx(ei_c2, pat_short(ast.texts[id])) >= 0 {
                    return -2000 - ei_c2;
                }
            }
            f = self.fn_first_id(ast.texts[id]);
            if f >= 0 {
                rt = ast.tys[f];
                if rt >= 0 {
                    tn = ty_name(ast, rt);
                    if tn == "String" { return -4003; }
                    if tn == "float" || tn == "f64" { return -4004; }
                    if tn == "f32" { return -4004; }
                    if tn == "char" { return -4005; }
                    if tn == "bool" { return -4002; }
                    if tn == "int" || tn == "usize" || tn == "i32" || tn == "u32" || tn == "i64" || tn == "u64" { return -4001; }
                    si_f = self.find_struct_idx(tn);
                    if si_f >= 0 { return -1000 - si_f; }
                    ei_f = self.find_enum_idx(tn);
                    if ei_f >= 0 { return -2000 - ei_f; }
                    rtag = ast.tags[rt];
                    if rtag == tt(TT::Char._tag) { return -4005; }
                    if rtag == tt(TT::Bool._tag) { return -4002; }
                    if rtag == tt(TT::Float._tag) { return -4004; }
                    if rtag == tt(TT::Int._tag) { return -4001; }
                }
            }
            return -1;
        }
        if tg == et(ET::Ident._tag) {
            nm = ast.texts[id];
            kd = self.local_kind(nm);
            if kd >= 100 && kd < 228 { return -1000 - (kd - 100); }
            if kd == 20 {
                ei2 = self.etype_of_local(nm);
                if ei2 >= 0 { return -2000 - ei2; }
                return -1;
            }
            if kd == 1 { return -4003; }
            if kd == 40 { return -4004; }
            if kd == 30 {
                et30 = self.etype_of_local(nm);
                if et30 == 2000 { return -4003; }
                if et30 == 8000 { return -4004; }
                if et30 == 7000 { return -4005; }
                if et30 == 9000 { return -4002; }
                if et30 >= 10001 && et30 < 10129 { return -1000 - (et30 - 10001); }
                return -4001;
            }
            if kd == 0 {
                et0 = self.etype_of_local(nm);
                if et0 == 2002 { return -4005; }
                if et0 == 7000 { return -4005; }
                if et0 == 9000 { return -4002; }
                if et0 >= 10001 && et0 < 10129 { return -1000 - (et0 - 10001); }
                return -4001;
            }
            return -1;
        }
        return -1;
    }

    /// 字段值 Ptr[T] 的元素类型标记（Ptr.new(X) → X 的类型）
    #[alloc]
    #[state]
    fn infer_ptr_elem(ref mut self, ref Ast ast, int expr) -> int {
        if expr < 0 { return -1; }
        if ast.tags[expr] == et(ET::Ref._tag) { return self.infer_ptr_elem(ast, ast.aa[expr]); }
        if ast.tags[expr] == et(ET::FnCall._tag) {
            nm_pe = ast.texts[expr];
            if nm_pe == "Ptr.new" || nm_pe == "Ptr::new" {
                a0_pe = ast.aa[expr];
                if a0_pe >= 0 {
                    if ast.tags[a0_pe] == xt(XT::Arg._tag) { a0_pe = ast.aa[a0_pe]; }
                    m_pe = self.infer_expr_ty(ast, a0_pe);
                    if m_pe == -1 { m_pe = self.infer_ctor_arg(ast, a0_pe); }
                    return m_pe;
                }
            }
        }
        return -1;
    }

    /// 无类型实参的结构体字面量：按字段值推断类型参数并查实例名
    #[alloc]
    #[state]
    fn infer_literal_inst(ref mut self, ref Ast ast, int id) -> String {
        nm = ast.texts[id];
        si = self.find_struct_idx(nm);
        if si < 0 { return ""; }
        gp1 = self.struct_gparam(ast, nm);
        if gp1.len == 0 { return ""; }
        gp2 = "";
        sdef = -1;
        i2 = 0;
        while i2 < ast.len {
            if ast.tags[i2] == st(ST::StructDef._tag) && ast.texts[i2] == nm { sdef = i2; break; }
            i2 = i2 + 1;
        }
        if sdef >= 0 {
            g2 = ast.bb[sdef];
            if g2 >= 0 {
                g2 = ast.nexts[g2];
                if g2 >= 0 { gp2 = ast.texts[g2].copy(); }
            }
        }
        a1 = -1;
        a2 = -1;
        f = ast.aa[id];
        while f >= 0 {
            idx = self.find_field_idx(nm, ast.texts[f]);
            if idx >= 0 {
                fty = self.ftype_at(si, idx);
                tn = ty_name(ast, fty);
                if tn.len > 0 && tn == gp1 {
                    m = self.infer_expr_ty(ast, ast.aa[f]);
                    if m == -1 { m = self.infer_ctor_arg(ast, ast.aa[f]); }
                    if m != -1 { a1 = m; }
                } elif gp2.len > 0 && tn == gp2 {
                    m2 = self.infer_expr_ty(ast, ast.aa[f]);
                    if m2 == -1 { m2 = self.infer_ctor_arg(ast, ast.aa[f]); }
                    if m2 != -1 { a2 = m2; }
                } elif tn == "Ptr" {
                    // Ptr[T] 字段：从 Ptr.new(X) 推断 T
                    mpt = self.infer_ptr_elem(ast, ast.aa[f]);
                    if mpt != -1 {
                        fpt = self.ftype_at(si, idx);
                        inpt = ast.aa[fpt];
                        if inpt < 0 { inpt = ast.tys[fpt]; }
                        inptn = ty_name(ast, unwrap_ty(ast, inpt));
                        if inptn.len > 0 && inptn == gp1 { a1 = mpt; }
                        elif gp2.len > 0 && inptn == gp2 { a2 = mpt; }
                    }
                }
            }
            f = ast.nexts[f];
        }
        if a1 == -1 { return ""; }
        return self.find_struct_inst_name(ast, si, a1);
    }

    /// 枚举构造载荷的类型标记（静态推断 + 局部源结构体名兜底）
    #[alloc]
    #[state]
    fn infer_ctor_arg(ref mut self, ref Ast ast, int id) -> int {
        if id < 0 { return -1; }
        if ast.tags[id] == et(ET::Ref._tag) { return self.infer_ctor_arg(ast, ast.aa[id]); }
        m = self.infer_static_ty(ast, id);
        if m != -1 { return m; }
        if ast.tags[id] == et(ET::Ident._tag) {
            src = self.local_src_of(ast.texts[id]);
            if src.len > 0 { return self.marker_of_name(src); }
        }
        return -1;
    }

    /// 按形参类型结构推断 T：Box[T] 对 Box 实例取其实参节点；Box[Box[T]] 递归下沉
    #[alloc]
    #[state]
    fn infer_through(ref mut self, ref Ast ast, int pty0, int arg, ref String gp) -> int {
        pty = unwrap_ty(ast, pty0);
        if pty < 0 || arg == -1 { return -1; }
        ptn = ty_name(ast, pty);
        if ptn == gp { return arg; }
        ptag = ast.tags[pty];
        if arg >= 0 {
            // 实参为类型节点：解包后基名一致则按参数递归
            an = unwrap_ty(ast, arg);
            if an != arg { return self.infer_through(ast, pty, an, gp); }
            if ptag == tt(TT::Generic._tag) || ptag == tt(TT::Named._tag) {
                if ty_name(ast, an) == ptn {
                    return self.infer_through(ast, ast.aa[pty], ast.aa[an], gp);
                }
            }
            return -1;
        }
        if arg <= -1000 && arg > -1128 {
            // 实参为结构体值：由实例表取它的类型实参节点，匹配 pty 的参数部分
            si_a = 0 - 1000 - arg;
            nm_a = self.st_names[si_a].copy();
            k_a = 0;
            while k_a < self.inst_st_count {
                if self.inst_st_names[k_a] == nm_a {
                    if ptag == tt(TT::Generic._tag) {
                        return self.infer_through(ast, ast.aa[pty], self.inst_st_argty[k_a], gp);
                    }
                    return -1;
                }
                k_a = k_a + 1;
            }
            return -1;
        }
        return -1;
    }

    /// 无显式类型实参时推断首个类型参数（单类型参数；支持 Box[T]/Box[Box[T]] 结构匹配）
    #[alloc]
    #[state]
    fn infer_call_arg(ref mut self, ref Ast ast, int fnode, int args) -> int {
        if fnode < 0 { return -1; }
        g = ast.cc[fnode];
        if g < 0 { return -1; }
        if ast.nexts[g] >= 0 { return -1; }
        gp = ast.texts[g].copy();
        p = ast.aa[fnode];
        a = args;
        while p >= 0 && a >= 0 {
            pty = ast.tys[p];
            if pty >= 0 {
                ax = a;
                if ast.tags[ax] == xt(XT::Arg._tag) { ax = ast.aa[ax]; }
                m_arg = self.infer_expr_ty(ast, ax);
                r = -1;
                if m_arg != -1 {
                    r = self.infer_through(ast, pty, m_arg, gp);
                    if r != -1 { return r; }
                }

            }
            p = ast.nexts[p];
            a = ast.nexts[a];
        }
        return -1;
    }

    /// 自由函数类型实参推断（≤2）：结果写入 inf_arg1/inf_arg2；1=推断到任一
    #[alloc]
    #[state]
    fn infer_call_all(ref mut self, ref Ast ast, int fnode, int args) -> int {
        self.inf_arg1 = -1;
        self.inf_arg2 = -1;
        self.inf_arg3 = -1;
        self.inf_arg4 = -1;
        if fnode < 0 { return 0; }
        g1 = ast.cc[fnode];
        if g1 < 0 { return 0; }
        gp1 = ast.texts[g1].copy();
        g2 = ast.nexts[g1];
        if g2 < 0 {
            self.inf_arg1 = self.infer_call_arg(ast, fnode, args);
            if self.inf_arg1 != -1 { return 1; }
            return 0;
        }
        gp2 = ast.texts[g2].copy();
        g3 = ast.nexts[g2];
        g4 = -1;
        if g3 >= 0 { g4 = ast.nexts[g3]; }
        gp3 = "";
        gp4 = "";
        if g3 >= 0 { gp3 = ast.texts[g3].copy(); }
        if g4 >= 0 { gp4 = ast.texts[g4].copy(); }
        // 逐形参、逐类型参数匹配
        p = ast.aa[fnode];
        a = args;
        while p >= 0 && a >= 0 {
            pty = ast.tys[p];
            if pty >= 0 {
                ax = a;
                if ast.tags[ax] == xt(XT::Arg._tag) { ax = ast.aa[ax]; }
                m = self.infer_expr_ty(ast, ax);
                if m == -1 { m = self.infer_ctor_arg(ast, ax); }
                if m != -1 {
                    if self.inf_arg1 == -1 {
                        r1 = self.infer_through(ast, pty, m, gp1);
                        if r1 != -1 { self.inf_arg1 = r1; }
                    }
                    if self.inf_arg2 == -1 {
                        r2 = self.infer_through(ast, pty, m, gp2);
                        if r2 != -1 { self.inf_arg2 = r2; }
                    }
                    if g3 >= 0 && self.inf_arg3 == -1 {
                        r3 = self.infer_through(ast, pty, m, gp3);
                        if r3 != -1 { self.inf_arg3 = r3; }
                    }
                    if g4 >= 0 && self.inf_arg4 == -1 {
                        r4 = self.infer_through(ast, pty, m, gp4);
                        if r4 != -1 { self.inf_arg4 = r4; }
                    }
                }
            }
            p = ast.nexts[p];
            a = ast.nexts[a];
        }
        // 约束反推：I: It[T]（由具体 I 的实现方法返回类型统一出 T）
        if self.inf_arg1 != -1 { self.infer_bound_propagate(ast, fnode, g1, self.inf_arg1); }
        if self.inf_arg2 != -1 { self.infer_bound_propagate(ast, fnode, g2, self.inf_arg2); }
        if g3 >= 0 && self.inf_arg3 != -1 { self.infer_bound_propagate(ast, fnode, g3, self.inf_arg3); }
        if g4 >= 0 && self.inf_arg4 != -1 { self.infer_bound_propagate(ast, fnode, g4, self.inf_arg4); }
        if self.inf_arg1 != -1 || self.inf_arg2 != -1 || self.inf_arg3 != -1 || self.inf_arg4 != -1 { return 1; }
        return 0;
    }

    /// 若 gpnode 带约束 Iface[Other] 且已由具体类型推断，反推 Other 到对应槽位
    #[alloc]
    #[state]
    fn infer_bound_propagate(ref mut self, ref Ast ast, int fnode, int gpnode, int marker) -> int {
        if gpnode < 0 || marker == -1 { return 0; }
        bnd = ast.tys[gpnode];
        if bnd < 0 { return 0; }
        iname = ty_name(ast, bnd);
        if iname.len == 0 { return 0; }
        if self.find_iface_idx(iname) < 0 { return 0; }
        ifb = ast.aa[bnd];
        if ifb < 0 { ifb = ast.tys[bnd]; }
        oname = ty_name(ast, unwrap_ty(ast, ifb));
        if oname.len == 0 { return 0; }
        r = self.infer_from_bound(ast, gpnode, marker, oname);
        if r == -1 { return 0; }
        g = ast.cc[fnode];
        k = 0;
        while g >= 0 {
            if k == 0 && ast.texts[g] == oname && self.inf_arg1 == -1 { self.inf_arg1 = r; return 1; }
            if k == 1 && ast.texts[g] == oname && self.inf_arg2 == -1 { self.inf_arg2 = r; return 1; }
            if k == 2 && ast.texts[g] == oname && self.inf_arg3 == -1 { self.inf_arg3 = r; return 1; }
            if k == 3 && ast.texts[g] == oname && self.inf_arg4 == -1 { self.inf_arg4 = r; return 1; }
            g = ast.nexts[g];
            k = k + 1;
        }
        return 0;
    }

    /// 推断实参归一化：调用者特化上下文中的类型参数替换为实参；未解析的类型参数拒绝（-1）
    #[alloc]
    #[state]
    fn resolve_inf_arg(ref mut self, ref Ast ast, int t) -> int {
        if t < 0 { return t; }
        u = unwrap_ty(ast, t);
        if u < 0 { return t; }
        tg_u = ast.tags[u];
        if tg_u != tt(TT::Named._tag) && tg_u != tt(TT::Generic._tag) { return t; }
        nm = ast.texts[u].copy();
        if nm.len == 0 { return t; }
        if nm == "Self" { nm = self.cur_self_ty.copy(); }
        if self.cur_inst_param.len > 0 && nm == self.cur_inst_param && self.cur_inst_arg_ty != -1 { return self.cur_inst_arg_ty; }
        if self.cur_inst_param2.len > 0 && nm == self.cur_inst_param2 && self.cur_inst_arg_ty2 != -1 { return self.cur_inst_arg_ty2; }
        if self.cur_inst_param3.len > 0 && nm == self.cur_inst_param3 && self.cur_inst_arg_ty3 != -1 { return self.cur_inst_arg_ty3; }
        if self.cur_inst_param4.len > 0 && nm == self.cur_inst_param4 && self.cur_inst_arg_ty4 != -1 { return self.cur_inst_arg_ty4; }
        if self.type_is_gparam(ast, u) { return -1; }
        return t;
    }

    /// 从约束 `GP: Iface[Other]` 与具体类型反推 Other（impl 方法返回类型统一）
    #[alloc]
    #[state]
    fn infer_from_bound(ref mut self, ref Ast ast, int gpnode, int marker, ref String other_gp) -> int {
        if gpnode < 0 || other_gp.len == 0 { return -1; }
        bnd = ast.tys[gpnode];
        if bnd < 0 { return -1; }
        iname = ty_name(ast, bnd);
        if iname.len == 0 { return -1; }
        ii = self.find_iface_idx(iname);
        if ii < 0 { return -1; }
        ifb = ast.aa[bnd];
        if ifb < 0 { ifb = ast.tys[bnd]; }
        ifb = unwrap_ty(ast, ifb);
        if ty_name(ast, ifb) != other_gp { return -1; }
        if !(marker <= -1000 && marker > -1128) { return -1; }
        si = 0 - 1000 - marker;
        if si < 0 || si >= self.st_count { return -1; }
        sname = self.st_names[si].copy();
        ms = self.if_mstart[ii];
        mn = self.if_mcount[ii];
        k = 0;
        while k < mn {
            mname = self.if_mnames[ms + k].copy();
            imid = self.find_method_id(sname, mname);
            if imid >= 0 {
                irt = self.method_ret_type(sname, mname);
                frt = -1;
                mnode = self.if_mnode[ms + k];
                if mnode >= 0 { frt = ast.tys[mnode]; }
                if irt >= 0 && frt >= 0 {
                    in_i = unwrap_ty(ast, irt);
                    in_f = unwrap_ty(ast, frt);
                    if in_i >= 0 && in_f >= 0 {
                        if ty_name(ast, in_f) == other_gp { return in_i; }
                        if ty_name(ast, in_i).len > 0 && ty_name(ast, in_i) == ty_name(ast, in_f) {
                            fa = ast.aa[in_f];
                            if fa < 0 { fa = ast.tys[in_f]; }
                            ia = ast.aa[in_i];
                            if ia < 0 { ia = ast.tys[in_i]; }
                            if ty_name(ast, unwrap_ty(ast, fa)) == other_gp {
                                return unwrap_ty(ast, ia);
                            }
                        }
                    }
                }
            }
            k = k + 1;
        }
        return -1;
    }

    /// impl 块的类型参数名（方法的泛型参数在 ImplBlock 上）
    #[alloc]
    fn impl_gparam(ref mut self, ref Ast ast, ref String prefix) -> String {
        si_p = 0;
        while si_p < ast.len {
            if ast.tags[si_p] == st(ST::ImplBlock._tag) {
                if ast.texts[si_p] == prefix {
                    gg = ast.bb[si_p];
                    if gg >= 0 { return ast.texts[gg].copy(); }
                    return "";
                }
            }
            si_p = si_p + 1;
        }
        return "";
    }

    /// 双类型参数替换的返回种类
    fn ret_kind_with2(ref mut self, ref Ast ast, int rty, ref String p1, int a1, ref String p2, int a2) -> int {
        o1 = self.cur_inst_param.copy();
        oa1 = self.cur_inst_arg_ty;
        o2 = self.cur_inst_param2.copy();
        oa2 = self.cur_inst_arg_ty2;
        self.cur_inst_param = p1.copy();
        self.cur_inst_arg_ty = a1;
        self.cur_inst_param2 = p2.copy();
        self.cur_inst_arg_ty2 = a2;
        r = self.ret_kind(ast, rty);
        self.cur_inst_param = o1.copy();
        self.cur_inst_arg_ty = oa1;
        self.cur_inst_param2 = o2.copy();
        self.cur_inst_arg_ty2 = oa2;
        return r;
    }

    /// 带类型参数替换的返回种类（调用点：方法特化）
    fn ret_kind_with(ref mut self, ref Ast ast, int rty, ref String pname, int arg_ty) -> int {
        if pname.len == 0 || arg_ty == -1 { return self.ret_kind(ast, rty); }
        op = self.cur_inst_param.copy();
        oa = self.cur_inst_arg_ty;
        self.cur_inst_param = pname.copy();
        self.cur_inst_arg_ty = arg_ty;
        r = self.ret_kind(ast, rty);
        self.cur_inst_param = op.copy();
        self.cur_inst_arg_ty = oa;
        return r;
    }

    /// impl 块的第二个类型参数名
    #[alloc]
    fn impl_gparam2(ref mut self, ref Ast ast, ref String prefix) -> String {
        si_p = 0;
        while si_p < ast.len {
            if ast.tags[si_p] == st(ST::ImplBlock._tag) {
                if ast.texts[si_p] == prefix {
                    gg = ast.bb[si_p];
                    if gg >= 0 {
                        gg = ast.nexts[gg];
                        if gg >= 0 { return ast.texts[gg].copy(); }
                    }
                    return "";
                }
            }
            si_p = si_p + 1;
        }
        return "";
    }

    /// 3tq：按 (源结构体下标, 实参类型节点) 查实例结构体名（节点 id 优先，类型名兜底）
    #[alloc]
    fn find_struct_inst_name(ref mut self, ref Ast ast, int si_src, int arg_ty) -> String {
        i = 0;
        while i < self.inst_st_count {
            if self.inst_st_src[i] == si_src && self.inst_st_argty[i] == arg_ty {
                return self.inst_st_names[i].copy();
            }
            i = i + 1;
        }
        an = self.type_arg_name(ast, arg_ty);
        if an.len == 0 { return ""; }
        i = 0;
        while i < self.inst_st_count {
            if self.inst_st_src[i] == si_src {
                if self.type_arg_name(ast, self.inst_st_argty[i]) == an {
                    return self.inst_st_names[i].copy();
                }
            }
            i = i + 1;
        }
        return "";
    }

    /// 3tq：登记特化（按 (FnDecl, 实参类型) 去重），返回 worklist 下标
    #[alloc]
    #[state]
    fn spec_register(ref mut self, ref Ast ast, int node, ref String prefix, int arg_ty, ref String self_ty) -> int {
        return self.spec_register2(ast, node, prefix, arg_ty, -1, self_ty);
    }

    /// 双类型实参特化登记
    #[alloc]
    #[state]
    fn spec_register2(ref mut self, ref Ast ast, int node, ref String prefix, int arg_ty, int arg_ty2, ref String self_ty) -> int {
        return self.spec_register4(ast, node, prefix, arg_ty, arg_ty2, -1, -1, self_ty);
    }

    /// 最多四类型实参特化登记（ZipIt[T,U,I,J] 等）
    #[alloc]
    #[state]
    fn spec_register4(ref mut self, ref Ast ast, int node, ref String prefix, int a1, int a2, int a3, int a4, ref String self_ty) -> int {
        if node < 0 || a1 == -1 { return -1; }
        i = 0;
        while i < self.spec_count {
            if self.spec_nodes[i] == node && self.spec_args[i] == a1 && self.spec_args2[i] == a2 && self.spec_args3[i] == a3 && self.spec_args4[i] == a4 { return i; }
            i = i + 1;
        }
        if self.spec_count >= 256 { return -1; }
        p1 = "";
        p2 = "";
        p3 = "";
        p4 = "";
        g = ast.cc[node];
        if g >= 0 {
            p1 = ast.texts[g].copy();
            g2 = ast.nexts[g];
            if g2 >= 0 {
                p2 = ast.texts[g2].copy();
                g3 = ast.nexts[g2];
                if g3 >= 0 {
                    p3 = ast.texts[g3].copy();
                    g4 = ast.nexts[g3];
                    if g4 >= 0 { p4 = ast.texts[g4].copy(); }
                }
            }
        }
        if prefix.len > 0 {
            if p1.len == 0 { p1 = self.impl_gparam_n(ast, prefix, 0); }
            if p2.len == 0 { p2 = self.impl_gparam_n(ast, prefix, 1); }
            if p3.len == 0 { p3 = self.impl_gparam_n(ast, prefix, 2); }
            if p4.len == 0 { p4 = self.impl_gparam_n(ast, prefix, 3); }
        }
        self.spec_nodes[self.spec_count] = node;
        self.spec_prefixes[self.spec_count] = prefix.copy();
        self.spec_params[self.spec_count] = p1;
        self.spec_args[self.spec_count] = a1;
        self.spec_args2[self.spec_count] = a2;
        self.spec_params2[self.spec_count] = p2;
        self.spec_params3[self.spec_count] = p3;
        self.spec_args3[self.spec_count] = a3;
        self.spec_params4[self.spec_count] = p4;
        self.spec_args4[self.spec_count] = a4;
        self.spec_selfs[self.spec_count] = self_ty.copy();
        ord = self.spec_count;
        self.spec_count = self.spec_count + 1;
        return ord;
    }

    /// impl 块第 n 个类型参数名（0 起，无 -> ""）
    #[alloc]
    fn impl_gparam_n(ref mut self, ref Ast ast, ref String prefix, int idx) -> String {
        si_p = 0;
        while si_p < ast.len {
            if ast.tags[si_p] == st(ST::ImplBlock._tag) {
                if ast.texts[si_p] == prefix {
                    gg = ast.bb[si_p];
                    k = 0;
                    while gg >= 0 {
                        if k == idx { return ast.texts[gg].copy(); }
                        gg = ast.nexts[gg];
                        k = k + 1;
                    }
                    return "";
                }
            }
            si_p = si_p + 1;
        }
        return "";
    }

    /// 3tq：发射全部特化（worklist 动态增长，处理传递闭包）
    #[alloc]
    #[state]
    fn emit_specializations(ref mut self, ref Ast ast) {
        wi = 0;
        while wi < self.spec_count {
            self.cur_inst_param = self.spec_params[wi].copy();
            self.cur_inst_arg_ty = self.spec_args[wi];
            self.cur_inst_param2 = self.spec_params2[wi].copy();
            self.cur_inst_arg_ty2 = self.spec_args2[wi];
            self.cur_inst_param3 = self.spec_params3[wi].copy();
            self.cur_inst_arg_ty3 = self.spec_args3[wi];
            self.cur_inst_param4 = self.spec_params4[wi].copy();
            self.cur_inst_arg_ty4 = self.spec_args4[wi];
            self.cur_inst_ord = wi;
            self.cur_inst_struct = self.spec_selfs[wi].copy();
            nfull = self.spec_prefixes[wi].copy();
            fnm_w = ast.texts[self.spec_nodes[wi]].copy();
            if nfull.len > 0 {
                nfull = nfull + ".";
                nfull = nfull + fnm_w;
            } else {
                nfull = fnm_w;
            }
            self.cur_ord = self.fn_idx_of_node(nfull, self.spec_nodes[wi]);
            emit_fn_named(ast, self.spec_nodes[wi], self.spec_prefixes[wi], self);
            wi = wi + 1;
        }
        self.cur_inst_param = "";
        self.cur_inst_arg_ty = -1;
        self.cur_inst_param2 = "";
        self.cur_inst_arg_ty2 = -1;
        self.cur_inst_param3 = "";
        self.cur_inst_arg_ty3 = -1;
        self.cur_inst_param4 = "";
        self.cur_inst_arg_ty4 = -1;
        self.cur_inst_ord = -1;
        self.cur_inst_struct = "";
    }

    /// 注册字符串字面量，返回全局名与长度（存入 strs）
    #[alloc]
    #[state]
    fn add_str(ref mut self, ref String text) -> int {
        idx = self.str_count;
        if idx < 8192 {
            self.strs[idx] = text.copy();
            self.str_count = idx + 1;
        }
        return idx;
    }
}

/// LLVM c"..." 转义（UTF-8 字节）
fn escape_ir(ref String s) -> String {
    b = StringBuf::new();
    i = 0;
    while i < s.len as int {
        c = char_code(s.index(i as usize));
        if c == 34 {
            b.push_str("\\22");
        } elif c == 92 {
            b.push_str("\\5c");
        } elif c == 10 {
            b.push_str("\\0a");
        } elif c == 13 {
            b.push_str("\\0d");
        } elif c == 9 {
            b.push_str("\\09");
        } elif c >= 32 && c <= 126 {
            b.push(c as char);
        } else {
            b.push_str("\\");
            h = c / 16;
            l = c % 16;
            b.push(hex_digit(h));
            b.push(hex_digit(l));
        }
        i = i + 1;
    }
    return b.to_string();
}

fn hex_digit(int v) -> char {
    if v < 10 { return (48 + v) as char; }
    return (87 + v) as char;
}

fn bin_llvm_op(int op) -> String {
    if op == bo(BinOp::Add._tag) { return "add"; }
    if op == bo(BinOp::Sub._tag) { return "sub"; }
    if op == bo(BinOp::Mul._tag) { return "mul"; }
    if op == bo(BinOp::Div._tag) { return "sdiv"; }
    if op == bo(BinOp::Mod._tag) { return "srem"; }
    if op == bo(BinOp::BitAnd._tag) { return "and"; }
    if op == bo(BinOp::BitOr._tag) { return "or"; }
    if op == bo(BinOp::BitXor._tag) { return "xor"; }
    if op == bo(BinOp::Shl._tag) { return "shl"; }
    if op == bo(BinOp::Shr._tag) { return "ashr"; }
    return "";
}

/// 运算符 -> 重载方法名（对应 rust binary_op_to_fn_name）
fn op_method_name(int op) -> String {
    if op == bo(BinOp::Add._tag) { return "add"; }
    if op == bo(BinOp::Sub._tag) { return "sub"; }
    if op == bo(BinOp::Mul._tag) { return "mul"; }
    if op == bo(BinOp::Div._tag) { return "div"; }
    if op == bo(BinOp::Mod._tag) { return "rem"; }
    if op == bo(BinOp::Eq._tag) { return "eq"; }
    if op == bo(BinOp::Neq._tag) { return "ne"; }
    if op == bo(BinOp::Lt._tag) { return "lt"; }
    if op == bo(BinOp::Gt._tag) { return "gt"; }
    if op == bo(BinOp::Le._tag) { return "le"; }
    if op == bo(BinOp::Ge._tag) { return "ge"; }
    if op == bo(BinOp::BitAnd._tag) { return "bitand"; }
    if op == bo(BinOp::BitOr._tag) { return "bitor"; }
    if op == bo(BinOp::BitXor._tag) { return "bitxor"; }
    if op == bo(BinOp::Shl._tag) { return "shl"; }
    if op == bo(BinOp::Shr._tag) { return "shr"; }
    return "";
}

/// 运算符重载：obj OP arg -> Type.method(obj, arg) 直接调用
#[alloc]
fn emit_op_method_call(ref Ast ast, int id, ref Val lt, ref String mn, int mid, ref mut Emitter e) -> Val {
    mname = lt.b + "." + mn;
    rty_m = ast.tys[mid];
    rk_m = e.ret_kind(ast, rty_m);
    b = StringBuf::new();
    b.push_str("  ");
    t = e.fresh();
    b.push_str(t);
    if rk_m == 1 {
        b.push_str(" = call { ptr, i64 } ");
    } elif rk_m == 5 {
        b.push_str(" = call double ");
    } else {
        b.push_str(" = call i64 ");
    }
    b.push_str("@");
    b.push_str(e.fn_sym(mname));
    b.push_str("(ptr ");
    b.push_str(lt.a);
    at = emit_expr(ast, ast.bb[id], e);
    pk = e.fn_param_kind(mname, 0);
    if pk == 1 {
        b.push_str(", ptr ");
        b.push_str(at.a);
        b.push_str(", i64 ");
        b.push_str(at.b);
    } elif pk == 31 {
        b.push_str(", double ");
        b.push_str(at.a);
    } elif pk == 0 {
        b.push_str(", i64 ");
        b.push_str(at.a);
    } else {
        b.push_str(", ptr ");
        b.push_str(at.a);
    }
    b.push_str(")\n");
    e.buf.push_str(b.to_string());
    if rk_m == 1 {
        ip = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(ip);
        e.buf.push_str(" = extractvalue { ptr, i64 } ");
        e.buf.push_str(t);
        e.buf.push_str(", 0\n  ");
        il = e.fresh();
        e.buf.push_str(il);
        e.buf.push_str(" = extractvalue { ptr, i64 } ");
        e.buf.push_str(t);
        e.buf.push_str(", 1\n");
        return mk_str_tmp(ip, il);
    }
    if rk_m == 5 { return mk_float(t); }
    if rk_m == 2 {
        pi = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(pi);
        e.buf.push_str(" = inttoptr i64 ");
        e.buf.push_str(t);
        e.buf.push_str(" to ptr\n");
        return Val { kind = 2, a = pi, b = ty_name(ast, rty_m).copy(), ty = -1 };
    }
    if rk_m == 4 {
        pi2 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(pi2);
        e.buf.push_str(" = inttoptr i64 ");
        e.buf.push_str(t);
        e.buf.push_str(" to ptr\n");
        return Val { kind = 4, a = pi2, b = ty_name(ast, rty_m).copy(), ty = -1 };
    }
    if rk_m == 3 {
        pi3 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(pi3);
        e.buf.push_str(" = inttoptr i64 ");
        e.buf.push_str(t);
        e.buf.push_str(" to ptr\n");
        return mk_arr(pi3, e.ret_info(ast, rty_m));
    }
    return mk_int(t);
}

/// UFCS 回退：同名自由函数且首参类型名 == recv_ty
#[alloc]
fn find_fn_by_recv(ref mut Emitter e, ref Ast ast, ref String name, ref String recv_ty) -> int {
    i = 0;
    while i < e.fn_count {
        if e.fn_names[i] == name {
            fid = e.fn_first[i];
            if fid >= 0 {
                p0 = ast.aa[fid];
                if p0 >= 0 {
                    pn = ty_name(ast, ast.tys[p0]);
                    if pn == recv_ty { return i; }
                }
            }
        }
        i = i + 1;
    }
    return -1;
}

/// UFCS 调用：自由函数（接收者作首参）
#[alloc]
#[state]
fn emit_ufcs_call(ref Ast ast, int id, ref Val obj, ref String name, ref mut Emitter e) -> Val {
    full = name.copy();
    mrty = e.fn_ret_type(full);
    rk_m = e.ret_kind(ast, mrty);
    b = StringBuf::new();
    b.push_str("  ");
    t = e.fresh();
    b.push_str(t);
    if rk_m == 5 {
        b.push_str(" = call double @");
    } elif rk_m == 1 {
        b.push_str(" = call { ptr, i64 } @");
    } else {
        b.push_str(" = call i64 @");
    }
    b.push_str(e.fn_sym_ord(full, e.fn_idx_of_node(full, e.fn_first_id(full))));
    pkc = e.fn_param_kind(full, 0);
    if pkc == 0 {
        b.push_str("(i64 ");
        b.push_str(obj.a);
    } elif pkc == 30 {
        tp0 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(tp0);
        e.buf.push_str(" = alloca i64\n  store i64 ");
        e.buf.push_str(obj.a);
        e.buf.push_str(", ptr ");
        e.buf.push_str(tp0);
        e.buf.push_str("\n");
        b.push_str("(ptr ");
        b.push_str(tp0);
    } elif pkc == 31 {
        b.push_str("(double ");
        b.push_str(float_operand(obj, e));
    } else {
        b.push_str("(ptr ");
        b.push_str(obj.a);
    }
    a3 = ast.bb[id];
    ak3 = 1;
    while a3 >= 0 {
        at3 = emit_expr(ast, ast.aa[a3], e);
        pk3 = e.fn_param_kind(full, ak3);
        if pk3 == 31 {
            b.push_str(", double ");
            b.push_str(float_operand(at3, e));
        } elif pk3 == 30 {
            a_r4 = ast.aa[a3];
            if ast.tags[a_r4] == xt(XT::Arg._tag) { a_r4 = ast.aa[a_r4]; }
            b.push_str(", ptr ");
            b.push_str(addr_of_arg(ast, a_r4, e));
        } elif pk3 == 0 {
            b.push_str(", i64 ");
            b.push_str(at3.a);
        } elif pk3 == 1 {
            b.push_str(", ptr ");
            b.push_str(at3.a);
            b.push_str(", i64 ");
            b.push_str(at3.b);
        } elif pk3 == 21 {
            ii_p3u = e.fn_piface_of(full, ak3);
            if ii_p3u > 0 && at3.kind != 21 {
                in_p3u = e.if_names[ii_p3u - 1].copy();
                b.push_str(", ptr ");
                b.push_str(e.emit_box(at3, in_p3u));
            } else {
                b.push_str(", ptr ");
                b.push_str(at3.a);
            }
        } else {
            b.push_str(", ptr ");
            b.push_str(at3.a);
        }
        ak3 = ak3 + 1;
        a3 = ast.nexts[a3];
    }
    b.push_str(e.implicit_args_m(ast, id, e.fn_first_id(full), ak3, 0));
    b.push_str(")\n");
    e.buf.push_str(b.to_string());
    if rk_m == 5 { return mk_float(t); }
    if rk_m == 1 {
        p6 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(p6);
        e.buf.push_str(" = extractvalue { ptr, i64 } ");
        e.buf.push_str(t);
        e.buf.push_str(", 0\n  ");
        l6 = e.fresh();
        e.buf.push_str(l6);
        e.buf.push_str(" = extractvalue { ptr, i64 } ");
        e.buf.push_str(t);
        e.buf.push_str(", 1\n");
        return mk_str_tmp(p6, l6);
    }
    if rk_m == 2 {
        rinfo3 = e.ret_info(ast, mrty);
        rnm3 = "";
        if rinfo3 >= 0 { rnm3 = e.st_names[rinfo3].copy(); }
        pi5 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(pi5);
        e.buf.push_str(" = inttoptr i64 ");
        e.buf.push_str(t);
        e.buf.push_str(" to ptr\n");
        return Val { kind = 2, a = pi5, b = rnm3, ty = -1 };
    }
    if rk_m == 4 {
        rinfo4 = e.ret_info(ast, mrty);
        rnm4 = "";
        if rinfo4 >= 0 { rnm4 = e.en_names[rinfo4].copy(); }
        pi6 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(pi6);
        e.buf.push_str(" = inttoptr i64 ");
        e.buf.push_str(t);
        e.buf.push_str(" to ptr\n");
        return Val { kind = 4, a = pi6, b = rnm4, ty = -1 };
    }
    if rk_m == 6 {
        rinfo6 = e.ret_info(ast, mrty);
        rnm6 = "";
        if rinfo6 >= 0 { rnm6 = e.if_names[rinfo6].copy(); }
        pi6b = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(pi6b);
        e.buf.push_str(" = inttoptr i64 ");
        e.buf.push_str(t);
        e.buf.push_str(" to ptr\n");
        return Val { kind = 21, a = pi6b, b = rnm6, ty = -1 };
    }
    if rk_m == 3 {
        pi7 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(pi7);
        e.buf.push_str(" = inttoptr i64 ");
        e.buf.push_str(t);
        e.buf.push_str(" to ptr\n");
        return mk_arr(pi7, e.ret_info(ast, mrty));
    }
    return mk_int(t);
}

/// for-in 的 next() 调用（无参）：结构体/枚举静态、接口 vtable
#[alloc]
#[state]
fn emit_forin_next(ref Ast ast, ref String it_nm, int it_kind, ref String it_ty, ref mut Emitter e) -> Val {
    if it_kind == 21 {
        ii = e.find_iface_idx(it_ty);
        mi = e.iface_method_idx(ii, "next");
        if ii < 0 || mi < 0 { return mk_int("0"); }
        rv = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(rv);
        e.buf.push_str(" = load ptr, ptr %v_");
        e.buf.push_str(it_nm);
        e.buf.push_str(".p\n");
        obj = Val { kind = 21, a = rv, b = it_ty.copy(), ty = -1 };
        return emit_iface_dispatch(ast, -1, obj, ii, mi, e);
    }
    // 结构体实例接收者：剥离 __m<k>，按源类型找 next 并特化
    it_src = it_ty.copy();
    inst_arg_f = -1;
    usp_f = it_src.index_of("__m");
    if usp_f > 0 {
        it_src = it_src.substring(0 as usize, usp_f as usize);
        kf = 0;
        while kf < e.inst_st_count {
            if e.inst_st_names[kf] == it_ty {
                inst_arg_f = e.inst_st_argty[kf];
                break;
            }
            kf = kf + 1;
        }
    }
    mid = e.find_method_id(it_src, "next");
    if mid < 0 { return mk_int("0"); }
    mrty = e.method_ret_type(it_src, "next");
    spec_f = -1;
    if inst_arg_f >= 0 {
        spec_f = e.spec_register(ast, mid, it_src, inst_arg_f, it_ty.copy());
    }
    rk = e.ret_kind(ast, mrty);
    if spec_f >= 0 {
        gpf = e.impl_gparam(ast, it_src);
        if gpf.len > 0 {
            rk = e.ret_kind_with(ast, mrty, gpf, inst_arg_f);
            if ty_name(ast, mrty) == gpf { mrty = inst_arg_f; }
        }
    }
    rv0 = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(rv0);
    e.buf.push_str(" = load ptr, ptr %v_");
    e.buf.push_str(it_nm);
    e.buf.push_str(".p\n");
    t = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(t);
    if rk == 5 {
        e.buf.push_str(" = call double @");
    } elif rk == 1 {
        e.buf.push_str(" = call { ptr, i64 } @");
    } else {
        e.buf.push_str(" = call i64 @");
    }
    full = it_src + ".next";
    e.buf.push_str(e.fn_sym_ord(full, e.fn_idx_of_node(full, e.fn_first_id(full))));
    if spec_f >= 0 {
        e.buf.push_str(".__i");
        e.buf.push_int(spec_f);
    }
    e.buf.push_str("(ptr ");
    e.buf.push_str(rv0);
    e.buf.push_str(")\n");
    if rk == 5 { return mk_float(t); }
    if rk == 1 {
        ip = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(ip);
        e.buf.push_str(" = extractvalue { ptr, i64 } ");
        e.buf.push_str(t);
        e.buf.push_str(", 0\n  ");
        il = e.fresh();
        e.buf.push_str(il);
        e.buf.push_str(" = extractvalue { ptr, i64 } ");
        e.buf.push_str(t);
        e.buf.push_str(", 1\n");
        return mk_str_tmp(ip, il);
    }
    if rk == 2 || rk == 4 || rk == 6 {
        rinfo = e.ret_info(ast, mrty);
        rnm = "";
        if rk == 2 {
            if rinfo >= 0 { rnm = e.st_names[rinfo].copy(); }
        } elif rk == 4 {
            if rinfo >= 0 { rnm = e.en_names[rinfo].copy(); }
        } else {
            if rinfo >= 0 { rnm = e.if_names[rinfo].copy(); }
        }
        pi = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(pi);
        e.buf.push_str(" = inttoptr i64 ");
        e.buf.push_str(t);
        e.buf.push_str(" to ptr\n");
        if rk == 2 { return Val { kind = 2, a = pi, b = rnm, ty = -1 }; }
        if rk == 4 { return Val { kind = 4, a = pi, b = rnm, ty = -1 }; }
        return Val { kind = 21, a = pi, b = rnm, ty = -1 };
    }
    if rk == 3 {
        pi3 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(pi3);
        e.buf.push_str(" = inttoptr i64 ");
        e.buf.push_str(t);
        e.buf.push_str(" to ptr\n");
        return mk_arr(pi3, e.ret_info(ast, mrty));
    }
    return mk_int(t);
}

/// 变体第 0 个载荷（for-in 的 Some / ? 的 Ok）
#[alloc]
#[state]
fn emit_variant_payload(ref Ast ast, ref String opt_a, ref String en_name, ref String variant, ref mut Emitter e) -> Val {
    ei = e.find_enum_idx(en_name);
    if ei < 0 { return mk_int("0"); }
    vi = e.find_variant_idx(ei, variant);
    if vi < 0 { return mk_int("0"); }
    sl = e.payload_slot(ast, ei, vi, 0);
    pty = e.variant_ptype(ei, vi, 0);
    g = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(g);
    e.buf.push_str(" = getelementptr %enum.");
    e.buf.push_str(en_name);
    e.buf.push_str(", ptr ");
    e.buf.push_str(opt_a);
    e.buf.push_str(", i32 0, i32 ");
    e.buf.push_int(sl);
    e.buf.push_str("\n");
    tn = ty_name(ast, pty);
    if tn == "String" {
        vp = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(vp);
        e.buf.push_str(" = load ptr, ptr ");
        e.buf.push_str(g);
        e.buf.push_str("\n  ");
        gl = e.fresh();
        e.buf.push_str(gl);
        e.buf.push_str(" = getelementptr %enum.");
        e.buf.push_str(en_name);
        e.buf.push_str(", ptr ");
        e.buf.push_str(opt_a);
        e.buf.push_str(", i32 0, i32 ");
        e.buf.push_int(sl + 1);
        e.buf.push_str("\n  ");
        vl = e.fresh();
        e.buf.push_str(vl);
        e.buf.push_str(" = load i64, ptr ");
        e.buf.push_str(gl);
        e.buf.push_str("\n");
        return mk_str_tmp(vp, vl);
    }
    si_p = e.find_struct_idx(tn);
    ei_p = e.find_enum_idx(tn);
    ii_p = e.find_iface_idx(tn);
    if tn.len > 0 {
        if si_p >= 0 || ei_p >= 0 || ii_p >= 0 {
            iq = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(iq);
            e.buf.push_str(" = load i64, ptr ");
            e.buf.push_str(g);
            e.buf.push_str("\n  ");
            qp = e.fresh();
            e.buf.push_str(qp);
            e.buf.push_str(" = inttoptr i64 ");
            e.buf.push_str(iq);
            e.buf.push_str(" to ptr\n");
            if ii_p >= 0 { return Val { kind = 21, a = qp, b = tn.copy(), ty = -1 }; }
            if si_p >= 0 { return Val { kind = 2, a = qp, b = tn.copy(), ty = -1 }; }
            return Val { kind = 4, a = qp, b = tn.copy(), ty = -1 };
        }
    }
    vi2 = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(vi2);
    e.buf.push_str(" = load i64, ptr ");
    e.buf.push_str(g);
    e.buf.push_str("\n");
    return mk_int(vi2);
}

/// 接口方法 vtable 动态派发：box = {data, vtable}
#[alloc]
#[state]
fn emit_iface_dispatch(ref Ast ast, int args_head, ref Val obj, int ii, int mi, ref mut Emitter e) -> Val {
    mnode = e.iface_method_node_at(ii, mi);
    mrty = -1;
    if mnode >= 0 { mrty = ast.tys[mnode]; }
    rk_m = e.ret_kind(ast, mrty);
    dt = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(dt);
    e.buf.push_str(" = load ptr, ptr ");
    e.buf.push_str(obj.a);
    e.buf.push_str("\n  ");
    vt = e.fresh();
    e.buf.push_str(vt);
    e.buf.push_str(" = getelementptr i8, ptr ");
    e.buf.push_str(obj.a);
    e.buf.push_str(", i64 8\n  ");
    vtl = e.fresh();
    e.buf.push_str(vtl);
    e.buf.push_str(" = load ptr, ptr ");
    e.buf.push_str(vt);
    e.buf.push_str("\n  ");
    sl = e.fresh();
    e.buf.push_str(sl);
    e.buf.push_str(" = getelementptr i8, ptr ");
    e.buf.push_str(vtl);
    e.buf.push_str(", i64 ");
    e.buf.push_int(mi * 8);
    e.buf.push_str("\n  ");
    fp = e.fresh();
    e.buf.push_str(fp);
    e.buf.push_str(" = load ptr, ptr ");
    e.buf.push_str(sl);
    e.buf.push_str("\n");
    b = StringBuf::new();
    b.push_str("  ");
    t5 = e.fresh();
    b.push_str(t5);
    if rk_m == 5 {
        b.push_str(" = call double ");
    } elif rk_m == 1 {
        b.push_str(" = call { ptr, i64 } ");
    } else {
        b.push_str(" = call i64 ");
    }
    b.push_str(fp);
    b.push_str("(ptr ");
    b.push_str(dt);
    a3 = args_head;
    ak3 = 1;
    while a3 >= 0 {
        at3 = emit_expr(ast, ast.aa[a3], e);
        pk4 = e.iface_param_kind(ast, mnode, ak3);
        if pk4 == 31 {
            b.push_str(", double ");
            b.push_str(float_operand(at3, e));
        } elif pk4 == 30 {
            a_r5 = ast.aa[a3];
            if ast.tags[a_r5] == xt(XT::Arg._tag) { a_r5 = ast.aa[a_r5]; }
            b.push_str(", ptr ");
            b.push_str(addr_of_arg(ast, a_r5, e));
        } elif pk4 == 0 {
            b.push_str(", i64 ");
            b.push_str(at3.a);
        } elif pk4 == 1 {
            b.push_str(", ptr ");
            b.push_str(at3.a);
            b.push_str(", i64 ");
            b.push_str(at3.b);
        } elif pk4 == 21 {
            b.push_str(", ptr ");
            if at3.kind == 21 {
                b.push_str(at3.a);
            } else {
                pn4 = e.iface_param_name(ast, mnode, ak3);
                b.push_str(e.emit_box(at3, pn4));
            }
        } else {
            b.push_str(", ptr ");
            b.push_str(at3.a);
        }
        ak3 = ak3 + 1;
        a3 = ast.nexts[a3];
    }
    b.push_str(e.implicit_args_m(ast, -1, mnode, ak3, 0));
    b.push_str(")\n");
    e.buf.push_str(b.to_string());
    if rk_m == 5 { return mk_float(t5); }
    if rk_m == 1 {
        p6 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(p6);
        e.buf.push_str(" = extractvalue { ptr, i64 } ");
        e.buf.push_str(t5);
        e.buf.push_str(", 0\n  ");
        l6 = e.fresh();
        e.buf.push_str(l6);
        e.buf.push_str(" = extractvalue { ptr, i64 } ");
        e.buf.push_str(t5);
        e.buf.push_str(", 1\n");
        return mk_str_tmp(p6, l6);
    }
    if rk_m == 2 {
        rinfo3 = e.ret_info(ast, mrty);
        rnm3 = "";
        if rinfo3 >= 0 { rnm3 = e.st_names[rinfo3].copy(); }
        pi5 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(pi5);
        e.buf.push_str(" = inttoptr i64 ");
        e.buf.push_str(t5);
        e.buf.push_str(" to ptr\n");
        return Val { kind = 2, a = pi5, b = rnm3, ty = -1 };
    }
    if rk_m == 4 {
        rinfo4 = e.ret_info(ast, mrty);
        rnm4 = "";
        if rinfo4 >= 0 { rnm4 = e.en_names[rinfo4].copy(); }
        pi6 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(pi6);
        e.buf.push_str(" = inttoptr i64 ");
        e.buf.push_str(t5);
        e.buf.push_str(" to ptr\n");
        return Val { kind = 4, a = pi6, b = rnm4, ty = -1 };
    }
    if rk_m == 6 {
        rinfo6 = e.ret_info(ast, mrty);
        rnm6 = "";
        if rinfo6 >= 0 { rnm6 = e.if_names[rinfo6].copy(); }
        pi7b = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(pi7b);
        e.buf.push_str(" = inttoptr i64 ");
        e.buf.push_str(t5);
        e.buf.push_str(" to ptr\n");
        return Val { kind = 21, a = pi7b, b = rnm6, ty = -1 };
    }
    if rk_m == 3 {
        pi7 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(pi7);
        e.buf.push_str(" = inttoptr i64 ");
        e.buf.push_str(t5);
        e.buf.push_str(" to ptr\n");
        return mk_arr(pi7, e.ret_info(ast, mrty));
    }
    return mk_int(t5);
}

fn cmp_llvm_op(int op) -> String {
    if op == bo(BinOp::Eq._tag) { return "eq"; }
    if op == bo(BinOp::Neq._tag) { return "ne"; }
    if op == bo(BinOp::Lt._tag) { return "slt"; }
    if op == bo(BinOp::Gt._tag) { return "sgt"; }
    if op == bo(BinOp::Le._tag) { return "sle"; }
    if op == bo(BinOp::Ge._tag) { return "sge"; }
    return "";
}

fn is_cmp(int op) -> bool {
    if op == bo(BinOp::Eq._tag) { return true; }
    if op == bo(BinOp::Neq._tag) { return true; }
    if op == bo(BinOp::Lt._tag) { return true; }
    if op == bo(BinOp::Gt._tag) { return true; }
    if op == bo(BinOp::Le._tag) { return true; }
    if op == bo(BinOp::Ge._tag) { return true; }
    return false;
}

/// 数组元素槽布局：统一 8 字节槽（String/结构体为 {ptr, i64} → 16 字节）
/// 内建哨兵：2000 = String（ptr 槽，16 字节）、2001 = float（double 槽）
fn elem_slot(ref Ast ast, int ty) -> String {
    // 合成 id（负值，避免与真实 AST 节点 id 冲突）
    if ty <= -1000 && ty > -1128 { return "ptr"; }
    if ty <= -2000 && ty > -2128 { return "ptr"; }
    if ty == 2000 { return "ptr"; }
    if ty == 2001 { return "double"; }
    if ty == 2002 { return "i8"; }
    if ty == -4001 { return "i64"; }
    if ty == -4002 { return "i64"; }
    if ty == -4003 { return "ptr"; }
    if ty == -4004 { return "double"; }
    if ty == -4005 { return "i8"; }
    if ty == -4006 { return "i64"; }
    if ty < 0 { return "i64"; }
    t = ast.tags[ty];
    if t == tt(TT::Char._tag) { return "i8"; }
    if t == tt(TT::Float._tag) { return "double"; }
    if t == tt(TT::Named._tag) { return "ptr"; }
    if t == tt(TT::Array._tag) { return "ptr"; }
    if t == tt(TT::ArraySized._tag) { return "ptr"; }
    if t == tt(TT::Unique._tag) { return "ptr"; }
    if t == tt(TT::Ref._tag) { return "ptr"; }
    if t == tt(TT::FnPtr._tag) { return "i64"; }
    if t == tt(TT::Closure._tag) { return "i64"; }
    return "i64";
}

/// 槽的 LLVM 类型（getelementptr / store 用）
fn elem_llvm(ref Ast ast, int ty) -> String {
    return elem_slot(ast, ty);
}

/// 槽字节数（malloc 分配用）
fn elem_bytes(ref Ast ast, int ty) -> int {
    // 必须与 elem_stride 一致（String 元素 16 字节）
    if elem_is_string(ast, ty) { return 16; }
    if ty == 2002 { return 1; }
    if elem_slot(ast, ty) == "i8" { return 1; }
    return 8;
}

/// 元素字节跨度（String 元素 16 字节：ptr + len）
fn elem_stride(ref Ast ast, int ety) -> int {
    if elem_is_string(ast, ety) { return 16; }
    if ety == 2002 { return 1; }
    if ety >= 0 {
        if elem_slot(ast, ety) == "i8" { return 1; }
    }
    return 8;
}

/// 向上对齐（a 为 2 的幂或一般正整数）
fn align_up(int x, int a) -> int {
    if a <= 1 { return x; }
    return (x + a - 1) / a * a;
}

/// 元素地址（字节偏移 GEP）：off = idx * stride
fn elem_addr(ref mut Emitter e, int stride, ref String base, ref String idx) -> String {
    off = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(off);
    e.buf.push_str(" = mul i64 ");
    e.buf.push_str(idx);
    e.buf.push_str(", ");
    e.buf.push_int(stride);
    e.buf.push_str("\n");
    g = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(g);
    e.buf.push_str(" = getelementptr i8, ptr ");
    e.buf.push_str(base);
    e.buf.push_str(", i64 ");
    e.buf.push_str(off);
    e.buf.push_str("\n");
    return g;
}

/// 元素是否为 String（布局 { ptr, i64 }，需要两次 store）
fn elem_is_string(ref Ast ast, int ty) -> bool {
    if ty <= -1000 && ty > -1128 { return false; }
    if ty <= -2000 && ty > -2128 { return false; }
    if ty == 2000 { return true; }
    if ty == 2002 { return false; }
    if ty == -4003 { return true; }
    if ty < 0 { return false; }
    if ty >= ast.len { return false; }
    if ast.tags[ty] != tt(TT::Named._tag) { return false; }
    return ast.texts[ty] == "String";
}

/// 元素的 AST 类型 id：字面量用内建哨兵，数组用其元素类型，其余 -1（i64 槽）
fn elem_type_of(ref Ast ast, int id) -> int {
    if id < 0 { return -1; }
    if ast.tags[id] == et(ET::Literal._tag) {
        k = ast.bb[id];
        if k == lk(LK::Str._tag) { return 2000; }
        if k == lk(LK::Float._tag) { return 2001; }
        if k == lk(LK::Char._tag) { return 2002; }
        return -1;
    }
    if ast.tags[id] == et(ET::ArraySized._tag) { return ast.tys[id]; }
    if ast.tags[id] == et(ET::ArrayLiteral._tag) { return elem_type_of(ast, ast.aa[id]); }
    if ast.tags[id] == et(ET::ArrayRepeat._tag) { return elem_type_of(ast, ast.aa[id]); }
    return -1;
}

/// 数组元素类型（含结构体/枚举字面量与结构体/枚举局部；合成 id：-1000-si / -2000-ei）
impl Emitter {
    #[alloc]
    #[state]
    fn elem_type_of_m(ref mut self, ref Ast ast, int id) -> int {
        if id < 0 { return -1; }
        tg = ast.tags[id];
        if tg == et(ET::StructLiteral._tag) {
            si = self.find_struct_idx(ast.texts[id]);
            if si >= 0 { return -1000 - si; }
            return -1;
        }
        if tg == et(ET::Lambda._tag) {
            // lambda 元素：节点本身即 Fn 类型（fn_type_params/ret 直接读 aa/tys）
            return id;
        }
        if tg == et(ET::EnumConstruct._tag) {
            en = pat_name(ast.texts[id]);
            ei = self.find_enum_idx(en);
            if ei >= 0 { return -2000 - ei; }
            return -1;
        }
        if tg == et(ET::Ident._tag) {
            kd = self.local_kind(ast.texts[id]);
            if kd >= 100 && kd < 228 { return -1000 - (kd - 100); }
            if kd == 20 {
                ei2 = self.etype_of_local(ast.texts[id]);
                if ei2 >= 0 { return -2000 - ei2; }
            }
            return -1;
        }
        return elem_type_of(ast, id);
    }
}

/// 模式名部分（"A|x,y" -> "A"；"E.A|x" -> "E.A"）
fn pat_name(ref String p) -> String {
    i = 0;
    while i < p.len as int {
        if p.index(i as usize) == '|' {
            return p.substring(0 as usize, i as usize);
        }
        i = i + 1;
    }
    return p.copy();
}

/// 模式绑定部分（"A|x,y" -> "x,y"；无 -> ""）
fn pat_binds(ref String p) -> String {
    i = 0;
    while i < p.len as int {
        if p.index(i as usize) == '|' {
            return p.substring((i + 1) as usize, p.len);
        }
        i = i + 1;
    }
    return "";
}

/// 变体短名（"E.A" -> "A"）
fn pat_short(ref String p) -> String {
    i = 0;
    last = -1;
    while i < p.len as int {
        if p.index(i as usize) == '.' { last = i; }
        i = i + 1;
    }
    if last >= 0 {
        return p.substring((last + 1) as usize, p.len);
    }
    return p.copy();
}

/// 枚举名（"E.A" -> "E"；无点 -> ""）
fn pat_enum(ref String p) -> String {
    i = 0;
    last = -1;
    while i < p.len as int {
        if p.index(i as usize) == '.' { last = i; }
        i = i + 1;
    }
    if last >= 0 {
        return p.substring(0 as usize, last as usize);
    }
    return "";
}

fn contains_dot2(ref String s) -> bool {
    i = 0;
    while i < s.len as int {
        if s.index(i as usize) == '.' { return true; }
        i = i + 1;
    }
    return false;
}

fn label(ref mut Emitter e, ref String prefix) -> String {
    b = StringBuf::new();
    b.push_str(prefix);
    b.push_int(e.tmp);
    e.tmp = e.tmp + 1;
    return b.to_string();
}

/// r1 引用协议解引用：调用 get()/get_mut() 得到 ref 指针
#[alloc]
#[state]
fn emit_protocol_deref(ref Ast ast, ref Val obj, ref String mn, ref mut Emitter e) -> Val {
    if obj.kind != 2 || obj.b.len == 0 { return mk_int("0"); }
    src = obj.b.copy();
    pa = -1;
    pa2 = -1;
    us = src.index_of("__m");
    if us > 0 {
        src = src.substring(0 as usize, us as usize);
        k = 0;
        while k < e.inst_st_count {
            if e.inst_st_names[k] == obj.b {
                pa = e.inst_st_argty[k];
                pa2 = e.inst_st_argty2[k];
                break;
            }
            k = k + 1;
        }
    }
    mid = e.find_method_id(src, mn);
    if mid < 0 { return mk_int("0"); }
    mrty = e.method_ret_type(src, mn);
    spec = -1;
    if pa != -1 { spec = e.spec_register2(ast, mid, src, pa, pa2, obj.b); }
    rk = e.ret_kind(ast, mrty);
    if spec >= 0 {
        g1 = e.impl_gparam(ast, src);
        g2 = "";
        if pa2 != -1 { g2 = e.impl_gparam2(ast, src); }
        if g1.len > 0 {
            rk = e.ret_kind_with2(ast, mrty, g1, pa, g2, pa2);
            if ty_name(ast, mrty) == g1 { mrty = pa; } elif g2.len > 0 && ty_name(ast, mrty) == g2 { mrty = pa2; }
        }
    }
    full_p = src + ".";
    full_p = full_p + mn;
    t = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(t);
    e.buf.push_str(" = call i64 @");
    e.buf.push_str(e.fn_sym_ord(full_p, e.fn_idx_of_node(full_p, e.fn_first_id(full_p))));
    if spec >= 0 { e.buf.push_str(".__i"); e.buf.push_int(spec); }
    e.buf.push_str("(ptr ");
    e.buf.push_str(obj.a);
    e.buf.push_str(")\n");
    rinfo = e.ret_info(ast, mrty);
    rnm = "";
    if rinfo >= 0 { rnm = e.st_names[rinfo].copy(); }
    pv = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(pv);
    e.buf.push_str(" = inttoptr i64 ");
    e.buf.push_str(t);
    e.buf.push_str(" to ptr\n");
    return Val { kind = 2, a = pv, b = rnm, ty = -1 };
}

/// 枚举构造：full = "E.A"（裸变体或带实参）
fn emit_enum_ctor(ref Ast ast, ref String full, int args, ref mut Emitter e) -> Val {
    ename = pat_enum(full);
    vname = pat_short(full);
    ei = e.find_enum_idx(ename);
    if ei < 0 { return mk_int("0"); }
    vi = e.find_variant_idx(ei, vname);
    if vi < 0 { return mk_int("0"); }
    // 先求值载荷实参（用于推断泛型枚举实例）；常见 ≤4 载荷用局部值，避免数组分配
    v0 = mk_int("0");
    v1 = mk_int("0");
    v2 = mk_int("0");
    v3 = mk_int("0");
    v4 = mk_int("0");
    v5 = mk_int("0");
    v6 = mk_int("0");
    v7 = mk_int("0");
    nv = 0;
    a0 = args;
    while a0 >= 0 && nv < 8 {
        vv = mk_int("0");
        if ast.tags[a0] == xt(XT::Arg._tag) { vv = emit_expr(ast, ast.aa[a0], e); } else { vv = emit_expr(ast, a0, e); }
        if nv == 0 { v0 = vv; } elif nv == 1 { v1 = vv; } elif nv == 2 { v2 = vv; } elif nv == 3 { v3 = vv; } elif nv == 4 { v4 = vv; } elif nv == 5 { v5 = vv; } elif nv == 6 { v6 = vv; } else { v7 = vv; }
        nv = nv + 1;
        a0 = ast.nexts[a0];
    }
    // 泛型枚举：按载荷值推断类型实参，改用实例（发射期可补建类型定义）
    gp_ce = e.enum_gparam(ast, ei);
    if gp_ce.len > 0 {
        ar_ce = e.variant_arity(ei, vi);
        k_ce = 0;
        while k_ce < ar_ce && k_ce < nv {
            if ty_name(ast, e.variant_ptype(ei, vi, k_ce)) == gp_ce {
                m_ce = -1;
                if k_ce == 0 { m_ce = e.val_marker(ast, v0); } elif k_ce == 1 { m_ce = e.val_marker(ast, v1); } elif k_ce == 2 { m_ce = e.val_marker(ast, v2); } elif k_ce == 3 { m_ce = e.val_marker(ast, v3); } elif k_ce == 4 { m_ce = e.val_marker(ast, v4); } elif k_ce == 5 { m_ce = e.val_marker(ast, v5); } elif k_ce == 6 { m_ce = e.val_marker(ast, v6); } else { m_ce = e.val_marker(ast, v7); }
                if m_ce != -1 {
                    ei_u = e.find_enum_inst(ast, ei, m_ce);
                    if ei_u < 0 { ei_u = e.fill_enum_inst(ast, ei, m_ce); }
                    if ei_u >= 0 {
                        ei = ei_u;
                        ename = e.en_names[ei_u].copy();
                        vi = e.find_variant_idx(ei, vname);
                        if vi < 0 { return mk_int("0"); }
                    }
                }
            }
            k_ce = k_ce + 1;
        }
    }
    nbytes = 8;
    if ei >= 0 { nbytes = (e.enum_max_arity(ei) + 1) * 8; }
    nb2 = StringBuf::new();
    nb2.push_int(nbytes);
    t = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(t);
    e.buf.push_str(" = call ptr @malloc(i64 ");
    e.buf.push_str(nb2.to_string());
    e.buf.push_str(")\n  call void @llvm.memset.p0.i64(ptr ");
    e.buf.push_str(t);
    e.buf.push_str(", i8 0, i64 ");
    e.buf.push_str(nb2.to_string());
    e.buf.push_str(", i1 false)\n");
    g0 = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(g0);
    e.buf.push_str(" = getelementptr %enum.");
    e.buf.push_str(ename);
    e.buf.push_str(", ptr ");
    e.buf.push_str(t);
    e.buf.push_str(", i32 0, i32 0\n  store i64 ");
    e.buf.push_int(vi);
    e.buf.push_str(", ptr ");
    e.buf.push_str(g0);
    e.buf.push_str("\n");
    if nv > 0 { enum_store_payload(ast, ei, vi, 0, ename, t, v0, e); }
    if nv > 1 { enum_store_payload(ast, ei, vi, 1, ename, t, v1, e); }
    if nv > 2 { enum_store_payload(ast, ei, vi, 2, ename, t, v2, e); }
    if nv > 3 { enum_store_payload(ast, ei, vi, 3, ename, t, v3, e); }
    if nv > 4 { enum_store_payload(ast, ei, vi, 4, ename, t, v4, e); }
    if nv > 5 { enum_store_payload(ast, ei, vi, 5, ename, t, v5, e); }
    if nv > 6 { enum_store_payload(ast, ei, vi, 6, ename, t, v6, e); }
    if nv > 7 { enum_store_payload(ast, ei, vi, 7, ename, t, v7, e); }
    return Val { kind = 4, a = t, b = ename.copy(), ty = -1 };
}

/// 枚举载荷槽写入（k 为载荷序号）
#[alloc]
fn enum_store_payload(ref Ast ast, int ei, int vi, int k, ref String ename, ref String t, ref Val v, ref mut Emitter e) {
    sl2 = e.payload_slot(ast, ei, vi, k);
    g = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(g);
    e.buf.push_str(" = getelementptr %enum.");
    e.buf.push_str(ename);
    e.buf.push_str(", ptr ");
    e.buf.push_str(t);
    e.buf.push_str(", i32 0, i32 ");
    e.buf.push_int(sl2);
    e.buf.push_str("\n");
    if v.kind == 1 {
        e.buf.push_str("  store ptr ");
        e.buf.push_str(ptr_operand(v.a));
        e.buf.push_str(", ptr ");
        e.buf.push_str(g);
        e.buf.push_str("\n");
        g2b = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(g2b);
        e.buf.push_str(" = getelementptr %enum.");
        e.buf.push_str(ename);
        e.buf.push_str(", ptr ");
        e.buf.push_str(t);
        e.buf.push_str(", i32 0, i32 ");
        e.buf.push_int(sl2 + 1);
        e.buf.push_str("\n  store i64 ");
        e.buf.push_str(v.b);
        e.buf.push_str(", ptr ");
        e.buf.push_str(g2b);
        e.buf.push_str("\n");
    } elif v.kind == 2 || v.kind == 3 || v.kind == 4 {
        e.buf.push_str("  store ptr ");
        e.buf.push_str(ptr_operand(v.a));
        e.buf.push_str(", ptr ");
        e.buf.push_str(g);
        e.buf.push_str("\n");
    } elif v.kind == 6 {
        b6e = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(b6e);
        e.buf.push_str(" = bitcast double ");
        e.buf.push_str(v.a);
        e.buf.push_str(" to i64\n  store i64 ");
        e.buf.push_str(b6e);
        e.buf.push_str(", ptr ");
        e.buf.push_str(g);
        e.buf.push_str("\n");
    } else {
        e.buf.push_str("  store i64 ");
        e.buf.push_str(v.a);
        e.buf.push_str(", ptr ");
        e.buf.push_str(g);
        e.buf.push_str("\n");
    }
}

/// 模式匹配条件（返回 i64 0/1 或 temp）
fn emit_pat_cond(ref Ast ast, int arm, ref Val sc, ref mut Emitter e) -> Val {
    ptext = ast.texts[arm];
    pk = ast.tys[arm];
    if pk == 0 { return mk_int("1"); }
    if pk == 4 { return mk_int("1"); }
    if pk == 1 {
        if sc.kind != 4 {
            // 绑定模式（n => ...）：恒匹配
            return mk_int("1");
        }
        vname = pat_short(pat_name(ptext));
        ename = pat_enum(pat_name(ptext));
        if ename.len == 0 { ename = sc.b.copy(); }
        ei = e.find_enum_idx(ename);
        if ei < 0 { return mk_int("0"); }
        vi = e.find_variant_idx(ei, vname);
        if vi < 0 { return mk_int("0"); }
        // 嵌套变体模式（Some|Some|v）：还需检查内层标签
        bar1 = -1;
        bar2 = -1;
        qq = 0;
        while qq < ptext.len as int {
            if ptext.index(qq as usize) == '|' {
                if bar1 < 0 { bar1 = qq; } elif bar2 < 0 { bar2 = qq; }
            }
            qq = qq + 1;
        }
        if bar2 > 0 {
            mid = ptext.substring((bar1 + 1) as usize, bar2 as usize);
            if e.find_struct_idx(mid) < 0 {
                // 内层标签检查在 body 块（外层标签确认后）进行，避免空指针解引用
            }
        }
        g = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(g);
        e.buf.push_str(" = getelementptr %enum.");
        e.buf.push_str(sc.b);
        e.buf.push_str(", ptr ");
        e.buf.push_str(sc.a);
        e.buf.push_str(", i32 0, i32 0\n");
        t = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(t);
        e.buf.push_str(" = load i64, ptr ");
        e.buf.push_str(g);
        e.buf.push_str("\n");
        c = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(c);
        e.buf.push_str(" = icmp eq i64 ");
        e.buf.push_str(t);
        e.buf.push_str(", ");
        e.buf.push_int(vi);
        e.buf.push_str("\n");
        return Val { kind = 5, a = c, b = "", ty = -1 };
    }
    if pk == 2 {
        lit = "0";
        if ptext == "true" { lit = "1"; }
        c2 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(c2);
        e.buf.push_str(" = icmp eq i64 ");
        e.buf.push_str(sc.a);
        e.buf.push_str(", ");
        e.buf.push_str(lit);
        e.buf.push_str("\n");
        return Val { kind = 5, a = c2, b = "", ty = -1 };
    }
    if pk == 6 {
        // 区间模式 start..end（左闭右开）或 start..=end（闭区间）
        dd = -1;
        eqq = 0;
        ii = 0;
        while ii < ptext.len as int {
            if ptext.index(ii as usize) == '.' {
                dd = ii;
                break;
            }
            ii = ii + 1;
        }
        if dd < 0 { return mk_int("0"); }
        rstart = ptext.substring(0 as usize, dd as usize);
        rest = ptext.substring((dd + 1) as usize, ptext.len);
        if rest.len > 0 {
            if rest.index(0) == '.' { rest = rest.substring(1 as usize, rest.len); }
        }
        if rest.len > 0 {
            if rest.index(0) == '=' {
                eqq = 1;
                rest = rest.substring(1 as usize, rest.len);
            }
        }
        rend = rest;
        if rstart.len == 0 || rend.len == 0 { return mk_int("0"); }
        c1r = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(c1r);
        e.buf.push_str(" = icmp sge i64 ");
        e.buf.push_str(sc.a);
        e.buf.push_str(", ");
        e.buf.push_str(rstart);
        e.buf.push_str("\n  ");
        c2r = e.fresh();
        e.buf.push_str(c2r);
        if eqq == 1 {
            e.buf.push_str(" = icmp sle i64 ");
        } else {
            e.buf.push_str(" = icmp slt i64 ");
        }
        e.buf.push_str(sc.a);
        e.buf.push_str(", ");
        e.buf.push_str(rend);
        e.buf.push_str("\n  ");
        c3r = e.fresh();
        e.buf.push_str(c3r);
        e.buf.push_str(" = and i1 ");
        e.buf.push_str(c1r);
        e.buf.push_str(", ");
        e.buf.push_str(c2r);
        e.buf.push_str("\n");
        return Val { kind = 5, a = c3r, b = "", ty = -1 };
    }
    if pk == 5 {
        // 字符字面量模式
        if ptext.len == 0 { return mk_int("0"); }
        cb5 = StringBuf::new();
        cb5.push_int(char_code(ptext.index(0)));
        c5 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(c5);
        e.buf.push_str(" = icmp eq i64 ");
        e.buf.push_str(sc.a);
        e.buf.push_str(", ");
        e.buf.push_str(cb5.to_string());
        e.buf.push_str("\n");
        return Val { kind = 5, a = c5, b = "", ty = -1 };
    }
    if pk == 3 {
        // 只支持整数字面量
        ok = 1;
        i = 0;
        while i < ptext.len as int {
            ch = ptext.index(i as usize);
            if !(ch >= '0' && ch <= '9') { ok = 0; }
            i = i + 1;
        }
        if ok == 0 { return mk_int("0"); }
        c3 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(c3);
        e.buf.push_str(" = icmp eq i64 ");
        e.buf.push_str(sc.a);
        e.buf.push_str(", ");
        e.buf.push_str(ptext);
        e.buf.push_str("\n");
        return Val { kind = 5, a = c3, b = "", ty = -1 };
    }
    return mk_int("0");
}

/// 嵌套变体模式的内层标签检查（在外层确认后、绑定前调用）；返回 1 表示已发射分支
#[alloc]
#[state]
fn emit_pat_inner_check(ref Ast ast, int arm, ref Val sc, ref String nxt, ref mut Emitter e) -> int {
    ptext = ast.texts[arm];
    pk = ast.tys[arm];
    if pk != 1 { return 0; }
    bar1 = -1;
    bar2 = -1;
    qq = 0;
    while qq < ptext.len as int {
        if ptext.index(qq as usize) == '|' {
            if bar1 < 0 { bar1 = qq; } elif bar2 < 0 { bar2 = qq; }
        }
        qq = qq + 1;
    }
    if bar2 <= 0 { return 0; }
    mid = ptext.substring((bar1 + 1) as usize, bar2 as usize);
    if e.find_struct_idx(mid) >= 0 { return 0; }
    ei = e.find_enum_idx(sc.b);
    if ei < 0 { return 0; }
    ivi = e.find_variant_idx(ei, mid);
    if ivi < 0 { return 0; }
    gpi = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(gpi);
    e.buf.push_str(" = getelementptr %enum.");
    e.buf.push_str(sc.b);
    e.buf.push_str(", ptr ");
    e.buf.push_str(sc.a);
    e.buf.push_str(", i32 0, i32 1\n  ");
    ipi = e.fresh();
    e.buf.push_str(ipi);
    e.buf.push_str(" = load ptr, ptr ");
    e.buf.push_str(gpi);
    e.buf.push_str("\n  ");
    gti = e.fresh();
    e.buf.push_str(gti);
    e.buf.push_str(" = getelementptr %enum.");
    e.buf.push_str(sc.b);
    e.buf.push_str(", ptr ");
    e.buf.push_str(ipi);
    e.buf.push_str(", i32 0, i32 0\n  ");
    tvi = e.fresh();
    e.buf.push_str(tvi);
    e.buf.push_str(" = load i64, ptr ");
    e.buf.push_str(gti);
    e.buf.push_str("\n  ");
    cvi = e.fresh();
    e.buf.push_str(cvi);
    e.buf.push_str(" = icmp eq i64 ");
    e.buf.push_str(tvi);
    e.buf.push_str(", ");
    e.buf.push_int(ivi);
    e.buf.push_str("\n  br i1 ");
    e.buf.push_str(cvi);
    e.buf.push_str(", label %");
    ok_l = label(e, "pat.ok.");
    e.buf.push_str(ok_l);
    e.buf.push_str(", label %");
    e.buf.push_str(nxt);
    e.buf.push_str("\n");
    e.buf.push_str(ok_l);
    e.buf.push_str(":\n");
    return 1;
}

/// 模式绑定（载荷 -> 局部变量）
fn emit_pat_binds(ref Ast ast, int arm, ref Val sc, ref mut Emitter e) {
    ptext = ast.texts[arm];
    pk = ast.tys[arm];
    if pk == 1 && sc.kind != 4 {
        // 绑定模式：把整个 scrutinee 绑定到模式名
        bn0 = pat_short(pat_name(ptext));
        if bn0.len > 0 && bn0 != "_" {
            e.declare_local(bn0, 0);
            e.buf.push_str("  store i64 ");
            e.buf.push_str(sc.a);
            e.buf.push_str(", ptr %v_");
            e.buf.push_str(bn0);
            e.buf.push_str("\n");
        }
        return;
    }
    binds = pat_binds(ptext);
    if binds.len == 0 { return; }
    // 枚举 + 嵌套结构体模式（Some|Point|x,y）：先取载荷槽 1 的指针，再按字段解构
    if pk == 1 {
        bar1 = -1;
        bar2 = -1;
        q0 = 0;
        while q0 < ptext.len as int {
            if ptext.index(q0 as usize) == '|' {
                if bar1 < 0 { bar1 = q0; } elif bar2 < 0 { bar2 = q0; }
            }
            q0 = q0 + 1;
        }
        if bar2 > 0 {
            sname = ptext.substring((bar1 + 1) as usize, bar2 as usize);
            binds = ptext.substring((bar2 + 1) as usize, ptext.len);
            if e.find_struct_idx(sname) < 0 {
                // 嵌套变体：内层载荷槽依次绑定
                gpv = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(gpv);
                e.buf.push_str(" = getelementptr %enum.");
                e.buf.push_str(sc.b);
                e.buf.push_str(", ptr ");
                e.buf.push_str(sc.a);
                e.buf.push_str(", i32 0, i32 1\n  ");
                ipv = e.fresh();
                e.buf.push_str(ipv);
                e.buf.push_str(" = load ptr, ptr ");
                e.buf.push_str(gpv);
                e.buf.push_str("\n");
                start3 = 0;
                i3 = 0;
                k3 = 0;
                while i3 <= binds.len as int {
                    at3e = 0;
                    if i3 == binds.len as int { at3e = 1; }
                    isc3 = 0;
                    if at3e == 0 {
                        if binds.index(i3 as usize) == ',' { isc3 = 1; }
                    }
                    if at3e == 1 || isc3 == 1 {
                        if i3 > start3 {
                            bnd3 = binds.substring(start3 as usize, i3 as usize);
                            g3 = e.fresh();
                            e.buf.push_str("  ");
                            e.buf.push_str(g3);
                            e.buf.push_str(" = getelementptr %enum.");
                            e.buf.push_str(sc.b);
                            e.buf.push_str(", ptr ");
                            e.buf.push_str(ipv);
                            e.buf.push_str(", i32 0, i32 ");
                            e.buf.push_int(k3 + 1);
                            e.buf.push_str("\n  ");
                            v3 = e.fresh();
                            e.buf.push_str(v3);
                            e.buf.push_str(" = load i64, ptr ");
                            e.buf.push_str(g3);
                            e.buf.push_str("\n");
                            e.declare_local(bnd3, 0);
                            e.buf.push_str("  store i64 ");
                            e.buf.push_str(v3);
                            e.buf.push_str(", ptr %v_");
                            e.buf.push_str(bnd3);
                            e.buf.push_str("\n");
                            k3 = k3 + 1;
                        }
                        start3 = i3 + 1;
                    }
                    i3 = i3 + 1;
                }
                return;
            }
            gp = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(gp);
            e.buf.push_str(" = getelementptr %enum.");
            e.buf.push_str(sc.b);
            e.buf.push_str(", ptr ");
            e.buf.push_str(sc.a);
            e.buf.push_str(", i32 0, i32 1\n");
            sp = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(sp);
            e.buf.push_str(" = load ptr, ptr ");
            e.buf.push_str(gp);
            e.buf.push_str("\n");
            start2 = 0;
            i2 = 0;
            while i2 <= binds.len as int {
                at_end2 = 0;
                if i2 == binds.len as int { at_end2 = 1; }
                is_comma2 = 0;
                if at_end2 == 0 {
                    if binds.index(i2 as usize) == ',' { is_comma2 = 1; }
                }
                if at_end2 == 1 || is_comma2 == 1 {
                    if i2 > start2 {
                        item = binds.substring(start2 as usize, i2 as usize);
                        fld = item.copy();
                        bnd = item.copy();
                        eqp2 = -1;
                        q3 = 0;
                        while q3 < item.len as int {
                            if item.index(q3 as usize) == '=' { eqp2 = q3; break; }
                            q3 = q3 + 1;
                        }
                        if eqp2 >= 0 {
                            fld = item.substring(0 as usize, eqp2 as usize);
                            bnd = item.substring((eqp2 + 1) as usize, item.len);
                        }
                        fi2 = e.find_field_idx(sname, fld);
                        if fi2 < 0 { return; }
                        gf = e.fresh();
                        e.buf.push_str("  ");
                        e.buf.push_str(gf);
                        e.buf.push_str(" = getelementptr %struct.");
                        e.buf.push_str(sname);
                        e.buf.push_str(", ptr ");
                        e.buf.push_str(sp);
                        e.buf.push_str(", i32 0, i32 ");
                        e.buf.push_int(fi2);
                        e.buf.push_str("\n");
                        vf = e.fresh();
                        e.buf.push_str("  ");
                        e.buf.push_str(vf);
                        e.buf.push_str(" = load i64, ptr ");
                        e.buf.push_str(gf);
                        e.buf.push_str("\n");
                        e.declare_local(bnd, 0);
                        si_d = e.find_struct_idx(sname);
                        if si_d >= 0 {
                            fty_d = unwrap_ty(ast, e.ftype_at(si_d, fi2));
                            if fty_d >= 0 && ty_name(ast, fty_d) == "Ptr" {
                                in_d = ast.aa[fty_d];
                                if in_d >= 0 { in_d = unwrap_ty(ast, in_d); }
                                if in_d >= 0 {
                                    si_di = e.find_struct_idx(ty_name(ast, in_d));
                                    if si_di >= 0 { e.record_etype(bnd, 10001 + si_di); }
                                }
                            }
                        }
                        e.buf.push_str("  store i64 ");
                        e.buf.push_str(vf);
                        e.buf.push_str(", ptr %v_");
                        e.buf.push_str(bnd);
                        e.buf.push_str("\n");
                    }
                    start2 = i2 + 1;
                }
                i2 = i2 + 1;
            }
            return;
        }
    }
    // 按 ',' 切分
    start = 0;
    k = 0;
    i = 0;
    while i <= binds.len as int {
        at_end = 0;
        if i == binds.len as int { at_end = 1; }
        is_comma = 0;
        if at_end == 0 {
            if binds.index(i as usize) == ',' { is_comma = 1; }
        }
        if at_end == 1 || is_comma == 1 {
            if i > start {
                bname = binds.substring(start as usize, i as usize);
                g = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(g);
                bname2 = bname.copy();
                pty_k = -1;
                psl_k = k + 1;
                pkind_k = 0;
                psi_k = -1;
                if pk == 1 {
                    ei_b = e.find_enum_idx(sc.b);
                    vn_b = pat_short(pat_name(ptext));
                    vi_b = -1;
                    if ei_b >= 0 { vi_b = e.find_variant_idx(ei_b, vn_b); }
                    if ei_b >= 0 && vi_b >= 0 {
                        pty_k = e.variant_ptype(ei_b, vi_b, k);
                        psl_k = e.payload_slot(ast, ei_b, vi_b, k);
                        tn_k = ty_name(ast, pty_k);
                        is_ch_k = 0;
                        if pty_k >= 0 {
                            if ast.tags[pty_k] == tt(TT::Char._tag) { is_ch_k = 1; }
                        }
                        if tn_k == "String" {
                            pkind_k = 1;
                        } elif tn_k == "char" || is_ch_k == 1 {
                            // char 载荷：标记 7000，拼接时按字符转换
                            pkind_k = 7000;
                        } else {
                            si_k = e.find_struct_idx(tn_k);
                            if si_k >= 0 {
                                pkind_k = 100 + si_k;
                                psi_k = si_k;
                            } else {
                                if tn_k == "Ptr" {
                                    // Ptr[T] 载荷：按指向结构体自动解引用
                                    in_p = ast.aa[pty_k];
                                    if in_p >= 0 { in_p = unwrap_ty(ast, in_p); }
                                    if in_p >= 0 {
                                        si_p = e.find_struct_idx(ty_name(ast, in_p));
                                        if si_p >= 0 {
                                            pkind_k = 100 + si_p;
                                            psi_k = si_p;
                                        }
                                    }
                                } else {
                                    ei_k = e.find_enum_idx(tn_k);
                                    if ei_k >= 0 {
                                        pkind_k = 20;
                                        psi_k = ei_k;
                                    }
                                }
                            }
                        }
                    }
                    e.buf.push_str(" = getelementptr %enum.");
                    e.buf.push_str(sc.b);
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(sc.a);
                    e.buf.push_str(", i32 0, i32 ");
                    e.buf.push_int(psl_k);
                } else {
                    // 结构体解构：bname 可能是 field 或 field=binding
                    fname2 = bname.copy();
                    eqp = -1;
                    q = 0;
                    while q < bname.len as int {
                        if bname.index(q as usize) == '=' { eqp = q; break; }
                        q = q + 1;
                    }
                    if eqp >= 0 {
                        fname2 = bname.substring(0 as usize, eqp as usize);
                        bname2 = bname.substring((eqp + 1) as usize, bname.len);
                    }
                    idx = e.find_field_idx(sc.b, fname2);
                    if idx < 0 { return; }
                    e.buf.push_str(" = getelementptr %struct.");
                    e.buf.push_str(sc.b);
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(sc.a);
                    e.buf.push_str(", i32 0, i32 ");
                    e.buf.push_int(idx);
                    e.buf.push_str("\n");
                }
                if pk == 1 && pkind_k == 1 {
                    // String 载荷：ptr + len
                    e.buf.push_str("\n");
                    vp_s = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(vp_s);
                    e.buf.push_str(" = load ptr, ptr ");
                    e.buf.push_str(g);
                    e.buf.push_str("\n");
                    gl_s = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(gl_s);
                    e.buf.push_str(" = getelementptr %enum.");
                    e.buf.push_str(sc.b);
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(sc.a);
                    e.buf.push_str(", i32 0, i32 ");
                    e.buf.push_int(psl_k + 1);
                    e.buf.push_str("\n");
                    vl_s = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(vl_s);
                    e.buf.push_str(" = load i64, ptr ");
                    e.buf.push_str(gl_s);
                    e.buf.push_str("\n");
                    e.declare_local(bname2, 1);
                    e.buf.push_str("  store ptr ");
                    e.buf.push_str(vp_s);
                    e.buf.push_str(", ptr %v_");
                    e.buf.push_str(bname2);
                    e.buf.push_str(".ptr\n  store i64 ");
                    e.buf.push_str(vl_s);
                    e.buf.push_str(", ptr %v_");
                    e.buf.push_str(bname2);
                    e.buf.push_str(".len\n");
                } elif pk == 1 && pkind_k >= 2 && pkind_k < 7000 {
                    // 结构体/枚举载荷：指针
                    e.buf.push_str("\n");
                    vp_p = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(vp_p);
                    e.buf.push_str(" = load ptr, ptr ");
                    e.buf.push_str(g);
                    e.buf.push_str("\n");
                    e.declare_local(bname2, pkind_k);
                    e.record_etype(bname2, psi_k);
                    e.buf.push_str("  store ptr ");
                    e.buf.push_str(vp_p);
                    e.buf.push_str(", ptr %v_");
                    e.buf.push_str(bname2);
                    e.buf.push_str(".p");
                    e.buf.push_str("\n");
                } else {
                    e.buf.push_str("\n");
                    v = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(v);
                    e.buf.push_str(" = load i64, ptr ");
                    e.buf.push_str(g);
                    e.buf.push_str("\n");
                    e.declare_local(bname2, 0);
                    if pkind_k == 7000 { e.record_etype(bname2, 7000); }
                    e.buf.push_str("  store i64 ");
                    e.buf.push_str(v);
                    e.buf.push_str(", ptr %v_");
                    e.buf.push_str(bname2);
                    e.buf.push_str("\n");
                }
                k = k + 1;
            }
            start = i + 1;
        }
        i = i + 1;
    }
}

/// match（语句 want_value=0 / 表达式 want_value=1）
/// 分支块尾是否为浮点值（用于 if/match 表达式结果槽的装载方式）
fn tail_is_float(ref Ast ast, int blk) -> int {
    if blk < 0 { return 0; }
    t = ast.bb[blk];
    if t < 0 { return 0; }
    if ast.tags[t] == et(ET::Literal._tag) {
        if ast.bb[t] == lk(LK::Float._tag) { return 1; }
        return 0;
    }
    if ast.tags[t] == et(ET::Suffixed._tag) {
        sfx = ast.texts[t];
        if sfx == "f32" || sfx == "f64" { return 1; }
        return 0;
    }
    return 0;
}

/// if 表达式分支：发射块语句 + 块尾值（存入 res）
fn emit_if_branch(ref Ast ast, int blk, ref String res, int want_float, ref mut Emitter e) -> int {
    if blk < 0 { return 0; }
    emit_stmts(ast, ast.aa[blk], e);
    if e.terminated == 1 { return 0; }
    tail = ast.bb[blk];
    if tail >= 0 {
        tv = emit_expr(ast, tail, e);
        if tv.kind == 6 {
            // 浮点：按位存入 i64 结果槽
            // 浮点：按位存入 i64 结果槽
            fb = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(fb);
            e.buf.push_str(" = bitcast double ");
            e.buf.push_str(tv.a);
            e.buf.push_str(" to i64\n  store i64 ");
            e.buf.push_str(fb);
            e.buf.push_str(", ptr ");
            e.buf.push_str(res);
            e.buf.push_str("\n");
        } elif want_float == 1 {
            // 结果槽按浮点解释：整数分支 sitofp 后按位存
            cf = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(cf);
            e.buf.push_str(" = sitofp i64 ");
            e.buf.push_str(tv.a);
            e.buf.push_str(" to double\n  ");
            cb = e.fresh();
            e.buf.push_str(cb);
            e.buf.push_str(" = bitcast double ");
            e.buf.push_str(cf);
            e.buf.push_str(" to i64\n  store i64 ");
            e.buf.push_str(cb);
            e.buf.push_str(", ptr ");
            e.buf.push_str(res);
            e.buf.push_str("\n");
            return 0;
        } else {
            return store_match_val(tv, res, e);
        }
    }
    return 0;
}

/// 分支尾值存入 i64 结果槽（指针类值先 ptrtoint；String 装箱为 16 字节单元，槽存单元指针）
/// 返回 1 表示本次存的是 String 单元（结果槽按 String 解释）
#[alloc]
fn store_match_val(ref Val tv, ref String res, ref mut Emitter e) -> int {
    if tv.kind == 1 {
        cell = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(cell);
        e.buf.push_str(" = call ptr @malloc(i64 16)\n  store ptr ");
        e.buf.push_str(tv.a);
        e.buf.push_str(", ptr ");
        e.buf.push_str(cell);
        e.buf.push_str("\n  ");
        c8 = e.fresh();
        e.buf.push_str(c8);
        e.buf.push_str(" = getelementptr i8, ptr ");
        e.buf.push_str(cell);
        e.buf.push_str(", i64 8\n  store i64 ");
        e.buf.push_str(tv.b);
        e.buf.push_str(", ptr ");
        e.buf.push_str(c8);
        e.buf.push_str("\n  ");
        pi = e.fresh();
        e.buf.push_str(pi);
        e.buf.push_str(" = ptrtoint ptr ");
        e.buf.push_str(cell);
        e.buf.push_str(" to i64\n  store i64 ");
        e.buf.push_str(pi);
        e.buf.push_str(", ptr ");
        e.buf.push_str(res);
        e.buf.push_str("\n");
        return 1;
    }
    if tv.kind == 2 || tv.kind == 3 || tv.kind == 4 || tv.kind == 21 {
        pv = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(pv);
        e.buf.push_str(" = ptrtoint ptr ");
        e.buf.push_str(tv.a);
        e.buf.push_str(" to i64\n  store i64 ");
        e.buf.push_str(pv);
        e.buf.push_str(", ptr ");
        e.buf.push_str(res);
        e.buf.push_str("\n");
        return 0;
    }
    e.buf.push_str("  store i64 ");
    e.buf.push_str(tv.a);
    e.buf.push_str(", ptr ");
    e.buf.push_str(res);
    e.buf.push_str("\n");
    return 0;
}

/// String 结果槽拆包：槽内 i64 是 16 字节单元指针（ptr + len）
#[alloc]
fn unpack_str_res(ref String slot_i64, ref mut Emitter e) -> Val {
    pc = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(pc);
    e.buf.push_str(" = inttoptr i64 ");
    e.buf.push_str(slot_i64);
    e.buf.push_str(" to ptr\n  ");
    rp = e.fresh();
    e.buf.push_str(rp);
    e.buf.push_str(" = load ptr, ptr ");
    e.buf.push_str(pc);
    e.buf.push_str("\n  ");
    rl8 = e.fresh();
    e.buf.push_str(rl8);
    e.buf.push_str(" = getelementptr i8, ptr ");
    e.buf.push_str(pc);
    e.buf.push_str(", i64 8\n  ");
    rl = e.fresh();
    e.buf.push_str(rl);
    e.buf.push_str(" = load i64, ptr ");
    e.buf.push_str(rl8);
    e.buf.push_str("\n");
    return mk_str_tmp(rp, rl);
}

/// if 表达式：条件链 + 分支块尾值合流
fn emit_if_expr(ref Ast ast, int id, ref mut Emitter e) -> Val {
    is_float_res = tail_is_float(ast, ast.bb[id]);
    if is_float_res == 0 { is_float_res = tail_is_float(ast, ast.dd[id]); }
    end_l = label(e, "ifx.end.");
    res = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(res);
    e.buf.push_str(" = alloca i64\n");
    sf = 0;
    c = emit_expr(ast, ast.aa[id], e);
    then_l = label(e, "ifx.then.");
    next_l = label(e, "ifx.next.");
    cc = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(cc);
    e.buf.push_str(" = icmp ne i64 ");
    e.buf.push_str(c.a);
    e.buf.push_str(", 0\n  br i1 ");
    e.buf.push_str(cc);
    e.buf.push_str(", label %");
    e.buf.push_str(then_l);
    e.buf.push_str(", label %");
    e.buf.push_str(next_l);
    e.buf.push_str("\n");
    e.buf.push_str(then_l);
    e.buf.push_str(":\n");
    e.terminated = 0;
    sf = sf | emit_if_branch(ast, ast.bb[id], res, is_float_res, e);
    if e.terminated == 0 {
        e.buf.push_str("  br label %");
        e.buf.push_str(end_l);
        e.buf.push_str("\n");
    }
    en = ast.cc[id];
    cur_next = next_l;
    while en >= 0 {
        e.buf.push_str(cur_next);
        e.buf.push_str(":\n");
        e.terminated = 0;
        ec2 = emit_expr(ast, ast.aa[en], e);
        then_l2 = label(e, "ifx.then.");
        next_l2 = label(e, "ifx.next.");
        cc2 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(cc2);
        e.buf.push_str(" = icmp ne i64 ");
        e.buf.push_str(ec2.a);
        e.buf.push_str(", 0\n  br i1 ");
        e.buf.push_str(cc2);
        e.buf.push_str(", label %");
        e.buf.push_str(then_l2);
        e.buf.push_str(", label %");
        e.buf.push_str(next_l2);
        e.buf.push_str("\n");
        e.buf.push_str(then_l2);
        e.buf.push_str(":\n");
        e.terminated = 0;
        sf = sf | emit_if_branch(ast, ast.bb[en], res, is_float_res, e);
        if e.terminated == 0 {
            e.buf.push_str("  br label %");
            e.buf.push_str(end_l);
            e.buf.push_str("\n");
        }
        cur_next = next_l2;
        en = ast.nexts[en];
    }
    e.buf.push_str(cur_next);
    e.buf.push_str(":\n");
    e.terminated = 0;
    e2 = ast.dd[id];
    if e2 >= 0 {
        sf = sf | emit_if_branch(ast, e2, res, is_float_res, e);
    }
    if e.terminated == 0 {
        e.buf.push_str("  br label %");
        e.buf.push_str(end_l);
        e.buf.push_str("\n");
    }
    e.buf.push_str(end_l);
    e.buf.push_str(":\n");
    e.terminated = 0;
    rv = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(rv);
    e.buf.push_str(" = load i64, ptr ");
    e.buf.push_str(res);
    e.buf.push_str("\n");
    if sf == 1 {
        return unpack_str_res(rv, e);
    }
    if is_float_res == 1 {
        fd = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(fd);
        e.buf.push_str(" = bitcast i64 ");
        e.buf.push_str(rv);
        e.buf.push_str(" to double\n");
        return mk_float(fd);
    }
    return mk_int(rv);
}

fn emit_match(ref Ast ast, int id, ref mut Emitter e, int want_value) -> Val {
    sc = emit_expr(ast, ast.aa[id], e);
    arms = ast.bb[id];
    cnt = 0;
    a = arms;
    while a >= 0 { cnt = cnt + 1; a = ast.nexts[a]; }
    if cnt == 0 { return mk_int("0"); }
    mtag_s = int_str2(e.tmp);
    end_l = label(e, "match.end.");
    res = "";
    sf_m = 0;
    if want_value == 1 {
        res = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(res);
        e.buf.push_str(" = alloca i64\n");
    }
    e.buf.push_str("  br label %match.arm." + mtag_s + "_0\n");
    i = 0;
    a = arms;
    prev_body = -1;
    while a >= 0 {
        lbl = "match.arm." + mtag_s + "_";
        b1 = StringBuf::new();
        b1.push_str(lbl);
        b1.push_int(i);
        nxt = end_l.copy();
        if i + 1 < cnt {
            n2 = StringBuf::new();
            n2.push_str("match.arm." + mtag_s + "_");
            n2.push_int(i + 1);
            nxt = n2.to_string();
        }
        bl = StringBuf::new();
        bl.push_str("match.body." + mtag_s + "_");
        bl.push_int(i);
        body_l = bl.to_string();
        e.buf.push_str(b1.to_string());
        e.buf.push_str(":\n");
        cond = emit_pat_cond(ast, a, sc, e);
        if cond.kind == 5 {
            e.buf.push_str("  br i1 ");
            e.buf.push_str(cond.a);
            e.buf.push_str(", label %");
            e.buf.push_str(body_l);
            e.buf.push_str(", label %");
            e.buf.push_str(nxt);
            e.buf.push_str("\n");
        } elif cond.kind == 0 {
            if cond.a == "1" {
                e.buf.push_str("  br label %");
                e.buf.push_str(body_l);
                e.buf.push_str("\n");
            } elif cond.a == "0" {
                e.buf.push_str("  br label %");
                e.buf.push_str(nxt);
                e.buf.push_str("\n");
            } else {
                cc = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(cc);
                e.buf.push_str(" = icmp ne i64 ");
                e.buf.push_str(cond.a);
                e.buf.push_str(", 0\n  br i1 ");
                e.buf.push_str(cc);
                e.buf.push_str(", label %");
                e.buf.push_str(body_l);
                e.buf.push_str(", label %");
                e.buf.push_str(nxt);
                e.buf.push_str("\n");
            }
        } else {
            cc2 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(cc2);
            e.buf.push_str(" = icmp ne i64 ");
            e.buf.push_str(cond.a);
            e.buf.push_str(", 0\n  br i1 ");
            e.buf.push_str(cc2);
            e.buf.push_str(", label %");
            e.buf.push_str(body_l);
            e.buf.push_str(", label %");
            e.buf.push_str(nxt);
            e.buf.push_str("\n");
        }
        e.buf.push_str(body_l);
        e.buf.push_str(":\n");
        emit_pat_inner_check(ast, a, sc, nxt, e);
        emit_pat_binds(ast, a, sc, e);
        gd = ast.bb[a];
        if gd >= 0 {
            // 守卫：绑定已就位，条件为假则跳到下一臂
            gv = emit_expr(ast, gd, e);
            gc = e.fresh();
            b2l = StringBuf::new();
            b2l.push_str("match.guard." + mtag_s + "_");
            b2l.push_int(i);
            e.buf.push_str("  ");
            e.buf.push_str(gc);
            e.buf.push_str(" = icmp ne i64 ");
            e.buf.push_str(gv.a);
            e.buf.push_str(", 0\n  br i1 ");
            e.buf.push_str(gc);
            e.buf.push_str(", label %");
            e.buf.push_str(b2l.to_string());
            e.buf.push_str(", label %");
            e.buf.push_str(nxt);
            e.buf.push_str("\n");
            e.buf.push_str(b2l.to_string());
            e.buf.push_str(":\n");
        }
        body = ast.aa[a];
        if body < 0 { body = prev_body; }
        if body >= 0 {
            prev_body = body;
            btag = ast.tags[body];
            if want_value == 1 {
                if btag == st(ST::Return._tag) {
                    emit_stmt(ast, body, e);
                } elif btag == st(ST::ExprStmt._tag) {
                    v = emit_expr(ast, ast.aa[body], e);
                    sf_m = sf_m | store_match_val(v, res, e);
                } elif btag == st(ST::Block._tag) {
                    emit_stmts(ast, ast.aa[body], e);
                    if e.terminated == 0 {
                        tail_m = ast.bb[body];
                        if tail_m >= 0 {
                            tv_m = emit_expr(ast, tail_m, e);
                            sf_m = sf_m | store_match_val(tv_m, res, e);
                        }
                    }
                } elif btag == st(ST::If._tag) {
                    // 臂体是尾位置 if（无花括号）：按 if 表达式取值
                    // （ST::If 与 ET::If 字段布局相同：aa=cond bb=then cc=elifs dd=else）
                    v_if = emit_if_expr(ast, body, e);
                    sf_m = sf_m | store_match_val(v_if, res, e);
                } else {
                    emit_stmt(ast, body, e);
                }
            } else {
                emit_stmt(ast, body, e);
            }
        }
        e.buf.push_str("  br label %");
        e.buf.push_str(end_l);
        e.buf.push_str("\n");
        i = i + 1;
        a = ast.nexts[a];
    }
    e.buf.push_str(end_l);
    e.buf.push_str(":\n");
    if want_value == 1 {
        rv = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(rv);
        e.buf.push_str(" = load i64, ptr ");
        e.buf.push_str(res);
        e.buf.push_str("\n");
        if sf_m == 1 {
            return unpack_str_res(rv, e);
        }
        return mk_int(rv);
    }
    return mk_int("0");
}

/// 间接调用 Fn 值：值 = 环境块指针（块首代码指针），env 作为末位参数
#[alloc]
fn emit_indirect_call(ref Ast ast, ref String fval, int fty, int args, ref mut Emitter e) -> Val {
    b = StringBuf::new();
    b.push_str("  ");
    envp = e.fresh();
    b.push_str(envp);
    b.push_str(" = inttoptr i64 ");
    b.push_str(fval);
    b.push_str(" to ptr\n  ");
    codep = e.fresh();
    b.push_str(codep);
    b.push_str(" = load ptr, ptr ");
    b.push_str(envp);
    b.push_str("\n  ");
    t4 = e.fresh();
    b.push_str(t4);
    frk = 0;
    frty = fn_type_ret(ast, fty);
    if frty >= 0 {
        frk = e.ret_kind(ast, frty);
    }
    if frk == 1 {
        b.push_str(" = call { ptr, i64 } ");
    } elif frk == 5 {
        b.push_str(" = call double ");
    } else {
        b.push_str(" = call i64 ");
    }
    b.push_str(codep);
    b.push_str("(");
    first0 = 1;
    a0f = args;
    fk_i = 0;
    while a0f >= 0 {
        at0 = emit_expr(ast, ast.aa[a0f], e);
        if first0 == 0 { b.push_str(", "); }
        pk0 = e.closure_param_kind(ast, fty, fk_i);
        if pk0 == 1 {
            b.push_str("ptr ");
            b.push_str(at0.a);
            b.push_str(", i64 ");
            b.push_str(at0.b);
        } elif pk0 == 31 {
            b.push_str("double ");
            b.push_str(float_operand(at0, e));
        } elif pk0 == 0 {
            b.push_str("i64 ");
            b.push_str(at0.a);
        } else {
            b.push_str("ptr ");
            b.push_str(at0.a);
        }
        first0 = 0;
        fk_i = fk_i + 1;
        a0f = ast.nexts[a0f];
    }
    if first0 == 0 { b.push_str(", "); }
    b.push_str("ptr ");
    b.push_str(envp);
    b.push_str(")\n");
    e.buf.push_str(b.to_string());
    if frk == 1 {
        ip5 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(ip5);
        e.buf.push_str(" = extractvalue { ptr, i64 } ");
        e.buf.push_str(t4);
        e.buf.push_str(", 0\n  ");
        il5 = e.fresh();
        e.buf.push_str(il5);
        e.buf.push_str(" = extractvalue { ptr, i64 } ");
        e.buf.push_str(t4);
        e.buf.push_str(", 1\n");
        return mk_str_tmp(ip5, il5);
    }
    if frk == 5 {
        return mk_float(t4);
    }
    return mk_int(t4);
}

/// 闭包值：非捕获 -> 静态环境块；捕获 -> 堆环境块（块首代码指针，后续捕获槽）
#[alloc]
fn emit_lambda_value(ref Ast ast, int id, ref mut Emitter e) -> Val {
    li = e.lam_index_of(id);
    if li < 0 {
        lp0 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(lp0);
        e.buf.push_str(" = ptrtoint ptr @");
        e.buf.push_str(ast.texts[id]);
        e.buf.push_str(" to i64\n");
        return mk_int(lp0);
    }
    if e.cap_done[li] == 0 {
        e.cap_start[li] = e.cap_total;
        e.cap_count[li] = 0;
        e.cap_done[li] = 1;
        cap_scan_list(ast, ast.bb[id], li, e);
    }
    cnt = e.cap_count[li];
    lname = ast.texts[id];
    if cnt == 0 {
        gnm = e.add_env_global("lamenv", lname);
        lp = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(lp);
        e.buf.push_str(" = ptrtoint ptr @");
        e.buf.push_str(gnm);
        e.buf.push_str(" to i64\n");
        return mk_int(lp);
    }
    sz = (cnt + 1) * 8;
    envp = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(envp);
    e.buf.push_str(" = call ptr @malloc(i64 ");
    e.buf.push_int(sz);
    e.buf.push_str(")\n  store ptr @");
    e.buf.push_str(e.fn_sym(lname));
    e.buf.push_str(", ptr ");
    e.buf.push_str(envp);
    e.buf.push_str("\n");
    start = e.cap_start[li];
    i = 0;
    while i < cnt {
        cid = e.cap_ids[start + i];
        ck = e.cap_kinds[start + i];
        off = (i + 1) * 8;
        if ck == 30 {
            ad = addr_of_arg(ast, cid, e);
            sp = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(sp);
            e.buf.push_str(" = getelementptr i8, ptr ");
            e.buf.push_str(envp);
            e.buf.push_str(", i64 ");
            e.buf.push_int(off);
            e.buf.push_str("\n  store ptr ");
            e.buf.push_str(ad);
            e.buf.push_str(", ptr ");
            e.buf.push_str(sp);
            e.buf.push_str("\n");
        } else {
            v = emit_expr(ast, cid, e);
            sp2 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(sp2);
            e.buf.push_str(" = getelementptr i8, ptr ");
            e.buf.push_str(envp);
            e.buf.push_str(", i64 ");
            e.buf.push_int(off);
            e.buf.push_str("\n");
            if v.kind == 1 {
                e.buf.push_str("  store ptr ");
                e.buf.push_str(v.a);
                e.buf.push_str(", ptr ");
                e.buf.push_str(sp2);
                e.buf.push_str("\n  ");
                sp2b = e.fresh();
                e.buf.push_str(sp2b);
                e.buf.push_str(" = getelementptr i8, ptr ");
                e.buf.push_str(envp);
                e.buf.push_str(", i64 ");
                e.buf.push_int(off + 8);
                e.buf.push_str("\n  store i64 ");
                e.buf.push_str(v.b);
                e.buf.push_str(", ptr ");
                e.buf.push_str(sp2b);
                e.buf.push_str("\n");
            } elif v.kind == 3 || v.kind == 2 || v.kind == 4 {
                e.buf.push_str("  store ptr ");
                e.buf.push_str(v.a);
                e.buf.push_str(", ptr ");
                e.buf.push_str(sp2);
                e.buf.push_str("\n");
            } elif v.kind == 6 {
                bb0 = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(bb0);
                e.buf.push_str(" = bitcast double ");
                e.buf.push_str(v.a);
                e.buf.push_str(" to i64\n  store i64 ");
                e.buf.push_str(bb0);
                e.buf.push_str(", ptr ");
                e.buf.push_str(sp2);
                e.buf.push_str("\n");
            } else {
                e.buf.push_str("  store i64 ");
                e.buf.push_str(v.a);
                e.buf.push_str(", ptr ");
                e.buf.push_str(sp2);
                e.buf.push_str("\n");
            }
        }
        i = i + 1;
    }
    lp2 = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(lp2);
    e.buf.push_str(" = ptrtoint ptr ");
    e.buf.push_str(envp);
    e.buf.push_str(" to i64\n");
    return mk_int(lp2);
}

/// 捕获扫描：收集 lambda 子树中引用到外层局部的名字（含嵌套 lambda 的引用）
#[alloc]
fn cap_scan_list(ref Ast ast, int id, int li, ref mut Emitter e) {
    while id >= 0 {
        cap_scan_node(ast, id, li, e);
        id = ast.nexts[id];
    }
}

/// bb 是否为子节点（Literal 存 LK、Ref 存 mutable 标志、Attributed 存属性数、MacroBlock 存计数）
fn bb_is_child(int tag) -> int {
    if tag == et(ET::Literal._tag) { return 0; }
    if tag == et(ET::Ref._tag) { return 0; }
    if tag == et(ET::MacroBlock._tag) { return 0; }
    if tag == st(ST::Attributed._tag) { return 0; }
    return 1;
}

/// cc/dd 为子节点的标签（if/for/index-assign）
fn ccdd_is_child(int tag) -> int {
    if tag == et(ET::If._tag) { return 1; }
    if tag == st(ST::If._tag) { return 1; }
    if tag == st(ST::For._tag) { return 1; }
    if tag == st(ST::IndexAssign._tag) { return 1; }
    return 0;
}

#[alloc]
fn cap_scan_node(ref Ast ast, int id, int li, ref mut Emitter e) {
    tag0 = ast.tags[id];
    if tag0 == et(ET::Ident._tag) {
        nm0 = ast.texts[id];
        kd0 = e.local_kind(nm0);
        if kd0 >= 0 {
            if e.lam_param_of(ast, li, nm0) == 1 { return; }
            ety0 = e.etype_of_local(nm0);
            e.cap_add(li, nm0, kd0, ety0, id);
        }
        return;
    }
    if tag0 == et(ET::Lambda._tag) {
        // 内层 lambda：其引用同样需要外层可见（捕获传递）
        cap_scan_list(ast, ast.bb[id], li, e);
        return;
    }
    if ast.aa[id] >= 0 {
        cap_scan_list(ast, ast.aa[id], li, e);
    }
    if ast.bb[id] >= 0 {
        if bb_is_child(tag0) == 1 {
            cap_scan_list(ast, ast.bb[id], li, e);
        }
    }
    if ccdd_is_child(tag0) == 1 {
        if ast.cc[id] >= 0 {
            cap_scan_list(ast, ast.cc[id], li, e);
        }
        if ast.dd[id] >= 0 {
            cap_scan_list(ast, ast.dd[id], li, e);
        }
    }
}

/// prelude 一元 int 调用：@fn(i64) -> i64（char 方法）
#[alloc]
fn emit_prelude_int1(ref String fname, ref String arg, ref mut Emitter e) -> Val {
    t = e.fresh();
    e.buf.push_str("  ");
    e.buf.push_str(t);
    e.buf.push_str(" = call i64 @");
    e.buf.push_str(e.fn_sym(fname));
    e.buf.push_str("(i64 ");
    e.buf.push_str(arg);
    e.buf.push_str(")\n");
    return mk_int(t);
}

/// prelude String 辅助调用：@fn(ptr s, i64 len[, ptr arg, i64 arglen])；rk 1 返回 String
#[alloc]
fn emit_prelude_str(ref String fname, ref Val s, ref Val arg, int has_arg, int rk, ref mut Emitter e) -> Val {
    b = StringBuf::new();
    b.push_str("  ");
    t = e.fresh();
    b.push_str(t);
    if rk == 1 {
        b.push_str(" = call { ptr, i64 } ");
    } else {
        b.push_str(" = call i64 ");
    }
    b.push_str("@");
    b.push_str(e.fn_sym(fname));
    b.push_str("(ptr ");
    b.push_str(ptr_operand(s.a));
    b.push_str(", i64 ");
    b.push_str(s.b);
    if has_arg == 1 {
        b.push_str(", ptr ");
        b.push_str(ptr_operand(arg.a));
        b.push_str(", i64 ");
        b.push_str(arg.b);
    }
    b.push_str(")\n");
    e.buf.push_str(b.to_string());
    if rk == 1 {
        ip = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(ip);
        e.buf.push_str(" = extractvalue { ptr, i64 } ");
        e.buf.push_str(t);
        e.buf.push_str(", 0\n  ");
        il = e.fresh();
        e.buf.push_str(il);
        e.buf.push_str(" = extractvalue { ptr, i64 } ");
        e.buf.push_str(t);
        e.buf.push_str(", 1\n");
        return mk_str_tmp(ip, il);
    }
    return mk_int(t);
}

/// 索引读取：按元素类型装载（base 为数组值，idx 为下标临时名）
#[alloc]
fn emit_index_read(ref Ast ast, ref Val base3, ref String idx, ref mut Emitter e) -> Val {
        ety3 = base3.ty;
        lty4 = "i64";
        if ety3 >= 0 || (ety3 <= -1000 && ety3 > -2128) || (ety3 <= -4001 && ety3 >= -4006) {
            lty4 = e.elem_llvm_m(ast, ety3);
        }
        g4 = elem_addr(e, elem_stride(ast, ety3), base3.a, idx);
        if elem_is_string(ast, ety3) {
            p4 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(p4);
            e.buf.push_str(" = load ptr, ptr ");
            e.buf.push_str(g4);
            e.buf.push_str("\n");
            g4b = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(g4b);
            e.buf.push_str(" = getelementptr i8, ptr ");
            e.buf.push_str(g4);
            e.buf.push_str(", i64 8\n");
            l4 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(l4);
            e.buf.push_str(" = load i64, ptr ");
            e.buf.push_str(g4b);
            e.buf.push_str("\n");
            return mk_str_tmp(p4, l4);
        }
        if lty4 == "ptr" {
            // 指针元素：结构体/枚举/其他指针值
            tp4 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(tp4);
            e.buf.push_str(" = load ptr, ptr ");
            e.buf.push_str(g4);
            e.buf.push_str("\n");
            if ety3 <= -1000 && ety3 > -1128 {
                return Val { kind = 2, a = tp4, b = e.st_names[0 - 1000 - ety3].copy(), ty = -1 };
            }
            if ety3 <= -2000 && ety3 > -2128 {
                return Val { kind = 4, a = tp4, b = e.en_names[0 - 2000 - ety3].copy(), ty = -1 };
            }
            etn4 = ty_name(ast, ety3);
            if etn4.len > 0 {
                si4 = e.find_struct_idx(etn4);
                if si4 >= 0 {
                    return Val { kind = 2, a = tp4, b = etn4.copy(), ty = -1 };
                }
                ei4i = e.find_enum_idx(etn4);
                if ei4i >= 0 {
                    return Val { kind = 4, a = tp4, b = etn4.copy(), ty = -1 };
                }
            }
            return mk_int(tp4);
        }
        if lty4 == "i8" {
            t4 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t4);
            e.buf.push_str(" = load i8, ptr ");
            e.buf.push_str(g4);
            e.buf.push_str("\n  ");
            s4 = e.fresh();
            e.buf.push_str(s4);
            e.buf.push_str(" = zext i8 ");
            e.buf.push_str(t4);
            e.buf.push_str(" to i64\n");
            return mk_int(s4);
        }
        if lty4 == "i32" {
            t5 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t5);
            e.buf.push_str(" = load i32, ptr ");
            e.buf.push_str(g4);
            e.buf.push_str("\n  ");
            s5 = e.fresh();
            e.buf.push_str(s5);
            e.buf.push_str(" = sext i32 ");
            e.buf.push_str(t5);
            e.buf.push_str(" to i64\n");
            return mk_int(s5);
        }
        t6 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(t6);
        e.buf.push_str(" = load ");
        e.buf.push_str(lty4);
        e.buf.push_str(", ptr ");
        e.buf.push_str(g4);
        e.buf.push_str("\n");
        if lty4 == "double" {
            return mk_float(t6);
        }
        return mk_int(t6);
    }

/// 结构体全局初始化函数：@__aya_init_globals（main 入口调用）
#[alloc]
fn emit_globals_init(ref Ast ast, ref mut Emitter e) {
    if e.need_ginit == 0 { return; }
    sv_buf2 = e.buf;
    sv_tmp2 = e.tmp;
    sv_lv2 = e.lv_count;
    sv_pre2 = e.pre_buf;
    sv_prea2 = e.pre_active;
    sv_term2 = e.terminated;
    sv_rt2 = e.cur_rtype;
    e.buf = StringBuf::new();
    e.tmp = 0;
    e.lv_count = 0;
    e.pre_buf = StringBuf::new();
    e.pre_active = 0;
    e.terminated = 0;
    e.buf.push_str("define void @__aya_init_globals() {\nentry:\n");
    i_g = 0;
    while i_g < e.g_count {
        if e.g_kinds[i_g] == 4 {
            v_g = emit_expr(ast, e.g_init_ids[i_g], e);
            pi_g = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(pi_g);
            e.buf.push_str(" = ptrtoint ptr ");
            e.buf.push_str(v_g.a);
            e.buf.push_str(" to i64\n  store i64 ");
            e.buf.push_str(pi_g);
            e.buf.push_str(", ptr @");
            e.buf.push_str(e.g_names[i_g]);
            e.buf.push_str("\n");
        } elif e.g_kinds[i_g] == 5 {
            // 堆数组全局：启动期调用 compile_time 函数取数据指针
            v_ga = emit_expr(ast, e.g_init_ids[i_g], e);
            e.buf.push_str("  store ptr ");
            e.buf.push_str(v_ga.a);
            e.buf.push_str(", ptr @");
            e.buf.push_str(e.g_names[i_g]);
            e.buf.push_str("\n");
        }
        i_g = i_g + 1;
    }
    e.buf.push_str("  ret void\n}\n");
    e.ginit_buf.push_str(e.buf.to_string());
    e.buf = sv_buf2;
    e.tmp = sv_tmp2;
    e.lv_count = sv_lv2;
    e.pre_buf = sv_pre2;
    e.pre_active = sv_prea2;
    e.terminated = sv_term2;
    e.cur_rtype = sv_rt2;
}

/// 十进制文本 -> int（非纯数字返回 -1；载荷下标 _N 解析用）
fn dec_val_e(ref String s) -> int {
    if s.len == 0 { return -1; }
    v = 0;
    i = 0;
    while i < s.len as int {
        c = char_code(s.index(i as usize));
        if c < 48 || c > 57 { return -1; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v;
}

/// ---- #[compile_time] 编译期解释器（int 域；失败 -999999）----

/// 二元运算求值
fn ct_binop(int op, int a, int b) -> int {
    if op == bo(BinOp::Add._tag) { return a + b; }
    if op == bo(BinOp::Sub._tag) { return a - b; }
    if op == bo(BinOp::Mul._tag) { return a * b; }
    if op == bo(BinOp::Div._tag) { if b == 0 { return -999999; } return a / b; }
    if op == bo(BinOp::Mod._tag) { if b == 0 { return -999999; } return a % b; }
    if op == bo(BinOp::BitAnd._tag) { return a & b; }
    if op == bo(BinOp::BitOr._tag) { return a | b; }
    if op == bo(BinOp::BitXor._tag) { return a ^ b; }
    if op == bo(BinOp::Shl._tag) { return a << b; }
    if op == bo(BinOp::Shr._tag) { return a >> b; }
    if op == bo(BinOp::Eq._tag) { if a == b { return 1; } return 0; }
    if op == bo(BinOp::Neq._tag) { if a != b { return 1; } return 0; }
    if op == bo(BinOp::Lt._tag) { if a < b { return 1; } return 0; }
    if op == bo(BinOp::Gt._tag) { if a > b { return 1; } return 0; }
    if op == bo(BinOp::Le._tag) { if a <= b { return 1; } return 0; }
    if op == bo(BinOp::Ge._tag) { if a >= b { return 1; } return 0; }
    if op == bo(BinOp::And._tag) { if a != 0 && b != 0 { return 1; } return 0; }
    if op == bo(BinOp::Or._tag) { if a != 0 || b != 0 { return 1; } return 0; }
    return -999999;
}

/// 解释语句链：0=正常 1=return -1=失败
fn ct_block(ref Ast ast, int stmts, ref mut Emitter e) -> int {
    st = stmts;
    while st >= 0 {
        r = ct_stmt(ast, st, e);
        if r != 0 { return r; }
        st = ast.nexts[st];
    }
    return 0;
}

/// 解释 if 的 then/elif/else 取值（表达式形式）
fn ct_if_value(ref Ast ast, int id, ref mut Emitter e) -> int {
    c = ct_expr(ast, ast.aa[id], e);
    if c == -999999 { return -999999; }
    if c != 0 {
        return ct_branch_value(ast, ast.bb[id], e);
    }
    en = ast.cc[id];
    while en >= 0 {
        c2 = ct_expr(ast, ast.aa[en], e);
        if c2 == -999999 { return -999999; }
        if c2 != 0 {
            return ct_branch_value(ast, ast.bb[en], e);
        }
        en = ast.nexts[en];
    }
    if ast.dd[id] >= 0 {
        return ct_branch_value(ast, ast.dd[id], e);
    }
    return -999999;
}

/// 解释分支块取值（语句 + 尾表达式）
fn ct_branch_value(ref Ast ast, int blk, ref mut Emitter e) -> int {
    if blk < 0 { return -999999; }
    base = e.ct_env_count;
    r = ct_block(ast, ast.aa[blk], e);
    res = -999999;
    if r == 1 {
        res = e.ct_ret;
    } elif r == 0 {
        t = ast.bb[blk];
        if t >= 0 { res = ct_expr(ast, t, e); }
    }
    e.ct_env_count = base;
    return res;
}

fn ct_stmt(ref Ast ast, int id, ref mut Emitter e) -> int {
    tag = ast.tags[id];
    if tag == st(ST::Assign._tag) {
        v = ct_expr(ast, ast.aa[id], e);
        if v == -999999 { return -1; }
        e.ct_set(ast.texts[id], v);
        return 0;
    }
    if tag == st(ST::Return._tag) {
        if ast.aa[id] >= 0 {
            v2 = ct_expr(ast, ast.aa[id], e);
            if v2 == -999999 { return -1; }
            e.ct_ret = v2;
        }
        return 1;
    }
    if tag == st(ST::If._tag) {
        // 语句语义：分支内的 return 必须向外传播（勿用表达式求值）
        c3 = ct_expr(ast, ast.aa[id], e);
        if c3 == -999999 { return -1; }
        if c3 != 0 { return ct_block(ast, ast.aa[ast.bb[id]], e); }
        en3 = ast.cc[id];
        while en3 >= 0 {
            c4 = ct_expr(ast, ast.aa[en3], e);
            if c4 == -999999 { return -1; }
            if c4 != 0 { return ct_block(ast, ast.aa[ast.bb[en3]], e); }
            en3 = ast.nexts[en3];
        }
        if ast.dd[id] >= 0 { return ct_block(ast, ast.aa[ast.dd[id]], e); }
        return 0;
    }
    if tag == st(ST::For._tag) {
        a1 = ct_expr(ast, ast.aa[id], e);
        b1 = ct_expr(ast, ast.bb[id], e);
        c1 = 1;
        if ast.cc[id] >= 0 {
            c1 = ct_expr(ast, ast.cc[id], e);
        }
        if a1 == -999999 || b1 == -999999 || c1 == -999999 { return -1; }
        if c1 == 0 { return -1; }
        base4 = e.ct_env_count;
        i1 = a1;
        while i1 < b1 {
            e.ct_set(ast.texts[id], i1);
            r4 = ct_block(ast, ast.aa[ast.dd[id]], e);
            if r4 != 0 { return r4; }
            e.ct_env_count = base4;
            i1 = i1 + c1;
        }
        e.ct_env_count = base4;
        return 0;
    }
    if tag == st(ST::ExprStmt._tag) {
        v5 = ct_expr(ast, ast.aa[id], e);
        if v5 == -999999 { return -1; }
        return 0;
    }
    if tag == st(ST::Block._tag) {
        return ct_block(ast, ast.aa[id], e);
    }
    return -1;
}

fn ct_expr(ref Ast ast, int id, ref mut Emitter e) -> int {
    if id < 0 { return -999999; }
    tag = ast.tags[id];
    if tag == et(ET::Literal._tag) {
        sv = const_int(ast, id);
        if sv.len == 0 { return -999999; }
        return str_to_int_ok(sv);
    }
    if tag == et(ET::Ident._tag) {
        nm = ast.texts[id];
        v = e.ct_get(nm);
        if v != -999999 { return v; }
        g = e.global_val(nm);
        if g.len == 0 { return -999999; }
        return str_to_int_ok(g);
    }
    if tag == et(ET::Binary._tag) {
        a = ct_expr(ast, ast.aa[id], e);
        if a == -999999 { return -999999; }
        b = ct_expr(ast, ast.bb[id], e);
        if b == -999999 { return -999999; }
        return ct_binop(ast.tys[id], a, b);
    }
    if tag == et(ET::Unary._tag) {
        a2 = ct_expr(ast, ast.aa[id], e);
        if a2 == -999999 { return -999999; }
        op2 = ast.tys[id];
        if op2 == uo(UnOp::Neg._tag) { return 0 - a2; }
        if op2 == uo(UnOp::Not._tag) { if a2 == 0 { return 1; } return 0; }
        if op2 == uo(UnOp::BitNot._tag) { return ~a2; }
        return -999999;
    }
    if tag == et(ET::If._tag) {
        return ct_if_value(ast, id, e);
    }
    if tag == et(ET::FnCall._tag) {
        fid = e.ct_find(ast.texts[id]);
        if fid < 0 { return -999999; }
        n = 0;
        a3 = ast.aa[id];
        while a3 >= 0 {
            av = ct_expr(ast, ast.aa[a3], e);
            if av == -999999 { return -999999; }
            if n < 16 { e.ct_args[n] = av; }
            n = n + 1;
            a3 = ast.nexts[a3];
        }
        return ct_call(ast, fid, n, e);
    }
    if tag == et(ET::Cast._tag) {
        return ct_expr(ast, ast.aa[id], e);
    }
    return -999999;
}

/// 解释 #[compile_time] 函数调用
fn ct_call(ref Ast ast, int fn_id, int nargs, ref mut Emitter e) -> int {
    if e.ct_depth > 64 { return -999999; }
    e.ct_depth = e.ct_depth + 1;
    base = e.ct_env_count;
    sv_frame = e.ct_frame;
    e.ct_frame = base;
    p = ast.aa[fn_id];
    i = 0;
    while p >= 0 {
        if i < nargs { e.ct_set(ast.texts[p], e.ct_args[i]); }
        i = i + 1;
        p = ast.nexts[p];
    }
    res = -999999;
    r = ct_block(ast, ast.aa[ast.bb[fn_id]], e);
    if r == 1 {
        res = e.ct_ret;
    } elif r == 0 {
        tail = ast.bb[ast.bb[fn_id]];
        if tail >= 0 { res = ct_expr(ast, tail, e); }
    }
    e.ct_env_count = base;
    e.ct_frame = sv_frame;
    e.ct_depth = e.ct_depth - 1;
    return res;
}

fn emit_expr(ref Ast ast, int id, ref mut Emitter e) -> Val {
    if id < 0 { return mk_int("0"); }
    tag = ast.tags[id];
    if tag == et(ET::Literal._tag) {
        k = ast.bb[id];
        if k == lk(LK::Int._tag) {
            dec = int_text_ok(ast.texts[id]);
            if dec.len > 0 { return mk_int(dec); }
            return mk_int(ast.texts[id]);
        }
        if k == lk(LK::Bool._tag) {
            if ast.texts[id] == "true" { return mk_int("1"); }
            return mk_int("0");
        }
        if k == lk(LK::Float._tag) {
            return mk_float(float_text(ast.texts[id]));
        }
        if k == lk(LK::Str._tag) {
            si = e.add_str(ast.texts[id]);
            b = StringBuf::new();
            b.push_str("@.str.");
            b.push_int(si);
            return mk_str(b.to_string(), ast.texts[id].len as int);
        }
        if k == lk(LK::Char._tag) {
            t = ast.texts[id];
            if t.len == 0 { return mk_int("0"); }
            cb = StringBuf::new();
            cb.push_int(char_code(t.index(0)));
            return mk_int(cb.to_string());
        }
        return mk_int("0");
    }
    if tag == et(ET::Suffixed._tag) {
        // 后缀字面量（1usize / 3f64）：f32/f64 按浮点
        sufx = ast.texts[id];
        if sufx == "f32" || sufx == "f64" {
            return mk_float(float_text(ast.texts[ast.aa[id]]));
        }
        return emit_expr(ast, ast.aa[id], e);
    }
    if tag == et(ET::Ident._tag) {
        nm = ast.texts[id];
        gk = e.global_kind(nm);
        if gk == 0 {
            t = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t);
            e.buf.push_str(" = load i64, ptr @");
            e.buf.push_str(nm);
            e.buf.push_str("\n");
            return mk_int(t);
        }
        if gk == 2 {
            return mk_arr("@" + nm, -1);
        }
        if gk == 3 {
            fdg = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(fdg);
            e.buf.push_str(" = load double, ptr @");
            e.buf.push_str(nm);
            e.buf.push_str("\n");
            return mk_float(fdg);
        }
        if gk == 5 {
            t_g5 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t_g5);
            e.buf.push_str(" = load ptr, ptr @");
            e.buf.push_str(nm);
            e.buf.push_str("\n");
            return mk_arr(t_g5, -1);
        }
        if gk == 4 {
            // 结构体全局：装载堆指针
            t_g4 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t_g4);
            e.buf.push_str(" = load i64, ptr @");
            e.buf.push_str(nm);
            e.buf.push_str("\n  ");
            p_g4 = e.fresh();
            e.buf.push_str(p_g4);
            e.buf.push_str(" = inttoptr i64 ");
            e.buf.push_str(t_g4);
            e.buf.push_str(" to ptr\n");
            gi_g4 = e.global_idx(nm);
            sn_g4 = "";
            if gi_g4 >= 0 {
                sti = e.g_stype[gi_g4];
                if sti >= 0 && sti < e.st_count { sn_g4 = e.st_names[sti].copy(); }
            }
            return Val { kind = 2, a = p_g4, b = sn_g4, ty = -1 };
        }
        if contains_dot2(nm) {
            if nm == "String.empty" || nm == "String.new" {
                return mk_str("null", 0);
            }
            return emit_enum_ctor(ast, nm, -1, e);
        }
        kd_pv = e.local_kind(nm);
        gk_pv = e.global_kind(nm);
        if kd_pv < 0 && gk_pv < 0 {
            // 命名函数作为值：取环境块地址（块首为代码指针）
            frt_pv = e.fn_ret_type(nm);
            if frt_pv >= 0 {
                gnm_pv = e.add_env_global("fnenv", nm);
                fp0 = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(fp0);
                e.buf.push_str(" = ptrtoint ptr @");
                e.buf.push_str(gnm_pv);
                e.buf.push_str(" to i64\n");
                return mk_int(fp0);
            }
        }
        kd = e.local_kind(nm);
        if kd == 3 || kd == 10 {
            // 数组变量/数组引用：装载 malloc 指针
            t9 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t9);
            e.buf.push_str(" = load ptr, ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str(".p");
            e.buf.push_str("\n");
            return mk_arr(t9, e.find_elem(nm));
        }
        if kd == 40 {
            df = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(df);
            e.buf.push_str(" = load double, ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str(".d");
            e.buf.push_str("\n");
            return mk_float(df);
        }
        if kd == 30 {
            rp = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(rp);
            e.buf.push_str(" = load ptr, ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str(".p\n");
            e30 = e.etype_of_local(nm);
            if e30 == 8000 {
                // ref 到浮点：load double
                rv80 = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(rv80);
                e.buf.push_str(" = load double, ptr ");
                e.buf.push_str(rp);
                e.buf.push_str("\n");
                return mk_float(rv80);
            }
            if e30 >= 5000 && e30 < 5128 {
                // ref 到结构体：槽里存的是结构体指针槽地址，再解一层
                rv30 = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(rv30);
                e.buf.push_str(" = load ptr, ptr ");
                e.buf.push_str(rp);
                e.buf.push_str("\n");
                return Val { kind = 2, a = rv30, b = e.st_names[e30 - 5000].copy(), ty = -1 };
            }
            if e30 >= 6000 && e30 < 6128 {
                rv30e = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(rv30e);
                e.buf.push_str(" = load ptr, ptr ");
                e.buf.push_str(rp);
                e.buf.push_str("\n");
                return Val { kind = 4, a = rv30e, b = e.en_names[e30 - 6000].copy(), ty = -1 };
            }
            rv2 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(rv2);
            e.buf.push_str(" = load i64, ptr ");
            e.buf.push_str(rp);
            e.buf.push_str("\n");
            return mk_int(rv2);
        }
        if kd == 20 {
            t = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t);
            e.buf.push_str(" = load ptr, ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str(".p");
            e.buf.push_str("\n");
            ei5 = e.etype_of_local(nm);
            en5 = "";
            if ei5 >= 0 { en5 = e.en_names[ei5].copy(); }
            return Val { kind = 4, a = t, b = en5, ty = -1 };
        }
        if kd == 21 {
            // 接口值：装载 box 指针；接口名来自 etype（vtable 派发用）
            t21 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t21);
            e.buf.push_str(" = load ptr, ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str(".p\n");
            e21 = e.etype_of_local(nm);
            n21 = "";
            if e21 >= 0 { n21 = e.if_names[e21].copy(); }
            return Val { kind = 21, a = t21, b = n21, ty = -1 };
        }
        if kd >= 2 {
            // 保留原 kind（100+si），不归一化为 2（否则丢失结构体索引，
            // addr_of_arg / 字段访问等按名查 epoch 的场景失败）
            t = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t);
            e.buf.push_str(" = load ptr, ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str(".p");
            e.buf.push_str("\n");
            return Val { kind = 2, a = t, b = e.struct_of_local(nm), ty = -1 };
        }
        if kd == 1 {
            p = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(p);
            e.buf.push_str(" = load ptr, ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str(".ptr\n");
            l = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(l);
            e.buf.push_str(" = load i64, ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str(".len\n");
            return Val { kind = 1, a = p, b = l, ty = -1 };
        }
        if kd == 10 {
            t = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t);
            e.buf.push_str(" = load ptr, ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str(".p");
            e.buf.push_str("\n");
            return mk_arr(t, e.elem_of_local(nm));
        }
        e.declare_local(nm, 0);
        t = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(t);
        e.buf.push_str(" = load i64, ptr %v_");
        e.buf.push_str(nm);
        e.buf.push_str("\n");
        et0 = e.etype_of_local(nm);
        if et0 == 7000 {
            return Val { kind = 0, a = t, b = "", ty = 7000 };
        }
        if et0 == 9000 {
            return Val { kind = 0, a = t, b = "", ty = 9000 };
        }
        if et0 >= 10000 && et0 < 10129 {
            pn_p = "";
            if et0 > 10000 { pn_p = e.st_names[et0 - 10001].copy(); }
            return Val { kind = 0, a = t, b = pn_p, ty = et0 };
        }
        return mk_int(t);
    }
    if tag == et(ET::Binary._tag) {
        op = ast.tys[id];
        lt = emit_expr(ast, ast.aa[id], e);
        if lt.kind == 2 || lt.kind == 4 {
            // 运算符重载：结构体/枚举值走 add/eq/... 方法
            mn_ov = op_method_name(op);
            if mn_ov.len > 0 {
                mid_ov = e.find_method_id(lt.b, mn_ov);
                if mid_ov >= 0 {
                    return emit_op_method_call(ast, id, lt, mn_ov, mid_ov, e);
                }
            }
        }
        rt = emit_expr(ast, ast.bb[id], e);
        if lt.kind == 6 || rt.kind == 6 {
            // 浮点运算/比较（混合时把整数侧 sitofp 到 double）
            la = float_operand(lt, e);
            ra = float_operand(rt, e);
            if is_cmp(op) {
                fc = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(fc);
                e.buf.push_str(" = fcmp ");
                e.buf.push_str(fcmp_op(op));
                e.buf.push_str(" double ");
                e.buf.push_str(la);
                e.buf.push_str(", ");
                e.buf.push_str(ra);
                e.buf.push_str("\n  ");
                fz = e.fresh();
                e.buf.push_str(fz);
                e.buf.push_str(" = zext i1 ");
                e.buf.push_str(fc);
                e.buf.push_str(" to i64\n");
                return mk_int(fz);
            }
            fop = "";
            if op == bo(BinOp::Add._tag) { fop = "fadd"; }
            elif op == bo(BinOp::Sub._tag) { fop = "fsub"; }
            elif op == bo(BinOp::Mul._tag) { fop = "fmul"; }
            elif op == bo(BinOp::Div._tag) { fop = "fdiv"; }
            if fop.len > 0 {
                fr = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(fr);
                e.buf.push_str(" = ");
                e.buf.push_str(fop);
                e.buf.push_str(" double ");
                e.buf.push_str(la);
                e.buf.push_str(", ");
                e.buf.push_str(ra);
                e.buf.push_str("\n");
                return mk_float(fr);
            }
            return mk_float("0.0");
        }
        if lt.kind == 1 || rt.kind == 1 {
            if op == bo(BinOp::Add._tag) {
                return emit_str_concat(lt, rt, e);
            }
            if op == bo(BinOp::Eq._tag) {
                return emit_str_eq(lt, rt, e);
            }
            if op == bo(BinOp::Neq._tag) {
                q = emit_str_eq(lt, rt, e);
                return emit_not(q, e);
            }
        }
        if is_cmp(op) {
            c = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(c);
            e.buf.push_str(" = icmp ");
            e.buf.push_str(cmp_llvm_op(op));
            e.buf.push_str(" i64 ");
            e.buf.push_str(lt.a);
            e.buf.push_str(", ");
            e.buf.push_str(rt.a);
            e.buf.push_str("\n");
            z = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(z);
            e.buf.push_str(" = zext i1 ");
            e.buf.push_str(c);
            e.buf.push_str(" to i64\n");
            return mk_int(z);
        }
        if op == bo(BinOp::And._tag) || op == bo(BinOp::Or._tag) {
            a = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(a);
            e.buf.push_str(" = icmp ne i64 ");
            e.buf.push_str(lt.a);
            e.buf.push_str(", 0\n");
            b2 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(b2);
            e.buf.push_str(" = icmp ne i64 ");
            e.buf.push_str(rt.a);
            e.buf.push_str(", 0\n");
            c2 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(c2);
            if op == bo(BinOp::And._tag) {
                e.buf.push_str(" = and i1 ");
            } else {
                e.buf.push_str(" = or i1 ");
            }
            e.buf.push_str(a);
            e.buf.push_str(", ");
            e.buf.push_str(b2);
            e.buf.push_str("\n");
            z2 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(z2);
            e.buf.push_str(" = zext i1 ");
            e.buf.push_str(c2);
            e.buf.push_str(" to i64\n");
            return mk_int(z2);
        }
        t2 = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(t2);
        e.buf.push_str(" = ");
        e.buf.push_str(bin_llvm_op(op));
        e.buf.push_str(" i64 ");
        e.buf.push_str(lt.a);
        e.buf.push_str(", ");
        e.buf.push_str(rt.a);
        e.buf.push_str("\n");
        return mk_int(t2);
    }
    if tag == et(ET::Unary._tag) {
        at = emit_expr(ast, ast.aa[id], e);
        op = ast.tys[id];
        if op == uo(UnOp::Neg._tag) {
            if at.kind == 6 {
                fn3 = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(fn3);
                e.buf.push_str(" = fneg double ");
                e.buf.push_str(at.a);
                e.buf.push_str("\n");
                return mk_float(fn3);
            }
            t3 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(t3);
            e.buf.push_str(" = sub i64 0, ");
            e.buf.push_str(at.a);
            e.buf.push_str("\n");
            return mk_int(t3);
        }
        if op == uo(UnOp::Deref._tag) {
            // 裸指针解引用：inttoptr 后按指向类型装载
            pv_d = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(pv_d);
            e.buf.push_str(" = inttoptr i64 ");
            e.buf.push_str(at.a);
            e.buf.push_str(" to ptr\n");
            tn_d = at.b.copy();
            si_d = e.find_struct_idx(tn_d);
            if si_d >= 0 {
                return Val { kind = 2, a = pv_d, b = tn_d, ty = -1 };
            }
            ei_d = e.find_enum_idx(tn_d);
            if ei_d >= 0 {
                return Val { kind = 4, a = pv_d, b = tn_d, ty = -1 };
            }
            if tn_d == "float" || tn_d == "f32" || tn_d == "f64" {
                vd = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(vd);
                e.buf.push_str(" = load double, ptr ");
                e.buf.push_str(pv_d);
                e.buf.push_str("\n");
                return mk_float(vd);
            }
            vd2 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(vd2);
            e.buf.push_str(" = load i64, ptr ");
            e.buf.push_str(pv_d);
            e.buf.push_str("\n");
            return mk_int(vd2);
        }
        if op == uo(UnOp::BitNot._tag) {
            tbn = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(tbn);
            e.buf.push_str(" = xor i64 ");
            e.buf.push_str(at.a);
            e.buf.push_str(", -1\n");
            return mk_int(tbn);
        }
        if op == uo(UnOp::Not._tag) {
            a3 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(a3);
            e.buf.push_str(" = icmp eq i64 ");
            e.buf.push_str(at.a);
            e.buf.push_str(", 0\n");
            z3 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(z3);
            e.buf.push_str(" = zext i1 ");
            e.buf.push_str(a3);
            e.buf.push_str(" to i64\n");
            return mk_int(z3);
        }
        return at;
    }
    if tag == et(ET::FnCall._tag) {
        nm = ast.texts[id];
        if nm == "String.new" {
            // String::new()：空字符串；String::new([char], usize) -> (ptr, len)
            if ast.aa[id] < 0 {
                return mk_str("null", 0);
            }
            a0 = emit_expr(ast, ast.aa[ast.aa[id]], e);
            if ast.nexts[ast.aa[id]] < 0 {
                // 单参形式：按缓冲长度构造（防御；std 未提供该重载）
                return mk_str_tmp(a0.a, a0.b);
            }
            a1 = emit_expr(ast, ast.aa[ast.nexts[ast.aa[id]]], e);
            return mk_str_tmp(a0.a, a1.a);
        }
        if nm == "String.empty" {
            return mk_str("null", 0);
        }
        if nm == "Ptr.new" || nm == "Ptr::new" {
            ap = ast.aa[id];
            if ap >= 0 {
                if ast.tags[ap] == xt(XT::Arg._tag) { ap = ast.aa[ap]; }
                vp = emit_expr(ast, ap, e);
                if vp.kind == 2 {
                    sip = e.find_struct_idx(vp.b);
                    pip = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(pip);
                    e.buf.push_str(" = ptrtoint ptr ");
                    e.buf.push_str(vp.a);
                    e.buf.push_str(" to i64\n");
                    return Val { kind = 0, a = pip, b = vp.b.copy(), ty = 10001 + sip };
                }
                if vp.kind == 4 {
                    // 枚举已是堆装箱值：Ptr 直接复用
                    return vp;
                }
                if vp.kind == 1 {
                    bx = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(bx);
                    e.buf.push_str(" = call ptr @malloc(i64 16)\n  ");
                    gb = e.fresh();
                    e.buf.push_str(gb);
                    e.buf.push_str(" = getelementptr i8, ptr ");
                    e.buf.push_str(bx);
                    e.buf.push_str(", i64 0\n  store ptr ");
                    e.buf.push_str(ptr_operand(vp.a));
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(gb);
                    e.buf.push_str("\n  ");
                    gb2 = e.fresh();
                    e.buf.push_str(gb2);
                    e.buf.push_str(" = getelementptr i8, ptr ");
                    e.buf.push_str(bx);
                    e.buf.push_str(", i64 8\n  store i64 ");
                    e.buf.push_str(vp.b);
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(gb2);
                    e.buf.push_str("\n  ");
                    qb = e.fresh();
                    e.buf.push_str(qb);
                    e.buf.push_str(" = ptrtoint ptr ");
                    e.buf.push_str(bx);
                    e.buf.push_str(" to i64\n");
                    return Val { kind = 0, a = qb, b = "", ty = 10000 };
                }
                bx2 = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(bx2);
                e.buf.push_str(" = call ptr @malloc(i64 8)\n  ");
                if vp.kind == 6 {
                    e.buf.push_str("store double ");
                    e.buf.push_str(vp.a);
                    e.buf.push_str(", ptr ");
                } else {
                    e.buf.push_str("store i64 ");
                    e.buf.push_str(vp.a);
                    e.buf.push_str(", ptr ");
                }
                e.buf.push_str(bx2);
                e.buf.push_str("\n  ");
                qb2 = e.fresh();
                e.buf.push_str(qb2);
                e.buf.push_str(" = ptrtoint ptr ");
                e.buf.push_str(bx2);
                e.buf.push_str(" to i64\n");
                return Val { kind = 0, a = qb2, b = "", ty = 10000 };
            }
            return mk_int("0");
        }
        if contains_dot2(nm) {
            if e.fn_ret_type(nm) < 0 && nm != "bits.reinterpret" && nm != "reinterpret" {
                return emit_enum_ctor(ast, nm, ast.aa[id], e);
            }
        }
        if nm == "char_code" {
            ac = emit_expr(ast, ast.aa[ast.aa[id]], e);
            return mk_int(ac.a);
        }
        if nm == "bits.reinterpret" || nm == "reinterpret" {
            // 位重解释：按目标类型 bitcast（f32 视作 f64，与自举一致）
            ty_r = ast.tys[id];
            tn_r = ty_name(ast, ty_r);
            to_f = 0;
            if tn_r == "float" || tn_r == "f32" || tn_r == "f64" { to_f = 1; }
            if ty_r >= 0 {
                if ast.tags[ty_r] == tt(TT::Float._tag) { to_f = 1; }
            }
            ar = ast.aa[id];
            if ar >= 0 {
                if ast.tags[ar] == xt(XT::Arg._tag) { ar = ast.aa[ar]; }
            }
            vr = mk_int("0");
            if ar >= 0 { vr = emit_expr(ast, ar, e); }
            if to_f == 1 {
                if vr.kind == 6 { return vr; }
                fb = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(fb);
                e.buf.push_str(" = bitcast i64 ");
                e.buf.push_str(vr.a);
                e.buf.push_str(" to double\n");
                return mk_float(fb);
            }
            if vr.kind == 6 {
                fb2 = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(fb2);
                e.buf.push_str(" = bitcast double ");
                e.buf.push_str(vr.a);
                e.buf.push_str(" to i64\n");
                return mk_int(fb2);
            }
            return vr;
        }
        if nm == "size_of" || nm == "align_of" || nm == "offset_of" {
            vb = e.layout_builtin_val(ast, id);
            if vb.len > 0 { return mk_int(vb); }
            return mk_int("0");
        }
        if nm == "static_assert" {
            // 编译期断言：条件求值（示例均为真；发射期不产生运行代码）
            ca = ast.aa[id];
            if ca >= 0 {
                if ast.tags[ca] == xt(XT::Arg._tag) { ca = ast.aa[ca]; }
                cv = e.const_eval_g(ast, ca);
            }
            return mk_int("0");
        }
        if nm == "to_cstr" {
            av2 = emit_expr(ast, ast.aa[ast.aa[id]], e);
            n4 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(n4);
            e.buf.push_str(" = add i64 ");
            e.buf.push_str(av2.b);
            e.buf.push_str(", 1\n  ");
            buf4 = e.fresh();
            e.buf.push_str(buf4);
            e.buf.push_str(" = call ptr @malloc(i64 ");
            e.buf.push_str(n4);
            e.buf.push_str(")\n  call ptr @memcpy(ptr ");
            e.buf.push_str(buf4);
            e.buf.push_str(", ptr ");
            e.buf.push_str(av2.a);
            e.buf.push_str(", i64 ");
            e.buf.push_str(av2.b);
            e.buf.push_str(")\n  ");
            nul4 = e.fresh();
            e.buf.push_str(nul4);
            e.buf.push_str(" = getelementptr i8, ptr ");
            e.buf.push_str(buf4);
            e.buf.push_str(", i64 ");
            e.buf.push_str(av2.b);
            e.buf.push_str("\n  store i8 0, ptr ");
            e.buf.push_str(nul4);
            e.buf.push_str("\n");
            return mk_arr(buf4, 2002);
        }
        if nm == "println" || nm == "print" {
            did_pf = 0;
            a = ast.aa[id];
            ar_lit = a;
            if a >= 0 {
                if ast.tags[a] == xt(XT::Arg._tag) { ar_lit = ast.aa[a]; }
            }
            if a >= 0 {
                v = emit_expr(ast, ast.aa[a], e);
                if v.kind == 1 {
                    e.buf.push_str("  call void @__ayanami_print_str(ptr ");
                    e.buf.push_str(v.a);
                    e.buf.push_str(", i64 ");
                    e.buf.push_str(v.b);
                    e.buf.push_str(")\n");
                } elif v.ty == 9000 || (ar_lit >= 0 && ast.tags[ar_lit] == et(ET::Literal._tag) && ast.bb[ar_lit] == lk(LK::Bool._tag)) {
                    // bool 字面量：交给 std 的 bool 重载（打印 true/false）
                    fi_pb = e.fn_pick_by_tyname(ast, nm, "bool");
                    if fi_pb >= 0 {
                        ord_pb = fi_pb;
                        e.buf.push_str("  call i64 @");
                        e.buf.push_str(e.fn_sym_ord(nm, ord_pb));
                        e.buf.push_str("(i64 ");
                        e.buf.push_str(v.a);
                        e.buf.push_str(")\n");
                        did_pf = 1;
                    }
                } elif v.ty == 7000 || (ar_lit >= 0 && ast.tags[ar_lit] == et(ET::Literal._tag) && ast.bb[ar_lit] == lk(LK::Char._tag)) {
                    // char 字面量：交给 std 的 char 重载（打印字符）
                    fi_pc = e.fn_pick_by_tyname(ast, nm, "char");
                    if fi_pc >= 0 {
                        ord_pc = fi_pc;
                        e.buf.push_str("  call i64 @");
                        e.buf.push_str(e.fn_sym_ord(nm, ord_pc));
                        e.buf.push_str("(i64 ");
                        e.buf.push_str(v.a);
                        e.buf.push_str(")\n");
                        did_pf = 1;
                    }
                } elif v.kind == 6 {
                    // 浮点：交给 std 重载（float.to_string 格式与 stage-0 一致）
                    fi_pf = e.fn_pick_by_kind(nm, 6);
                    if fi_pf >= 0 {
                        ord_pf = fi_pf;
                        e.buf.push_str("  call i64 @");
                        e.buf.push_str(e.fn_sym_ord(nm, ord_pf));
                        e.buf.push_str("(double ");
                        e.buf.push_str(float_operand(v, e));
                        e.buf.push_str(")\n");
                        did_pf = 1;
                    }
                } else {
                    e.buf.push_str("  call void @__ayanami_print_int(i64 ");
                    e.buf.push_str(v.a);
                    e.buf.push_str(")\n");
                }
            }
            if nm == "println" && did_pf == 0 {
                e.buf.push_str("  call void @__ayanami_print_ln()\n");
            }
            return mk_int("0");
        }
        kd_ic = e.local_kind(nm);
        ft_ic = e.ftype_of_local(nm);
        if kd_ic >= 0 && ft_ic >= 0 {
            // 函数值（i64 槽）：间接调用（仅 Fn 类型局部）
            fpv = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(fpv);
            e.buf.push_str(" = load i64, ptr %v_");
            e.buf.push_str(nm);
            e.buf.push_str("\n");
            return emit_indirect_call(ast, fpv, ft_ic, ast.aa[id], e);
        }
        b = StringBuf::new();
        b.push_str("  ");
        t4 = e.fresh();
        // 重载：先发射首个实参，按其 kind 选择候选（int/float 等）
        fi_sel = -1;
        at_first = mk_int("0");
        a_first = ast.aa[id];
        if a_first >= 0 {
            at_first = emit_expr(ast, ast.aa[a_first], e);
            fi_sel = e.fn_pick_by_kind(nm, at_first.kind);
        }
        rty_sel = e.fn_ret_type(nm);
        ord_sel = -1;
        if fi_sel >= 0 {
            rty_sel = e.fn_rt_at(fi_sel);
            ord_sel = fi_sel;
        }
        // 显式泛型实参：登记特化；返回类型若为类型参数则替换为实参类型
        ty_call = ast.tys[id];
        ty_call2 = -1;
        ty_call3 = -1;
        ty_call4 = -1;
        inst_call = -1;
        if ty_call < 0 {
            // 无显式类型实参：优先用容器用法推断，再按形参/约束推断（≤4 个类型参数）
            ty_call = e.infer_call_ty_of(id);
            if ty_call == -1 {
                if e.infer_call_all(ast, e.fn_first_id(nm), ast.aa[id]) == 1 {
                    ty_call = e.inf_arg1;
                    ty_call2 = e.inf_arg2;
                    ty_call3 = e.inf_arg3;
                    ty_call4 = e.inf_arg4;
                }
            }
        }
        ty_call = e.resolve_inf_arg(ast, ty_call);
        ty_call2 = e.resolve_inf_arg(ast, ty_call2);
        ty_call3 = e.resolve_inf_arg(ast, ty_call3);
        ty_call4 = e.resolve_inf_arg(ast, ty_call4);
        if ty_call != -1 {
            fnode_c = e.fn_first_id(nm);
            pf_c = "";
            last_dot = -1;
            q_c = 0;
            while q_c < nm.len as int {
                if nm.index(q_c as usize) == '.' { last_dot = q_c; }
                q_c = q_c + 1;
            }
            if last_dot > 0 { pf_c = nm.substring(0 as usize, last_dot as usize); }
            inst_call = e.spec_register4(ast, fnode_c, pf_c, ty_call, ty_call2, ty_call3, ty_call4, "");
            if fnode_c >= 0 && rty_sel >= 0 {
                gt_r = ast.cc[fnode_c];
                gt_r2 = -1;
                gt_r3 = -1;
                gt_r4 = -1;
                if gt_r >= 0 { gt_r2 = ast.nexts[gt_r]; }
                if gt_r2 >= 0 { gt_r3 = ast.nexts[gt_r2]; }
                if gt_r3 >= 0 { gt_r4 = ast.nexts[gt_r3]; }
                if gt_r >= 0 {
                    if ast.texts[rty_sel] == ast.texts[gt_r] {
                        rty_sel = ty_call;
                    } elif gt_r2 >= 0 && ast.texts[rty_sel] == ast.texts[gt_r2] {
                        rty_sel = ty_call2;
                    } elif gt_r3 >= 0 && ast.texts[rty_sel] == ast.texts[gt_r3] {
                        rty_sel = ty_call3;
                    } elif gt_r4 >= 0 && ast.texts[rty_sel] == ast.texts[gt_r4] {
                        rty_sel = ty_call4;
                    }
                }
            }
        }
        rk_c = e.ret_kind(ast, rty_sel);
        rll_c = e.fn_ret_llvm(nm);
        b.push_str(t4);
        if rk_c == 5 {
            b.push_str(" = call double @");
        } elif rk_c == 1 {
            b.push_str(" = call { ptr, i64 } @");
        } elif rll_c == 1 {
            b.push_str(" = call i32 @");
        } elif rll_c == 2 {
            b.push_str(" = call i8 @");
        } else {
            b.push_str(" = call i64 @");
        }
        b.push_str(e.fn_sym_ord(nm, ord_sel));
        if inst_call >= 0 {
            b.push_str(".__i");
            b.push_int(inst_call);
        }
        b.push_str("(");
        first = 1;
        a2 = ast.aa[id];
        ak = 0;
        while a2 >= 0 {
            at2 = mk_int("0");
            if ak == 0 && a_first >= 0 {
                at2 = at_first;
            } else {
                at2 = emit_expr(ast, ast.aa[a2], e);
            }
            if first == 0 { b.push_str(", "); }
            pk2 = e.fn_pk_at(fi_sel, ak);
            if pk2 < 0 { pk2 = e.fn_param_kind(nm, ak); }
            if ty_call != -1 {
                // 特化调用：形参 ABI 随实参类型（与特化序言的替换规则一致）
                if at2.kind == 1 {
                    pk2 = 1;
                } elif at2.kind == 6 {
                    pk2 = 31;
                } elif at2.kind == 2 || at2.kind == 3 || at2.kind == 4 {
                    pk2 = 1000;
                } else {
                    pk2 = 0;
                }
            }
            if pk2 == 31 {
                b.push_str("double ");
                b.push_str(float_operand(at2, e));
            } elif pk2 == 30 {
                a_r2 = ast.aa[a2];
                if ast.tags[a_r2] == xt(XT::Arg._tag) { a_r2 = ast.aa[a_r2]; }
                b.push_str("ptr ");
                nm_sr = "";
                if ast.tags[a_r2] == et(ET::Ident._tag) {
                    nm_sr = ast.texts[a_r2].copy();
                    if e.local_kind(nm_sr) != 1 { nm_sr = ""; }
                }
                if nm_sr.len > 0 {
                    b.push_str(e.string_ref_temp(nm_sr));
                } else {
                    b.push_str(addr_of_arg(ast, a_r2, e));
                }
            } elif pk2 == 0 {
                b.push_str("i64 ");
                b.push_str(at2.a);
            } elif pk2 == 1 {
                b.push_str("ptr ");
                b.push_str(at2.a);
                b.push_str(", i64 ");
                b.push_str(at2.b);
            } elif pk2 == 21 {
                ii_p2 = e.fn_piface_of(nm, ak);
                if ii_p2 > 0 && at2.kind != 21 {
                    in_p2 = e.if_names[ii_p2 - 1].copy();
                    b.push_str("ptr ");
                    b.push_str(e.emit_box(at2, in_p2));
                } else {
                    b.push_str("ptr ");
                    b.push_str(at2.a);
                }
            } else {
                b.push_str("ptr ");
                b.push_str(at2.a);
            }
            first = 0;
            ak = ak + 1;
            a2 = ast.nexts[a2];
        }
        b.push_str(e.implicit_args_m(ast, id, e.fn_first_id(nm), ak, first));
        b.push_str(")\n");
        e.buf.push_str(b.to_string());
        e.flush_string_refs();
        if rk_c == 5 {
            return mk_float(t4);
        }
        if rk_c == 1 {
            p5 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(p5);
            e.buf.push_str(" = extractvalue { ptr, i64 } ");
            e.buf.push_str(t4);
            e.buf.push_str(", 0\n  ");
            l5 = e.fresh();
            e.buf.push_str(l5);
            e.buf.push_str(" = extractvalue { ptr, i64 } ");
            e.buf.push_str(t4);
            e.buf.push_str(", 1\n");
            return mk_str_tmp(p5, l5);
        }
        if rk_c == 2 {
            rinfo = e.ret_info(ast, rty_sel);
            rnm = "";
            if rinfo >= 0 { rnm = e.st_names[rinfo].copy(); }
            done_i = 0;
            // 返回类型本身是具体泛型（Wrap[Box[int]] / T 被替换为 Box[int]）：按该类型自身实参找实例
            rty_u = unwrap_ty(ast, rty_sel);
            if rty_u >= 0 && ast.tags[rty_u] == tt(TT::Generic._tag) {
                in_q = ast.aa[rty_u];
                if in_q >= 0 {
                    in_u = unwrap_ty(ast, in_q);
                    if !e.type_has_gparam(ast, in_u) {
                        rnm_i = e.find_struct_inst_name(ast, rinfo, in_u);
                        if rnm_i.len > 0 { rnm = rnm_i; done_i = 1; }
                    }
                }
            }
            if done_i == 0 && inst_call >= 0 {
                // 返回类型是泛型结构体：用调用点推断实参立即补建实例（main 发射期就要拿到实例名）
                rty_g = unwrap_ty(ast, rty_sel);
                if rinfo >= 0 && rty_g >= 0 && ast.tags[rty_g] == tt(TT::Generic._tag) {
                    fnode_r = e.fn_first_id(nm);
                    gp_r1 = "";
                    gp_r2 = "";
                    gp_r3 = "";
                    gp_r4 = "";
                    if fnode_r >= 0 {
                        g_r = ast.cc[fnode_r];
                        if g_r >= 0 {
                            gp_r1 = ast.texts[g_r].copy();
                            g_r2 = ast.nexts[g_r];
                            if g_r2 >= 0 {
                                gp_r2 = ast.texts[g_r2].copy();
                                g_r3 = ast.nexts[g_r2];
                                if g_r3 >= 0 {
                                    gp_r3 = ast.texts[g_r3].copy();
                                    g_r4 = ast.nexts[g_r3];
                                    if g_r4 >= 0 { gp_r4 = ast.texts[g_r4].copy(); }
                                }
                            }
                        }
                    }
                    a1_r = -1;
                    a2_r = -1;
                    a3_r = -1;
                    a4_r = -1;
                    ga_r = ast.aa[rty_g];
                    k_r = 0;
                    while ga_r >= 0 && k_r < 4 {
                        an_r = ty_name(ast, unwrap_ty(ast, ga_r));
                        aa_r = -1;
                        if an_r.len > 0 {
                            if gp_r1.len > 0 && an_r == gp_r1 { aa_r = ty_call; }
                            elif gp_r2.len > 0 && an_r == gp_r2 { aa_r = ty_call2; }
                            elif gp_r3.len > 0 && an_r == gp_r3 { aa_r = ty_call3; }
                            elif gp_r4.len > 0 && an_r == gp_r4 { aa_r = ty_call4; }
                        }
                        if aa_r == -1 {
                            au_r = unwrap_ty(ast, ga_r);
                            if !e.type_is_gparam(ast, au_r) && !e.type_has_gparam(ast, au_r) { aa_r = au_r; }
                        }
                        if k_r == 0 { a1_r = aa_r; } elif k_r == 1 { a2_r = aa_r; } elif k_r == 2 { a3_r = aa_r; } else { a4_r = aa_r; }
                        ga_r = ast.nexts[ga_r];
                        k_r = k_r + 1;
                    }
                    if a1_r != -1 {
                        nm_ir = e.find_struct_inst_name(ast, rinfo, a1_r);
                        if nm_ir.len == 0 {
                            e.fill_struct_inst4(ast, rinfo, a1_r, a2_r, a3_r, a4_r);
                            nm_ir = e.find_struct_inst_name(ast, rinfo, a1_r);
                        }
                        if nm_ir.len > 0 {
                            rnm = nm_ir;
                            done_i = 1;
                        }
                    }
                }
                if done_i == 0 {
                    rnm_i2 = e.find_struct_inst_name(ast, rinfo, ty_call);
                    if rnm_i2.len > 0 { rnm = rnm_i2; }
                }
            }
            pi2 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(pi2);
            e.buf.push_str(" = inttoptr i64 ");
            e.buf.push_str(t4);
            e.buf.push_str(" to ptr\n");
            return Val { kind = 2, a = pi2, b = rnm, ty = -1 };
        }
        // 返回 Ptr[结构体]：值带解引用标记（字段访问/方法调用自动解引用）
        rty_p = unwrap_ty(ast, rty_sel);
        if rty_p >= 0 && ty_name(ast, rty_p) == "Ptr" {
            in_p = ast.aa[rty_p];
            if in_p < 0 { in_p = ast.tys[rty_p]; }
            in_pu = unwrap_ty(ast, in_p);
            np_p = ty_name(ast, in_pu);
            si_p = e.find_struct_idx(np_p);
            if si_p >= 0 {
                return Val { kind = 0, a = t4, b = np_p, ty = 10001 + si_p };
            }
        }
        if rk_c == 4 {
            rinfo2 = e.ret_info(ast, rty_sel);
            rnm2 = "";
            if rinfo2 >= 0 { rnm2 = e.en_names[rinfo2].copy(); }
            pi3 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(pi3);
            e.buf.push_str(" = inttoptr i64 ");
            e.buf.push_str(t4);
            e.buf.push_str(" to ptr\n");
            return Val { kind = 4, a = pi3, b = rnm2, ty = -1 };
        }
        if rk_c == 6 {
            rinfo6 = e.ret_info(ast, rty_sel);
            rnm6 = "";
            if rinfo6 >= 0 { rnm6 = e.if_names[rinfo6].copy(); }
            pi6c = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(pi6c);
            e.buf.push_str(" = inttoptr i64 ");
            e.buf.push_str(t4);
            e.buf.push_str(" to ptr\n");
            return Val { kind = 21, a = pi6c, b = rnm6, ty = -1 };
        }
        if rk_c == 3 {
            pi4 = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(pi4);
            e.buf.push_str(" = inttoptr i64 ");
            e.buf.push_str(t4);
            e.buf.push_str(" to ptr\n");
            return mk_arr(pi4, e.ret_info(ast, rty_sel));
        }
        if rll_c != 0 {
            sx = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(sx);
            if rll_c == 1 {
                e.buf.push_str(" = sext i32 ");
            } else {
                e.buf.push_str(" = zext i8 ");
            }
            e.buf.push_str(t4);
            e.buf.push_str(" to i64\n");
            return mk_int(sx);
        }
        return mk_int(t4);
    }
    if tag == et(ET::StructLiteral._tag) {
        nm = ast.texts[id];
        tyg_e = ast.tys[id];
        if tyg_e >= 0 {
            si_e = e.find_struct_idx(nm);
            if si_e >= 0 {
                sub_done = 0;
                if e.cur_inst_ord >= 0 {
                    // 特化上下文：类型实参中的 T/I 替换为实参，使用/补建实例
                    a1_s = -1;
                    a2_s = -1;
                    a3_s = -1;
                    a4_s = -1;
                    ga_s = tyg_e;
                    k_s = 0;
                    while ga_s >= 0 && k_s < 4 {
                        an_s = ty_name(ast, unwrap_ty(ast, ga_s));
                        aa_s = -1;
                        if an_s.len > 0 {
                            if e.cur_inst_param.len > 0 && an_s == e.cur_inst_param {
                                aa_s = e.cur_inst_arg_ty;
                            } elif e.cur_inst_param2.len > 0 && an_s == e.cur_inst_param2 {
                                aa_s = e.cur_inst_arg_ty2;
                            } elif e.cur_inst_param3.len > 0 && an_s == e.cur_inst_param3 {
                                aa_s = e.cur_inst_arg_ty3;
                            } elif e.cur_inst_param4.len > 0 && an_s == e.cur_inst_param4 {
                                aa_s = e.cur_inst_arg_ty4;
                            }
                        }
                        if aa_s == -1 {
                            au_s = unwrap_ty(ast, ga_s);
                            if !e.type_is_gparam(ast, au_s) && !e.type_has_gparam(ast, au_s) { aa_s = au_s; }
                        }
                        if k_s == 0 { a1_s = aa_s; } elif k_s == 1 { a2_s = aa_s; } elif k_s == 2 { a3_s = aa_s; } else { a4_s = aa_s; }
                        ga_s = ast.nexts[ga_s];
                        k_s = k_s + 1;
                    }
                    if a1_s != -1 {
                        nm_ie = e.find_struct_inst_name(ast, si_e, a1_s);
                        if nm_ie.len == 0 {
                            e.fill_struct_inst4(ast, si_e, a1_s, a2_s, a3_s, a4_s);
                            nm_ie = e.find_struct_inst_name(ast, si_e, a1_s);
                        }
                        if nm_ie.len > 0 {
                            nm = nm_ie;
                            sub_done = 1;
                        }
                    }
                }
                if sub_done == 0 {
                    nm_ie2 = e.find_struct_inst_name(ast, si_e, tyg_e);
                    if nm_ie2.len > 0 { nm = nm_ie2; }
                }
            }
        } else {
            nm_il = e.infer_literal_inst(ast, id);
            if nm_il.len > 0 { nm = nm_il; }
        }
        if e.cur_inst_ord >= 0 && e.cur_inst_struct.len > 0 && nm == e.cur_self_ty {
            // 特化上下文：源结构体字面量改用实例布局
            nm = e.cur_inst_struct.copy();
        }
        if nm == "String" {
            // 内建 String：{ data, len } -> (ptr, len) 值
            vd = Val { kind = 0, a = "null", b = "", ty = -1 };
            vl = Val { kind = 0, a = "0", b = "", ty = -1 };
            f2 = ast.aa[id];
            while f2 >= 0 {
                if ast.texts[f2] == "data" {
                    vd = emit_expr(ast, ast.aa[f2], e);
                } elif ast.texts[f2] == "len" {
                    vl = emit_expr(ast, ast.aa[f2], e);
                }
                f2 = ast.nexts[f2];
            }
            pd = vd.a;
            if vd.kind != 1 { pd = ptr_operand(vd.a); }
            return mk_str_tmp(pd, vl.a);
        }
        si_n = e.find_struct_idx(nm);
        nslots = 1;
        if si_n >= 0 { nslots = e.st_slots[si_n]; }
        nb = StringBuf::new();
        nb.push_int(nslots * 8);
        t = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(t);
        e.buf.push_str(" = call ptr @malloc(i64 ");
        e.buf.push_str(nb.to_string());
        e.buf.push_str(")\n  call void @llvm.memset.p0.i64(ptr ");
        e.buf.push_str(t);
        e.buf.push_str(", i8 0, i64 ");
        e.buf.push_str(nb.to_string());
        e.buf.push_str(", i1 false)\n");
        f = ast.aa[id];
        while f >= 0 {
            idx = e.find_field_idx(nm, ast.texts[f]);
            if idx >= 0 {
                v = emit_expr(ast, ast.aa[f], e);
                si_l = e.find_struct_idx(nm);
                sl = e.fslot_at(si_l, idx);
                fk = e.fkind_at(si_l, idx);
                g = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(g);
                e.buf.push_str(" = getelementptr %struct.");
                e.buf.push_str(nm);
                e.buf.push_str(", ptr ");
                e.buf.push_str(t);
                e.buf.push_str(", i32 0, i32 ");
                e.buf.push_int(sl);
                e.buf.push_str("\n");
                if fk == 1 {
                    e.buf.push_str("  store ptr ");
                    e.buf.push_str(ptr_operand(v.a));
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(g);
                    e.buf.push_str("\n");
                    g1b = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(g1b);
                    e.buf.push_str(" = getelementptr %struct.");
                    e.buf.push_str(nm);
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(t);
                    e.buf.push_str(", i32 0, i32 ");
                    e.buf.push_int(sl + 1);
                    e.buf.push_str("\n  store i64 ");
                    e.buf.push_str(v.b);
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(g1b);
                    e.buf.push_str("\n");
                } elif fk == 5 {
                    fv5 = float_operand(v, e);
                    e.buf.push_str("  store double ");
                    e.buf.push_str(fv5);
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(g);
                    e.buf.push_str("\n");
                } elif fk == 2 || fk == 3 || fk == 4 {
                    e.buf.push_str("  store ptr ");
                    e.buf.push_str(ptr_operand(v.a));
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(g);
                    e.buf.push_str("\n");
                } elif fk == 6 {
                    // 接口字段：值需为 box（kind 21），具体值就地装箱
                    fv6 = v.a.copy();
                    if v.kind != 21 {
                        fi6b = e.finfo_at(si_l, idx);
                        in6b = "";
                        if fi6b >= 0 { in6b = e.if_names[fi6b].copy(); }
                        fv6 = e.emit_box(v, in6b);
                    }
                    e.buf.push_str("  store ptr ");
                    e.buf.push_str(fv6);
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(g);
                    e.buf.push_str("\n");
                } else {
                    store_slot_i64(e, g, v);
                }
            }
            f = ast.nexts[f];
        }
        return Val { kind = 2, a = t, b = nm.copy(), ty = -1 };
    }
    if tag == et(ET::TryOp._tag) {
        // `expr?`：枚举 tag != Ok/Some 则从当前函数原样返回，否则取载荷
        v_try = emit_expr(ast, ast.aa[id], e);
        if v_try.kind != 4 { return v_try; }
        en_try = v_try.b.copy();
        ei_try = e.find_enum_idx(en_try);
        ok_i = -1;
        ok_nm = "Ok";
        if ei_try >= 0 {
            ok_i = e.find_variant_idx(ei_try, "Ok");
            if ok_i < 0 {
                ok_i = e.find_variant_idx(ei_try, "Some");
                ok_nm = "Some";
            }
        }
        gt_try = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(gt_try);
        e.buf.push_str(" = getelementptr %enum.");
        e.buf.push_str(en_try);
        e.buf.push_str(", ptr ");
        e.buf.push_str(v_try.a);
        e.buf.push_str(", i32 0, i32 0\n  ");
        tg_try = e.fresh();
        e.buf.push_str(tg_try);
        e.buf.push_str(" = load i64, ptr ");
        e.buf.push_str(gt_try);
        e.buf.push_str("\n  ");
        c_try = e.fresh();
        e.buf.push_str(c_try);
        e.buf.push_str(" = icmp ne i64 ");
        e.buf.push_str(tg_try);
        e.buf.push_str(", ");
        e.buf.push_int(ok_i);
        e.buf.push_str("\n  br i1 ");
        e.buf.push_str(c_try);
        err_l = label(e, "try.err.");
        ok_l = label(e, "try.ok.");
        e.buf.push_str(", label %");
        e.buf.push_str(err_l);
        e.buf.push_str(", label %");
        e.buf.push_str(ok_l);
        e.buf.push_str("\n");
        e.buf.push_str(err_l);
        e.buf.push_str(":\n");
        e.terminated = 1;
        pi_try = e.fresh();
        e.buf.push_str("  ");
        e.buf.push_str(pi_try);
        e.buf.push_str(" = ptrtoint ptr ");
        e.buf.push_str(v_try.a);
        e.buf.push_str(" to i64\n  ret i64 ");
        e.buf.push_str(pi_try);
        e.buf.push_str("\n");
        e.buf.push_str(ok_l);
        e.buf.push_str(":\n");
        e.terminated = 0;
        return emit_variant_payload(ast, v_try.a, en_try, ok_nm, e);
    }
    if tag == et(ET::FieldAccess._tag) {
        // _data_<Variant>._<N>：整体识别（内层不能单独发射，否则会先退化成 0）
        ob4 = ast.aa[id];
        if ob4 >= 0 {
            if ast.tags[ob4] == et(ET::FieldAccess._tag) {
                f4 = ast.texts[ob4];
                if f4.starts_with("_data_") {
                    ix4 = ast.texts[id];
                    if ix4.starts_with("_") {
                        oo4 = emit_expr(ast, ast.aa[ob4], e);
                        if oo4.kind == 4 {
                            vn4 = f4.substring(6 as usize, f4.len);
                            k4 = dec_val_e(ix4.substring(1 as usize, ix4.len));
                            ei4 = e.find_enum_idx(oo4.b);
                            if ei4 >= 0 && k4 >= 0 {
                                vi4 = e.find_variant_idx(ei4, vn4);
                                if vi4 >= 0 {
                                    sl4 = e.payload_slot(ast, ei4, vi4, k4);
                                    g4p = e.fresh();
                                    e.buf.push_str("  ");
                                    e.buf.push_str(g4p);
                                    e.buf.push_str(" = getelementptr %enum.");
                                    e.buf.push_str(oo4.b);
                                    e.buf.push_str(", ptr ");
                                    e.buf.push_str(oo4.a);
                                    e.buf.push_str(", i32 0, i32 ");
                                    e.buf.push_int(sl4);
                                    e.buf.push_str("\n");
                                    pty4 = e.variant_ptype(ei4, vi4, k4);
                                    if pty4 >= 0 {
                                        if ty_name(ast, pty4) == "String" {
                                            p4s = e.fresh();
                                            e.buf.push_str("  ");
                                            e.buf.push_str(p4s);
                                            e.buf.push_str(" = load ptr, ptr ");
                                            e.buf.push_str(g4p);
                                            e.buf.push_str("\n  ");
                                            l4s = e.fresh();
                                            e.buf.push_str(l4s);
                                            e.buf.push_str(" = getelementptr i8, ptr ");
                                            e.buf.push_str(g4p);
                                            e.buf.push_str(", i64 8\n  ");
                                            v4s = e.fresh();
                                            e.buf.push_str(v4s);
                                            e.buf.push_str(" = load i64, ptr ");
                                            e.buf.push_str(l4s);
                                            e.buf.push_str("\n");
                                            return mk_str_tmp(p4s, v4s);
                                        }
                                        pn4 = ty_name(ast, pty4);
                                        if pn4.len > 0 {
                                            if pn4 == "Ptr" {
                                                // Ptr[Inner] 载荷：记录解引用标记（Ptr 值是 i64 指针）
                                                in4 = ast.aa[pty4];
                                                if in4 < 0 { in4 = ast.tys[pty4]; }
                                                in4 = unwrap_ty(ast, in4);
                                                in4n = ty_name(ast, in4);
                                                si4 = e.find_struct_idx(in4n);
                                                i4q = e.fresh();
                                                e.buf.push_str("  ");
                                                e.buf.push_str(i4q);
                                                e.buf.push_str(" = load i64, ptr ");
                                                e.buf.push_str(g4p);
                                                e.buf.push_str("\n");
                                                if si4 >= 0 {
                                                    return Val { kind = 0, a = i4q, b = in4n, ty = 10001 + si4 };
                                                }
                                                return mk_int(i4q);
                                            }
                                            if e.find_struct_idx(pn4) >= 0 || e.find_enum_idx(pn4) >= 0 {
                                                i4p = e.fresh();
                                                e.buf.push_str("  ");
                                                e.buf.push_str(i4p);
                                                e.buf.push_str(" = load i64, ptr ");
                                                e.buf.push_str(g4p);
                                                e.buf.push_str("\n  ");
                                                q4p = e.fresh();
                                                e.buf.push_str(q4p);
                                                e.buf.push_str(" = inttoptr i64 ");
                                                e.buf.push_str(i4p);
                                                e.buf.push_str(" to ptr\n");
                                                if e.find_struct_idx(pn4) >= 0 {
                                                    return Val { kind = 2, a = q4p, b = pn4.copy(), ty = -1 };
                                                }
                                                return Val { kind = 4, a = q4p, b = pn4.copy(), ty = -1 };
                                            }
                                        }
                                    }
                                    v4i = e.fresh();
                                    e.buf.push_str("  ");
                                    e.buf.push_str(v4i);
                                    e.buf.push_str(" = load i64, ptr ");
                                    e.buf.push_str(g4p);
                                    e.buf.push_str("\n");
                                    return mk_int(v4i);
                                }
                            }
                        }
                    }
                }
            }
        }
        obj = emit_expr(ast, ast.aa[id], e);
        if obj.ty >= 10000 && obj.ty < 10129 {
            // 裸指针字段访问：先解引用
            pv_f = e.fresh();
            e.buf.push_str("  ");
            e.buf.push_str(pv_f);
            e.buf.push_str(" = inttoptr i64 ");
            e.buf.push_str(obj.a);
            e.buf.push_str(" to ptr\n");
            obj = Val { kind = 2, a = pv_f, b = obj.b.copy(), ty = -1 };
        }
        if obj.kind == 1 {
            if ast.texts[id] == "len" {
                return mk_int(obj.b);
            }
            if ast.texts[id] == "data" {
                // String.data -> [char]（元素 i8）
                return mk_arr(obj.a, 2002);
            }
            return mk_int("0");
        }
        if obj.kind == 4 {
            if ast.texts[id] == "_tag" {
                g = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(g);
                e.buf.push_str(" = getelementptr %enum.");
                e.buf.push_str(obj.b);
                e.buf.push_str(", ptr ");
                e.buf.push_str(obj.a);
                e.buf.push_str(", i32 0, i32 0\n");
                vtag = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(vtag);
                e.buf.push_str(" = load i64, ptr ");
                e.buf.push_str(g);
                e.buf.push_str("\n");
                return mk_int(vtag);
            }
            return mk_int("0");
        }
        if obj.kind == 2 {
            idx = e.find_field_idx(obj.b, ast.texts[id]);
            if idx < 0 {
                // r1 引用协议：类型无该字段且有 get() → 自动解引用（接收者可能是实例名）
                src_r1 = obj.b.copy();
                us_r1 = src_r1.index_of("__m");
                if us_r1 > 0 { src_r1 = src_r1.substring(0 as usize, us_r1 as usize); }
                if e.find_method_id(src_r1, "get") >= 0 {
                    obj = emit_protocol_deref(ast, obj, "get", e);
                    idx = e.find_field_idx(obj.b, ast.texts[id]);
                }
            }
            if idx >= 0 {
                si_f = e.find_struct_idx(obj.b);
                sl = e.fslot_at(si_f, idx);
                fk = e.fkind_at(si_f, idx);
                g2 = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(g2);
                e.buf.push_str(" = getelementptr %struct.");
                e.buf.push_str(obj.b);
                e.buf.push_str(", ptr ");
                e.buf.push_str(obj.a);
                e.buf.push_str(", i32 0, i32 ");
                e.buf.push_int(sl);
                e.buf.push_str("\n");
                if fk == 1 {
                    // String 字段：ptr + len 两槽
                    vp = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(vp);
                    e.buf.push_str(" = load ptr, ptr ");
                    e.buf.push_str(g2);
                    e.buf.push_str("\n");
                    g2b = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(g2b);
                    e.buf.push_str(" = getelementptr %struct.");
                    e.buf.push_str(obj.b);
                    e.buf.push_str(", ptr ");
                    e.buf.push_str(obj.a);
                    e.buf.push_str(", i32 0, i32 ");
                    e.buf.push_int(sl + 1);
                    e.buf.push_str("\n");
                    vllen = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(vllen);
                    e.buf.push_str(" = load i64, ptr ");
                    e.buf.push_str(g2b);
                    e.buf.push_str("\n");
                    return mk_str_tmp(vp, vllen);
                }
                if fk == 2 {
                    vp2 = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(vp2);
                    e.buf.push_str(" = load ptr, ptr ");
                    e.buf.push_str(g2);
                    e.buf.push_str("\n");
                    fnm = e.st_names[e.finfo_at(si_f, idx)].copy();
                    // 字段类型是具体泛型（如 B[C[int]]）：改用其实例名，保证后续字段布局正确
                    ftn = unwrap_ty(ast, e.ftype_at(si_f, idx));
                    if ftn >= 0 && ast.tags[ftn] == tt(TT::Generic._tag) {
                        in_f = ast.aa[ftn];
                        if in_f >= 0 {
                            in_fu = unwrap_ty(ast, in_f);
                            if !e.type_has_gparam(ast, in_fu) {
                                si_b = e.find_struct_idx(ty_name(ast, ftn));
                                nm_ii = e.find_struct_inst_name(ast, si_b, in_fu);
                                if nm_ii.len > 0 { fnm = nm_ii; }
                            }
                        }
                    }
                    return Val { kind = 2, a = vp2, b = fnm, ty = -1 };
                }
                if fk == 3 {
                    vp3 = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(vp3);
                    e.buf.push_str(" = load ptr, ptr ");
                    e.buf.push_str(g2);
                    e.buf.push_str("\n");
                    return mk_arr(vp3, e.finfo_at(si_f, idx));
                }
                if fk == 5 {
                    vd5 = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(vd5);
                    e.buf.push_str(" = load double, ptr ");
                    e.buf.push_str(g2);
                    e.buf.push_str("\n");
                    return mk_float(vd5);
                }
                if fk == 4 {
                    vp4 = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(vp4);
                    e.buf.push_str(" = load ptr, ptr ");
                    e.buf.push_str(g2);
                    e.buf.push_str("\n");
                    enm4 = "";
                    ei4 = e.finfo_at(si_f, idx);
                    if ei4 >= 0 { enm4 = e.en_names[ei4].copy(); }
                    // 字段类型是具体泛型枚举（如 Option[Ptr[Tree]]）：改用其实例名
                    ftn4 = unwrap_ty(ast, e.ftype_at(si_f, idx));
                    if ei4 >= 0 && ftn4 >= 0 && ast.tags[ftn4] == tt(TT::Generic._tag) {
                        in4f = ast.aa[ftn4];
                        if in4f >= 0 {
                            in4fu = unwrap_ty(ast, in4f);
                            if !e.type_has_gparam(ast, in4fu) {
                                ei_i4 = e.find_enum_inst(ast, ei4, in4fu);
                                if ei_i4 >= 0 { enm4 = e.en_names[ei_i4].copy(); }
                            }
                        }
                    }
                    return Val { kind = 4, a = vp4, b = enm4, ty = -1 };
                }
                if fk == 6 {
                    // 接口字段：装载 box 指针
                    vp6 = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(vp6);
                    e.buf.push_str(" = load ptr, ptr ");
                    e.buf.push_str(g2);
                    e.buf.push_str("\n");
                    inm6 = "";
                    fi6 = e.finfo_at(si_f, idx);
                    if fi6 >= 0 { inm6 = e.if_names[fi6].copy(); }
                    return Val { kind = 21, a = vp6, b = inm6, ty = -1 };
                }
                v2 = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(v2);
                e.buf.push_str(" = load i64, ptr ");
                e.buf.push_str(g2);
                e.buf.push_str("\n");
                // 字段类型 Ptr[Inner]：返回解引用标记（.get()/协议链）
                ftp = unwrap_ty(ast, e.ftype_at(si_f, idx));
                if ftp >= 0 && ty_name(ast, ftp) == "Ptr" {
                    inp = ast.aa[ftp];
                    if inp < 0 { inp = ast.tys[ftp]; }
                    inpu = unwrap_ty(ast, inp);
                    inpn = ty_name(ast, inpu);
                    if e.cur_inst_param.len > 0 && inpn == e.cur_inst_param { inpu = e.cur_inst_arg_ty; }
                    elif e.cur_inst_param2.len > 0 && inpn == e.cur_inst_param2 { inpu = e.cur_inst_arg_ty2; }
                    sip = -1;
                    if inpu <= -1000 && inpu > -1128 { sip = 0 - 1000 - inpu; }
                    elif inpu >= 0 { sip = e.find_struct_idx(ty_name(ast, inpu)); }
                    if sip >= 0 {
                        return Val { kind = 0, a = v2, b = e.st_names[sip].copy(), ty = 10001 + sip };
                    }
                }
                return mk_int(v2);
            }
        }
        return mk_int("0");
    }
    if tag == et(ET::CallExpr._tag) {
        // (callee)(args)：字段闭包调用（结构体字段为 Fn 类型）
        callee = ast.aa[id];
        cargs = ast.bb[id];
        if callee >= 0 {
            if ast.tags[callee] == et(ET::Index._tag) {
                // a[i](x)：数组元素闭包（元素为 Lambda 或 Closure 类型）
                arr_ce = ast.aa[callee];
                if arr_ce >= 0 && ast.tags[arr_ce] == et(ET::Ident._tag) {
                    an_ce = ast.texts[arr_ce];
                    ety_ce = e.elem_of_local(an_ce);
                    if ety_ce >= 0 {
                        if ast.tags[ety_ce] == et(ET::Lambda._tag) || ast.tags[ety_ce] == tt(TT::Closure._tag) {
                            av_ce = emit_expr(ast, callee, e);
                            return emit_indirect_call(ast, av_ce.a, ety_ce, cargs, e);
                        }
                    }
                }
            }
            if ast.tags[callee] == et(ET::FieldAccess._tag) {
                obj = emit_expr(ast, ast.aa[callee], e);
                if obj.kind == 2 {
                    si_ce = e.find_struct_idx(obj.b);
                    fi_ce = e.find_field_idx(obj.b, ast.texts[callee]);
                    if si_ce >= 0 && fi_ce >= 0 {
                        fty_ce = e.ftype_at(si_ce, fi_ce);
                        if fty_ce >= 0 {
                            if ast.tags[fty_ce] == tt(TT::Closure._tag) {
                                sl_ce = e.fslot_at(si_ce, fi_ce);
                                g_ce = e.fresh();
                                e.buf.push_str("  ");
                                e.buf.push_str(g_ce);
                                e.buf.push_str(" = getelementptr %struct.");
                                e.buf.push_str(obj.b);
                                e.buf.push_str(", ptr ");
                                e.buf.push_str(obj.a);
                                e.buf.push_str(", i32 0, i32 ");
                                e.buf.push_int(sl_ce);
                                e.buf.push_str("\n  ");
                                fv_ce = e.fresh();
                                e.buf.push_str(fv_ce);
                                e.buf.push_str(" = load i64, ptr ");
                                e.buf.push_str(g_ce);
                                e.buf.push_str("\n");
                                return emit_indirect_call(ast, fv_ce, fty_ce, cargs, e);
                            }
                        }
                    }
                }
            }
        }
        return mk_int("0");
    }
    if tag == et(ET::MethodCall._tag) {
        obj = emit_expr(ast, ast.aa[id], e);
        if obj.kind == 1 {
            mn = ast.texts[id];
            if mn == "len" { return mk_int(obj.b); }
            if mn == "to_string" { return obj; }
            if mn == "is_empty" {
                c = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(c);
                e.buf.push_str(" = icmp eq i64 ");
                e.buf.push_str(obj.b);
                e.buf.push_str(", 0\n");
                z = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(z);
                e.buf.push_str(" = zext i1 ");
                e.buf.push_str(c);
                e.buf.push_str(" to i64\n");
                return mk_int(z);
            }
            // prelude String 方法（std 语义；见 base/prelude.aya）
            if mn == "trim" {
                if e.fn_ret_type("aya_str_trim") >= 0 {
                    return emit_prelude_str("aya_str_trim", obj, obj, 0, 1, e);
                }
            }
            if mn == "to_upper" {
                if e.fn_ret_type("aya_str_to_upper") >= 0 {
                    return emit_prelude_str("aya_str_to_upper", obj, obj, 0, 1, e);
                }
            }
            if mn == "to_lower" {
                if e.fn_ret_type("aya_str_to_lower") >= 0 {
                    return emit_prelude_str("aya_str_to_lower", obj, obj, 0, 1, e);
                }
            }
            if mn == "parse_int" {
                if e.fn_ret_type("aya_str_parse_int") >= 0 {
                    return emit_prelude_str("aya_str_parse_int", obj, obj, 0, 0, e);
                }
            }
            if mn == "is_int" {
                if e.fn_ret_type("aya_str_is_int") >= 0 {
                    return emit_prelude_str("aya_str_is_int", obj, obj, 0, 0, e);
                }
            }
            if mn == "contains" {
                if e.fn_ret_type("aya_str_contains") >= 0 {
                    a_c = emit_expr(ast, ast.aa[ast.bb[id]], e);
                    return emit_prelude_str("aya_str_contains", obj, a_c, 1, 0, e);
                }
            }
            if mn == "index_of" {
                if e.fn_ret_type("aya_str_index_of") >= 0 {
                    a_i = emit_expr(ast, ast.aa[ast.bb[id]], e);
                    return emit_prelude_str("aya_str_index_of", obj, a_i, 1, 0, e);
                }
            }
            if mn == "repeat" {
                if e.fn_ret_type("aya_str_repeat") >= 0 {
                    a_r = emit_expr(ast, ast.aa[ast.bb[id]], e);
                    t_r = e.fresh();
                    e.buf.push_str("  ");
                    e.buf.push_str(t_r);
                    e.buf.push_str(" = call { ptr, i64 } @");
                    e.buf.push_str(e.fn_sym("aya_str_repeat"));
                    e.buf.push_str("(ptr ");
                    e.buf.push_str(ptr_operand(obj.a));
                    e.buf.push_str(", i64 ");
                    e.buf.push_str(obj.b);
                    e.buf.push_str(", i64 ");
                    e.buf.push_str(a_r.a);
                    e.buf.push_str(")\n  ");
                    ip_r = e.fresh();
                    e.buf.push_str(ip_r);
                    e.buf.push_str(" = extractvalue { ptr, i64 } ");
                    e.buf.push_str(t_r);
                    e.buf.push_str(", 0\n  ");
                    il_r = e.fresh();
                    e.buf.push_str(il_r);
                    e.buf.push_str(" = extractvalue { ptr, i64 } ");
                    e.buf.push_str(t_r);
                    e.buf.push_str(", 1\n");
                    return mk_str_tmp(ip_r, il_r);
                }
            }
            if mn == "index" {
                iv = emit_expr(ast, ast.aa[ast.bb[id]], e);
                g = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(g);
                e.buf.push_str(" = getelementptr i8, ptr ");
                e.buf.push_str(obj.a);
                e.buf.push_str(", i64 ");
                e.buf.push_str(iv.a);
                e.buf.push_str("\n  ");
                t8 = e.fresh();
                e.buf.push_str(t8);
                e.buf.push_str(" = load i8, ptr ");
                e.buf.push_str(g);
                e.buf.push_str("\n  ");
                z8 = e.fresh();
                e.buf.push_str(z8);
                e.buf.push_str(" = zext i8 ");
                e.buf.push_str(t8);
                e.buf.push_str(" to i64\n");
                return mk_int(z8);
            }
            if mn == "copy" {
                return emit_str_slice(obj, "0", obj.b, e);
            }
            if mn == "substring" {
                a1 = emit_expr(ast, ast.aa[ast.bb[id]], e);
                a2s = emit_expr(ast, ast.aa[ast.nexts[ast.bb[id]]], e);
                return emit_str_slice(obj, a1.a, a2s.a, e);
            }
            if mn == "add" {
                tadd = emit_expr(ast, ast.aa[ast.bb[id]], e);
                return emit_str_concat(obj, tadd, e);
            }
            if mn == "add" {
                tadd = emit_expr(ast, ast.aa[ast.bb[id]], e);
                return emit_str_concat(obj, tadd, e);
            }
            if mn == "eq" {
                tq = emit_expr(ast, ast.aa[ast.bb[id]], e);
                return emit_str_eq(obj, tq, e);
            }
            if mn == "ne" {
                tq2 = emit_expr(ast, ast.aa[ast.bb[id]], e);
                q2 = emit_str_eq(obj, tq2, e);
                return emit_not(q2, e);
            }
            if mn == "starts_with" {
                tp = emit_expr(ast, ast.aa[ast.bb[id]], e);
                ok = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(ok);
                e.buf.push_str(" = icmp sle i64 ");
                e.buf.push_str(tp.b);
                e.buf.push_str(", ");
                e.buf.push_str(obj.b);
                e.buf.push_str("\n  ");
                r2 = e.fresh();
                e.buf.push_str(r2);
                e.buf.push_str(" = call i32 @memcmp(ptr ");
                e.buf.push_str(tp.a);
                e.buf.push_str(", ptr ");
                e.buf.push_str(obj.a);
                e.buf.push_str(", i64 ");
                e.buf.push_str(tp.b);
                e.buf.push_str(")\n  ");
                e2b = e.fresh();
                e.buf.push_str(e2b);
                e.buf.push_str(" = icmp eq i32 ");
                e.buf.push_str(r2);
                e.buf.push_str(", 0\n  ");
                b2b = e.fresh();
                e.buf.push_str(b2b);
                e.buf.push_str(" = and i1 ");
                e.buf.push_str(ok);
                e.buf.push_str(", ");
                e.buf.push_str(e2b);
                e.buf.push_str("\n  ");
                z2b = e.fresh();
                e.buf.push_str(z2b);
                e.buf.push_str(" = zext i1 ");
                e.buf.push_str(b2b);
                e.buf.push_str(" to i64\n");
                return mk_int(z2b);
            }
            if mn == "ends_with" {
                ts = emit_expr(ast, ast.aa[ast.bb[id]], e);
                ok3 = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(ok3);
                e.buf.push_str(" = icmp sle i64 ");
                e.buf.push_str(ts.b);
                e.buf.push_str(", ");
                e.buf.push_str(obj.b);
                e.buf.push_str("\n  ");
                off3 = e.fresh();
                e.buf.push_str(off3);
                e.buf.push_str(" = sub i64 ");
                e.buf.push_str(obj.b);
                e.buf.push_str(", ");
                e.buf.push_str(ts.b);
                e.buf.push_str("\n  ");
                p3 = e.fresh();
                e.buf.push_str(p3);
                e.buf.push_str(" = getelementptr i8, ptr ");
                e.buf.push_str(obj.a);
                e.buf.push_str(", i64 ");
                e.buf.push_str(off3);
                e.buf.push_str("\n  ");
                r3 = e.fresh();
                e.buf.push_str(r3);
                e.buf.push_str(" = call i32 @memcmp(ptr ");
                e.buf.push_str(ts.a);
                e.buf.push_str(", ptr ");
                e.buf.push_str(p3);
                e.buf.push_str(", i64 ");
                e.buf.push_str(ts.b);
                e.buf.push_str(")\n  ");
                e3b = e.fresh();
                e.buf.push_str(e3b);
                e.buf.push_str(" = icmp eq i32 ");
                e.buf.push_str(r3);
                e.buf.push_str(", 0\n  ");
                b3b = e.fresh();
                e.buf.push_str(b3b);
                e.buf.push_str(" = and i1 ");
                e.buf.push_str(ok3);
                e.buf.push_str(", ");
                e.buf.push_str(e3b);
                e.buf.push_str("\n  ");
                z3b = e.fresh();
                e.buf.push_str(z3b);
                e.buf.push_str(" = zext i1 ");
                e.buf.push_str(b3b);
                e.buf.push_str(" to i64\n");
                return mk_int(z3b);
            }
