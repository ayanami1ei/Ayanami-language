                pi6b = e.fresh();
                e.buf.push_str("  ");
                e.buf.push_str(pi6b);
                e.buf.push_str(" = inttoptr i64 ");
                e.buf.push_str(t5);
                e.buf.push_str(" to ptr\n");
                return Val { kind = 21, a = pi6b, b = rnm6, ty = -1 };
            }
