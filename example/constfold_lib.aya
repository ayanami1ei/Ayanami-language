// A5d-3c：MIR 优化注解 demo —— 常量折叠（依赖编译器 pass 不动点，单轮实现）
import "mir"

fn lt_int(int a, int b) -> int {
    if a < b { return 1 }
    return 0
}

fn gt_int(int a, int b) -> int {
    if a > b { return 1 }
    return 0
}

fn eq_int(int a, int b) -> int {
    if a == b { return 1 }
    return 0
}

fn neq_int(int a, int b) -> int {
    if a != b { return 1 }
    return 0
}

#[pass]
pub fn const_fold(ref mut MirFunction f) {
    if f.node_count == 0 { return }
    n = f.node_count
    size = [int; n]
    i = n - 1
    while i >= 0 {
        s = 1
        c = i + 1
        for k in (0, f.child_counts[i]) {
            s = s + size[c]
            c = c + size[c]
        }
        size[i] = s
        i = i - 1
    }
    for i in (0, n) {
        if f.kinds[i] == 2 {
            if f.child_counts[i] == 2 {
                c1 = i + 1
                c2 = c1 + size[c1]
                if is_int_literal(f, c1) && is_int_literal(f, c2) {
                    a = folded_int(f, c1)
                    b = folded_int(f, c2)
                    v = 0
                    is_cmp = false
                    done = false
                    if op_is_add(f.ops[i]) { v = a + b; done = true }
                    if op_is_sub(f.ops[i]) { v = a - b; done = true }
                    if op_is_mul(f.ops[i]) { v = a * b; done = true }
                    if op_is_lt(f.ops[i]) { is_cmp = true; v = lt_int(a, b) }
                    if op_is_gt(f.ops[i]) { is_cmp = true; v = gt_int(a, b) }
                    if op_is_eq(f.ops[i]) { is_cmp = true; v = eq_int(a, b) }
                    if op_is_neq(f.ops[i]) { is_cmp = true; v = neq_int(a, b) }
                    if done { f.replace_int(i, v) }
                    if is_cmp { f.replace_bool(i, v) }
                }
            }
        }
    }
}
