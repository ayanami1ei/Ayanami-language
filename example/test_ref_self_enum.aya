// #212：ref self 读取泛型 enum 的 _tag（函数返回的实例）
enum Opt2[T] {
    Some(T),
    None,
}

impl[T] Opt2[T] {
    fn is_none(ref self) -> bool {
        return self._tag != 0
    }
}

fn some(usize x) -> Opt2[usize] {
    return Opt2::Some(x)
}

fn none(usize x) -> Opt2[usize] {
    if x == 0 { return Opt2::None() }
    return Opt2::Some(x)
}

fn main() -> int {
    a = some(7)
    if a.is_none() { return 1 }
    b = none(0)
    if !b.is_none() { return 2 }
    c = Opt2::Some(9usize)
    if c.is_none() { return 3 }
    return 0
}
