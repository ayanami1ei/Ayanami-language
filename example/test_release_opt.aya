// M-opt.1：release 语义优化（溢出回绕、所有权推断 noalias、nounwind、opt -O3）
fn sum_squares(int n) -> int {
    s = 0
    i = 0
    while i < n {
        s = s + i * i
        i = i + 1
    }
    return s
}

fn bump(ref mut int x) -> int {
    x = x + 1
    return x
}

fn main() -> int {
    if sum_squares(100) != 328350 { return 1 }
    a = 1
    if bump(a) != 2 { return 2 }
    if a != 2 { return 3 }
    return 0
}
