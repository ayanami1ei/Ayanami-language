// #134：泛型实例作为类型实参的单态化（Option[ArrayList[String]].unwrap_or）
// 修复前符号名残缺（ArrayList_lt_String 缺 _gt_），opt/llc 类型不匹配
import "arraylist"
import "option"

fn main() -> int {
    a = ArrayList::new[String]()
    a.push("x")
    o = Option::Some(a)
    empty = ArrayList::new[String]()
    b = o.unwrap_or(empty)
    if b.len() != 1 { return 1 }
    return 0
}
