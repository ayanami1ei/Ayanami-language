// Phase 1.3（atb.1）：match 字面量 / `_` / 或模式 / guard
enum Color {
    Red,
    Green,
    Blue,
}

enum Opt[T] {
    Some(T),
    None,
}

fn name(int x) -> int {
    return match x {
        0 => 10,
        1 | 2 | 3 => 20,
        n if n < 0 => 30,
        _ => 40,
    }
}

fn kind(Color c) -> int {
    return match c {
        Red => 1,
        Green | Blue => 2,
    }
}

fn flag(bool b) -> int {
    return match b {
        true => 1,
        false => 0,
    }
}

fn letter(char c) -> int {
    return match c {
        'a' | 'b' => 1,
        _ => 0,
    }
}

fn opt_kind(Opt[int] o) -> int {
    return match o {
        Some(v) if v > 10 => 1,
        Some(_) => 2,
        None => 3,
    }
}

fn main() -> int {
    if name(0) != 10 { return 1 }
    if name(2) != 20 { return 2 }
    if name(-5) != 30 { return 3 }
    if name(7) != 40 { return 4 }
    if kind(Color::Red) != 1 { return 5 }
    if kind(Color::Blue) != 2 { return 6 }
    if flag(true) != 1 { return 7 }
    if flag(false) != 0 { return 8 }
    if letter('b') != 1 { return 9 }
    if letter('z') != 0 { return 10 }
    if opt_kind(Opt::Some(20)) != 1 { return 11 }
    if opt_kind(Opt::Some(5)) != 2 { return 12 }
    if opt_kind(Opt::None) != 3 { return 13 }
    return 0
}
