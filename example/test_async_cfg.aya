// A1b-3：通用 async CFG（嵌套 if/while/break/continue + 任意同步语句 + String 局部）。
import "io"
import "option"

enum Poll[T] { Ready(T), Pending }
struct Waker { int id }
impl Waker { fn wake(ref self) { } }
struct Context { Waker waker }
interface Future[T] { fn poll(ref mut self, ref Context cx) -> Poll[T]; }

enum MatchE { A(int), B(int) }
enum MatchS { A(String), B }

struct RangeIter {
    int cur
    int end
}

impl RangeIter {
    #[state]
    fn next(ref mut self) -> Option[int] {
        if self.cur >= self.end { return Option::None }
        v = self.cur
        self.cur = self.cur + 1
        return Option::Some(v)
    }
}

#[state]
fn block_on[F: Future[int]](ref mut F f) -> int {
    cx = Context { waker = Waker { id = 0 } }
    while true {
        match f.poll(ref cx) {
            Ready(v) => { return v }
            Pending => { }
        }
    }
    return -1
}

#[state]
fn block_on_s[F: Future[String]](ref mut F f) -> String {
    cx = Context { waker = Waker { id = 0 } }
    while true {
        match f.poll(ref cx) {
            Ready(v) => { return v }
            Pending => { }
        }
    }
    return ""
}

#[async]
fn inc(int x) -> int { return x + 1 }

#[async]
fn dec(int x) -> int { return x - 1 }

#[async]
fn dbl(int x) -> int { return x * 2 }

#[async]
fn greet() -> String { return "hi" }

#[async]
fn mixed(int x) -> int {
    a = await inc(x)
    b = a + 1
    c = 0
    if b > 10 {
        c = await inc(b)
    } else {
        c = await dec(b)
    }
    while c < 20 {
        c = await inc(c)
        if c == 15 { break }
    }
    return c
}

#[async]
fn nested(int x) -> int {
    y = 0
    while y < 3 {
        if y == 1 {
            y = await inc(y)
        } else {
            y = await inc(y)
        }
        if y == 2 { continue }
        if y == 3 { break }
    }
    return y
}

#[async]
fn pick(int x) -> int {
    y = 0
    if x > 10 {
        y = await inc(x)
    } elif x > 0 {
        y = await dbl(x)
    } else {
        y = await dec(x)
    }
    return y
}

#[async]
fn outer(int x) -> int {
    y = x
    while y < 5 {
        if y == 2 { break }
        y = await inc(y)
        if y == 4 { continue }
        if y == 3 { y = await inc(y) }
    }
    return y
}

#[async]
fn noelse(int x) -> int {
    y = 0
    if x > 0 {
        y = await inc(x)
    }
    z = await inc(y)
    return z
}

#[async]
fn nested_loops(int x) -> int {
    y = 0
    z = 0
    while y < 2 {
        z = 0
        while z < 2 {
            z = await inc(z)
            if z == 2 { break }
        }
        y = await inc(y)
    }
    return y * 10 + z
}

#[async]
fn cont(int x) -> int {
    y = 0
    while y < 4 {
        y = await inc(y)
        if y == 2 { continue }
        if y == 4 { break }
    }
    return y
}

#[async]
fn syncmix(int x) -> int {
    y = await inc(x)
    z = 0
    while z < 3 { z = z + 1 }
    if z == 3 {
        y = await inc(y)
    } else {
        y = await dec(y)
    }
    return y
}

fn plus1(int x) -> int { return x + 1 }

#[async]
fn expr_sum(int x) -> int {
    y = (await inc(x)) + 1
    return y * 2
}

#[async]
fn expr_ret(int x) -> int {
    return (await inc(x)) + (await inc(x + 1))
}

#[async]
fn expr_arg(int x) -> int {
    y = await inc((await inc(x)) + 1)
    return y
}

#[async]
fn expr_product(int x) -> int {
    return (await inc(x)) * (await inc(x))
}

#[async]
fn expr_call(int x) -> int {
    y = plus1(await inc(x))
    return y
}

#[async]
fn expr_if_cond(int x) -> int {
    y = 0
    if (await inc(x)) > 1 {
        y = await inc(x)
    } else {
        y = 0
    }
    return y
}

#[async]
fn for_body(int x) -> int {
    s = 0
    for i in (0, 3) {
        s = s + (await inc(i))
    }
    return s
}

#[async]
fn for_break(int x) -> int {
    s = 0
    for i in (0, 10) {
        s = s + (await inc(i))
        if i == 2 { break }
    }
    return s
}

#[async]
fn for_continue(int x) -> int {
    s = 0
    for i in (0, 4) {
        if i == 1 { continue }
        s = s + (await inc(i))
    }
    return s
}

#[async]
fn for_usize(usize n) -> int {
    s = 0
    for i in (0, n) {
        s = s + (await inc(i as int))
    }
    return s
}

#[async]
fn match_arm(Option[int] v) -> int {
    y = 0
    match v {
        Option::Some(n) => { y = await inc(n) }
        Option::None => { y = 7 }
    }
    return y
}

#[async]
fn match_ret(Option[int] v) -> int {
    match v {
        Option::Some(n) => { return await inc(n) }
        Option::None => { return 7 }
    }
    return 0
}

#[async]
fn match_enum(MatchE v) -> int {
    y = 0
    match v {
        MatchE::A(n) => { y = await inc(n) }
        MatchE::B(n) => { y = await dec(n) }
    }
    return y
}

#[async]
fn match_string(MatchS v) -> String {
    s = ""
    match v {
        MatchS::A(x) => { s = await echo(x) }
        MatchS::B => { s = "b" }
    }
    return s
}

#[async]
fn match_lit(int y) -> int {
    while y < 3 {
        match y {
            0 => { break }
            _ => { }
        }
        y = await inc(y)
    }
    return y
}

#[async]
fn match_guard(Option[int] v) -> int {
    y = 0
    match v {
        Option::Some(n) if n > 0 => { y = await inc(n) }
        Option::Some(n) => { y = 100 + n }
        Option::None => { y = 7 }
    }
    return y
}

#[async]
fn match_break(Option[int] v) -> int {
    y = 0
    while true {
        match v {
            Option::Some(n) => { y = await inc(n); break }
            Option::None => { break }
        }
        y = y
    }
    return y
}

#[async]
fn match_local(int x) -> int {
    v = Option::Some(x)
    y = 0
    match v {
        Option::Some(n) => { y = await inc(n) }
        Option::None => { y = 7 }
    }
    return y
}

#[async]
fn for_in(RangeIter it) -> int {
    s = 0
    for v in it {
        s = s + (await inc(v))
    }
    return s
}

#[async]
fn expr_elif(int x) -> int {
    y = 0
    if x > 10 {
        y = 1
    } elif (await inc(x)) > 1 {
        y = 2
    } else {
        y = 3
    }
    return y
}

#[async]
fn while_cond(int x) -> int {
    y = 0
    while (await inc(y)) < 3 {
        y = y + 1
    }
    return y
}

#[async]
fn while_cond_continue(int x) -> int {
    y = 0
    while (await inc(y)) < 5 {
        y = y + 1
        if y == 2 { continue }
        if y == 4 { break }
    }
    return y
}

#[async]
fn loop_expr(int x) -> int {
    y = 0
    while y < 3 {
        y = (await inc(y)) + 1
    }
    return y
}

#[async]
fn expr_string(int x) -> String {
    s = (await greet()) + "!"
    return s
}

#[async]
fn echo(String s) -> String { return s }

#[async]
fn pass(int x, String s) -> String {
    t = await echo(s)
    u = await echo(t)
    return u
}

#[async]
fn choose_sync(int x) -> int {
    y = 0
    match x {
        0 => { y = 1 }
        _ => { y = 2 }
    }
    z = await inc(y)
    return z
}

#[async]
fn join(int x) -> String {
    s = "a"
    t = await greet()
    s = s + t
    if x > 0 {
        s = s + "!"
    } else {
        s = s + "?"
    }
    u = await greet()
    return s + u
}

fn main() -> int {
    f1 = mixed(5)
    if block_on(ref mut f1) != 15 { return 1 }
    f2 = mixed(20)
    if block_on(ref mut f2) != 23 { return 2 }
    f3 = nested(0)
    if block_on(ref mut f3) != 3 { return 3 }
    f4 = pick(20)
    if block_on(ref mut f4) != 21 { return 4 }
    f5 = pick(5)
    if block_on(ref mut f5) != 10 { return 5 }
    f6 = pick(-2)
    if block_on(ref mut f6) != -3 { return 6 }
    f7 = outer(0)
    if block_on(ref mut f7) != 2 { return 7 }
    f8 = outer(9)
    if block_on(ref mut f8) != 9 { return 8 }
    f9 = noelse(2)
    if block_on(ref mut f9) != 4 { return 9 }
    f10 = noelse(0)
    if block_on(ref mut f10) != 1 { return 10 }
    f11 = nested_loops(0)
    if block_on(ref mut f11) != 22 { return 11 }
    f12 = cont(0)
    if block_on(ref mut f12) != 4 { return 12 }
    f13 = syncmix(1)
    if block_on(ref mut f13) != 3 { return 13 }
    f14 = syncmix(0)
    if block_on(ref mut f14) != 2 { return 14 }
    s1 = join(1)
    if block_on_s(ref mut s1) != "ahi!hi" { return 15 }
    s2 = join(0)
    if block_on_s(ref mut s2) != "ahi?hi" { return 16 }
    s3 = pass(1, "yo")
    if block_on_s(ref mut s3) != "yo" { return 17 }
    f15 = choose_sync(0)
    if block_on(ref mut f15) != 2 { return 18 }
    f16 = choose_sync(9)
    if block_on(ref mut f16) != 3 { return 19 }
    f17 = expr_sum(1)
    if block_on(ref mut f17) != 6 { return 20 }
    f18 = expr_ret(1)
    if block_on(ref mut f18) != 5 { return 21 }
    f19 = expr_arg(1)
    if block_on(ref mut f19) != 4 { return 22 }
    f20 = expr_product(2)
    if block_on(ref mut f20) != 9 { return 23 }
    f21 = expr_call(1)
    if block_on(ref mut f21) != 3 { return 24 }
    s4 = expr_string(1)
    if block_on_s(ref mut s4) != "hi!" { return 25 }
    f22 = expr_if_cond(1)
    if block_on(ref mut f22) != 2 { return 26 }
    f23 = expr_if_cond(-1)
    if block_on(ref mut f23) != 0 { return 27 }
    f24 = loop_expr(0)
    if block_on(ref mut f24) != 4 { return 28 }
    f25 = while_cond(0)
    if block_on(ref mut f25) != 2 { return 29 }
    f26 = while_cond_continue(0)
    if block_on(ref mut f26) != 4 { return 30 }
    f27 = expr_elif(20)
    if block_on(ref mut f27) != 1 { return 31 }
    f28 = expr_elif(1)
    if block_on(ref mut f28) != 2 { return 32 }
    f29 = expr_elif(-2)
    if block_on(ref mut f29) != 3 { return 33 }
    f30 = for_body(0)
    if block_on(ref mut f30) != 6 { return 34 }
    f31 = for_break(0)
    if block_on(ref mut f31) != 6 { return 35 }
    f32 = for_usize(3usize)
    if block_on(ref mut f32) != 6 { return 36 }
    f33 = for_continue(0)
    if block_on(ref mut f33) != 8 { return 37 }
    it = RangeIter { cur = 0, end = 3 }
    f34 = for_in(it)
    if block_on(ref mut f34) != 6 { return 38 }
    f35 = match_arm(Option::Some(2))
    if block_on(ref mut f35) != 3 { return 39 }
    f36 = match_arm(Option::None)
    if block_on(ref mut f36) != 7 { return 40 }
    f37 = match_ret(Option::Some(2))
    if block_on(ref mut f37) != 3 { return 41 }
    f38 = match_ret(Option::None)
    if block_on(ref mut f38) != 7 { return 42 }
    f39 = match_enum(MatchE::A(1))
    if block_on(ref mut f39) != 2 { return 43 }
    f40 = match_enum(MatchE::B(1))
    if block_on(ref mut f40) != 0 { return 44 }
    f41 = match_break(Option::Some(2))
    if block_on(ref mut f41) != 3 { return 45 }
    f42 = match_break(Option::None)
    if block_on(ref mut f42) != 0 { return 46 }
    f43 = match_local(2)
    if block_on(ref mut f43) != 3 { return 47 }
    s5 = match_string(MatchS::A("hi"))
    if block_on_s(ref mut s5) != "hi" { return 48 }
    s6 = match_string(MatchS::B)
    if block_on_s(ref mut s6) != "b" { return 49 }
    f44 = match_lit(0)
    if block_on(ref mut f44) != 0 { return 50 }
    f45 = match_guard(Option::Some(2))
    if block_on(ref mut f45) != 3 { return 51 }
    f46 = match_guard(Option::Some(-1))
    if block_on(ref mut f46) != 99 { return 52 }
    f47 = match_guard(Option::None)
    if block_on(ref mut f47) != 7 { return 53 }
    return 0
}
