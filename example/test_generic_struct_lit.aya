// 多参数/嵌套泛型结构体字面量（Pair[A, B] { ... } / Box[Pair[int, int]] { ... }）
struct Pair[A, B] {
    A a
    B b
}

struct Box[T] {
    T v
}

fn main() -> int {
    p = Pair[int, int] { a = 1, b = 2 }
    q = Box[Pair[int, int]] { v = p }
    if q.v.a != 1 { return 1 }
    if q.v.b != 2 { return 2 }
    return 0
}
