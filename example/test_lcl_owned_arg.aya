// #73：.lcl 函数调用的 owned 数组实参必须被标记移动（不得悬空）
import "io";
import "string";

fn mk() -> String {
    buf = [char; 2]
    buf[0] = 'A'
    buf[1] = 'B'
    return String::new(buf, 2)
}

fn main() -> int {
    a = mk()
    t = "XYZ"
    if char_code(a.index(0)) != 65 { return 1 }
    if char_code(a.index(1)) != 66 { return 2 }
    return 0
}
