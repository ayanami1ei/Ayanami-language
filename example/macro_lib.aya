// A5b：宏库示例（编译期执行，见 test_macro.aya）
import "string"

#[alloc]
#[macro]
pub fn answer() -> String { return "fn answer() -> int { return 42 }" }

// A5b-3：宏实参（input = item 源码；其后依次是实参的源码文本）
#[macro]
pub fn keep(String input) -> String { return input }

#[alloc]
#[state]
#[macro]
pub fn emit_const(String input, String name, String value) -> String {
    return "fn " + name + "() -> int { return " + value + " }"
}

// 字符串字面量实参按源码文本传入（含引号），可直接拼进生成源码
#[alloc]
#[state]
#[macro]
pub fn show(String input, String arg) -> String {
    return "fn shown() -> String { return " + arg + " }"
}

// A5c-1：语句级宏（input = 语句源码；输出可展开为多条语句）
#[alloc]
#[state]
#[macro]
pub fn twice(String input) -> String { return input + input }

#[alloc]
#[state]
#[macro]
pub fn guarded(String input, String cond) -> String {
    return "if " + cond + " {" + input + "}"
}

// A5c-2：函数宏（表达式级，调用形式 `#double(3)`）
#[alloc]
#[state]
#[macro]
pub fn double(String input, String x) -> String { return "(" + x + " + " + x + ")" }

// 调用点信息（Rust 风格 line/column/file 的等价物：保留参数 __line/__col/__file）
#[macro]
pub fn my_line(String input, int __line, int __col) -> String { return "" + __line }

// #88：函数宏块实参 —— 第二参数为块源码文本（`#block_len({ ... })`）
#[alloc]
#[state]
#[macro]
pub fn block_len(String input, String block) -> String {
    return (block.len() as int).to_string()
}

// mcl.1：token 宏（`#[macro(tokens)]`）——输入/输出为 TokenStream 编码字节
// （String 承载，二进制安全；宏侧可直接拼接/切片）
#[macro(tokens)]
pub fn tok_keep(String input) -> String { return input }

// 语句级：输入 token 流重复两遍（`v = v + 1;` → 两条语句）
#[macro(tokens)]
pub fn tok_twice(String input) -> String { return input + input }

// mcl.2：hygiene —— 生成名加宏 id 后缀（不捕获调用点同名函数、不泄漏）
// 编译器 shim 提供（宏内可直接声明 extern 使用）：
extern "C" fn __ayanami_macro_hygienic(String name) -> String;
extern "C" fn __ayanami_macro_diag(int level, String msg) -> void;

#[alloc]
#[state]
#[macro]
pub fn hygienic_fn(String input, String name) -> String {
    h = __ayanami_macro_hygienic(name)
    return "fn " + h + "() -> int { return 9 }\nfn hygienic_call() -> int { return " + h + "() }"
}

// mcl.2：诊断通道（1=warn 编译继续；2=error 编译失败）
#[macro]
pub fn warn_me(String input) -> String {
    __ayanami_macro_diag(1, "warn_me: demo warning")
    return input
}

#[macro]
pub fn err_me(String input) -> String {
    __ayanami_macro_diag(2, "err_me: demo error")
    return input
}
