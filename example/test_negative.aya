// A6：负数与混合基元类型运算（char→int、int→float 自动提升）
fn take(int x) -> int { return x }

fn main() -> int {
    // 负数字面量 / 一元负号
    a = -5
    if a != -5 { return 1 }
    b = -5.0
    if b != -5.0 { return 2 }
    c = 3 - -5
    if c != 8 { return 3 }
    x = 4
    d = -x
    if d != -4 { return 4 }
    e = -x + 1
    if e != -3 { return 5 }
    f = x * -2
    if f != -8 { return 6 }

    // 数组与实参里的负数
    arr = [-1, -2, -3]
    if arr[0] != -1 { return 7 }
    if take(-7) != -7 { return 8 }

    // 混合类型：int op float
    if 1 + 2.5 != 3.5 { return 9 }
    if 2.5 + 1 != 3.5 { return 10 }
    if 1.5 - 2 != -0.5 { return 11 }
    if x / 4.0 != 1.0 { return 12 }
    if 2.0 * 3 != 6.0 { return 13 }
    if 2 - -2.5 != 4.5 { return 14 }

    // 混合比较
    if x < 3.5 != false { return 15 }
    if 2.5 > x != false { return 16 }

    // char 与 int
    if 'a' != 97 { return 17 }
    if 'b' <= 98 != true { return 18 }
    g = 'a' + 1
    if g != 98 { return 19 }

    return 0
}
