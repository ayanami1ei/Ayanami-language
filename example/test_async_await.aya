    if block_on(ref mut x10) != 20 { return 51 }
    x11 = choose_post(1)
    if block_on(ref mut x11) != 30 { return 52 }
    x12 = choose_post(-2)
    if block_on(ref mut x12) != -20 { return 53 }
    x13 = choose_post2(1)
    if block_on(ref mut x13) != 40 { return 54 }
    x14 = choose_post2(-2)
    if block_on(ref mut x14) != -10 { return 55 }
    x15 = elif_post(20)
    if block_on(ref mut x15) != 220 { return 56 }
    x16 = elif_post(5)
    if block_on(ref mut x16) != 110 { return 57 }
    x17 = elif_post(-2)
    if block_on(ref mut x17) != -20 { return 58 }
    x18 = elif_post2(20)
    if block_on(ref mut x18) != 230 { return 59 }
    x19 = elif_post2(5)
    if block_on(ref mut x19) != 120 { return 60 }
    x20 = elif_post2(-2)
    if block_on(ref mut x20) != -10 { return 61 }
    x21 = if_multi_post(1)
    if block_on(ref mut x21) != 40 { return 62 }
    x22 = if_multi_post(0)
    if block_on(ref mut x22) != 10 { return 63 }
