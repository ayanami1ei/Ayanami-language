// A1b-2 第一切片：单挂起点 await（目标为同程序 #[async] 函数）
import "io"

enum Poll[T] { Ready(T), Pending }
struct Waker { int id }
impl Waker { fn wake(ref self) { } }
struct Context { Waker waker }
interface Future[T] { fn poll(ref mut self, ref Context cx) -> Poll[T]; }

#[async]
fn inc(int x) -> int {
    return x + 1
}

#[async]
fn twice(int x) -> int {
    y = await inc(x)
    return y + 1
}

#[async]
fn greet() -> String {
    return "hi"
}

#[async]
fn exclaim() -> String {
    s = await greet()
    return s + "!"
}

#[async]
fn add2(int x) -> int {
    return x + 2
}

#[async]
fn chain(int x) -> int {
    a = await inc(x)
    b = await add2(x)
    return a + b
}

#[async]
fn dep(int x) -> int {
    a = await inc(x)
    b = await add2(a)
    return b
}

#[async]
fn maybe(int x) -> int {
    y = 0
    if x > 0 {
        y = await inc(x)
    }
    return y + 10
}

#[async]
fn loop3(int x) -> int {
    y = 0
    while y < 3 {
        y = await inc(y)
    }
    return y * 10
}

#[async]
fn dec(int x) -> int {
    return x - 1
}

#[async]
fn choose(int x) -> int {
    y = 0
    if x > 0 {
        y = await inc(x)
    } else {
        y = await dec(x)
    }
    return y * 10
}

#[async]
fn dbl(int x) -> int {
    return x * 2
}

#[async]
fn pick3(int x) -> int {
    y = 0
    if x > 10 {
        y = await inc(x)
    } elif x > 0 {
        y = await dbl(x)
    } else {
        y = await dec(x)
    }
    return y
}

#[async]
fn find(int limit) -> int {
    y = 0
    while y < 10 {
        if y == limit { break }
        y = await inc(y)
    }
    return y * 10
}

#[async]
fn find_after(int limit) -> int {
    y = 0
    while y < 10 {
        y = await inc(y)
        if y == limit { break }
    }
    return y * 10
}

#[async]
fn find_ctl(int limit) -> int {
    y = 0
    while y < 10 {
        y = await inc(y)
        if y == 2 { continue }
        if y == limit { break }
    }
    return y * 10
}

#[async]
fn double_inc(int limit) -> int {
    y = 0
    while y < limit {
        y = await inc(y)
        y = await inc(y)
    }
    return y
}

#[async]
fn triple_inc(int limit) -> int {
    y = 0
    while y < limit {
        y = await inc(y)
        y = await inc(y)
        y = await inc(y)
    }
    return y
}

#[async]
fn double_find(int limit) -> int {
    y = 0
    while y < 10 {
        y = await inc(y)
        y = await inc(y)
        if y == limit { break }
    }
    return y
}

#[state]
fn block_on_s[F: Future[String]](ref mut F f) -> String {
    w = Waker { id = 1 }
    cx = Context { waker = w }
    while true {
        p = f.poll(ref cx)
        match p {
            Ready(v) => { return v }
            Pending => { }
        }
    }
    return ""
}

#[state]
fn block_on[F: Future[int]](ref mut F f) -> int {
    w = Waker { id = 1 }
    cx = Context { waker = w }
    while true {
        p = f.poll(ref cx)
        match p {
            Ready(v) => { return v }
            Pending => { }
        }
    }
    return -1
}

fn main() -> int {
    f = twice(1)
    if block_on(ref mut f) != 3 { return 1 }
    g = inc(5)
    if block_on(ref mut g) != 6 { return 2 }
    h = exclaim()
    if block_on_s(ref mut h) != "hi!" { return 3 }
    k = chain(1)
    if block_on(ref mut k) != 5 { return 4 }
    d = dep(1)
    if block_on(ref mut d) != 4 { return 5 }
    e = maybe(1)
    if block_on(ref mut e) != 12 { return 6 }
    z = maybe(0)
    if block_on(ref mut z) != 10 { return 7 }
    l = loop3(0)
    if block_on(ref mut l) != 30 { return 8 }
    p1 = choose(2)
    if block_on(ref mut p1) != 30 { return 9 }
    p2 = choose(-2)
    if block_on(ref mut p2) != -30 { return 10 }
    q1 = pick3(20)
    if block_on(ref mut q1) != 21 { return 11 }
    q2 = pick3(5)
    if block_on(ref mut q2) != 10 { return 12 }
    q3 = pick3(-3)
    if block_on(ref mut q3) != -4 { return 13 }
    r1 = find(3)
    if block_on(ref mut r1) != 30 { return 14 }
    r2 = find(0)
    if block_on(ref mut r2) != 0 { return 15 }
    r3 = find_after(3)
    if block_on(ref mut r3) != 30 { return 16 }
    r4 = find_ctl(4)
    if block_on(ref mut r4) != 40 { return 17 }
    r5 = find_ctl(2)
    if block_on(ref mut r5) != 100 { return 18 }
    r6 = double_inc(5)
    if block_on(ref mut r6) != 6 { return 19 }
    r7 = double_inc(8)
    if block_on(ref mut r7) != 8 { return 20 }
    r8 = triple_inc(4)
    if block_on(ref mut r8) != 6 { return 21 }
    r9 = double_find(4)
    if block_on(ref mut r9) != 4 { return 22 }
    return 0
}
