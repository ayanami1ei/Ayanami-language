    r2 = find(0)
    if block_on(ref mut r2) != 0 { return 15 }
    r3 = find_after(3)
    if block_on(ref mut r3) != 30 { return 16 }
    r4 = find_ctl(4)
    if block_on(ref mut r4) != 40 { return 17 }
    r5 = find_ctl(2)
    if block_on(ref mut r5) != 100 { return 18 }
    r6 = double_inc(5)
    if block_on(ref mut r6) != 6 { return 19 }
    r7 = double_inc(8)
    if block_on(ref mut r7) != 8 { return 20 }
    r8 = triple_inc(4)
    if block_on(ref mut r8) != 6 { return 21 }
    r9 = double_find(4)
    if block_on(ref mut r9) != 4 { return 22 }
    s1 = if_double(1)
    if block_on(ref mut s1) != 30 { return 23 }
    s2 = if_double(0)
    if block_on(ref mut s2) != 0 { return 24 }
    s3 = if_triple(1)
    if block_on(ref mut s3) != 4 { return 25 }
    t1 = choose_double(1)
    if block_on(ref mut t1) != 30 { return 26 }
    t2 = choose_double(-2)
    if block_on(ref mut t2) != -40 { return 27 }
    t3 = choose_asym(1)
    if block_on(ref mut t3) != 20 { return 28 }
    t4 = choose_asym(-1)
    if block_on(ref mut t4) != -30 { return 29 }
    u1 = pick_multi(20)
    if block_on(ref mut u1) != 22 { return 30 }
    u2 = pick_multi(5)
    if block_on(ref mut u2) != 11 { return 31 }
    u3 = pick_multi(-2)
    if block_on(ref mut u3) != -4 { return 32 }
    u4 = pick_mix(20)
    if block_on(ref mut u4) != 21 { return 33 }
    u5 = pick_mix(5)
    if block_on(ref mut u5) != 11 { return 34 }
    u6 = pick_mix(-2)
    if block_on(ref mut u6) != -3 { return 35 }
    v1 = mixed(1)
    if block_on(ref mut v1) != 4 { return 36 }
    v2 = pre_sync(1)
    if block_on(ref mut v2) != 30 { return 37 }
    v3 = str_mixed()
    if block_on(ref mut v3) != 6 { return 38 }
    v4 = str_call(1)
    if block_on(ref mut v4) != 4 { return 39 }
    w1 = expr_arg(1)
    if block_on(ref mut w1) != 5 { return 40 }
    w2 = call_arg(1)
    if block_on(ref mut w2) != 4 { return 41 }
    x1 = branch_sync(1)
    if block_on(ref mut x1) != 4 { return 42 }
    x2 = branch_sync(10)
    if block_on(ref mut x2) != 11 { return 43 }
    x3 = loop_sync(1)
    if block_on(ref mut x3) != 3 { return 44 }
    x4 = while_post(0)
    if block_on(ref mut x4) != 40 { return 45 }
    x5 = while_post_str(0)
    if block_on(ref mut x5) != 5 { return 46 }
    x6 = while_post2(0)
    if block_on(ref mut x6) != 40 { return 47 }
    x7 = if_post(1)
    if block_on(ref mut x7) != 30 { return 48 }
    x8 = if_post(0)
    if block_on(ref mut x8) != 10 { return 49 }
