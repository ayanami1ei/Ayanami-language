// A1b-2 第一切片：单挂起点 await（目标为同程序 #[async] 函数）
import "io"

enum Poll[T] { Ready(T), Pending }
struct Waker { int id }
impl Waker { fn wake(ref self) { } }
struct Context { Waker waker }
interface Future[T] { fn poll(ref mut self, ref Context cx) -> Poll[T]; }

#[async]
fn inc(int x) -> int {
    return x + 1
}

#[async]
fn twice(int x) -> int {
    y = await inc(x)
    return y + 1
}

#[async]
fn greet() -> String {
    return "hi"
}

#[async]
fn exclaim() -> String {
    s = await greet()
    return s + "!"
}

#[async]
fn add2(int x) -> int {
    return x + 2
}

#[async]
fn chain(int x) -> int {
    a = await inc(x)
    b = await add2(x)
    return a + b
}

#[async]
fn dep(int x) -> int {
    a = await inc(x)
    b = await add2(a)
    return b
}

#[async]
fn maybe(int x) -> int {
    y = 0
    if x > 0 {
        y = await inc(x)
    }
    return y + 10
}

#[async]
fn loop3(int x) -> int {
    y = 0
    while y < 3 {
        y = await inc(y)
    }
    return y * 10
}

#[async]
fn dec(int x) -> int {
    return x - 1
}

#[async]
fn choose(int x) -> int {
    y = 0
    if x > 0 {
        y = await inc(x)
    } else {
        y = await dec(x)
    }
    return y * 10
}

#[async]
fn dbl(int x) -> int {
    return x * 2
}

#[async]
fn pick3(int x) -> int {
    y = 0
    if x > 10 {
        y = await inc(x)
    } elif x > 0 {
        y = await dbl(x)
    } else {
        y = await dec(x)
    }
    return y
}

#[async]
fn pick_multi(int x) -> int {
    y = 0
    if x > 10 {
        y = await inc(x)
        y = await inc(y)
    } elif x > 0 {
        y = await dbl(x)
        y = await inc(y)
    } else {
        y = await dec(x)
        y = await dec(y)
    }
    return y
}

#[async]
fn pick_mix(int x) -> int {
    y = 0
    if x > 10 {
        y = await inc(x)
    } elif x > 0 {
        y = await dbl(x)
        y = await inc(y)
    } else {
        y = await dec(x)
    }
    return y
}

#[async]
fn choose_double(int x) -> int {
    y = 0
    if x > 0 {
        y = await inc(x)
        y = await inc(y)
    } else {
        y = await dec(x)
        y = await dec(y)
    }
    return y * 10
}

#[async]
fn choose_asym(int x) -> int {
    y = 0
    if x > 0 {
        y = await inc(x)
    } else {
        y = await dec(x)
        y = await dec(y)
    }
    return y * 10
}

#[async]
fn if_double(int x) -> int {
    y = 0
    if x > 0 {
        y = await inc(x)
        y = await inc(y)
    }
    return y * 10
}

#[async]
fn if_triple(int x) -> int {
    y = 0
    if x > 0 {
        y = await inc(x)
        y = await inc(y)
        y = await inc(y)
    }
    return y
}

#[async]
fn find(int limit) -> int {
    y = 0
    while y < 10 {
        if y == limit { break }
        y = await inc(y)
    }
    return y * 10
}

#[async]
fn find_after(int limit) -> int {
    y = 0
    while y < 10 {
        y = await inc(y)
        if y == limit { break }
    }
    return y * 10
}

#[async]
fn find_ctl(int limit) -> int {
    y = 0
    while y < 10 {
        y = await inc(y)
        if y == 2 { continue }
        if y == limit { break }
    }
    return y * 10
}

#[async]
fn double_inc(int limit) -> int {
    y = 0
    while y < limit {
        y = await inc(y)
        y = await inc(y)
    }
    return y
}

#[async]
fn triple_inc(int limit) -> int {
    y = 0
    while y < limit {
        y = await inc(y)
        y = await inc(y)
        y = await inc(y)
    }
    return y
}

#[async]
fn double_find(int limit) -> int {
    y = 0
    while y < 10 {
        y = await inc(y)
        y = await inc(y)
        if y == limit { break }
    }
    return y
}

#[async]
fn mixed(int x) -> int {
    a = await inc(x)
    b = a + 1
    c = await inc(b)
    return c
}

#[async]
fn pre_sync(int x) -> int {
    p = x + 1
    a = await inc(p)
    return a * 10
}

#[async]
fn str_mixed() -> int {
    s = await exclaim()
    n = s.len as int
    t = await exclaim()
    return n + t.len as int
}

#[async]
fn str_call(int x) -> int {
    a = await inc(x)
    s = a.to_string()
    b = await inc(a)
    return s.len as int + b
}

#[async]
fn expr_arg(int x) -> int {
    a = await inc(x)
    n = a + 1
    c = await inc(n + 1)
    return c
}

#[async]
fn call_arg(int x) -> int {
    a = await inc(x)
    s = a.to_string()
    b = await inc(a + s.len as int)
    return b
}

#[async]
fn branch_sync(int x) -> int {
    a = await inc(x)
    if a > 5 {
        a = 10
    } else {
        a = a + 1
    }
    b = await inc(a)
    return b
}

#[async]
fn loop_sync(int x) -> int {
    a = await inc(x)
    i = 0
    while i < a {
        i = i + 1
        if i == 2 { continue }
    }
    b = await inc(i)
    return b
}

#[async]
fn while_post(int x) -> int {
    y = 0
    while y < 3 {
        y = await inc(y)
    }
    z = await inc(y)
    return z * 10
}

#[async]
fn while_post_str(int x) -> int {
    y = 0
    while y < 2 {
        y = await inc(y)
    }
    s = await exclaim()
    return s.len as int + y
}

#[async]
fn while_post2(int x) -> int {
    y = 0
    while y < 2 {
        y = await inc(y)
    }
    a = await inc(y)
    b = await inc(a)
    return b * 10
}

