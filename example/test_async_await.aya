#[state]
fn block_on_s[F: Future[String]](ref mut F f) -> String {
    w = Waker { id = 1 }
    cx = Context { waker = w }
    while true {
        p = f.poll(ref cx)
        match p {
            Ready(v) => { return v }
            Pending => { }
        }
    }
    return ""
}

#[state]
fn block_on[F: Future[int]](ref mut F f) -> int {
    w = Waker { id = 1 }
    cx = Context { waker = w }
    while true {
        p = f.poll(ref cx)
        match p {
            Ready(v) => { return v }
            Pending => { }
        }
    }
    return -1
}

fn main() -> int {
    f = twice(1)
    if block_on(ref mut f) != 3 { return 1 }
    g = inc(5)
    if block_on(ref mut g) != 6 { return 2 }
    h = exclaim()
    if block_on_s(ref mut h) != "hi!" { return 3 }
    k = chain(1)
    if block_on(ref mut k) != 5 { return 4 }
    d = dep(1)
    if block_on(ref mut d) != 4 { return 5 }
    e = maybe(1)
    if block_on(ref mut e) != 12 { return 6 }
    z = maybe(0)
    if block_on(ref mut z) != 10 { return 7 }
    l = loop3(0)
    if block_on(ref mut l) != 30 { return 8 }
    p1 = choose(2)
    if block_on(ref mut p1) != 30 { return 9 }
    p2 = choose(-2)
    if block_on(ref mut p2) != -30 { return 10 }
    q1 = pick3(20)
