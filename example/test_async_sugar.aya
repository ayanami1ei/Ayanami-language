// A1b 第一切片：`#[async]`（无 await）→ 普通 Fut 结构 + poll；调用方用 block_on
import "io"

enum Poll[T] {
    Ready(T),
    Pending,
}

struct Waker {
    int id
}

impl Waker {
    fn wake(ref self) {
    }
}

struct Context {
    Waker waker
}

interface Future[T] {
    fn poll(ref mut self, ref Context cx) -> Poll[T];
}

#[async]
fn sum2(int a, int b) -> int {
    return a + b
}

#[async]
fn pick(int a, int b, int c) -> int {
    if a > b {
        return a + c
    }
    return b + c
}

#[async]
fn identity[T](T v) -> T {
    return v
}

struct Counter {
    int n
}

impl Counter {
    #[async]
    fn add(ref self, int x) -> int {
        return self.n + x
    }

    #[async]
    #[state]
    fn bump(ref mut self) -> int {
        self.n = self.n + 1;
        return self.n
    }
}

#[state]
fn block_on[F: Future[int]](ref mut F f) -> int {
    w = Waker { id = 1 }
    cx = Context { waker = w }
    while true {
        p = f.poll(ref cx)
        match p {
            Ready(v) => { return v }
            Pending => { }
        }
    }
    return -1
}

#[state]
fn block_on_bool[F: Future[bool]](ref mut F f) -> bool {
    w = Waker { id = 2 }
    cx = Context { waker = w }
    while true {
        p = f.poll(ref cx)
        match p {
            Ready(v) => { return v }
            Pending => { }
        }
    }
    return false
}

fn main() -> int {
    if block_on(sum2(1, 2)) != 3 { return 1 }
    if block_on(pick(1, 2, 3)) != 5 { return 2 }
    if block_on(pick(2, 1, 3)) != 5 { return 3 }
    if block_on(identity(7)) != 7 { return 4 }
    if block_on_bool(identity(true)) != true { return 5 }
    mut c = Counter { n = 10 }
    if block_on(c.add(5)) != 15 { return 6 }
    if block_on(c.bump()) != 11 { return 7 }
    return 0
}
