// A1b 第一切片：`#[async]`（无 await）→ 普通 Fut 结构 + poll；调用方用 block_on
import "io"

enum Poll[T] {
    Ready(T),
    Pending,
}

struct Waker {
    int id
}

impl Waker {
    fn wake(ref self) {
    }
}

struct Context {
    Waker waker
}

interface Future[T] {
    fn poll(ref mut self, ref Context cx) -> Poll[T];
}

#[async]
fn sum2(int a, int b) -> int {
    return a + b
}

#[async]
fn pick(int a, int b, int c) -> int {
    if a > b {
        return a + c
    }
    return b + c
}

#[state]
fn block_on[F: Future[int]](ref mut F f) -> int {
    w = Waker { id = 1 }
    cx = Context { waker = w }
    while true {
        p = f.poll(ref cx)
        match p {
            Ready(v) => { return v }
            Pending => { }
        }
    }
    return -1
}

fn main() -> int {
    if block_on(sum2(1, 2)) != 3 { return 1 }
    if block_on(pick(1, 2, 3)) != 5 { return 2 }
    if block_on(pick(2, 1, 3)) != 5 { return 3 }
    return 0
}
