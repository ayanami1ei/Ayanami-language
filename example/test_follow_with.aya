// A4a：注解式生命周期语法/校验（借用检查接入在 A4b）
struct S {
    int x
}

// 返回引用跟随参数 s（单引用省略规则下也可写，显式更清晰）
#[follow_with(s)]
fn pick(ref S s) -> ref S { return s }

// 多来源：返回引用跟随 a（生命周期取最短）
#[follow_with(a)]
fn first(ref S a, ref S b) -> ref S { return a }

struct Holder {
    // 字段引用跟随 owner（实例不晚于被引用对象失效）
    #[follow_with(owner)]
    ref S item
}

// 字段存引用：以实例为键登记 loan（v1：实例不可移动/返回）
fn read_item(ref S s) -> int {
    h = Holder { item = s }
    return 0
}

// 跨函数传播：调用结果按被调函数的 follow_with 绑定实参来源
#[follow_with(b)]
fn pick_second(ref S a, ref S b) -> ref S { return b }

#[follow_with(y)]
fn caller(ref S x, ref S y) -> ref S {
    r = pick_second(x, y)
    return r
}

// 多来源联合约束：结果同时绑定 x 与 y（生命周期取最短）
#[follow_with(b, a)]
fn pick_ab(ref S a, ref S b) -> ref S { return b }

#[follow_with(x, y)]
fn joint(ref S x, ref S y) -> ref S {
    r = pick_ab(x, y)
    return r
}

fn main() -> int {
    return 0
}
