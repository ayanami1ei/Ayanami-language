// A5d-3：MIR body 改写（常量折叠）+ 应用后重跑借用检查
import "constfold_lib.aya"

#[constfold_lib::const_fold]
fn folded() -> int {
    return 1 + 2 + 3
}

#[constfold_lib::const_fold]
fn folded_mul() -> int {
    return 2 * 3 + 4 * 5
}

// 比较折叠为 bool 字面量（1 < 2 恒真）
#[constfold_lib::const_fold]
fn folded_cmp_true() -> int {
    if 1 < 2 { return 7 }
    return 0
}

#[constfold_lib::const_fold]
fn folded_cmp_false() -> int {
    if 3 < 2 { return 1 }
    return 9
}

fn main() -> int {
    if folded() != 6 { return 1 }
    if folded_mul() != 26 { return 2 }
    if folded_cmp_true() != 7 { return 3 }
    if folded_cmp_false() != 9 { return 4 }
    return 0
}
