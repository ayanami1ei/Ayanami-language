// P2 枚举 payload 释放验证：非活跃变体零初始化，drop 后无存活分配
extern "C" fn __ayanami_live_allocs() -> int;

struct Point {
    int x
    int y
}

enum Maybe {
    Some(unique Point),
    None,
}

fn make() -> int {
    p = Point { x = 1, y = 2 };
    a = Maybe::Some(unique p);
    b = Maybe::None;
    return 0;
}

fn main() -> int {
    make();
    return __ayanami_live_allocs();
}
