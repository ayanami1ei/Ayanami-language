// Phase 1.3（atb.2）：嵌套模式 / 结构体解构 / 区间模式
enum Opt[T] {
    Some(T),
    None,
}

struct Point {
    int x
    int y
}

fn nested(Opt[Opt[int]] o) -> int {
    return match o {
        Some(Some(v)) => v,
        Some(None) => 0 - 1,
        None => 0 - 2,
    }
}

fn destr(Point p) -> int {
    return match p {
        Point { x, y } => x * 10 + y,
    }
}

fn destr_rename(Point p) -> int {
    return match p {
        Point { x = a, y = b } => a - b,
    }
}

fn ranged(int n) -> int {
    return match n {
        0 => 100,
        1..10 => 200,
        10..=20 => 300,
        _ => 400,
    }
}

fn nested_struct(Opt[Point] o) -> int {
    return match o {
        Some(Point { x, y }) => x + y,
        None => 0 - 1,
    }
}

fn main() -> int {
    if nested(Opt::Some(Opt::Some(7))) != 7 { return 1 }
    if nested(Opt::Some(Opt::None)) != 0 - 1 { return 2 }
    if nested(Opt::None) != 0 - 2 { return 3 }
    p = Point { x = 3, y = 4 }
    if destr(p) != 34 { return 4 }
    if destr_rename(p) != 0 - 1 { return 5 }
    if ranged(0) != 100 { return 6 }
    if ranged(5) != 200 { return 7 }
    if ranged(10) != 300 { return 8 }
    if ranged(20) != 300 { return 9 }
    if ranged(21) != 400 { return 10 }
    sp = Point { x = 2, y = 5 }
    if nested_struct(Opt::Some(sp)) != 7 { return 11 }
    if nested_struct(Opt::None) != 0 - 1 { return 12 }
    return 0
}
