// M2 闭包：按值捕获 / 可变捕获（FnMut）/ 拥有类型捕获 + 环境释放
extern "C" fn __ayanami_live_allocs() -> int;

fn run() -> int {
    a = [1, 2, 3]
    n = 0
    f = (int x) -> int {
        n = n + x;
        return n + a[0]
    }
    r = f(5) + f(7)   // f(5)=6, f(7)=13 → 19
    return r
}

fn main() -> int {
    r = run()
    // run 返回后环境与数组缓冲都应释放：live_allocs = 0
    return r + __ayanami_live_allocs() * 100 - 19
}
