// A3d：`?` 真错误传播（Err 提前返回整个枚举值；要求与函数返回类型一致）
enum Res {
    Ok(int),
    Err(int),
}

fn inner(int x) -> Res {
    if x < 0 { return Res::Err(x) }
    return Res::Ok(x + 1)
}

fn outer(int x) -> Res {
    v = inner(x)?
    return Res::Ok(v * 10)
}

fn main() -> int {
    a = outer(1)
    b = outer(-5)
    // a 应为 Ok（_tag=0），b 应为 Err（_tag=1）
    return a._tag + b._tag - 1
}
