// C3a：泛型闭包签名约束（named/static/capturing/FnOnce）
fn inc(int x) -> int {
    return x + 1
}

fn one() -> int {
    return 1
}

fn apply[T: Fn(int) -> int](T f, int x) -> int {
    return f(x)
}

fn apply_once[T: FnOnce() -> int](T f) -> int {
    return f()
}

fn main() -> int {
    if apply(inc, 2) != 3 { return 1 }

    base = 10
    add = (int x) -> int { return x + base };
    if apply(add, 2) != 12 { return 2 }

    if apply_once(one) != 1 { return 3 }

    s = "abc";
    eat = () -> int {
        taken = s;
        return taken.len as int
    };
    if apply_once(eat) != 3 { return 4 }
    return 0
}
