// A5d-3c-2：常量传播 + 常量折叠 + pass 不动点（x=5; y=x+1; return y*2 → 12）
import "const_prop_lib.aya"
import "constfold_lib.aya"

#[const_prop_lib::const_prop]
#[constfold_lib::const_fold]
fn prop_fold() -> int {
    x = 5
    y = x + 1
    return y * 2
}

fn main() -> int {
    if prop_fold() != 12 { return 1 }
    return 0
}
