// Ayanami language grammar for Asuka
// This grammar describes the full Ayanami syntax.

@lexer {
    keyword: "fn", "return", "if", "else", "true", "false", "while",
             "for", "in", "match", "enum", "struct", "interface", "impl",
             "pub", "unique", "ref", "mut", "extern", "import", "as", "asm",
             "break", "continue", "self", "move", "clone", "inline", "let"
    operator: "+" (prec:5, assoc:left)
              "-" (prec:5, assoc:left)
              "*" (prec:6, assoc:left)
              "/" (prec:6, assoc:left)
              "%" (prec:6, assoc:left)
              "==" (prec:3, assoc:left)
              "!=" (prec:3, assoc:left)
              "<" (prec:3, assoc:left)
              ">" (prec:3, assoc:left)
              "<=" (prec:3, assoc:left)
              ">=" (prec:3, assoc:left)
              "&&" (prec:4, assoc:left)
              "||" (prec:4, assoc:left)
              "=" (prec:2, assoc:right)
              "!" (prefix)
              "-" (prefix, prec:7)
              "[" (prefix, group)
              "]" (prefix)
    punct: ";", "{", "}", "(", ")", "[", "]", ",", ":", "::", "->", "=>",
           "_", ".", "#"
}

@ast {
    Program       = Item*;

    AttrList      = Attr*;
    Attr          = "#" "[" AttrPath AttrArgs? "]";
    AttrPath      = Ident ("::" Ident)*;
    AttrArg       = Ident | IntLiteral | StringLiteral;
    AttrArgs      = "(" AttrArg ("," AttrArg)* ")";
    Item          = FnDecl | StructDef | EnumDef | InterfaceDef | ImplBlock | Import | Namespace;

    Import        = "import" StringLiteral ("{" IdentList "}")? ";";
    IdentList     = Ident ("," Ident)*;
    Namespace     = Vis? "namespace" Ident "{" Item* "}";

    FnDecl        = AttrList Vis? Inline? ExternC? "fn" Ident GenericParams? "(" ParamList ")" ("->" Type)? Block;
    FnParam       = Attr* Type Ident;  // A1b：形参标注（#[noalias]/#[nonnull]）
    ParamList     = FnParam ("," FnParam)*;
    Vis           = "pub" ("(" "crate" ")")?;
    Inline        = "inline";
    ExternC       = "extern" StringLiteral;

    StructDef     = AttrList Vis? "struct" Ident GenericParams? "{" FieldList "}";
    Field         = AttrList? Type Ident;
    FieldList     = Field*;

    EnumDef       = AttrList Vis? "enum" Ident GenericParams? "{" VariantList "}";
    Variant       = Ident ("(" TypeList? ")")? ("{" FieldList "}")?;
    VariantList   = Variant ("," Variant)*;

    InterfaceDef  = AttrList Vis? "interface" Ident GenericParams? "{" IfaceMethodList "}";
    IfaceMethod   = AttrList "fn" Ident "(" SelfParam ("," ParamList)? ")" ("->" Type)? ";";
    SelfParam     = ("unique" | "ref" "mut"?) "self" | "self";

    ImplBlock     = AttrList Vis? "impl" GenericParams? Ident GenericArgs? "{" MethodList "}";
    Method        = AttrList Vis? "fn" Ident GenericParams? "(" SelfParam ("," ParamList)? ")" ("->" Type)? Block;
    GenericArgs   = "[" Type ("," Type)* "]";

    GenericParams = "[" GenericParam ("," GenericParam)* "]";
    GenericParam  = Ident (":" Ident)?;

    Type          = TypeBase | UniqueType | FnType | ArrayType | RefType;
    TypeBase      = Ident (GenericArgs)?;
    UniqueType    = "unique" Type;
    RefType       = "ref" "mut"? Type;
    FnType        = "fn" "(" TypeList? ")" ("->" Type)?;
    ArrayType     = "[" Type (";" Expr)? "]";
    TypeList      = Type ("," Type)*;

    Block         = "{" Stmt* "}";

    Stmt          = AttrList StmtKind;
    StmtKind      = VarDecl | FieldAssign | IndexAssign
                   | ReturnStmt | IfStmt | WhileStmt | ForStmt
                   | MatchStmt | BreakStmt | ContinueStmt
                   | ExprStmt | Block;

    VarDecl       = Type? Ident "=" Expr ";";
    FieldAssign   = Expr "." Ident "=" Expr ";";
    IndexAssign   = Expr "[" Expr "]" "=" Expr ";";
    ReturnStmt    = "return" Expr? ";";
    IfStmt        = "if" Expr Block ("elif" Expr Block)* ("else" Block)?;
    WhileStmt     = "while" Expr Block;
    ForStmt       = "for" Ident "in" "(" Expr "," Expr ("," Expr)? ")" Block;
    MatchStmt     = "match" Expr "{" MatchArm* "}";
    MatchArm      = Pattern "=>" Expr ",";
    BreakStmt     = "break" ";";
    ContinueStmt  = "continue" ";";
    ExprStmt      = Expr ";";

    Pattern       = Ident ("(" PatternArgs? ")")?;
    PatternArgs   = Pattern ("," Pattern)*;

    Expr          = BinaryExpr | UnaryExpr | FnCallExpr | CallExpr | FieldExpr | IndexExpr
                   | MethodCallExpr
                   | MatchExpr | IfExpr | BlockExpr
                   | LambdaExpr
                   | MoveExpr | CloneExpr | ToUniqueExpr
                   | RefExpr | TryOp
                   | StructLiteral | ArrayLiteral | ArraySized
                   | EnumConstruct
                   | AsmExpr | NullExpr
                   | Ident | IntLiteral | FloatLiteral | StringLiteral | CharLiteral | BoolLiteral;

    BinaryExpr    = Expr operator Expr;
    UnaryExpr     = ("-" | "!") Expr;
    FnCallExpr    = Ident "(" ExprList? ")";
    CallExpr      = Expr "(" ExprList? ")";
    FieldExpr     = Expr "." Ident;
    IndexExpr     = Expr "[" Expr "]";
    MethodCallExpr= Expr "." Ident "(" ExprList? ")";

    MatchExpr     = "match" Expr "{" MatchArm* "}";
    IfExpr        = "if" Expr Block ("elif" Expr Block)* ("else" (IfExpr | Block))?;
    BlockExpr     = Block;

    LambdaExpr    = "(" ParamList ")" ("->" Type)? Block;

    MoveExpr      = "move" Expr;
    CloneExpr     = "clone" Expr;
    ToUniqueExpr  = "unique" Expr;
    RefExpr       = "ref" "mut"? Expr;
    TryOp         = Expr "?";

    NullExpr      = "null";
    ArraySized    = "[" Type ";" Expr "]";

    StructLiteral = Type "{" FieldInitList "}";
    FieldInit     = Ident "=" Expr;
    FieldInitList = FieldInit ("," FieldInit)*;
    ArrayLiteral  = "[" ExprList? "]";
    ExprList      = Expr ("," Expr)*;

    EnumConstruct = Ident "::" Ident ("(" ExprList? ")")?;

    AsmExpr       = "asm" "(" StringLiteral ":" AsmOutputList? ":" AsmInputList? ")";
    AsmOutput     = StringLiteral ":" Expr;
    AsmOutputList = AsmOutput ("," AsmOutput)*;
    AsmInput      = StringLiteral ":" Expr;
    AsmInputList  = AsmInput ("," AsmInput)*;

    BoolLiteral   = "true" | "false";
    IntLiteral    = token("IntLiteral");
    FloatLiteral  = token("FloatLiteral");
    StringLiteral = token("StrLit");
    CharLiteral   = token("CharLiteral");
}

@hir {
    // Placeholder — lowering defined in Rust code via VisitorCtx::on()
}

@emit {
    // Placeholder — C/LLVM IR emission templates
}

@pipeline {
    parse → lex, parse_ast;
}
