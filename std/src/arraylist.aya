import "string"
import "panic"
import "list"

pub struct ArrayList[T]{
    [T] data
    int len
    int capability
}

pub namespace ArrayList {
    /// 空表
    pub fn new[T]() -> ArrayList[T] {
        return ArrayList[T] { data = null, len = 0, capability = 0 }
    }
    /// 预分配容量（cap <= 0 时等价于 new）
#[alloc]
    pub fn with_capacity[T](int cap) -> ArrayList[T] {
        if cap <= 0 {
            return ArrayList[T] { data = null, len = 0, capability = 0 }
        }
        return ArrayList[T] { data = [T; cap], len = 0, capability = cap }
    }
}

impl[T] ArrayList[T]{
#[alloc]
#[state]
    fn expand(ref mut self){
        if self.capability == 0 {
            self.capability = 1
            self.data = [T; 1]
        } else {
            tmp = [T; self.capability * 2]
            for i in (0, self.len) { tmp[i] = self.data[i] }
            self.data = tmp
            self.capability = self.capability * 2
        }
    }

#[alloc]
#[state]
    pub fn push(ref mut self, T val){
        if self.len + 1 >= self.capability { self.expand() }
        self.data[self.len] = val
        self.len = self.len + 1
    }

    pub fn index(ref self, int index)->T{
        if index < 0 || index >= self.len { panic_bounds_at(0, 0, String { data = null, len = 0 }, index, self.len) }
        return self.data[index]
    }
    pub fn len(ref self)->int{ return self.len }

#[state]
    pub fn set(ref mut self, int i, T v) {
        if i < 0 || i >= self.len { panic_bounds_at(0, 0, String { data = null, len = 0 }, i, self.len) }
        self.data[i] = v
    }

    /// 弹出末元素（调用方需自行保证非空）
#[alloc]
#[state]
    pub fn pop(ref mut self) -> T {
        if self.len <= 0 { panic_at(0, 0, String { data = null, len = 0 }, "pop from empty ArrayList") }
        self.len = self.len - 1
        return self.data[self.len]
    }

    pub fn is_empty(ref self) -> bool {
        return self.len == 0
    }

    /// 清空（保留底层缓冲，元素不做逐个释放）
#[state]
    pub fn clear(ref mut self) {
        self.len = 0
    }

    pub fn iter(ref self, fn(T) f) {
        for i in (0, self.len) {
            f(self.data[i])
        }
    }
}

/// 需要元素实现 ToString
impl[T:ToString] ArrayList[T] {
#[alloc]
#[state]
    pub fn to_string(ref self)->String{
        res = "["
        for i in (0, self.len){
            res = res + self.data[i]
            if i != self.len-1 { res = res + ", " }
        }
        res = res + "]"
        return res
    }
}
