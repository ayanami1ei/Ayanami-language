import "string"
import "list"

pub struct ArrayList[T:ToString]{
    [T] data
    int len
    int capability
}

impl[T:ToString] ArrayList[T]{
    fn expand(ref mut self){
        if self.capability == 0 {
            self.capability = 1
            self.data = [T; 1]
        } else {
            tmp = [T; self.capability * 2]
            for i in (0, self.len) { tmp[i] = self.data[i] }
            self.data = tmp
            self.capability = self.capability * 2
        }
    }

    pub fn push(ref mut self, T val){
        if self.len + 1 >= self.capability { self.expand() }
        self.data[self.len] = val
        self.len = self.len + 1
    }

    pub fn index(ref self, int index)->T{ return self.data[index] }
    pub fn to_string(ref self)->String{
        res = "["
        for i in (0, self.len){
            res = res + self.data[i]
            if i != self.len-1 { res = res + ", " }
        }
        res = res + "]"
        return res
    }
    pub fn len(ref self)->int{ return self.len }

    pub fn iter(ref self, fn(T) f) {
        for i in (0, self.len) {
            f(self.data[i])
        }
    }
}
