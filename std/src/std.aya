// Ayanami Standard Library
import "io.aya";
import "string.aya";
import "math.aya";
import "list.aya";
import "linkedlist.aya";
import "arraylist.aya";

pub interface Error {
    fn what(shared self) -> shared String;
}

pub enum Result[T, E] {
    Ok(T),
    Err(E),
}

impl[T, E] Result[T, E] {
    pub fn try_unwrap(unique self) -> T {
        match self {
            Ok(v) => v,
            Err(_) => 0,
        }
    }
}
