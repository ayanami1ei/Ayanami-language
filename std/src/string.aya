pub struct String {
    unique [char] data
    int len
}

impl String {
    pub fn index(shared self, int i) -> char {
        return self.data[i];
    }
    pub fn len(shared self) -> int {
        return self.len;
    }

    pub fn add[T:Add](shared self, unique T a)->unique String{
        return self.data;
    }
}
