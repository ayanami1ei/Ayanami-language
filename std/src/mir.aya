// A5d-3：MIR 优化注解的公开视图（schema v1，扁平 preorder）
//
// 布局与编译器生成的 C 桥接一一对应：
//   int  → i64；[int] → 堆数组指针；字段顺序固定。
// 节点按 preorder 排列：child_counts[i] 是第 i 个节点的直接子节点数，
// 函数体根节点为下标 0（空函数 node_count == 0）。
//
// 约定：
// - pure/no_error 可直接改写；
// - 其余只读数组不得修改；
// - body 改写通过编辑数组表达：edit_kind[i]=1 表示把第 i 个表达式节点替换为
//   edit_i64[i] 的整型字面量（目前仅支持 int）；编译器应用后会重跑借用检查。

pub struct MirFunction {
    int pure
    int no_error
    int node_count
    [int] kinds
    [int] is_call
    [int] callee_pure
    [int] is_alloc
    [int] is_asm
    [int] is_store
    [int] child_counts
    [int] ops
    [int] lit_kinds
    [int] lit_i64
    [int] lit_f64
    [int] stmt_kinds
    [int] var_ids
    [int] edit_kind
    [int] edit_i64
}

/// 无副作用扫描：调用（且被调方非 pure）、堆分配、汇编、字段/索引写
/// 任一出现即判定有副作用。v0 直接线性遍历全部节点。
pub fn scan_effects(ref MirFunction f) -> bool {
    for i in (0, f.node_count) {
        if f.is_alloc[i] != 0 { return false }
        if f.is_asm[i] != 0 { return false }
        if f.is_store[i] != 0 { return false }
        if f.is_call[i] != 0 {
            if f.callee_pure[i] == 0 { return false }
        }
    }
    return true
}

// ── 检查注解诊断通道（由插件 shim 提供实现）──

extern "C" fn __ayanami_diag_emit(int level, String msg);

/// 上报 warning 级诊断（1）
pub fn warn(String msg) {
    __ayanami_diag_emit(1, msg)
}

/// 上报 error 级诊断（2，会导致编译失败）
pub fn error(String msg) {
    __ayanami_diag_emit(2, msg)
}

// ── 编辑辅助 ──

/// 标记第 idx 个表达式节点替换为整型字面量 value
#[state]
pub fn replace_int(ref mut MirFunction f, int idx, int value) {
    f.edit_kind[idx] = 1
    f.edit_i64[idx] = value
}

/// 标记替换为浮点字面量（bits 为 f64 的位模式）
#[state]
pub fn replace_float(ref mut MirFunction f, int idx, int bits) {
    f.edit_kind[idx] = 2
    f.edit_i64[idx] = bits
}

/// 标记替换为布尔字面量（value != 0）
#[state]
pub fn replace_bool(ref mut MirFunction f, int idx, int value) {
    f.edit_kind[idx] = 3
    f.edit_i64[idx] = value
}

/// 标记替换为字符字面量（code 为字符编码）
#[state]
pub fn replace_char(ref mut MirFunction f, int idx, int code) {
    f.edit_kind[idx] = 4
    f.edit_i64[idx] = code
}

/// 标记用第 src 个表达式节点的克隆替换第 idx 个节点（类型必须一致）
#[state]
pub fn replace_with(ref mut MirFunction f, int idx, int src) {
    f.edit_kind[idx] = 5
    f.edit_i64[idx] = src
}

/// 标记删除第 idx 个语句节点（替换为空块）
#[state]
pub fn delete_stmt(ref mut MirFunction f, int idx) {
    f.edit_kind[idx] = 6
}

/// preorder 子树大小表（下标与扁平视图一致）
#[alloc]
#[state]
pub fn subtree_sizes(ref MirFunction f) -> [int] {
    n = f.node_count
    size = [int; n]
    i = n - 1
    while i >= 0 {
        s = 1
        c = i + 1
        for k in (0, f.child_counts[i]) {
            s = s + size[c]
            c = c + size[c]
        }
        size[i] = s
        i = i - 1
    }
    return size
}

// ── 语句种类（与编译器一致）──

pub fn stmt_is_assign(int k) -> bool { return k == 1 }
pub fn stmt_is_return(int k) -> bool { return k == 4 }
pub fn stmt_is_if(int k) -> bool { return k == 5 }
pub fn stmt_is_while(int k) -> bool { return k == 6 }
pub fn stmt_is_break(int k) -> bool { return k == 7 }
pub fn stmt_is_continue(int k) -> bool { return k == 8 }

// ── 运算符编码（与编译器一致）──

pub fn op_is_add(int op) -> bool { return op == 1 }
pub fn op_is_sub(int op) -> bool { return op == 2 }
pub fn op_is_mul(int op) -> bool { return op == 3 }
pub fn op_is_eq(int op) -> bool { return op == 6 }
pub fn op_is_neq(int op) -> bool { return op == 7 }
pub fn op_is_lt(int op) -> bool { return op == 8 }
pub fn op_is_gt(int op) -> bool { return op == 9 }

// ── 常量折叠辅助 ──

/// 第 idx 个节点是否可当作 int 字面量（原始字面量或已被编辑为字面量）
pub fn is_int_literal(ref MirFunction f, int idx) -> bool {
    if f.edit_kind[idx] == 1 { return true }
    return f.lit_kinds[idx] == 1
}

/// 取第 idx 个节点的 int 字面量值（编辑优先）
pub fn folded_int(ref MirFunction f, int idx) -> int {
    if f.edit_kind[idx] == 1 { return f.edit_i64[idx] }
    return f.lit_i64[idx]
}
