import "string"

// A5c-2：运行时 panic（退出码 101）
// 函数宏 `#panic("msg")` 在调用点展开，自动带上 __line/__col/__file

#[pure]
#[noreturn]
extern "C" fn __ayanami_panic_at(int line, int col, String file, String msg) -> void;

#[pure]
#[noreturn]
extern "C" fn __ayanami_panic_bounds_at(int line, int col, String file, int index, int len) -> void;

/// 带调用点的 panic（一般由 `#panic` 宏生成调用）
#[pure]
#[noreturn]
pub fn panic_at(int line, int col, String file, String msg) -> void {
    __ayanami_panic_at(line, col, file, msg);
}

/// 带调用点的越界 panic（标准库集合检查用）
#[pure]
#[noreturn]
pub fn panic_bounds_at(int line, int col, String file, int index, int len) -> void {
    __ayanami_panic_bounds_at(line, col, file, index, len);
}

#[alloc]
#[state]
#[macro]
pub fn panic(String input, String msg, int __line, int __col, String __file) -> String {
    return "panic_at(" + __line + ", " + __col + ", \"" + __file + "\", " + msg + ")"
}

#[alloc]
#[state]
#[macro]
pub fn panic_bounds(String input, String index, String len, int __line, int __col, String __file) -> String {
    return "panic_bounds_at(" + __line + ", " + __col + ", \"" + __file + "\", " + index + ", " + len + ")"
}
