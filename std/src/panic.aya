import "string"

// A5c-2：用户侧 panic（函数宏 `#panic("msg")`，调用点位置 + 退出码 101）

#[pure]
#[noreturn]
extern "C" fn __ayanami_panic_at(int line, int col, String file, String msg) -> void;

#[pure]
#[noreturn]
pub fn panic_at(int line, int col, String file, String msg) -> void {
    __ayanami_panic_at(line, col, file, msg);
}

// 注：宏体只用非泛型函数（add(ref String)/int.to_string），避免把共享泛型特化
// 烘焙进 .lcl 导致与其它对象重复定义
#[alloc]
#[state]
#[macro]
pub fn panic(String input, String msg, int __line, int __col, String __file) -> String {
    res = "panic_at(";
    res = res.add(__line.to_string());
    res = res.add(", ");
    res = res.add(__col.to_string());
    res = res.add(", \"");
    res = res.add(__file);
    res = res.add("\", ");
    res = res.add(msg);
    res = res.add(")");
    return res;
}

#[alloc]
#[state]
#[macro]
pub fn panic_bounds(String input, String index, String len, int __line, int __col, String __file) -> String {
    res = "panic_bounds_at(";
    res = res.add(__line.to_string());
    res = res.add(", ");
    res = res.add(__col.to_string());
    res = res.add(", \"");
    res = res.add(__file);
    res = res.add("\", ");
    res = res.add(index);
    res = res.add(", ");
    res = res.add(len);
    res = res.add(")");
    return res;
}
