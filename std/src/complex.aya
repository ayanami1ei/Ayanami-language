// A6：复数（float 对实现，运算符重载：+ - * / 一元- == !=）
import "string"
import "math"

pub struct Complex {
    float re
    float im
}

/// 便捷构造：complex(3.0, 4.0) → 3+4i
pub fn complex(float re, float im) -> Complex {
    return Complex { re = re, im = im }
}

impl Complex {
    #[pure]
    pub fn add(ref self, ref Complex other) -> Complex {
        return Complex { re = self.re + other.re, im = self.im + other.im }
    }

    #[pure]
    pub fn sub(ref self, ref Complex other) -> Complex {
        return Complex { re = self.re - other.re, im = self.im - other.im }
    }

    /// (a+bi)(c+di) = (ac-bd) + (ad+bc)i
    #[pure]
    pub fn mul(ref self, ref Complex other) -> Complex {
        return Complex {
            re = self.re * other.re - self.im * other.im,
            im = self.re * other.im + self.im * other.re,
        }
    }

    /// (a+bi)/(c+di) = ((ac+bd) + (bc-ad)i) / (c²+d²)
    #[pure]
    pub fn div(ref self, ref Complex other) -> Complex {
        d = other.re * other.re + other.im * other.im
        return Complex {
            re = (self.re * other.re + self.im * other.im) / d,
            im = (self.im * other.re - self.re * other.im) / d,
        }
    }

    // ── 标量（float）重载 ──

    #[pure]
    pub fn add(ref self, float s) -> Complex {
        return Complex { re = self.re + s, im = self.im }
    }

    #[pure]
    pub fn sub(ref self, float s) -> Complex {
        return Complex { re = self.re - s, im = self.im }
    }

    #[pure]
    pub fn mul(ref self, float s) -> Complex {
        return Complex { re = self.re * s, im = self.im * s }
    }

    #[pure]
    pub fn div(ref self, float s) -> Complex {
        return Complex { re = self.re / s, im = self.im / s }
    }

    #[pure]
    pub fn neg(self) -> Complex {
        return Complex { re = -self.re, im = -self.im }
    }

    #[pure]
    pub fn eq(ref self, ref Complex other) -> bool {
        return self.re == other.re && self.im == other.im
    }

    #[pure]
    pub fn ne(ref self, ref Complex other) -> bool {
        return !self.eq(other)
    }

    // ── 复函数 ──

    #[pure]
    pub fn norm_sq(ref self) -> float {
        return self.re * self.re + self.im * self.im
    }

    /// 模长 |a+bi| = √(a²+b²)
    #[pure]
    pub fn abs(ref self) -> float {
        return sqrt(self.norm_sq())
    }

    /// 共轭 a-bi
    #[pure]
    pub fn conj(ref self) -> Complex {
        return Complex { re = self.re, im = -self.im }
    }

    /// 整数幂（exp >= 0）
    #[pure]
    pub fn pow(ref self, int exp) -> Complex {
        r = Complex { re = 1.0, im = 0.0 }
        for i in (0, exp) {
            r = r * self
        }
        return r
    }

    #[alloc]
    #[state]
    pub fn to_string(self) -> String {
        if self.im == 0.0 { return self.re.to_string() }
        if self.re == 0.0 { return self.im.to_string() + "i" }
        if self.im > 0.0 { return self.re.to_string() + "+" + self.im.to_string() + "i" }
        return self.re.to_string() + self.im.to_string() + "i"
    }
}

