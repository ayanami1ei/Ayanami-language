// I/O functions

extern "C" fn __ayanami_getchar() -> int;
extern "C" fn __ayanami_putchar(int c);
extern "C" fn __ayanami_print_int(int n);
extern "C" fn __ayanami_print_str(unique [char] s);
extern "C" fn __ayanami_print_ln();

pub fn getchar() -> int { return __ayanami_getchar(); }
pub fn putchar(int c) { __ayanami_putchar(c); }
pub fn print(int n) { __ayanami_print_int(n); }
pub fn print_str(unique [char] s) { __ayanami_print_str(s); }
pub fn println() { __ayanami_print_ln(); }
